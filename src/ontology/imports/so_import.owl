    <!-- http://purl.obolibrary.org/obo/SO_0000839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001411"/>
        <obo:IAO_0000115>Biological sequence region that can be assigned to a specific subsequence of a polypeptide.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>BS:00124</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>BS:00331</oboInOwl:hasAlternativeId>
        <oboInOwl:hasNarrowSynonym>region</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>site</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>positional</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>positional polypeptide feature</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>region or site annotation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>SO:0000839</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#biosapiens"/>
        <rdfs:comment>Added to allow the polypeptide regions to have is_a paths back to the root.</rdfs:comment>
