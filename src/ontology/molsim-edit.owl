DisjointClasses(obo:MOLSIM_000066 obo:MOLSIM_000068 obo:MOLSIM_000069 obo:MOLSIM_000070 obo:MOLSIM_000071 obo:MOLSIM_000072 obo:MOLSIM_001475 obo:MOLSIM_001496 obo:MOLSIM_001535)
# implicit solvent model (MOLSIM_000068) — 6 children
