############################

# Annotation Property: obo:IAO_0000115 (definition)


# Annotation Property: obo:IAO_0000117 (term editor)


# Annotation Property: obo:IAO_0000119 (definition source)


# Annotation Property: obo:MOLSIM_002254 (has software keyword)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002254 "A relation that records the name a piece of simulation software uses for the concept this term names, as it appears in that software's input file, output file or command line. The software the name belongs to is given by annotating the statement itself with dcterms:source, so one property serves every program rather than needing one property per program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002254 "has software keyword"@en)

# Annotation Property: obo:IAO_0100001 (term replaced by)


############################
#   Object Properties
############################

# Object Property: obo:IAO_0000039 (has measurement unit label)

SubObjectPropertyOf(obo:IAO_0000039 owl:topObjectProperty)

# Data Property: obo:IAO_0000004 (has measurement value)


# Object Property: obo:IAO_0000136 (is about)

SubObjectPropertyOf(obo:IAO_0000136 owl:topObjectProperty)

# Object Property: obo:MOLSIM_000297 (has periodic box type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000297 "A relation that links a molecular simulation system to the geometric shape of the simulation cell used to apply periodic boundary conditions. Those conditions mimic an infinite system by making a particle that leaves one side re-enter from the opposite side. Common shapes are cubic, triclinic and rhombic dodecahedron, and the choice affects both computational cost and how isotropic the system is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000297 "has periodic box type"@en)
SubObjectPropertyOf(obo:MOLSIM_000297 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_000297 obo:MOLSIM_001887)
ObjectPropertyRange(obo:MOLSIM_000297 obo:MOLSIM_000032)

# Object Property: obo:MOLSIM_000504 (has molecular dynamics suite utility)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000504 "A relation that links a computational process or analysis step to the utility program from a molecular dynamics software suite that was used to perform it. For example, a trajectory analysis may use a particular trajectory processing utility, or system preparation a particular solvation tool. It records the exact tool used within a larger workflow, where that tool is one component of a bigger software package. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000504 "has molecular dynamics suite utility"@en)
SubObjectPropertyOf(obo:MOLSIM_000504 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_000504 obo:MOLSIM_000000)
ObjectPropertyRange(obo:MOLSIM_000504 obo:MOLSIM_000001)

# Object Property: obo:MOLSIM_000507 (has alignment tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000507 "A relation that links a structural alignment procedure or analysis step to the software program used to perform the alignment. Structural alignment superimposes molecular structures such as proteins or nucleic acids, so that their conformations can be compared or conserved regions found. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000507 "has alignment tool"@en)
SubObjectPropertyOf(obo:MOLSIM_000507 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_000507 obo:MOLSIM_000004)
ObjectPropertyRange(obo:MOLSIM_000507 obo:MOLSIM_000001)

# Object Property: obo:MOLSIM_000508 (has protein structure source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000508 "A relation that links a molecular structure to the origin from which its three-dimensional coordinates were obtained. The origin may be an entry in an experimental database such as the Protein Data Bank, the output of a computational prediction method such as homology modelling, or another defined source. Recording it lets a reader trace where a structure came from and judge its quality. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000508 "has protein structure source"@en)
SubObjectPropertyOf(obo:MOLSIM_000508 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_000508 obo:MOLSIM_000904)
ObjectPropertyRange(obo:MOLSIM_000508 obo:MOLSIM_000688)

# Object Property: obo:MOLSIM_001033 (has simulation environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001033 "A relation that links a molecular simulation system to the overall physical context or medium it represents, such as an aqueous solution, a lipid bilayer, a vacuum or a crystal lattice. That context shapes the choice of simulation parameters, including boundary conditions and dielectric treatment, and how the results should be read."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001033 "has simulation environment"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001033 orcid:0009-0007-1391-4986)
SubObjectPropertyOf(obo:MOLSIM_001033 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_001033 obo:MOLSIM_001887)
ObjectPropertyRange(obo:MOLSIM_001033 obo:MOLSIM_002067)

# Object Property: obo:MOLSIM_001034 (has template complex structure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001034 "A relation that links a molecular simulation system to the initial three-dimensional structural model of the molecular complex used as its starting point. That structure is often taken from experimental data such as a PDB entry, or from earlier computational modelling such as a docking pose. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001034 "has template complex structure"@en)
SubObjectPropertyOf(obo:MOLSIM_001034 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_001034 obo:MOLSIM_001887)
ObjectPropertyRange(obo:MOLSIM_001034 obo:MOLSIM_000904)

# Object Property: obo:MOLSIM_001035 (has validated ligand selection criteria)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001035 "A relation that links a plan specification to the rules, checks or conditions applied to confirm that the chosen ligands, and the alchemical transformations between them, are suitable for a relative binding free energy calculation. Those checks may cover structural similarity, consistency of charge and protonation state, or avoiding transformations that inappropriately break or form covalent bonds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001035 "has validated ligand selection criteria"@en)
SubObjectPropertyOf(obo:MOLSIM_001035 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_001035 obo:IAO_0000104)
ObjectPropertyRange(obo:MOLSIM_001035 obo:MOLSIM_000143)

# Object Property: obo:MOLSIM_001036 (has reaction coordinate)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001036 "A relation that links an enhanced sampling process to the geometric or collective variable along which the system is steered or biased, for example in steered molecular dynamics or umbrella sampling. Examples are the distance between two groups of atoms, an angle, a dihedral angle, or a more complex function of atomic coordinates."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001036 "has reaction coordinate"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001036 orcid:0009-0007-1391-4986)
SubObjectPropertyOf(obo:MOLSIM_001036 owl:topObjectProperty)
ObjectPropertyDomain(obo:MOLSIM_001036 obo:MOLSIM_000845)
ObjectPropertyRange(obo:MOLSIM_001036 obo:MOLSIM_001994)

# Object Property: obo:RO_0000056 (participates in)

SubObjectPropertyOf(obo:RO_0000056 owl:topObjectProperty)

# Object Property: obo:RO_0000058 (is concretized as)


# Object Property: obo:RO_0000086 (has quality)

SubObjectPropertyOf(obo:RO_0000086 owl:topObjectProperty)

# Object Property: obo:RO_0002233 (has input)

AnnotationAssertion(rdfs:comment obo:RO_0002233 "http://purl.obolibrary.org/obo/RO_0002233")
SubObjectPropertyOf(obo:RO_0002233 owl:topObjectProperty)

# Object Property: obo:RO_0002234 (has output)

SubObjectPropertyOf(obo:RO_0002234 owl:topObjectProperty)
SubObjectPropertyOf(obo:OBI_0000293 obo:RO_0002233)
SubObjectPropertyOf(obo:OBI_0000299 obo:RO_0002234)

############################
#   Data Properties
############################

# Data Property: obo:MOLSIM_001121 (has composition count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001121 "A relation that groups properties quantifying the chemical composition of a molecular system, such as the total number of atoms, residues and molecules of each type. Those counts give the stoichiometry and the overall size of the system being simulated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001121 "has composition count"@en)
SubDataPropertyOf(obo:MOLSIM_001121 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001121 obo:MOLSIM_001887)
DataPropertyRange(obo:MOLSIM_001121 xsd:integer)

# Data Property: obo:MOLSIM_001122 (number of total atoms)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001122 "A relation that gives the total number of atoms in a molecular system, counting every molecule present including solvent and ions. It is the single figure that most determines what a simulation will cost, because the work of each step grows with it. A solvated protein system is usually tens of thousands of atoms, most of them water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001122 "The NATOM pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001122 "number of total atoms"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001122 "NATOM")
SubDataPropertyOf(obo:MOLSIM_001122 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001122 xsd:integer)

# Data Property: obo:MOLSIM_001123 (number of total distinct atoms)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001123 "A relation that gives the number of different atom types the force field uses for a system, rather than the number of atoms. An atom type is a category such as an aromatic carbon or a carbonyl oxygen, and every atom of that type shares the same interaction parameters. The figure reflects how chemically varied the system is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001123 "The NTYPES pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001123 "number of total distinct atoms"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001123 "NTYPES")
SubDataPropertyOf(obo:MOLSIM_001123 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001123 xsd:integer)

# Data Property: obo:MOLSIM_001124 (number of total residues)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001124 "A relation that gives the number of residues in a molecular system, a residue being one building block of a polymer such as an amino acid or a nucleotide. It measures the size of the macromolecules present in a way that does not change with how much solvent surrounds them. Counting atoms would. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001124 "The NRES pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001124 "number of total residues"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001124 "NRES")
SubDataPropertyOf(obo:MOLSIM_001124 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001124 xsd:integer)

# Data Property: obo:MOLSIM_001125 (number of receptor residues)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001125 "A relation that gives the number of the last residue treated as part of the solute, which fixes where the receptor ends. Everything numbered beyond it is ligand, solvent or ions. The boundary matters because analyses of binding must know which atoms belong to the receptor. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001125 "The IPTRES pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001125 "number of receptor residues"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001125 "IPTRES")
SubDataPropertyOf(obo:MOLSIM_001125 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001125 xsd:integer)

# Data Property: obo:MOLSIM_001126 (number of ligands)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001126 "A relation that gives the number of ligand molecules in a molecular system. A ligand here is a small molecule being studied for how it binds to a larger one. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001126 "number of ligands"@en)
SubDataPropertyOf(obo:MOLSIM_001126 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001126 xsd:integer)

# Data Property: obo:MOLSIM_001127 (number of charged ligands)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001127 "A relation that gives the number of ligand molecules in a system that carry a net electrical charge. It matters because charged ligands change how the system must be neutralised and how its electrostatics behave. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001127 "number of charged ligands"@en)
SubDataPropertyOf(obo:MOLSIM_001127 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001127 xsd:integer)

# Data Property: obo:MOLSIM_001128 (number of ligand conformers)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001128 "A relation that gives the number of distinct shapes of a ligand being considered in a study. Docking and conformational analysis generate many shapes of the same molecule, and how many were kept affects what the result means. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001128 "number of ligand conformers"@en)
SubDataPropertyOf(obo:MOLSIM_001128 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001128 xsd:integer)

# Data Property: obo:MOLSIM_001129 (number of total atoms in the largest residue)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001129 "A relation that gives the number of atoms in the biggest single residue of a system. A standard amino acid has fewer than 30, so a much larger figure marks a cofactor, a ligand or a modified residue. It is a quick way to notice that a system contains something other than a plain polymer. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001129 "The NMXRS pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001129 "number of total atoms in the largest residue"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001129 "NMXRS")
SubDataPropertyOf(obo:MOLSIM_001129 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001129 xsd:integer)

# Data Property: obo:MOLSIM_001130 (number of extra points)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001130 "A relation that gives the number of massless interaction sites in a molecular model, which carry charge or interaction parameters but sit at no nucleus. They let charge be placed where no atom is, such as on a lone pair or slightly off an oxygen. Four-point water models and halogen bonding parameters are the usual reason a system has any. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001130 "The NUMEXTRA pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001130 "number of extra points"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001130 "NUMEXTRA")
SubDataPropertyOf(obo:MOLSIM_001130 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_001130 xsd:integer)

# Data Property: obo:MOLSIM_001131 (has topological count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001131 "A relation that groups properties quantifying the covalent structure and connectivity of a molecular system, such as the number of bonds, angles and dihedral angles. Together they describe the topology, which is the graph of how the atoms are joined. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001131 "has topological count"@en)
SubDataPropertyOf(obo:MOLSIM_001131 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001131 obo:MOLSIM_001076)
DataPropertyRange(obo:MOLSIM_001131 xsd:integer)

# Data Property: obo:MOLSIM_001132 (number of total bonds with hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001132 "A relation that gives the number of covalent bonds in a system in which one of the 2 atoms is a hydrogen. These bonds vibrate faster than anything else in the system, so they are usually held at a fixed length to permit a longer timestep. In an organic system they are roughly half of all bonds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001132 "The NBONH pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001132 "number of total bonds with hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001132 "NBONH")
SubDataPropertyOf(obo:MOLSIM_001132 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001132 xsd:integer)

# Data Property: obo:MOLSIM_001133 (number of total bonds without hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001133 "A relation that gives the number of covalent bonds in a system that join 2 heavy atoms, with no hydrogen involved. These bonds form the skeleton of each molecule and are not normally constrained, because they vibrate slowly enough for the timestep to follow them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001133 "The MBONA pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001133 "number of total bonds without hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001133 "MBONA")
SubDataPropertyOf(obo:MOLSIM_001133 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001133 xsd:integer)

# Data Property: obo:MOLSIM_001134 (number of total angles with hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001134 "A relation that gives the number of bond angles in a system in which at least one of the 3 atoms is a hydrogen. Angles involving hydrogen bend fastest, so some simulations constrain them as well as the bonds. Doing so permits a longer timestep still, at the cost of losing that motion. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001134 "The NTHETH pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001134 "number of total angles with hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001134 "NTHETH")
SubDataPropertyOf(obo:MOLSIM_001134 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001134 xsd:integer)

# Data Property: obo:MOLSIM_001135 (number of total angles without hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001135 "A relation that gives the number of bond angles in a system formed entirely by heavy atoms. These angles set the shape of each molecule's skeleton and are almost never constrained. Bending them is the main way a molecule accommodates strain. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001135 "The MTHETA pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001135 "number of total angles without hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001135 "MTHETA")
SubDataPropertyOf(obo:MOLSIM_001135 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001135 xsd:integer)

# Data Property: obo:MOLSIM_001136 (number of total dihedral angles with hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001136 "A relation that gives the number of dihedral angles in a system in which at least one of the 4 defining atoms is a hydrogen. Most of these describe the rotation of groups such as methyl and hydroxyl. They are numerous and individually unimportant, which is why they are counted separately from the rest. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001136 "The NPHIH pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001136 "number of total dihedral angles with hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001136 "NPHIH")
SubDataPropertyOf(obo:MOLSIM_001136 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001136 xsd:integer)

# Data Property: obo:MOLSIM_001137 (number of total dihedral angles without hydrogens)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001137 "A relation that gives the number of dihedral angles in a system defined entirely by heavy atoms. These are the rotations that decide what shapes a molecule can adopt, including the backbone angles of a protein. They carry most of what a force field knows about conformation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001137 "The MPHIA pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001137 "number of total dihedral angles without hydrogens"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001137 "MPHIA")
SubDataPropertyOf(obo:MOLSIM_001137 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001137 xsd:integer)

# Data Property: obo:MOLSIM_001138 (number of total excluded atom pairs)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001138 "A relation that gives the number of atom pairs whose non-bonded interaction is deliberately left out of the calculation. Atoms 1 or 2 bonds apart are excluded because the bonded terms already describe how they interact, and counting both would double the effect. The exclusion list is part of the topology rather than a setting. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001138 "The NNB pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001138 "number of total excluded atom pairs"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001138 "NNB")
SubDataPropertyOf(obo:MOLSIM_001138 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_001138 xsd:integer)

# Data Property: obo:MOLSIM_001139 (has constraint count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001139 "A relation that groups properties counting the degrees of freedom held fixed during a simulation, such as the bonds and angles made rigid by an algorithm like SHAKE. They record how far the natural dynamics of the system has been altered. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001139 "has constraint count"@en)
SubDataPropertyOf(obo:MOLSIM_001139 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001139 obo:MOLSIM_001076)
DataPropertyRange(obo:MOLSIM_001139 xsd:integer)

# Data Property: obo:MOLSIM_001140 (number of total bonds with constraints)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001140 "A relation that gives the number of covalent bonds whose length is held fixed by a constraint algorithm during a simulation. Each constrained bond removes one degree of freedom from the system, which is why the figure is needed to compute temperature correctly. It is obtained by subtracting 2 counts in the topology rather than read from a single field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001140 "prmtop NBONA - MBONA")
AnnotationAssertion(rdfs:label obo:MOLSIM_001140 "number of total bonds with constraints"@en)
SubDataPropertyOf(obo:MOLSIM_001140 obo:MOLSIM_001139)
DataPropertyRange(obo:MOLSIM_001140 xsd:integer)

# Data Property: obo:MOLSIM_001141 (number of total angles with constraints)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001141 "A relation that gives the number of bond angles held fixed by a constraint algorithm during a simulation. Constraining angles as well as bonds permits a longer timestep and removes the motion being constrained. It is obtained by subtracting 2 counts in the topology rather than read from a single field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001141 "prmtop NTHETA - MTHETA")
AnnotationAssertion(rdfs:label obo:MOLSIM_001141 "number of total angles with constraints"@en)
SubDataPropertyOf(obo:MOLSIM_001141 obo:MOLSIM_001139)
DataPropertyRange(obo:MOLSIM_001141 xsd:integer)

# Data Property: obo:MOLSIM_001142 (number of total dihedrals with constraints)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001142 "A relation that gives the number of dihedral angles held fixed by a constraint algorithm during a simulation. Constraining a dihedral prevents a rotation entirely, so it is done rarely and deliberately. It is obtained by subtracting 2 counts in the topology rather than read from a single field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001142 "prmtop NPHIA - MPHIA")
AnnotationAssertion(rdfs:label obo:MOLSIM_001142 "number of total dihedrals with constraints"@en)
SubDataPropertyOf(obo:MOLSIM_001142 obo:MOLSIM_001139)
DataPropertyRange(obo:MOLSIM_001142 xsd:integer)

# Data Property: obo:MOLSIM_001143 (has force field parameter count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001143 "A relation that groups properties counting the distinct force field parameters applied to a molecular system, such as the number of unique bond, angle and atom types. The counts indicate how complex the energy function used to model the system is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001143 "has force field parameter count"@en)
SubDataPropertyOf(obo:MOLSIM_001143 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001143 obo:MOLSIM_001076)
DataPropertyRange(obo:MOLSIM_001143 xsd:integer)

# Data Property: obo:MOLSIM_001144 (number of total unique bond types)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001144 "A relation that gives the number of different bond parameter sets a system's topology draws on. Two bonds share a type when the force field gives them the same preferred length and stiffness. The figure reflects how chemically varied the bonding in the system is, not how many bonds there are. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001144 "The NUMBND pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001144 "number of total unique bond types"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001144 "NUMBND")
SubDataPropertyOf(obo:MOLSIM_001144 obo:MOLSIM_001143)
DataPropertyRange(obo:MOLSIM_001144 xsd:integer)

# Data Property: obo:MOLSIM_001145 (number of total unique angle types)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001145 "A relation that gives the number of different angle parameter sets a system's topology draws on. Two angles share a type when the force field gives them the same preferred value and stiffness. The figure reflects the variety of local geometries the system contains. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001145 "The NUMANG pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001145 "number of total unique angle types"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001145 "NUMANG")
SubDataPropertyOf(obo:MOLSIM_001145 obo:MOLSIM_001143)
DataPropertyRange(obo:MOLSIM_001145 xsd:integer)

# Data Property: obo:MOLSIM_001146 (number of total unique dihedral types)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001146 "A relation that gives the number of different dihedral parameter sets a system's topology draws on. Dihedral parameters control which rotations are preferred, so this figure reflects how varied the conformational behaviour of the system is. It is usually the largest of the 3 parameter type counts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001146 "The NPTRA pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001146 "number of total unique dihedral types"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001146 "NPTRA")
SubDataPropertyOf(obo:MOLSIM_001146 obo:MOLSIM_001143)
DataPropertyRange(obo:MOLSIM_001146 xsd:integer)

# Data Property: obo:MOLSIM_001147 (number of total atom types in the parameter file)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001147 "A relation that gives the number of atom types defined in the force field parameter files being used, rather than the number appearing in one system. It describes the coverage of the force field itself. A general-purpose organic force field defines far more than a protein force field does. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001147 "The NATYP pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001147 "number of total atom types in the parameter file"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001147 "NATYP")
SubDataPropertyOf(obo:MOLSIM_001147 obo:MOLSIM_001143)
DataPropertyRange(obo:MOLSIM_001147 xsd:integer)

# Data Property: obo:MOLSIM_001148 (number of total distinct hydrogen bond pair types)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001148 "A relation that gives the number of distinct hydrogen bond parameter sets defined in a force field, for the older treatment that gives hydrogen bonds a potential of their own. Modern force fields describe hydrogen bonds through ordinary electrostatics and van der Waals terms instead, so this figure is 0 for most current systems. A non-zero value marks an older parameter set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001148 "The NPHB pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001148 "number of total distinct hydrogen bond pair types"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001148 "NPHB")
SubDataPropertyOf(obo:MOLSIM_001148 obo:MOLSIM_001143)
DataPropertyRange(obo:MOLSIM_001148 xsd:integer)

# Data Property: obo:MOLSIM_001149 (has alchemical transformation count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001149 "A relation that groups properties counting what a chemical transformation in a free energy calculation covers, such as the atoms, bonds and angles being changed during the simulation. They set out the scope of the alchemical modification performed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001149 "has alchemical transformation count"@en)
SubDataPropertyOf(obo:MOLSIM_001149 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001149 obo:MOLSIM_001887)
DataPropertyRange(obo:MOLSIM_001149 xsd:integer)

# Data Property: obo:MOLSIM_001150 (number of total perturbed bonds)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001150 "In an alchemical free energy calculation, this specifies the total count of bonds being chemically transformed."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001150 "The NBPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001150 "number of total perturbed bonds"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001150 orcid:0009-0007-1391-4986)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001150 "NBPER")
SubDataPropertyOf(obo:MOLSIM_001150 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001150 xsd:integer)

# Data Property: obo:MOLSIM_001151 (number of total perturbed angles)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001151 "In an alchemical free energy calculation, this specifies the total count of angles being chemically transformed."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001151 "The NGPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001151 "number of total perturbed angles"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001151 orcid:0009-0007-1391-4986)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001151 "NGPER")
SubDataPropertyOf(obo:MOLSIM_001151 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001151 xsd:integer)

# Data Property: obo:MOLSIM_001152 (number of total perturbed dihedrals)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001152 "In an alchemical free energy calculation, this specifies the total count of dihedrals being chemically transformed."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001152 "The NDPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001152 "number of total perturbed dihedrals"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001152 orcid:0009-0007-1391-4986)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001152 "NDPER")
SubDataPropertyOf(obo:MOLSIM_001152 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001152 xsd:integer)

# Data Property: obo:MOLSIM_001153 (number of total bonds with all atoms in the perturbed group)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001153 "A relation that gives the number of bonds in an alchemical free energy calculation whose 2 atoms both lie in the group being transformed. Such bonds change entirely with the transformation, unlike bonds that cross the boundary of the group and are only partly affected. The distinction determines how each bond is handled along the path. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001153 "The MBPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001153 "number of total bonds with all atoms in the perturbed group"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001153 "MBPER")
SubDataPropertyOf(obo:MOLSIM_001153 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001153 xsd:integer)

# Data Property: obo:MOLSIM_001154 (number of total angles with all atoms in perturbed groups)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001154 "A relation that gives the number of bond angles in an alchemical free energy calculation whose 3 atoms all lie in the group being transformed. They change entirely with the transformation, unlike angles that straddle its boundary. The distinction determines how each angle is handled along the path. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001154 "The MGPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001154 "number of total angles with all atoms in perturbed groups"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001154 "MGPER")
SubDataPropertyOf(obo:MOLSIM_001154 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001154 xsd:integer)

# Data Property: obo:MOLSIM_001155 (number of total dihedrals with all atoms in perturbed groups)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001155 "A relation that gives the number of dihedral angles in an alchemical free energy calculation whose 4 atoms all lie in the group being transformed. They change entirely with the transformation, unlike dihedrals that straddle its boundary. The distinction determines how each dihedral is handled along the path. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001155 "The MDPER pointer in an AMBER prmtop topology file.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001155 "number of total dihedrals with all atoms in perturbed groups"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001155 "MDPER")
SubDataPropertyOf(obo:MOLSIM_001155 obo:MOLSIM_001149)
DataPropertyRange(obo:MOLSIM_001155 xsd:integer)

# Data Property: obo:MOLSIM_001156 (has state descriptor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001156 "A relation that groups properties describing the overall state or the main qualitative features of a molecular system, such as yes-or-no flags and short textual descriptions of its composition and setup. They give high-level context about what kind of simulation it is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001156 "has state descriptor"@en)
SubDataPropertyOf(obo:MOLSIM_001156 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_001156 obo:MOLSIM_001887)

# Data Property: obo:MOLSIM_001157 (has ligand)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001157 "A relation that states whether a molecular system contains at least 1 ligand molecule. It marks at a glance which simulations concern binding rather than a molecule on its own. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001157 "has ligand"@en)
SubDataPropertyOf(obo:MOLSIM_001157 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001157 xsd:boolean)

# Data Property: obo:MOLSIM_001158 (has added salt)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001158 "A relation that states whether salt ions were added to a system beyond the counterions needed to make it neutral. Added salt sets the ionic strength, which changes how strongly charges are screened and how molecules interact. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001158 "has added salt"@en)
SubDataPropertyOf(obo:MOLSIM_001158 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001158 xsd:boolean)

# Data Property: obo:MOLSIM_001159 (is transmembrane system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001159 "A boolean descriptor indicating whether the molecular system houses an explicit lipid bilayer, rather than just an aqueous or implicit solvent environment. This is a higher-level descriptor not directly present in the prmtop pointers."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001159 "is transmembrane system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001159 orcid:0009-0007-1391-4986)
SubDataPropertyOf(obo:MOLSIM_001159 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001159 xsd:boolean)

# Data Property: obo:MOLSIM_001160 (has multiple starting conformations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001160 "A relation that states whether the starting structure contained more than one arrangement for some part of the molecule. Crystal structures often record 2 positions for a flexible side chain, and which was used changes what the simulation began from. No field in a topology file records this, so it has to be stated by whoever describes the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001160 "has multiple starting conformations"@en)
SubDataPropertyOf(obo:MOLSIM_001160 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001160 xsd:boolean)

# Data Property: obo:MOLSIM_001161 (lipid composition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001161 "A textual description of the types, proportions and spatial arrangements of different lipid molecules used to construct a biological membrane. This is a higher-level descriptor not directly present in the prmtop pointers."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001161 "lipid composition"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001161 orcid:0009-0007-1391-4986)
SubDataPropertyOf(obo:MOLSIM_001161 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001161 xsd:string)

# Data Property: obo:MOLSIM_001162 (lipid ratio)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001162 "A numerical or string representation of the relative amounts of different lipid types in a membrane. For example, a value of \"3:1\" could describe a mixture of two different lipids. This provides a semiquantitative description of the membrane composition."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001162 "lipid ratio"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001162 orcid:0009-0007-1391-4986)
SubDataPropertyOf(obo:MOLSIM_001162 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_001162 xsd:string)

# Data Property: obo:MOLSIM_002121 (first solvent molecule index)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002121 "A relation that associates a molecular system with the index of the first solvent molecule in its ordered list of molecules. In the Amber topology convention this pointer marks where solvent begins, separating solute from solvent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002121 "first solvent molecule index"@en)
SubDataPropertyOf(obo:MOLSIM_002121 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_002121 xsd:integer)

# Data Property: obo:MOLSIM_002122 (number of solvent molecules)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002122 "A relation that associates a molecular system with how many solvent molecules it contains. It quantifies the amount of solvent used to solvate the solute. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002122 "number of solvent molecules"@en)
SubDataPropertyOf(obo:MOLSIM_002122 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_002122 xsd:integer)

# Data Property: obo:MOLSIM_002123 (number of atoms per frame)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002123 "A relation that associates a trajectory with the atom count recorded in each of its frames. It reflects the size of the coordinate set stored at every saved time point. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002123 "number of atoms per frame"@en)
SubDataPropertyOf(obo:MOLSIM_002123 obo:MOLSIM_001121)
DataPropertyRange(obo:MOLSIM_002123 xsd:integer)

# Data Property: obo:MOLSIM_002124 (ion counts dict)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002124 "A relation that associates a molecular system with a mapping from ion species to the count of ions of each species present. It records the ionic composition used, for example, to neutralize charge or set ionic strength. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002124 "ion counts dict"@en)
SubDataPropertyOf(obo:MOLSIM_002124 obo:MOLSIM_001121)
AnnotationAssertion(rdfs:comment obo:MOLSIM_002124 "This property stores its value as text, not as a number. The text lists each kind of ion and how many of them there are, for example {\"Na+\": 12, \"Cl-\": 10}. That is how the simulation files themselves write it. The other count properties next to this one use plain numbers, because each of them counts a single thing. This one has to count several kinds of ion at the same time, and the ontology has no way yet to say which count belongs to which ion. We looked at two other ways of doing it: making a separate property for every kind of ion, or making a small object that holds one ion and its number. Both would add a lot of work for little gain right now, so we kept the text form. The text itself can be checked later with SHACL, a rule language for checking data files."@en)
DataPropertyRange(obo:MOLSIM_002124 xsd:string)

# Data Property: obo:MOLSIM_002125 (number of total angles)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002125 "A relation that associates a molecular system with how many bond-angle terms are defined in its force-field topology. It helps describe the size and complexity of the bonded interaction set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002125 "number of total angles"@en)
SubDataPropertyOf(obo:MOLSIM_002125 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_002125 xsd:integer)

# Data Property: obo:MOLSIM_002126 (number of total dihedrals)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002126 "A relation that associates a molecular system with how many dihedral, or torsion, terms are defined in its force-field topology. It helps describe the size and complexity of the bonded interaction set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002126 "number of total dihedrals"@en)
SubDataPropertyOf(obo:MOLSIM_002126 obo:MOLSIM_001131)
DataPropertyRange(obo:MOLSIM_002126 xsd:integer)

# Data Property: obo:MOLSIM_002127 (number of constraint failures)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002127 "A relation that associates a simulation with how many times a geometric constraint algorithm, such as SHAKE, failed to converge during the run. A nonzero value can signal instability in the integration. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002127 "number of constraint failures"@en)
SubDataPropertyOf(obo:MOLSIM_002127 obo:MOLSIM_001139)
DataPropertyRange(obo:MOLSIM_002127 xsd:integer)

# Data Property: obo:MOLSIM_002128 (has completion status)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002128 "A relation that associates a simulation run with an indication of whether it finished normally or terminated abnormally. It supports quick screening of runs for successful completion. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002128 "has completion status"@en)
SubDataPropertyOf(obo:MOLSIM_002128 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002128 xsd:boolean)

# Data Property: obo:MOLSIM_002129 (continuation flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002129 "A relation that indicates whether a run was started as a continuation of a previous run rather than from initial conditions. It distinguishes restarted runs from fresh ones. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002129 "continuation flag"@en)
SubDataPropertyOf(obo:MOLSIM_002129 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002129 xsd:boolean)

# Data Property: obo:MOLSIM_002130 (coordinate wrapping flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002130 "A relation that indicates whether the atomic coordinates in a trajectory have been translated back into the primary periodic unit cell. It records whether periodic-image wrapping was applied to the stored coordinates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002130 "coordinate wrapping flag"@en)
SubDataPropertyOf(obo:MOLSIM_002130 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002130 xsd:boolean)

# Data Property: obo:MOLSIM_002131 (QM/MM activation flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002131 "A relation that indicates whether a simulation uses a combined quantum-mechanics and molecular-mechanics treatment for part of the system. It records whether a region is described at the quantum level while the remainder uses a classical force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002131 "QM/MM activation flag"@en)
SubDataPropertyOf(obo:MOLSIM_002131 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002131 xsd:boolean)

# Data Property: obo:MOLSIM_002132 (self-guided Langevin dynamics flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002132 "A relation that indicates whether a run employs self-guided Langevin dynamics, an enhanced sampling scheme that adds a guiding force to accelerate conformational exploration. It records the use of this sampling enhancement. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002132 "self-guided Langevin dynamics flag"@en)
SubDataPropertyOf(obo:MOLSIM_002132 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002132 xsd:boolean)

# Data Property: obo:MOLSIM_002133 (spherical cap flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002133 "A relation that indicates whether a spherical solvent cap was applied around a region of interest instead of full periodic solvation. It records the use of a localized, non-periodic solvent boundary. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002133 "spherical cap flag"@en)
SubDataPropertyOf(obo:MOLSIM_002133 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002133 xsd:boolean)

# Data Property: obo:MOLSIM_002134 (has box dimensions flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002134 "A relation that indicates whether periodic box dimension information is present for a molecular system or trajectory. It records whether unit-cell size and shape data are available. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002134 "has box dimensions flag"@en)
SubDataPropertyOf(obo:MOLSIM_002134 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002134 xsd:boolean)

# Data Property: obo:MOLSIM_002135 (has velocities flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002135 "A relation that indicates whether atomic velocity data are stored alongside coordinates in a file or trajectory. Velocities are needed to seamlessly restart a run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002135 "has velocities flag"@en)
SubDataPropertyOf(obo:MOLSIM_002135 obo:MOLSIM_001156)
DataPropertyRange(obo:MOLSIM_002135 xsd:boolean)

# Data Property: obo:MOLSIM_002136 (obsolete box type flag)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002136 "OBSOLETE. A relation that records the kind of periodic box used for a molecular system, such as rectangular or truncated octahedral. It identifies the geometry of the periodic unit cell."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002136 "obsolete box type flag"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_002136 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_002136 obo:MOLSIM_000297)
AnnotationAssertion(rdfs:comment obo:MOLSIM_002136 "Retired 2026-08-13. It duplicated MOLSIM:000297 has periodic box type, which links a molecular simulation system to the class MOLSIM:000032 box type and its five children. This term held the same information as a plain string, so no value could be checked, while the object property points at a real hierarchy that a reasoner can use. Its label also broke the house convention: ten of the eleven data properties ending in flag are yes-or-no values, and this one recorded which box geometry was used.")

# Data Property: obo:MOLSIM_002137 (has trajectory metadata)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002137 "A relation that groups descriptive properties characterizing a molecular dynamics trajectory as a whole, such as its length and coordinate encoding. It serves as an organizing parent for individual trajectory-level metadata relations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002137 "has trajectory metadata"@en)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_002137 "Domain chosen 2026-08-13. This domain asserts something the other grouping properties here do not: anything carrying a child of this property, such as MOLSIM:002138 number of frames, is inferred to be a MOLSIM:001081 simulation trajectory. That is correct if a frame count is only ever recorded about a trajectory. If the source metadata ever records a frame count against a whole run rather than against its trajectory file, the domain should be MOLSIM:000000 molecular dynamics process instead. Confirm against the MDDB records before relying on it."@en)
SubDataPropertyOf(obo:MOLSIM_002137 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_002137 obo:MOLSIM_001081)

# Data Property: obo:MOLSIM_002138 (number of frames)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002138 "A relation that associates a trajectory with how many saved frames it contains. It reflects how many time points were recorded over the course of the run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002138 "number of frames"@en)
SubDataPropertyOf(obo:MOLSIM_002138 obo:MOLSIM_002137)
DataPropertyRange(obo:MOLSIM_002138 xsd:integer)

# Data Property: obo:MOLSIM_002139 (coordinate format specifier)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002139 "A relation that associates a trajectory or coordinate file with an identifier of the file format used to store its coordinates. It records how the coordinate data are encoded, for example as NetCDF or formatted text. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002139 "coordinate format specifier"@en)
SubDataPropertyOf(obo:MOLSIM_002139 obo:MOLSIM_002137)
DataPropertyRange(obo:MOLSIM_002139 xsd:string)

# Data Property: obo:MOLSIM_002140 (has box geometry array)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002140 "A relation that groups properties whose values are arrays describing the size and geometry of a molecular system, such as periodic box vectors. It serves as an organizing parent for array-valued structural metadata relations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002140 "has box geometry array"@en)
SubDataPropertyOf(obo:MOLSIM_002140 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_002140 obo:MOLSIM_001887)
DataPropertyRange(obo:MOLSIM_002140 xsd:string)

# Data Property: obo:MOLSIM_002141 (box dimensions array)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002141 "A relation that associates a molecular system with an array giving the lengths and angles that define its periodic simulation box. It captures the full geometry of the periodic unit cell. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002141 "box dimensions array"@en)
SubDataPropertyOf(obo:MOLSIM_002141 obo:MOLSIM_002140)
DataPropertyRange(obo:MOLSIM_002141 xsd:string)

# Data Property: obo:MOLSIM_002142 (initial box dimensions array)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002142 "A relation that associates a molecular system with an array giving the periodic box lengths and angles at the start of a run. It records the initial unit-cell geometry before any volume changes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002142 "initial box dimensions array"@en)
SubDataPropertyOf(obo:MOLSIM_002142 obo:MOLSIM_002140)
DataPropertyRange(obo:MOLSIM_002142 xsd:string)

# Data Property: obo:MOLSIM_002143 (has system nomenclature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002143 "A relation that groups properties recording the names and labels assigned to components of a molecular system, such as residue and atom-type names. It serves as an organizing parent for naming-related metadata relations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002143 "has system nomenclature"@en)
SubDataPropertyOf(obo:MOLSIM_002143 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_002143 obo:MOLSIM_001887)
DataPropertyRange(obo:MOLSIM_002143 xsd:string)

# Data Property: obo:MOLSIM_002144 (solvent residue name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002144 "A relation that associates a molecular system with the residue name used to identify its solvent in the topology, such as WAT for water. It records the label under which solvent is stored. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002144 "solvent residue name"@en)
SubDataPropertyOf(obo:MOLSIM_002144 obo:MOLSIM_002143)
DataPropertyRange(obo:MOLSIM_002144 xsd:string)

# Data Property: obo:MOLSIM_002145 (residue labels)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002145 "A relation that associates a molecular system with the ordered list of residue names for its constituent residues. It records the per-residue naming as given in the system's topology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002145 "residue labels"@en)
SubDataPropertyOf(obo:MOLSIM_002145 obo:MOLSIM_002143)
DataPropertyRange(obo:MOLSIM_002145 xsd:string)

# Data Property: obo:MOLSIM_002146 (unique residue names)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002146 "A relation that associates a molecular system with the set of distinct residue names it contains. It summarizes the kinds of residues present without regard to how many times each occurs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002146 "unique residue names"@en)
SubDataPropertyOf(obo:MOLSIM_002146 obo:MOLSIM_002143)
DataPropertyRange(obo:MOLSIM_002146 xsd:string)

# Data Property: obo:MOLSIM_002147 (unique atom types)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002147 "A relation that associates a molecular system with the set of distinct force-field atom types it uses. It summarizes the range of parameterized atom types present in the topology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002147 "unique atom types"@en)
SubDataPropertyOf(obo:MOLSIM_002147 obo:MOLSIM_002143)
DataPropertyRange(obo:MOLSIM_002147 xsd:string)

# Data Property: obo:MOLSIM_002148 (born radii set name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002148 "A relation that associates a molecular system with the identifier of the intrinsic radii set used in a generalized Born implicit-solvent calculation. It records which parameterization defines the atomic solvation radii. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002148 "born radii set name"@en)
SubDataPropertyOf(obo:MOLSIM_002148 obo:MOLSIM_002143)
DataPropertyRange(obo:MOLSIM_002148 xsd:string)

# Data Property: obo:MOLSIM_002149 (has diagnostic record)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002149 "A relation that groups properties recording what a simulation or a checking step reported about itself, such as an error message, a warning, or the outcome of a validation check. It gathers the output a run produced about its own progress, as distinct from the settings it was given. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002149 "has diagnostic record"@en)
SubDataPropertyOf(obo:MOLSIM_002149 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_002149 obo:MOLSIM_000000)
DataPropertyRange(obo:MOLSIM_002149 xsd:string)

# Data Property: obo:MOLSIM_002253 (has run input record)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002253 "A relation that groups properties recording what a simulation run was given to start from, such as the settings parsed from its input file or the restart file it continued from. It covers the input side of a run, as distinct from what the run reported about itself. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002253 "has run input record"@en)
SubDataPropertyOf(obo:MOLSIM_002253 owl:topDataProperty)
DataPropertyDomain(obo:MOLSIM_002253 obo:MOLSIM_000000)
DataPropertyRange(obo:MOLSIM_002253 xsd:string)

# Data Property: obo:MOLSIM_002150 (has error message)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002150 "A relation that associates a simulation or processing step with textual diagnostic output emitted when a fault occurred. It captures the message describing why a run failed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002150 "has error message"@en)
SubDataPropertyOf(obo:MOLSIM_002150 obo:MOLSIM_002149)
DataPropertyRange(obo:MOLSIM_002150 xsd:string)

# Data Property: obo:MOLSIM_002151 (has warning message)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002151 "A relation that associates a simulation or processing step with a textual warning emitted during execution. Such warnings flag potential problems that did not necessarily stop the run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002151 "has warning message"@en)
SubDataPropertyOf(obo:MOLSIM_002151 obo:MOLSIM_002149)
DataPropertyRange(obo:MOLSIM_002151 xsd:string)

# Data Property: obo:MOLSIM_002152 (has validation warning)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002152 "A relation that associates a dataset or run with a non-fatal issue raised during a validation check. It flags a concern found while verifying correctness or consistency. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002152 "has validation warning"@en)
SubDataPropertyOf(obo:MOLSIM_002152 obo:MOLSIM_002149)
DataPropertyRange(obo:MOLSIM_002152 xsd:string)

# Data Property: obo:MOLSIM_002153 (has validation error)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002153 "A relation that associates a dataset or run with a fault raised during a validation check that caused the check to fail. It records a validation failure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002153 "has validation error"@en)
SubDataPropertyOf(obo:MOLSIM_002153 obo:MOLSIM_002149)
DataPropertyRange(obo:MOLSIM_002153 xsd:string)

# Data Property: obo:MOLSIM_002154 (consistency check result)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002154 "A relation that associates a dataset or run with the outcome of a check verifying that its data are mutually consistent. It records whether internal consistency tests passed or failed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002154 "consistency check result"@en)
SubDataPropertyOf(obo:MOLSIM_002154 obo:MOLSIM_002149)
DataPropertyRange(obo:MOLSIM_002154 xsd:string)

# Data Property: owl:topDataProperty (owl:topDataProperty)

DataPropertyDomain(owl:topDataProperty obo:MOLSIM_001887)

############################
#   Classes
############################

# Class: obo:MOLSIM_000000 (molecular dynamics process)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000000 "A sequence of related actions or operations performed to achieve a specific outcome in a biomolecular simulation study. This encompasses all stages from initial system setup and simulation execution to final data analysis and interpretation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000000 "molecular dynamics process"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000000 orcid:0000-0002-8291-8071)

# Class: obo:MOLSIM_000001 (software)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000001 "A set of instructions and data that a computer follows to carry out a task. In this field it covers everything from a program that runs a simulation to a small script that converts one file format into another. It is the top of the branch that every named program in this ontology sits somewhere below. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000001 "software"@en)

# Class: obo:MOLSIM_000002 (preparation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000002 "A stage of a simulation study in which the molecular system and its environment are assembled and made ready to run. It covers obtaining a structure, adding the atoms and molecules the experimental structure left out, choosing a force field, adding solvent and ions, and settling the system before data is collected. Most simulations that fail, fail here rather than later. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000002 "preparation"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000002 "simulation preparation"@en)
SubClassOf(obo:MOLSIM_000002 obo:MOLSIM_002156)

# Class: obo:MOLSIM_000003 (execution)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000003 "The stage of a biomolecular simulation process where the main simulation runs are performed according to the prepared system and defined parameters to generate trajectory data. This phase involves propagating the system forward in time using algorithms like molecular dynamics or Monte Carlo, under specific ensemble conditions. The goal is typically to sample conformational space, observe dynamic events, or calculate specific properties like free energies."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000003 "execution"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000003 "simulation execution"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000003 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000003 obo:MOLSIM_002156)

# Class: obo:MOLSIM_000004 (analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000004 "A stage of a simulation study that follows the run, in which the trajectory and energy output are processed into results. It covers everything from measuring a distance to fitting a kinetic model. It is where a simulation becomes a finding rather than a large file. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000004 "analysis"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000004 "simulation analysis"@en)
SubClassOf(obo:MOLSIM_000004 obo:MOLSIM_002156)

# Class: obo:MOLSIM_000005 (protonation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000005 "A specific step within the preparation process where the ionization states (presence or absence of protons) of ionizable residues (like acids, bases, histidines) and ligands are determined and assigned based on estimated pKa values relevant to the target pH of the simulation. Correct protonation is critical for accurately modeling electrostatic interactions and pH-dependent phenomena. Specialized tools are often used for this task. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000005 "protonation"@en)
SubClassOf(obo:MOLSIM_000005 obo:MOLSIM_000002)

# Class: obo:MOLSIM_000006 (model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000006 "A simplified representation used to study a real-world system, such as a molecule or collection of molecules. In biomolecular simulation, it defines the components (atoms, residues) and their properties needed for computational analysis. This framework allows scientists to simulate and predict the system's behavior. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000006 "Distinct from 'MoDEL' (MOLSIM:001001), a named simulation data repository whose name differs from this term only by capitalisation. This term is the general class of representations used in simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000006 "model"@en)

# Class: obo:MOLSIM_000007 (force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000007 "A set of mathematical functions and fitted numbers used to compute the potential energy of a system of atoms from their positions alone. It replaces the electrons of quantum mechanics with terms for bonds, angles, rotations and non-bonded contacts. Everything a classical simulation can and cannot describe follows from it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000007 "FF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000007 "force field"@en)
SubClassOf(obo:MOLSIM_000007 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000008 (lipid  force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000008 "A force field specifically designed and parameterized for simulating lipid molecules and lipid bilayers, crucial components of cell membranes. It aims to accurately capture the unique properties of lipids, including their phase behavior and interactions with other molecules. Examples include LIPID14, LIPID17, and parameters within general force fields like CHARMM36m. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000008 "lipid force field"@en)
SubClassOf(obo:MOLSIM_000008 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000009 (protein force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000009 "A force field specifically designed and parameterized for simulating proteins and peptides, focusing on accurately representing amino acid properties and polypeptide chain behavior. These are crucial for studying protein folding, dynamics, and interactions. Many different protein force fields exist, often differing in their parameterization philosophy and target data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000009 "protein force field"@en)
SubClassOf(obo:MOLSIM_000009 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000010 (DNA force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000010 "A force field specifically developed and parameterized for simulating Deoxyribonucleic Acid (DNA) molecules. It focuses on accurately representing the structure, dynamics, and interactions of DNA bases, sugars, and phosphate backbone, including features like sugar pucker and helical parameters. Accurate DNA force fields are essential for studying DNA replication, transcription, and drug binding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000010 "DNA force field"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000010 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000010 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000011 (RNA force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000011 "A force field specifically developed and parameterized for simulating Ribonucleic Acid (RNA) molecules. It aims to accurately capture the complex conformational landscape and catalytic potential of RNA. Development often focuses on improving descriptions of sugar pucker, backbone torsions (especially the epsilon and zeta angles), and non-canonical base interactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000011 "RNA force field"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000011 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000011 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000012 (carbohydrates force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000012 "A force field specifically designed and parameterized for simulating carbohydrate molecules (sugars or glycans). It addresses the unique challenges of modeling the flexibility of glycosidic linkages between sugar units and the numerous hydrogen bonding possibilities involving hydroxyl groups. These are important for studying glycoproteins, glycolipids, and polysaccharides like cellulose."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000012 "carbohydrates force field"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000012 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000012 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000013 (organic molecule force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000013 "A force field parameterised for small organic molecules, covering the wide range of chemistry found in drug-like compounds. It must handle groups no protein or nucleic acid force field was built for. It is used together with a biomolecular force field when a ligand is simulated in a protein. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000013 "organic molecule force field"@en)
SubClassOf(obo:MOLSIM_000013 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000014 (water model force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000014 "A force field parameterised for water alone, usually representing a molecule by 3 to 5 interaction points with fixed geometry. Water is most of the atoms in a biomolecular simulation, so the choice affects cost as much as accuracy. No model reproduces every measured property of water, so the choice depends on which properties matter for the study. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000014 "water model force field"@en)
SubClassOf(obo:MOLSIM_000014 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000015 (ion force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000015 "A set of parameters specifically developed to describe the interactions of ions (charged atoms or small molecules) within a simulation, typically in conjunction with a specific water model and other biomolecular force fields. These parameters define the ion's charge and non-bonded terms (usually Lennard-Jones parameters for size and interaction strength). Accurate ion parameters are crucial for modeling salt effects, ion channels, and metalloproteins, and often require careful tuning for compatibility with the chosen water model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000015 "ion force field"@en)
SubClassOf(obo:MOLSIM_000015 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000016 (general purpose organic force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000016 "An organic molecule force field designed to give parameters for almost any organic structure, including ones never tested during its development. It achieves that breadth by defining atom types broadly and supplying rules to fill gaps. The parameters it produces are therefore approximate, and are checked rather than trusted for any specific molecule. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000016 "other organic molecules force field"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000016 "general purpose organic force field"@en)
SubClassOf(obo:MOLSIM_000016 obo:MOLSIM_000772)

# Class: obo:MOLSIM_000017 (minimal basis set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000017 "A basis set holding only enough functions to accommodate an atom's electrons in its ground state, with none to spare. Having no spare functions means the electron cloud cannot change shape when a bond forms, so bonding is described poorly. It is used for teaching and for very rough calculations, not for results. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000017 "minimal"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000017 "minimal basis set"@en)
SubClassOf(obo:MOLSIM_000017 obo:MOLSIM_000432)

# Class: obo:MOLSIM_000018 (lipid21)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000018 "A specific version of a lipid force field, part of the AMBER family, providing parameters optimized for simulating lipids. Released around 2021, it incorporates updates and refinements based on contemporary data and methodologies to improve accuracy in membrane simulations. Its name indicates the originating group (AMBER) and year of major update. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000018 "lipid21"@en)
SubClassOf(obo:MOLSIM_000018 obo:MOLSIM_000008)

# Class: obo:MOLSIM_000019 (lipid14)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000019 "A specific lipid force field parameter set developed for the AMBER simulation package, released around 2014. It provides parameters optimized for simulating a range of common lipid types found in biological membranes. This version aimed to improve upon previous lipid models within the AMBER family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000019 "lipid14"@en)
SubClassOf(obo:MOLSIM_000019 obo:MOLSIM_000008)

# Class: obo:MOLSIM_000020 (lipid17)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000020 "A specific lipid force field parameter set developed for the AMBER simulation package, released around 2017. It was built upon the modularity of LIPID14 and provided an extension of modular phospholipid residues to include anionic head groups and polyunsaturated tails."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000020 "lipid17"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000020 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000020 obo:MOLSIM_000008)

# Class: obo:MOLSIM_000021 (amber ff14SB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000021 "A specific protein force field parameter set from the AMBER family (ff), released around 2014, with optimizations primarily for side-chain (S) and backbone (B) torsion angles compared to earlier versions like ff99SB. It was widely adopted for its improved accuracy in representing protein secondary structure and dynamics. It is an all-atom force field."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000021 "AMBER ff14SB"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000021 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000021 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000022 (TIP3P)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000022 "A rigid water model with 3 interaction sites, one on each atom, using the measured geometry of an isolated water molecule. It is the cheapest widely used model and the one the AMBER and CHARMM force fields were fitted alongside. It reproduces density well and diffuses about twice as fast as real water, which matters for any rate taken from a simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000022 "TIP3P"@en)
SubClassOf(obo:MOLSIM_000022 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000023 (general AMBER force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000023 "A force field for small organic molecules, built to be used alongside the AMBER protein and nucleic acid parameters. It defines atom types broadly enough to cover almost any organic structure, and supplies rules for filling gaps where no parameter was fitted. That breadth is why its parameters for any particular molecule should be checked rather than trusted. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000023 "GAFF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000023 "general AMBER force field"@en)
SubClassOf(obo:MOLSIM_000023 obo:MOLSIM_000016)

# Class: obo:MOLSIM_000024 (general AMBER force field 2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000024 "A force field for small organic molecules, refitting the original general AMBER parameters against a larger set of quantum calculations and measurements. It improves the description of rotations and of van der Waals interactions in particular. It is not interchangeable with the first version, so which one was used must be recorded. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000024 "GAFF2"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000024 "general AMBER force field 2"@en)
SubClassOf(obo:MOLSIM_000024 obo:MOLSIM_000016)

# Class: obo:MOLSIM_000025 (mol3 format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000025 "A text-based molecular structure format, similar to the mol2 format, but designed to include additional records for atomic connectivity. It is used to represent chemical structures with an expanded description of their bonding topology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000025 "mol3 format"@en)
SubClassOf(obo:MOLSIM_000025 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000026 (analysis method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000026 "A method for processing the data a simulation produces and extracting something meaningful from it. It turns a trajectory, which is a list of coordinates at successive times, into a quantity that can be compared with an experiment or with another simulation. Almost nothing useful comes out of a simulation without one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000026 "analysis method"@en)
SubClassOf(obo:MOLSIM_000026 obo:MOLSIM_000140)

# Class: obo:MOLSIM_000027 (reaction analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000027 "A specific type of analysis method focused on understanding how chemical reactions occur within the simulated molecular system. It involves characterizing the pathways, transition states, and energy changes associated with the transformation of reactants into products. This helps elucidate reaction mechanisms and kinetics at the molecular level."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000027 "reaction analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000027 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000027 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000028 (coordinate analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000028 "A subset of reaction analysis that uses the positions (coordinates) of atoms to describe the progress of a chemical reaction or conformational change. It defines one or more geometric variables, collectively known as reaction coordinates, to map the transition pathway between different molecular states. This analysis helps visualize and quantify the structural changes during a reaction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000028 "coordinate analysis"@en)
SubClassOf(obo:MOLSIM_000028 obo:MOLSIM_000027)

# Class: obo:MOLSIM_000029 (direct reaction coordinate analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000029 "A type of coordinate analysis where the reaction progress is described using simple, intuitive geometric parameters like bond distances, angles, or dihedrals directly involved in the transformation. This provides a straightforward way to monitor specific structural changes assumed to be representative of the reaction pathway."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000029 "direct reaction coordinate analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000029 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000029 obo:MOLSIM_000028)

# Class: obo:MOLSIM_000030 (water type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000030 "OBSOLETE. Refers to specific parameterizations or types of water models commonly used in biomolecular simulations, often used somewhat interchangeably with 'water model'. Each 'water type' (e.g., SPC, TIP3P, TIP4P-Ew) defines the geometry, number of interaction sites, and associated parameters (charges, Lennard-Jones) for representing water molecules. The choice significantly influences simulation outcomes, particularly solvation effects and dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000030 "obsolete water type"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000030 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000030 "Retired 2026-08-24. Its own definition described it as 'often used somewhat interchangeably with water model', and that is what it was: a second home for water models alongside MOLSIM:000014 water model force field, which holds all 18. Its two children were re-parented rather than replaced, so there is no single successor. MOLSIM:000031 optimal point charges moved to MOLSIM:000014 beside OPC3, and MOLSIM:000476 TIP3P water model was retired as a duplicate of MOLSIM:000022 TIP3P.")

# Class: obo:MOLSIM_000031 (OPC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000031 "A rigid four-site water model whose partial charges and geometry were optimised together to reproduce bulk properties of liquid water, including the density, the heat of vaporisation and the dielectric constant. It reproduces several of those properties more closely than the older three-site and four-site models at a similar computational cost. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000031 "optimal point charges"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000031 "OPC"@en)
SubClassOf(obo:MOLSIM_000031 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000032 (box type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000032 "Specifies the geometric shape of the simulation cell used under periodic boundary conditions (PBCs), which replicate the central simulation system in three dimensions to mimic a bulk environment and avoid surface effects. The choice of shape (e.g., cubic, truncated octahedron, rhombic dodecahedron) affects the computational efficiency (volume of solvent needed) and how well the unit cell packs space. It determines the distance and geometry for interactions between a particle and its periodic images."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000032 "box type"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000032 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000032 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000033 (rhombic dodecahedron)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000033 "A specific type of simulation box shape corresponding to a dodecahedron with rhombus-shaped faces. It is one of the space-filling polyhedra that is closer to a sphere than a cube, thus often requiring less solvent volume (and fewer solvent molecules) to solvate a roughly spherical solute while maintaining a minimum distance to the periodic images. It can offer computational savings compared to a cubic box of similar minimum image distance."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000033 "rhombic dodecahedron"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000033 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000033 obo:MOLSIM_000032)

# Class: obo:MOLSIM_000034 (truncated octahedron)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000034 "A specific type of simulation box shape created by cutting off the corners of an octahedron. Like the rhombic dodecahedron, it is a space-filling polyhedron that approximates a sphere more closely than a cube, reducing the required solvent volume for solvating non-cubic solutes under periodic boundary conditions. It offers similar computational efficiency benefits as the rhombic dodecahedron for many systems."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000034 "truncated octahedron"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000034 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000034 obo:MOLSIM_000032)

# Class: obo:MOLSIM_000035 (hexagonal prism)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000035 "A simulation box shape consisting of a hexagonal base extruded along a perpendicular axis. This shape is sometimes used for systems with inherent one-dimensional periodicity or symmetry, such as fibers (like DNA) or layered systems, where periodic boundary conditions are naturally applied across the hexagonal faces and along the prism axis. Its use is less common than cubic or truncated octahedral boxes for general globular protein simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000035 "hexagonal prism"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000035 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000035 obo:MOLSIM_000032)

# Class: obo:MOLSIM_000036 (rectangular/cubic)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000036 "The simplest simulation box shape, defined by three mutually perpendicular axes (orthogonal box). If all edge lengths are equal, it is cubic; otherwise, it is rectangular (also called orthorhombic or cuboid). While straightforward to implement and visualize, cubic boxes can be inefficient for solvating non-cubic solutes, often requiring significantly more solvent molecules than more spherically approximating shapes like the truncated octahedron to achieve the same minimum distance between periodic images."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000036 "rectangular/cubic"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000036 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000036 obo:MOLSIM_000032)

# Class: obo:MOLSIM_000037 (algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000037 "A well-defined sequence of steps or rules designed to perform a specific task or solve a particular problem. In computational science, algorithms provide the precise instructions for a computer to follow to achieve a desired outcome, such as simulating molecular motion or analyzing data. They are the fundamental building blocks of computational methods used in biomolecular simulation and analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000037 "algorithm"@en)

# Class: obo:MOLSIM_000038 (thermostat algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000038 "An algorithm used in molecular dynamics simulations to control the temperature of the simulated system, ensuring it samples configurations corresponding to a specific target temperature (e.g., for the NVT or NPT ensembles). Thermostats work by adjusting particle velocities or adding/removing kinetic energy in various ways to mimic coupling with an external heat bath. Different thermostat algorithms vary in their theoretical basis, efficiency, and how accurately they reproduce correct statistical mechanics. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000038 "thermostat algorithm"@en)
SubClassOf(obo:MOLSIM_000038 obo:MOLSIM_000382)

# Class: obo:MOLSIM_000039 (barostat algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000039 "An algorithm used in molecular dynamics simulations, typically alongside a thermostat, to control the pressure of the simulated system by adjusting the simulation box volume. This allows simulations to be performed under conditions of constant pressure and temperature (NPT ensemble), mimicking typical laboratory conditions. Different barostats vary in how they couple the volume changes to the pressure difference and whether they allow anisotropic box changes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000039 "barostat algorithm"@en)
SubClassOf(obo:MOLSIM_000039 obo:MOLSIM_000382)

# Class: obo:MOLSIM_000040 (Berendsen barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000040 "A barostat algorithm that weakly couples the system to an external pressure bath by rescaling the simulation box volume and particle coordinates based on the difference between the current instantaneous pressure and the target pressure. Similar to the Berendsen thermostat, it is computationally simple and effective for equilibration but does not rigorously sample the correct NPT ensemble. It allows isotropic or anisotropic pressure coupling. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000040 "Berendsen barostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000040 "barostat=1")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000040 "pcoupl=Berendsen")
SubClassOf(obo:MOLSIM_000040 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000041 (Monte Carlo barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000041 "A barostat algorithm where trial changes to the simulation box volume are attempted periodically during a molecular dynamics simulation using a Monte Carlo acceptance criterion. Accepted moves rescale the box dimensions and particle coordinates. This method correctly samples the NPT ensemble but can be less efficient than continuous barostats for large volume fluctuations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000041 "Monte Carlo barostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000041 "barostat=2")
SubClassOf(obo:MOLSIM_000041 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000042 (Andersen barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000042 "A barostat algorithm where the simulation box volume is treated as a dynamic variable coupled to a fictitious \"piston\" mass, interacting with the internal pressure of the system. This extended Lagrangian approach allows the volume to fluctuate dynamically around the value corresponding to the target external pressure, correctly generating the NPT ensemble. It typically assumes isotropic volume changes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000042 "Andersen barostat"@en)
SubClassOf(obo:MOLSIM_000042 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000043 (Parrinello-Rahman barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000043 "An extension of the Andersen barostat that allows the simulation box shape and volume to change anisotropically, meaning the lengths of the box edges and the angles between them can fluctuate independently. This is crucial for simulating phase transitions or studying materials under anisotropic stress conditions while correctly sampling the NPT ensemble. It uses a matrix of barostat variables coupled to the pressure tensor. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000043 "Parrinello-Rahman barostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000043 "pcoupl=Parrinello-Rahman")
SubClassOf(obo:MOLSIM_000043 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000044 (Langevin-piston barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000044 "A barostat algorithm that combines the extended Lagrangian approach (like Andersen or Parrinello-Rahman) with Langevin dynamics applied to the piston/box degrees of freedom. This introduces stochastic and frictional terms to the equation of motion for the box volume, helping to control pressure fluctuations and potentially improving sampling efficiency. It aims to provide robust pressure control while correctly sampling the NPT ensemble. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000044 "Langevin-piston barostat"@en)
SubClassOf(obo:MOLSIM_000044 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000045 (Langevin thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000045 "A Langevin thermostat is a widely used algorithm in molecular dynamics simulations that maintains a constant temperature by mimicking a solvent environment. It modifies Newton's equations of motion by adding two forces to each particle: a frictional drag force that removes kinetic energy, and a random, stochastic force that adds kinetic energy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000045 "Langevin thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000045 "ntt=3")
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000045 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000045 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000046 (Berendsen thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000046 "A thermostat algorithm that weakly couples the system to an external heat bath by rescaling particle velocities at each step based on the difference between the current instantaneous temperature and the target temperature. While computationally simple and effective at bringing the system to the target temperature, it does not rigorously generate configurations from the correct canonical (NVT) ensemble. It is often used for equilibration phases rather than production simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000046 "Berendsen thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000046 "ntt=1")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000046 "tcoupl=berendsen")
SubClassOf(obo:MOLSIM_000046 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000047 (Andersen thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000047 "A thermostat algorithm that maintains temperature by introducing stochastic collisions between randomly selected particles and fictitious heat bath particles. When a particle \"collides,\" its velocity is reassigned from a Maxwell-Boltzmann distribution corresponding to the target temperature. This method correctly generates configurations from the canonical (NVT) ensemble. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000047 "Andersen thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000047 "tcoupl=andersen")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000047 "ntt=2")
SubClassOf(obo:MOLSIM_000047 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000048 (Nosé-Hoover thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000048 "A deterministic thermostat algorithm that controls temperature by introducing an extended degree of freedom (a thermostat variable) that dynamically couples to the physical system's kinetic energy. This extended variable evolves according to its own equation of motion, causing the physical system's temperature to fluctuate around the target value in a way consistent with the canonical (NVT) ensemble. It avoids the stochastic elements of Langevin or Andersen thermostats. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000048 "Nose-Hoover"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000048 "Nosé-Hoover thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000048 "tcoupl=nose-hoover")
SubClassOf(obo:MOLSIM_000048 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000049 (constraint algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000049 "An algorithm used in molecular dynamics simulations to fix certain geometric parameters, most commonly bond lengths involving light atoms like hydrogen. By constraining these fast vibrations, longer simulation time steps can be used, significantly speeding up the simulation while having minimal impact on slower, large-scale motions. These algorithms iteratively adjust particle positions or use analytical solutions to satisfy the constraint conditions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000049 "constraint algorithm"@en)
SubClassOf(obo:MOLSIM_000049 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000050 (SHAKE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000050 "An iterative constraint algorithm widely used in molecular dynamics to fix bond lengths. It adjusts the positions of atoms involved in a constraint at the end of a time step until the constraint condition (e.g., fixed bond distance) is satisfied within a defined tolerance. It handles coupled constraints involving multiple atoms connected together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000050 "SHAKE algorithm"@en)
SubClassOf(obo:MOLSIM_000050 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000051 (RATTLE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000051 "A constraint algorithm similar to SHAKE but designed for velocity-Verlet type integrators, ensuring that both positions and velocities satisfy the constraint conditions at the end of each time step. It involves solving constraint equations for positions first, then using those positions to solve for constrained velocities. This maintains consistency between positions and velocities under constraint. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000051 "RATTLE algorithm"@en)
SubClassOf(obo:MOLSIM_000051 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000052 (LINCS algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000052 "A constraint algorithm that holds bond lengths fixed by correcting the positions after each integration step, solving the constraint equations directly rather than by repeated adjustment. Being non-iterative makes it fast and makes its cost predictable. It is the constraint algorithm GROMACS uses by default. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000052 "LINCS"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000052 "linear constraint solver algorithm"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000052 "LINCS algorithm"@en)
SubClassOf(obo:MOLSIM_000052 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000053 (electrostatic interaction algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000053 "An algorithm designed to efficiently calculate the long-range electrostatic forces between charged particles (atoms) in molecular simulations, which is computationally demanding due to the N-squared complexity if all pairs are considered directly. These methods employ various approximations or techniques like grid-based calculations, truncation schemes, or multipole expansions to reduce the computational cost while maintaining acceptable accuracy. They are essential for simulating realistic biomolecular systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000053 "electrostatic interaction algorithm"@en)
SubClassOf(obo:MOLSIM_000053 obo:MOLSIM_000384)

# Class: obo:MOLSIM_000054 (particle mesh Ewald)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000054 "A highly efficient grid-based algorithm for calculating long-range electrostatic interactions in periodic systems, based on the Ewald summation technique. It splits the calculation into a short-range part computed directly in real space and a long-range part computed efficiently in reciprocal space using Fast Fourier Transforms (FFTs) on a grid. PME is a standard method for accurate electrostatics in biomolecular simulations. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000054 "PME"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000054 "particle mesh Ewald"@en)
SubClassOf(obo:MOLSIM_000054 obo:MOLSIM_000428)

# Class: obo:MOLSIM_000055 (reaction field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000055 "An approximate method for handling long-range electrostatic interactions where direct interactions are calculated only up to a certain cutoff distance. The effect of charges beyond the cutoff is approximated by embedding the cutoff sphere within a continuous dielectric medium representing the solvent. While computationally cheaper than PME, its accuracy depends on the system and parameters chosen. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000055 "RF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000055 "reaction field"@en)
SubClassOf(obo:MOLSIM_000055 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000056 (particle-particle particle-mesh)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000056 "An efficient algorithm for calculating long-range forces (like electrostatic or gravitational) in particle simulations, conceptually similar to Particle Mesh Ewald (PME). It splits the force calculation into a short-range part computed directly between nearby particles (particle-particle) and a long-range part computed using a grid and Fast Fourier Transforms (particle-mesh). PPPM is widely used in both astrophysics and molecular simulation for its performance and accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000056 "P3M"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000056 "PPPM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000056 "particle-particle particle-mesh"@en)
SubClassOf(obo:MOLSIM_000056 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000057 (interaction type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000057 "Refers to the classification of forces or potential energy contributions that describe how particles (atoms, ions, coarse-grained beads) affect each other within a simulation's model or force field. These types determine the structure, dynamics, and thermodynamics of the simulated system according to the chosen model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000057 "interaction type"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000057 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000057 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000058 (long range interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000058 "An interaction between particles where the force or potential energy diminishes slowly with increasing distance, typically decaying as r^−n where n≤3 (e.g., electrostatic interactions decaying as 1/r). Because their influence extends significantly far, these interactions necessitate special computational techniques (like Particle Mesh Ewald (PME) or Ewald sums) in simulations using periodic boundary conditions to accurately account for contributions beyond a simple distance cutoff. They are crucial for the behavior of charged or polar molecules in condensed phases. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000058 "long range interaction"@en)
SubClassOf(obo:MOLSIM_000058 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000059 (short range interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000059 "An interaction between particles where the force or potential energy decreases rapidly with increasing distance, becoming negligible beyond a certain range (typically a few molecular diameters). Van der Waals interactions (often modeled with Lennard-Jones potentials decaying as 1/(r^6) for attraction) are the primary example. These interactions can often be computationally truncated using a cutoff radius in simulations without significant loss of accuracy, improving efficiency. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000059 "short range interaction"@en)
SubClassOf(obo:MOLSIM_000059 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000060 (specific interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000060 "An interaction whose strength and occurrence depend critically on the specific chemical identities, geometries, and relative orientations of the interacting partners. These often involve directional components and chemical complementarity, such as hydrogen bonds, salt bridges (ionic interactions), or π-stacking, playing key roles in molecular recognition, binding specificity, and defined structural motifs. They contrast with more general, less directional interactions like isotropic Van der Waals forces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000060 "specific interaction"@en)
SubClassOf(obo:MOLSIM_000060 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000061 (non specific interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000061 "An interaction energy arising from forces that depend little on the chemical identity or the orientation of the groups involved, chiefly dispersion attraction and excluded-volume repulsion. These forces act between almost any pair of atoms, so they set overall cohesion and packing rather than specific recognition. They are what drives the hydrophobic effect. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000061 "non specific interaction energy"@en)
SubClassOf(obo:MOLSIM_000061 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000062 (non-covalent interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000062 "An interaction between atoms, ions, or molecules that does not involve the sharing of valence electrons to form a covalent bond. These interactions, including Van der Waals forces, electrostatic interactions (encompassing hydrogen bonds, salt bridges, dipole interactions), π-effects, and hydrophobic effects, govern molecular recognition, self-assembly, folding, and the stability of biomolecular complexes. Though individually weaker than covalent bonds (typically 0.1-10 kcal/mol vs >50 kcal/mol), their cumulative effect is critical for biological structure and function. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000062 "non-covalent interaction"@en)
SubClassOf(obo:MOLSIM_000062 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000063 (covalent interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000063 "An interaction in which atoms share valence electrons, forming the bonds that hold a molecule together. It is far stronger than any non-bonded interaction, which is why bonds do not break at ordinary temperatures. A classical force field represents it as a fixed connection rather than describing the sharing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000063 "covalent interaction"@en)
SubClassOf(obo:MOLSIM_000063 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000064 (Van der Waals interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000064 "A short-range non-covalent interaction between atoms or molecules arising from temporary fluctuations in electron distribution causing transient dipoles (London dispersion forces) and interactions involving permanent or induced multipoles, counteracted by strong short-range repulsion due to overlapping electron clouds (Pauli exclusion principle). Commonly modeled using potentials like the Lennard-Jones 6-12 potential. These interactions determine molecular size, shape, packing efficiency, and contribute to binding affinity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000064 "Van der Waals interaction"@en)
SubClassOf(obo:MOLSIM_000064 obo:MOLSIM_000062)

# Class: obo:MOLSIM_000065 (solvation model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000065 "A model that represents the effect of the surrounding solvent on a solute in a simulation. It may include individual solvent molecules explicitly, or replace them with a continuous medium carrying averaged properties. The choice sets both the cost of the simulation and which solvent effects can appear in the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000065 "solvation model"@en)
SubClassOf(obo:MOLSIM_000065 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000066 (explicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000066 "A solvation model where individual solvent molecules (e.g., water molecules represented by a specific water model like TIP3P or SPC/E) are explicitly included in the simulation system alongside the solute molecule(s). This approach provides the most detailed, atomistic representation of solute-solvent interactions, capturing specific hydrogen bonding patterns, local solvent structure, and dynamic effects. However, it significantly increases the system size and computational expense due to the large number of solvent particles that must be simulated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000066 "explicit solvent model"@en)
SubClassOf(obo:MOLSIM_000066 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000067 (water model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000067 "OBSOLETE. Within the context of solvation models, this typically refers to the use of an explicit solvent model where the solvent is specifically water, represented using a particular force field parameter set (e.g., TIP3P, SPC/E, TIP4P-Ew). This distinguishes it from implicit solvation approaches or explicit simulations using non-aqueous solvents. The term emphasizes that water molecules are being directly simulated using a chosen set of parameters defining their interactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000067 "obsolete water model"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000067 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000067 obo:MOLSIM_000014)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000067 "Retired 2026-08-24. It named a water model but held none: all 18 sit under MOLSIM:000014 water model force field, which its own definition pointed at by naming TIP3P, SPC/E and TIP4P-Ew as the parameter sets involved. The distinction it was reaching for, explicit solvation with water specifically, is already carried by MOLSIM:000066 explicit solvent model, whose definition names the same models. It was also asserted disjoint from MOLSIM:000066, which was wrong, since explicit water is a kind of explicit solvent rather than something separate from it.")

# Class: obo:MOLSIM_000068 (implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000068 "A solvation model that approximates the average effect of the solvent environment without explicitly representing individual solvent molecules. Instead, the solvent is treated as a continuous medium characterized by macroscopic properties, primarily its dielectric constant (ϵ) to account for electrostatic screening, and sometimes surface tension to account for nonpolar effects like cavity formation. Common examples include Generalized Born (GB) models and methods based on solving the Poisson-Boltzmann (PB) equation, often combined with a surface area term (SASA); these significantly reduce computational cost compared to explicit solvent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000068 "implicit solvent model"@en)
SubClassOf(obo:MOLSIM_000068 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000069 (hybrid solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000069 "A solvation modeling approach that combines elements of both explicit and implicit solvent representations within the same simulation. Typically, a limited number of explicit solvent molecules are retained in a specific region of interest deemed critical (e.g., the active site of an enzyme, the first solvation shell around a solute), while the bulk solvent further away is represented using an implicit continuum model. This strategy aims to capture detailed local solvent effects accurately while maintaining computational efficiency by treating the less critical bulk solvent implicitly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000069 "hybrid solvent model"@en)
SubClassOf(obo:MOLSIM_000069 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000070 (coarse grained solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000070 "A solvent model designed for compatibility with coarse-grained (CG) solute force fields, where the solvent representation is also simplified to match the reduced resolution of the solute. This can involve explicit CG solvent particles where each particle represents multiple (e.g., 3-4) real water molecules (like MARTINI water), or implicit CG solvent models that adapt continuum concepts to the coarse-grained scale. These models drastically reduce the number of degrees of freedom associated with the solvent, enabling simulations of very large systems or very long timescales. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000070 "coarse grained solvent model"@en)
SubClassOf(obo:MOLSIM_000070 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000071 (machine learning solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000071 "An emerging class of solvation models where the complex relationship between a solute's structure/properties and its solvation free energy (or related solvent effects) is learned using machine learning (ML) algorithms. These algorithms are trained on large datasets generated from high-fidelity sources like explicit solvent simulations, quantum mechanical calculations, or experimental data. ML solvent models aim to achieve high accuracy approaching that of the training data but at a significantly reduced computational cost, potentially bridging the gap between fast implicit models and expensive explicit models. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000071 "machine learning solvent model"@en)
SubClassOf(obo:MOLSIM_000071 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000072 (quantum mechanical solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000072 "A solvation model where the electronic structure of the solvent, or its interaction with the solute, is treated using quantum mechanics (QM). This can range from embedding a QM description of the solute within a classical solvent model (either implicit or explicit) using QM/MM techniques, to treating a number of explicit solvent molecules quantum mechanically along with the solute, or using implicit solvent models derived from QM principles (like the SMD model). These models capture electronic polarization, charge transfer, and other quantum effects involving the solvent, providing high accuracy but at a very high computational cost, reserved for specific problems like chemical reactions in solution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000072 "quantum mechanical solvent model"@en)
SubClassOf(obo:MOLSIM_000072 obo:MOLSIM_000065)

# Class: obo:MOLSIM_000073 (generalized Born)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000073 "A specific type of implicit solvent model that provides an analytical approximation to the electrostatic component of the solvation free energy, based on the Born model for solvation of a spherical ion. It calculates effective Born radii for each atom in the solute, representing the degree of solvent exposure, and uses these radii in a formula that approximates the electrostatic polarization energy typically calculated by solving the more complex Poisson-Boltzmann equation. GB models are computationally much faster than PB methods, making them popular for applications like MD simulations or energy minimization, often paired with a surface area term (GBSA). (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000073 "GB"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000073 "generalized Born"@en)
SubClassOf(obo:MOLSIM_000073 obo:MOLSIM_000068)

# Class: obo:MOLSIM_000074 (similarity calculation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000074 "An algorithm used to quantify the degree of resemblance between two objects, often molecules represented by chemical fingerprints or structural features, or between simulation data like conformations or trajectories. These methods employ various mathematical formulas (metrics or coefficients) to compute a numerical score indicating similarity or distance. They are widely used in cheminformatics, drug discovery, and simulation analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000074 "similarity calculation algorithm"@en)
SubClassOf(obo:MOLSIM_000074 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000075 (Tanimoto similarity algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000075 "An algorithm that measures how similar 2 molecules are by comparing the sets of features each carries, as the number of features they share divided by the number either one has. The result runs from 0 for no shared features to 1 for identical sets. It is the standard measure used with molecular fingerprints, where the features are substructures present in the molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000075 "Tanimoto similarity algorithm"@en)
SubClassOf(obo:MOLSIM_000075 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000076 (Tversky index algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000076 "A molecular similarity measure that compares two molecular structures by calculating their overlap while allowing asymmetric weighting through parameters α and β. The measure ranges from 0 (completely different) to 1 (identical), and can be adjusted to emphasize either the reference or query molecule in the comparison. It is particularly useful in molecular screening as it can identify both substructure and superstructure relationships between molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000076 "Tversky index algorithm"@en)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_000076 "General form, for reference: T(A,B) = |A n B| / (alpha*|A - B| + beta*|B - A| + |A n B|), where A and B are the feature sets of the two molecules being compared. alpha weights features unique to A (the reference) and beta weights features unique to B (the query or fit molecule); alpha = beta = 1 reduces to the Tanimoto coefficient, and alpha = beta = 0.5 gives the Dice coefficient. The named variants below differ only in their fixed alpha/beta values, which each of their definitions states. Note this text is a plain-string note: no OWL consumer renders mathematical notation, so it is written to be readable as-is rather than as LaTeX. Requested in GitHub issue #1."@en)
SubClassOf(obo:MOLSIM_000076 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000077 (Dice coefficient algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000077 "A similarity calculation method used to compare two sets (e.g., features in molecular fingerprints), closely related to the Tanimoto coefficient and Jaccard index. It measures the overlap between the sets, normalized by the average size of the two sets. It is often used in information retrieval and cheminformatics as an alternative similarity metric. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000077 "Dice coefficient algorithm"@en)
SubClassOf(obo:MOLSIM_000077 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000078 (Euclidean distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000078 "A type of statistical property representing the straight-line distance between two points in a multi-dimensional space, which may represent molecules in a property space or conformations by atom coordinates. It is calculated as the square root of the sum of squared differences between corresponding coordinates or features. Lower Euclidean distance implies higher similarity in the context of the chosen space. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000078 "Euclidean distance"@en)
SubClassOf(obo:MOLSIM_000078 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_000078 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_000078 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_000079 (Manhattan distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000079 "A type of statistical property representing the distance between two points in a multi-dimensional space, calculated as the sum of the absolute differences of their coordinates. The Manhattan distance is an alternative to the Euclidean distance for measuring similarity in clustering and data analysis. This is also known as the city block distance. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000079 "Manhattan distance"@en)
SubClassOf(obo:MOLSIM_000079 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_000079 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_000079 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_000080 (distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000080 "A type of `structural property` that represents the separation between two specified atoms or centers of mass. It is a fundamental geometric measure used to monitor interactions like hydrogen bonds, salt bridges, or the separation between molecular components. Analysis outputs frequently report `distance` values over time. This value is commonly referred to as `dist` in analysis scripts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000080 "distance"@en)
SubClassOf(obo:MOLSIM_000080 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_000080 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_000080 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_000081 (Hamming distance algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000081 "A similarity calculation method specifically used for comparing two strings or bit vectors (like binary molecular fingerprints) of equal length. It counts the number of positions at which the corresponding symbols or bits are different. A lower Hamming distance indicates higher similarity between the binary representations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000081 "Hamming distance algorithm"@en)
SubClassOf(obo:MOLSIM_000081 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000082 (Jaccard index algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000082 "A similarity calculation method used for comparing two sets, defined as the size of the intersection divided by the size of the union of the sets. It is identical to the Tanimoto coefficient when applied to binary data (like molecular fingerprints). It provides a normalized measure of overlap between feature sets, ranging from 0 (no overlap) to 1 (identical sets). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000082 "Jaccard index algorithm"@en)
SubClassOf(obo:MOLSIM_000082 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000083 (overlap coefficient algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000083 "A similarity calculation method that measures the overlap between two sets, defined as the size of the intersection divided by the size of the smaller of the two sets. Unlike Tanimoto/Jaccard, it reaches 1 if one set is a subset of the other. It is useful for assessing containment or sub-structure relationships. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000083 "overlap coefficient algorithm"@en)
SubClassOf(obo:MOLSIM_000083 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000084 (fit Tversky combo)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000084 "A comprehensive molecular similarity measure that combines FitTversky shape matching with FitColorTversky chemical feature matching into a single metric. This measure emphasizes the database (fit) molecule's characteristics through its high β parameter value (0.95), making it particularly useful for identifying compounds where the query molecule is a substructure of database molecules. Like RefTverskyCombo, it produces scores typically ranging from 0 to 2, providing a balanced assessment of both geometric shape and chemical functionality similarities. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000084 "fit Tversky combo"@en)
SubClassOf(obo:MOLSIM_000084 obo:MOLSIM_000076)

# Class: obo:MOLSIM_000085 (ref Tversky)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000085 "A specialized variant of the Tversky Index that uses fixed parameters with the alpha (α) value of 0.95, and beta (β) value of 0.05 to heavily weight the reference molecule in the comparison. This asymmetric weighting makes it particularly effective at finding molecules that contain the reference structure as a substructure. RefTversky is commonly used in virtual screening to identify compounds that preserve key structural features of a reference molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000085 "ref Tversky"@en)
SubClassOf(obo:MOLSIM_000085 obo:MOLSIM_000076)

# Class: obo:MOLSIM_000086 (combo score algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000086 "A general term for a similarity score obtained by combining results from multiple different similarity calculation methods or metrics. The rationale is often to capture different aspects of similarity (e.g., structural, feature-based) into a single, potentially more informative score. The specific combination formula and constituent metrics define the particular combo score. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000086 "combo score algorithm"@en)
SubClassOf(obo:MOLSIM_000086 obo:MOLSIM_000074)

# Class: obo:MOLSIM_000087 (optimal transformation path algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000087 "An algorithm designed to find the best path or connection between states or nodes according to some defined criteria, such as minimum cost, shortest distance, or maximum flow. These algorithms are used in various contexts, including finding minimum energy pathways for reactions, constructing minimum spanning trees for clustering, optimizing network routes, or solving complex search problems. They employ different strategies ranging from exact graph traversals to heuristic searches. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000087 "optimal transformation path algorithm"@en)
SubClassOf(obo:MOLSIM_000087 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000088 (Kruskal's algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000088 "A greedy algorithm used to find a Minimum Spanning Tree (MST) for a connected, undirected graph with weighted edges. An MST connects all vertices together with the minimum possible total edge weight. Kruskal's algorithm iteratively adds the lowest-weight edge that does not form a cycle until all vertices are connected."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000088 "Kruskal's algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000088 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000088 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000089 (Prim's algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000089 "An algorithm that finds the cheapest set of connections joining every node of a network, by starting from one node and repeatedly adding the cheapest link to a node not yet reached. The result is a tree touching every node with no redundant links. In this field it is used to build the shortest paths connecting conformations in a clustering. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000089 "Prim's algorithm"@en)
SubClassOf(obo:MOLSIM_000089 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000090 (Dijkstra's algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000090 "An algorithm for finding the shortest path between a starting node and all other nodes in a graph with non-negative edge weights. It works by iteratively exploring the graph, maintaining the shortest distance found so far to each node, and always extending the path from the node with the current shortest distance. It is fundamental in graph theory and network routing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000090 "Dijkstra's algorithm"@en)
SubClassOf(obo:MOLSIM_000090 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000091 (A* search algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000091 "An informed search algorithm used for finding the shortest path between a starting node and a target node in a graph, commonly used in pathfinding and planning problems. It extends Dijkstra's algorithm by using a heuristic function to estimate the cost from the current node to the target, guiding the search towards the goal more efficiently. Its performance depends on the quality of the heuristic used. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000091 "A-star search algorithm"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000091 "A* search algorithm"@en)
SubClassOf(obo:MOLSIM_000091 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000092 (nearest neighbor algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000092 "An algorithm that answers a question about a point by looking at whichever recorded points lie closest to it. It is used to classify, to cluster, and to build lists of which atoms are near enough to interact. It makes no assumption about the shape of the data, only that closeness is meaningful. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000092 "nearest neighbor algorithm"@en)
SubClassOf(obo:MOLSIM_000092 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000093 (genetic algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000093 "A class of heuristic optimization algorithms inspired by the process of natural selection and evolution. They maintain a population of candidate solutions (chromosomes) that evolve over generations through processes like selection, crossover (recombination), and mutation, guided by a fitness function that evaluates solution quality. Genetic algorithms are often used for complex optimization problems where exact methods are infeasible. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000093 "genetic algorithm"@en)
SubClassOf(obo:MOLSIM_000093 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000094 (simulated annealing algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000094 "A probabilistic heuristic algorithm used for finding the global optimum of a function in a large search space, inspired by the annealing process in metallurgy. It starts with an initial solution and iteratively explores neighboring solutions, accepting worse solutions with a probability that decreases over time (controlled by a \"temperature\" parameter), allowing it to escape local optima. It is a metaheuristic for global optimization. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000094 "simulated annealing algorithm"@en)
SubClassOf(obo:MOLSIM_000094 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000095 (ant colony optimization algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000095 "A probabilistic heuristic algorithm for finding good paths through graphs, inspired by the foraging behavior of ants who deposit pheromones. Artificial ants construct candidate solutions (paths) by moving through the graph, probabilistically choosing edges based on distance and accumulated artificial pheromone trails, which are updated based on the quality of solutions found. It is often applied to combinatorial optimization problems like the Traveling Salesperson Problem. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000095 "ant colony optimization algorithm"@en)
SubClassOf(obo:MOLSIM_000095 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000096 (network flow algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000096 "A class of algorithms designed to solve problems related to flows in networks (graphs where edges have capacities), such as finding the maximum flow possible between a source and a sink node. Examples include the Ford-Fulkerson algorithm and its variations (e.g., Edmonds-Karp). These algorithms are used in logistics, scheduling, network design, and resource allocation problems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000096 "network flow algorithm"@en)
SubClassOf(obo:MOLSIM_000096 obo:MOLSIM_000087)

# Class: obo:MOLSIM_000097 (NetCDF trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000097 "A binary trajectory format based on the NetCDF standard, used by the Amber simulation package. It efficiently stores atomic coordinates, velocities, forces, and periodic box dimensions from a simulation. This is the modern, recommended trajectory format for Amber."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000097 "AMBER NetCDF trajectory format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000097 "AMBER nc format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000097 "In the vast majority of scientific applications, including molecular dynamics, climate science, and oceanography, a .nc file is a NetCDF file. There is no difference in the format itself. The .nc extension is simply the most common file name suffix for a file written using the NetCDF data model. (UNVERFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000097 "NetCDF trajectory format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000097 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000097 obo:MOLSIM_000844)
SubClassOf(obo:MOLSIM_000097 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000098 (ligand state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000098 "Refers to the specific characteristics of a ligand molecule, particularly in the context of its interaction with a receptor molecule (like a protein). This encompasses various aspects, including whether it is bound or unbound, its specific binding pose or conformation, its protonation or tautomeric form, and its electronic state."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000098 "ligand state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000098 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000098 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000099 (bound state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000099 "The state in which a ligand molecule is physically associated with its receptor molecule, typically residing within a specific binding site or pocket, stabilized by non-covalent interactions. Simulations often aim to characterize the structure, dynamics, and interaction energy of the ligand within the bound state, or calculate the free energy difference between the bound and unbound states (binding free energy)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000099 "bound state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000099 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000099 obo:MOLSIM_000098)

# Class: obo:MOLSIM_000100 (unbound state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000100 "The state in which a ligand molecule is not associated with the receptor molecule, typically solvated freely in the surrounding solvent or located far from the receptor's binding site. Defining the unbound state is necessary for calculating binding free energies, as it serves as the reference state relative to the bound state. It represents the ligand and receptor separated and independently solvated."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000100 "unbound state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000100 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000100 obo:MOLSIM_000098)

# Class: obo:MOLSIM_000101 (transition state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000101 "In chemical kinetics and simulation, the transition state refers to a specific, high-energy, transient molecular configuration along the reaction coordinate connecting two stable states (e.g., reactant and product, or bound and unbound states). It is connected to the energy barrier that must be overcome for the transition to occur. While challenging to simulate directly due to its short lifetime, characterizing the transition state is crucial for understanding reaction mechanisms and rates, often studied using specialized simulation techniques or QM methods."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000101 "transition state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000101 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000101 obo:MOLSIM_002255)

# Class: obo:MOLSIM_000102 (metastable state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000102 "A state of a system that is locally stable (residing in a minimum on the potential energy surface) but has a higher free energy than the globally stable state. The system can persist in a metastable state for a significant time if the energy barrier to reach a more stable state is high. Examples in biomolecular systems include misfolded protein conformations, transiently bound ligand poses, or specific intermediate states along a functional cycle."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000102 "metastable state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000102 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000102 obo:MOLSIM_002255)

# Class: obo:MOLSIM_000103 (encounter complex)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000103 "A transient state occurring early in the binding process where the ligand and receptor molecules first come into close proximity and make non-specific contacts, largely driven by diffusion, before potentially rearranging into a specific, stable bound state. The encounter complex represents a collection of loosely associated configurations, often characterized by significant residual motion and non-optimal interactions, preceding the formation of the final bound pose."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000103 "encounter complex"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000103 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000103 obo:MOLSIM_000098)

# Class: obo:MOLSIM_000104 (solvated state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000104 "A general state referring to a molecule (either ligand or receptor, or the complex) being surrounded by solvent molecules (typically a water buffer in biological contexts). This term emphasizes the presence and influence of the solvent on the molecule's structure, dynamics, and energetics. Both the bound and unbound states are typically solvated states, and solvation effects are crucial components of binding free energies and conformational preferences."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000104 "solvated state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000104 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000104 obo:MOLSIM_002255)

# Class: obo:MOLSIM_000105 (conformational state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000105 "A specific three-dimensional arrangement or shape adopted by a flexible molecule, such as a protein or ligand. Molecules can typically exist in multiple conformational states, corresponding to different local minima on their potential energy surface, separated by energy barriers. Simulations are often used to explore the accessible conformational states, their relative populations, and the transitions between them, which are essential for molecular function and binding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000105 "conformational state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000105 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000105 obo:MOLSIM_002255)

# Class: obo:MOLSIM_000106 (protonation state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000106 "The condition of a molecule defined by which of its acidic and basic groups currently carry a proton. It fixes the charge on the molecule and therefore how it interacts with everything around it. It depends on the acidity of the surroundings, so a group buried in a protein may differ from the same group in water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000106 "protonation state"@en)
SubClassOf(obo:MOLSIM_000106 obo:MOLSIM_001210)

# Class: obo:MOLSIM_000107 (tautomeric state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000107 "One of several forms of a molecule that differ by the position of a hydrogen atom and an accompanying shift of a double bond, and which interconvert readily. The forms are genuinely different molecules for a simulation, because their bonds and charges differ. Choosing the wrong one for a ligand is a common and silent source of error. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000107 "tautomeric state"@en)
SubClassOf(obo:MOLSIM_000107 obo:MOLSIM_001210)

# Class: obo:MOLSIM_000108 (excited state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000108 "An electronic state of a molecule where one or more electrons have been promoted to higher energy levels than in the ground electronic state, typically following the absorption of light (photoexcitation). Excited states have different electron distributions, geometries, and reactivity compared to the ground state and are central to photochemistry and spectroscopy (like fluorescence). Simulating excited states requires quantum mechanical methods (like TD-DFT or CASSCF) as classical force fields are typically parameterized only for the ground electronic state. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000108 "excited state"@en)
SubClassOf(obo:MOLSIM_000108 obo:MOLSIM_002255)

# Class: obo:MOLSIM_000109 (method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000109 "A method represents the overall strategy or plan that specifies how a scientific objective is to be achieved. In the context of biomolecular science, this high-level concept encompasses both the physical procedures of an experimental method and the abstract protocols of a computational method. Defining the specific method is crucial for establishing the provenance and reproducibility of a result, as it dictates whether the evidence was generated through physical observation or theoretical calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000109 "method"@en)

# Class: obo:MOLSIM_000110 (Euler integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000110 "An integration algorithm that computes the next position and velocity from the current ones and the current force alone. It is the simplest possible scheme and the easiest to reason about. It is not used in practice, because the energy of a system integrated this way drifts steadily upward. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000110 "Euler integrator"@en)
SubClassOf(obo:MOLSIM_000110 obo:MOLSIM_001691)

# Class: obo:MOLSIM_000111 (correlation coefficient)

AnnotationAssertion(owl:deprecated obo:MOLSIM_000111 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000111 "OBSOLETE. A type of statistical property that measures the strength and direction of the linear association between two variables. It is a value between -1 and 1, where 1 indicates a perfect positive correlation and -1 indicates a perfect negative correlation. The correlation coefficient is widely used to identify relationships between different properties in a simulation. This is often reported as r or rho."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000111 obo:STATO_0000142)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000111 "Obsoleted 2026-07-29: duplicated STATO:0000142. STATO is the canonical OBO home for statistics; reused in place of this term. Its four children were re-parented under STATO:0000142 in the same edit - retiring a parent necessarily re-points every child that named it."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000111 "obsolete correlation coefficient"@en)

# Class: obo:MOLSIM_000112 (Pearson's correlation coefficient)

AnnotationAssertion(owl:deprecated obo:MOLSIM_000112 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000112 "OBSOLETE. Pearson's correlation coefficient (often denoted as 'r') measures the strength and direction of the linear relationship between two continuous variables. It assumes the data are approximately normally distributed and calculates the covariance of the two variables divided by the product of their standard deviations. It is perhaps the most widely used measure of linear correlation."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000112 obo:STATO_0000280)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000112 "Obsoleted 2026-07-29: duplicated STATO:0000280. STATO is the canonical OBO home for statistics; reused in place of this term."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000112 "obsolete Pearson's correlation coefficient"@en)

# Class: obo:MOLSIM_000113 (tilt orientation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000113 "A specific type of `orientation` descriptor that represents the cosine of the rotation of a vector orthogonal to a given axis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000113 "tilt orientation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000113 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000113 obo:MOLSIM_001352)

# Class: obo:MOLSIM_000114 (HOLE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000114 "HOLE is a computer program used to analyze the dimensions and shape of internal pathways or tunnels within a biomolecular structure. It operates by computationally squeezing a flexible sphere along a channel axis to determine the maximum pore radius at every point without overlapping the surrounding atoms."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:MOLSIM_000114 "https://doi.org/10.1016/S0263-7855(97)00009-X")
AnnotationAssertion(rdfs:label obo:MOLSIM_000114 "HOLE"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000114 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000114 obo:MOLSIM_000245)

# Class: obo:MOLSIM_000115 (MOLE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000115 "MOLE is a software algorithm designed to automatically locate and characterize channels, tunnels, and pores within protein structures. It utilizes a Voronoi diagram approach to efficiently map the void space inside a molecule and identify paths connecting internal cavities to the surface."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000115 "MOLE"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000115 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000115 obo:MOLSIM_000245)

# Class: obo:MOLSIM_000116 (bootstrap analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000116 "A statistical method that estimates how uncertain a computed quantity is by drawing many new samples from the existing data, with repetition allowed, and recomputing the quantity from each. The spread of those recomputed values estimates the spread the original would have shown across repeated experiments. It needs no assumption about how the data are distributed, which is why it suits simulation output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000116 "bootstrap analysis"@en)
SubClassOf(obo:MOLSIM_000116 obo:MOLSIM_000349)

# Class: obo:MOLSIM_000117 (Markov state model analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000117 "A data analysis method that divides the conformations visited in simulations into discrete states and counts the transitions between them, assuming the next state depends only on the current one and not on the path taken there. That assumption lets many short simulations be stitched into a picture of behaviour far longer than any of them. From it come the slow timescales, the populations of the states, and the routes between them. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000117 "MSM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000117 "Markov state model analysis"@en)
SubClassOf(obo:MOLSIM_000117 obo:MOLSIM_000300)

# Class: obo:MOLSIM_000118 (Jensen-Shannon divergence analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000118 "A statistical measure of how different 2 probability distributions are, bounded between 0 and 1 and giving the same answer whichever distribution is taken first. Those 2 properties are what it adds to the underlying relative entropy measure, which is unbounded and asymmetric. It is used to compare the conformations sampled by 2 simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000118 "Jensen-Shannon divergence analysis"@en)
SubClassOf(obo:MOLSIM_000118 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000119 (Kullback-Leibler divergence)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000119 "A statistical measure of how much information is lost when one probability distribution is used in place of another. It is not symmetric: the value depends on which distribution is treated as the reference. It is 0 only when the 2 are identical and has no upper limit, which is why the symmetric bounded version is often preferred. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000119 "Kullback-Leibler divergence"@en)
SubClassOf(obo:MOLSIM_000119 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_000119 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_000119 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_000120 (dimensionality reduction technique analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000120 "A statistical method that re-expresses data with many variables in terms of a few, chosen to keep as much of the structure as possible. A protein trajectory has 3 coordinates per atom, which cannot be looked at directly. Reducing it to 2 or 3 numbers per frame is what makes it possible to see where the system went. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000120 "dimensionality reduction technique analysis"@en)
SubClassOf(obo:MOLSIM_000120 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000121 (principal component analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000121 "A statistical method that finds the directions along which data vary most, and re-expresses the data in terms of the few largest of them. Applied to a trajectory, the largest directions are the collective motions that account for most of the movement. A protein with thousands of coordinates can then be described by 2 or 3 numbers per frame. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000121 "PCA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000121 "principal component analysis"@en)
SubClassOf(obo:MOLSIM_000121 obo:MOLSIM_000120)

# Class: obo:MOLSIM_000122 (data analysis technique)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000122 "A data analysis technique is a specific computational method used to extract meaningful scientific insights from the raw data generated by a simulation. These techniques can range from simple calculations, like measuring the distance between two atoms over time, to complex statistical methods that identify large-scale molecular motions. Applying these techniques is the crucial step that transforms a trajectory of atomic coordinates into an understandable story about the molecule's behavior."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000122 "data analysis technique"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000122 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000122 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000123 (clustering analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000123 "Clustering analysis encompasses algorithms designed to partition a dataset into distinct groups or clusters, such that data points within the same cluster are more similar to each other than to those in other clusters based on chosen features. In molecular simulation, clustering is frequently applied to trajectory data to identify distinct conformational states visited by the system. Various algorithms exist, differing in how similarity and clusters are defined (e.g., k-means, hierarchical clustering)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000123 "clustering analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000123 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000123 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000124 (statistical test analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000124 "A statistical test is a specific procedure used within the framework of hypothesis testing to decide whether to reject or fail to reject the null hypothesis. It involves calculating a test statistic (a value derived from the sample data) and comparing it to a critical value or calculating a p-value (the probability of observing the data, or more extreme data, if the null hypothesis were true). Examples include t-tests, chi-squared tests, and ANOVA. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000124 "statistical test analysis"@en)
SubClassOf(obo:MOLSIM_000124 obo:MOLSIM_000348)

# Class: obo:MOLSIM_000125 (Kolmogorov-Smirnov test analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000125 "A statistical test that judges whether 2 sets of values come from the same distribution, by measuring the largest gap between their cumulative distributions. It assumes nothing about the shape of either distribution, which is why it suits simulation data. It is used to check whether 2 simulations sampled the same conformations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000125 "Kolmogorov-Smirnov test analysis"@en)
SubClassOf(obo:MOLSIM_000125 obo:MOLSIM_000124)

# Class: obo:MOLSIM_000126 (confidence intervals analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000126 "A confidence interval provides a range of values, calculated from sample data (e.g., simulation results), that is estimated to contain the true underlying value of a population parameter (e.g., the true average energy) with a specified probability or confidence level (e.g., 95%). It quantifies the uncertainty associated with estimating a parameter from limited or noisy data. Wider intervals indicate greater uncertainty. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000126 "confidence intervals analysis"@en)
SubClassOf(obo:MOLSIM_000126 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000127 (error metrics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000127 "A statistical method that measures how far predicted values lie from observed ones. Which measure to use depends on what a large error should cost: squaring the differences makes outliers dominate, taking their size does not. Reporting more than one is usual, because each hides something the others show. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000127 "error metrics analysis"@en)
SubClassOf(obo:MOLSIM_000127 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000128 (standard error of the mean analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000128 "A statistical measure giving how far a computed average is likely to lie from the true average, based on how much the data scatter and how many independent samples there are. It shrinks as more independent data is added, unlike the spread of the data itself, which does not. For a trajectory the count of independent samples is far smaller than the number of frames, which is why it must be estimated by block averaging. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000128 "SEM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000128 "standard error of the mean analysis"@en)
SubClassOf(obo:MOLSIM_000128 obo:MOLSIM_000127)

# Class: obo:MOLSIM_000129 (root mean square error analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000129 "An error metric giving the typical size of the difference between predicted and observed values, computed by squaring the differences, averaging them and taking the square root. Squaring first makes large errors count disproportionately, so a single bad prediction moves it noticeably. It is in the same units as the quantity itself, which makes it directly interpretable. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000129 "RMSE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000129 "root mean square error analysis"@en)
SubClassOf(obo:MOLSIM_000129 obo:MOLSIM_000127)

# Class: obo:MOLSIM_000130 (mean absolute error analyisis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000130 "An error metric giving the average size of the difference between predicted and observed values, ignoring sign. Because it does not square the differences, every error counts in proportion to its size and one large error does not dominate. It is the measure to prefer when outliers are expected and should not be allowed to control the score. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000130 "MAE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000130 "mean absolute error analyisis"@en)
SubClassOf(obo:MOLSIM_000130 obo:MOLSIM_000127)

# Class: obo:MOLSIM_000131 (mean squared error analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000131 "An error metric giving the average of the squared differences between predicted and observed values. It is the quantity most fitting procedures minimise, because squaring makes it smooth and easy to differentiate. Its units are the square of the quantity's, which is why the square root is usually reported instead. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000131 "MSE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000131 "mean squared error analysis"@en)
SubClassOf(obo:MOLSIM_000131 obo:MOLSIM_000127)

# Class: obo:MOLSIM_000132 (CHARMM 36)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000132 "A widely used all-atom force field parameter set from the CHARMM family, optimized for proteins, lipids, nucleic acids, and carbohydrates. Developed by the MacKerell Lab at the University of Maryland, it provides the mathematical parameters (atomic charges, masses, bond lengths, and angles) necessary to calculate the physical forces dictating the structure and dynamics of biomolecules. It represents a significant update over earlier CHARMM versions (like CHARMM22/27), incorporating improved parameters derived from high-level quantum calculations and experimental data. The 'm' variant (CHARMM36m) includes further refinements, particularly for proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000132 "CHARMM36"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000132 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000132 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000133 (cross-validation errors analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000133 "A statistical method that measures how well a model predicts data it was not fitted to, by repeatedly holding part of the data back, fitting on the rest, and testing on the held-back part. A model can always be made to fit the data it was built from, so testing on that data proves nothing. This is the standard guard against that mistake. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000133 "cross-validation errors analysis"@en)
SubClassOf(obo:MOLSIM_000133 obo:MOLSIM_000135)

# Class: obo:MOLSIM_000134 (bootstrapped error estimates analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000134 "A validation method that puts an uncertainty on a result by resampling the data it came from and recomputing it many times. It is used to show that a conclusion does not rest on a few particular data points. A result whose value changes substantially across resamples is not a result. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000134 "BSE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000134 "bootstrapped error estimates analysis"@en)
SubClassOf(obo:MOLSIM_000134 obo:MOLSIM_000353)

# Class: obo:MOLSIM_000135 (convergence and uncertainty quantification analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000135 "A data analysis method that judges whether a simulation has sampled enough for its results to be stable, and puts an error estimate on those results. It works from time series of the quantity of interest, or by resampling the data statistically. Without both parts, a reported value has no stated reliability. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000135 "convergence and uncertainty quantification analysis"@en)
SubClassOf(obo:MOLSIM_000135 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000136 (block averaging analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000136 "A statistical method that estimates the uncertainty of an average taken from a trajectory, by dividing the data into blocks and looking at how the block averages scatter. It is needed because successive frames of a trajectory resemble each other, so the usual formula for the uncertainty of a mean underestimates it badly. Enlarging the blocks until the estimate stops changing gives the honest figure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000136 "block averaging analysis"@en)
SubClassOf(obo:MOLSIM_000136 obo:MOLSIM_000135)

# Class: obo:MOLSIM_000137 (hysteresis analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000137 "A data analysis method that compares results obtained while a parameter or collective variable is changed in one direction with those obtained while it is changed back, and reports the difference between them. A large difference means the system did not stay near equilibrium, or that sampling was insufficient. Showing that the difference is small is part of demonstrating that a free energy calculation has converged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000137 "hysteresis analysis"@en)
SubClassOf(obo:MOLSIM_000137 obo:MOLSIM_000135)

# Class: obo:MOLSIM_000138 (convergence metrics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000138 "A data analysis method that computes quantitative measures of whether a simulation has sampled enough for its results to have stopped changing. Measures include the stability of a running average, the size of fluctuations in a key property, and the number of transitions observed between states. Which measure is appropriate depends on the kind of simulation and on what is being calculated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000138 "convergence metrics analysis"@en)
SubClassOf(obo:MOLSIM_000138 obo:MOLSIM_000135)

# Class: obo:MOLSIM_000139 (overlap metrics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000139 "A data analysis method that measures how far the configurations sampled in neighbouring simulation windows or thermodynamic states coincide. Enough overlap is a precondition for combining the windows with WHAM or MBAR; too little makes the combined free energy unreliable. It is checked before the free energy profile is computed, not after. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000139 "overlap metrics analysis"@en)
SubClassOf(obo:MOLSIM_000139 obo:MOLSIM_000135)

# Class: obo:MOLSIM_000140 (computational method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000140 "A computational method is a procedure that uses computers to study a scientific problem. As a type of method, it encompasses the specific set of calculations and theoretical models used to simulate molecular behavior or analyze resulting data, distinct from experimental or purely theoretical approaches. These methods are defined by their underlying algorithms and the parameters specified in input files, such as an AMBER mdin or GROMACS mdp file. This is a high-level concept, often found in methods sections of papers as \"computational methods,\" \"in silico approach,\" or \"simulation protocol.\" (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000140 "computational method"@en)
SubClassOf(obo:MOLSIM_000140 obo:MOLSIM_000109)

# Class: obo:MOLSIM_000141 (theoretical approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000141 "A method consisting of the physical principles and mathematical framework a calculation is built on, such as quantum mechanics or classical mechanics with an empirical potential. It sits above the algorithm and the software, and fixes what the calculation is able to represent at all. Two methods sharing an approach can still differ in every other respect. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000141 "theoretical approach"@en)
SubClassOf(obo:MOLSIM_000141 obo:MOLSIM_000109)

# Class: obo:MOLSIM_000142 (predictive index analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000142 "A statistical metric rating how well a model's predictions support a decision, by weighting each pair of compounds by how much getting their order wrong would cost. Ordering 2 very different compounds wrongly counts more heavily than ordering 2 similar ones wrongly. It is used where a model guides a choice rather than predicting a value. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000142 "predictive index analysis"@en)
SubClassOf(obo:MOLSIM_000142 obo:MOLSIM_000127)

# Class: obo:MOLSIM_000143 (ligand pairs selection criteria)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000143 "A criterion applied when choosing which pairs of compounds to compare in a relative free energy study. The choice determines whether the calculation converges at all, because a pair differing by one atom behaves quite differently from a pair differing by a ring. Its subclasses cover similarity, affinity range, data quality and practicality. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000143 "ligand pairs selection criteria"@en)
SubClassOf(obo:MOLSIM_000143 obo:IAO_0000030)

# Class: obo:MOLSIM_000144 (structural similarity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000144 "A ligand selection criterion favouring pairs of molecules that share a common core and differ only by small changes. Such pairs can be transformed into one another alchemically with few atoms changing, which is what makes the calculation converge. Choosing dissimilar pairs is the most common reason a relative free energy calculation fails. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000144 "structural similarity"@en)
SubClassOf(obo:MOLSIM_000144 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000145 (chemical similarity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000145 "A ligand selection criterion favouring molecules that resemble each other in chemical character, such as polarity, charge and hydrogen bonding, rather than in how their atoms are connected. Two molecules built on different frameworks can still behave alike by this measure. It is used when the aim is to replace a scaffold rather than to modify one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000145 "chemical similarity"@en)
SubClassOf(obo:MOLSIM_000145 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000146 (binding affinity range)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000146 "A ligand selection criterion requiring the measured binding strengths of the chosen compounds to fall within a stated range, or to differ by no more than a stated amount. A pair whose affinities differ enormously gives a free energy difference that is large and easy to predict, which tests nothing. A pair too close together cannot be distinguished from calculation error. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000146 "binding affinity range"@en)
SubClassOf(obo:MOLSIM_000146 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000147 (structural and chemical diversity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000147 "A ligand selection criterion requiring the chosen set as a whole to span a range of structures and chemistries, even though individual pairs within it should be similar. A set of near-identical compounds tests a method over a narrow region and says nothing about its general reliability. The 2 requirements apply at different levels: similarity within a pair, diversity across the set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000147 "structural and chemical diversity"@en)
SubClassOf(obo:MOLSIM_000147 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000148 (experimental data availability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000148 "This practical criterion emphasizes selecting ligands for which reliable experimental data, particularly binding affinity measurements (like Ki, Kd, or IC50), already exist. Having high-quality experimental data is essential for validating the computational predictions and assessing the accuracy of the methods used. Availability of structural data (e.g., co-crystal structures) is also highly valuable."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000148 "experimental data availability"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000148 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000148 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000149 (chemical properties)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000149 "A ligand selection criterion based on computed or measured properties of the compounds, such as molecular weight, lipophilicity, charge and the number of rotatable bonds. These properties predict how difficult a compound will be to simulate as well as how drug-like it is. A charged or very flexible compound needs far more sampling than a neutral rigid one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000149 "chemical properties"@en)
SubClassOf(obo:MOLSIM_000149 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000150 (structural change)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000150 "A ligand selection criterion based on how large and of what kind the difference between 2 candidate compounds is. Changing a single atom converges quickly; changing a ring or a charge does not. The size of the change is the best single predictor of whether a relative free energy calculation will succeed. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000150 "structural changes"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000150 "structural change"@en)
SubClassOf(obo:MOLSIM_000150 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000151 (computational feasibility)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000151 "A ligand selection criterion asking whether the calculations a candidate would require can be completed with the time and computing available. A charged or highly flexible ligand may need many times the sampling of a neutral rigid one. It is applied before the calculation, since discovering the answer afterwards wastes the whole effort. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000151 "computational feasibility"@en)
SubClassOf(obo:MOLSIM_000151 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000152 (relevance to drug discovery)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000152 "A ligand selection criterion favouring molecules and modifications that bear on an ongoing drug discovery project or a stated therapeutic aim. It is a judgement about purpose rather than about chemistry, so it cannot be computed. It is recorded because it explains why a particular set of compounds was chosen. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000152 "relevance to drug discovery"@en)
SubClassOf(obo:MOLSIM_000152 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000153 (structural data quality)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000153 "A ligand selection criterion based on how good the experimental structure of the complex is, judged by resolution, how well the model fits the data, and whether the ligand is clearly resolved. A poorly resolved ligand may be placed wrongly, and a calculation started from it inherits that error. It is assessed before the structure is used, not after a result looks wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000153 "structural data quality"@en)
SubClassOf(obo:MOLSIM_000153 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000154 (stability in simulations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000154 "A ligand selection criterion based on whether the compound stays bound and in a consistent pose during a trial simulation. A ligand that drifts out of its site, or flips between poses, gives a free energy that depends on how long the run was. Testing it with a short simulation before committing to a full calculation is cheaper than discovering it afterwards. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000154 "stability in simulations"@en)
SubClassOf(obo:MOLSIM_000154 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000155 (ligand efficiency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000155 "A measure relating how tightly a compound binds to how many heavy atoms it has, usually as binding energy divided by that count. It exists because binding strength rises almost automatically with size, so a large weak binder can look better than a small efficient one. Optimising a small efficient compound usually ends better than optimising a large inefficient one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000155 "ligand efficiency"@en)
SubClassOf(obo:MOLSIM_000155 obo:MOLSIM_000143)

# Class: obo:MOLSIM_000156 (GROMACS mdp format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000156 "The GROMACS mdp format is the specific simulation parameter format used by the GROMACS software package. The file, which typically has a \".mdp\" extension, contains a series of keyword-value pairs that control every aspect of the simulation run, from the integrator and time step to the thermostat and pressure coupling methods. For GROMACS users, creating and editing the mdp file is the primary way to define the simulation protocol."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000156 "GROMACS mdp format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000156 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000156 obo:MOLSIM_002065)

# Class: obo:MOLSIM_000157 (simulation framework)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000157 "A reusable software platform or environment that provides a basic structure and set of tools or libraries for developing applications or performing complex tasks within a specific domain. In biomolecular simulation, a framework might offer standardized ways to set up simulations, manage data, integrate different tools, or build custom analysis workflows, providing a higher level of abstraction than individual tools or scripts. Examples could include workflow management systems (like Galaxy, KNIME adapted for simulation) or simulation setup environments (like CHARMM-GUI). (UNVERIFIED)"@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_000157 <https://doi.org/10.1002/jcc>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000157 "framework"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000157 "simulation framework"@en)
SubClassOf(obo:MOLSIM_000157 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000158 (simulation and modeling software)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000158 "A software program that builds, runs or analyses a computational model of a physical system. It is the category the simulation engines, the modelling suites and the analysis packages all belong to. What separates it from other software is that its subject is a model of something real. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000158 "simulation and modeling software"@en)
SubClassOf(obo:MOLSIM_000158 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000159 (mdcrd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000159 "A text-based file format from the Amber software that stores the movement of atoms over time from a simulation. It contains a series of snapshots, or frames, where each frame lists the x, y, and z coordinates of every atom at a specific time point. It may also store the x, y, and z simulation box sizes."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000159 "AMBER mdcrd format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000159 "mdcrd format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000159 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000159 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000160 (molecular dynamics engine)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000160 "Application programs specifically designed to perform molecular dynamics (MD) simulations, which calculate the motion of atoms and molecules over time based on classical mechanics and a chosen force field. These packages typically include capabilities for system preparation, simulation execution (often optimized for high-performance computing), and basic trajectory analysis. Examples include AMBER, GROMACS, NAMD, CHARMM, Desmond, and LAMMPS."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000160 "molecular dynamics engine"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000160 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000160 obo:MOLSIM_001851)

# Class: obo:MOLSIM_000161 (quantum chemistry engine)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000161 "A software program that solves for the arrangement of electrons in atoms and molecules using quantum mechanics. It implements methods such as Hartree-Fock, density functional theory and the correlated methods built on them. It is what supplies an energy and a set of forces when a force field is not accurate enough. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000161 "quantum chemistry engine"@en)
SubClassOf(obo:MOLSIM_000161 obo:MOLSIM_001851)

# Class: obo:MOLSIM_000162 (docking tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000162 "A computational tool used to predict the preferred binding orientation and affinity (scoring) of one molecule (typically a small ligand) to another (usually a larger receptor like a protein or nucleic acid). Docking tools employ search algorithms to explore possible binding poses within a target site and use scoring functions to estimate the binding strength for each pose. Widely used in drug discovery and understanding molecular recognition, examples include AutoDock, Vina, Glide, GOLD, and DOCK."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000162 "docking tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000162 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000162 obo:MOLSIM_001850)

# Class: obo:MOLSIM_000163 (visualization tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000163 "A software program that draws molecular structures, surfaces, densities and trajectories as interactive 3-dimensional images. It lets a person look at a system rather than only measure it. Many faults in a prepared system, such as a molecule sitting half outside its box, are obvious on sight and invisible to any numerical check. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000163 "visualization tool"@en)
SubClassOf(obo:MOLSIM_000163 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000164 (analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000164 "Software designed to process raw data generated from biomolecular simulations (like trajectories, energy files) to calculate specific quantitative properties and extract meaningful insights. Analysis tools implement algorithms for calculating metrics like RMSD, RMSF, radius of gyration, hydrogen bonds, interaction energies, principal components (PCA), free energy estimations (MM/PBSA), clustering, etc. Examples include cpptraj (AmberTools), GROMACS analysis utilities, MDAnalysis (Python library), and specialized scripts or programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000164 "analysis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000164 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000164 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000165 (data processing tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000165 "A tool focused on manipulating, converting, filtering, or extracting information from data files. This can involve tasks like converting file formats, extracting specific columns or frames, merging datasets, calculating simple statistics, or preparing data for input into other analysis or visualization tools."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000165 "data processing tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000165 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000165 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000166 (file conversion tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000166 "A specific type of data processing tool dedicated to converting molecular structure, trajectory, or data files from one format to another (e.g., PDB to MOL2, XTC to netcdf)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000166 "file conversion tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000166 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000166 obo:MOLSIM_000165)

# Class: obo:MOLSIM_000167 (automation script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000167 "A script specifically designed to automate a series of steps in a workflow that would otherwise need to be performed manually. In simulations, this could involve automatically setting up multiple simulation replicas, submitting jobs to a computing cluster, checking job status, and organizing output files, thereby reducing manual effort and potential errors. Workflow management systems often rely heavily on automation scripts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000167 "automation script"@en)
SubClassOf(obo:MOLSIM_000167 obo:MOLSIM_001802)

# Class: obo:MOLSIM_000168 (data analysis script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000168 "A script written to perform specific analysis tasks on data generated from simulations, often going beyond the standard capabilities of packaged analysis tools or requiring custom calculations. Examples include scripts to calculate specific geometric parameters over time, parse log files for specific energy terms, perform advanced statistical analysis or time-series analysis on trajectory data, or generate data for custom plots."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000168 "data analysis script"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000168 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000168 obo:MOLSIM_001802)

# Class: obo:MOLSIM_000169 (workflow script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000169 "A script that defines and executes an entire sequence of computational tasks constituting a specific workflow, often involving multiple steps like data preparation, running simulations (potentially submitting to clusters), performing analysis, and summarizing results. These scripts orchestrate the execution of various tools and other scripts, manage intermediate data, and handle dependencies between steps, ensuring the entire process runs smoothly and reproducibly. Tools like Snakemake or Nextflow help in creating robust workflow scripts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000169 "workflow script"@en)
SubClassOf(obo:MOLSIM_000169 obo:MOLSIM_001802)

# Class: obo:MOLSIM_000170 (software component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000170 "A reusable part of a larger software system that provides a defined set of functions to whatever calls it. Unlike a program, it is not run on its own; it is built into something else. A library that reads a file format is the usual example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000170 "software component"@en)
SubClassOf(obo:MOLSIM_000170 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000171 (software development and management tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000171 "A software program that helps in writing, building, testing or maintaining other software, rather than in doing any science itself. Compilers, version control systems and test frameworks belong here. They appear in this ontology because a simulation result depends on which versions of which tools produced it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000171 "software development and management tool"@en)
SubClassOf(obo:MOLSIM_000171 obo:MOLSIM_000001)

# Class: obo:MOLSIM_000172 (topology and parameterization tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000172 "A software program that works out which atom type each atom belongs to and which force field parameters therefore apply, producing the topology a simulation needs. The assignment is made from the molecule's connectivity and chemistry. A wrong assignment produces a system that simulates normally and represents the wrong molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000172 "topology and parameterization tool"@en)
SubClassOf(obo:MOLSIM_000172 obo:MOLSIM_001850)

# Class: obo:MOLSIM_000173 (quantum mechanics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000173 "A physical theory describing how matter behaves at the scale of atoms and subatomic particles, where energy and angular momentum take discrete values. It is what chemical bonding and molecular electronic structure are explained by. In this field its equations are solved approximately to predict molecular properties. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000173 "QM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000173 "quantum mechanics"@en)
SubClassOf(obo:MOLSIM_000173 obo:MOLSIM_000141)

# Class: obo:MOLSIM_000174 (STO-2G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000174 "A minimal basis set in which each atomic orbital is approximated by 2 Gaussian functions added together. Gaussians are used because the integrals they require can be computed quickly, while the orbital shape they imitate cannot. With only 2 the imitation is poor, so it is used to demonstrate the method rather than to obtain results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000174 "STO-2G"@en)
SubClassOf(obo:MOLSIM_000174 obo:MOLSIM_000017)

# Class: obo:MOLSIM_000175 (Gaussian)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000175 "A comprehensive and widely used quantum chemistry software package, primarily focused on electronic structure calculations using ab initio methods, Density Functional Theory (DFT), and semi-empirical methods. While its core strength is QM, Gaussian can perform ONIOM (QM/MM) calculations and some limited molecular mechanics (MM) computations, making it potentially usable in biomolecular contexts, especially for parameterization or high-accuracy active site studies, but it's not typically used as a primary classical MD engine like AMBER or GROMACS. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000175 "Gaussian"@en)
SubClassOf(obo:MOLSIM_000175 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000176 (GAMESS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000176 "A quantum chemistry engine providing a broad range of wavefunction-based and density functional methods, distributed freely for academic use. Two separately maintained programs share the name, developed in the United States and the United Kingdom, and their inputs are not interchangeable. Which one produced a result therefore has to be recorded. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000176 "GAMESS"@en)
SubClassOf(obo:MOLSIM_000176 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000177 (Psi4)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000177 "An open-source suite of quantum chemistry software specializing in high-accuracy ab initio methods (like coupled cluster and symmetry-adapted perturbation theory) alongside standard methods like HF and DFT. Psi4 is known for its modern codebase (Python and C++), user-friendly input, extensive libraries, and focus on accuracy and efficient algorithms for correlated wavefunction calculations. It's increasingly popular in the academic community for demanding electronic structure calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000177 "Psi4"@en)
SubClassOf(obo:MOLSIM_000177 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000178 (Orca)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000178 "A versatile and powerful quantum chemistry software package, freely available for academic use, offering a wide range of methods including DFT, HF, semi-empirical, MPn, coupled cluster, and multi-reference methods. Orca is known for its robustness, efficiency (especially for DFT), user-friendliness, and ability to handle large molecules, making it very popular for diverse applications in computational chemistry, including biomolecular-relevant calculations like QM/MM or spectroscopy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000178 "Orca"@en)
SubClassOf(obo:MOLSIM_000178 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000179 (Q-Chem)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000179 "A comprehensive quantum chemistry software package offering a wide range of methods, including Hartree-Fock, DFT, coupled-cluster, and QM/MM capabilities. Like Gaussian, its primary focus is quantum mechanical electronic structure calculations. While it can be used for QM/MM simulations relevant to biomolecular systems, it's not typically used for large-scale classical MD simulations in the way dedicated MD packages are. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000179 "Q-Chem"@en)
SubClassOf(obo:MOLSIM_000179 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000180 (Quantum ESPRESSO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000180 "An integrated suite of open-source software for quantum mechanical electronic structure calculations and materials modeling, primarily based on Density Functional Theory (DFT), plane waves, and pseudopotentials. While extremely powerful for condensed matter physics and materials science, and capable of ab initio MD (Born-Oppenheimer MD), its typical application domain and methods (plane waves) differ from those commonly used for classical MD or QM/MM studies of large solvated biomolecules in packages like AMBER or GROMACS. It is more suited for periodic systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000180 "Quantum ESPRESSO"@en)
SubClassOf(obo:MOLSIM_000180 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000181 (NWChem)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000181 "A versatile open-source computational chemistry software package developed by Pacific Northwest National Laboratory (PNNL), designed for high-performance computing. It offers a broad range of capabilities, including classical MD simulation, various quantum mechanical methods (DFT, Hartree-Fock, coupled cluster), and hybrid QM/MM methods. Its ability to handle both MD and QM makes it suitable for complex biomolecular simulations requiring multi-scale approaches on large parallel computers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000181 "NWChem"@en)
SubClassOf(obo:MOLSIM_000181 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000182 (Molpro)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000182 "A high-accuracy quantum chemistry software package primarily focused on sophisticated ab initio wavefunction-based methods, particularly multi-reference methods (CASSCF, CASPT2, MRCI) and high-level coupled cluster calculations (CCSD(T), etc.), alongside standard HF and DFT. Molpro is renowned for its capabilities in calculating highly accurate energies, properties, and potential energy surfaces, often used for benchmarking or studying systems where electron correlation is challenging, including complex transition metal systems or photochemical processes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000182 "Molpro"@en)
SubClassOf(obo:MOLSIM_000182 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000183 (Chronus Quantum)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000183 "An object-oriented quantum chemistry software package focused on developing and implementing novel electronic structure theories, particularly methods for electron correlation and response properties (e.g., for spectroscopy). It serves both as a research platform for method development and an application for advanced QM calculations. It provides a modern framework for tackling challenging quantum chemical problems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000183 "Chronus Quantum"@en)
SubClassOf(obo:MOLSIM_000183 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000184 (QuTiP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000184 "A Python library for simulating quantum systems that exchange energy with their surroundings, rather than being isolated. Its subject is quantum optics and quantum information rather than molecular structure. It appears here because such calculations sometimes accompany spectroscopic work on molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000184 "QuTiP"@en)
SubClassOf(obo:MOLSIM_000184 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000185 (π-π interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000185 "A non-covalent interaction occurring between aromatic rings, arising from a combination of electrostatic interactions between their quadrupole moments (electron-rich faces vs electron-poorer edges) and Van der Waals (dispersion) forces. The preferred geometry (e.g., stacked, parallel-displaced, T-shaped) depends on the specific aromatic systems and influences the interaction strength. They are important in protein structure (stacking of Phe, Tyr, Trp, His residues) and the stability of DNA/RNA helices (base stacking). (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000185 "π-π interactions"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000185 "π-π interaction"@en)
SubClassOf(obo:MOLSIM_000185 obo:MOLSIM_000064)

# Class: obo:MOLSIM_000186 (hydrophobic interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000186 "The observed tendency for nonpolar molecules or molecular groups to associate with each other when in an aqueous (water) environment, effectively minimizing their disruptive contact with water molecules. This phenomenon is primarily entropically driven by the favorable increase in the entropy of water molecules that are released from ordered \"cages\" (solvation shells) around the nonpolar surfaces when they aggregate. It is a major driving force for protein folding (burying hydrophobic residues), membrane formation, and ligand binding."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000186 "hydrophobic interactions"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000186 "hydrophobic interaction"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000186 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000186 obo:MOLSIM_000062)

# Class: obo:MOLSIM_000187 (electrostatic interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000187 "An interaction between charged or polar groups arising from the attraction and repulsion of their charges. It reaches much further than any other non-bonded interaction, falling off only in proportion to distance for 2 ions. That long reach is why a periodic simulation needs a special method to compute it rather than simply cutting it off. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000187 "electrostatic interactions"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000187 "electrostatic interaction"@en)
SubClassOf(obo:MOLSIM_000187 obo:MOLSIM_000062)

# Class: obo:MOLSIM_000188 (cation-π interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000188 "A specific type of non-covalent electrostatic interaction involving the attractive force between a cation (a positively charged ion, e.g., Na+,K+,Lys+,Arg+) and the electron-rich face of an aromatic π-system (like benzene, or the side chains of Phe, Tyr, Trp, His). The cation is attracted to the negative electrostatic potential above and below the plane of the aromatic ring, which arises from its quadrupole moment. These interactions contribute significantly to protein structure stabilization and molecular recognition, including ligand binding. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000188 "cation-π interactions"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000188 "cation-π interaction"@en)
SubClassOf(obo:MOLSIM_000188 obo:MOLSIM_000187)
DisjointClasses(obo:MOLSIM_000188 obo:MOLSIM_000189)

# Class: obo:MOLSIM_000189 (hydrogen bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000189 "A specific, directional non-covalent interaction formed between a hydrogen atom covalently bonded to a highly electronegative atom (the donor, D, typically N, O, or F) and another nearby electronegative atom (the acceptor, A, also typically N, O, or F) which possesses a lone pair of electrons. Represented as D-H···A, it has characteristics of both electrostatic attraction (between the partially positive H and partially negative A) and weak orbital overlap/covalency."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000189 "hydrogen bond"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000189 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000189 obo:MOLSIM_000187)

# Class: obo:MOLSIM_000190 (backbone hydrogen bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000190 "Hydrogen bonds formed specifically between the atoms of the polypeptide backbone in proteins or peptides. The most common form involves the amide hydrogen (N-H group) of one residue acting as the donor and the carbonyl oxygen (C=O group) of another residue (often i→i+4 in helices or between strands in sheets) acting as the acceptor."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000190 "backbone hydrogen bonds"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000190 "backbone hydrogen bond"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000190 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000190 obo:MOLSIM_000189)

# Class: obo:MOLSIM_000191 (side-chain hydrogen bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000191 "Hydrogen bonds where at least one of the participating atoms (either the donor hydrogen attached to its electronegative atom, or the acceptor electronegative atom) belongs to an amino acid side chain, rather than exclusively involving backbone atoms. These interactions can occur between two side chains, or between a side chain and the backbone, contributing to the stability of the protein's tertiary and quaternary structure, protein-ligand interactions, and enzyme active site chemistry."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000191 "side-chain hydrogen bonds"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000191 "side-chain hydrogen bond"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000191 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000191 obo:MOLSIM_000189)

# Class: obo:MOLSIM_000192 (backbone-side chain hydrogen bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000192 "Hydrogen bonds formed specifically between an atom on the polypeptide backbone (either the amide N-H donor or the carbonyl C=O acceptor) and an atom within an amino acid side chain (acting as acceptor or donor, respectively). These interactions directly link the regular backbone structure to the specific side chain identities and conformations, playing crucial roles in stabilizing protein folds (tertiary structure) and positioning side chains for function."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000192 "backbone-side chain hydrogen bonds"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000192 "backbone-side chain hydrogen bond"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000192 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000192 obo:MOLSIM_000189)

# Class: obo:MOLSIM_000193 (peptidic bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000193 "A covalent bond joining the carbonyl carbon of one amino acid to the nitrogen of the next, formed with the loss of a water molecule. Its partial double-bond character holds the 6 atoms around it flat and makes rotation about it slow. That rigidity is why a protein backbone has only 2 freely rotating angles per residue. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000193 "peptidic bond"@en)
SubClassOf(obo:MOLSIM_000193 obo:MOLSIM_000063)
DisjointClasses(obo:MOLSIM_000193 obo:MOLSIM_000194)

# Class: obo:MOLSIM_000194 (disulfide bridge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000194 "A specific type of covalent bond formed by the oxidation of the thiol (-SH) groups of two cysteine amino acid residues, creating a sulfur-sulfur bond (-S-S-). These bonds can form between cysteines within the same polypeptide chain (intramolecular) or between different chains (intermolecular), acting as strong cross-links that significantly stabilize the folded tertiary or quaternary structure of many proteins, particularly extracellular ones. Formation and breakage of disulfide bridges are important biochemical processes. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000194 "disulfide bridges"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000194 "disulfide bridge"@en)
SubClassOf(obo:MOLSIM_000194 obo:MOLSIM_000063)

# Class: obo:MOLSIM_000195 (thermodynamic ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000195 "A theoretical statistical mechanics construct representing a probability distribution for the state of a system, defined by a specific set of macroscopic variables held constant (e.g., NVT, NPT). In molecular simulation, it dictates the thermodynamic conditions and integration rules applied to generate a trajectory. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000195 "statistical ensemble"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000195 "ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000195 "thermodynamic ensemble"@en)
SubClassOf(obo:MOLSIM_000195 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000196 (canonical ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000196 "A statistical ensemble representing systems where the number of particles (N), the system volume (V), and the temperature (T) are held constant; hence often called the NVT ensemble. The system is considered to be in thermal contact with an infinitely large heat bath at temperature T, allowing energy exchange. Simulations performed in the NVT ensemble generate configurations according to the Boltzmann probability distribution appropriate for that temperature, making it suitable for studying equilibrium properties under constant temperature and volume conditions. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000196 "NVT ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000196 "canonical ensemble"@en)
SubClassOf(obo:MOLSIM_000196 obo:MOLSIM_000195)

# Class: obo:MOLSIM_000197 (isothermal-isobaric ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000197 "The isothermal-isobaric ensemble (often called the NPT ensemble) is a statistical mechanical framework for a system with a fixed number of particles (N), constant temperature (T), and constant pressure (P). Unlike canonical ensembles, volume (V) is allowed to fluctuate, making it ideal for modeling real-world condensed-phase laboratory conditions."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000197 "NPT ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000197 "isothermal-isobaric ensemble"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000197 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000197 obo:MOLSIM_000195)

# Class: obo:MOLSIM_000198 (microcanonical ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000198 "A statistical ensemble representing completely isolated systems, where the number of particles (N), the system volume (V), and the total energy (E) are all held constant; hence often called the NVE ensemble. There is no exchange of energy or particles with the surroundings. Simulations performed in the NVE ensemble directly follow Newtonian laws of motion (integrating Hamilton's equations), and conservation of total energy serves as a key check of simulation stability and accuracy, but it's less commonly used for equilibrium sampling compared to NVT or NPT as temperature can fluctuate. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000198 "NVE ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000198 "microcanonical ensemble"@en)
SubClassOf(obo:MOLSIM_000198 obo:MOLSIM_000195)

# Class: obo:MOLSIM_000199 (grand canonical ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000199 "A statistical ensemble representing open systems where the chemical potential (μ), the system volume (V), and the temperature (T) are held constant; hence often called the μVT ensemble. The system can exchange both energy (with a heat bath at T) and particles (with a particle reservoir at chemical potential μ). Simulations in this ensemble are useful for studying systems where the number of particles can change, such as adsorption phenomena, phase equilibria (vapor-liquid), or systems involving chemical reactions where concentrations are fixed rather than particle numbers. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000199 "µVT ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000199 "grand canonical ensemble"@en)
SubClassOf(obo:MOLSIM_000199 obo:MOLSIM_000195)

# Class: obo:MOLSIM_000200 (protein structure determination method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000200 "Protein structure determination methods refer to the experimental techniques used to obtain high-resolution three-dimensional atomic coordinates of protein molecules. These methods provide the foundational structural data used in biomolecular simulations, structure-based drug design, and understanding protein function. The primary techniques include X-ray crystallography, NMR spectroscopy, and cryo-electron microscopy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000200 "protein structure determination method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000200 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000200 obo:MOLSIM_000304)

# Class: obo:MOLSIM_000201 (X-ray crystallography)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000201 "X-ray crystallography is an experimental technique that determines the three-dimensional structure of molecules, particularly proteins, by analyzing the diffraction pattern produced when X-rays are scattered by a crystalline form of the molecule. The diffraction pattern contains information about the arrangement of electrons, allowing calculation of an electron density map into which the atomic structure can be built. It is capable of providing very high-resolution structural information. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000201 "X-ray"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000201 "X-ray crystallography"@en)
SubClassOf(obo:MOLSIM_000201 obo:MOLSIM_000200)

# Class: obo:MOLSIM_000202 (nuclear magnetic resonance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000202 "Nuclear Magnetic Resonance (NMR) spectroscopy is an experimental technique used to determine protein structures, typically in solution, by exploiting the magnetic properties of atomic nuclei. It measures distances between specific pairs of atoms (primarily hydrogens using the Nuclear Overhauser Effect) and torsion angle restraints based on spin-spin coupling. These experimentally derived restraints are then used to calculate an ensemble of structures consistent with the data."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000202 "NMR"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000202 "nuclear magnetic resonance"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000202 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000202 obo:MOLSIM_000200)

# Class: obo:MOLSIM_000203 (cryogenic electron microscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000203 "Cryogenic electron microscopy (Cryo-EM) is an experimental technique that determines the structure of molecules and complexes by imaging samples rapidly frozen in a thin layer of vitreous (non-crystalline) ice using an electron microscope. Sophisticated image processing techniques are used to average images of thousands or millions of individual particles to reconstruct a high-resolution three-dimensional density map. Cryo-EM is particularly powerful for large, flexible complexes that are difficult to crystallize. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000203 "Cryo-EM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000203 "cryogenic electron microscopy"@en)
SubClassOf(obo:MOLSIM_000203 obo:MOLSIM_000200)

# Class: obo:MOLSIM_000204 (ligand charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000204 "A computational methodology or protocol used to assign partial atomic charges to the atoms of a small molecule (ligand), typically for use within a classical molecular mechanics force field during simulations of its interaction with a biomolecule (like a protein or nucleic acid). Since electrostatic interactions are crucial for molecular recognition and binding affinity, accurate and consistent charge assignment is critical. Different models (e.g., RESP, AM1-BCC, Mulliken, Löwdin) exist, often aiming to reproduce the quantum mechanically derived electrostatic potential around the molecule or fit to experimental data, with varying levels of theory, complexity, and computational cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000204 "ligand charge model"@en)
SubClassOf(obo:MOLSIM_000204 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000205 (AM1-BCC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000205 "A widely used method for assigning atom-centered partial charges to organic molecules, particularly suitable for general force fields like GAFF (stands for Austin Model 1 - Bond Charge Correction). It involves a two-step process: first, charges are calculated using the computationally inexpensive semi-empirical AM1 quantum mechanical method; second, empirical Bond Charge Corrections (BCCs) are added to these initial charges based on atom and bond types to make them better reproduce the electrostatic potential obtained from higher-level QM calculations (typically HF/6-31G*). AM1-BCC aims to provide a balance between speed and accuracy for charging diverse organic ligands. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000205 "AM1-BCC"@en)
SubClassOf(obo:MOLSIM_000205 obo:MOLSIM_000204)
DisjointClasses(obo:MOLSIM_000205 obo:MOLSIM_000206)

# Class: obo:MOLSIM_000206 (restrained electrostatic potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000206 "A popular method for deriving high-quality partial atomic charges for molecules, frequently used in conjunction with the AMBER force fields. It involves calculating the quantum mechanical electrostatic potential (ESP) on a grid of points around the molecule (typically using Hartree-Fock or DFT methods), and then fitting atom-centered point charges to reproduce this ESP using a least-squares algorithm. Crucially, 'restraints' (typically hyperbolic penalties) are applied during the fitting process to prevent unrealistically large charges on buried atoms and ensure transferability, often performed in multiple stages for chemical equivalence. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000206 "RESP"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000206 "restrained electrostatic potential"@en)
SubClassOf(obo:MOLSIM_000206 obo:MOLSIM_000204)

# Class: obo:MOLSIM_000207 (custom script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000207 "A script written by a researcher for one specific purpose in their own project, rather than distributed as part of a tool. It exists because no available program did quite what was needed. It is worth recording because a result may depend on it entirely, and it is usually the least documented part of a workflow. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000207 "custom script"@en)
SubClassOf(obo:MOLSIM_000207 obo:MOLSIM_001802)

# Class: obo:MOLSIM_000208 (thermalization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000208 "A step within the preparation or equilibration phase where the system's temperature is gradually raised or adjusted to the desired target temperature for the production simulation. This is typically done by coupling the system to a thermostat while velocities are assigned or rescaled. Proper thermalization ensures the system reaches the correct kinetic energy distribution before equilibration or production runs. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000208 "heating"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000208 "thermalization"@en)
SubClassOf(obo:MOLSIM_000208 obo:MOLSIM_000002)

# Class: obo:MOLSIM_000209 (equilibration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000209 "A crucial phase in simulation preparation, following initial setup and minimization/thermalization, where the system is simulated under the target ensemble conditions (e.g., NVT or NPT) for a period to allow it to relax and reach a stable state. Key properties like temperature, pressure, density, potential energy, and RMSD are monitored to ensure the system is well-equilibrated before starting the production simulation intended for data collection. This phase allows the system to 'forget' its initial, potentially artificial starting configuration."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000209 "equilibration"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000209 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000209 obo:MOLSIM_000002)

# Class: obo:MOLSIM_000210 (umbrella sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000210 "A specific simulation execution technique used to enhance sampling along a chosen reaction coordinate or order parameter, often for calculating the potential of mean force (PMF) or free energy profile associated with a process like ligand unbinding or a conformational change. It involves running multiple simulations, each confined ('biased') by a potential (the 'umbrella') to sample a specific window along the coordinate, with subsequent analysis required to unbias the results and reconstruct the overall profile. It falls under the category of enhanced sampling methods."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000210 "US"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000210 "umbrella sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000210 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000210 obo:MOLSIM_000003)

# Class: obo:MOLSIM_000211 (production)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000211 "A stage of a simulation run in which data is collected, after the system has been prepared and allowed to settle. It is run under the conditions the study is about, for long enough that averages taken from it stop drifting. Only this part of a trajectory is normally analysed; the settling period before it is discarded. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000211 "production"@en)
SubClassOf(obo:MOLSIM_000211 obo:MOLSIM_000003)

# Class: obo:MOLSIM_000212 (free energy calculation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000212 "A type of simulation execution specifically designed to compute the free energy difference between two states (e.g., bound vs unbound, state A vs state B) or the free energy profile along a reaction coordinate. Common methods include Free Energy Perturbation (FEP), Thermodynamic Integration (TI), Umbrella Sampling (for PMFs), and sometimes methods based on endpoint analysis like MM/PBSA or MM/GBSA (though these are technically post-processing analyses estimating free energy). These calculations are computationally demanding but crucial for understanding binding affinities, reaction barriers, and relative stabilities. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000212 "free energy calculation"@en)
SubClassOf(obo:MOLSIM_000212 obo:MOLSIM_000003)

# Class: obo:MOLSIM_000213 (adaptive steered molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000213 "An enhanced sampling simulation technique that enhances traditional steered molecular dynamics (SMD) to calculate binding affinities, mechanical unfolding pathways, and free energy profiles (e.g., Potential of Mean Force) in biomolecules. It works by breaking long pulling processes into a series of stages or windows along a specific reaction coordinate."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000213 "adaptive steered molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000213 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000213 obo:MOLSIM_000003)

# Class: obo:MOLSIM_000214 (STO-3G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000214 "A minimal basis set in which each atomic orbital is approximated by 3 Gaussian functions added together. Gaussians are used because the integrals they require can be computed quickly, while the orbital shape they imitate cannot. It is by far the most used member of the family and appears in almost every textbook example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000214 "STO-3G"@en)
SubClassOf(obo:MOLSIM_000214 obo:MOLSIM_000017)

# Class: obo:MOLSIM_000215 (STO-4G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000215 "A minimal basis set in which each atomic orbital is approximated by 4 Gaussian functions added together. Gaussians are used because the integrals they require can be computed quickly, while the orbital shape they imitate cannot. More Gaussians give a better imitation and no extra flexibility, because the number of orbitals is unchanged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000215 "STO-4G"@en)
SubClassOf(obo:MOLSIM_000215 obo:MOLSIM_000017)

# Class: obo:MOLSIM_000216 (visualization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000216 "A process that turns molecular structures, trajectories and simulation data into pictures or animations. It is how a system is checked before a run, watched during one, and understood afterwards. Many errors in a prepared system are obvious on sight and invisible in any numerical check. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000216 "visualization"@en)
SubClassOf(obo:MOLSIM_000216 obo:MOLSIM_000004)

# Class: obo:MOLSIM_000217 (AMBER)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000217 "A widely used package of biomolecular simulation software, encompassing both a suite of programs (AmberTools) for simulation preparation, analysis, and modeling, and a high-performance simulation engine (pmemd) for running MD and free energy calculations. AMBER is associated with a popular family of force fields (e.g., ff14SB, GAFF) and is extensively used for simulating proteins, nucleic acids, lipids, and organic molecules. It includes capabilities for classical MD, QM/MM, and various advanced simulation techniques."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000217 "AmberMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000217 "AMBER"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000217 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000217 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000218 (AmberTools)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000218 "The freely available component of the AMBER software package, containing numerous programs and utilities for biomolecular simulation tasks excluding the main high-performance simulation engine (pmemd). AmberTools includes programs for system setup (tleap), trajectory analysis (cpptraj), structure preparation (antechamber), energy minimization and basic MD simulation (sander), QM calculations (sqm), free energy analysis (mmpbsa), and many others. It provides the essential infrastructure for preparing, analyzing, and modeling simulations run with AMBER or other programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000218 "AmberTools"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000218 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000218 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000219 (amber.sh)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000219 "This likely refers to a shell script used within the AMBER software ecosystem, possibly for setting up environment variables, running specific AmberTools programs, or launching simulations. It represents a specific script file used to execute or configure parts of the AMBER software suite. Its exact function would depend on the specific context or script content. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000219 "amber.sh"@en)
SubClassOf(obo:MOLSIM_000219 obo:MOLSIM_001569)

# Class: obo:MOLSIM_000220 (protonation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000220 "A software program that decides which acidic and basic groups in a structure carry a proton at a stated acidity. It predicts this from the local environment of each group, since experimental structures rarely show hydrogens. The answer changes the charge of the system and so changes everything a simulation does. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000220 "protonation tool"@en)
SubClassOf(obo:MOLSIM_000220 obo:MOLSIM_000490)

# Class: obo:MOLSIM_000221 (PDB2PQR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000221 "A widely used software tool (available as a web server and standalone package) that automates many common tasks in preparing biomolecular structures (from PDB files) for continuum electrostatics calculations or simulations. Its core functions include adding missing heavy atoms, adding and optimizing hydrogen atom positions, assigning charges and radii from a chosen force field, and determining residue protonation states at a specified pH using the PROPKA algorithm internally. It outputs the structure in PQR format (PDB with Charge and Radius)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000221 "PDB2PQR"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000221 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000221 obo:MOLSIM_000223)

# Class: obo:MOLSIM_000222 (ligand protonation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000222 "A protonation tool specifically focused on determining the most likely ionization and tautomeric states of small molecule ligands, often in the context of drug discovery or protein-ligand binding studies. Predicting ligand protonation can be challenging due to diverse functional groups and potential binding site environmental effects."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000222 "ligand protonation tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000222 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000222 obo:MOLSIM_000220)

# Class: obo:MOLSIM_000223 (generic protonation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000223 "A protonation tool designed for general use on biomolecular structures, typically proteins or nucleic acids obtained from sources like the PDB, to add hydrogens and determine appropriate protonation states for titratable residues at a given pH. These tools often focus on standard amino acids and sometimes common cofactors. PDB2PQR is a classic example of such a tool."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000223 "generic protonation tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000223 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000223 obo:MOLSIM_000220)

# Class: obo:MOLSIM_000224 (Epik)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000224 "A software program in the Schrödinger suite that predicts which protonation and tautomeric forms of a small molecule are present at a given acidity, and how much each is favoured. It is run before docking or simulation, since the form chosen determines the molecule's charge and hydrogen bonding. It reports several forms with penalties rather than a single answer. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000224 "Epik"@en)
SubClassOf(obo:MOLSIM_000224 obo:MOLSIM_000222)

# Class: obo:MOLSIM_000225 (membrane packing tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000225 "A computational tool specifically designed to generate realistic initial configurations of lipid bilayers, often including embedded proteins, for use in membrane simulations. These tools arrange lipid molecules (and potentially cholesterol, solvent) according to specified lipid types, compositions, and area per lipid, ensuring proper packing density and avoiding steric clashes, which is challenging to do manually. Examples include PACKMOL-Memgen, CHARMM-GUI's Membrane Builder, and InflateGRO. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000225 "membrane packing tool"@en)
SubClassOf(obo:MOLSIM_000225 obo:MOLSIM_001556)

# Class: obo:MOLSIM_000226 (PACKMOL-Memgen)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000226 "A specific tool or script that likely utilizes the general packing capabilities of PACKMOL (a program for creating initial configurations of molecules in defined regions) specifically for generating lipid bilayer structures for membrane simulations. Memgen might refer to a set of routines or scripts that work with PACKMOL to arrange lipids correctly around a pre-positioned membrane protein or to build pure bilayers with specific properties, automating the membrane generation process. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000226 "PACKMOL-Memgen"@en)
SubClassOf(obo:MOLSIM_000226 obo:MOLSIM_000225)

# Class: obo:MOLSIM_000227 (membrane protein orientation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000227 "A computational tool designed to predict or determine the likely orientation and transmembrane embedding depth of a protein structure within a lipid bilayer. Correctly positioning a membrane protein in the bilayer is a critical first step for setting up realistic membrane protein simulations. These tools often use algorithms based on hydrophobicity analysis, sequence features, or structural properties to find the most favorable position relative to the hydrophobic core and hydrophilic headgroup regions of the membrane."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000227 "membrane protein orientation tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000227 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000227 obo:MOLSIM_001850)

# Class: obo:MOLSIM_000228 (memembed)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000228 "A specific computational tool or algorithm designed to predict the optimal orientation and insertion depth of a membrane protein within a lipid bilayer. It works from a knowledge-based statistical potential."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000228 "memembed"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000228 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000228 obo:MOLSIM_000227)

# Class: obo:MOLSIM_000229 (resolution-based simulation method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000229 "A simulation method classified by how much structural detail it keeps, from every atom represented separately to many atoms grouped into 1 particle. The choice is the main control on what a simulation costs and on what can be seen in its result. A grouped model runs far longer and further, but nothing smaller than a group can be observed in it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000229 "simulation type"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000229 "resolution-based simulation method"@en)
SubClassOf(obo:MOLSIM_000229 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000230 (all-atom molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000230 "All-atom molecular dynamics (AA-MD) is a simulation technique where every individual atom in the molecular system, including hydrogen atoms and explicit solvent molecules, is represented. The motion of each atom is simulated over time by numerically integrating Newton's equations of motion using forces derived from a classical force field. This approach provides high structural detail but is computationally intensive, limiting accessible timescales and system sizes."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000230 "AA-MD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000230 "all-atom molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000230 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000230 obo:MOLSIM_000229)

# Class: obo:MOLSIM_000231 (interaction energy model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000231 "A model specifying which contributions make up the total potential energy of a system and what functional form each takes. It is the structure of a force field, as distinct from the numbers filling it. Two force fields with the same structure and different numbers behave differently; 2 with different structures cannot share numbers at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000231 "interaction energy model"@en)
SubClassOf(obo:MOLSIM_000231 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000232 (bond interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000232 "A component of the potential energy stored in the stretching or compression of covalent bonds away from their preferred length. It is usually modelled as a spring, which rises steeply for small departures and never lets the bond break. That is why an ordinary force field cannot describe a chemical reaction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000232 "bond interaction energy"@en)
SubClassOf(obo:MOLSIM_000232 obo:MOLSIM_000231)
SubClassOf(obo:MOLSIM_000232 obo:MOLSIM_001294)

# Class: obo:MOLSIM_000233 (gravitational interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000233 "A potential energy arising from the gravitational attraction between masses. At the scale of molecules it is smaller than the electrostatic interaction by roughly 36 orders of magnitude, so no molecular simulation includes it. The term exists for completeness in the list of fundamental interactions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000233 "gravitational interaction energy"@en)
SubClassOf(obo:MOLSIM_000233 obo:MOLSIM_000231)

# Class: obo:MOLSIM_000234 (electromagnetic interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000234 "A potential energy arising from electromagnetic forces, covering both the attraction and repulsion between charges and the weaker interactions between magnetic moments. Every chemical interaction is ultimately of this kind, including bonding and dispersion. In a force field it appears explicitly as the electrostatic term and implicitly in all the others. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000234 "electromagnetic interaction energy"@en)
SubClassOf(obo:MOLSIM_000234 obo:MOLSIM_000231)

# Class: obo:MOLSIM_000235 (nuclear interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000235 "A potential energy arising from the strong and weak nuclear forces, which act only within an atomic nucleus over distances of about a femtometre. They hold the nucleus together and govern radioactive decay. They never appear in a molecular simulation, which treats each nucleus as a single unchanging particle. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000235 "nuclear interaction energy"@en)
SubClassOf(obo:MOLSIM_000235 obo:MOLSIM_000231)

# Class: obo:MOLSIM_000236 (weighted histogram analysis method analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000236 "A free energy analysis method that combines histograms from several biased simulations, such as the windows of an umbrella sampling run, into a single unbiased free energy profile. It solves self-consistently for the free energy offset of each window, which is what removes the bias. It needs the sampled ranges of neighbouring windows to overlap. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000236 "WHAM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000236 "weighted histogram analysis method analysis"@en)
SubClassOf(obo:MOLSIM_000236 obo:MOLSIM_000353)

# Class: obo:MOLSIM_000237 (potential mean force analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000237 "The Potential of Mean Force (PMF) method calculates the free energy profile of a system as a function of one or more specific coordinates, often called reaction coordinates or order parameters. It essentially describes the effective potential energy governing the system's behavior along those chosen coordinates, including entropic effects averaged over all other degrees of freedom. PMFs are crucial for understanding reaction mechanisms, binding processes, and conformational changes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000237 "potential of mean force analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000237 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000237 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000238 (trajectory approach analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000238 "A free energy analysis method distinguished by how many simulations its snapshots come from: 1 simulation of the complex, or separate simulations of the complex, the free receptor and the free ligand. The single-trajectory choice cancels internal energy terms and is cheaper, but it cannot capture conformational change on binding. The choice affects both cost and accuracy, so it must be recorded with the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000238 "trajectory approach analysis"@en)
SubClassOf(obo:MOLSIM_000238 obo:MOLSIM_000262)

# Class: obo:MOLSIM_000239 (single trajectory)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000239 "The single trajectory approach, often used in MM/PBSA and MM/GBSA calculations, involves running only one molecular dynamics simulation of the protein-ligand complex. Snapshots of the complex, the protein alone, and the ligand alone are then extracted directly from this single trajectory for endpoint free energy calculations. This reduces the computational cost compared to running three separate simulations but assumes the conformations sampled in the complex are representative for the free states."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000239 "single trajectory"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000239 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000239 obo:MOLSIM_000238)

# Class: obo:MOLSIM_000240 (pKa tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000240 "A computational tool specifically designed to predict the pKa values of ionizable groups (acidic or basic sites) within a molecule, typically amino acid residues in a protein or functional groups in a ligand. The pKa value indicates the pH at which a group is 50% protonated/deprotonated. These tools use various methods, ranging from simple empirical rules to sophisticated calculations involving continuum electrostatics (solving Poisson-Boltzmann equation) or QM methods, to estimate how the molecular environment shifts the intrinsic pKa of a group. PROPKA is a well-known example."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000240 "pKa tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000240 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000240 obo:MOLSIM_000490)

# Class: obo:MOLSIM_000241 (PROPKA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000241 "A widely used, fast empirical method and software tool for predicting the pKa values of ionizable residues in proteins and protein-ligand complexes. PROPKA uses information about the local structural environment (hydrogen bonds, desolvation, interactions with charged groups) to estimate shifts from standard reference pKa values, providing quick and often reasonably accurate pKa predictions crucial for determining protonation states at a given simulation pH. It's often integrated into other tools like PDB2PQR. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000241 "PROPKA"@en)
SubClassOf(obo:MOLSIM_000241 obo:MOLSIM_000240)

# Class: obo:MOLSIM_000242 (MMPBSA.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000242 "A specific implementation of the MM/PBSA and MM/GBSA methods, distributed as a Python script within the AmberTools software suite. It reads trajectory files (from AMBER or other packages) and calculates binding free energies by computing the MM energy components (using sander or other external programs), the electrostatic solvation energy (using PB or GB solvers), and the nonpolar solvation energy (SASA-based), and combining them according to the MM/PBSA or MM/GBSA schemes. It automates this popular but approximate free energy estimation procedure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000242 "MMPBSA.py"@en)
SubClassOf(obo:MOLSIM_000242 obo:MOLSIM_000460)

# Class: obo:MOLSIM_000243 (in-silico mutagenesis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000243 "A computational tool that allows researchers to simulate the effects of mutations (changing one amino acid residue to another) on the structure, stability, dynamics, or binding affinity of a protein. These tools typically take a protein structure, allow the user to specify mutations, and then use algorithms (often based on molecular mechanics energy functions, rotamer libraries, or machine learning) to model the structural changes and estimate the impact on stability (ddG) or other properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000243 "in-silico mutagenesis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000243 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000243 obo:MOLSIM_001850)

# Class: obo:MOLSIM_000244 (FoldX)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000244 "A popular empirical force field and associated software tool specifically designed for rapid calculation of protein stability changes upon mutation (in silico mutagenesis). FoldX uses an energy function that includes terms relevant to protein folding stability (like VdW interactions, solvation energy, hydrogen bonds, electrostatics, entropy) to estimate the folding free energy of a protein structure and, importantly, the change in folding free energy (ΔΔG) caused by single or multiple point mutations. It's widely used for predicting mutation effects and in protein design. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000244 "FoldX"@en)
SubClassOf(obo:MOLSIM_000244 obo:MOLSIM_000243)

# Class: obo:MOLSIM_000245 (tunnel predictor tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000245 "A computational tool designed to identify and characterize pathways, channels, or tunnels within the structure of a macromolecule, typically a protein enzyme. These tunnels often connect a buried active site to the protein surface and are important for ligand entry/egress, solvent access, or product release. Tools like CAVER use geometric algorithms to find voids and pathways within the protein structure based on atomic coordinates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000245 "tunnel predictor tool"@en)
SubClassOf(obo:MOLSIM_000245 obo:MOLSIM_000164)

# Class: obo:MOLSIM_000246 (CAVER)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000246 "A software tool for identifying and analyzing tunnels and channels in protein structures. CAVER uses computational geometry algorithms to explore the void space within a protein (or dynamic snapshots from a simulation) and simulates the introduction of probes to map the surface and the cavities of a target. It provides information on the location, dimensions (bottleneck radius), curvature, and physicochemical properties of identified tunnels."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000246 "CAVER"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000246 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000246 obo:MOLSIM_000245)

# Class: obo:MOLSIM_000247 (GROMACS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000247 "A highly popular, versatile, and extremely fast open-source software package primarily designed for classical molecular dynamics simulations of biomolecules like proteins, lipids, and nucleic acids. Known for its computational efficiency, particularly on parallel architectures (CPUs and GPUs), GROMACS supports various force fields (including AMBER, CHARMM, OPLS, GROMOS families via ports), simulation protocols, enhanced sampling methods, and includes extensive tools for trajectory analysis. It is widely used in the academic and industrial research community. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000247 "GROMACS"@en)
SubClassOf(obo:MOLSIM_000247 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000248 (CHARMM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000248 "A versatile and long-established software package for molecular simulation, encompassing molecular mechanics (MM) and dynamics (MD), as well as capabilities for QM/MM and complex modeling tasks (stands for Chemistry at HARvard Macromolecular Mechanics). CHARMM is associated with its own widely used force field family (e.g., CHARMM36) and provides extensive functionalities for preparing, running, and analyzing simulations, particularly for proteins, lipids, nucleic acids, and carbohydrates. Both a free academic version and a licensed version exist."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000248 "CHARMM"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000248 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000248 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000249 (ion parameterization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000249 "The set of numbers defining how an ion interacts non-covalently in a force field, being its charge, its size and its interaction strength. Ions are hard to parameterise because a single set cannot match every measured property at once. The choice therefore depends on what the simulation is meant to reproduce. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000249 "ion parameterization"@en)
SubClassOf(obo:MOLSIM_000249 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000250 (Li and Merz 12-6)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000250 "A set of van der Waals parameters for common single-atom ions, fitted for the standard 12-6 form of the potential. Separate versions were fitted to reproduce different target properties, because no single set reproduces hydration free energy and ion-water distance at once. Which version was used must be recorded, since they are not interchangeable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000250 "Li and Merz 12-6"@en)
SubClassOf(obo:MOLSIM_000250 obo:MOLSIM_000249)

# Class: obo:MOLSIM_000251 (trajectory processing tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000251 "An analysis tool specifically focused on reading, processing, manipulating, and analyzing molecular dynamics trajectory files. These tools provide functionalities to read various trajectory formats, select specific atoms or frames, perform calculations over time (like RMSD, distances, angles), calculate average structures, remove solvent, re-image periodic boundaries, and write out modified trajectories or extracted data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000251 "trajectory processing tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000251 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000251 obo:MOLSIM_000164)

# Class: obo:MOLSIM_000252 (CPPTRAJ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000252 "A powerful command-line trajectory analysis program, distributed with AmberTools, capable of processing trajectories from many simulation packages (AMBER, GROMACS, NAMD, CHARMM, etc.) and performing a wide variety of analyses. Its capabilities include calculating structural metrics (RMSD, radius of gyration, distances, angles, dihedrals), analyzing hydrogen bonds, performing principal component analysis (PCA), clustering, calculating interaction energies, grid analysis, and extensive data manipulation and output options. It is a central tool for analyzing simulation data in the AMBER ecosystem and beyond."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000252 "CPPTRAJ"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000252 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000252 obo:MOLSIM_000251)

# Class: obo:MOLSIM_000253 (clustering algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000253 "An algorithm used in data analysis to group a set of objects (e.g., molecular conformations, data points) such that objects in the same group (cluster) are more similar to each other than to those in other groups. Clustering algorithms use various criteria and methods (e.g., distance-based, density-based, hierarchical) to identify inherent structures or patterns within unlabeled data. They are essential tools for exploring and understanding complex datasets. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000253 "clustering algorithm"@en)
SubClassOf(obo:MOLSIM_000253 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000254 (hierarchical agglomerative bottom-up algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000254 "A specific type of clustering algorithm that builds a hierarchy of clusters starting with each data point as its own cluster and iteratively merging the two closest clusters until only one cluster (containing all points) remains. This process creates a tree-like structure (dendrogram) that can be cut at different levels to obtain different numbers of clusters. It provides a nested partitioning of the data based on similarity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000254 "hierarchical agglomerative bottom-up algorithm"@en)
SubClassOf(obo:MOLSIM_000254 obo:MOLSIM_000253)

# Class: obo:MOLSIM_000255 (static molecular interaction prediction modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000255 "A modelling method that predicts how molecules will bind from their fixed structures alone, without simulating them moving. It scores how well 2 shapes fit together and how favourable the contacts are, rather than following the binding as it happens. It is fast enough to test millions of candidate molecules, which no simulation-based method can do. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000255 "static molecular interaction prediction modeling"@en)
SubClassOf(obo:MOLSIM_000255 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000256 (protein-protein docking analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000256 "A computational method that predicts the structure of a complex formed when 2 proteins bind, given the structure of each on its own. It searches over the ways the 2 surfaces can meet and scores each arrangement. It is harder than docking a small molecule, because the contact area is far larger and both partners may change shape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000256 "protein-protein docking analysis"@en)
SubClassOf(obo:MOLSIM_000256 obo:MOLSIM_000255)

# Class: obo:MOLSIM_000257 (endpoint free energy tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000257 "A software program that estimates a binding or solvation free energy from the initial and final states of a process alone, without simulating any path between them. It combines molecular mechanics energies with a continuum solvation model and a surface area term. It is much cheaper than an alchemical calculation and correspondingly less rigorous. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000257 "endpoint free energy tool"@en)
SubClassOf(obo:MOLSIM_000257 obo:MOLSIM_001564)

# Class: obo:MOLSIM_000258 (Antechamber)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000258 "A specific program, typically distributed as part of the AmberTools suite, designed to automatically assign atom types and calculate partial atomic charges for organic molecules, preparing them for use with molecular mechanics force fields like GAFF (General AMBER Force Field). Antechamber reads common molecular file formats and generates topology and parameter files needed for subsequent energy minimization or molecular dynamics simulations using programs like SANDER or PMEMD from the AMBER package. It is a crucial tool for preparing non-standard residues or ligands for simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000258 "Antechamber"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000258 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000258 obo:MOLSIM_000172)

# Class: obo:MOLSIM_000259 (topology and coordinate generation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000259 "A tool used in the preparation stage of a simulation to generate the molecular topology file (defining atom types, bonds, angles, dihedrals, charges, non-bonded parameters according to a force field) and initial coordinate file for the system to be simulated. These tools typically take structural information (like a PDB file) and force field definitions as input and assemble the complete system description required by the simulation engine. tleap in AmberTools is a classic example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000259 "topology and coordinate generation tool"@en)
SubClassOf(obo:MOLSIM_000259 obo:MOLSIM_001556)

# Class: obo:MOLSIM_000260 (tleap)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000260 "A core program within the AmberTools suite used for building the topology (parameter) files and initial coordinate files for simulations with AMBER. Tleap reads force field definition files, structural fragments (like amino acid residues or solvent molecules), and user-provided structure files (e.g., PDB), then connects units (e.g., solvating a protein), adds counterions, and writes out the prmtop (topology) and inpcrd (coordinate) files necessary to run simulations with SANDER or PMEMD. It is an essential setup tool in the AMBER workflow. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000260 "LEaP"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000260 "tleap"@en)
SubClassOf(obo:MOLSIM_000260 obo:MOLSIM_000259)

# Class: obo:MOLSIM_000261 (binding free energy calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000261 "Binding free energy encompasses computational techniques specifically designed to estimate the Gibbs free energy change (ΔGbind) associated with the non-covalent binding of two molecules. Calculating binding free energy is crucial for predicting molecular interactions, understanding binding affinity in drug design, and validating docking poses. These methods range from approximate endpoint methods to more rigorous alchemical transformations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000261 "binding free energy calculation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000261 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000261 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000262 (molecular mechanics Poisson Boltzmann surface area analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000262 "A free energy analysis method that estimates a binding free energy from snapshots of the bound and free states by adding 3 terms: the molecular mechanics energy in vacuum, the polar solvation free energy from the Poisson-Boltzmann equation, and a non-polar term scaled from the solvent-accessible surface area. It uses only the end states, so it needs no path of intermediates. That makes it much cheaper than an alchemical calculation and correspondingly less rigorous. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000262 "MM/PBSA"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000262 "MMPBSA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000262 "molecular mechanics Poisson Boltzmann surface area analysis"@en)
SubClassOf(obo:MOLSIM_000262 obo:MOLSIM_000326)

# Class: obo:MOLSIM_000263 (molecular mechanics generalized Born surface area analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000263 "A free energy analysis method that estimates a binding free energy in the same way as the Poisson-Boltzmann variant, but computes the polar solvation term with the generalized Born approximation instead of solving the Poisson-Boltzmann equation. The approximation is much faster and usually close enough for ranking related ligands. The molecular mechanics and surface-area terms are unchanged. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000263 "MM/GBSA"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000263 "MMGBSA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000263 "molecular mechanics generalized Born surface area analysis"@en)
SubClassOf(obo:MOLSIM_000263 obo:MOLSIM_000326)

# Class: obo:MOLSIM_000264 (linear interaction energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000264 "A free energy analysis method that estimates a binding free energy from the change in the average electrostatic and van der Waals interaction energies of a ligand with its surroundings between the bound and the free state. The 2 changes are combined with empirical scaling coefficients rather than computed from first principles. It needs 1 simulation of the complex and 1 of the ligand in solution, which is far fewer than an alchemical route. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000264 "LIE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000264 "linear interaction energy analysis"@en)
SubClassOf(obo:MOLSIM_000264 obo:MOLSIM_000326)

# Class: obo:MOLSIM_000265 (alchemical free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000265 "A free energy analysis method that computes a free energy difference by simulating a reversible path between 2 states through intermediates that need not be physically realisable. The energy function is changed gradually along the path, for example turning a ligand's interactions off, and the free energy is recovered from how the system responds. Free energy perturbation and thermodynamic integration are the 2 standard ways of doing it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000265 "alchemical free energy analysis"@en)
SubClassOf(obo:MOLSIM_000265 obo:MOLSIM_000261)

# Class: obo:MOLSIM_000266 (free energy perturbation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000266 "Free Energy Perturbation (FEP) is an alchemical method for calculating free energy differences between two states (A and B) by simulating a series of intermediate states that gradually transform A into B. The free energy change between adjacent intermediate states (λ and λ+Δλ) is calculated using the Zwanzig equation, which involves ensemble averaging the energy difference exponentiated. Summing the free energy changes over all intermediate steps yields the total free energy difference between A and B."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000266 "FEP"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000266 "free energy perturbation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000266 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000266 obo:MOLSIM_000265)

# Class: obo:MOLSIM_000267 (CHAP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000267 "The Channel Annotation Package (CHAP) is a specialized software tool used to analyze the functional properties of pores and channels in membrane proteins. It calculates a detailed pore radius profile combined with a hydrophobicity profile to estimate the free energy barriers for water and ion permeation. This analysis allows researchers to visualize solvent behavior inside the pore and determine the conductive state of ion channels."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000267 "CHAP"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000267 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000267 obo:MOLSIM_000245)

# Class: obo:MOLSIM_000268 (binding free energy estimator 2 analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000268 "Binding Free Energy Estimator 2 (BFEE2) is a comprehensive computational workflow designed to calculate protein-ligand binding free energies with 'chemical' accuracy. Its packages automate a rigorous multi-step process that includes enhanced sampling of the ligand's binding pose and the use of alchemical or geometrical free energy methods to compute the final affinity."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000268 "BFEE2"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000268 "binding free energy estimator 2 analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000268 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000268 obo:MOLSIM_000261)

# Class: obo:MOLSIM_000269 (non-equilibrium free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000269 "A free energy analysis method that recovers an equilibrium free energy difference from simulations deliberately driven away from equilibrium, by applying a fluctuation theorem to the work done. Many fast, irreversible transformations are run between the 2 states and the work distribution is analysed with Jarzynski's equality or Crooks' theorem. It can be cheaper than the equilibrium alchemical route because each transformation is short. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000269 "NEQ"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000269 "non-equilibrium free energy analysis"@en)
SubClassOf(obo:MOLSIM_000269 obo:MOLSIM_000261)

# Class: obo:MOLSIM_000270 (Poisson-Boltzmann surface area)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000270 "A method (often abbreviated PB/SA) for calculating the free energy of solvation by combining two components: the electrostatic contribution calculated by numerically solving the Poisson-Boltzmann (PB) equation, and the non-polar contribution estimated as being proportional to the solvent-accessible surface area (SASA) of the solute. The PB equation provides a more rigorous treatment of continuum electrostatics than GB models by accounting for solute shape and charge distribution within a dielectric medium, while the SASA term models the cost of creating the solute cavity in the solvent and attractive solute-solvent van der Waals interactions. This method is often used for post-processing simulation trajectories to estimate binding free energies. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000270 "PBSA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000270 "Poisson-Boltzmann surface area"@en)
SubClassOf(obo:MOLSIM_000270 obo:MOLSIM_000068)

# Class: obo:MOLSIM_000271 (generalized Born surface area)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000271 "A method (often abbreviated GB/SA) for calculating the free energy of solvation, similar to PB/SA, but using a Generalized Born (GB) model instead of the Poisson-Boltzmann equation to compute the electrostatic contribution. It combines the GB electrostatic energy with a non-polar energy term proportional to the solvent-accessible surface area (SASA). GBSA offers a computationally much cheaper alternative to PB/SA for estimating solvation free energies, suitable for use during simulations or large-scale analyses, though potentially less accurate depending on the GB implementation and system. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000271 "GBSA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000271 "generalized Born surface area"@en)
SubClassOf(obo:MOLSIM_000271 obo:MOLSIM_000068)

# Class: obo:MOLSIM_000272 (radii set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000272 "A defined collection or list that assigns specific atomic radius values to different atom types (defined by element, hybridization state, and sometimes chemical environment). These radii are used in various computational molecular modeling contexts, such as calculating molecular surfaces (like Van der Waals surface or Solvent Accessible Surface Area - SASA), estimating molecular volumes, defining cavities, or as parameters within implicit solvent models (e.g., determining effective Born radii for GB models or defining the dielectric boundary for PB models). Different radii sets exist (e.g., Bondi Van der Waals radii, radii optimized for solvation calculations like PARSE), derived from different physical principles or empirical fitting procedures. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000272 "radii set"@en)
SubClassOf(obo:MOLSIM_000272 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000273 (bondi)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000273 "A set of van der Waals radii covering most of the periodic table, compiled by Bondi in the 1960s from crystallographic contact distances and gas-phase properties. It is the reference set most later radii sets were derived from by modification. It was not fitted for use in any solvation model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000273 "bondi"@en)
SubClassOf(obo:MOLSIM_000273 obo:MOLSIM_000272)

# Class: obo:MOLSIM_000274 (mbondi)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000274 "A set of van der Waals radii derived from the Bondi set with adjustments for particular atom types, chiefly hydrogen. The adjustments were made so that generalized Born solvation energies better match Poisson-Boltzmann ones. The prefix stands for modified. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000274 "mbondi"@en)
SubClassOf(obo:MOLSIM_000274 obo:MOLSIM_000272)

# Class: obo:MOLSIM_000275 (mbondi2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000275 "A specific version ('version 2') of modified Bondi radii, developed primarily for use within the AMBER simulation package, particularly in conjunction with specific Generalized Born (GB) implicit solvent models (like GB models with igb=2 or igb=5 in AMBER). These radii have been empirically optimized by adjusting values (especially for hydrogens, C, N, O, S, P) relative to the original Bondi set or earlier mbondi sets to yield improved accuracy in reproducing experimental solvation free energies of small molecules and potentially biomolecular energetics when using those particular GBSA methods. They represent a parameter set tuned for a specific computational model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000275 "mbondi2"@en)
SubClassOf(obo:MOLSIM_000275 obo:MOLSIM_000272)

# Class: obo:MOLSIM_000276 (enthropic contributions mode analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000276 "A thermodynamics analysis method that estimates the entropy term of the free energy from the vibrational modes of a system. It approximates entropy from how the system vibrates about an average structure, rather than counting states directly. Normal mode analysis and the quasiharmonic approximation are the 2 usual routes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000276 "enthropic contributions mode analysis"@en)
SubClassOf(obo:MOLSIM_000276 obo:MOLSIM_000309)

# Class: obo:MOLSIM_000277 (quasiharmonic analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000277 "A dynamics analysis method that estimates vibrational entropy from a trajectory by treating atoms as oscillating harmonically about their average positions. It diagonalises the mass-weighted covariance matrix of the atomic fluctuations to obtain effective frequencies, which are then put through the standard harmonic oscillator formulas. Unlike normal mode analysis it uses the sampled motion rather than a single minimum, so it captures anharmonic breadth as an effective frequency. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000277 "QHA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000277 "quasiharmonic analysis"@en)
SubClassOf(obo:MOLSIM_000277 obo:MOLSIM_000276)
DisjointClasses(obo:MOLSIM_000277 obo:MOLSIM_000278)

# Class: obo:MOLSIM_000278 (normal mode analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000278 "A dynamics analysis method that computes the vibrational modes and frequencies of a molecule by treating its motion as harmonic about a single energy minimum. It builds the matrix of second derivatives of the potential energy at that minimum and diagonalises it, giving collective modes as eigenvectors and their frequencies from the eigenvalues. Those frequencies are what a vibrational entropy estimate is built from. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000278 "NMA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000278 "normal mode analysis"@en)
SubClassOf(obo:MOLSIM_000278 obo:MOLSIM_000276)

# Class: obo:MOLSIM_000279 (1 trajectory approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000279 "A trajectory approach for end-point binding free energy calculations in which only the complex is simulated, and the receptor and ligand structures are taken from that same trajectory. Because every structure comes from 1 simulation, the internal energies of the parts cancel exactly, which removes most of the statistical noise. The price is that neither part can relax into the shape it would take on its own, so any real conformational change on binding is missed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000279 "1 trajectory approach"@en)
SubClassOf(obo:MOLSIM_000279 obo:MOLSIM_000238)

# Class: obo:MOLSIM_000280 (3 trajectory approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000280 "A trajectory approach for end-point binding free energy calculations in which the complex, the free receptor and the free ligand are each simulated separately. Each component is therefore sampled in the state it is actually in, which captures any conformational change on binding. The cost is 3 simulations instead of 1, and much larger statistical noise, because the internal energies no longer cancel. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000280 "3 trajectory approach"@en)
SubClassOf(obo:MOLSIM_000280 obo:MOLSIM_000238)

# Class: obo:MOLSIM_000281 (thermodynamic integration similarity calculation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000281 "A type of utility program used to help set up a thermodynamic integration (TI) free energy calculation. It assesses the similarity between the starting and ending molecules of a planned alchemical transformation, often by calculating the overlap of their potential energies. The results from this tool are used to design an optimal pathway with an appropriate number of intermediate steps, which is crucial for ensuring the TI calculation will be accurate and reliable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000281 "thermodynamic integration similarity calculation tool"@en)
SubClassOf(obo:MOLSIM_000281 obo:MOLSIM_001556)

# Class: obo:MOLSIM_000282 (ROCS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000282 "A software program that compares molecules by overlaying their 3-dimensional shapes and chemical features rather than their bond connectivity. Two molecules built on different scaffolds can occupy the same space and bind the same site, which a structure comparison would miss. It is used to search for such replacements. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000282 "rapid overlay of chemical structures"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000282 "ROCS"@en)
SubClassOf(obo:MOLSIM_000282 obo:MOLSIM_000281)
SubClassOf(obo:MOLSIM_000282 obo:MOLSIM_001684)

# Class: obo:MOLSIM_000283 (AMBER-FEW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000283 "This likely refers to FEW (Free Energy Workflow), a tool or set of scripts designed to automate and manage free energy calculations (like FEP or TI) specifically using the AMBER simulation package. Such workflows typically handle tasks like setting up the simulation legs (lambda windows), running the simulations, collecting data, and performing the final free energy analysis, aiming to simplify and standardize complex free energy calculation protocols within the AMBER environment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000283 "AMBER-FEW"@en)
SubClassOf(obo:MOLSIM_000283 obo:MOLSIM_000281)

# Class: obo:MOLSIM_000284 (OpenCalphad)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000284 "An open-source software library for thermodynamic calculations using the CALPHAD method, which models phase equilibria in multi-component systems from fitted Gibbs energy expressions. It is used in materials science and metallurgy to compute phase diagrams. It is a thermodynamic modelling tool rather than a molecular simulation one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000284 "OpenCalphad"@en)
SubClassOf(obo:MOLSIM_000284 obo:MOLSIM_000281)

# Class: obo:MOLSIM_000285 (Brick-CFCMC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000285 "This likely refers to a tool or module implementing the Continuous Fractional Component Monte Carlo (CFCMC) method, possibly within a specific software framework ('Brick'). CFCMC is an advanced Monte Carlo simulation technique used for calculating chemical potentials and free energies, particularly useful for phase equilibria or solvation free energy calculations, by allowing molecules to be gradually inserted or deleted via a fractional intermediate state. It's a specialized free energy calculation method distinct from standard TI or FEP. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000285 "Brick-CFCMC"@en)
SubClassOf(obo:MOLSIM_000285 obo:MOLSIM_000281)

# Class: obo:MOLSIM_000286 (thermodynamic integration approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000286 "A free energy analysis method distinguished by how a thermodynamic integration calculation is arranged: how the path between the states is built, how the intermediate states are spaced, and how the atoms of the 2 states are mapped onto each other. The choices affect cost and convergence but not the quantity being computed. Its subclasses each fix 1 of those choices. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000286 "thermodynamic integration approach"@en)
SubClassOf(obo:MOLSIM_000286 obo:MOLSIM_000355)

# Class: obo:MOLSIM_000287 (standard thermodynamic integration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000287 "A thermodynamic integration approach in which independent simulations are run at a set of fixed values of the coupling parameter and the results integrated numerically. Each simulation is independent of the others, so they can all be run at once. It is the arrangement every other variant is compared against. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000287 "standard thermodynamic integration"@en)
SubClassOf(obo:MOLSIM_000287 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000288 (extended thermodynamic integration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000288 "Extended Thermodynamic Integration likely refers to modifications or extensions of the standard TI protocol designed to handle more complex transformations, improve sampling efficiency, or apply TI in broader contexts beyond simple λ-coupling. This might include approaches combining TI principles with non-equilibrium work measurements, using specialized integration schemes along multiple reaction coordinates, or applying advanced sampling techniques at intermediate λ states. The specific meaning depends heavily on the context in which it is used. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000288 "extended thermodynamic integration"@en)
SubClassOf(obo:MOLSIM_000288 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000289 (dual-topology approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000289 "A thermodynamic integration approach in which the atoms of both states are present in the system at once, with each set coupled to the rest according to the coupling parameter and invisible to the other. It handles changes in connectivity that a single set of atoms cannot represent. It costs more, because both states are simulated throughout. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000289 "dual-topology approach"@en)
SubClassOf(obo:MOLSIM_000289 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000290 (single-topology approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000290 "A thermodynamic integration approach in which 1 set of atoms has its types, charges and van der Waals parameters changed along the path, with atoms present in only 1 state grown or shrunk to nothing. It keeps the atom count fixed throughout. It is compact but awkward when the 2 states have different connectivity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000290 "single-topology approach"@en)
SubClassOf(obo:MOLSIM_000290 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000291 (1-step soft-core approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000291 "A thermodynamic integration approach that uses a soft-core potential to cover the whole transformation in 1 window, or very few. The soft-core form keeps the energy finite as atoms appear and disappear, which is what makes so few windows possible. It saves simulation time at the cost of relying heavily on the soft-core form being well behaved. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000291 "1-step soft-core approach"@en)
SubClassOf(obo:MOLSIM_000291 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000292 (multi-step approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000292 "A thermodynamic integration approach that divides the path between the 2 states into several discrete windows, each sampled separately. Dividing it keeps the change between neighbouring windows small enough for the samples to overlap. It is the standard arrangement, and the alternative of a single window is a special case. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000292 "multi-step approach"@en)
SubClassOf(obo:MOLSIM_000292 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000293 (Hamiltonian replica exchange)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000293 "A thermodynamic integration approach in which the simulations at different coupling values run in parallel and periodically swap configurations, with the swap accepted or rejected by a Metropolis criterion. Swapping lets a configuration travel along the whole path, which relieves sampling bottlenecks at any single value. It converges faster than independent windows for the same total simulation time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000293 "Hamiltonian replica exchange"@en)
SubClassOf(obo:MOLSIM_000293 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000294 (conveyor belt thermodynamic integration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000294 "A thermodynamic integration approach in which several replicas move together along the coupling parameter, keeping a fixed spacing between them as the whole set advances. Coupling their movement means the path is traversed as a unit rather than sampled at fixed points. It is intended to reduce the number of replicas needed for a given accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000294 "CBTI"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000294 "conveyor belt thermodynamic integration"@en)
SubClassOf(obo:MOLSIM_000294 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000295 (optimization of alchemical pathways)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000295 "A thermodynamic integration approach that chooses the number and the spacing of the intermediate coupling values so as to minimise the statistical error for a given amount of simulation. Even spacing is wasteful, because the integrand changes much faster near the end points than in the middle. The spacing may be fixed in advance or adjusted as the calculation runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000295 "optimization of alchemical pathways"@en)
SubClassOf(obo:MOLSIM_000295 obo:MOLSIM_000286)

# Class: obo:MOLSIM_000296 (free energy workflow)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000296 "A workflow that sets up, runs and analyses a free energy calculation as one automated sequence. It manages the many coupling states, their simulations and the collection of their output, which is otherwise done by hand and easily got wrong. It is what makes a campaign over many ligands practical. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000296 "FEW"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000296 "free energy workflow"@en)
SubClassOf(obo:MOLSIM_000296 obo:MOLSIM_000167)

# Class: obo:MOLSIM_000298 (thermodynamic integration extrapolation approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000298 "This category encompasses variants of TI calculations where the full integral ∫ 0 1 ⟨∂H/∂λ⟩λ dλ is estimated based on simulation data obtained only at or near the endpoints (λ=0 and λ=1) or at a very limited number of intermediate points, using some form of extrapolation. These approaches aim to significantly reduce the computational cost associated with simulating many intermediate λ states. The accuracy critically depends on the validity of the extrapolation scheme used for the specific system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000298 "thermodynamic integration extrapolation approach"@en)
SubClassOf(obo:MOLSIM_000298 obo:MOLSIM_000355)

# Class: obo:MOLSIM_000299 (thermodynamic integration with linear extrapolation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000299 "A thermodynamic integration approach that samples the integrand only at or near the 2 end points and assumes it varies linearly between them. Assuming linearity removes every intermediate simulation, which is where nearly all the cost lies. It is only valid where the integrand really is close to linear, which is uncommon. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000299 "thermodynamic integration with linear extrapolation"@en)
SubClassOf(obo:MOLSIM_000299 obo:MOLSIM_000298)
DisjointClasses(obo:MOLSIM_000299 obo:MOLSIM_000356)

# Class: obo:MOLSIM_000300 (free energy and molecular dynamics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000300 "Analysis techniques and calculated properties that are particularly characteristic of or frequently applied to data generated from molecular dynamics (MD) simulations, especially those aimed at calculating free energies or characterizing structural dynamics. These methods help interpret the complex time-series data produced by MD. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000300 "free energy and molecular dynamics analysis"@en)
SubClassOf(obo:MOLSIM_000300 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000301 (Bennett acceptance ratio analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000301 "A free energy analysis method that estimates the free energy difference between 2 thermodynamic states by combining the forward and reverse work distributions sampled in both. For a given amount of simulation data it gives the lowest-variance estimate available. It handles exactly 2 states; the multi-state generalisation is a separate term. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000301 "BAR"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000301 "Bennett acceptance ratio analysis"@en)
SubClassOf(obo:MOLSIM_000301 obo:MOLSIM_000300)
DisjointClasses(obo:MOLSIM_000301 obo:MOLSIM_000302)

# Class: obo:MOLSIM_000302 (multi-state Bennett acceptance ratio analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000302 "A free energy analysis method that combines data from simulations run at many thermodynamic states at once, and returns the free energy difference between any pair of them together with equilibrium averages. It uses every sample from every state rather than only neighbouring pairs, which is what makes it statistically optimal. It generalises the 2-state Bennett acceptance ratio. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000302 "MBAR"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000302 "multi-state Bennett acceptance ratio analysis"@en)
SubClassOf(obo:MOLSIM_000302 obo:MOLSIM_000300)

# Class: obo:MOLSIM_000303 (linear dependence evaluation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000303 "A mathematical technique used to determine if a set of variables or vectors (e.g., descriptive coordinates or components from data analysis) are linearly related, meaning one can be expressed as a combination of the others. In simulation analysis, this is often used to check for redundancy in sets of collective variables or principal components derived from trajectory data. Identifying such dependencies can help simplify models or analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000303 "linear dependence evaluation analysis"@en)
SubClassOf(obo:MOLSIM_000303 obo:MOLSIM_000383)

# Class: obo:MOLSIM_000304 (experimental method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000304 "An experimental method is a procedure carried out in a laboratory to make observations and gather data about the real world. As a type of method, it provides real-world data, such as a structure from X-ray crystallography or dynamics from nuclear magnetic resonance, which serves as a crucial input for validation of a computational simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000304 "experimental method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000304 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000304 obo:MOLSIM_000109)

# Class: obo:MOLSIM_000305 (modeling method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000305 "A modeling method is a computational technique used to to predict, refine, and simulate 3D molecular arrangements. As a type of computational method, it typically involves predicting a static structure or interaction pose without simulating its dynamic behavior over time, such as in protein-ligand docking. These methods often employ search algorithms and scoring functions to evaluate and rank potential conformations based on criteria like shape complementarity and interaction energy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000305 "modeling method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000305 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000305 obo:MOLSIM_000140)

# Class: obo:MOLSIM_000306 (statistical package)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000306 "A software program built for statistical analysis, data handling, plotting and reporting. It is not specific to molecular simulation, but simulation output is data like any other and is often analysed in one. R and similar environments are the usual examples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000306 "statistical package"@en)
SubClassOf(obo:MOLSIM_000306 obo:MOLSIM_000164)

# Class: obo:MOLSIM_000307 (R)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000307 "A widely used free software environment and programming language specifically designed for statistical computing and graphics. R provides a vast collection of packages contributed by users worldwide, covering nearly every area of statistical analysis, data visualization, and data science. In biomolecular simulation analysis, R is frequently used for plotting results (energy profiles, RMSD timeseries), performing statistical analysis on sampled properties, clustering conformations, and developing custom analysis workflows. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000307 "R"@en)
SubClassOf(obo:MOLSIM_000307 obo:MOLSIM_000306)
SubClassOf(obo:MOLSIM_000307 obo:MOLSIM_001659)

# Class: obo:MOLSIM_000308 (simulation method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000308 "A computational method that reproduces how a system changes over time by advancing its state in small steps according to physical laws. It covers molecular dynamics and the enhanced sampling schemes built on it, and it produces a trajectory rather than a single answer. The choice of method fixes which physical laws apply and how the state is advanced. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000308 "simulation method"@en)
SubClassOf(obo:MOLSIM_000308 obo:MOLSIM_000140)

# Class: obo:MOLSIM_000309 (entropy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000309 "A thermodynamics analysis method that estimates the contribution of disorder to the free energy of a molecular system. It works from the system's vibrational modes or from the spread of conformations in a trajectory, most often through normal mode analysis or the quasiharmonic approximation. The result is the term that must be subtracted from an energy to give a free energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000309 "entropy analysis"@en)
SubClassOf(obo:MOLSIM_000309 obo:MOLSIM_000610)

# Class: obo:MOLSIM_000310 (plan specification)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000310 "OBSOLETE. A plan specification is a document or set of rules that describes how a study or experiment should be designed and carried out. As a type of information content entity, it represents the formal design of a computational experiment, such as the ligand pairs selection criteria for a relative binding free energy study. This specification outlines the rationale and criteria for selecting systems and parameters before the simulation or analysis is performed, ensuring a systematic and reproducible approach. This concept is often described in publications in sections titled \"Experimental Design,\" \"Study Protocol,\" \"Selection Criteria,\" or \"Computational Strategy.\""@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000310 "Kept as a MOLSIM term rather than reusing IAO:0000104 plan specification, which is already present in the IAO import module but referenced nowhere. Reusing it would pull in two grouping levels MOLSIM has no use for, IAO:0000033 directive information entity and IAO:0000030 information content entity, and would place this branch under the BFO spine (BFO:0000031 generically dependent continuant and above), which MOLSIM defers. Revisit only if upper-ontology alignment is opened."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000310 "obsolete plan specification"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000310 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000310 obo:IAO_0000104)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000310 "Retired 2026-08-12 as part of the COB alignment. IAO:0000104 plan specification says the same thing and is reached from IAO:0000030 information content entity, which MOLSIM already adopted. This retirement waited until the branch was cleaned: MOLSIM:000310 previously held four children of which three were not plans, and those moved to MOLSIM:002251 atom selection specification and MOLSIM:002252 selection criteria. Its one remaining child, MOLSIM:002155 simulation protocol, was re-parented onto IAO:0000104 in the same change.")

# Class: obo:MOLSIM_000311 (RMSD analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000311 "A calculation that measures how much a molecule's shape has changed compared to a reference structure by quantifying the root-mean-square deviation of atomic coordinates after optimal superposition. This can be performed against a single static starting structure over time (1D trajectory), or calculated for every pair of frames in a simulation to produce a frame-to-frame comparative matrix, often displayed as a 2D heat map (2D RMSD analysis). It is the most common procedure for assessing simulation stability, monitoring conformational transitions, and serving as a metric for clustering algorithms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000311 "RMSD analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000311 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000311 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000312 (RMSF analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000312 "RMSF analysis is a calculation that identifies which parts of a molecule are the most flexible or wobbly. As a type of structural analysis, this method quantifies the mobility of individual atoms or residues by calculating the root-mean-square fluctuation of their positions around the time-averaged structure from a trajectory. The resulting per-residue RMSF values are directly comparable to crystallographic B-factors and are used to identify flexible loops, termini, or side chains."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000312 "RMSF analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000312 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000312 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000313 (distance RMSD analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000313 "Distance RMSD analysis is a way to compare two molecular shapes based on their internal distances, without needing to align them first. As a type of structural analysis, this method calculates the root-mean-square deviation of a matrix of internal, pairwise atomic distances between two conformations, providing a metric of structural similarity that is independent of overall rotation and translation. This is particularly useful for comparing highly flexible molecules or for clustering based on internal conformational changes rather than global alignment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000313 "distance RMSD analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000313 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000313 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000314 (radius of gyration analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000314 "Radius of gyration analysis is a calculation that measures how compact or spread out a molecule is. As a type of structural analysis, this method quantifies the overall size and shape of a molecule or atomic selection by calculating the root-mean-square distance of its atoms from their common center of mass. Monitoring the radius of gyration over time is a standard procedure to track large-scale conformational changes, such as protein folding, unfolding, or domain movements."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000314 "radius of gyration analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000314 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000314 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000315 (ramachandran plot data)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000315 "A structural property consisting of the pair of backbone rotation angles for each residue in a protein. Plotted against each other across many residues, the pairs cluster into a few regions and leave most of the plot empty, because the remaining combinations put atoms on top of one another. A residue falling in an empty region is a sign that the structure is wrong there. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000315 "Rama plot"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000315 "ramachandran plot data"@en)
SubClassOf(obo:MOLSIM_000315 obo:MOLSIM_001333)

# Class: obo:MOLSIM_000316 (potential of mean force)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000316 "A potential of mean force is an energy profile that shows how much energy it takes to move a molecule from one place to another. As a type of free energy, the Potential of Mean Force (PMF) is an output_data_descriptor that represents the free energy of a system as a function of one or more specific geometric coordinates, known as reaction coordinates. The PMF describes the energetic landscape along a pathway, with its minima representing stable states and its maxima corresponding to transition state energy barriers. This is commonly referred to in analysis outputs and publications as \"PMF,\" \"free energy profile,\" \"Potential of Mean Force,\" or \"pmf.dat.\""@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000316 "PMF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000316 "potential of mean force"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000316 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000316 obo:MOLSIM_001314)

# Class: obo:MOLSIM_000317 (JSON format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000317 "JSON (JavaScript Object Notation) is a textual data interchange format with a simple syntax and low parsing cost. It is human-readable and it has a flexible structure. The JSON format is widely used and it is natively supported for parsing and serialization in most mainstream programming languages."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000317 "JSON format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000317 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000317 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000318 (YAML format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000318 "A text data format that records structured data using indentation to show nesting, with no brackets or closing tags. It is easy for a person to read and edit, which is why configuration and workflow files use it. Its reliance on indentation also means a misplaced space changes the meaning. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000318 "YAML format"@en)
SubClassOf(obo:MOLSIM_000318 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000319 (standard xyz format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000319 "A standardized, minimalistic text-based file format used to store the Cartesian coordinates of atoms. It typically consists of a header line (atom count), a comment line, and one line per atom containing the element symbol and X, Y, Z positions. It may contain multiple frames (i.e. trajectory). The XYZ file format is widely supported by many programs, although many slightly different XYZ file formats coexist (Tinker XYZ, UniChem XYZ, etc.)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000319 "standard xyz format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000319 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000319 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000320 (TOML format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000320 "A text data format for configuration files, built from key and value pairs grouped into named sections. Its rules are deliberately narrow, so a file has only one possible reading. That is its advantage over more flexible formats, where the same text can be interpreted more than one way. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000320 "TOML format"@en)
SubClassOf(obo:MOLSIM_000320 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000321 (pickle format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000321 "A binary data format that stores Python objects exactly as they exist in memory, so they can be written to a file and restored later. It preserves structures no general format can express. It can only be read back by Python, and reading one from an untrusted source can execute code, so it is unsuitable for exchange. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000321 "pickle format"@en)
SubClassOf(obo:MOLSIM_000321 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000322 (xvg format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000322 "A text-based data file format generated by GROMACS analysis tools, designed for plotting 1D or 2D graphs. It contains tabular numerical data alongside metadata and formatting commands intended to be read directly by the Grace (xmgrace) plotting program."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000322 "xvg format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000322 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000322 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000323 (element type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000323 "An atom type that classifies an atom based strictly on its atomic number (number of protons in its nucleus), defining its fundamental chemical element. In structure files, it is typically represented by its standard IUPAC one- or two-letter chemical symbol (e.g., C, O, Fe)."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000323 "atomic element"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000323 "element type"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000323 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000323 obo:MOLSIM_001763)
DisjointClasses(obo:MOLSIM_000323 obo:MOLSIM_001764)

# Class: obo:MOLSIM_000324 (force field atom type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000324 "An atom type assigned by a specific molecular mechanics force field that dictates the atom's non-bonded and bonded interaction parameters. It encodes not only the element, but also the atom's hybridization state, local chemical environment, and connectivity (e.g., distinguishing between an sp3 aliphatic carbon and an sp2 aromatic carbon). (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000324 "mechanics atom type"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000324 "force field atom type"@en)
SubClassOf(obo:MOLSIM_000324 obo:MOLSIM_001763)

# Class: obo:MOLSIM_000325 (monte carlo simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000325 "A stochastic simulation method that relies on repeated random sampling to explore the configurational space of a molecular system. Unlike molecular dynamics, which integrates equations of motion over time, Monte Carlo generates a sequence of states by proposing random trial moves (such as atom displacements or molecular rotations) and accepting or rejecting them based on a thermodynamic probability criterion, typically the Metropolis algorithm. It is widely used for calculating equilibrium thermodynamic properties and sampling conformational ensembles. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000325 "MC"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000325 "MC simulation"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000325 "monte carlo simulation"@en)
SubClassOf(obo:MOLSIM_000325 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000326 (endpoint free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000326 "An endpoint free energy method is a computational approach that estimates the free energy difference between two states by analyzing simulations performed only at the beginning and end points of a process. Unlike more rigorous alchemical methods, it does not simulate the intermediate transformation pathway. Methods like MM/PBSA and MM/GBSA are popular endpoint methods that combine molecular mechanics energies with continuum solvent models to estimate binding free energies from trajectories of the bound and unbound states. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000326 "endpoint free energy analysis"@en)
SubClassOf(obo:MOLSIM_000326 obo:MOLSIM_000265)

# Class: obo:MOLSIM_000327 (active site focusing analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000327 "Active site focusing is a strategy used in some endpoint free energy methods to improve the calculation by concentrating on the most important region of the system. This might involve performing the energy analysis only for residues within a certain distance of the binding site, or using a more detailed model for that region. For experts, this approach aims to reduce computational noise and focus the calculation on the energetic contributions that are most relevant to the binding event."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000327 "active site focusing analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000327 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000327 obo:MOLSIM_000262)

# Class: obo:MOLSIM_000328 (system setup modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000328 "A system setup method is a procedure used to prepare a molecular system for a simulation. This involves all the steps required to build a complete and chemically correct model, such as adding solvent molecules, placing ions, and ensuring the correct atom ordering. For experts, these methods are critical for creating a valid starting point that accurately reflects the intended experimental conditions of the simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000328 "system setup modeling"@en)
SubClassOf(obo:MOLSIM_000328 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000329 (ion placement analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000329 "An ion placement method is a specific procedure used during system setup to add ions, such as sodium or chloride, to the simulation box. The primary purpose is usually to neutralize the total charge of the system and to mimic a specific salt concentration."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000329 "ion placement analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000329 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000329 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000330 (ion concentration calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000330 "An ion concentration calculation method is the procedure used to determine the exact number of positive and negative ions that need to be added to a simulation box to achieve a target salt concentration. This calculation must account for the volume of the box and the number of counter-ions already added to neutralize the solute molecule. For experts, accurately performing this calculation is a mandatory step for preparing a system that correctly models the desired ionic strength. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000330 "ion concentration calculation analysis"@en)
SubClassOf(obo:MOLSIM_000330 obo:MOLSIM_000329)

# Class: obo:MOLSIM_000331 (force field component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000331 "One of the individual terms a force field's energy is built from, such as the bond, angle, rotation, van der Waals or electrostatic term. Each covers a distinct kind of interaction and their sum is the total energy. They are fitted together, which is why terms from different force fields cannot be mixed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000331 "force field component"@en)
SubClassOf(obo:MOLSIM_000331 obo:MOLSIM_000006)

# Class: obo:MOLSIM_000332 (SCF convergence algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000332 "An optimization algorithm that drives the iterative solution for a molecule's electrons towards a stable answer. Simple repetition often oscillates between 2 near-solutions instead of settling, particularly for metals and open-shell systems. These algorithms extrapolate from previous iterations to break that oscillation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000332 "SCF convergence algorithm"@en)
SubClassOf(obo:MOLSIM_000332 obo:MOLSIM_000407)

# Class: obo:MOLSIM_000333 (level shifting algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000333 "A technique that helps a self-consistent field calculation converge by artificially raising the energy of the unoccupied orbitals. Widening the gap between occupied and unoccupied orbitals stops electrons moving between them from one iteration to the next, which is what causes oscillation. The shift is reduced to zero before the final answer is taken. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000333 "level shifting algorithm"@en)
SubClassOf(obo:MOLSIM_000333 obo:MOLSIM_000332)

# Class: obo:MOLSIM_000334 (fit color Tversky)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000334 "A similarity measure that specifically compares the chemical features and atom types between molecules, focusing on their functional groups and chemical properties rather than their shape. This measure evaluates the similarity of atomic properties and chemical functionalities between molecules, making it valuable for identifying compounds with similar chemical behavior. It complements shape-based similarity measures in molecular comparison workflows. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000334 "fit color Tversky"@en)
SubClassOf(obo:MOLSIM_000334 obo:MOLSIM_000076)

# Class: obo:MOLSIM_000335 (restrained subset dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000335 "Restrained subset dynamics is a simulation method where restraining potentials are applied to only a specific part, or subset, of the molecular system. This allows the selected atoms to be held fixed or guided, while the rest of the system is free to move and respond dynamically."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000335 "restrained subset dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000335 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000335 obo:MOLSIM_000364)

# Class: obo:MOLSIM_000336 (multiscale simulation method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000336 "A simulation method that combines 2 or more levels of description within one system, such as quantum mechanics for a reacting group and a force field for everything else. The expensive description is applied only where it is needed. The difficulty is always the boundary, where the 2 descriptions must be joined without introducing artefacts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000336 "multiscale simulation method"@en)
SubClassOf(obo:MOLSIM_000336 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000337 (Mulliken charge analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000337 "A method that assigns charge to atoms by dividing each basis function's electron population between the atoms its functions are centred on, splitting shared contributions equally. It is the cheapest such method and requires no fitting. Its values depend strongly on the basis set used, so they are unreliable for anything beyond a rough comparison. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000337 "Mulliken charge analysis"@en)
SubClassOf(obo:MOLSIM_000337 obo:MOLSIM_000674)

# Class: obo:MOLSIM_000338 (isotropic position scaling barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000338 "A pressure control algorithm that holds pressure steady by scaling all 3 box dimensions by the same factor, so the box changes size but not shape. It suits a system with no preferred direction, such as a protein in water. It is the wrong choice for a membrane, where the plane of the bilayer and the direction across it behave differently. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000338 "isotropic position scaling barostat"@en)
SubClassOf(obo:MOLSIM_000338 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000339 (numerical integration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000339 "A numerical method that advances a differential equation forward in small steps, because no exact solution can be written down. The equations of motion for more than 2 interacting particles are of that kind, so every molecular dynamics simulation is doing this. The size of the step controls both the accuracy and the cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000339 "numerical integration"@en)
SubClassOf(obo:MOLSIM_000339 obo:MOLSIM_000340)

# Class: obo:MOLSIM_000340 (integration analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000340 "A class of mathematical techniques specifically used in molecular dynamics simulations to numerically solve the equations of motion governing particle movement. These algorithms approximate the positions and velocities of atoms at future discrete time steps based on the forces acting upon them at the current step. They are fundamental for generating the trajectory of the molecular system over time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000340 "integration analysis"@en)
SubClassOf(obo:MOLSIM_000340 obo:MOLSIM_000383)

# Class: obo:MOLSIM_000341 (auto-correlation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000341 "Auto-correlation analysis examines the correlation of a time series (a sequence of data points ordered in time, e.g., from a simulation) with lagged versions of itself. It helps identify repeating patterns, seasonality, or the characteristic timescale (memory) over which values in the series are statistically dependent. The primary output is the Auto-Correlation Function (ACF)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000341 "auto-correlation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000341 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000341 obo:MOLSIM_000342)

# Class: obo:MOLSIM_000342 (correlation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000342 "A dynamics analysis method that measures the statistical relationship between fluctuating quantities recorded during a simulation. It covers both how a single property relates to itself after a delay and how 2 different properties vary together or in opposition. The results reveal which motions are linked and over what timescales. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000342 "correlation analysis"@en)
SubClassOf(obo:MOLSIM_000342 obo:MOLSIM_000400)
SubClassOf(obo:MOLSIM_000342 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000343 (anisotropic position scaling barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000343 "An anisotropic position scaling barostat is a pressure control algorithm that allows the lengths of the three simulation box vectors to fluctuate independently to maintain a constant pressure tensor. This allows the shape of the simulation box to change, which is necessary for simulating systems that are not uniform in all directions, such as lipid membranes or solid crystals."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000343 "anisotropic position scaling barostat"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000343 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000343 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000344 (Welch's T-test analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000344 "A statistical test that judges whether 2 groups have different averages, without assuming they scatter by the same amount. The older form of the test assumes equal scatter, which independent simulations rarely have. It is the form to use when comparing runs of different lengths or from different conditions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000344 "Welch's T-test analysis"@en)
SubClassOf(obo:MOLSIM_000344 obo:MOLSIM_000124)

# Class: obo:MOLSIM_000345 (auto-correlation coefficients analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000345 "Auto-correlation coefficients are the numerical values that make up the Auto-Correlation Function (ACF) at different time points (τ). Each coefficient measures the linear correlation between the time series and the same series shifted by τ time steps."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000345 "auto-correlation coefficients analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000345 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000345 obo:MOLSIM_000341)

# Class: obo:MOLSIM_000346 (partial auto-correlation coefficients analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000346 "A statistical method that measures how strongly a series relates to itself a given number of steps back, after removing everything explained by the steps in between. Plain autocorrelation cannot distinguish a real long-range relationship from one carried indirectly through the intervening points. Removing the intermediate effect is what this adds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000346 "partial auto-correlation coefficients analysis"@en)
SubClassOf(obo:MOLSIM_000346 obo:MOLSIM_000345)

# Class: obo:MOLSIM_000347 (regression analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000347 "A statistical method that fits a relationship between an outcome and one or more explanatory quantities. It gives both the shape of the relationship and how much of the variation it accounts for. It is how a simulated quantity is checked against a measured one across a set of systems rather than one at a time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000347 "regression analysis"@en)
SubClassOf(obo:MOLSIM_000347 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000348 (hypothesis testing analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000348 "A statistical method that judges whether an observed difference is larger than would be expected from sampling alone. It computes how likely the observed result would be if there were no real difference, and that likelihood is compared against a chosen threshold. It answers whether a difference is real, not whether it is large enough to matter. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000348 "hypothesis testing analysis"@en)
SubClassOf(obo:MOLSIM_000348 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000349 (resampling method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000349 "A statistical method that estimates how uncertain a result is by repeatedly drawing new samples from the data already collected and recomputing the result from each. It replaces an assumption about how the data are distributed with computation. That makes it usable where no standard formula applies, which is most of simulation output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000349 "resampling method"@en)
SubClassOf(obo:MOLSIM_000349 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000350 (small angle x-ray scattering)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000350 "An experimental technique that measures the X-rays scattered at small angles by a sample in solution, and from that pattern infers the overall size and shape of the molecules in it. Because it works in solution it reports on the ensemble actually present, not on 1 crystallised conformation. It gives low-resolution shape rather than atomic positions. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000350 "SAXS"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000350 "small angle x-ray scattering"@en)
SubClassOf(obo:MOLSIM_000350 obo:MOLSIM_000990)

# Class: obo:MOLSIM_000351 (obsolete similarity and divergence analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000351 "OBSOLETE. Similarity and divergence measures are mathematical quantities used to compare two probability distributions, datasets, or sequences, quantifying how similar or different they are. Similarity measures indicate closeness (higher values mean more similar), while divergence measures quantify the difference or 'distance' between them (higher values mean more different). These are used in various fields including information theory, statistics, and bioinformatics (e.g., comparing conformational ensembles)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000351 "obsolete similarity and divergence analysis"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000351 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000351 "Retired 2026-08-13. It held a single child, MOLSIM:000118 Jensen-Shannon divergence analysis, which now sits directly under MOLSIM:000400 statistical analysis beside correlation analysis and hypothesis testing analysis. Three faults made it worth removing rather than renaming: the label joined two ideas with and, which reviewers raised as a pattern in August 2026; it grouped one term, so it explained nothing; and its definition described similarity and divergence measures, meaning quantities, while the class was labelled an analysis and parented under statistical analysis. The same shape as MOLSIM:000918 global structure analysis, retired on 2026-08-08.")

# Class: obo:MOLSIM_000352 (binpos format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000352 "The binpos (\"binary position\") format is binary file format from Amber that stores atomic coordinate frames (i.e. a trajectory) from a molecular dynamics simulation."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000352 ".binpos")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000352 "Scripps Research Institute BinPos"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000352 "Scripps binpos format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000352 "binpos format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000352 orcid:0000-0002-2294-5393)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_000352 "The Scripps Research Institute is named upstream as the originator of the format. Recorded here rather than in the definition, which was verified on 2026-09-18 without it. Source: EDAM 1.25, class format_3885 BinPos (http://edamontology.org/format_3885)."@en)
SubClassOf(obo:MOLSIM_000352 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000353 (validation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000353 "A method used to check whether the results or models generated by biomolecular simulations are accurate, physically realistic, and reliable. These techniques assess the quality of simulation outputs by comparing them against known experimental data or established theoretical principles. Their goal is to ensure the simulation provides a meaningful representation of the molecular system being studied. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000353 "validation analysis"@en)
SubClassOf(obo:MOLSIM_000353 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000354 (p-value)

AnnotationAssertion(owl:deprecated obo:MOLSIM_000354 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000354 "OBSOLETE. A type of statistical property that represents the probability of obtaining results at least as extreme as the observed results, assuming that the null hypothesis is true. A small p-value (typically < 0.05) is used to argue that the observed result is statistically significant. It is a fundamental concept in hypothesis testing. This is a standard output of statistical tests."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000354 obo:STATO_0000700)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000354 "Obsoleted 2026-07-29: duplicated STATO:0000700. STATO is the canonical OBO home for statistics; reused in place of this term."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000354 "obsolete p-value"@en)

# Class: obo:MOLSIM_000355 (thermodynamic integration analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000355 "A free energy analysis method that computes the free energy difference between 2 states by simulating a series of intermediate states along a coupling parameter and integrating the average derivative of the energy with respect to that parameter. The path between the states does not have to be physically realisable, only reversible. The formula belongs in an editor note rather than in the definition, where mathematical notation does not render. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000355 "TI"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000355 "thermodynamic integration analysis"@en)
SubClassOf(obo:MOLSIM_000355 obo:MOLSIM_000265)

# Class: obo:MOLSIM_000356 (thermodynamic integration without linear extrapolation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000356 "A thermodynamic integration approach in which the integrand is sampled at intermediate values of the coupling parameter rather than only at the end points, so the integral is computed from the sampled curve. Sampling the middle costs a simulation at each intermediate state and removes the assumption that the curve is a straight line. It is the arrangement nearly all thermodynamic integration uses. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000356 "thermodynamic integration without linear extrapolation"@en)
SubClassOf(obo:MOLSIM_000356 obo:MOLSIM_000298)

# Class: obo:MOLSIM_000357 (visualization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000357 "A visualization method is a technique used to create a graphical representation of molecular data, allowing scientists to see and interact with their results. This includes generating 3D images of molecules, animating simulation trajectories, or plotting data in the form of 2D graphs. For researchers, visualization is an indispensable method for understanding complex structural information and communicating findings. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000357 "visualization analysis"@en)
SubClassOf(obo:MOLSIM_000357 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000358 (worm plot visualization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000358 "A worm plot is a visualization method that displays a collection of superimposed molecular structures from a simulation or an NMR ensemble. Each structure is typically represented as a smooth tube or \"worm\" tracing the path of the protein backbone. This method provides a clear visual impression of the conformational variability and dynamic fluctuations within the molecular ensemble. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000358 "worm plot visualization analysis"@en)
SubClassOf(obo:MOLSIM_000358 obo:MOLSIM_000357)

# Class: obo:MOLSIM_000359 (helical density map visualization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000359 "A helical density map is a visualization method used to represent the three-dimensional distribution of atoms within a helical structure, averaged over time from a simulation. It creates a 3D grid where the value at each point represents the probability of finding an atom, which can then be displayed as a contoured surface. This method is particularly useful for analyzing the average structure and packing of molecules like DNA or alpha-helical proteins. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000359 "helical density map visualization analysis"@en)
SubClassOf(obo:MOLSIM_000359 obo:MOLSIM_000357)

# Class: obo:MOLSIM_000360 (Laplacian mapping ion placement analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000360 "A computational method for placing ions, like sodium or chloride, into a simulation box containing a charged molecule like a protein. It works by calculating the electrostatic potential around the molecule and then using a mathematical operator, the Laplacian, to identify the most electrostatically favorable positions for the ions to be placed. This approach is more physically realistic than simply placing ions randomly, as it positions them in regions where they are most likely to be found, such as near oppositely charged amino acid residues."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000360 "Laplacian mapping ion placement analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000360 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000360 obo:MOLSIM_000329)

# Class: obo:MOLSIM_000361 (adaptively biased molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000361 "An enhanced sampling simulation technique that enhances traditional biased molecular dynamics to calculate binding affinities, mechanical unfolding pathways, and free energy profiles (e.g., Potential of Mean Force) in biomolecules. It applies an evolving, position-dependent energy bias to help the system escape local minima along a specific reaction coordinate."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000361 "adaptively biased molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000361 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000361 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000362 (driven adaptively biased molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000362 "Driven adaptively biased molecular dynamics (d-ABMD) is an enhanced sampling technique that combines two approaches to explore a specific molecular process. It uses an adaptive biasing potential, like in metadynamics, to overcome energy barriers, while simultaneously applying an external \"driving\" force to guide the system along a predefined reaction coordinate. This dual approach is particularly effective for efficiently calculating the free energy profile of a complex conformational change that is too slow to occur spontaneously."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000362 "driven adaptively biased molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000362 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000362 obo:MOLSIM_000361)

# Class: obo:MOLSIM_000363 (redox potential replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000363 "Redox potential replica-exchange molecular dynamics is a specialized version of the REMD method where the different parallel simulations are run at different electrochemical redox potentials, rather than different temperatures. This allows the system to efficiently sample different oxidation states in a simulation that is coupled to an electron bath."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000363 "redox potential REMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000363 "redox potential replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000363 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000363 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000364 (restrained simulation method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000364 "A restrained simulation is a type of simulation where an additional, artificial energy potential is applied to guide the system's motion. These restraints can be used to force a molecule to adopt a certain conformation, to prevent it from moving too far, or to incorporate experimental data into the simulation. Restraints are a powerful tool for targeted sampling, structure refinement, and calculating potentials of mean force."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000364 "restrained simulation method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000364 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000364 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000365 (electron microscopy map restraint method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000365 "An electron microscopy map restraint method is a simulation technique where the simulation is guided by a three-dimensional density map obtained from an electron microscopy experiment. An additional energy term is added that penalizes conformations where the simulated atoms do not fit well into the experimental density. For structural biologists, this method is a powerful tool for refining low-resolution experimental structures into high-resolution, physically realistic atomic models."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000365 "electron microscopy map restraint method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000365 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000365 obo:MOLSIM_000364)

# Class: obo:MOLSIM_000366 (finite-difference analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000366 "A numerical method that solves a differential equation by replacing each derivative with the difference between values at nearby grid points. The continuous problem becomes a large set of simultaneous equations, one per grid point. It is how the Poisson-Boltzmann equation is solved for a molecular shape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000366 "finite-difference analysis"@en)
SubClassOf(obo:MOLSIM_000366 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000367 (numerical analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000367 "A branch of mathematics concerned with computing approximate answers to problems that cannot be solved exactly. Almost every step of a simulation rests on it, because the equations of motion and the integrals of statistical mechanics have no closed-form solutions for a real molecule. Its central concern is how large the approximation error is and whether it accumulates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000367 "numerical analysis"@en)
SubClassOf(obo:MOLSIM_000367 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000368 (immersed interface analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000368 "A numerical method for solving a differential equation across a boundary where the solution or its derivative jumps, such as the surface between a solute and continuum solvent. It modifies the finite-difference stencil near the boundary to take the known jump conditions into account, instead of smoothing over them. In this field it is used to solve the Poisson-Boltzmann equation accurately at the molecular surface. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000368 "immersed interface analysis"@en)
SubClassOf(obo:MOLSIM_000368 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000369 (low-mode conformational search)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000369 "An enhanced sampling method that generates new conformations by displacing a structure along its slowest collective modes rather than at random. Those modes are the directions in which the molecule moves most easily, so displacing along them reaches genuinely different conformations at low energy cost. Random displacement mostly produces strained structures that are immediately rejected. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000369 "low-mode conformational search"@en)
SubClassOf(obo:MOLSIM_000369 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000370 (constant pH replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000370 "A simulation method that runs several constant pH simulations in parallel, each at a different pH or temperature, and periodically swaps configurations between them. The swaps let a configuration stuck in one protonation state escape by way of conditions where that state is unfavourable. It converges protonation populations far faster than a single constant pH run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000370 "constant pH replica-exchange molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000370 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000371 (NMR analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000371 "NMR analysis in a simulation context refers to the methods used to calculate NMR-related properties from a molecular dynamics trajectory. This allows for a direct comparison between the simulation results and experimental data from Nuclear Magnetic Resonance (NMR) spectroscopy. This includes calculating observables like J-couplings, nuclear Overhauser effects (NOEs), and relaxation times, which are crucial for validating the accuracy of the simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000371 "NMR analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000371 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000371 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000372 (r-6 weighted distance averaging analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000372 "The r-6 weighted distance averaging is a specific calculation method used in NMR analysis to compute an effective distance from a simulation trajectory that can be directly compared to an experimental nuclear Overhauser effect (NOE). Because the NOE intensity is proportional to the inverse sixth power of the distance between two protons, a simple average of the distance is incorrect. For experts, performing this <r⁻⁶>⁻¹/⁶ averaging is the physically correct way to back-calculate NOE-derived distances from a dynamic ensemble of structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000372 "r-6 weighted distance averaging analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000372 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000372 obo:MOLSIM_000371)

# Class: obo:MOLSIM_000373 (replica-exchange self-guided Langevin dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000373 "This is an enhanced sampling method that combines the replica-exchange method with self-guided Langevin dynamics (SGLD). It runs multiple SGLD simulations in parallel, typically at different temperatures, and attempts to swap their coordinates. This combination aims to leverage the accelerated local exploration of SGLD with the global barrier-crossing capability of replica-exchange for very efficient conformational sampling."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000373 "replica-exchange self-guided Langevin dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000373 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000373 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000374 (force field parameterization modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000374 "A force field parameterization method is the systematic procedure used to derive the numerical values, or parameters, for a force field. This process involves fitting the parameters of the force field's energy functions to reproduce high-quality data, which can come from quantum mechanical calculations or experimental measurements. For experts, the parameterization method is the core of force field development and determines the accuracy and domain of applicability of the resulting model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000374 "force field parameterization modeling"@en)
SubClassOf(obo:MOLSIM_000374 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000375 (Seminario method modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000375 "A parameterization method that derives bond and angle force constants from the matrix of second derivatives of the energy computed quantum mechanically. It projects that matrix onto each bond and angle direction in turn, which separates contributions that a simple fit would confuse. It is the standard way parameters are obtained for a molecule no existing force field covers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000375 "Seminario method modeling"@en)
SubClassOf(obo:MOLSIM_000375 obo:MOLSIM_000374)

# Class: obo:MOLSIM_000376 (temperature replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000376 "Temperature replica-exchange molecular dynamics is the standard and most common form of the REMD method. It involves running multiple parallel simulations at a range of different temperatures and attempting to swap their coordinates. This is a robust and widely used method for enhancing the sampling of systems with complex energy landscapes, such as in protein folding simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000376 "temperature replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000376 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000376 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000377 (well-tempered adaptively biased molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000377 "Well-Tempered Adaptively Biased Molecular Dynamics (WT-ABMD) is an enhanced sampling technique in computational chemistry. It merges the features of adaptively biased molecular dynamics (ABMD) and well-tempered metadynamics to calculate the free energy surface of complex molecular systems while avoiding over-exploration of high-energy states."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000377 "well-tempered adaptively biased molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000377 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000377 obo:MOLSIM_000361)

# Class: obo:MOLSIM_000378 (Z-matrix parameterization modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000378 "A parameterization method in which the molecule's geometry is expressed in internal coordinates, as bond lengths, angles and rotations, and parameters are fitted in those terms. Fitting in internal coordinates makes each parameter correspond to one geometric feature. It is more laborious than fitting in Cartesian coordinates and gives parameters that are easier to interpret and transfer. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000378 "Z-matrix parameterization modeling"@en)
SubClassOf(obo:MOLSIM_000378 obo:MOLSIM_000374)

# Class: obo:MOLSIM_000379 (ZLM density fitting)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000379 "A density fitting method that expands the electron density in spherical harmonic functions centred on each atom, so that electron repulsion integrals can be computed more cheaply. Fitting the density rather than computing every integral exactly is what makes large density functional calculations affordable. The error it introduces is small and controllable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000379 "ZLM density fitting"@en)
SubClassOf(obo:MOLSIM_000379 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000380 (force interpolation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000380 "A force interpolation method is a numerical technique used in some simulation algorithms to estimate the forces on atoms without calculating them directly at every step. This is often done by calculating the forces on a coarser grid and then interpolating these forces to the actual atomic positions. For experts, this method can be used in some multiple-time-stepping algorithms to reduce the computational cost of the force calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000380 "force interpolation analysis"@en)
SubClassOf(obo:MOLSIM_000380 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000381 (adaptive thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000381 "A temperature control algorithm that changes its own coupling strength as the simulation proceeds. Strong coupling is wanted while a system is still far from its target and unwanted once it has settled, and a fixed setting cannot do both. It adjusts so that the early phase is fast and the later dynamics are left alone. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000381 "adaptive thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000381 "ntt=6")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000381 "ntt=7")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_000381 "ntt=8")
SubClassOf(obo:MOLSIM_000381 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000382 (simulation control algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000382 "An algorithm that governs how a simulation advances and how its physical conditions are held steady. It covers the integrator that moves the atoms forward in time, and the thermostats and barostats that keep temperature and pressure at their targets. These are the algorithms that determine what ensemble a simulation actually samples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000382 "simulation control algorithm"@en)
SubClassOf(obo:MOLSIM_000382 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000383 (mathematical analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000383 "The use of defined mathematical procedures to process data and extract quantities from it. It covers fitting, transforming, integrating and differentiating the output of a simulation. It is distinguished from the domain-specific analyses by making no assumption about what the numbers represent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000383 "mathematical analysis"@en)
SubClassOf(obo:MOLSIM_000383 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000384 (force calculation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000384 "An algorithm that computes the force on every atom at each step, from the positions of the atoms and the force field. It dominates the cost of a simulation, because the non-bonded part must consider a great many pairs. Almost every optimisation in a simulation engine is aimed at this step. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000384 "force calculation algorithm"@en)
SubClassOf(obo:MOLSIM_000384 obo:MOLSIM_000382)

# Class: obo:MOLSIM_000385 (Mulliken Ewald summation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000385 "An Ewald summation method in which the charge distribution is represented by charges assigned to atoms by Mulliken population analysis rather than by fixed force field charges. It allows a quantum mechanical charge distribution to be handled by the standard periodic electrostatics machinery. The accuracy is limited by how well atom-centred charges can stand in for the real distribution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000385 "Mulliken Ewald summation"@en)
SubClassOf(obo:MOLSIM_000385 obo:MOLSIM_000428)

# Class: obo:MOLSIM_000386 (QM-QM derivative calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000386 "A numerical method for computing energy derivatives in a calculation with more than one quantum layer, such as a high-accuracy method inside a cheaper one. The derivatives of each layer must be combined so that the force on a shared atom is consistent. Getting the combination wrong produces forces that do not match the energy, and a simulation that drifts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000386 "QM-QM derivative calculation analysis"@en)
SubClassOf(obo:MOLSIM_000386 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000387 (QM Ewald treatment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000387 "An application of Ewald summation to a system whose charge distribution comes from a quantum mechanical calculation rather than from fixed charges. It is needed because a quantum region in a periodic box interacts with its own images, which must be accounted for rather than ignored. The difficulty is that the charge distribution changes as the calculation proceeds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000387 "QM Ewald treatment"@en)
SubClassOf(obo:MOLSIM_000387 obo:MOLSIM_000428)

# Class: obo:MOLSIM_000388 (QM/MM simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000388 "A multiscale simulation in which a small chemically active region is described by quantum mechanics and the rest by a force field. It is what allows a reaction inside an enzyme to be modelled, since a force field cannot break bonds and a quantum treatment of the whole protein is impossible. The difficulty is always the boundary, where the 2 descriptions must be joined without artefacts. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000388 "QM/MM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000388 "QM/MM simulation"@en)
SubClassOf(obo:MOLSIM_000388 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000389 (hot spot adaptive QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000389 "A QM/MM method in which the quantum region follows the chemistry, expanding to include whatever is currently involved in the reaction. It differs from a solvent-adaptive scheme in that the region moves with the reactive event rather than merely exchanging solvent. It suits a reaction whose site shifts along a chain or across a surface. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000389 "hot spot adaptive QM/MM"@en)
SubClassOf(obo:MOLSIM_000389 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000390 (isotropic periodic sum method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000390 "A general term for a method that calculates the long-range forces in a simulation with periodic boundary conditions, assuming the system is uniform in all directions. It involves summing up the interactions between a particle and all of its periodic images in a way that correctly accounts for the infinite, repeating nature of the simulated system. Standard algorithms like the Ewald sum or Particle Mesh Ewald (PME) are specific implementations of this principle, which is essential for accurately modeling the electrostatics of a bulk liquid. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000390 "isotropic periodic sum method"@en)
SubClassOf(obo:MOLSIM_000390 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000391 (semi-isotropic position scaling barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000391 "A semi-isotropic position scaling barostat is a pressure control algorithm that couples the scaling of the x and y dimensions of the simulation box together, while allowing the z dimension to fluctuate independently. This method is specifically designed for simulating planar systems like lipid bilayers, where the pressure in the plane of the membrane is different from the pressure perpendicular to it."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000391 "semi-isotropic pressure scaling barostat"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000391 "semi-isotropic position scaling barostat"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000391 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000391 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000392 (direct sum Coulomb method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000392 "An electrostatic method that computes the force between every pair of charged atoms explicitly and adds them all up. It is exact for a system with no periodic images, and its cost grows with the square of the number of atoms. That growth is why it is used only for small or non-periodic systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000392 "direct sum Coulomb method"@en)
SubClassOf(obo:MOLSIM_000392 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000393 (self-guided Langevin dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000393 "Self-guided Langevin dynamics (SGLD) is an enhanced sampling method that accelerates conformational searching by adding a memory-dependent guiding force to the standard equations of motion. This guiding force is calculated from a local average of the forces the system has recently experienced, effectively pushing the system to explore new regions faster. SGLD enhances sampling by reducing random fluctuations and promoting more directed exploration of the potential energy surface."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000393 "self-guided Langevin dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000393 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000393 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000394 (generalized Langevin equation self-guided Langevin dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000394 "A simulation method that adds a guiding force built from a running average of the system's recent motion, so that slow collective movements are amplified while fast local ones are not. Amplifying the slow motions lets a simulation cross barriers it would otherwise take far longer to reach. Results must be corrected afterwards to recover the unbiased distribution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000394 "generalized Langevin equation self-guided Langevin dynamics"@en)
SubClassOf(obo:MOLSIM_000394 obo:MOLSIM_000393)

# Class: obo:MOLSIM_000395 (accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000395 "Accelerated molecular dynamics is a special type of simulation whose scope is to overcome the timescale limitations of classical molecular dynamics. It works by adding a \"boost\" to the system's energy, effectively lowering the energy barriers that separate different molecular conformations. For experts, aMD is an enhanced sampling method that adds a non-negative, history-independent bias potential when the system's potential energy is below a certain threshold, allowing for the recovery of canonical averages through energetic reweighting."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000395 "aMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000395 "accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000395 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000395 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000396 (Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000396 "Gaussian accelerated molecular dynamics (GaMD) is an enhanced sampling method that speeds up simulations by adding a boost potential that has a Gaussian distribution. This method smooths the potential energy surface, allowing the system to more easily escape from local energy minima."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000396 "GaMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000396 "Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000396 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000396 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000397 (ligand Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000397 "Ligand Gaussian accelerated molecular dynamics is a specific application of the GaMD method focused on enhancing the sampling of a ligand's movement and conformational changes. The boost potential is applied in a way that specifically accelerates the dynamics of the ligand, its binding site, or both."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000397 "ligand Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000397 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000397 obo:MOLSIM_000396)

# Class: obo:MOLSIM_000398 (dual-boost ligand Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000398 "Dual-boost ligand Gaussian accelerated molecular dynamics (Dual-boost LiGaMD) is a variant of the GaMD method where two separate boost potentials are applied simultaneously to enhance the sampling of ligand binding and unbinding pathways. For example, one boost is applied to the dihedral angles of the ligand to enhance its conformational sampling, while a second boost is applied to the total potential energy of the system to accelerate its overall dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000398 "dual-boost ligand Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000398 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000398 obo:MOLSIM_000397)

# Class: obo:MOLSIM_000399 (peptide Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000399 "Peptide Gaussian accelerated molecular dynamics is a specific application of the GaMD method tailored to enhance the conformational sampling of peptides. The boost potential is applied to accelerate the slow folding and conformational transition events that are characteristic of flexible peptide molecules."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000399 "peptide Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000399 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000399 obo:MOLSIM_000396)

# Class: obo:MOLSIM_000400 (statistical analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000400 "A method that uses probability theory to collect, summarise and draw conclusions from data. It is what puts an uncertainty on a value and what decides whether a difference between 2 results is real. Simulation output is a sample, so nothing taken from it is complete without one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000400 "statistical analysis"@en)
SubClassOf(obo:MOLSIM_000400 obo:MOLSIM_000367)

# Class: obo:MOLSIM_000401 (dual-boost peptide Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000401 "Dual-boost peptide Gaussian accelerated molecular dynamics (Dual-boost PepGaMD) is a variant of GaMD where two separate boost potentials are applied simultaneously to enhance the sampling of peptides. One boost is typically applied to the peptide's dihedral angles to accelerate local conformational changes, while the second is applied to the total system potential to overcome larger energy barriers."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000401 "dual-boost peptide Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000401 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000401 obo:MOLSIM_000399)

# Class: obo:MOLSIM_000402 (ligand Gaussian accelerated molecular dynamics 3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000402 "Ligand Gaussian accelerated molecular dynamics 3 (GaMD3) is a recent and refined version of an enhanced sampling method used to accelerate the simulation of ligand binding and unbinding events. It applies a smoothly varying boost potential to the system's energy landscape, allowing the ligand to escape from deep binding pockets and explore different conformations more rapidly. This third-generation implementation includes improved algorithms for updating the boost potential, aiming for more robust and efficient sampling of complex ligand dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000402 "ligand Gaussian accelerated molecular dynamics 3"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000402 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000402 obo:MOLSIM_000397)

# Class: obo:MOLSIM_000403 (protein-protein interaction Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000403 "This is an application of the GaMD method specifically designed to enhance the sampling of protein-protein binding and unbinding events. The boost potential is applied to the potential energy of the entire complex to accelerate the slow association and dissociation processes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000403 "protein-protein interaction Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000403 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000403 obo:MOLSIM_000396)

# Class: obo:MOLSIM_000404 (dual-boost protein-protein interaction Gaussian accelerated molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000404 "Dual-boost protein-protein interaction Gaussian accelerated molecular dynamics (Dual-boost PPI-GaMD) is a variant of GaMD where two separate boost potentials are applied simultaneously to enhance the sampling of protein-protein interfaces. One boost is typically applied to the protein protein interface to accelerate local conformational changes, while the second is applied to the total system potential to overcome larger energy barriers."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000404 "dual-boost protein-protein interaction Gaussian accelerated molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000404 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000404 obo:MOLSIM_000403)

# Class: obo:MOLSIM_000405 (multiply-targeted molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000405 "Multiply-targeted molecular dynamics is an enhanced sampling technique that biases a simulation to explore the conformational space between several known target structures simultaneously. Unlike standard targeted MD which pulls a molecule from one state to another, this method encourages the system to visit a collection of different functional states. This is useful for characterizing the pathways that connect multiple known conformations of a protein, such as its active and inactive forms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000405 "multiply-targeted molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000405 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000405 obo:MOLSIM_000862)

# Class: obo:MOLSIM_000406 (partial nudged elastic band)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000406 "A Partial Nudged Elastic Band (PNEB) is a computational method used to calculate the minimum energy path for structural transitions. Unlike traditional NEB, it applies the nudging algorithm only to a user-defined subset of atoms while allowing the remaining atoms to optimize freely. This reduces computational costs and supports complex environments like explicit solvents."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000406 "partial nudged elastic band"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000406 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000406 obo:MOLSIM_000856)

# Class: obo:MOLSIM_000407 (optimization algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000407 "An algorithm that searches for the input values giving the best score under some measure, usually the lowest or highest value of a function. In this field the function is almost always an energy and the inputs are atomic positions. The difficulty is that such a search finds the nearest good answer rather than the best one anywhere. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000407 "optimization algorithm"@en)
SubClassOf(obo:MOLSIM_000407 obo:MOLSIM_000037)

# Class: obo:MOLSIM_000408 (energy minimization algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000408 "An optimization algorithm that adjusts atomic positions to lower the energy of a structure until it reaches a nearby minimum. It moves downhill only, so it settles in the nearest low point rather than the lowest one. It is run on a freshly built system to remove overlaps that would otherwise make the first simulation steps explode. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000408 "energy minimization algorithm"@en)
SubClassOf(obo:MOLSIM_000408 obo:MOLSIM_000407)

# Class: obo:MOLSIM_000409 (XMIN minimization algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000409 "A family of minimization algorithms that build up an approximation to the curvature of the energy surface from the slopes seen at successive steps, rather than computing it directly. Reusing past steps this way gives most of the speed of a curvature-based method at the cost of a slope-based one. It is the minimizer AmberTools offers for large systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000409 "XMIN minimization algorithm"@en)
SubClassOf(obo:MOLSIM_000409 obo:MOLSIM_000408)

# Class: obo:MOLSIM_000410 (lambda-scheduling free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000410 "A lambda-scheduling free energy method is a technique where the alchemical transformation between two states is performed in a single, continuous simulation run. This is achieved by slowly and continuously changing the coupling parameter, lambda, according to a predefined schedule over the course of the simulation. For experts, this non-equilibrium approach can be computationally efficient, and the free energy can be estimated from the work performed during the transformation using fluctuation theorems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000410 "lambda-scheduling free energy analysis"@en)
SubClassOf(obo:MOLSIM_000410 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000411 (hybrid solvent replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000411 "Hybrid solvent replica-exchange molecular dynamics is a specialized version of the REMD method where the different parallel simulations use different solvent models. For example, some replicas might use an implicit solvent model, which allows for very fast sampling, while others use a more accurate explicit solvent model. Swapping between these replicas allows the simulation to combine the sampling efficiency of implicit solvent with the accuracy of explicit solvent."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000411 "hybrid solvent replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000411 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000411 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000412 (reservoir replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000412 "Reservoir replica-exchange molecular dynamics is an efficient variant of the REMD method for simulations with a very large number of replicas. Instead of attempting swaps between all adjacent pairs, it attempts swaps between a master simulation and a large \"reservoir\" of simulations running at different temperatures. This can significantly improve the efficiency of the exchange process when a very wide temperature range needs to be sampled."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000412 "reservoir replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000412 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000412 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000413 (replica-exchange umbrella sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000413 "Replica-exchange umbrella sampling is an enhanced sampling method that combines two powerful techniques to calculate free energy profiles. It runs multiple umbrella sampling simulations in parallel, each restraining the system to a different window along a reaction coordinate, and periodically attempts to swap the coordinates between these simulations. This combination helps to overcome slow conformational sampling within each umbrella window, leading to faster convergence of the potential of mean force."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000413 "replica-exchange umbrella sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000413 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000413 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000414 (replica-exchange with arbitrary degree of freedom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000414 "Replica-exchange with an arbitrary degree of freedom is a powerful generalization of the standard replica-exchange simulation method. Instead of running parallel simulations at different temperatures, this technique allows them to be run along any user-defined variable, such as a reaction coordinate, a force field parameter, or a pH value. By attempting to swap these variables between replicas, the method can dramatically enhance sampling and map out a system's response to a wide range of conditions in a single set of simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000414 "replica-exchange with arbitrary degree of freedom"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000414 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000414 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000415 (EMIL free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000415 "A free energy calculation analysis that computes an absolute free energy by thermodynamic integration from a realistic atomistic model to a simplified reference model whose free energy can be solved exactly. The Einstein Molecule model is used for the solute, in which each atom is held in place by a harmonic potential so that the reference free energy has a closed-form solution. EMIL is the name of the module that implements this in AMBER, and its authors call the underlying method Thermodynamic Integration relative to an Exact Solution. (UNVERIFIED)"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_000415 "Berryman J.T. and Schilling T. Free energies by thermodynamic integration relative to an exact solution, used to find the handedness-switching salt concentration for DNA. J. Chem. Theory Comput. 9(1):679-686, 2013.")
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_000415 "Berryman J.T. Absolute free energies for biomolecules in implicit or explicit solvent. Physics Procedia, 2014. States that the AMBER implementation of this method is called EMIL.")
AnnotationAssertion(rdfs:label obo:MOLSIM_000415 "EMIL free energy analysis"@en)
SubClassOf(obo:MOLSIM_000415 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000416 (constant pH molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000416 "A simulation method in which acidic and basic groups can gain or lose a proton during the run, rather than being fixed at the start. Their protonation is coupled to a chosen acidity, so the populations that result are those at that pH. It matters because a fixed assignment made before the simulation may be wrong, and a wrong charge changes everything downstream. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000416 "CpHMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000416 "constant pH molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000416 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000417 (continuous constant pH molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000417 "A constant pH method in which the degree of protonation of each titratable group is a continuous quantity that moves under its own equation of motion, rather than switching between protonated and deprotonated. Because it changes smoothly, no jump has to be accepted or rejected and the simulation never stops to attempt one. The cost is that intermediate values do not correspond to any real chemical state and must be kept away from. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000417 "continuous constant pH molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000417 obo:MOLSIM_000416)

# Class: obo:MOLSIM_000418 (lambda-dynamics free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000418 "Lambda-dynamics is a free energy calculation method where the coupling parameter, lambda, is treated as a dynamic variable that evolves in time, just like an atomic coordinate. A fictitious mass is assigned to lambda, and its \"motion\" along the transformation pathway is simulated, allowing it to sample different intermediate states."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000418 "lambda-dynamics free energy analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000418 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000418 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000419 (PME continuous constant pH molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000419 "A continuous constant pH method formulated to work with particle mesh Ewald electrostatics. The difficulty it solves is that changing a charge continuously changes the total charge of the system, which the Ewald treatment assumes is fixed. Without this reformulation, constant pH and the standard long-range electrostatics could not be used together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000419 "PME continuous constant pH molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000419 obo:MOLSIM_000417)

# Class: obo:MOLSIM_000420 (variational free energy profile analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000420 "A variational free energy profile method is a class of techniques for finding the minimum free energy path between two states. These methods work by optimizing a trial pathway to minimize a functional that represents the free energy, based on a variational principle. For experts, methods like the string method are a type of variational approach for identifying the most probable transition pathway and the associated free energy barrier. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000420 "variational free energy profile analysis"@en)
SubClassOf(obo:MOLSIM_000420 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000421 (weighted thermodynamic perturbation theory analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000421 "A free energy analysis method that improves on plain free energy perturbation by applying a weighting function to the sampled configurations. The weighting concentrates effort where the 2 states overlap least, which is where plain perturbation converges worst. It is used when the states are too dissimilar for the unweighted estimator to be reliable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000421 "weighted thermodynamic perturbation theory analysis"@en)
SubClassOf(obo:MOLSIM_000421 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000422 (generalized weighted thermodynamic perturbation theory)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000422 "A free energy analysis method that extends weighted thermodynamic perturbation theory to a broader family of weighting functions. The generalisation lets the weighting be chosen to suit the pair of states rather than taken from a fixed form. It targets the same problem, which is poor overlap between the states being compared. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000422 "generalized weighted thermodynamic perturbation theory"@en)
SubClassOf(obo:MOLSIM_000422 obo:MOLSIM_000421)

# Class: obo:MOLSIM_000423 (multidimensional replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000423 "Multidimensional replica-exchange molecular dynamics is an extension of the REMD method where exchanges are performed along more than one variable simultaneously. For example, parallel simulations could be run at different temperatures and different pH values, with swaps attempted in both the temperature and pH dimensions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000423 "multidimensional replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000423 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000423 obo:MOLSIM_000858)

# Class: obo:MOLSIM_000424 (transition state search algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000424 "An optimization algorithm that locates a first-order saddle point on a potential energy surface, where the energy is at a maximum along 1 direction and a minimum along all others. It differs from a minimiser in having to climb in a chosen direction rather than descend in every one. The saddle point it finds is the transition state that sets a reaction barrier. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000424 "transition state search algorithm"@en)
SubClassOf(obo:MOLSIM_000424 obo:MOLSIM_000407)

# Class: obo:MOLSIM_000425 (dimer method algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000425 "A transition state search algorithm that uses 2 closely spaced copies of a structure to find the direction in which the energy curves downwards most, then moves uphill along it to a saddle point. It needs only first derivatives of the energy, never the full matrix of second derivatives. That makes it usable on systems too large for methods that build the whole Hessian. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000425 "dimer method algorithm"@en)
SubClassOf(obo:MOLSIM_000425 obo:MOLSIM_000424)

# Class: obo:MOLSIM_000426 (grid inhomogeneous solvation theory analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000426 "A data analysis method that computes the local density, energy and entropy of water on a 3-dimensional grid around a solute, from a simulation with explicit solvent. It assigns thermodynamic quantities to positions rather than to the system as a whole. That is what allows individual hydration sites to be identified and their contribution to solvation free energy to be quantified. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000426 "grid inhomogeneous solvation theory analysis"@en)
SubClassOf(obo:MOLSIM_000426 obo:MOLSIM_000974)

# Class: obo:MOLSIM_000427 (3D-mapping analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000427 "An analysis method that builds a 3-dimensional map showing which regions around a molecule matter for its function, by computing a chosen property at each point of a grid. What the map shows depends on the property: where a probe binds favourably, where solvent is held, or where charge accumulates. It turns a per-point calculation into a picture that can be inspected. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000427 "3D-mapping analysis"@en)
SubClassOf(obo:MOLSIM_000427 obo:MOLSIM_000974)

# Class: obo:MOLSIM_000428 (Ewald summation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000428 "An electrostatic method that computes the total electrostatic energy of a periodically repeating system by splitting the calculation into a short-range part summed directly and a long-range part summed in reciprocal space. The split works because each part converges quickly where the other does not. Without it, the sum over periodic images does not converge at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000428 "Ewald summation"@en)
SubClassOf(obo:MOLSIM_000428 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000429 (Lennard-Jones particle mesh Ewald)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000429 "An algorithm that computes the long-range part of the van der Waals interaction using the same grid-based reciprocal space treatment that particle mesh Ewald applies to electrostatics. Van der Waals forces are usually just cut off at a distance, which introduces a small systematic error in density and surface tension. This removes that error at modest extra cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000429 "Lennard-Jones particle mesh Ewald"@en)
SubClassOf(obo:MOLSIM_000429 obo:MOLSIM_000053)

# Class: obo:MOLSIM_000430 (non-bonded potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000430 "The part of a force field describing interactions between atoms not joined by a bond, comprising the electrostatic term and the van der Waals term. Every atom in principle interacts with every other, so this part dominates the cost of a simulation. Nearly all the effort of making simulations fast goes into computing it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000430 "non-bonded potential"@en)
SubClassOf(obo:MOLSIM_000430 obo:MOLSIM_000331)

# Class: obo:MOLSIM_000431 (improper torsion potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000431 "The part of a force field that keeps 4 atoms flat, or preserves a centre's handedness, using a term with a single preferred value rather than a repeating one. The 4 atoms are not in a chain, which is what makes it improper. It exists because the other terms have no way to forbid a planar group from folding. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000431 "improper torsion potential"@en)
SubClassOf(obo:MOLSIM_000431 obo:MOLSIM_000331)

# Class: obo:MOLSIM_000432 (quantum mechanics basis set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000432 "A set of mathematical functions, often resembling atomic orbitals, used in quantum chemical calculations to represent the spatial distribution of electrons within a molecule (molecular orbitals). The choice and size of the basis set significantly impact the accuracy and computational cost of a simulation; larger, more flexible basis sets generally yield more accurate results but require more computer resources. These functions serve as the building blocks for constructing the calculated electronic wavefunction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000432 "quantum mechanics basis set"@en)
SubClassOf(obo:MOLSIM_000432 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000433 (Altona & Sundaralingam pucker analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000433 "A structural analysis method that describes the shape of a 5-membered ring, such as the ribose sugar of a nucleotide, using 2 numbers: the phase angle of pseudorotation and the puckering amplitude. The phase angle says which atoms lie out of the plane and in which direction, and the amplitude says by how much. Together they place a sugar in a named conformational family such as C2'-endo or C3'-endo. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000433 "Altona & Sundaralingam pucker analysis"@en)
SubClassOf(obo:MOLSIM_000433 obo:MOLSIM_000927)

# Class: obo:MOLSIM_000434 (Cremer & Pople pucker analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000434 "A structural analysis method that describes the shape of any non-planar ring using a set of numbers derived from how far each atom sits out of the ring's mean plane. It applies to rings of any size, where the older 2-parameter treatment covers 5-membered rings only. For a 6-membered ring it gives 3 numbers that place it on a sphere of possible shapes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000434 "Cremer & Pople pucker analysis"@en)
SubClassOf(obo:MOLSIM_000434 obo:MOLSIM_000927)

# Class: obo:MOLSIM_000435 (kernel modified molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000435 "A simulation method in which the forces are adjusted using a function borrowed from machine learning that measures how similar 2 configurations are. The adjustment pushes the system away from configurations it has already visited. That is what encourages it to explore rather than settle. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000435 "kernel modified molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000435 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000436 (data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000436 "A data format defines the specific rules and conventions used to structure, store, and exchange data, particularly within computer files. In biomolecular simulation, this refers to the various standardized ways that information like molecular structures, simulation parameters, or results are organized. Understanding these formats is essential for using simulation software and sharing data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000436 "data format"@en)

# Class: obo:MOLSIM_000437 (simulation input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000437 "A data format that provides the necessary data, settings, or instructions required to initiate a computational task. This format provides the instructional input for simulation or analysis software. It is distinct from formats that describe molecular structure or results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000437 "simulation input format"@en)
SubClassOf(obo:MOLSIM_000437 obo:MOLSIM_001085)

# Class: obo:MOLSIM_000438 (script format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000438 "A data format for a file containing a sequence of commands or code in a specific language. These scripts are designed to be executed by a program to automate a workflow or a series of analysis steps."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000438 "script format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000438 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000438 obo:MOLSIM_001085)

# Class: obo:MOLSIM_000439 (simulation log format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000439 "A simulation log format is a text-based file structure that records the progress and key information generated during a computer simulation or calculation. It typically includes a copy of the input settings, step-by-step updates on energy and temperature, performance timings, and any warnings or error messages. This format is the primary source for monitoring a simulation's stability, diagnosing problems, and extracting averaged thermodynamic properties after the run is complete."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000439 "output log format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000439 "simulation log format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000439 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000439 obo:MOLSIM_001085)

# Class: obo:MOLSIM_000440 (NMR data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000440 "A category of data formats for files containing information derived from Nuclear Magnetic Resonance (NMR) experiments. These formats are used to store and exchange experimental data, such as structural restraints, that can be used in simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000440 "NMR data format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000440 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000440 obo:MOLSIM_000436)

# Class: obo:MOLSIM_000441 (simulation state format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000441 "A data format for a file that stores a complete snapshot of a simulation's state at a specific time. This includes coordinates, velocities, and other state variables sufficient to resume the run. These formats are often binary for efficiency."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000441 "simulation state format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000441 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000441 obo:MOLSIM_001085)

# Class: obo:MOLSIM_000442 (Molden format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000442 "A text data format that stores the results of a quantum chemistry calculation for visualization, holding atomic coordinates together with the basis functions and coefficients that describe the molecular orbitals. Because it carries the orbitals themselves rather than only a picture of them, a viewer can render orbitals, electron density and vibrational modes from it. It is read by many visualization programs, not only the one it is named after. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000442 "Molden format"@en)
SubClassOf(obo:MOLSIM_000442 obo:MOLSIM_010022)

# Class: obo:MOLSIM_000443 (xyzv format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000443 "A simple text-based file format for storing data that exists at various points in 3D space. Each line in the file specifies an x, y, and z coordinate, followed by the data value at that point. It is a straightforward, human-readable format for representing sparse or irregular grid data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000443 "xyzv format"@en)
SubClassOf(obo:MOLSIM_000443 obo:MOLSIM_000909)

# Class: obo:MOLSIM_000444 (tleap input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000444 "A script file format for the tleap program in AmberTools, used to build a molecular system for simulation. It contains a sequence of commands to load molecular structures, apply force fields, add solvent, and save the final topology and coordinate files. This format is a fundamental part of the system preparation stage in an Amber workflow. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000444 "tleap input format"@en)
SubClassOf(obo:MOLSIM_000444 obo:MOLSIM_000438)

# Class: obo:MOLSIM_000445 (mmCIF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000445 "The mmCIF format (.cif or .mmcif) is the standard archival format for macromolecular structures used by the Protein Data Bank (PDB), superseding the legacy PDB format. It uses a flexible, dictionary-based syntax (CIF) with key-value pairs and loop structures to store atomic coordinates, connectivity, experimental details, and extensive metadata. It is better suited for handling large, complex structures and diverse experimental data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000445 "mmCIF format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000445 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000445 obo:MOLSIM_001088)
DisjointClasses(obo:MOLSIM_000445 obo:MOLSIM_000446)

# Class: obo:MOLSIM_000446 (PDB format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000446 "The PDB format (.pdb) is the long-standing, fixed-column text format traditionally used for storing protein and nucleic acid structures from the Protein Data Bank. It includes records for metadata, atomic coordinates, and optionally connectivity. While still widely compatible with visualization and simulation software, it is considered obsolete since it has limitations for very large structures and complex metadata compared to the newer mmCIF format."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000446 "PDB format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000446 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000446 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000447 (identifier)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000447 "An identifier is a unique name, code, or label assigned to a specific entity, data record, or concept to distinguish it unambiguously from others within a given context. In scientific databases and computational workflows, identifiers (like accession numbers or unique IDs) are crucial for referencing, retrieving, and linking specific pieces of information accurately. They serve as unique addresses for data points or objects. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000447 "identifier"@en)

# Class: obo:MOLSIM_000448 (protein database ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000448 "OBSOLETE. A protein database ID is a unique alphanumeric code assigned to each entry in a public protein structure or sequence database, such as the Protein Data Bank (PDB ID, e.g., '1TIM') or UniProt (accession number, e.g., 'P00761'). These identifiers serve as the standard way to reference and retrieve specific protein structures or sequence information."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000448 "obsolete protein database ID"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000448 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000448 "Retired 2026-08-07 on review by orcid:0000-0002-2294-5393. Two objections, both accepted. First, the Protein Data Bank is not a protein database: it holds nucleic acids, protein-nucleic acid complexes and other assemblies, so the label and definition made a claim that is simply false. Second, a PDB entry identifies a deposited structure while a UniProt accession identifies a sequence record, so grouping them said less than it appeared to. Its two children, MOLSIM:000686 PDB ID and MOLSIM:000687 UniProt ID, were re-parented to MOLSIM:000447 identifier alongside the other identifiers. No IAO:0100001 successor, because there is no single term that replaces it; this is the same shape as the other retired grouping terms whose children were re-parented instead. Note the term had been verified by orcid:0000-0003-4177-3619 before this review."@en)

# Class: obo:MOLSIM_000449 (electrostatic damping function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000449 "A function that reduces the electrostatic interaction between 2 charges as they approach very closely. Without it, a polarizable model can reach a state where 2 induced dipoles reinforce each other without limit and the energy diverges. Damping prevents that failure, which is called polarization catastrophe. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000449 "tinker-exponential damping"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000449 "electrostatic damping function"@en)
SubClassOf(obo:MOLSIM_000449 obo:MOLSIM_000430)

# Class: obo:MOLSIM_000450 (hydrogen bond analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000450 "Hydrogen bond analysis is a structural analysis method used to identify and quantify the hydrogen bonds that are formed and broken during a simulation. The analysis typically uses a set of geometric criteria, such as a maximum distance between the donor and acceptor atoms and a minimum angle, to define when a hydrogen bond exists."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000450 "hydrogen bond analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000450 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000450 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000451 (isotropically distributed ensemble analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000451 "A structural analysis method that tests whether the orientations of the structures in a collection are spread evenly over all directions. It computes the distribution of orientations and looks for any preferred alignment. It is used to confirm that a simulation has not introduced an artificial bias in rotational motion, which some theoretical treatments assume is absent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000451 "isotropically distributed ensemble analysis"@en)
SubClassOf(obo:MOLSIM_000451 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000452 (isotropic reorientational eigenmode dynamics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000452 "A dynamics analysis method that breaks the tumbling of a molecule in solution into a set of independent rotational modes. Each mode has its own timescale, so the overall rotation can be described by a few numbers instead of a full trajectory. The result can be compared directly with NMR relaxation measurements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000452 "isotropic reorientational eigenmode dynamics analysis"@en)
SubClassOf(obo:MOLSIM_000452 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000453 (nucleic acid structure analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000453 "Nucleic acid structure analysis is a specialized type of structural analysis that calculates a set of parameters describing the detailed geometry of a DNA or RNA helix, known as the helical parameters. This includes parameters that describe the geometry of individual base pairs as well as the relationship between adjacent base pairs, such as twist, roll, and slide."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000453 "nucleic acid structure analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000453 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000453 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000454 (native contact analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000454 "A structural analysis method that tracks how many of the atom pairs in contact in a reference folded structure are also in contact at each point in a trajectory. The reference set is taken from the native state and the result is reported as the fraction of it that is present. That fraction is a common single-number measure of how far folding has progressed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000454 "native contact analysis"@en)
SubClassOf(obo:MOLSIM_000454 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000455 (time-lagged independent component analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000455 "A statistical method that finds the directions in which a system changes most slowly, rather than those in which it varies most. It does this by looking at how coordinates relate to themselves after a delay rather than at the same instant. The slowest motions are usually the functionally important ones, and they are not always the largest. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000455 "tICA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000455 "time-lagged independent component analysis"@en)
SubClassOf(obo:MOLSIM_000455 obo:MOLSIM_000120)

# Class: obo:MOLSIM_000456 (wavelet analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000456 "A method that decomposes a signal into contributions at different frequencies, while keeping track of when each occurred. A standard frequency analysis says which frequencies are present over the whole record but not when. That matters for a trajectory, where a motion may appear only during part of the run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000456 "wavelet analysis"@en)
SubClassOf(obo:MOLSIM_000456 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000457 (wavelet analysis feature extraction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000457 "A method that identifies events in a signal from the output of a wavelet decomposition, by finding where energy at a given frequency appears or disappears. It picks out transitions rather than describing the signal as a whole. In a trajectory it marks the moments at which a molecule changed its mode of motion. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000457 "wavelet analysis feature extraction"@en)
SubClassOf(obo:MOLSIM_000457 obo:MOLSIM_000456)

# Class: obo:MOLSIM_000458 (fluorescence spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000458 "Fluorescence spectroscopy is an experimental technique that measures the light emitted by a substance after it has absorbed light. A molecule absorbs light at one wavelength, promoting it to an excited electronic state, and then emits light at a longer, lower-energy wavelength as it relaxes back down. This technique is highly sensitive and is widely used to study molecular conformation, binding, and dynamics by monitoring changes in the fluorescence signal."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000458 "fluorescence spectroscopy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000458 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000458 obo:MOLSIM_001008)

# Class: obo:MOLSIM_000459 (rtp format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000459 "A data format used by GROMACS that defines a reusable template for one residue, giving its atoms, their charges and the bonds between them. It is what lets a topology be built automatically from a sequence rather than written out atom by atom. It is the GROMACS counterpart of the CHARMM residue topology file. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000459 "GROMACS rtp format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000459 "rtp format"@en)
SubClassOf(obo:MOLSIM_000459 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000460 (molecular mechanics Poisson-Boltzmann surface area tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000460 "A computational tool or script that implements the MM/PBSA (Molecular Mechanics / Poisson-Boltzmann Surface Area) method for estimating free energy changes, typically ligand binding affinities or solvation free energies. This approach involves calculating molecular mechanics energies (MM), electrostatic solvation free energies using the Poisson-Boltzmann (PB) equation, and non-polar solvation free energies using a term proportional to the Solvent Accessible Surface Area (SASA), usually averaged over snapshots from an MD trajectory. It's an endpoint free energy method, computationally cheaper than FEP or TI but generally considered less rigorous. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000460 "MMPBSA tool"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000460 "molecular mechanics Poisson-Boltzmann surface area tool"@en)
SubClassOf(obo:MOLSIM_000460 obo:MOLSIM_000257)

# Class: obo:MOLSIM_000461 (molecular mechanics Poisson-Boltzmann surface area module)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000461 "A molecular mechanics Poisson-Boltzmann surface area tool that is built into a larger simulation or modelling package rather than run on its own. It uses that package's own energy routines and Poisson-Boltzmann solver, which is what distinguishes it from a standalone script such as MMPBSA.py. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000461 "MMPBSA module"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000461 "molecular mechanics Poisson-Boltzmann surface area module"@en)
SubClassOf(obo:MOLSIM_000461 obo:MOLSIM_000460)

# Class: obo:MOLSIM_000462 (molecular mechanics generalized Born surface area tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000462 "A computational tool or script that implements the MM/GBSA (Molecular Mechanics / Generalized Born Surface Area) method for estimating free energy changes, analogous to MM/PBSA. The key difference is that MM/GBSA uses a Generalized Born (GB) model instead of the more computationally expensive Poisson-Boltzmann (PB) equation to calculate the electrostatic contribution to the solvation free energy. Like MM/PBSA, it combines MM energies, GB electrostatic solvation energy, and a SASA-based nonpolar term, averaged over simulation snapshots, providing a faster but often less accurate estimation of binding or solvation free energies compared to rigorous methods. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000462 "MMGBSA tool"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000462 "molecular mechanics generalized Born surface area tool"@en)
SubClassOf(obo:MOLSIM_000462 obo:MOLSIM_000257)

# Class: obo:MOLSIM_000463 (ref Tversky combo)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000463 "A comprehensive molecular similarity measure that combines both shape-based RefTversky and chemical feature-based RefColorTversky scores into a single metric. This combined measure provides a more complete assessment of molecular similarity by considering both geometric shape and chemical functionality simultaneously. The resulting score typically ranges from 0 to 2, though it can occasionally exceed this range due to the field-based nature of shape matching. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000463 "ref Tversky combo"@en)
SubClassOf(obo:MOLSIM_000463 obo:MOLSIM_000076)

# Class: obo:MOLSIM_000464 (STO-6G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000464 "A minimal basis set in which each atomic orbital is approximated by 6 Gaussian functions added together. It is the most faithful imitation in the family and still minimal, so it remains unsuitable for real work. Adding Gaussians improves the shape of each orbital and never lets the electron cloud change shape as a bond forms. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000464 "STO-6G"@en)
SubClassOf(obo:MOLSIM_000464 obo:MOLSIM_000017)

# Class: obo:MOLSIM_000465 (NModelGB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000465 "NModelGB is a specific implementation of a Generalized Born (GB) implicit solvent model, likely used within a particular simulation package. It provides a specific set of equations and parameters for calculating the electrostatic contribution to the solvation free energy. The \"NModel\" designation distinguishes this particular variant from other GB models available to the user. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000465 "NModelGB"@en)
SubClassOf(obo:MOLSIM_000465 obo:MOLSIM_000462)

# Class: obo:MOLSIM_000466 (orientations of proteins in membranes)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000466 "OPM database (Orientations of Proteins in Membranes) is both a database and a web server/tool providing pre-calculated transmembrane orientations and positions for experimentally determined membrane protein structures found in the PDB. OPM uses a computational approach based on minimizing the calculated transfer free energy from water to the lipid bilayer to determine the most likely membrane boundaries and protein position relative to the bilayer center. It's a valuable resource for obtaining initial membrane protein placements for simulations."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000466 "OPM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000466 "orientations of proteins in membranes"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000466 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000466 obo:MOLSIM_000227)
SubClassOf(obo:MOLSIM_000466 obo:MOLSIM_001119)

# Class: obo:MOLSIM_000467 (Forster resonance energy transfer)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000467 "Förster Resonance Energy Transfer (FRET) is a specific phenomenon in fluorescence spectroscopy where an excited donor fluorophore non-radiatively transfers its energy to a nearby acceptor fluorophore. The efficiency of this energy transfer is extremely sensitive to the distance between the two molecules, making it a \"spectroscopic ruler.\""@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000467 "FRET"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000467 "Forster resonance energy transfer"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000467 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000467 obo:MOLSIM_000458)

# Class: obo:MOLSIM_000468 (MRC format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000468 "A binary file format used to store three-dimensional images or maps, common in electron microscopy. It is the standard format for storing 3D density maps in cryo-electron microscopy (cryo-EM) and is also used in X-ray crystallography. This format is essential for the visualization and analysis of volumetric data in structural biology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000468 "MRC format"@en)
SubClassOf(obo:MOLSIM_000468 obo:MOLSIM_000909)

# Class: obo:MOLSIM_000469 (AMBER mdin format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000469 "A text-based format containing control parameters for the Amber sander and pmemd programs, organized in Fortran namelists. It specifies simulation conditions like timestep, duration, and temperature/pressure coupling algorithms. This format dictates how the molecular dynamics simulation is performed."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000469 "AMBER mdin format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000469 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000469 obo:MOLSIM_002065)

# Class: obo:MOLSIM_000470 (mdout format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000470 "A text-based log format generated by Amber's simulation engines that provides a detailed record of the simulation's progress. It contains energy components, thermodynamic properties, and performance timings printed at regular intervals. This format is essential for monitoring simulation stability and extracting averaged properties. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000470 "AMBER mdout format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000470 "AMBER out format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000470 "mdout format"@en)
SubClassOf(obo:MOLSIM_000470 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000471 (AMBER restart format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000471 "A format that stores the complete state of an Amber simulation, including atomic coordinates, velocities, and periodic box dimensions. It is used to save the simulation state at a specific point in time, allowing the run to be resumed exactly. The format can be either ASCII-based (.rst7) or binary NetCDF-based (.ncrst)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000471 "AMBER restart format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000471 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000471 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000472 (AMBER topology format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000472 "The Amber molecular dynamics topology file (.prmtop or .parm7) contains all the static information about the molecular system needed for an Amber simulation, excluding coordinates. This includes atom definitions (names, types, masses, charges), molecular connectivity (bonds, angles, dihedrals), force field parameters for all interaction terms, and non-bonded interaction rules. It is generated by programs like tleap and used together with a coordinate file (.inpcrd, .rst7)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000472 "AMBER topology format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000472 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000472 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000473 (ac format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000473 "A file format generated by the Antechamber program in AmberTools that contains a molecule's structure and atomic properties. It typically stores atom types and partial charges assigned during the parameterization process for a small molecule. This format serves as an intermediate in preparing non-standard molecules for simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000473 "ac format"@en)
SubClassOf(obo:MOLSIM_000473 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000474 (protein-ligand docking analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000474 "A computational method that predicts how a small molecule sits in a binding site on a protein, and scores how well it binds. It searches over positions and shapes of the molecule and rates each by a scoring function. It is fast enough to screen large libraries, and its scores rank candidates far better than they predict real binding strengths. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000474 "protein-ligand docking analysis"@en)
SubClassOf(obo:MOLSIM_000474 obo:MOLSIM_000255)

# Class: obo:MOLSIM_000475 (coarse-grained molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000475 "A molecular dynamics method that integrates the equations of motion for a coarse-grained model rather than an all-atom one. Fewer and smoother interactions permit a timestep 10 or more times longer, which together with the smaller particle count is where its speed comes from. Its trajectory cannot be interpreted below the size of 1 site. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000475 "CG-MD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000475 "coarse-grained molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000475 obo:MOLSIM_000229)

# Class: obo:MOLSIM_000476 (TIP3P water model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000476 "OBSOLETE. A specific, widely used 3-point water model type characterized by its simplicity and computational efficiency (Transferable Intermolecular Potential 3-Point). It places charges on the oxygen and two hydrogen atoms and represents water as a rigid molecule with experimentally derived geometry. While computationally fast, it is known to have limitations in reproducing some properties of real water (like the temperature of maximum density or dielectric constant) compared to more complex models."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000476 "obsolete TIP3P water model"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000476 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000476 obo:MOLSIM_000022)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000476 "Retired 2026-08-24 as a duplicate. MOLSIM:000022 TIP3P describes the same rigid three-site model with charges on the oxygen and two hydrogens, and sits with the other 18 water models under MOLSIM:000014 water model force field. This one sat under the parallel MOLSIM:000030 water type branch, which was retired in the same change.")

# Class: obo:MOLSIM_000477 (CHELPG charge analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000477 "A method that assigns charge to atoms by fitting point charges to reproduce the molecule's electrostatic potential at points on a grid outside it. Fitting to the potential is what makes the resulting charges suitable for a force field, since that potential is what other molecules feel. Charges on buried atoms are poorly determined, because the potential outside barely depends on them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000477 "CHELPG charge analysis"@en)
SubClassOf(obo:MOLSIM_000477 obo:MOLSIM_000674)

# Class: obo:MOLSIM_000478 (molecular surface analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000478 "Molecular surface analysis is a category of analysis methods used to calculate and characterize the surface of a molecule. This includes calculating properties like the total surface area, identifying pockets and cavities, and mapping properties like electrostatic potential onto the surface."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000478 "molecular surface analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000478 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000478 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000479 (Connolly surface analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000479 "A Connolly surface calculation is a specific algorithm used to compute the solvent-accessible surface of a molecule, which is the surface traced out by the center of a probe sphere as it rolls over the molecule. It is a widely used method for defining the boundary between a molecule and the surrounding solvent."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000479 "Connolly surface analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000479 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000479 obo:MOLSIM_000478)

# Class: obo:MOLSIM_000480 (covariance matrix analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000480 "A covariance matrix calculation is an analysis method that quantifies the correlated motions of atoms in a simulation. The resulting matrix describes how the displacement of each atom is correlated with the displacement of every other atom. For experts, calculating and diagonalizing the covariance matrix is the central step in Principal Component Analysis (PCA), which is used to identify the dominant, large-scale collective motions of a protein or other macromolecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000480 "covariance matrix analysis"@en)
SubClassOf(obo:MOLSIM_000480 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000481 (2D RMSD analysis)

AnnotationAssertion(owl:deprecated obo:MOLSIM_000481 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000481 "OBSOLETE. A 2D RMSD analysis is a method where the Root-Mean-Square Deviation (RMSD) is calculated for multiple frames in a simulation trajectory with respect to a reference structure. The reference structure is usually the first frame in the trajectory or an average structure of the whole simulation. The results are typically visualized as a two-dimensional plot, where each point represents the RMSD between one frame and the reference structure."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000481 obo:MOLSIM_000311)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000481 "Retired as redundant with 'RMSD analysis' (MOLSIM:000311), which shares the same parent and the same underlying principle. The 2D frame-to-frame form is now covered explicitly by that term's definition. Reported and approved by the term verifier in GitHub issue #45."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000481 "obsolete 2D RMSD analysis"@en)

# Class: obo:MOLSIM_000482 (lipid SCD order parameter calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000482 "A lipid SCD order parameter calculation is a specific analysis method used to quantify the orientational order of the carbon-hydrogen bonds in the acyl tails of lipid molecules in a membrane simulation. The SCD parameter measures the motional restriction of these bonds relative to the membrane normal. Calculating these order parameters and comparing them to experimental values from NMR is a primary method for validating the accuracy of a membrane simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000482 "lipid SCD order parameter calculation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000482 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000482 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000483 (3D reference interaction site analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000483 "An analysis method that computes where solvent molecules are likely to sit around a solute by solving integral equations of liquid-state theory on a 3-dimensional grid. It gives a solvent distribution without simulating solvent molecules moving, so no sampling problem arises. What it cannot give is any individual solvent molecule's behaviour over time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000483 "3D reference interaction site analysis"@en)
SubClassOf(obo:MOLSIM_000483 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000484 (adaptive solvent QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000484 "A QM/MM method in which solvent molecules pass between the quantum and the classical region as they diffuse, rather than being assigned once. A fixed assignment would either trap particular water molecules in the quantum region or cut them as they moved out. The method exists because solvent does not stay put. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000484 "adaptive solvent QM/MM"@en)
SubClassOf(obo:MOLSIM_000484 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000485 (split-valence basis set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000485 "A basis set that represents each valence orbital with 2 or more functions of different spatial extent, while keeping a single function for each core orbital. The extra valence functions let the electron cloud expand or contract as bonding requires, which a minimal set cannot. Splitting only the valence shell concentrates the added cost where bonding happens. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000485 "split-valence"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000485 "split-valence basis set"@en)
SubClassOf(obo:MOLSIM_000485 obo:MOLSIM_000432)

# Class: obo:MOLSIM_000486 (3-21G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000486 "A split-valence Gaussian basis set describing each core orbital with 3 contracted primitives and each valence orbital with 2 functions, built from 2 and 1 primitives. It is small enough for large molecules and crude enough that its geometries are only approximate. It is used for a quick first optimisation before a better basis set is applied. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000486 "3-21G"@en)
SubClassOf(obo:MOLSIM_000486 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000487 (4-21G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000487 "A split-valence Gaussian basis set describing each core orbital with 4 contracted primitives and each valence orbital with 2 functions. It differs from the 3-primitive version only in the description of the core, which barely affects bonding. It is rarely used today. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000487 "4-21G"@en)
SubClassOf(obo:MOLSIM_000487 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000488 (harmonic improper torsion potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000488 "An improper torsion potential in which the energy rises with the square of the departure from a single preferred value. Unlike the repeating cosine form it has one minimum, which is what makes it suitable for holding a group flat. The AMBER force fields use a cosine form for the same purpose, so the 2 conventions are not interchangeable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000488 "harmonic improper torsion potential"@en)
SubClassOf(obo:MOLSIM_000488 obo:MOLSIM_000431)

# Class: obo:MOLSIM_000489 (Lennard-Jones potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000489 "A potential energy function representing the van der Waals interaction between 2 atoms, with a steep repulsion at short range and a weaker attraction falling off with the sixth power of distance. The attraction has a physical basis in dispersion; the repulsion is chosen for computational convenience rather than derived. It is the form almost every force field uses. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000489 "Lennard-Jones potential"@en)
SubClassOf(obo:MOLSIM_000489 obo:MOLSIM_000430)

# Class: obo:MOLSIM_000490 (structure preparation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000490 "A software program that prepares, corrects and checks a molecular structure before it is used in a simulation. Its tasks include adding atoms the experimental structure does not contain, choosing between alternative positions where the data was ambiguous, and reporting geometry that cannot be right. Experimental structures nearly always need this, because crystallography rarely sees hydrogens and often misses flexible loops. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000490 "structure preparation tool"@en)
SubClassOf(obo:MOLSIM_000490 obo:MOLSIM_001850)

# Class: obo:MOLSIM_000491 (SYBYL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000491 "A comprehensive commercial molecular modeling software suite developed by Certara, widely used in drug discovery and computational chemistry. SYBYL offers extensive tools for structure building and manipulation, conformational analysis, pharmacophore modeling, QSAR, docking, scoring, and visualization, along with molecular mechanics and dynamics capabilities. It provides an integrated environment for many structure preparation and modeling tasks relevant to biomolecular simulation setup, particularly in pharmaceutical research. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000491 "SYBYL"@en)
SubClassOf(obo:MOLSIM_000491 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000492 (Swiss PDB viewer)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000492 "A visualization and analysis program for protein structures that also performs measurement, superposition and simple modelling. It can build a model of one protein on the structure of a related one, and submit that model for refinement. It is now distributed under the name DeepView, which should be kept as an exact synonym of this term. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000492 "DeepView"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000492 "Swiss PDB viewer"@en)
SubClassOf(obo:MOLSIM_000492 obo:MOLSIM_000490)
SubClassOf(obo:MOLSIM_000492 obo:MOLSIM_002041)

# Class: obo:MOLSIM_000493 (Pymol)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000493 "A very popular, powerful, and widely used open-source (with some subscription features) molecular visualization system, known for producing high-quality 3D images of molecules and biological macromolecules. PyMOL allows detailed structure inspection, analysis (measurements, surfaces, electrostatics), creating publication-quality figures and animations, and includes scripting capabilities for automation. It is an indispensable tool for visualizing simulation setups and trajectories, although its structure manipulation capabilities are less extensive than dedicated modeling suites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000493 "Pymol"@en)
SubClassOf(obo:MOLSIM_000493 obo:MOLSIM_002041)

# Class: obo:MOLSIM_000494 (minimization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000494 "Minimization is a computational step that relaxes a molecular structure to remove any bad clashes between atoms. As a stage of the preparation process, energy minimization is a procedure that adjusts the atomic coordinates to find a nearby local minimum on the potential energy surface, thereby removing steric strain from the initial model. This is achieved by using algorithms like steepest descent or conjugate gradient to iteratively reduce the net forces on the atoms until a convergence criterion, such as grms_tol, is met. This process is referred to in log files and inputs with terms like \"MINIMIZATION,\" \"ntmin=1,\" \"emtol,\" and \"ncyc.\" (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000494 "minimization"@en)
SubClassOf(obo:MOLSIM_000494 obo:MOLSIM_000002)

# Class: obo:MOLSIM_000495 (parse radii)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000495 "An empirically derived set of atomic radii developed by Sitkoff, Sharp, and Honig in the 1990s, specifically optimized for use in continuum electrostatic calculations, particularly Poisson-Boltzmann (PB) calculations aimed at reproducing experimental solvation energies (PARSE stands for \"Parameters for Solvation Energy\"). These radii define the boundary between the low-dielectric solute molecule and the high-dielectric solvent continuum in PB theory. They differ significantly from standard Van der Waals radii (like Bondi's) as they are optimized to implicitly account for various energetic contributions within that specific theoretical framework (PB/SA). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000495 "parse radii"@en)
SubClassOf(obo:MOLSIM_000495 obo:MOLSIM_000272)

# Class: obo:MOLSIM_000496 (pyMBAR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000496 "A Python library that implements the multi-state Bennett acceptance ratio estimator for combining data from simulations at several thermodynamic states. It returns free energy differences between any pair of those states together with equilibrium averages. It is the reference implementation most other tools call. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000496 "pyMBAR"@en)
SubClassOf(obo:MOLSIM_000496 obo:MOLSIM_001566)

# Class: obo:MOLSIM_000497 (computational method statistical measure analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000497 "A statistical metric used to judge how well a computational method performs, rather than to describe the system being studied. Error measures, correlation measures and ranking measures all belong here. They are what a method is validated against before its predictions are relied on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000497 "computational method statistical measure analysis"@en)
SubClassOf(obo:MOLSIM_000497 obo:MOLSIM_000348)

# Class: obo:MOLSIM_000498 (predictive index of Pearman analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000498 "A statistical metric that rates how useful a model's predictions are for making a decision, by weighting each pair of compounds by how much choosing wrongly between them would cost. It counts a wrong ordering of 2 very different compounds more heavily than of 2 similar ones. It is used where a model is meant to guide a choice rather than reproduce a number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000498 "predictive index of Pearman analysis"@en)
SubClassOf(obo:MOLSIM_000498 obo:MOLSIM_000497)

# Class: obo:MOLSIM_000499 (accuracy of ddG prediction metrics measurements analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000499 "A data analysis method that measures how closely predicted relative binding free energies match experimental ones for the same set of ligand pairs. It reports error measures such as root mean square error and mean absolute error, and agreement measures such as the Pearson correlation and the Kendall rank correlation. The rank measures matter most when the purpose is to order ligands rather than to predict a number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000499 "accuracy of ddG prediction metrics measurements analysis"@en)
SubClassOf(obo:MOLSIM_000499 obo:MOLSIM_000348)

# Class: obo:MOLSIM_000500 (mechanical embedding QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000500 "A QM/MM scheme in which the quantum region is computed in isolation and its interaction with the surroundings is treated entirely by the force field. The quantum region therefore never feels the charges around it, so its electron distribution does not respond to its environment. It is the simplest scheme and the least accurate where the environment is polar. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000500 "mechanical embedding QM/MM"@en)
SubClassOf(obo:MOLSIM_000500 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000501 (4-31G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000501 "A split-valence Gaussian basis set describing each core orbital with 4 contracted primitives and each valence orbital with 2 functions built from 3 and 1 primitives. It was an early step towards the widely used 6-31G family and is superseded by it. It is retained because older published work used it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000501 "4-31G"@en)
SubClassOf(obo:MOLSIM_000501 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000502 (linear correlation significance determination analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000502 "A statistical mathematical technique used to assess whether an observed linear relationship (correlation) between two variables, calculated from simulation data, is statistically meaningful. It evaluates the probability that such a correlation could have occurred simply by random chance if no true underlying relationship existed. This helps researchers confidently interpret potential connections found in simulation results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000502 "linear correlation significance determination analysis"@en)
SubClassOf(obo:MOLSIM_000502 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000503 (determination by p-value analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000503 "A common specific method for linear correlation significance determination (and statistical testing in general) that involves calculating a probability value, the p-value. The p-value represents the probability of observing the calculated correlation, or a stronger one, assuming that there is actually no real correlation (the null hypothesis). A small p-value (typically below a threshold like 0.05) leads to the conclusion that the observed correlation is statistically significant and unlikely due to chance. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000503 "determination by p-value analysis"@en)
SubClassOf(obo:MOLSIM_000503 obo:MOLSIM_000400)

# Class: obo:MOLSIM_000505 (6-21G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000505 "A split-valence Gaussian basis set describing each core orbital with 6 contracted primitives and each valence orbital with 2 functions. The larger core description makes it more accurate than its 3-primitive and 4-primitive relatives for core-dependent properties and no better for bonding. It is rarely used today. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000505 "6-21G"@en)
SubClassOf(obo:MOLSIM_000505 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000506 (6-31G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000506 "A split-valence Gaussian basis set that describes each core orbital with 6 contracted primitives and each valence orbital with 2 functions, an inner one contracted from 3 primitives and an outer one from a single primitive. It is one of the most widely used basis sets in quantum chemistry, because it is far more accurate than a minimal basis set while staying cheap enough for routine work. It is also the starting point most polarization and diffuse variants are built on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000506 "6-31G"@en)
SubClassOf(obo:MOLSIM_000506 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000509 (QM generalized Born treatment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000509 "A multiscale method that describes a solute quantum mechanically while representing the surrounding solvent with a generalized Born continuum model. The quantum region can then respond electronically to the solvent without any solvent molecules being simulated. It is used where reactivity matters but explicit solvent would be too expensive. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000509 "QM generalized Born treatment"@en)
SubClassOf(obo:MOLSIM_000509 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000510 (time-averaged restraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000510 "A time-averaged restraint simulation is an advanced simulation method where the restraining potential is applied not to the instantaneous structure, but to the average of a an experimental one over a period of time. This is particularly useful for incorporating experimental data, like from NMR, which is also an average over time and a molecular ensemble. For experts, this method provides a more physically meaningful way to enforce experimental restraints that reflect the dynamic nature of the molecule."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000510 "time-averaged restraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000510 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000510 obo:MOLSIM_000364)

# Class: obo:MOLSIM_000511 (6-311G)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000511 "A split-valence Gaussian basis set that describes each core orbital with 6 contracted primitives and each valence orbital with 3 functions of different spatial extent, contracted from 3, 1 and 1 primitives. The extra valence function gives more freedom than a double-split set, so it is more accurate for the same molecule. It is usually used together with polarization and diffuse functions rather than on its own. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000511 "6-311G"@en)
SubClassOf(obo:MOLSIM_000511 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000512 (LANL08)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000512 "A set of effective core potentials and matching valence basis sets developed at Los Alamos National Laboratory for calculations on heavier elements. The potential replaces the chemically inert inner electrons with a single function, which cuts cost and folds in some relativistic effects, while the valence basis describes the electrons that form bonds. It is the successor to the older LANL2 family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000512 "LANL08"@en)
SubClassOf(obo:MOLSIM_000512 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000513 (LANL08(f))

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000513 "A set of effective core potentials and valence basis sets from the Los Alamos LANL08 family, with f type polarization functions added on the heavy atoms the potential covers. The f functions give more freedom in describing electron distribution, which matters for bonding in molecules containing heavier elements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000513 "LANL08(f)"@en)
SubClassOf(obo:MOLSIM_000513 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000514 (LANL2-[6s4p4d2f])

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000514 "A Los Alamos effective core potential paired with a valence basis contracted to 6 s-type, 4 p-type, 4 d-type and 2 f-type functions. The potential replaces the inner electrons, and the large valence contraction gives far more flexibility than the standard double-zeta basis of the same family. It is used for heavier elements where the standard basis is too small to describe bonding accurately. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000514 "LANL2-[6s4p4d2f]"@en)
SubClassOf(obo:MOLSIM_000514 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000515 (LANL2DZ ECP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000515 "A Los Alamos effective core potential paired with a double-zeta valence basis, for elements from the third row onwards. The potential replaces the inner electrons with a single function, which cuts cost and folds in some relativistic effects. It is the most widely used effective core potential basis combination. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000515 "LANL2DZ ECP"@en)
SubClassOf(obo:MOLSIM_000515 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000516 (LANL2DZ+1d1f)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000516 "A Los Alamos effective core potential with a double-zeta valence basis, carrying 1 extra d type and 1 extra f type polarization function on the heavy atoms the potential covers. The higher angular momentum functions give the valence basis more freedom, which improves the description of bonding for heavier elements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000516 "LANL2DZ+1d1f"@en)
SubClassOf(obo:MOLSIM_000516 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000517 (LANL2DZ+2s2p2d2f)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000517 "A Los Alamos effective core potential with a double-zeta valence basis, carrying 2 additional s, p, d and f functions on the heavy atoms the potential covers. The additions give far more freedom in describing valence electrons than the standard double-zeta set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000517 "LANL2DZ+2s2p2d2f"@en)
SubClassOf(obo:MOLSIM_000517 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000518 (LANL2DZdp ECP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000518 "A Los Alamos effective core potential with a double-zeta valence basis, carrying d type polarization functions on the heavy atoms the potential covers and p type polarization functions on hydrogen. The added polarization functions improve molecular geometries and interaction energies markedly over the unpolarized version. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000518 "LANL2DZdp ECP"@en)
SubClassOf(obo:MOLSIM_000518 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000519 (LANL2DZdp ECP Polarization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000519 "A Los Alamos effective core potential with a double-zeta valence basis, carrying d type polarization functions on the heavy atoms the potential covers and p type polarization functions on hydrogen. The added polarization functions improve molecular geometries and interaction energies markedly over the unpolarized version. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000519 "LANL2DZdp ECP Polarization"@en)
SubClassOf(obo:MOLSIM_000519 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000520 (LANL2TZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000520 "A Los Alamos effective core potential paired with a triple-zeta valence basis set, using 3 functions per valence orbital. The extra valence function makes it more flexible and more accurate than the double-zeta member of the same family, at a higher cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000520 "LANL2TZ"@en)
SubClassOf(obo:MOLSIM_000520 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000521 (LANL2TZ(f))

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000521 "A Los Alamos effective core potential with a triple-zeta valence basis set, with f type polarization functions added on the heavy atoms the potential covers. The f functions describe electron correlation and polarization around heavier elements more accurately than the unaugmented set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000521 "LANL2TZ(f)"@en)
SubClassOf(obo:MOLSIM_000521 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000522 (cc-pVDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000522 "A correlation-consistent basis set giving 2 functions per valence orbital with a set of polarization functions. It is the smallest member of its family and the cheapest at which correlated methods give meaningful results. It is used as the lowest point of an extrapolation towards the complete basis set limit. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000522 "cc-pVDZ"@en)
SubClassOf(obo:MOLSIM_000522 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000523 (cc-pVTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000523 "A correlation-consistent basis set that gives 3 functions per valence orbital together with polarization functions up to f type. It is the level at which correlated calculations first become reliably useful. It is the most widely used member of the family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000523 "cc-pVTZ"@en)
SubClassOf(obo:MOLSIM_000523 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000524 (cc-pVQZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000524 "A correlation-consistent basis set that gives 4 functions per valence orbital together with polarization functions up to g type. It is used where a triple-zeta result is not converged enough, and as one point in an extrapolation to the complete basis set limit. Its cost restricts it to modest-sized molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000524 "cc-pVQZ"@en)
SubClassOf(obo:MOLSIM_000524 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000525 (cc-pV5Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000525 "A correlation-consistent basis set that gives 5 functions per valence orbital together with polarization functions up to h type. It is built for benchmark calculations that need to come very close to the complete basis set limit for correlation energy. Its cost restricts it to small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000525 "cc-pV5Z"@en)
SubClassOf(obo:MOLSIM_000525 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000526 (cc-pV6Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000526 "A correlation-consistent basis set that gives 6 functions per valence orbital together with polarization functions up to i type. It is 1 step larger than the quintuple-zeta set and buys a further small step towards the complete basis set limit. In practice it is feasible only for atoms and diatomic molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000526 "cc-pV6Z"@en)
SubClassOf(obo:MOLSIM_000526 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000527 (cc-pV8Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000527 "A correlation-consistent basis set that gives 8 functions per valence orbital together with very extensive polarization functions. It exists to study how results converge towards the complete basis set limit, rather than to be used in ordinary work. Its cost restricts it to single atoms and diatomic molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000527 "cc-pV8Z"@en)
SubClassOf(obo:MOLSIM_000527 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000528 (cc-pV9Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000528 "A correlation-consistent basis set that gives 9 functions per valence orbital together with polarization functions of very high angular momentum. It is among the largest sets ever constructed in this family and serves only to extrapolate towards the complete basis set limit. It is too expensive for any molecular calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000528 "cc-pV9Z"@en)
SubClassOf(obo:MOLSIM_000528 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000529 (cc-pVDZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000529 "An auxiliary basis set built to be paired with the correlation-consistent double-zeta orbital basis in resolution-of-identity or density fitting calculations. It approximates products of orbital basis functions rather than representing orbitals itself. Pairing it with a different orbital basis degrades the approximation it was fitted for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000529 "cc-pVDZ-RI"@en)
SubClassOf(obo:MOLSIM_000529 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000530 (cc-pVTZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000530 "An auxiliary basis set built to be paired with the correlation-consistent triple-zeta orbital basis in resolution-of-identity or density fitting calculations. It approximates products of orbital basis functions so integrals can be evaluated faster. It is not used to represent orbitals. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000530 "cc-pVTZ-RI"@en)
SubClassOf(obo:MOLSIM_000530 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000531 (cc-pVQZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000531 "An auxiliary basis set built to be paired with the correlation-consistent quadruple-zeta orbital basis in resolution-of-identity or density fitting calculations. It carries the extra functions that fitting products of the larger orbital basis requires. Its purpose is speed, not accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000531 "cc-pVQZ-RI"@en)
SubClassOf(obo:MOLSIM_000531 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000532 (cc-pV5Z-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000532 "An auxiliary basis set built to be paired with the correlation-consistent quintuple-zeta orbital basis in resolution-of-identity or density fitting calculations. It is not used to represent orbitals; it approximates products of them so that integrals can be evaluated faster. Without it, calculations at that orbital basis size are often impractical. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000532 "cc-pV5Z-RI"@en)
SubClassOf(obo:MOLSIM_000532 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000533 (cc-pV6Z-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000533 "An auxiliary basis set built to be paired with the correlation-consistent sextuple-zeta orbital basis in resolution-of-identity or density fitting calculations. It approximates products of orbital basis functions rather than the orbitals themselves. It is what allows benchmark calculations at that orbital basis size to run at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000533 "cc-pV6Z-RI"@en)
SubClassOf(obo:MOLSIM_000533 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000534 (cc-pCVDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000534 "A correlation-consistent basis set at double-zeta level that adds tight functions, of large exponent, to describe correlation involving the core electrons. Standard valence sets assume the core is inert, which is a poor approximation for properties that depend on core-valence correlation. It is the smallest member of the family and the cheapest at which the effect can be seen at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000534 "cc-pCVDZ"@en)
SubClassOf(obo:MOLSIM_000534 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000535 (cc-pCVTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000535 "A correlation-consistent basis set at triple-zeta level that adds tight functions, of large exponent, to describe correlation involving the core electrons. Standard valence sets assume the core is inert, which is a poor approximation for properties that depend on core-valence correlation. It is the level at which core-valence correlation is usually first worth its cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000535 "cc-pCVTZ"@en)
SubClassOf(obo:MOLSIM_000535 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000536 (cc-pCVQZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000536 "A correlation-consistent basis set at quadruple-zeta level that adds tight functions, of large exponent, to describe correlation involving the core electrons. Standard valence sets assume the core is inert, which is a poor approximation for properties that depend on core-valence correlation. It is used for benchmark work where core-valence correlation must be converged rather than merely included. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000536 "cc-pCVQZ"@en)
SubClassOf(obo:MOLSIM_000536 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000537 (cc-pCV5Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000537 "A correlation-consistent basis set at quintuple-zeta level that adds tight functions describing correlation involving the core electrons, without diffuse functions. It is used for benchmark work where core-valence correlation must be converged. Its size restricts it to very small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000537 "cc-pCV5Z"@en)
SubClassOf(obo:MOLSIM_000537 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000538 (cc-pCV6Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000538 "A correlation-consistent basis set at sextuple-zeta level that adds tight functions describing correlation involving the core electrons, without diffuse functions. It is among the largest such sets in existence and approaches the complete basis set limit for the core-valence contribution. Its size restricts it to atoms and diatomic molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000538 "cc-pCV6Z"@en)
SubClassOf(obo:MOLSIM_000538 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000539 (cc-pV(D+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000539 "A correlation-consistent double-zeta basis set carrying 1 extra energy-optimised d type polarization function beyond the standard set. The extra function was added because the standard double-zeta set was found short of d functions for the second-row elements sodium to argon. For first-row elements it behaves like the ordinary double-zeta set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000539 "cc-pV(D+d)Z"@en)
SubClassOf(obo:MOLSIM_000539 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000540 (cc-pV(T+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000540 "A correlation-consistent triple-zeta basis set carrying 1 extra optimised d type polarization function beyond the standard set. It describes polarization and correlation for the second-row elements sodium to argon more completely than the ordinary triple-zeta set. For other elements the 2 are equivalent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000540 "cc-pV(T+d)Z"@en)
SubClassOf(obo:MOLSIM_000540 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000541 (cc-pV(Q+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000541 "A correlation-consistent quadruple-zeta basis set carrying 1 extra optimised d type polarization function beyond the standard set. It is used for benchmark-quality results on the second-row elements sodium to argon, where d function flexibility limits accuracy. For other elements the 2 are equivalent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000541 "cc-pV(Q+d)Z"@en)
SubClassOf(obo:MOLSIM_000541 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000542 (cc-pV(5+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000542 "A correlation-consistent quintuple-zeta basis set carrying 1 extra optimised d type polarization function beyond the standard set. It is used in high-level benchmark work on small molecules containing the second-row elements sodium to argon. For other elements the 2 are equivalent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000542 "cc-pV(5+d)Z"@en)
SubClassOf(obo:MOLSIM_000542 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000543 (cc-pV(6+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000543 "A correlation-consistent sextuple-zeta basis set carrying 1 extra optimised d type polarization function beyond the standard set. It is a highly specialised set for work on the second-row elements sodium to argon near the complete basis set limit. For other elements the 2 are equivalent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000543 "cc-pV(6+d)Z"@en)
SubClassOf(obo:MOLSIM_000543 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000544 (aug-cc-pVDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000544 "A correlation-consistent basis set giving 2 functions per valence orbital, with 1 diffuse function added at each angular momentum present. The diffuse functions matter for anions, weakly bound complexes and response properties. It is the smallest basis set at which such properties can be attempted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000544 "aug-cc-pVDZ"@en)
SubClassOf(obo:MOLSIM_000544 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000545 (aug-cc-pVTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000545 "A correlation-consistent basis set giving 3 functions per valence orbital, with a set of diffuse functions added. It is the usual working choice where both correlation and diffuse character matter. It is large enough to be trusted and small enough for molecules of a few dozen atoms. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000545 "aug-cc-pVTZ"@en)
SubClassOf(obo:MOLSIM_000545 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000546 (aug-cc-pVQZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000546 "A correlation-consistent basis set giving 4 functions per valence orbital with a set of diffuse functions added at each angular momentum. The diffuse functions matter for anions, weakly bound complexes and response properties. It is a common point in an extrapolation towards the complete basis set limit. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000546 "aug-cc-pVQZ"@en)
SubClassOf(obo:MOLSIM_000546 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000547 (aug-cc-pV5Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000547 "A correlation-consistent basis set that gives 5 functions per valence orbital and adds a set of diffuse functions. The diffuse functions matter when electron density reaches far from the nuclei, as in an anion or a weakly bound complex. It is a benchmark-level set and its cost limits it to very small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000547 "aug-cc-pV5Z"@en)
SubClassOf(obo:MOLSIM_000547 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000548 (aug-cc-pV6Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000548 "A correlation-consistent basis set that gives 6 functions per valence orbital and adds a set of diffuse functions. It is one of the largest standard augmented sets available. It is used to study convergence, or for properties that need extreme accuracy in both correlation and diffuse electron density. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000548 "aug-cc-pV6Z"@en)
SubClassOf(obo:MOLSIM_000548 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000549 (aug-cc-pV8Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000549 "A correlation-consistent basis set that gives 8 functions per valence orbital and adds a set of diffuse functions. It is a research set used almost only on atoms and diatomic molecules, to study how properties sensitive to diffuse electrons converge. It is not usable for molecular calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000549 "aug-cc-pV8Z"@en)
SubClassOf(obo:MOLSIM_000549 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000550 (aug-cc-pV9Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000550 "A correlation-consistent basis set that gives 9 functions per valence orbital and adds a set of diffuse functions. Like the octuple-zeta version it is a research set for atoms and diatomic molecules only. It is not usable for molecular calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000550 "aug-cc-pV9Z"@en)
SubClassOf(obo:MOLSIM_000550 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000551 (aug-cc-pVDZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000551 "An auxiliary basis set built to be paired with the diffuse-augmented correlation-consistent double-zeta orbital basis in resolution-of-identity or density fitting calculations. It carries the extra functions needed to fit products involving the diffuse part of that basis. Pairing it with a different orbital basis degrades the approximation it was fitted for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000551 "aug-cc-pVDZ-RI"@en)
SubClassOf(obo:MOLSIM_000551 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000552 (aug-cc-pVTZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000552 "An auxiliary basis set built to be paired with the diffuse-augmented correlation-consistent triple-zeta orbital basis in resolution-of-identity or density fitting calculations. It carries the extra functions needed to fit products involving the diffuse part of that basis. Pairing it with a different orbital basis degrades the approximation it was fitted for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000552 "aug-cc-pVTZ-RI"@en)
SubClassOf(obo:MOLSIM_000552 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000553 (aug-cc-pVQZ-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000553 "An auxiliary basis set built to be paired with the diffuse-augmented correlation-consistent quadruple-zeta orbital basis in density fitting calculations. It carries the extra functions needed to fit products involving the diffuse part of that basis. Its purpose is speed, not accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000553 "aug-cc-pVQZ-RI"@en)
SubClassOf(obo:MOLSIM_000553 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000554 (aug-cc-pV5Z-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000554 "An auxiliary basis set built to be paired with the diffuse-augmented correlation-consistent quintuple-zeta orbital basis in resolution-of-identity or density fitting calculations. It carries the extra functions needed to fit products involving the diffuse part of that orbital basis. Its purpose is speed, not accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000554 "aug-cc-pV5Z-RI"@en)
SubClassOf(obo:MOLSIM_000554 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000555 (aug-cc-pV6Z-RI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000555 "An auxiliary basis set built to be paired with the diffuse-augmented correlation-consistent sextuple-zeta orbital basis in resolution-of-identity or density fitting calculations. It is required in practice, because calculations at that orbital basis size are otherwise not feasible. Its purpose is speed, not accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000555 "aug-cc-pV6Z-RI"@en)
SubClassOf(obo:MOLSIM_000555 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000556 (aug-cc-pCVDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000556 "A correlation-consistent basis set at double-zeta level that adds both diffuse functions and tight functions describing correlation involving the core electrons. Standard valence sets assume the core is inert, which fails for properties that depend on it. It is the smallest combination that carries both additions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000556 "aug-cc-pCVDZ"@en)
SubClassOf(obo:MOLSIM_000556 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000557 (aug-cc-pCVTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000557 "A correlation-consistent basis set at triple-zeta level that adds both diffuse functions and tight functions describing correlation involving the core electrons. Standard valence sets assume the core is inert, which fails for properties that depend on it. It is the usual working choice where a system needs diffuse character and core-valence correlation at once. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000557 "aug-cc-pCVTZ"@en)
SubClassOf(obo:MOLSIM_000557 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000558 (aug-cc-pCVQZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000558 "A correlation-consistent basis set at quadruple-zeta level that adds both diffuse functions and tight functions describing correlation involving the core electrons. Standard valence sets assume the core is inert, which fails for properties that depend on it. It is used where both effects must be converged rather than merely present. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000558 "aug-cc-pCVQZ"@en)
SubClassOf(obo:MOLSIM_000558 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000559 (aug-cc-pCV5Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000559 "A correlation-consistent basis set at quintuple-zeta level that adds both diffuse functions and tight functions describing correlation involving the core electrons. Standard valence sets assume the core is inert, which fails for properties that depend on it. It is a benchmark set whose cost restricts it to small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000559 "aug-cc-pCV5Z"@en)
SubClassOf(obo:MOLSIM_000559 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000560 (aug-cc-pCV6Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000560 "A correlation-consistent basis set at sextuple-zeta level that adds both diffuse functions and tight functions describing correlation involving the core electrons. Standard valence sets assume the core is inert, which fails for properties that depend on it. It is among the largest standard basis sets in existence and is confined to atoms and diatomic molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000560 "aug-cc-pCV6Z"@en)
SubClassOf(obo:MOLSIM_000560 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000561 (aug-cc-pV(D+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000561 "A correlation-consistent double-zeta basis set that adds both a set of diffuse functions and 1 extra optimised d type polarization function. It is meant for the second-row elements sodium to argon in situations that also need diffuse functions, such as anions and weakly bound complexes. It combines 2 separate corrections to the standard double-zeta set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000561 "aug-cc-pV(D+d)Z"@en)
SubClassOf(obo:MOLSIM_000561 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000562 (aug-cc-pV(T+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000562 "A correlation-consistent triple-zeta basis set that adds both a set of diffuse functions and 1 extra optimised d type polarization function. It targets the second-row elements sodium to argon where both diffuse electron density and d orbital flexibility matter, such as anions and intermolecular complexes. It is the triple-zeta member of that combined family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000562 "aug-cc-pV(T+d)Z"@en)
SubClassOf(obo:MOLSIM_000562 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000563 (aug-cc-pV(Q+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000563 "A correlation-consistent quadruple-zeta basis set that adds both a set of diffuse functions and 1 extra optimised d type polarization function. It is used for benchmark results on systems containing the second-row elements sodium to argon whose properties depend on both corrections. It is large enough that its use is restricted to small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000563 "aug-cc-pV(Q+d)Z"@en)
SubClassOf(obo:MOLSIM_000563 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000564 (aug-cc-pV(5+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000564 "A correlation-consistent quintuple-zeta basis set that adds both a set of diffuse functions and 1 extra optimised d type polarization function. It is a specialised benchmark set for the second-row elements sodium to argon in processes that also need diffuse functions. It is close to the complete basis set limit for those elements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000564 "aug-cc-pV(5+d)Z"@en)
SubClassOf(obo:MOLSIM_000564 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000565 (aug-cc-pV(6+d)Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000565 "A correlation-consistent sextuple-zeta basis set that adds both a set of diffuse functions and 1 extra optimised d type polarization function. It is among the largest combinations available and is used only for extreme benchmark work on very small systems containing the second-row elements sodium to argon. Both corrections apply to those elements alone. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000565 "aug-cc-pV(6+d)Z"@en)
SubClassOf(obo:MOLSIM_000565 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000566 (aug-cc-pwCVDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000566 "A correlation-consistent double-zeta basis set that adds diffuse functions together with tight functions weighted towards core-valence correlation. The weighting concentrates the added functions where core and valence electrons actually correlate, rather than describing the core itself. It suits a small system needing both diffuse character and core-valence correlation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000566 "aug-cc-pwCVDZ"@en)
SubClassOf(obo:MOLSIM_000566 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000567 (aug-cc-pwCVTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000567 "A correlation-consistent triple-zeta basis set that adds diffuse functions together with weighted core-valence correlating functions. It is the level at which core-valence effects are usually first worth their cost. Both additions are needed for properties sensitive to diffuse electrons in systems where the core cannot be treated as inert. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000567 "aug-cc-pwCVTZ"@en)
SubClassOf(obo:MOLSIM_000567 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000568 (aug-cc-pwCVQZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000568 "A correlation-consistent quadruple-zeta basis set that adds diffuse functions together with weighted core-valence correlating functions. It is used for high-accuracy work where both effects must be converged rather than merely present. Its size restricts it to small molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000568 "aug-cc-pwCVQZ"@en)
SubClassOf(obo:MOLSIM_000568 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000569 (aug-cc-pwCV5Z)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000569 "A correlation-consistent quintuple-zeta basis set that adds diffuse functions together with weighted core-valence correlating functions. It is a benchmark set used to approach the complete basis set limit. Its cost restricts it to atoms and very small molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000569 "aug-cc-pwCV5Z"@en)
SubClassOf(obo:MOLSIM_000569 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000570 (aug-pc-0)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000570 "A polarization-consistent basis set at the lowest level of the pc-n family, with diffuse functions added. The family is built so results improve smoothly as the level rises, which makes extrapolation to the limit reliable. This level is the starting point of that sequence rather than a basis for production work. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000570 "aug-pc-0"@en)
SubClassOf(obo:MOLSIM_000570 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000571 (aug-pc-1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000571 "A polarization-consistent basis set at the first level of the pc-n family, with diffuse functions added. The level corresponds roughly to polarized double-zeta quality. It is the smallest member of the family used for real calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000571 "aug-pc-1"@en)
SubClassOf(obo:MOLSIM_000571 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000572 (aug-pc-2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000572 "A polarization-consistent basis set at the second level of the pc-n family, with a set of diffuse functions added. The second level corresponds to polarized triple-zeta quality, and the family is built so that results converge smoothly as the level rises. The diffuse functions make it suitable for anions, intermolecular interactions and polarizabilities. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000572 "aug-pc-2"@en)
SubClassOf(obo:MOLSIM_000572 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000573 (aug-pc-3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000573 "A polarization-consistent basis set at the third level of the pc-n family, with a set of diffuse functions added. The third level corresponds to polarized quadruple-zeta quality. It is used where both high accuracy and a correct description of diffuse electron density are needed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000573 "aug-pc-3"@en)
SubClassOf(obo:MOLSIM_000573 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000574 (aug-pc-4)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000574 "A polarization-consistent basis set at the fourth level of the pc-n family, with a set of diffuse functions added. The fourth level corresponds to polarized quintuple-zeta quality and is the largest in common use in this family. It is a benchmark set for small systems whose properties depend on diffuse electrons. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000574 "aug-pc-4"@en)
SubClassOf(obo:MOLSIM_000574 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000575 (Ahlrichs Coulomb fitting)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000575 "An auxiliary basis set developed by the Ahlrichs group to fit the Coulomb part of the electron repulsion in a density fitting calculation. Fitting only the Coulomb term, rather than the whole 2-electron integral set, gives most of the speed-up at very little cost in accuracy. It is matched to the Karlsruhe orbital basis sets. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000575 "Ahlrichs Coulomb fitting"@en)
SubClassOf(obo:MOLSIM_000575 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000576 (Ahlrichs Polarization)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000576 "A set of polarization functions, of higher angular momentum than the atom occupies in its ground state, developed by the Ahlrichs group for the Karlsruhe basis sets. Polarization functions let the electron density distort away from atomic symmetry, which is what bonding requires. Without them a basis set cannot describe a bond angle correctly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000576 "Ahlrichs Polarization"@en)
SubClassOf(obo:MOLSIM_000576 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000577 (Ahlrichs pvDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000577 "A basis set from the Ahlrichs group giving 2 functions per valence orbital together with polarization functions. The polarization functions let the electron cloud distort away from atomic symmetry, which is what bonding requires and which the unpolarized member of the family cannot do. It is the smallest basis set in that family suitable for real calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000577 "Ahlrichs pvDZ"@en)
SubClassOf(obo:MOLSIM_000577 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000578 (Ahlrichs VDZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000578 "A basis set from the Ahlrichs group giving 2 functions per valence orbital and no polarization functions. Without polarization functions the electron cloud cannot distort away from atomic symmetry, so bond angles are poorly described. It is used as a starting point rather than for results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000578 "Ahlrichs VDZ"@en)
SubClassOf(obo:MOLSIM_000578 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000579 (Ahlrichs VTZ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000579 "A basis set from the Ahlrichs group giving 3 functions per valence orbital and no polarization functions. The extra valence function improves the radial description while leaving the angular one unchanged. Like its double-zeta counterpart it is normally used with polarization functions added. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000579 "Ahlrichs VTZ"@en)
SubClassOf(obo:MOLSIM_000579 obo:MOLSIM_000485)

# Class: obo:MOLSIM_000580 (plane-wave)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000580 "A type of quantum mechanics basis set consisting of periodic sine and cosine functions (waves) defined by their direction and wavelength. Plane waves are particularly well-suited for calculations on periodic systems like crystals or surfaces, often used in conjunction with Density Functional Theory and pseudopotentials. Their systematic improvability by increasing the number of waves (controlled by an energy cutoff) is a key advantage in solid-state simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000580 "plane-wave"@en)
SubClassOf(obo:MOLSIM_000580 obo:MOLSIM_000432)

# Class: obo:MOLSIM_000581 (real-space)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000581 "A method that represents electronic wavefunctions or densities as values on a grid of points in ordinary 3-dimensional space, rather than as coefficients of basis functions. Accuracy is then improved by making the grid finer, which is a single adjustable control. It parallelises well, because each point depends mostly on its neighbours. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000581 "real-space"@en)
SubClassOf(obo:MOLSIM_000581 obo:MOLSIM_000432)

# Class: obo:MOLSIM_000582 (intrinsic reaction coordinate analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000582 "A coordinate analysis technique that defines the reaction path as the minimum energy path connecting reactants and products through the transition state on the potential energy surface. This path follows the steepest descent direction (in terms of energy) down from the transition state towards both the reactant and product basins. It is considered a more rigorous definition of the reaction pathway at zero Kelvin. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000582 "intrinsic reaction coordinate analysis"@en)
SubClassOf(obo:MOLSIM_000582 obo:MOLSIM_000028)

# Class: obo:MOLSIM_000583 (intrinsic reaction coordinate maximum analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000583 "An analysis method that locates the highest point along the lowest-energy path joining reactant and product. That point is the transition state, and its height above the reactant is the reaction barrier. Finding it is what turns a computed path into a predicted rate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000583 "intrinsic reaction coordinate maximum analysis"@en)
SubClassOf(obo:MOLSIM_000583 obo:MOLSIM_000582)

# Class: obo:MOLSIM_000584 (surface analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000584 "A form of reaction analysis focused on characterizing the features of the potential energy surface (PES), which maps the system's energy as a function of its atomic coordinates. This analysis identifies critical points like energy minima (stable states), saddle points (transition states), and intersections between surfaces that govern molecular stability and reactivity. It helps visualize the energetic landscape explored during reactions or conformational changes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000584 "surface analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000584 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000584 obo:MOLSIM_000027)

# Class: obo:MOLSIM_000585 (conical intersection point analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000585 "A critical feature identified through surface analysis representing a point in molecular geometry where two electronic potential energy surfaces of the same spin-symmetry become degenerate (have the same energy). These points act as funnels facilitating rapid, non-adiabatic transitions between electronic states, crucial for understanding photochemical reactions and relaxation processes. Their location and properties dictate the efficiency and outcome of such electronic transitions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000585 "conical intersection point analysis"@en)
SubClassOf(obo:MOLSIM_000585 obo:MOLSIM_000584)

# Class: obo:MOLSIM_000586 (saddle analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000586 "A saddle point on a potential energy surface is a stationary point (where forces are zero) that corresponds to an energy maximum along one direction (the reaction pathway) and an energy minimum along all other directions. It represents the highest energy barrier that must be overcome during a chemical transformation. Locating saddle points is key to identifying transition states and calculating activation energies for reactions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000586 "saddle analysis"@en)
SubClassOf(obo:MOLSIM_000586 obo:MOLSIM_000584)

# Class: obo:MOLSIM_000587 (minimum crossing analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000587 "A minimum crossing point, often Minimum Energy Crossing Point (MECP), is the molecular geometry where two potential energy surfaces corresponding to different electronic spin states (e.g., singlet and triplet) intersect at the lowest possible energy. These points are crucial for understanding pathways of spin-forbidden reactions or intersystem crossing events. Locating MECPs helps analyze transitions between different spin manifolds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000587 "minimum crossing analysis"@en)
SubClassOf(obo:MOLSIM_000587 obo:MOLSIM_000584)

# Class: obo:MOLSIM_000588 (pathway analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000588 "A form of reaction analysis aimed at identifying and characterizing the sequence of intermediate states and transition states that connect reactants to products, effectively mapping the reaction pathway. This can involve exploring multiple possible routes, using algorithms to find minimum energy paths, or analyzing trajectories from reaction dynamics simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000588 "pathway analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000588 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000588 obo:MOLSIM_000027)

# Class: obo:MOLSIM_000589 (trace gradient extremal analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000589 "A specific computational technique sometimes used in pathway analysis to find reaction paths or other significant paths on a potential energy surface by following trajectories associated with gradient extremals. This approach can potentially identify pathways connecting different energy minima without necessarily locating the transition states first. It serves as an alternative method for exploring the connections within a complex energy landscape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000589 "trace gradient extremal analysis"@en)
SubClassOf(obo:MOLSIM_000589 obo:MOLSIM_000588)

# Class: obo:MOLSIM_000590 (plot data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000590 "A category for file formats designed to store numerical data in a specific structure that is easily parsed and read by graphing or plotting software (e.g., Grace, Gnuplot). These are structured data files typically containing columns of numbers and plotting directives."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000590 "plot data format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000590 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000590 obo:MOLSIM_000436)

# Class: obo:MOLSIM_000591 (agr format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000591 "A text-based data file format for the Grace/Xmgrace plotting program. It contains numerical data along with commands that specify the appearance of the graph, such as titles, labels, and colors. This format allows for the creation of complex, publication-quality plots. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000591 "agr format"@en)
SubClassOf(obo:MOLSIM_000591 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000592 (stripped topology format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000592 "A file format that represents a molecular system's topology after certain atoms, typically solvent or ions, have been removed. This format is created to simplify analysis by focusing only on the solute, while retaining the necessary parameter information for calculations. It is commonly used in post-processing steps like MM/PBSA free energy calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000592 "stripped topology format"@en)
SubClassOf(obo:MOLSIM_000592 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000593 (CPPTRAJ standard output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000593 "A text data format in which cpptraj writes time-series results by default, as columns of numbers with the frame or time in the first column and the calculated values in the rest. It is space-delimited and carries no header structure beyond a comment line, so plotting and analysis programs read it directly. Files are commonly given the extension .dat. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000593 "Typically with .dat extension, but could be using other file extension."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000593 "CPPTRAJ standard output format"@en)
SubClassOf(obo:MOLSIM_000593 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000594 (Gnuplot data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000594 "A data file format designed to be used with the Gnuplot plotting program. It typically consists of columns of numerical data in a simple text-based layout that Gnuplot can easily parse and visualize. This format is widely used for generating scientific graphs and plots from raw data. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000594 "gnu format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000594 "Gnuplot data format"@en)
SubClassOf(obo:MOLSIM_000594 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000595 (XPLOR format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000595 "A file format associated with the XPLOR-NIH software, used for representing 3D grid data. It is a text-based format that defines a grid and the data values at each point, often used for electron density maps. This format is a common way to store volumetric data in crystallography and NMR. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000595 "XPLOR format"@en)
SubClassOf(obo:MOLSIM_000595 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000596 (grid format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000596 "A file format for representing data that is distributed over a three-dimensional grid. Originating from the XPLOR-NIH software, it is used to store volumetric data like electron density or potential maps. This format is used in structural biology to visualize grid-based properties around a molecule."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000596 ".grid"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000596 "grid format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000596 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000596 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000597 (DX format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000597 "A file format for the OpenDX (Data Explorer) visualization program, used to represent 3D grid-based data. It stores scalar or vector data on a regular grid, making it suitable for visualizing properties like electrostatic potential or molecular density. This format is a common output for scientific programs that generate volumetric data. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000597 "OpenDX format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000597 "DX format"@en)
SubClassOf(obo:MOLSIM_000597 obo:MOLSIM_000590)

# Class: obo:MOLSIM_000598 (mdvel format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000598 "A data format that stores the velocity of every atom of a system at each saved step of an AMBER simulation. It records velocities where a trajectory format records positions. It is needed for analyses such as velocity autocorrelation that cannot be done from coordinates alone. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000598 "AMBER mdvel format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000598 "mdvel format"@en)
SubClassOf(obo:MOLSIM_000598 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000599 (AMBER REM log format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000599 "A log file format that records the progress of an Amber replica exchange molecular dynamics simulation. The main file extension for Amber REM (Replica Exchange Molecular Dynamics) log files is .log, typically named as rem.log, according to the Amber documentation and tutorial resources. This log file tracks exchanges, replica temperatures, and relevant statistics for the REMD process. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000599 "Amber Replica Exchange Log"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000599 "rem.log"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000599 "AMBER REM log format"@en)
SubClassOf(obo:MOLSIM_000599 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000600 (AMBER eigenvector format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000600 "A file format that holds the eigenvectors and eigenvalues produced by principal component analysis, normal mode analysis or quasiharmonic analysis in AMBER. The vectors come from diagonalising a covariance or mass-weighted covariance matrix, and are used in essential dynamics analysis of molecular simulations. There is no required extension: the file is usually called evecs.dat or evecs.out, and its layout is standardised so that AMBER tools such as cpptraj and ptraj can read and write it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000600 "evecs.dat"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000600 "evecs.out"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000600 "AMBER eigenvector format"@en)
SubClassOf(obo:MOLSIM_000600 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000601 (cpout format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000601 "An output file format produced during constant pH molecular dynamics in AMBER, holding pH-dependent state changes, lambda values, protonation fractions and statistics for titratable groups. These files are produced as a result of the simulation or post-simulation analysis, not used to initiate or restart simulations. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000601 ".cpout")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000601 "AMBER cpout format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000601 "cpout format"@en)
SubClassOf(obo:MOLSIM_000601 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000602 (geometry optimization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000602 "A computational procedure within structural analysis used to find the atomic coordinates corresponding to a stationary point, typically a local minimum, on the potential energy surface, representing a stable or equilibrium structure. Starting from an initial guess geometry, algorithms iteratively adjust atomic positions to minimize the energy and reduce the forces acting on the atoms until convergence criteria are met. This predicts the most stable three-dimensional structure for a given molecular composition and electronic state. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000602 "geometry optimization analysis"@en)
SubClassOf(obo:MOLSIM_000602 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000603 (FMO geometry optimization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000603 "A specific geometry optimization technique designed for large molecular systems that employs the Fragment Molecular Orbital (FMO) method. The FMO method divides the large system (like a protein or DNA segment) into smaller, manageable fragments, performs quantum mechanical calculations on fragments and fragment pairs, and combines the results to approximate the properties (energy, gradient) of the entire system. This fragmentation allows for efficient geometry optimization of very large biomolecules at a quantum mechanical level. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000603 "FMO geometry optimization analysis"@en)
SubClassOf(obo:MOLSIM_000603 obo:MOLSIM_000602)

# Class: obo:MOLSIM_000604 (single point energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000604 "An energy analysis calculation that determines the potential energy of a molecular system for a single, fixed geometric arrangement of its atoms (a specific 'snapshot' or structure), without performing geometry optimization or simulating dynamics. This provides the energy value for that particular conformation according to the chosen theoretical method (e.g., force field or quantum mechanical level). It's often used to compare the relative energies of different pre-defined structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000604 "single point energy analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000604 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000604 obo:MOLSIM_000950)

# Class: obo:MOLSIM_000605 (high accuracy energies analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000605 "A data analysis method that computes potential energies with a high-level and computationally expensive treatment, such as coupled cluster theory or density functional theory with a large basis set. It is applied to a few chosen structures, typically optimised minima, transition states or representative conformations, rather than to a whole trajectory. The values serve as benchmarks for reaction barriers, binding energies and conformational stabilities obtained more cheaply. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000605 "high accuracy energies analysis"@en)
SubClassOf(obo:MOLSIM_000605 obo:MOLSIM_000950)

# Class: obo:MOLSIM_000606 (energy decomposition analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000606 "An energy analysis technique designed to partition the total interaction energy between two or more interacting molecular fragments (e.g., in a complex) into physically meaningful components based on the underlying quantum mechanical or molecular mechanical framework. Common components include electrostatics, exchange-repulsion (Pauli repulsion), polarization (induction), and charge transfer (or dispersion in some schemes), providing insights into the nature of the forces driving the interaction. Different EDA schemes exist (e.g., Morokuma, SAPT, FMO-EDA). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000606 "energy decomposition analysis"@en)
SubClassOf(obo:MOLSIM_000606 obo:MOLSIM_000950)

# Class: obo:MOLSIM_000607 (force analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000607 "A structural analysis technique that involves calculating the forces acting on each atom for a given molecular configuration. These forces represent the negative gradient of the potential energy and indicate the direction and magnitude of the tendency for atoms to move to lower the system's energy. Analyzing forces is crucial for geometry optimization (where forces are minimized), understanding structural strain, and driving molecular dynamics simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000607 "force analysis"@en)
SubClassOf(obo:MOLSIM_000607 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000608 (CCP4 map format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000608 "A binary data format that stores 3-dimensional volumetric data on a regular grid, most often electron density from X-ray crystallography or a map from cryogenic electron microscopy. It is the format structural biology tools read and write by default for such maps. It lets the shape of a protein or nucleic acid be seen and interpreted. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000608 ".ccp4")
AnnotationAssertion(rdfs:label obo:MOLSIM_000608 "CCP4 map format"@en)
SubClassOf(obo:MOLSIM_000608 obo:MOLSIM_000909)

# Class: obo:MOLSIM_000609 (cmatrix format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000609 "A binary file format that stores pre-calculated pairwise distances between structures. It has no mandatory extension, but .cmatrix is the conventional one. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000609 ".cmatrix")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000609 "CPPTRAJ pairwise distance cache format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000609 "cmatrix format"@en)
SubClassOf(obo:MOLSIM_000609 obo:MOLSIM_010020)

# Class: obo:MOLSIM_000610 (thermodynamics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000610 "A type of analysis, often performed using data from simulations or specialized calculations complementary to MD, focused on determining the thermodynamic properties governing molecular systems. This includes calculating state functions like enthalpy, entropy, and particularly free energy, which dictate stability, equilibrium constants, and the spontaneity of molecular processes. Such analysis provides insights into the energetic driving forces behind biomolecular behavior. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000610 "thermodynamics analysis"@en)
SubClassOf(obo:MOLSIM_000610 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000611 (thermal property analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000611 "A subset of thermodynamics analysis specifically dealing with how a system's properties change with temperature or involve heat exchange. This includes calculating quantities like heat capacity (how much energy is needed to raise the temperature), coefficients of thermal expansion, or enthalpy changes associated with specific processes. These properties are important for understanding temperature dependence and energy balance in molecular systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000611 "thermal property analysis"@en)
SubClassOf(obo:MOLSIM_000611 obo:MOLSIM_000610)

# Class: obo:MOLSIM_000612 (thermochemical analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000612 "A specific type of thermal properties analysis focused on quantifying the heat absorbed or released during chemical reactions or phase transitions, often involving the calculation of enthalpies of formation, reaction enthalpies, or activation enthalpies. Typically employing quantum mechanical methods or specialized simulation setups, this analysis provides fundamental data on the energetics of chemical transformations. It helps predict reaction feasibility and energy output/input. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000612 "thermochemical analysis"@en)
SubClassOf(obo:MOLSIM_000612 obo:MOLSIM_000611)

# Class: obo:MOLSIM_000613 (prep format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000613 "A text data format used by AMBER to define a new molecular building block, giving its atoms, their types and charges, the bonds between them and its geometry. It is how a residue that no standard library contains is introduced. It is written by the parameter assignment tools rather than by hand. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000613 ".prep")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000613 ".prepi")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000613 "AMBER prep format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000613 "prep format"@en)
SubClassOf(obo:MOLSIM_000613 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000614 (OFF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000614 "A text data format used by AMBER to store a library of molecular building blocks together with their force field parameters and geometry. Unlike the prep format, which defines one block, a single file holds many. It is the format the standard residue libraries are distributed in. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000614 ".off"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000614 "AMBER Object File Format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000614 "AMBER off format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000614 "AMBER lib format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000614 "OFF format"@en)
SubClassOf(obo:MOLSIM_000614 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000615 (free energy calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000615 "A thermodynamics analysis method that computes the free energy of a system, or more often the free energy difference between 2 states such as bound and unbound or folded and unfolded. Free energy combines energy and disorder, so it, rather than energy alone, decides which state a process settles into. Obtaining it usually needs enhanced sampling, because the states of interest are separated by barriers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000615 "free energy calculation analysis"@en)
SubClassOf(obo:MOLSIM_000615 obo:MOLSIM_000610)

# Class: obo:MOLSIM_000616 (free state FMO analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000616 "A specific computational task within a free energy calculation framework that uses the Fragment Molecular Orbital (FMO) method to determine the energy and properties of a molecule in its unbound ('free') state. This is often required when calculating binding free energies, where the energy of the isolated components serves as a reference point (G free). Employing FMO makes such quantum mechanical calculations feasible for the large molecules often involved in biomolecular binding events. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000616 "free state FMO analysis"@en)
SubClassOf(obo:MOLSIM_000616 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000617 (Gaussian fluctuation free energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000617 "A free energy analysis method that estimates free energy differences by assuming the system's fluctuations about its average state follow a multi-dimensional Gaussian distribution. That assumption reduces the calculation to the mean and covariance of the sampled coordinates, which is cheap. Its accuracy depends entirely on how well the assumption holds for the system in question. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000617 "Gaussian fluctuation free energy analysis"@en)
SubClassOf(obo:MOLSIM_000617 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000618 (PC+ correction analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000618 "A free energy analysis method that adjusts a computed binding free energy using an empirical term based on the number and kind of charged atoms at the interface. It exists because continuum solvent models systematically misjudge the cost of desolvating charged groups. It is applied after the main calculation rather than inside it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000618 "PC+ correction analysis"@en)
SubClassOf(obo:MOLSIM_000618 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000619 (universal correction analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000619 "A free energy analysis method that adds a fixed entropic penalty to a computed binding free energy to represent the translational and rotational freedom a ligand loses on binding. The penalty is taken from prior work rather than computed for the system at hand. It supplies a term that end-point methods otherwise omit entirely. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000619 "UC Correction"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000619 "universal correction analysis"@en)
SubClassOf(obo:MOLSIM_000619 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000620 (density-functional based tight-binding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000620 "A semi-empirical quantum method derived from density functional theory by expanding its energy about a reference density and tabulating the resulting integrals in advance. Tabulating them removes almost all the cost while keeping a quantum description. It is 2 to 3 orders of magnitude faster than the theory it comes from. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000620 "DFTB"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000620 "density-functional based tight-binding"@en)
SubClassOf(obo:MOLSIM_000620 obo:MOLSIM_000803)

# Class: obo:MOLSIM_000621 (self-consistent-charge density-functional based tight-binding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000621 "A tight binding method that solves for the atomic charges self-consistently, so each atom's charge responds to the others rather than being fixed. Adding that step corrects the description of polar and charged systems, which the non-self-consistent form handles badly. It is the form nearly all current tight binding work uses. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000621 "SCC-DFTB"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000621 "self-consistent-charge density-functional based tight-binding"@en)
SubClassOf(obo:MOLSIM_000621 obo:MOLSIM_000620)

# Class: obo:MOLSIM_000622 (third-order self-consistent-charge density-functional based tight-binding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000622 "A tight binding method that carries the expansion of the energy one order further than the self-consistent charge form, adding a term for how an atom's response to charge itself changes with charge. That term corrects the description of charged and hydrogen-bonded systems, which the lower order handles poorly. It is the form recommended for biomolecular work. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000622 "DFTB3"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000622 "third-order self-consistent-charge density-functional based tight-binding"@en)
SubClassOf(obo:MOLSIM_000622 obo:MOLSIM_000621)

# Class: obo:MOLSIM_000623 (quantum interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000623 "An interaction that cannot be described correctly without quantum mechanics, because it depends on the wave nature of electrons or on energy taking discrete values. Bond formation, charge transfer and dispersion are all of this kind. A classical force field represents their effects approximately with fitted terms rather than describing them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000623 "quantum interaction"@en)
SubClassOf(obo:MOLSIM_000623 obo:MOLSIM_000057)

# Class: obo:MOLSIM_000624 (hyperfine coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000624 "A quantum mechanical interaction representing the coupling between the magnetic moment associated with the spin of an electron and the magnetic moment of a nearby atomic nucleus. This interaction leads to small shifts and splittings ('hyperfine structure') in atomic and molecular energy levels, which are observable in high-resolution spectroscopy, particularly Electron Paramagnetic Resonance (EPR) for species with unpaired electrons, and also in NMR. It provides valuable information about the electron distribution (spin density) near the nucleus and thus molecular structure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000624 "hyperfine coupling"@en)
SubClassOf(obo:MOLSIM_000624 obo:MOLSIM_000626)
DisjointClasses(obo:MOLSIM_000624 obo:MOLSIM_000625)

# Class: obo:MOLSIM_000625 (spin-orbit coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000625 "A relativistic quantum mechanical interaction between a particle's intrinsic spin angular momentum and its orbital angular momentum (due to its motion, e.g., an electron orbiting a nucleus). This coupling mixes electronic states and becomes increasingly significant for electrons in atoms with high atomic number (heavy atoms). Spin-orbit coupling influences electronic energy levels, causes splitting of spectral lines (fine structure), and facilitates transitions between states of different spin multiplicity (e.g., intersystem crossing in photochemistry, important for phosphorescence). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000625 "spin-orbit coupling"@en)
SubClassOf(obo:MOLSIM_000625 obo:MOLSIM_000626)

# Class: obo:MOLSIM_000626 (spin effect)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000626 "A physical effect arising from the intrinsic angular momentum carried by electrons and atomic nuclei. Spin gives each particle a magnetic moment, and the interactions between those moments are what produce magnetic resonance signals and fine structure in spectra. A calculation that ignores spin cannot reproduce them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000626 "spin effect"@en)
SubClassOf(obo:MOLSIM_000626 obo:MOLSIM_000623)

# Class: obo:MOLSIM_000627 (density functional theory)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000627 "A quantum mechanical method that obtains the energy and other properties of a system from its electron density rather than from the many-electron wavefunction. The density depends on 3 spatial coordinates however many electrons there are, which is what makes the method affordable for large systems. Its accuracy rests on the approximate functional chosen to relate density to energy. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000627 "DFT"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000627 "density functional theory"@en)
SubClassOf(obo:MOLSIM_000627 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000628 (electrostatic embedding QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000628 "A QM/MM scheme in which the partial charges of the classical region enter the quantum calculation directly, so the quantum region's electron distribution responds to its surroundings. That response is what captures how a protein environment alters the chemistry inside an active site. It costs more than the mechanical scheme and is markedly more accurate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000628 "electrostatic embedding QM/MM"@en)
SubClassOf(obo:MOLSIM_000628 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000629 (QM/MM Ewald summation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000629 "An Ewald summation method for a periodic system in which part is described quantum mechanically and the rest by a force field. It must handle 3 kinds of interaction: within the quantum region, within the classical region, and between them. Getting the third right is what distinguishes it, because the 2 descriptions represent charge differently. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000629 "Ewald for QM/MM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000629 "QM/MM Ewald summation"@en)
SubClassOf(obo:MOLSIM_000629 obo:MOLSIM_000428)

# Class: obo:MOLSIM_000630 (multilayer QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000630 "A QM/MM method using more than 2 levels of description, such as an expensive quantum method for a reacting group, a cheaper quantum method around it, and a force field beyond that. Each boundary must be handled separately, so the arrangement is more delicate than a 2-level one. It is used where the reacting region is small but its immediate surroundings still need quantum treatment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000630 "multilayer QM/MM"@en)
SubClassOf(obo:MOLSIM_000630 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000631 (difference-based adaptive solvation QM/MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000631 "A QM/MM method that lets solvent molecules move between the quantum and the classical region during a simulation, deciding the boundary from the difference in energy between the 2 descriptions. Solvent near a reacting centre is therefore treated quantum mechanically only while it is near. A fixed boundary would either trap the wrong molecules inside or cut bonds as they diffuse across it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000631 "difference-based adaptive solvation QM/MM"@en)
SubClassOf(obo:MOLSIM_000631 obo:MOLSIM_000484)

# Class: obo:MOLSIM_000632 (adaptive buffered force-mixing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000632 "A QM/MM method in which the boundary moves as the simulation proceeds, with a buffer zone where forces from the quantum and classical descriptions are blended. The blending prevents the jump in force that an abrupt reassignment would cause as a molecule crosses. It is what lets solvent diffuse in and out of a quantum region during a run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000632 "adaptive buffered force-mixing"@en)
SubClassOf(obo:MOLSIM_000632 obo:MOLSIM_000388)

# Class: obo:MOLSIM_000633 (surface potential analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000633 "A structural analysis method that computes a field, most often the electrostatic potential, and displays it on the surface of a molecule. Colouring the surface by potential shows at a glance which regions would attract a positive or a negative partner. It is how electrostatic complementarity between 2 binding partners is judged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000633 "surface potential analysis"@en)
SubClassOf(obo:MOLSIM_000633 obo:MOLSIM_000584)

# Class: obo:MOLSIM_000634 (electrostatic potential calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000634 "An analysis method that computes the electrostatic potential a molecule's charge distribution produces at points around it. Mapped onto the molecular surface, it shows where an approaching charge would be attracted or repelled. It is how a binding site is judged to be electrostatically complementary to a ligand. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000634 "electrostatic potential calculation analysis"@en)
SubClassOf(obo:MOLSIM_000634 obo:MOLSIM_000633)

# Class: obo:MOLSIM_000635 (frequency analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000635 "An analysis method, typically based on quantum mechanics or molecular mechanics, used to calculate the vibrational frequencies and corresponding normal modes (patterns of atomic motion) of a molecule, usually performed at a stationary point on the potential energy surface (like an energy minimum or transition state). These frequencies can be compared to experimental vibrational spectra (e.g., IR, Raman) to validate the structure or force field. The analysis also helps confirm the nature of the stationary point (minimums have all real frequencies, transition states have one imaginary frequency). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000635 "frequency analysis"@en)
SubClassOf(obo:MOLSIM_000635 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000636 (anharmonic vibrational corrections analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000636 "A refinement within frequency analysis that goes beyond the standard harmonic approximation (which assumes vibrations occur in a perfectly parabolic potential well) to account for the true, anharmonic shape of the potential energy surface. Calculating these corrections yields more accurate vibrational frequencies that better match experimental observations, particularly for large-amplitude motions or systems with significant vibrational coupling. This improves the quantitative interpretation of vibrational spectra and thermodynamic properties derived from frequencies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000636 "anharmonic vibrational corrections analysis"@en)
SubClassOf(obo:MOLSIM_000636 obo:MOLSIM_000635)

# Class: obo:MOLSIM_000637 (semi-empirical Born-Oppenheimer molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000637 "A simulation method in which the forces at each step come from a fast approximate quantum mechanical calculation, solved fully at each new geometry. Being quantum, it can describe bonds being made and broken, which a force field cannot. Being approximate, it is fast enough to run for a useful length of time. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000637 "SEBOMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000637 "semi-empirical Born-Oppenheimer molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000637 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000638 (hybrid ReaxFF/AMBER molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000638 "A simulation method combining a reactive force field for the region where bonds form and break with a conventional force field for everything else. The reactive treatment costs far more, so confining it to a small region makes a large system affordable. The boundary between the 2 must be placed where no bond will cross it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000638 "hybrid ReaxFF/AMBER molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000638 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000639 (polarizable force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000639 "A force field that represents how a molecule's charge distribution is distorted by the electric field around it, rather than fixing the charges in advance. It matters where the environment changes markedly, as when a ligand moves from water into a protein interior. It costs several times more, because the induced response must be solved for at every step. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000639 "fluctuating charge model"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000639 "polarizable force field"@en)
SubClassOf(obo:MOLSIM_000639 obo:MOLSIM_000007)

# Class: obo:MOLSIM_000640 (polarizable Gaussian multipole force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000640 "A polarizable force field in which each atom carries a multipole expansion built from Gaussian-shaped charge distributions, and responds to the field around it. Using distributed shapes rather than points lets the model describe how charge density overlaps between close atoms. It targets the short-range region where point-charge models are least reliable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000640 "polarizable Gaussian multipole force field"@en)
SubClassOf(obo:MOLSIM_000640 obo:MOLSIM_000639)

# Class: obo:MOLSIM_000641 (empirical dispersion correction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000641 "A correction added to a quantum chemistry calculation to supply the weak long-range attraction that most density functionals omit. The functionals fail here because the attraction arises from correlated fluctuations they do not describe. The correction is a fitted term depending on the atoms and their separation, and it is what makes density functional theory usable for stacking and binding. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000641 "D3 dispersion model"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000641 "grimme dispersion correction"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000641 "empirical dispersion correction"@en)
SubClassOf(obo:MOLSIM_000641 obo:MOLSIM_001463)

# Class: obo:MOLSIM_000642 (Gaussian-shaped constraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000642 "A Gaussian-shaped constraint simulation is a type of restrained simulation where the artificial potential used to guide the system has the mathematical form of a Gaussian function. This provides a smooth, harmonic-like restraint near the target value but becomes weaker further away."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000642 "Gaussian-shaped constraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000642 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000642 obo:MOLSIM_000364)

# Class: obo:MOLSIM_000643 (Lorentz-Berthelot mixing modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000643 "A rule for obtaining the van der Waals parameters between 2 different atom types from the parameters of each alone, averaging their sizes and taking the geometric mean of their interaction strengths. Without such a rule every pair of atom types would need its own fitted parameters. The rule is a convenience rather than physics, which is why some pairs need an explicit override. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000643 "Lorentz-Berthelot mixing modeling"@en)
SubClassOf(obo:MOLSIM_000643 obo:MOLSIM_000374)

# Class: obo:MOLSIM_000644 (HF/6-31G RESP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000644 "A protocol for deriving atomic charges in which the electrostatic potential is computed at the Hartree-Fock level with the 6-31G* basis set, then point charges are fitted to it with a restraint pulling buried charges towards zero. That combination is not the most accurate available; it is used because it systematically overestimates polarity by about the amount a simulation in fixed-charge water requires. It is the convention the AMBER force fields were built on, so charges for a new molecule must follow it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000644 "HF/6-31G RESP"@en)
SubClassOf(obo:MOLSIM_000644 obo:MOLSIM_000204)

# Class: obo:MOLSIM_000645 (SIRAH force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000645 "A coarse-grained force field for proteins and nucleic acids whose beads are chosen to preserve the chemical character and the directionality of interactions such as hydrogen bonds. It keeps more chemical detail than a purely shape-based mapping, at a higher cost. It can be combined with explicit coarse-grained water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000645 "SIRAH force field"@en)
SubClassOf(obo:MOLSIM_000645 obo:MOLSIM_000736)

# Class: obo:MOLSIM_000646 (empirical metal center parameterization modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000646 "An empirical metal center parameterization is a method for deriving force field parameters for a metal ion and its coordination site by fitting them to reproduce experimental data. This can include data such as crystal structures, vibrational frequencies, or binding energies for a set of known metal complexes. For experts, this approach is often necessary for metal ions because standard, general-purpose parameterization methods can fail to capture their complex electronic and bonding behavior. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000646 "empirical metal center parameterization modeling"@en)
SubClassOf(obo:MOLSIM_000646 obo:MOLSIM_000374)

# Class: obo:MOLSIM_000647 (hybrid solvent MM-PBSA analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000647 "A free energy analysis method that estimates binding free energy using explicit water molecules near the solute and a continuum model for the bulk. It keeps the specific water-mediated contacts that a continuum model cannot represent, while avoiding the cost of explicit solvent everywhere. The energies are then combined in the usual molecular mechanics Poisson-Boltzmann surface area way. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000647 "hybrid solvent MM-PBSA analysis"@en)
SubClassOf(obo:MOLSIM_000647 obo:MOLSIM_000262)

# Class: obo:MOLSIM_000648 (BAR/PBSA analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000648 "A free energy analysis method that combines the Bennett acceptance ratio estimator with the molecular mechanics Poisson-Boltzmann surface area treatment of solvation. It aims to keep the rigour of an alchemical estimator where it matters most while using a continuum model for the rest. The division between the 2 parts is what distinguishes it from either method alone. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000648 "BAR/PBSA analysis"@en)
SubClassOf(obo:MOLSIM_000648 obo:MOLSIM_000615)

# Class: obo:MOLSIM_000649 (kinetic map analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000649 "Kinetic map analysis is a method used to visualize the network of transitions between different conformational states that a molecule visits during a simulation. It represents the molecular states as nodes and the transitions between them as connections, often colored or weighted by their probability or rate. This provides a clear and intuitive map of the dominant pathways for conformational change, helping to understand the mechanism and timescales of processes like ligand binding or protein folding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000649 "kinetic map analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000649 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000649 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000650 (commute map analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000650 "Commute map analysis is a method used to identify how different parts of a molecule are dynamically connected, even if they are far apart. It transforms complex molecular coordinates into a mathematical space where the Euclidean distance between points directly corresponds to the commute time (the mean time it takes for a molecule to transition between two conformations and back). This analysis helps to uncover long-range communication networks within a protein that are essential for its function, such as in allosteric regulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000650 "commute map analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000650 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000650 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000651 (entropic decomposition analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000651 "A thermodynamics analysis method that splits the total entropy change of a process into separate contributions. The split may be by kind of motion, into translational, rotational and vibrational parts, or by component, into solute and solvent. It shows which source of disorder drives a process, for example whether binding is favoured by the release of ordered water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000651 "entropic decomposition analysis"@en)
SubClassOf(obo:MOLSIM_000651 obo:MOLSIM_000309)

# Class: obo:MOLSIM_000652 (molecular reconstruction from distribution functions analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000652 "An advanced analysis method that attempts to generate a three-dimensional model of a molecule or a molecular complex using statistical information about its structure. It takes one or more distribution functions, such as the pairwise distances between atoms obtained from a simulation or experiment, and uses an optimization algorithm to find a 3D structure that is consistent with those distributions. This technique can be used to build structural models from sparse or low-resolution data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000652 "molecular reconstruction from distribution functions analysis"@en)
SubClassOf(obo:MOLSIM_000652 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000653 (polar decomposition analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000653 "A structural analysis method that separates the change in shape of a group of atoms between 2 conformations into a pure rotation and an internal deformation. It does this by factorising the matrix that maps one set of coordinates onto the other. It answers whether a domain has turned as a rigid body or genuinely changed shape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000653 "polar decomposition analysis"@en)
SubClassOf(obo:MOLSIM_000653 obo:MOLSIM_000610)

# Class: obo:MOLSIM_000654 (path integral molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000654 "A simulation method that includes quantum behaviour of the atomic nuclei themselves, by replacing each nucleus with a ring of connected copies. The spread of the ring represents the uncertainty in the particle's position, which is large for light atoms. It matters for hydrogen, where treating the nucleus as a point misplaces bond lengths and reaction barriers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000654 "path integral molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000654 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000655 (replica-exchange free energy perturbation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000655 "Replica-exchange free energy perturbation is an enhanced sampling method that combines replica-exchange with an alchemical free energy calculation. It runs multiple simulations in parallel, each at a different intermediate state (lambda value) of the alchemical transformation, and periodically attempts to swap the lambda values between replicas."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000655 "replica-exchange free energy perturbation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000655 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000655 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000656 (constant redox potential molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000656 "A simulation method in which groups can gain or lose an electron during the run, coupled to a chosen electrode potential. It is the redox counterpart of constant pH simulation and uses the same machinery. It is used for proteins whose function involves moving electrons, where the oxidation state is not fixed in advance. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000656 "constant redox potential molecular dynamics"@en)
SubClassOf(obo:MOLSIM_000656 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000657 (X-ray refinement)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000657 "X-ray refinement is the computational process of building and optimizing an atomic model of a molecule to fit the experimental data from an X-ray crystallography experiment. It is an iterative procedure where the atomic coordinates are adjusted to best match the calculated electron density map, while simultaneously ensuring that the model has realistic chemical geometry, such as proper bond lengths and angles. This process is the final and crucial step in determining a high-resolution crystal structure."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000657 "X-ray refinement"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000657 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000657 obo:MOLSIM_000201)

# Class: obo:MOLSIM_000658 (grid binning analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000658 "A structural analysis method that divides the simulation box into a regular 3-dimensional grid of cells and counts how often atoms of a chosen type fall in each cell across a trajectory. The counts give the average spatial density of those atoms. It is the usual way to map where water or ions gather around a solute. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000658 "grid binning analysis"@en)
SubClassOf(obo:MOLSIM_000658 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000659 (periodic boundary imaging)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000659 "A fundamental trajectory post-processing step used to correct the visual representation of molecules in a periodic system. When a molecule crosses a periodic boundary, it can appear 'broken' or jump across the box in the raw output. This procedure translates the atomic coordinates back into the primary simulation box, implicitly fixing broken 'image bonds' to ensure target molecules remain whole and centered. This is a mandatory prerequisite for correct visualization and accurate calculation of some structural properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000659 "periodic boundary imaging"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000659 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000659 obo:MOLSIM_001767)

# Class: obo:MOLSIM_000660 (LES trajectory splitting analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000660 "A trajectory processing method that separates the single combined trajectory written by a locally enhanced sampling run into 1 trajectory per copy of the duplicated region. Locally enhanced sampling simulates several copies of one part of a molecule at once, and their coordinates are interleaved in the output. Splitting them is required before each copy can be analysed or the copies averaged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000660 "LES trajectory splitting analysis"@en)
SubClassOf(obo:MOLSIM_000660 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000661 (structure modification modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000661 "A structure modification method is a computational procedure that alters the atomic coordinates or composition of a molecular structure file. This includes a wide range of operations such as adding or deleting atoms, rotating or translating molecules, or building new polymeric chains. For researchers, these methods are the fundamental tools used to build, edit, and prepare molecular models for simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000661 "structure modification modeling"@en)
SubClassOf(obo:MOLSIM_000661 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000662 (ion randomization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000662 "An ion randomization method is a procedure for placing ions in a simulation box by randomly swapping their positions with existing solvent molecules. This is often done after an initial, simpler placement to ensure the ions are well-distributed throughout the solvent. This method helps to create a more disordered and realistic initial distribution of ions, avoiding potential artifacts from placing them in a regular grid."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000662 "ion randomization analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000662 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000662 obo:MOLSIM_000329)

# Class: obo:MOLSIM_000663 (cell replication analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000663 "A cell replication method is a procedure used in system setup to create a larger system, known as a supercell, by duplicating the original simulation unit cell in one or more dimensions. This is commonly used in materials science simulations to model bulk crystals or surfaces from a smaller repeating unit. For experts, this method is the standard way to construct a periodic system that is large enough to minimize finite-size artifacts. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000663 "cell replication analysis"@en)
SubClassOf(obo:MOLSIM_000663 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000664 (coordinate scaling modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000664 "A coordinate scaling method is a structure modification method that multiplies all the atomic coordinates in a system by a specific scaling factor. This is used to uniformly expand or contract the entire system. For experts, this can be a step in adjusting the density of a system or in some barostat algorithms that control pressure by scaling the box and the coordinates within it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000664 "coordinate scaling modeling"@en)
SubClassOf(obo:MOLSIM_000664 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000665 (velocity assignment analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000665 "A velocity assignment method is the procedure used to give atoms their initial speeds and directions at the beginning of a molecular dynamics simulation. These velocities are typically chosen from a random distribution, such as the Maxwell-Boltzmann distribution, that corresponds to the desired starting temperature of the system. For experts, this step is crucial for initiating the thermal motion of the system before the equilibration phase. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000665 "velocity assignment analysis"@en)
SubClassOf(obo:MOLSIM_000665 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000666 (volumetric map generation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000666 "An analysis method that computes a value at every point of a 3-dimensional grid covering a region of a simulation. The values may be how often solvent is found at each point, or the electrostatic potential there. The result is a map that can be viewed as a surface or a cloud rather than read as a number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000666 "volumetric map generation analysis"@en)
SubClassOf(obo:MOLSIM_000666 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000667 (topology stripping analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000667 "A topology stripping method is a procedure used to remove a subset of atoms, typically solvent and ions, from a molecular topology file. This is most often done during post-processing to create smaller topology files for the receptor and ligand alone, which are needed for MM/PBSA or MM/GBSA free energy calculations. For experts, this method is an essential step in the workflow for preparing files for endpoint free energy analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000667 "topology stripping analysis"@en)
SubClassOf(obo:MOLSIM_000667 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000668 (force field parameter update modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000668 "A force field parameter update method is a procedure for modifying or adding to an existing set of force field parameters. This is often done by reading a small file containing new or revised parameters that override the default values loaded from the main force field library. For experts, this method is the standard way to use parameters for a non-standard ligand or to apply a specific correction to the force field without having to edit the core parameter files. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000668 "force field parameter update modeling"@en)
SubClassOf(obo:MOLSIM_000668 obo:MOLSIM_000374)

# Class: obo:MOLSIM_000669 (average structure calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000669 "An average structure calculation is a structural analysis method that computes the average coordinates of all atoms over a simulation trajectory. This provides a single, representative structure that reflects the central conformation of the system during the simulation. It is important to note that this average structure may not be a physically realistic conformation itself, especially if the molecule is highly flexible."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000669 "average structure calculation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000669 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000669 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000670 (coordinate centering analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000670 "Coordinate centering is a structural analysis method, often performed as a pre-processing step, that translates the coordinates of a molecular system so that its center of mass is at the origin of the coordinate system. This is a standard procedure to ensure that the molecule remains in the center of the simulation box for easier analysis and visualization."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000670 "coordinate centering analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000670 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000670 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000671 (closest solvent analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000671 "An analysis method that identifies which solvent molecules lie nearest a solute, and follows them over time. It is used to reorder a trajectory so that the same water molecules stay near the solute in the output, or to count how long an individual water stays in contact. It answers which solvent molecules matter, rather than how much solvent there is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000671 "closest solvent analysis"@en)
SubClassOf(obo:MOLSIM_000671 obo:MOLSIM_000974)

# Class: obo:MOLSIM_000672 (trajectory frame filtering)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000672 "Trajectory frame filtering is a data processing step where a simulation trajectory is selectively reduced in size by removing certain frames based on a specific criterion. This could involve discarding an initial equilibration period or keeping only those frames where a molecule adopts a particular shape. This filtering is a common procedure used to focus an analysis on a specific time period or a subset of conformations that are most relevant to the scientific question."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000672 "trajectory frame filtering"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000672 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000672 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000673 (electronic structure analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000673 "A type of analysis method focused on examining the electronic properties of a molecule derived from its quantum mechanical description, such as the wavefunction or electron density. This includes analyzing the distribution of electrons (charge, spin density), the nature of molecular orbitals, chemical bonding characteristics, and electronic response properties like polarizability. It provides fundamental insights into chemical reactivity, spectroscopy, and intermolecular forces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000673 "electronic structure analysis"@en)
SubClassOf(obo:MOLSIM_000673 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000674 (charge analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000674 "A specific electronic structure analysis technique used to partition the total electron density of a molecule and assign partial atomic charges to individual atoms. Various schemes exist (e.g., Mulliken, Löwdin, Hirshfeld, Natural Population Analysis, ESP-derived charges), each with different theoretical underpinnings, providing insights into charge distribution, polarity, and electrostatic interaction sites. These charges are often used to parameterize classical force fields or interpret reactivity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000674 "charge analysis"@en)
SubClassOf(obo:MOLSIM_000674 obo:MOLSIM_000673)

# Class: obo:MOLSIM_000675 (wavefunction property analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000675 "An electronic structure analysis method that directly calculates molecular properties as expectation values using the computed quantum mechanical wavefunction or density matrix. This can include properties like dipole and multipole moments, electron density at specific points (e.g., bond critical points in QTAIM), spin densities, or electric field gradients, providing detailed information about the molecule's electronic state and interactions. It leverages the full information contained within the wavefunction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000675 "wavefunction property analysis"@en)
SubClassOf(obo:MOLSIM_000675 obo:MOLSIM_000673)

# Class: obo:MOLSIM_000676 (orbital analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000676 "A form of electronic structure analysis that investigates the molecular orbitals (MOs) of a system, which represent the energy levels and spatial distributions of electrons within the molecule based on quantum mechanics. Common analyses include visualizing frontier orbitals (HOMO, LUMO), examining orbital compositions (e.g., atomic orbital contributions), analyzing orbital energies for insights into ionization potential or electron affinity, and relating MOs to chemical bonding, reactivity, and electronic transitions. It helps rationalize chemical behavior based on electron distribution in orbitals. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000676 "orbital analysis"@en)
SubClassOf(obo:MOLSIM_000676 obo:MOLSIM_000673)

# Class: obo:MOLSIM_000677 (polarization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000677 "An electronic structure analysis technique that examines how the electron distribution of a molecule is distorted (polarized) in response to an external electric field or the field generated by nearby molecules. This involves calculating the induced dipole moment and the polarizability tensor, which quantify the molecule's susceptibility to charge redistribution. Understanding polarization is crucial for accurately describing intermolecular interactions, solvation effects, and responses to electromagnetic fields. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000677 "polarization analysis"@en)
SubClassOf(obo:MOLSIM_000677 obo:MOLSIM_000673)

# Class: obo:MOLSIM_000678 (atom order fixing analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000678 "An atom order fixing method is a procedure used to reorder the atoms in a structure file to ensure they match the order expected by a corresponding topology file. Inconsistencies in atom ordering are a common source of errors when preparing systems for simulation. For experts, this is a critical sanity check and correction step to ensure that the coordinates and parameters are correctly matched for every atom. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000678 "atom order fixing analysis"@en)
SubClassOf(obo:MOLSIM_000678 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000679 (image bond fixing analysis)

AnnotationAssertion(owl:deprecated obo:MOLSIM_000679 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000679 "OBSOLETE. Image bond fixing is a post-processing step applied to simulation trajectories to correct the visual representation of molecules in a periodic system. When a molecule crosses a periodic boundary, it can appear \"broken\" in the raw output, with parts of it on opposite sides of the simulation box. This procedure identifies such cases and translates the atomic coordinates to make the molecule appear whole, which is essential for correct visualization and many types of analysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000679 "obsolete image bond fixing analysis"@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000679 obo:MOLSIM_000659)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000679 "Retired as redundant with its former parent 'periodic boundary imaging' (MOLSIM:000659), of which it was the only child. Bond fixing is an implicit outcome of imaging, and that term's definition now states so. Reported and approved by the term verifier in GitHub issue #45."@en)

# Class: obo:MOLSIM_000680 (atom selection analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000680 "An atom selection method is the procedure or syntax used to specify a particular group of atoms within a molecular system for an analysis or modification. This is typically done using a text-based selection language that allows users to choose atoms based on properties like name, residue, or position."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000680 "atom selection analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000680 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000680 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000681 (Gaussian electrostatic model force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000681 "A polarizable force field that represents charge as smeared-out Gaussian distributions rather than as points, with both permanent and induced multipole terms. Smearing the charge removes the artificial divergence that point charges give at very short range. It is markedly more accurate and more expensive than a point-charge treatment. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000681 "GEM force field"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000681 "Gaussian electrostatic model force field"@en)
SubClassOf(obo:MOLSIM_000681 obo:MOLSIM_000639)

# Class: obo:MOLSIM_000682 (amber ff19SB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000682 "Amber ff19SB is a modern and widely used set of rules, or a force field, for accurately simulating the structure and movement of proteins. The AMBER ff19SB protein force field is a recent refinement of the ff14SB lineage, incorporating updated quantum mechanical calculations for backbone dihedral angle parameters to improve the description of protein secondary structure balance. It is considered a state-of-the-art choice for all-atom protein simulations, offering high fidelity for studying protein folding, dynamics, and interactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000682 "AMBER ff19SB"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000682 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000682 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000683 (vector analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000683 "A structural analysis method that measures the direction of vectors defined within a molecule, such as a bond vector or the normal to a plane, and how those directions change. It covers both the orientation of a single vector over time and the angle between 2 of them. It is how the orientation and rotational behaviour of specific groups is quantified. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000683 "vector analysis"@en)
SubClassOf(obo:MOLSIM_000683 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000684 (atom remapping analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000684 "An atom remapping method is a procedure used to systematically change the properties of atoms in a topology file, such as their atom types or charges. This is often required when converting a system from one force field to another or when applying specific corrections. For experts, this is an advanced manipulation used in force field development or for setting up non-standard simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000684 "atom remapping analysis"@en)
SubClassOf(obo:MOLSIM_000684 obo:MOLSIM_000328)

# Class: obo:MOLSIM_000685 (ab-initio method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000685 "A quantum chemistry method that solves the electronic Schrödinger equation using only fundamental physical constants and the identities of the atoms, with no parameters fitted to experiment. Hartree-Fock and the correlated methods built on it, such as Møller-Plesset perturbation theory and coupled cluster, belong here. The absence of fitted parameters is what lets accuracy be improved systematically rather than by re-tuning. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000685 "ab-initio method"@en)
SubClassOf(obo:MOLSIM_000685 obo:MOLSIM_000141)

# Class: obo:MOLSIM_000686 (PDB ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000686 "A PDB ID is the unique four-character alphanumeric code (e.g., '1TIM', '6M0J') where the first character is always numeric. Every PDB id is assigned to a experimentally determined biomolecular structure deposited in the Protein Data Bank (PDB). This identifier serves to reference and retrieve PDB data. However these identifiers are now deprecated in favor of the Extended PDB ID."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000686 "PDB ID"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000686 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000686 obo:MOLSIM_000447)

# Class: obo:MOLSIM_000687 (UniProt ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000687 "A UniProt ID, more formally known as a UniProt Accession Number (e.g., 'P00761', 'Q8WZ42'), is the stable and unique identifier assigned to a protein sequence record in the UniProt Knowledgebase (UniProtKB). This ID provides access to comprehensive information about a protein, including its sequence, function, annotations, and cross-references to other databases. It serves as a primary key for protein sequence and functional data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000687 "UniProt ID"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000687 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000687 obo:MOLSIM_000447)

# Class: obo:MOLSIM_000688 (data source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000688 "Any origin from which data used in a biomolecular study is obtained, whether a database, a document, a laboratory record or a person. It covers where a structure, a parameter or a measurement came from. Recording it is what lets a claim in a dataset be traced back and checked. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000688 "TODO:may be be replacable with IAO's information content entity (http://purl.obolibrary.org/obo/IAO_0000030 ) as an import. discussion needed: the definition there is however rather abstract. #ontologyengineer #import"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000688 "How this branch is built. The classes here are KINDS of data source, for example protein structural database, pathway database, or simulation data repository. Each real, named resource is then added as an individual of one of those classes, not as a class of its own. PDB, UniProt, ChEMBL, Reactome, MoDEL and AlphaFold DB are individuals in this way. This is on purpose: a named database is one single thing in the world, not a kind of thing, so it fits better as an individual. Please keep this pattern, and do not turn these individuals into classes as a tidy-up. Two things to know. First, individuals are not copied into the OBO-format file (see the release-format note in the ontology header). Second, most OBO ontologies use classes for everything, so a reviewer may ask why we did this."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000688 "data source"@en)

# Class: obo:MOLSIM_000689 (database source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000689 "An organized, typically electronic, collection of structured information or data that can be easily accessed, managed, and updated. In biomolecular sciences, databases store vast amounts of information like molecular structures, sequences, experimental results, and simulation trajectories. They serve as central repositories for the research community. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000689 "database source"@en)
SubClassOf(obo:MOLSIM_000689 obo:MOLSIM_000688)

# Class: obo:MOLSIM_000690 (primary database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000690 "A type of database that archives original data directly submitted by researchers or generated through primary experimental efforts. These databases are foundational resources, providing the raw material (e.g., atomic coordinates, gene sequences) upon which further analysis and knowledge discovery are built. Examples include repositories for protein structures or DNA sequences."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000690 "primary database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000690 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000690 obo:MOLSIM_000689)

# Class: obo:MOLSIM_000691 (structural database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000691 "A primary database specializing in the storage and dissemination of three-dimensional (3D) atomic coordinate data for biological macromolecules like proteins and nucleic acids. These databases are essential for understanding molecular function, designing drugs, and providing starting points for simulations. The Protein Data Bank (PDB) is a prime example."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000691 "structural database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000691 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000691 obo:MOLSIM_000690)

# Class: obo:MOLSIM_000692 (protein structural database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000692 "A structural database specifically focused on archiving and distributing 3D atomic coordinates and associated experimental data for proteins and their complexes. These resources are critical for researchers studying protein architecture, function, and interactions. The PDB is the foremost example in this category. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000692 "protein structural database"@en)
SubClassOf(obo:MOLSIM_000692 obo:MOLSIM_000691)

# Class: obo:MOLSIM_000693 (nucleic acid structural database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000693 "A structural database dedicated to collecting and providing 3D atomic coordinates and related information for nucleic acids such as DNA and RNA, including their various forms and complexes. These databases support research into gene regulation, RNA function, and nucleic acid-drug interactions. The Nucleic Acid Database (NDB) is a key example."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000693 "nucleic acid structural database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000693 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000693 obo:MOLSIM_000691)

# Class: obo:MOLSIM_000694 (electron microscopy database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000694 "A structural database that archives 3D maps and associated metadata derived from electron microscopy experiments, particularly cryo-electron microscopy (cryo-EM), which is used to determine the structure of large biomolecular assemblies. It complements X-ray crystallography and NMR databases by providing structural information for systems often intractable by other methods. The Electron Microscopy Data Bank (EMDB) is the main repository. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000694 "electron microscopy database"@en)
SubClassOf(obo:MOLSIM_000694 obo:MOLSIM_000691)

# Class: obo:MOLSIM_000695 (sequence database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000695 "A primary database that stores and organizes linear sequences of amino acids (for proteins) or nucleotides (for DNA/RNA). These databases are fundamental for comparative genomics, evolutionary studies, identifying functional motifs, and linking sequence to structure and function. Examples include GenBank for nucleic acids and UniProtKB for protein sequences."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000695 "sequence database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000695 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000695 obo:MOLSIM_000690)

# Class: obo:MOLSIM_000696 (protein sequence database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000696 "A sequence database specifically focused on collecting, annotating, and distributing protein amino acid sequences and associated functional information. These resources are vital for understanding protein evolution, function, and for identifying proteins from experimental data. UniProtKB is a comprehensive example."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000696 "protein sequence database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000696 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000696 obo:MOLSIM_000695)
DisjointClasses(obo:MOLSIM_000696 obo:MOLSIM_000697)

# Class: obo:MOLSIM_000697 (nucleic acid sequence database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000697 "A sequence database dedicated to archiving and providing access to DNA and RNA nucleotide sequences from various organisms, including genes, genomes, and transcripts. These databases are cornerstones of genomics and molecular biology research. GenBank, ENA, and DDBJ are major international examples."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000697 "nucleic acid sequence database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000697 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000697 obo:MOLSIM_000695)

# Class: obo:MOLSIM_000698 (small molecule database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000698 "A primary database that curates information about small chemical compounds, including their structures, properties, and biological activities. These resources are crucial for drug discovery, cheminformatics, and understanding ligand-protein interactions. PubChem and ChEBI are prominent examples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000698 "small molecule database"@en)
SubClassOf(obo:MOLSIM_000698 obo:MOLSIM_000690)

# Class: obo:MOLSIM_000699 (chemical structure database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000699 "A small molecule database primarily focused on storing and providing access to 2D and 3D chemical structures, identifiers, and physicochemical properties of diverse chemical compounds. These are fundamental for chemical information retrieval and computational chemistry. PubChem Compound and ZINC are key examples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000699 "chemical structure database"@en)
SubClassOf(obo:MOLSIM_000699 obo:MOLSIM_000698)
DisjointClasses(obo:MOLSIM_000699 obo:MOLSIM_000700)

# Class: obo:MOLSIM_000700 (drug information database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000700 "A small molecule database specifically curating information about drugs, including their chemical properties, pharmacological actions, targets, and therapeutic uses. These resources are vital for pharmacology, drug development, and clinical research. DrugBank is a well-known example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000700 "drug information database"@en)
SubClassOf(obo:MOLSIM_000700 obo:MOLSIM_000698)

# Class: obo:MOLSIM_000701 (spectroscopic database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000701 "A primary database that archives experimental data obtained from various spectroscopic techniques, such as Nuclear Magnetic Resonance (NMR), mass spectrometry, or infrared spectroscopy, applied to biological molecules. These databases allow for the reanalysis of raw or processed spectral data and aid in structural and functional characterization. The Biological Magnetic Resonance Data Bank (BMRB) is an example for NMR data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000701 "spectroscopic database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000701 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000701 obo:MOLSIM_000690)

# Class: obo:MOLSIM_000702 (NMR data repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000702 "A spectroscopic database specifically designed to store, organize, and disseminate experimental data from Nuclear Magnetic Resonance (NMR) studies of biomolecules. This includes raw spectral data, assigned chemical shifts, coupling constants, and derived structural constraints, complementing 3D coordinate depositions. The BMRB is the principal repository."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000702 "NMR data repository"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000702 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000702 obo:MOLSIM_000701)

# Class: obo:MOLSIM_000703 (secondary database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000703 "A type of database that derives its content from analyzing, curating, or integrating information from one or more primary databases, often providing value-added annotations or classifications. These databases help researchers interpret primary data by, for example, grouping proteins into families or classifying structures. Pfam (protein families) and SCOP (structural classification) are examples."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000703 "secondary database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000703 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000703 obo:MOLSIM_000689)

# Class: obo:MOLSIM_000704 (protein family and domain database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000704 "A secondary database that classifies proteins into families and identifies conserved domains based on sequence similarity, structural features, or functional annotations. These resources help predict protein function and understand evolutionary relationships. Examples include Pfam, InterPro, and SMART. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000704 "protein family and domain database"@en)
SubClassOf(obo:MOLSIM_000704 obo:MOLSIM_000703)

# Class: obo:MOLSIM_000705 (structural classification database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000705 "A secondary database that organizes known protein structures into a hierarchical classification based on their evolutionary relationships and structural similarities, such as folds and superfamilies. These classifications provide insights into protein architecture and evolution. SCOP and CATH are prominent examples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000705 "structural classification database"@en)
SubClassOf(obo:MOLSIM_000705 obo:MOLSIM_000703)

# Class: obo:MOLSIM_000706 (pathway database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000706 "Databases that curate and represent information about biological pathways, such as metabolic, signaling, or regulatory networks, detailing the interactions between molecules. These resources help understand complex biological processes and the roles of individual components. KEGG and Reactome are widely used examples."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000706 "pathway database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000706 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000706 obo:MOLSIM_000703)

# Class: obo:MOLSIM_000707 (bioactivity database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000707 "A secondary (or sometimes primary) database that collects and organizes experimental data on the biological activity of chemical compounds, particularly their interactions with protein targets (e.g., binding affinity, inhibition constants). These are crucial for drug discovery and chemical biology research. ChEMBL and BindingDB are key examples. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000707 "bioactivity database"@en)
SubClassOf(obo:MOLSIM_000707 obo:MOLSIM_000703)

# Class: obo:MOLSIM_000708 (knowledge-based database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000708 "A specialized type of database designed to store complex, structured, and unstructured information, often integrating data from multiple sources and using ontologies or controlled vocabularies to represent knowledge explicitly. Knowledge bases aim to provide a comprehensive understanding of specific biological entities or systems, facilitating inference and discovery. UniProtKB is a prime example in the protein domain. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000708 "knowledge-based database"@en)
SubClassOf(obo:MOLSIM_000708 obo:MOLSIM_000689)

# Class: obo:MOLSIM_000709 (repository database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000709 "A type of database primarily focused on the storage, preservation, and dissemination of datasets, often associated with specific types of studies, computational outputs, or large-scale projects. Repositories ensure data accessibility and reusability for the scientific community. Examples include those for simulation trajectories or predicted protein structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000709 "repository database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000709 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000709 obo:MOLSIM_000689)

# Class: obo:MOLSIM_000710 (simulation data repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000710 "A repository specifically designed to store, share, and allow re-analysis of data generated from biomolecular simulations, such as molecular dynamics trajectories and analysis results. These resources promote reproducibility and enable new discoveries from existing simulation data. MDposit and MDrepo are examples."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000710 "simulation data repository"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000710 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000710 obo:MOLSIM_000709)

# Class: obo:MOLSIM_000711 (predicted structure repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000711 "A repository that archives and provides access to computationally predicted three-dimensional structures of proteins, often generated by large-scale initiatives or community efforts. These resources offer structural hypotheses for proteins lacking experimental structures. The AlphaFold DB is a prominent example."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000711 "predicted structure repository"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000711 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000711 obo:MOLSIM_000709)

# Class: obo:MOLSIM_000712 (metabolomics repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000712 "A repository dedicated to storing and disseminating datasets from metabolomics experiments, which involve the comprehensive study of small molecules (metabolites) within cells, tissues, or organisms. These resources support systems biology and biomarker discovery. MetaboLights is an example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000712 "metabolomics repository"@en)
SubClassOf(obo:MOLSIM_000712 obo:MOLSIM_000709)

# Class: obo:MOLSIM_000713 (literature database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000713 "A database that indexes and provides access to bibliographic information from scientific journals, conference proceedings, and other scholarly publications. These are essential tools for researchers to find relevant scientific articles and stay updated on research findings. PubMed and Scopus are widely used examples."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000713 "literature database"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000713 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000713 obo:MOLSIM_000689)

# Class: obo:MOLSIM_000714 (tool web server)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000714 "A web server that runs a computation on data the user supplies, rather than returning records it already holds. The user uploads a structure, the server computes something from it, and the result comes back. That is what separates it from a database server, which retrieves rather than computes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000714 "tool web server"@en)
SubClassOf(obo:MOLSIM_000714 obo:MOLSIM_001671)

# Class: obo:MOLSIM_000715 (prediction data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000715 "A data format that holds the direct output of a prediction program, such as a predicted structure, a predicted binding site, or a predicted functional annotation. It covers the result as the program wrote it, before any curation or deposition into a public repository. A coordinate file from a local homology modelling run is an example. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000715 "prediction data format"@en)
SubClassOf(obo:MOLSIM_000715 obo:MOLSIM_001085)

# Class: obo:MOLSIM_000716 (UCSF ChimeraX)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000716 "A visualization and analysis program for molecular structures, built to handle very large data such as cryogenic electron microscopy maps and whole virus capsids. It is the successor to Chimera, rewritten for modern graphics hardware. Its speed on large structures is what distinguishes it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000716 "ChimeraX"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000716 "UCSF ChimeraX"@en)
SubClassOf(obo:MOLSIM_000716 obo:MOLSIM_000490)
SubClassOf(obo:MOLSIM_000716 obo:MOLSIM_002041)

# Class: obo:MOLSIM_000717 (experimental data source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000717 "OBSOLETE. Refers to data obtained directly from a specific laboratory experiment. This can include data reported in a scientific publication for which no separate database entry exists, or unpublished results from ongoing research."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000717 "obsolete experimental data source"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000717 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000717 "Retired 2026-09-18. MOLSIM:000688 data source sorted its children by 3 different questions at once: what kind of resource it is, how the data was produced, and who may see it. Only the first is a kind of source, so a private unpublished PDB entry belonged under all 3. The 2 facets are now recorded by the MOLSIM:002274 data source descriptor branch instead. Raised in review by orcid:0000-0002-2294-5393; neither this term nor its former children had a single instance."@en)

# Class: obo:MOLSIM_000718 (obsolete scientific publication source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000718 "OBSOLETE. A published research article, review, book chapter, or conference proceeding that serves as the source of specific data, findings, or methodologies. When data is cited directly from a publication without an associated database entry, the publication itself is considered the data source. This is common for specific measurements or observations not typically archived elsewhere."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000718 "obsolete scientific publication source"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000718 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000718 obo:IAO_0000310)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000718 "Retired 2026-09-18 in favour of IAO:0000310 document, which is now imported and attached under MOLSIM:000688 data source. The term duplicated a concept IAO already models, and its own definition enumerated exactly IAO's document types. Part of the data source refactor asked for in review by orcid:0000-0002-2294-5393, which removed the facets experimental and private from the hierarchy and left it sorting sources by what kind of resource they are."@en)

# IAO:0000310 document, imported 2026-09-18, attached here so a document can be
# named as the origin of simulation data.
SubClassOf(obo:IAO_0000310 obo:MOLSIM_000688)

# Class: obo:MOLSIM_002270 (review article)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002270 "A publication that surveys and summarises existing published work on a topic rather than reporting new primary results."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002270 "review article"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002270 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002270 obo:IAO_0000311)

# Class: obo:MOLSIM_002271 (book chapter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002271 "A publication that forms one titled part of an edited book, usually written by different authors from the other parts."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002271 "book chapter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002271 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002271 obo:IAO_0000311)

# Class: obo:MOLSIM_002272 (thesis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002272 "A document presenting the research carried out for an academic degree, submitted to and examined by the awarding institution. Simulation results are often reported here before they appear in any journal."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002272 "thesis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002272 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002272 obo:IAO_0000310)

# Class: obo:MOLSIM_002273 (conference proceeding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002273 "A publication that is one of the collected contributions to a scientific meeting."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002273 "conference proceeding"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002273 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002273 obo:IAO_0000311)

# Class: obo:MOLSIM_002274 (data source descriptor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002274 "An information content entity that records one property of a data source, such as how its data was produced or who may see it. These are deliberately kept apart from the data source hierarchy itself, which sorts sources only by what kind of resource they are, so that a single source can carry several descriptors at once."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002274 "data source descriptor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002274 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002274 obo:IAO_0000030)

# Class: obo:MOLSIM_002275 (data origin)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002275 "A data source descriptor that records how the data held by a source was produced."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002275 "data origin"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002275 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002275 obo:MOLSIM_002274)

# Class: obo:MOLSIM_002276 (experimental data origin)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002276 "A data origin recording that the data was obtained by measurement in a laboratory rather than by calculation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002276 "experimental data origin"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002276 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002276 obo:MOLSIM_002275)

# Class: obo:MOLSIM_002277 (computational data origin)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002277 "A data origin recording that the data was produced by calculation or simulation rather than by laboratory measurement."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002277 "computational data origin"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002277 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002277 obo:MOLSIM_002275)

# Class: obo:MOLSIM_002278 (data access)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002278 "A data source descriptor that records who may obtain the data held by a source."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002278 "data access"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002278 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002278 obo:MOLSIM_002274)

# Class: obo:MOLSIM_002279 (public access)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002279 "A data access descriptor recording that the data may be obtained by anyone without permission or licence."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002279 "public access"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002279 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002279 obo:MOLSIM_002278)

# Class: obo:MOLSIM_002280 (restricted access)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002280 "A data access descriptor recording that the data may be obtained only under some condition, such as an institutional membership, a licence, an embargo period, or a direct request to its holder."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002280 "restricted access"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002280 orcid:0000-0003-4846-8051)
SubClassOf(obo:MOLSIM_002280 obo:MOLSIM_002278)

# Class: obo:MOLSIM_002281 (Extended PDB ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002281 "An Extended PDB ID is the unique twelve-character code composed of a 'pdb_' header followed by 8 alphanumeric characters. Every Extended PDB ID is assigned to a experimentally determined biomolecular structure deposited in the Protein Data Bank (PDB). This identifier serves to reference and retrieve PDB data. This format is the successor of the legacy four-character PDB ID."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002281 "Extended PDB ID"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002281 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002281 obo:MOLSIM_000447)

# Class: obo:MOLSIM_002282 (InChIKey code)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002282 "An InChIKey is a fixed-length, 27-character alphanumeric hash derived from the InChI (International Chemical Identifier) code of a chemical structure, used to uniquely and compactly identify chemical compounds in databases and web searches."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002282 "InChIKey code"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002282 orcid:0000-0002-2294-5393)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002282 "InChiKey code"@en)
SubClassOf(obo:MOLSIM_002282 obo:MOLSIM_000447)

# Class: obo:MOLSIM_000719 (unpublished experimental result source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000719 "OBSOLETE. Data or findings originating from a laboratory experiment that have not yet been published or formally disseminated to the public or scientific community. This category covers preliminary results, ongoing research data, or information shared through informal channels before formal publication or deposition."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000719 "obsolete unpublished experimental result source"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000719 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000719 "Retired 2026-09-18. MOLSIM:000688 data source sorted its children by 3 different questions at once: what kind of resource it is, how the data was produced, and who may see it. Only the first is a kind of source, so a private unpublished PDB entry belonged under all 3. The 2 facets are now recorded by the MOLSIM:002274 data source descriptor branch instead. Raised in review by orcid:0000-0002-2294-5393; neither this term nor its former children had a single instance."@en)

# Class: obo:MOLSIM_000720 (private source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000720 "OBSOLETE. A data source that is not publicly accessible, such as an internal database maintained by a private company or research institution, or data held privately by an individual researcher. This category is important for acknowledging data origins that cannot be independently verified or accessed by the wider community."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000720 "obsolete private source"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000720 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000720 "Retired 2026-09-18. MOLSIM:000688 data source sorted its children by 3 different questions at once: what kind of resource it is, how the data was produced, and who may see it. Only the first is a kind of source, so a private unpublished PDB entry belonged under all 3. The 2 facets are now recorded by the MOLSIM:002274 data source descriptor branch instead. Raised in review by orcid:0000-0002-2294-5393; neither this term nor its former children had a single instance."@en)

# Class: obo:MOLSIM_000721 (in house database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000721 "OBSOLETE. A database developed and maintained within a specific organization (e.g., a pharmaceutical company, a research institute) for its internal use, not generally accessible to the public. These often contain proprietary data, specialized collections, or information tailored to the organization's specific research needs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000721 "obsolete in house database"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000721 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_000721 obo:MOLSIM_000689)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000721 "Retired 2026-09-18. MOLSIM:000688 data source sorted its children by 3 different questions at once: what kind of resource it is, how the data was produced, and who may see it. Only the first is a kind of source, so a private unpublished PDB entry belonged under all 3. The 2 facets are now recorded by the MOLSIM:002274 data source descriptor branch instead. Raised in review by orcid:0000-0002-2294-5393; neither this term nor its former children had a single instance. This one has a successor: an in house database is a database, so MOLSIM:000689 database source replaces it."@en)

# Class: obo:MOLSIM_000722 (private communication source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000722 "Information or data obtained directly from an individual researcher or expert through informal means such as email, conversation, or unpublished notes, rather than through a formal publication or public database. While sometimes necessary, such sources are typically less verifiable and are often used for supplementary or preliminary information."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000722 "personal communication source"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000722 "private communication source"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000722 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000722 obo:MOLSIM_000688)

# Class: obo:MOLSIM_000735 (resolution-based force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000735 "A type of force field classified by the level of structural detail, or resolution, used to represent the system's components. This classification distinguishes between models that represent every atom explicitly versus those that group atoms into larger pseudo-atoms or beads. The resolution impacts the balance between computational efficiency and physical accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000735 "resolution-based force field"@en)
SubClassOf(obo:MOLSIM_000735 obo:MOLSIM_000007)

# Class: obo:MOLSIM_000736 (coarse-grained force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000736 "A force field in which groups of atoms are represented by single interaction sites rather than individually. Cutting the number of particles cuts the cost of every step and allows a longer timestep, so much larger systems and much longer times become reachable. What is lost is any detail below the size of a site. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000736 "coarse-grained force field"@en)
SubClassOf(obo:MOLSIM_000736 obo:MOLSIM_000735)
DisjointClasses(obo:MOLSIM_000736 obo:MOLSIM_000737)

# Class: obo:MOLSIM_000737 (all-atom force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000737 "A force field that explicitly includes parameters for every atom in the simulated system, including hydrogen atoms. This approach provides a high level of detail and aims for greater physical realism compared to coarse-grained models. All-atom simulations are generally more computationally intensive due to the larger number of particles."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000737 "all-atom force field"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000737 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000737 obo:MOLSIM_000735)

# Class: obo:MOLSIM_000738 (amber glycam 06)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000738 "A specific parameter set within the AMBER family, developed by the GLYCAM group for simulating carbohydrates (glycans). Released around 2006, it provides parameters for common monosaccharides and the glycosidic linkages between them, enabling the study of oligosaccharides and the carbohydrate portions of glycoproteins/glycolipids. It is designed to be compatible with AMBER protein/lipid force fields. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000738 "AMBER GLYCAM 06"@en)
SubClassOf(obo:MOLSIM_000738 obo:MOLSIM_000012)
DisjointClasses(obo:MOLSIM_000738 obo:MOLSIM_000739)

# Class: obo:MOLSIM_000739 (amber glycam 06 EP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000739 "A force field for carbohydrates in the AMBER family that places extra charged points on the lone pairs of ring and hydroxyl oxygens. Those points direct hydrogen bonding more sharply than a charge on the nucleus can, which matters for sugars because their behaviour is dominated by hydrogen bonds. It is a variant of the GLYCAM06 parameter set rather than a separate force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000739 "AMBER GLYCAM 06 EP"@en)
SubClassOf(obo:MOLSIM_000739 obo:MOLSIM_000012)

# Class: obo:MOLSIM_000740 (amber AMOEBA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000740 "A set of ion parameters for the AMOEBA polarizable force field as distributed with the AMBER suite. Because AMOEBA represents charge with atomic multipoles and explicit induced dipoles rather than fixed point charges, ions need parameters fitted for that form. Parameters from a fixed-charge force field cannot be used with it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000740 "AMBER AMOEBA"@en)
SubClassOf(obo:MOLSIM_000740 obo:MOLSIM_000015)

# Class: obo:MOLSIM_000741 (amber ff02)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000741 "A specific protein force field parameter set from the AMBER family, representing one of the earlier polarizable force fields. Unlike fixed-charge force fields (like ff99SB), ff02 includes electronic polarizability explicitly, aiming for a more accurate description of electrostatics but at a higher computational cost. Its adoption was less widespread than fixed-charge counterparts."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000741 "AMBER ff02"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000741 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000741 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000742 (amber ff10)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000742 "A specific protein force field parameter set from the AMBER family, incorporating updates (e.g., to backbone torsions) over ff99SB, developed around 2010. It served as an evolutionary step in the AMBER force field lineage. However, it was largely superseded by subsequent versions like ff12SB and ff14SB. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000742 "AMBER ff10"@en)
SubClassOf(obo:MOLSIM_000742 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000743 (amber ff12SB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000743 "A specific protein force field parameter set from the AMBER family, representing an update released around 2012. Compared to ff99SB, ff12SB refined quantum-chemical (QM) based side-chain dihedral parameters and updated the backbone φ rotational profile to compensate for biases seen in earlier version. It served as an intermediate improvement before the release of ff14SB."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000743 "AMBER ff12SB"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000743 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000743 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000744 (amber ff94)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000744 "An early, widely influential all-atom protein force field parameter set from the AMBER family, released around 1994. It provided a complete set of parameters for proteins and became a benchmark for subsequent developments. While largely superseded by newer versions (ff96, ff99, ff99SB, ff14SB etc.), its development laid crucial groundwork. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000744 "AMBER ff94"@en)
SubClassOf(obo:MOLSIM_000744 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000745 (amber ff96)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000745 "A subsequent refinement of the AMBER ff94 protein force field parameter set, released around 1996. It included adjustments based on accumulated experience and new data, aiming to improve performance compared to ff94. Like ff94, it has been largely replaced by later versions but represents a step in the evolution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000745 "AMBER ff96"@en)
SubClassOf(obo:MOLSIM_000745 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000746 (amber ff99)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000746 "An important revision of the AMBER protein force field parameter set released around 1999, incorporating significant updates, especially to backbone torsion parameters, compared to ff94/ff96. It aimed to better reproduce secondary structure propensities. Several variants of ff99 exist, addressing specific issues or refining parameters further. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000746 "AMBER ff99"@en)
SubClassOf(obo:MOLSIM_000746 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000747 (amber ff99 phi)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000747 "A specific modification of the AMBER ff99 protein force field. This variant likely involved adjustments targeted at the phi (ϕ) backbone dihedral angle parameters, aiming to correct specific structural biases observed with the original ff99. Such targeted modifications are common in force field development. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000747 "AMBER ff99 phi"@en)
SubClassOf(obo:MOLSIM_000747 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000748 (amber ff99bsc0)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000748 "A force field for nucleic acids, built on the AMBER ff99 parameter set with the alpha and gamma backbone dihedral terms refit by the Barcelona group. The refit removed an irreversible backbone flip that caused DNA simulations to degrade after tens of nanoseconds. It was the first parameter set to make multi-nanosecond DNA simulation stable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000748 "AMBER ff99bsc0"@en)
SubClassOf(obo:MOLSIM_000748 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000749 (amber ff99SB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000749 "A highly popular and widely used refinement of the AMBER ff99 protein force field, where 'SB' indicates improvements primarily focused on side-chain (S) and backbone (B) dihedral torsion potentials. It corrected some imbalances in secondary structure preference found in ff99. ff99SB served as a robust baseline before the development of ff14SB. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000749 "AMBER ff99SB"@en)
SubClassOf(obo:MOLSIM_000749 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000750 (amber ff99SB ILDN)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000750 "A force field for proteins, built on the AMBER ff99SB parameter set with the side-chain torsion terms refit for isoleucine, leucine, aspartate and asparagine. The 4 residues were singled out because their rotamer populations disagreed most with NMR measurements. The rest of the parameter set is unchanged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000750 "AMBER ff99SB ILDN"@en)
SubClassOf(obo:MOLSIM_000750 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000751 (CHARMM 22)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000751 "An all-atom force field parameter set from the CHARMM family, widely used for protein simulations, often paired with the CMAP (Cross-term energy Correction Map) correction for backbone torsions. Released before CHARMM27 and CHARMM36, it represented a standard for many years. Parameterization relied heavily on fitting to experimental data available at the time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000751 "CHARMM 22"@en)
SubClassOf(obo:MOLSIM_000751 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000752 (CHARMM 19)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000752 "An earlier force field parameter set from the CHARMM family, notable for being a 'united-atom' force field for proteins. In this representation, nonpolar hydrogen atoms (e.g., on CH, CH2, CH3 groups) are implicitly included in the heavy atoms they are attached to, reducing the number of particles and computational cost compared to all-atom models."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000752 "CHARMM 19"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000752 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000752 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000753 (CHARMM 27)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000753 "An all-atom force field parameter set from the CHARMM family, representing an update and extension of CHARMM22, released around 2000-2001. It included refined parameters for proteins and also incorporated compatible parameters for nucleic acids (DNA, RNA). Like CHARMM22, it was often used with the CMAP correction for proteins. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000753 "CHARMM 27"@en)
SubClassOf(obo:MOLSIM_000753 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000754 (OPEP 1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000754 "Specific versions 1 of the OPEP (Optimized Potential for Efficient peptide structure Prediction) coarse-grained force field. OPEP represents each amino acid residue using multiple beads (typically backbone N, H, Cα, C, O and a side-chain bead), aiming to retain chemical specificity while gaining computational efficiency. The different versions likely represent successive refinements and parameter updates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000754 "OPEP 1"@en)
SubClassOf(obo:MOLSIM_000754 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000755 (OPEP 2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000755 "Specific versions 2 of the OPEP (Optimized Potential for Efficient peptide structure Prediction) coarse-grained force field. OPEP represents each amino acid residue using multiple beads (typically backbone N, H, Cα, C, O and a side-chain bead), aiming to retain chemical specificity while gaining computational efficiency. The different versions likely represent successive refinements and parameter updates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000755 "OPEP 2"@en)
SubClassOf(obo:MOLSIM_000755 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000756 (OPEP 3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000756 "Specific versions 3 of the OPEP (Optimized Potential for Efficient peptide structure Prediction) coarse-grained force field. OPEP represents each amino acid residue using multiple beads (typically backbone N, H, Cα, C, O and a side-chain bead), aiming to retain chemical specificity while gaining computational efficiency. The different versions likely represent successive refinements and parameter updates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000756 "OPEP 3"@en)
SubClassOf(obo:MOLSIM_000756 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000757 (OPEP 4)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000757 "Specific versions 4 of the OPEP (Optimized Potential for Efficient peptide structure Prediction) coarse-grained force field. OPEP represents each amino acid residue using multiple beads (typically backbone N, H, Cα, C, O and a side-chain bead), aiming to retain chemical specificity while gaining computational efficiency. The different versions likely represent successive refinements and parameter updates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000757 "OPEP 4"@en)
SubClassOf(obo:MOLSIM_000757 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000758 (OPLS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000758 "A family of force fields whose parameters were fitted to reproduce the measured properties of liquids, such as density and heat of vaporisation, rather than to quantum calculations alone. Fitting to bulk properties is what distinguishes it from the other major families. It covers organic molecules, proteins and nucleic acids. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000758 "OPLS"@en)
SubClassOf(obo:MOLSIM_000758 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000759 (OPLS-AA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000759 "A force field of the OPLS family in which every atom including hydrogen is represented separately. It is more accurate than the united-atom version, particularly for aromatic groups and for anything where a hydrogen's position matters. It costs roughly twice as much, because an organic molecule has about twice as many sites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000759 "OPLS-AA"@en)
SubClassOf(obo:MOLSIM_000759 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000760 (OPLS-UA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000760 "A force field of the OPLS family in which non-polar hydrogens are merged into the heavy atom they are bonded to, so that a methyl group is 1 interaction site rather than 4. Merging them cuts the particle count substantially at the cost of any detail those hydrogens carried. It was widely used for organic liquids before all-atom parameters became affordable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000760 "OPLS-UA"@en)
SubClassOf(obo:MOLSIM_000760 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000761 (OPLS-2001)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000761 "A specific parameter set version within the OPLS-AA force field family, released around 2001. It contained parameters primarily for proteins and organic liquids available at that time. Subsequent versions like OPLS-2005 updated and expanded upon this set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000761 "OPLS-2001"@en)
SubClassOf(obo:MOLSIM_000761 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000762 (OPLS-2005)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000762 "A significant update and expansion of the OPLS-AA force field parameter set, released around 2005. It included refined parameters for proteins, nucleic acids, and a wider range of organic functional groups compared to OPLS-2001. It remains a widely used parameter set within the OPLS family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000762 "OPLS-2005"@en)
SubClassOf(obo:MOLSIM_000762 obo:MOLSIM_000009)

# Class: obo:MOLSIM_000763 (TIP4P)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000763 "A rigid water model with 4 sites, the fourth being a massless point near the oxygen carrying that atom's negative charge. Moving the negative charge off the oxygen towards the hydrogens gives a better electrostatic field around the molecule. It costs about 25% more than a 3-site model and reproduces the dielectric constant and the density maximum far better. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000763 "TIP4P"@en)
SubClassOf(obo:MOLSIM_000763 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000764 (TIP4P-Ew)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000764 "A specific variant of the TIP4P water model, optimized for use with Ewald summation methods for calculating long-range electrostatic interactions, which are standard in modern simulations with periodic boundary conditions. The parameters are adjusted to provide good agreement with experimental properties of liquid water (like density, enthalpy of vaporization) under typical simulation conditions (room temperature and pressure). It is a popular choice for biomolecular simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000764 "TIP4P-Ew"@en)
SubClassOf(obo:MOLSIM_000764 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000765 (TIP4P/Ice)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000765 "A specific variant of the TIP4P water model, parameterized specifically to reproduce the properties of different phases of ice (solid water), as well as liquid water properties. It aims to provide a better description of water's phase diagram, particularly the solid phases, compared to models optimized solely for the liquid state. It is useful for studying freezing, melting, or ice interfaces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000765 "TIP4P/Ice"@en)
SubClassOf(obo:MOLSIM_000765 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000766 (TIP4P/2005)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000766 "A specific variant of the TIP4P water model, released around 2005, re-parameterized to provide improved agreement with a wider range of experimental properties of liquid water over various temperatures and pressures compared to earlier TIP4P versions. It is considered one of the most accurate rigid, non-polarizable 4-point models for general liquid water simulations. It accurately predicts properties like the temperature of maximum density. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000766 "TIP4P/2005"@en)
SubClassOf(obo:MOLSIM_000766 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000767 (TIP5P)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000767 "A rigid water model with 5 sites, adding 2 massless points in the positions the oxygen's lone pairs would occupy. Placing negative charge there makes hydrogen bonding directional in the way real water's is. It reproduces the temperature of maximum density correctly, which simpler models do not, at a further increase in cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000767 "TIP5P"@en)
SubClassOf(obo:MOLSIM_000767 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000768 (TIP6P)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000768 "A rigid water model with 6 sites, carrying charges on all 3 atoms, on 2 lone-pair points and on a further point near the oxygen. The extra sites refine the electrostatic field further still. Its cost restricts it to studies of water itself rather than of biomolecules in water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000768 "TIP6P"@en)
SubClassOf(obo:MOLSIM_000768 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000769 (SPC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000769 "A rigid water model with 3 interaction sites, one on each atom, and a bond angle set to the ideal tetrahedral value rather than the measured one of an isolated molecule. Widening the angle compensates for the absence of polarization in a fixed-charge model. It is among the oldest models still in use. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000769 "SPC"@en)
SubClassOf(obo:MOLSIM_000769 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000770 (SPC flexible)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000770 "A variation of the SPC water model where the normally rigid constraints on bond lengths (O-H) and/or angle (H-O-H) are replaced with flexible harmonic potentials. This allows the water molecule geometry to fluctuate during the simulation, which can affect dynamics and spectroscopic properties. It adds computational overhead compared to rigid SPC. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000770 "SPC flexible"@en)
SubClassOf(obo:MOLSIM_000770 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000771 (SPC/E)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000771 "A rigid 3-site water model that keeps the geometry of its predecessor and adds a correction for the energy cost of polarizing a molecule from its gas-phase to its liquid charge distribution. That correction improves the density and the diffusion coefficient markedly. It is a common choice where bulk water properties matter more than compatibility with a particular force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000771 "SPC/E"@en)
SubClassOf(obo:MOLSIM_000771 obo:MOLSIM_000014)

# Class: obo:MOLSIM_000772 (chemical entity-based force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000772 "A force field specifically developed and parameterized to accurately model a particular class of chemical molecules, such as proteins, lipids, or nucleic acids. Its parameters are tuned based on experimental data and/or quantum mechanical calculations relevant to that molecular type. This specialization aims to improve the accuracy of simulations for specific biomolecular systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000772 "chemical entity-based force field"@en)
SubClassOf(obo:MOLSIM_000772 obo:MOLSIM_000007)

# Class: obo:MOLSIM_000773 (ADF)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000773 "A quantum chemistry engine built around density functional theory using Slater-type orbitals rather than the Gaussian functions most programs use. Slater functions have the correct shape at the nucleus, which suits properties that depend on the region near heavy atoms. It is chosen for transition metal and relativistic work for that reason. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000773 "ADF"@en)
SubClassOf(obo:MOLSIM_000773 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000774 (Abalone)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000774 "Abalone (Abalone II) is a general purpose molecular dynamics and molecular graphics program for simulations of bio-molecules in a periodic boundary conditions in explicit or implicit water models. Mainly designed to simulate the protein folding and DNA-ligand complexes in AMBER force field."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000774 "Abalone"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000774 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000774 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000775 (CP2K)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000775 "An open-source quantum chemistry and solid-state physics software package designed for performing atomistic simulations of solid state, liquid, molecular, periodic, material, crystal, and biological systems. CP2K is particularly known for its efficient DFT calculations using a hybrid Gaussian and Plane Waves (GPW) method and its Quickstep module, enabling QM and QM/MM simulations of large systems, including ab initio MD. It's highly parallelized and versatile for demanding simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000775 "CP2K"@en)
SubClassOf(obo:MOLSIM_000775 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000776 (CPMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000776 "A quantum chemistry engine for molecular dynamics in which the forces come from a density functional calculation at every step. It avoids re-solving the electronic structure each step by giving the electronic degrees of freedom their own fictitious dynamics. That method is what the program is named after. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000776 "CPMD"@en)
SubClassOf(obo:MOLSIM_000776 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000777 (Desmond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000777 "A high-performance software package specifically designed for classical molecular dynamics simulations of biological systems, developed by D. E. Shaw Research (DESRES). Desmond is known for its exceptional speed, particularly on GPUs, and its integration with the Schrödinger Materials Science Suite. It supports standard force fields (like CHARMM, AMBER, OPLS) and offers features for system building, simulation execution (including free energy calculations), and analysis, primarily targeting drug discovery and biomolecular research."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000777 "Desmond"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000777 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000777 obo:MOLSIM_000160)

# Class: obo:MOLSIM_000778 (Firefly)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000778 "A quantum chemistry engine offering a broad range of wavefunction and density functional methods, heavily optimised for Intel processors. It shares its origins and much of its input syntax with GAMESS (US). It was formerly distributed as PC GAMESS, which should be kept as an exact synonym. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000778 "Firefly"@en)
SubClassOf(obo:MOLSIM_000778 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000779 (GAMESS-UK)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000779 "A quantum chemistry software package developed in the UK, distinct from GAMESS-US, though sharing common historical roots. It offers a broad range of ab initio QM methods (HF, MP2, CCSD(T), MCSCF, DFT) and includes capabilities for QM/MM calculations. Like other QM packages, it is primarily used for electronic structure calculations and parameterization rather than large-scale classical MD. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000779 "GAMESS-UK"@en)
SubClassOf(obo:MOLSIM_000779 obo:MOLSIM_000176)

# Class: obo:MOLSIM_000780 (GAMESS-US)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000780 "A widely used, freely available quantum chemistry software package (General Atomic and Molecular Electronic Structure System). It provides a broad range of quantum mechanical methods, from semi-empirical to high-level ab initio (HF, DFT, MP2, CCSD, MCSCF), and includes features for geometry optimization, vibrational analysis, and QM/MM simulations. GAMESS-US is extensively used in computational chemistry research and education for electronic structure calculations relevant to biomolecular systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000780 "GAMESS-US"@en)
SubClassOf(obo:MOLSIM_000780 obo:MOLSIM_000176)

# Class: obo:MOLSIM_000781 (GROMOS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000781 "A software package for classical molecular dynamics simulation, developed principally at ETH Zürich, covering system setup, simulation and analysis. It is distributed together with the force field family of the same name. The package and the force field are separate things and should not share 1 term. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000781 "GROMOS"@en)
SubClassOf(obo:MOLSIM_000781 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000782 (HyperChem)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000782 "A commercial molecular modeling software package providing a graphical interface for building, visualizing, and simulating molecular systems. It offers capabilities for molecular mechanics (MM) using various force fields, quantum mechanics (QM) using semi-empirical and ab initio methods, and molecular dynamics (MD) simulations. HyperChem aims to provide an integrated environment for a range of computational chemistry tasks on desktop computers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000782 "HyperChem"@en)
SubClassOf(obo:MOLSIM_000782 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000783 (Jaguar)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000783 "A high-performance quantum chemistry software package, part of the Schrödinger Materials Science Suite, known for its speed and accuracy, particularly for DFT calculations. It also offers ab initio methods (like LMP2) and QM/MM capabilities. Jaguar is often used in drug discovery contexts for tasks requiring high-quality QM calculations, such as reaction modeling, property prediction, and parameterization. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000783 "Jaguar"@en)
SubClassOf(obo:MOLSIM_000783 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000784 (LAMMPS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000784 "A highly versatile, open-source classical molecular dynamics simulator developed at Sandia National Laboratories, designed for parallel computing (Large-scale Atomic/Molecular Massively Parallel Simulator). LAMMPS has a very broad application range, extending from biomolecules (using standard force fields like CHARMM, AMBER, OPLS) to materials science, solid-state physics, and coarse-grained simulations, due to its extensive library of potentials and simulation methods. Its flexibility makes it suitable for non-standard simulation setups. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000784 "LAMMPS"@en)
SubClassOf(obo:MOLSIM_000784 obo:MOLSIM_000160)

# Class: obo:MOLSIM_000785 (MOPAC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000785 "A widely used semi-empirical quantum chemistry software package (Molecular Orbital PACkage). It implements methods like AM1, PM3, PM6, PM7, which are much faster than ab initio or DFT methods, allowing calculations on larger systems or longer timescales, albeit typically with lower accuracy. MOPAC is often used for rapid geometry optimization, property estimation, or as the QM component in QM/MM calculations where speed is critical. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000785 "MOPAC"@en)
SubClassOf(obo:MOLSIM_000785 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000786 (NAMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000786 "A highly scalable, parallel molecular dynamics simulation software package developed at the University of Illinois Urbana-Champaign, designed specifically for simulating large biomolecular systems on high-performance computers (NAnoscale Molecular Dynamics). NAMD works particularly well with the CHARMM force field (and others like AMBER) and is often used in conjunction with the VMD visualization program for setup and analysis. It is known for its excellent performance on parallel architectures, including GPUs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000786 "NAMD"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000786 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000786 obo:MOLSIM_000160)

# Class: obo:MOLSIM_000787 (SIESTA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000787 "An open-source software package for performing electronic structure calculations and ab initio molecular dynamics simulations based on Density Functional Theory (DFT). SIESTA uses localized numerical atomic orbitals as basis sets and efficient pseudopotentials, making it suitable for large systems and parallel computation. While applicable to biomolecules, its strengths are often utilized in materials science and condensed matter physics contexts, similar to Quantum ESPRESSO or VASP. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000787 "SIESTA"@en)
SubClassOf(obo:MOLSIM_000787 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000788 (Spartan)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000788 "A commercial molecular modeling and computational chemistry software package featuring an integrated graphical user interface. It provides tools for structure building and visualization, and implements a range of computational methods, including molecular mechanics (MM), semi-empirical methods (like AM1, PM3), Hartree-Fock (HF), Density Functional Theory (DFT), and Møller-Plesset (MPn) calculations. Spartan is widely used in education and research for structure-property relationship studies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000788 "Spartan"@en)
SubClassOf(obo:MOLSIM_000788 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000789 (TINKER)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000789 "A freely available software package for molecular mechanics and dynamics simulations. TINKER provides implementations of various standard force fields (AMBER, CHARMM, OPLS, MMFF) and includes tools for energy minimization, MD simulation, free energy calculations, and structural analysis. It is particularly notable for its implementation of polarizable force fields (e.g., AMOEBA) and its modular design. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000789 "TINKER"@en)
SubClassOf(obo:MOLSIM_000789 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000790 (Tremolo-X)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000790 "A molecular dynamics program built for high-performance computing, developed at Fraunhofer SCAI. Its applications are in nanotechnology and materials rather than in biomolecules. It is included here because simulation metadata may name it as the engine that produced a dataset. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000790 "Tremolo-X"@en)
SubClassOf(obo:MOLSIM_000790 obo:MOLSIM_000160)

# Class: obo:MOLSIM_000791 (TURBOMOLE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000791 "A highly efficient quantum chemistry software package focusing on ab initio methods, particularly Density Functional Theory (DFT) and correlated wavefunction methods (like MP2, CC2, CCSD(T)), optimized for speed and parallel performance. It is widely used for calculations on molecules and clusters, especially for applications requiring high accuracy or large basis sets, such as reaction mechanism studies, spectroscopy, and parameterization tasks relevant to biomolecular simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000791 "TURBOMOLE"@en)
SubClassOf(obo:MOLSIM_000791 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000792 (VASP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000792 "A quantum chemistry engine for density functional calculations on periodic systems, using plane waves as its basis. Plane waves suit an infinite repeating solid, where atom-centred functions do not. It is the standard tool for solids and surfaces rather than for isolated molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000792 "VASP"@en)
SubClassOf(obo:MOLSIM_000792 obo:MOLSIM_000161)

# Class: obo:MOLSIM_000793 (X-PLOR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000793 "A software package primarily used for macromolecular structure determination based on experimental data, particularly X-ray crystallography and NMR spectroscopy data. It incorporates molecular mechanics (energy terms from force fields), molecular dynamics (often used for refinement or simulated annealing protocols), and terms representing the experimental restraints to refine structures consistent with both physics and experimental observations. While it uses MD concepts, its primary goal is structure determination rather than simulating equilibrium dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000793 "X-PLOR"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000793 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000793 obo:MOLSIM_001664)

# Class: obo:MOLSIM_000794 (Hoover barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000794 "A pressure control algorithm that treats the volume of the box as an extra degree of freedom with its own equation of motion, following Hoover's formulation. Because the equations are deterministic, the trajectory can be reproduced exactly from the same starting point. It generates the correct constant-pressure ensemble, which the simpler rescaling schemes do not. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000794 "Hoover barostat"@en)
SubClassOf(obo:MOLSIM_000794 obo:MOLSIM_000039)

# Class: obo:MOLSIM_000795 (M-SHAKE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000795 "A modification of the SHAKE algorithm designed to handle constraints more efficiently in parallel computing environments. It addresses issues related to communication overhead when constraints span across different processors by optimizing the way constraint information is shared and processed. It aims to improve the scalability of constrained simulations on parallel machines. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000795 "M-SHAKE algorithm"@en)
SubClassOf(obo:MOLSIM_000795 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000796 (P-SHAKE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000796 "A constraint algorithm that holds bond lengths fixed using the SHAKE approach, restructured so the work can be divided across processors. The difficulty it addresses is that constraints link atoms which may sit on different processors, so enforcing them needs communication. It targets that communication rather than the constraint mathematics. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000796 "P-SHAKE algorithm"@en)
SubClassOf(obo:MOLSIM_000796 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000797 (SETTLE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000797 "An analytical (non-iterative) constraint algorithm specifically designed for rigid water models like TIP3P or SPC/E, where both bond lengths and the bond angle are fixed. Because the geometry is simple and fixed, the constraint equations for a water molecule can be solved analytically, making SETTLE significantly faster than iterative methods like SHAKE for constraining water. It is highly efficient for simulations with explicit water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000797 "SETTLE algorithm"@en)
SubClassOf(obo:MOLSIM_000797 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000798 (SHAPE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000798 "A constraint algorithm related to SHAKE, often used for fixing distances within rigid clusters of atoms larger than simple bonds or angles. It iteratively adjusts the positions of atoms within the defined rigid body to maintain their relative positions. It extends the concept of bond constraints to more complex rigid units. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000798 "SHAPE algorithm"@en)
SubClassOf(obo:MOLSIM_000798 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000799 (WIGGLE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000799 "A constraint algorithm that holds bond lengths fixed while using information about the atoms' velocities as well as their positions to converge faster. Holding bonds fixed removes the fastest vibrations from a system, which is what allows a longer timestep. It is an extension of the SHAKE approach rather than a separate idea. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000799 "WIGGLE algorithm"@en)
SubClassOf(obo:MOLSIM_000799 obo:MOLSIM_000049)

# Class: obo:MOLSIM_000800 (Nose thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000800 "A temperature control algorithm that adds an extra degree of freedom to the system, standing for the heat bath, and lets it exchange energy with the atoms through its own equation of motion. The equations are deterministic and produce exactly the canonical distribution, which simple rescaling does not. Its original form rescales time as well, which the later reformulation removes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000800 "Nose thermostat"@en)
SubClassOf(obo:MOLSIM_000800 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000801 (Nose-Poincare thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000801 "A specific mathematical formulation of the Nosé thermostat dynamics based on Poincaré's canonical transformations. It offers insights into the theoretical foundations and conservation laws of the Nosé thermostatting mechanism. It represents a rigorous theoretical framework for this class of deterministic thermostats. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000801 "Nose-Poincare thermostat"@en)
SubClassOf(obo:MOLSIM_000801 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000802 (V-rescale thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000802 "A temperature control algorithm that modifies simple weak coupling by adding a random term chosen so the resulting distribution of kinetic energies is the correct one. Weak coupling alone drives every fluctuation towards the mean, which suppresses the spread a real system has. The random term restores it at no extra cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000802 "V-rescale thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_000802 "tcoupl=v-rescale")
SubClassOf(obo:MOLSIM_000802 obo:MOLSIM_000038)

# Class: obo:MOLSIM_000803 (semi-empirical method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000803 "A category of quantum chemistry calculation methods that bridges the gap between highly accurate but slow ab initio methods and very fast but simple molecular mechanics. It simplifies the complex equations of quantum mechanics (often starting from the Hartree-Fock framework) by neglecting certain terms and using parameters derived from experimental data to approximate others. These methods aim to provide a reasonable balance between computational cost and accuracy for studying molecular properties like geometry and energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000803 "semi-empirical method"@en)
SubClassOf(obo:MOLSIM_000803 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000804 (all-valence-electron restricted)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000804 "A semi-empirical method that treats every valence electron explicitly while representing the inner electrons by a fixed core. Including all valence electrons is what lets it describe molecules of any element combination rather than only conjugated ones. It is the level nearly all modern semi-empirical methods work at. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000804 "all-valence-electron restricted"@en)
SubClassOf(obo:MOLSIM_000804 obo:MOLSIM_000803)
DisjointClasses(obo:MOLSIM_000804 obo:MOLSIM_000806)

# Class: obo:MOLSIM_000805 (PPP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000805 "A semi-empirical quantum method that treats only the pi electrons of a conjugated system, holding the rest of the molecule fixed as a framework. Restricting the calculation to pi electrons made conjugated molecules computable long before general methods existed. It predicted the absorption spectra of dyes well and cannot describe anything outside the pi system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000805 "PPP"@en)
SubClassOf(obo:MOLSIM_000805 obo:MOLSIM_000806)

# Class: obo:MOLSIM_000806 (pi-electron restricted)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000806 "A semi-empirical method that treats only the pi electrons explicitly, holding the rest of the molecule fixed as a framework. Restricting the calculation this way made conjugated molecules computable on the hardware of the 1950s and 1960s. It cannot describe anything outside the pi system, which is why it is of historical interest only. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000806 "pi-electron restricted"@en)
SubClassOf(obo:MOLSIM_000806 obo:MOLSIM_000803)

# Class: obo:MOLSIM_000807 (AM1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000807 "A semi-empirical quantum method built on the NDDO approximation, adding extra Gaussian terms to the core repulsion so that hydrogen bonding is described better than its predecessor manages. Its parameters were adjusted by hand against measured heats of formation and geometries. It remains in wide use, particularly as the basis of fast charge assignment schemes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000807 "AM1"@en)
SubClassOf(obo:MOLSIM_000807 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000808 (CNDO/2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000808 "A semi-empirical all-valence-electron method that neglects essentially all overlap between electron distributions on different atoms, in its second parameterisation. The severity of that approximation makes it very fast and correspondingly crude. It is of historical interest rather than in current use. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000808 "CNDO/2"@en)
SubClassOf(obo:MOLSIM_000808 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000809 (INDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000809 "A semi-empirical all-valence-electron method that keeps the one-centre electron repulsion integrals between orbitals on the same atom, which the earlier complete-neglect scheme discarded. Keeping them is what lets it describe electron spin distributions and the properties that depend on them. It is the level the MINDO and SINDO families refine. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000809 "INDO"@en)
SubClassOf(obo:MOLSIM_000809 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000810 (Hartree-Fock)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000810 "A fundamental ab initio quantum chemistry method that approximates the solution to the electronic Schrödinger equation for a multi-electron system. It treats each electron as moving in an average field created by all other electrons, neglecting instantaneous electron correlation but including exact exchange interaction. It serves as a starting point for more sophisticated ab initio methods and is the foundation simplified by semi-empirical approaches. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000810 "HF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000810 "Hartree-Fock"@en)
SubClassOf(obo:MOLSIM_000810 obo:MOLSIM_000685)

# Class: obo:MOLSIM_000812 (restricted open-shell Hartree-Fock)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000812 "A Hartree-Fock method for systems with unpaired electrons that keeps electrons of opposite spin in the same spatial orbitals wherever they are paired. The constraint means the wavefunction remains an eigenfunction of total spin, with no spin contamination. It is less flexible than the unrestricted method and usually gives a slightly higher energy. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000812 "ROHF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000812 "restricted open-shell Hartree-Fock"@en)
SubClassOf(obo:MOLSIM_000812 obo:MOLSIM_000810)

# Class: obo:MOLSIM_000813 (self-consistent field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000813 "An iterative computational procedure that solves for a set of molecular orbitals by repeatedly recomputing the average field each electron feels from all the others until the orbitals stop changing. It is how the Hartree-Fock equations, and those of density functional theory, are solved in practice. A calculation that fails to reach that fixed point is said not to have converged. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000813 "SCF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000813 "self-consistent field"@en)
SubClassOf(obo:MOLSIM_000813 obo:MOLSIM_000810)

# Class: obo:MOLSIM_000814 (Unrestricted Hartree-Fock)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000814 "A Hartree-Fock method that lets electrons of opposite spin occupy different spatial orbitals. The extra freedom describes unpaired electrons better than forcing paired orbitals does. The price is that the resulting wavefunction is not an eigenfunction of total spin, so it can be contaminated by states of higher multiplicity. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000814 "UHF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000814 "Unrestricted Hartree-Fock"@en)
SubClassOf(obo:MOLSIM_000814 obo:MOLSIM_000810)

# Class: obo:MOLSIM_000815 (MINDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000815 "A family of semi-empirical all-valence-electron methods that refine the intermediate-neglect approximation with re-fitted parameters, aimed at predicting heats of formation for organic molecules. Successive members are distinguished by a version number. They were superseded by the MNDO and AM1 families. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000815 "MINDO"@en)
SubClassOf(obo:MOLSIM_000815 obo:MOLSIM_000809)

# Class: obo:MOLSIM_000816 (MNDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000816 "A semi-empirical quantum method built on the NDDO approximation, the first to treat all valence electrons at that level. It described geometries and heats of formation far better than the earlier intermediate-neglect methods. Its known failure is that it underestimates hydrogen bonding severely, which is what the later methods set out to fix. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000816 "MNDO"@en)
SubClassOf(obo:MOLSIM_000816 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000817 (NDDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000817 "A semi-empirical approximation scheme that neglects the overlap between atomic orbitals on different atoms, except where both orbitals of a pair sit on the same atom. Dropping those integrals is what makes semi-empirical calculations fast. It underlies the MNDO, AM1 and PM families of methods. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000817 "NDDO"@en)
SubClassOf(obo:MOLSIM_000817 obo:MOLSIM_000804)

# Class: obo:MOLSIM_000818 (PDDG)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000818 "A modification applied to the MNDO and AM1 semi-empirical methods, adding correction terms that depend on the distance between each pair of atoms. The corrections improve heats of formation markedly, particularly for organic molecules. It changes the parameters and the core repulsion rather than the underlying approximation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000818 "PDDG"@en)
SubClassOf(obo:MOLSIM_000818 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000819 (PM3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000819 "A semi-empirical quantum method built on the NDDO approximation, with its parameters fitted automatically to a large set of measured molecular properties. The automatic fitting is what distinguishes it from its contemporaries, whose parameters were adjusted by hand. It handles hydrogen bonding better than those and geometries around nitrogen worse. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000819 "PM3"@en)
SubClassOf(obo:MOLSIM_000819 obo:MOLSIM_000804)

# Class: obo:MOLSIM_000820 (PM3MM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000820 "A hybrid method that combines the PM3 semi-empirical quantum mechanical treatment for a part of the system (e.g., the active site of an enzyme) with a faster molecular mechanics (MM) force field for the remainder (e.g., the surrounding protein or solvent). This QM/MM approach allows computationally feasible studies of large systems where quantum effects are important locally. It leverages PM3's balance of speed and accuracy for the QM region. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000820 "PM3MM"@en)
SubClassOf(obo:MOLSIM_000820 obo:MOLSIM_000819)

# Class: obo:MOLSIM_000821 (PM6)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000821 "A semi-empirical quantum method built on the NDDO approximation, parameterised for most of the periodic table rather than for organic elements alone. That coverage is what distinguishes it from its predecessors, which handle few metals. It also revised the core repulsion terms, improving hydrogen bonding and the description of metal complexes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000821 "PM6"@en)
SubClassOf(obo:MOLSIM_000821 obo:MOLSIM_000819)

# Class: obo:MOLSIM_000822 (RM1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000822 "A semi-empirical quantum method built on the NDDO approximation, refitting the parameters of AM1 against a larger and more modern set of measurements. It uses the same functional form as its predecessor and differs only in the parameter values. It covers the elements most common in organic and biological molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000822 "RM1"@en)
SubClassOf(obo:MOLSIM_000822 obo:MOLSIM_000804)

# Class: obo:MOLSIM_000823 (SAM1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000823 "A semi-empirical quantum method built on the NDDO approximation that computes some of the electron repulsion integrals directly rather than taking them all from parameters. Computing part of them was intended to improve accuracy for hydrogen bonds and transition states. It is much less widely used than its contemporaries. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000823 "SAM1"@en)
SubClassOf(obo:MOLSIM_000823 obo:MOLSIM_000804)

# Class: obo:MOLSIM_000824 (SINDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000824 "A semi-empirical all-valence-electron method at the intermediate-neglect level that first orthogonalises the atomic orbitals symmetrically. The orthogonalisation makes the approximations more internally consistent than in the unmodified scheme. It was developed to improve on the earlier intermediate-neglect methods. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000824 "SINDO"@en)
SubClassOf(obo:MOLSIM_000824 obo:MOLSIM_000804)

# Class: obo:MOLSIM_000825 (Sparkle/AM1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000825 "A modification of the AM1 semi-empirical method specifically parameterized to handle lanthanide elements (rare earth metals). Standard AM1 parameters are not available or reliable for these heavy elements, so Sparkle/AM1 replaces the core description of the lanthanide ion with a point charge dressed by Gaussian functions, adjusted to reproduce structural data. It enables AM1-level calculations on complexes containing lanthanides. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000825 "Sparkle/AM1"@en)
SubClassOf(obo:MOLSIM_000825 obo:MOLSIM_000807)

# Class: obo:MOLSIM_000826 (ZANDO)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000826 "An all-valence-electron semi-empirical method likely based on the INDO or NDDO approximation schemes, developed by Zhidomirov and coworkers. It represents one of the many variations within the semi-empirical framework, likely with specific parameterizations or modifications to the integral approximations aimed at particular applications or accuracy improvements. Note: This method is less common than MNDO/AM1/PMx variants, and specific details might require consulting specialized literature. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000826 "ZANDO"@en)
SubClassOf(obo:MOLSIM_000826 obo:MOLSIM_000817)

# Class: obo:MOLSIM_000827 (Moeller-Plesset)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000827 "A post-Hartree-Fock method that recovers electron correlation by treating the difference between the true electronic Hamiltonian and the Hartree-Fock one as a perturbation, and computing energy corrections order by order. Each successive order adds more correlation and costs more. The order used is written as a number after the name. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000827 "MP")
AnnotationAssertion(rdfs:label obo:MOLSIM_000827 "Moeller-Plesset"@en)
SubClassOf(obo:MOLSIM_000827 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000828 (Moeller-Plesset 2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000828 "A Møller-Plesset method truncated at second order, which adds the correlation energy from double excitations out of the Hartree-Fock reference. It is the cheapest way to include electron correlation at all and is widely used for that reason. It describes dispersion reasonably and overestimates it for large systems. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000828 "MP2")
AnnotationAssertion(rdfs:label obo:MOLSIM_000828 "Moeller-Plesset 2"@en)
SubClassOf(obo:MOLSIM_000828 obo:MOLSIM_000827)

# Class: obo:MOLSIM_000829 (Moeller-Plesset 3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000829 "A Møller-Plesset method truncated at third order. It costs substantially more than second order and does not reliably give a better answer, because the perturbation series does not converge smoothly. It is rarely used in practice. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000829 "MP3")
AnnotationAssertion(rdfs:label obo:MOLSIM_000829 "Moeller-Plesset 3"@en)
SubClassOf(obo:MOLSIM_000829 obo:MOLSIM_000827)

# Class: obo:MOLSIM_000830 (Moeller-Plesset 4)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000830 "A Møller-Plesset method truncated at fourth order, including single, double, triple and quadruple excitations out of the Hartree-Fock reference. The triple excitations are what make it markedly more accurate than second order and also what make it expensive. It is sometimes written with the excitation levels listed explicitly. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000830 "MP4")
AnnotationAssertion(rdfs:label obo:MOLSIM_000830 "Moeller-Plesset 4"@en)
SubClassOf(obo:MOLSIM_000830 obo:MOLSIM_000827)

# Class: obo:MOLSIM_000831 (Moeller-Plesset 5)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000831 "A Møller-Plesset method truncated at fifth order. It includes still higher excitations than fourth order, at a cost that rises steeply with system size. It is used almost only to study how the perturbation series itself behaves. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000831 "MP5")
AnnotationAssertion(rdfs:label obo:MOLSIM_000831 "Moeller-Plesset 5"@en)
SubClassOf(obo:MOLSIM_000831 obo:MOLSIM_000827)

# Class: obo:MOLSIM_000832 (multi-reference method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000832 "A class of advanced quantum mechanics methods required for accurately describing molecules or chemical processes where the electronic structure cannot be well represented by a single dominant electron configuration (as assumed in basic Hartree-Fock theory). These situations often involve stretched bonds, excited states, diradicals, or transition metals, necessitating the use of multiple electronic configurations to capture the essential physics. These methods are typically more computationally demanding than single-reference approaches. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000832 "multi-reference"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000832 "multi-reference method"@en)
SubClassOf(obo:MOLSIM_000832 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000833 (complete active space self-consistent field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000833 "A multi-configurational method in which a chosen set of electrons and orbitals, the active space, is treated with every possible configuration among them while the remaining orbitals stay doubly occupied or empty. Choosing that space is the whole art of the method, because its cost grows factorially with its size. It is the most widely used multi-reference starting point. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000833 "CASSCF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000833 "complete active space self-consistent field"@en)
SubClassOf(obo:MOLSIM_000833 obo:MOLSIM_000832)

# Class: obo:MOLSIM_000834 (multi-configurational self-consistent field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000834 "A quantum chemistry method that optimises the shapes of the molecular orbitals and the weights of several electron configurations at the same time. A single configuration cannot describe a bond being broken or a near-degenerate ground state; several can. It is the starting point for the multi-reference correlated methods. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000834 "MC-SCF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000834 "multi-configurational self-consistent field"@en)
SubClassOf(obo:MOLSIM_000834 obo:MOLSIM_000832)

# Class: obo:MOLSIM_000835 (multi-reference coupled cluster with single and double excitations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000835 "A quantum chemistry method that applies a coupled cluster treatment with single and double excitations on top of a multi-configurational reference wavefunction. It combines the size consistency of coupled cluster with a reference able to describe bond breaking. It is among the most accurate methods available and among the most expensive. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000835 "MR-CCSD")
AnnotationAssertion(rdfs:label obo:MOLSIM_000835 "multi-reference coupled cluster with single and double excitations"@en)
SubClassOf(obo:MOLSIM_000835 obo:MOLSIM_000832)

# Class: obo:MOLSIM_000836 (multi-reference configuration interaction with single and double excitations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000836 "A quantum chemistry method that performs a configuration interaction treatment with single and double excitations starting from a multi-configurational reference rather than a single determinant. It recovers dynamic correlation on top of the static correlation the reference already describes. It is not size-consistent, which limits its use on large or dissociating systems. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000836 "MR-CI(SD)")
AnnotationAssertion(rdfs:label obo:MOLSIM_000836 "multi-reference configuration interaction with single and double excitations"@en)
SubClassOf(obo:MOLSIM_000836 obo:MOLSIM_000832)

# Class: obo:MOLSIM_000837 (restricted active space self-consistent field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000837 "A multi-configurational method that divides the active space into subspaces and limits how many electrons may be excited out of or into each. The restriction keeps the number of configurations manageable where a complete treatment would be too large. It trades some completeness for the ability to use a bigger active space. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000837 "RASSCF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000837 "restricted active space self-consistent field"@en)
SubClassOf(obo:MOLSIM_000837 obo:MOLSIM_000832)

# Class: obo:MOLSIM_000838 (quadratic configuration interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000838 "A quantum chemistry method developed to account for electron correlation, closely related to the Coupled Cluster (CC) family of methods. It was designed to ensure size-consistency, an important theoretical property meaning the energy of two non-interacting systems is the sum of their individual energies, which is not guaranteed by standard truncated Configuration Interaction (CI). It offers a systematic way to improve upon the Hartree-Fock description. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000838 "quadratic configuration interaction"@en)
SubClassOf(obo:MOLSIM_000838 obo:MOLSIM_000173)

# Class: obo:MOLSIM_000839 (QCISD(T))

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000839 "A quadratic configuration interaction method with single and double excitations that adds a perturbative estimate of triple excitations. The triples correction is what brings the method close to chemical accuracy for many properties. It costs considerably more than the calculation without it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000839 "QCISD(T)"@en)
SubClassOf(obo:MOLSIM_000839 obo:MOLSIM_000838)
DisjointClasses(obo:MOLSIM_000839 obo:MOLSIM_000840)

# Class: obo:MOLSIM_000840 (QCISD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000840 "A post-Hartree-Fock method that includes single and double excitations in a configuration interaction treatment modified so that the result is size-consistent. Size consistency means the energy of 2 well-separated molecules equals the sum of their separate energies, which plain truncated configuration interaction does not satisfy. Its cost and accuracy are close to those of coupled cluster with single and double excitations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000840 "QCISD"@en)
SubClassOf(obo:MOLSIM_000840 obo:MOLSIM_000838)

# Class: obo:MOLSIM_000841 (empirical method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000841 "A computational method that uses a simplified energy function whose parameters were fitted to experimental measurements or to more accurate calculations, rather than derived from first principles. The fitting is what makes it fast enough for large systems. It is also its limit: the method is reliable only for systems resembling those it was fitted to. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000841 "empirical method"@en)
SubClassOf(obo:MOLSIM_000841 obo:MOLSIM_000141)

# Class: obo:MOLSIM_000842 (minimization method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000842 "A method that adjusts the positions of atoms to reach a nearby arrangement of lowest energy. It moves downhill from wherever it starts, so it finds the nearest low point rather than the lowest one anywhere. It is run before a simulation to remove the severe atom overlaps that a freshly built system almost always contains. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000842 "minimization method"@en)
SubClassOf(obo:MOLSIM_000842 obo:MOLSIM_000841)

# Class: obo:MOLSIM_000843 (molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000843 "Molecular dynamics (MD) is a computer simulation technique used to study the physical movement of atoms and molecules over time. It calculates the forces between particles using an empirical potential energy function (force field) and then integrates Newton's equations of motion numerically to simulate how the positions and velocities evolve in small time steps. MD simulations provide detailed information about the dynamic behavior, conformational changes, and thermodynamics of molecular systems."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000843 "MD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000843 "molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000843 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000843 obo:MOLSIM_000308)

# Class: obo:MOLSIM_000844 (NetCDF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000844 "The NetCDF (Network Common Data Form) format, which typically uses the .nc extension, is a set of software libraries and a file format designed for storing and sharing array-oriented scientific data. Developed and maintained by the Unidata program at the University Corporation for Atmospheric Research (UCAR), it is an open standard widely used across many scientific disciplines, such as molecular dynamics. While Amber has adopted NetCDF as its preferred, modern format for storing trajectories and other data, the format itself is not specific to Amber and is a general-purpose standard."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000844 "NetCDF format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000844 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000844 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000845 (enhanced sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000845 "Enhanced sampling encompasses a diverse set of computational techniques used in molecular simulations to accelerate the exploration of a system's possible configurations or states. These methods aim to overcome the timescale limitations of standard simulations, particularly when high energy barriers separate important states or when rare events need to be sampled efficiently. They often involve modifying the potential energy surface, using multiple simulation copies, or applying biasing forces."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000845 "enhanced sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000845 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000845 obo:MOLSIM_000843)

# Class: obo:MOLSIM_000846 (adaptive force bias)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000846 "An enhanced sampling method that gradually builds up a force opposing the system's own along a chosen coordinate, until the system moves along that coordinate freely. Once the opposing force matches the true one, the barriers along that coordinate have been flattened. The accumulated force is itself the answer, because it gives the free energy profile. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000846 "adaptive force bias"@en)
SubClassOf(obo:MOLSIM_000846 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000847 (canonical adiabatic free energy sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000847 "Canonical adiabatic free energy sampling refers to enhanced sampling strategies where system parameters or constraints are changed very slowly (adiabatically) during a simulation performed under constant NVT conditions. It splits a system into a \"subsystem\" (the reactive part) and an \"environment\". By introducing fictitious masses and decoupling the subsystem, it allows the subsystem to evolve slowly and adiabatically on the potential of mean force while operating at a much higher temperature than the environment, speeding up rare events without altering the physical ensemble."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000847 "canonical adiabatic free energy sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000847 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000847 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000848 (forward flux simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000848 "Forward Flux Sampling (FFS) is an enhanced sampling technique specifically designed to calculate rate constants and characterize pathways for rare events, such as transitions between stable molecular states. It involves defining a series of non-overlapping interfaces along a reaction coordinate between the initial and final states. Trajectories are initiated from these interfaces and only propagated forward if they reach the next interface, efficiently focusing computational effort on successful transition paths."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000848 "forward flux simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000848 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000848 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000849 (locally enhanced sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000849 "Locally Enhanced Sampling (LES) is a computational method used in molecular dynamics to accelerate the simulation of specific, localized regions of a molecule, such as a ligand binding site or a specific protein segment. It achieves this by introducing multiple non-interacting copies of the \"enhanced\" atoms while proportionately reducing their interaction potentials."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000849 "LES"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000849 "locally enhanced sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000849 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000849 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000850 (markov chain model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000850 "A statistical model of a system that moves between discrete states, in which the next state depends only on the current one and not on how the system arrived there. That assumption is what makes long-timescale behaviour computable from short observations. It holds only if the states are chosen so that everything relevant about the past is captured by which state the system is in. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000850 "markov chain model"@en)
SubClassOf(obo:MOLSIM_000850 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000851 (max-flux approach)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000851 "The max-flux approach in molecular systems typically refers to a variational method used to calculate the most probable reaction pathway during a transition (like conformational changes or chemical reactions). It finds the path that maximizes the diffusive flux of distinct reactive trajectories between two metastable states."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000851 "max-flux approach"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000851 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000851 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000852 (metadynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000852 "Metadynamics is an enhanced sampling technique that accelerates the exploration of complex energy landscapes by adding a history-dependent bias potential along a few chosen collective variables (CVs). Small repulsive energy 'hills' (often Gaussian functions) are periodically deposited at the system's current location in the CV space, discouraging revisiting explored areas and eventually filling up free energy wells. The accumulated bias potential provides an estimate of the free energy surface along the selected CVs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000852 "metadynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000852 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000852 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000853 (milestoning)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000853 "Milestoning sampling (or the milestoning algorithm) is an advanced molecular simulation technique designed to calculate the kinetics and thermodynamics of slow, complex processes (such as protein folding or drug binding). It breaks down computationally expensive simulations into multiple, short, independent trajectories between predefined interfaces, or \"milestones\"."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000853 "milestoning"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000853 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000853 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000854 (multi-state bennett acceptance ratio)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000854 "A free energy analysis method that combines data from simulations run at many thermodynamic states at once, and returns the free energy difference between any pair of them together with equilibrium averages. It uses every sample from every state rather than only neighbouring pairs, which is what makes it statistically optimal. It generalises the 2-state Bennett acceptance ratio. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000854 "multi-state bennett acceptance ratio"@en)
SubClassOf(obo:MOLSIM_000854 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000855 (neural network)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000855 "A machine learning model built from layers of simple units, each combining its inputs and passing the result on, whose connection strengths are adjusted to fit training data. Given enough units it can represent almost any relationship, which is why it is used where no formula is known. In this field it is used to predict energies and forces, and to find useful coordinates automatically. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000855 "neural networks"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000855 "neural network"@en)
SubClassOf(obo:MOLSIM_000855 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000856 (nudged elastic band)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000856 "The Nudged Elastic Band (NEB) method is primarily used to find the Minimum Energy Path (MEP) connecting two known stable states (e.g., reactant and product) on a potential energy surface. It works by optimizing a discrete chain of intermediate structures (images) linking the start and end points. Forces acting on the images perpendicular to the path are minimized, while spring forces along the path ensure continuity, guiding the chain towards the MEP, including the transition state."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000856 "NEB"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000856 "nudged elastic band"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000856 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000856 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000857 (reference potential spatial warping)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000857 "An enhanced sampling method that speeds up sampling by transforming the coordinates, or modifying the potential energy, using a simpler reference potential as the guide. The transformation flattens barriers that the reference potential also has, leaving the difference between the 2 to be sampled. Results are then corrected back to the true potential. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000857 "reference potential spatial warping"@en)
SubClassOf(obo:MOLSIM_000857 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000858 (replica-exchange molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000858 "Replica-exchange molecular dynamics (REMD), also known as parallel tempering, is an enhanced sampling technique that runs multiple simulations (replicas) of the same system in parallel, typically each at a different temperature. At regular intervals, attempts are made to swap the current configurations between pairs of replicas running at adjacent temperatures, accepted based on a probability criterion. This allows configurations explored at high temperatures (overcoming energy barriers) to diffuse down to lower temperatures, enhancing conformational sampling."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000858 "REMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000858 "replica-exchange molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000858 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000858 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000859 (steered dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000859 "Steered Molecular Dynamics (sMD) is a simulation technique where an external, time-dependent force or constraint is applied to manipulate the system, often by pulling on specific atoms or controlling the distance between groups. This forces the system along a chosen pathway, allowing exploration of processes like ligand unbinding or protein monomerization-multimerization that might not occur spontaneously on simulation timescales. sMD trajectories can also be used with fluctuation theorems (like Jarzynski's equality) to estimate equilibrium free energy differences."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000859 "steered dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000859 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000859 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000860 (string method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000860 "A computational method that finds the most likely route between 2 stable states of a system, described in terms of a few chosen coordinates. It represents the route as a line of points and repeatedly moves them downhill in energy while keeping them evenly spaced along it. The line settles onto the path the system is most likely to take, which is rarely a straight one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000860 "string method"@en)
SubClassOf(obo:MOLSIM_000860 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000861 (swarm-of-trajectories)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000861 "The swarm-of-trajectories approach refers to computational strategies that utilize a large number of independent, often relatively short, MD simulations launched from specific initial conditions. This \"swarm\" allows for efficient statistical sampling of pathways, transition probabilities between states, or average forces needed in methods like the String Method or Milestoning. It contrasts with relying on a single, very long trajectory to observe events of interest."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000861 "swarm-of-trajectories"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000861 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000861 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000862 (targeted molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000862 "Targeted Molecular Dynamics (TMD) is a simulation technique used to induce a conformational transition between a known initial structure and a known target structure. It achieves this by adding an extra potential energy term that biases the system to reduce its root-mean-square deviation (RMSD) relative to the target structure over the course of the simulation. TMD provides a plausible pathway for the transition, although not necessarily the minimum energy or most probable one."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000862 "TMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000862 "targeted molecular dynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000862 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000862 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000863 (transition path sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000863 "Transition Path Sampling (TPS) is a powerful simulation technique designed to study rare transition events between stable molecular states by directly sampling the ensemble of reactive pathways connecting them. Starting with one known reactive trajectory, it uses a Monte Carlo sampling in path space (generating new trial paths from old ones) to explore the set of all possible transition mechanisms without needing predefined reaction coordinates. TPS allows for the calculation of rate constants and detailed mechanistic analysis."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000863 "TPS"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000863 "transition path sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000863 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000863 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000864 (transition state ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000864 "The Transition State Ensemble (TSE) refers to the collection of molecular configurations that lie at the top of the highest free energy barrier separating the reactant and product states of a process, such as protein folding or a chemical reaction. Structures within the TSE are equally likely to proceed forward to the product state or revert back to the reactant state (i.e., they have a committor probability of 0.5). Characterizing the structural features of the TSE is key to understanding the mechanism of the transition."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000864 "TSE"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000864 "transition state ensembles"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000864 "transition state ensemble"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000864 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000864 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000865 (transition interface sampling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000865 "Transition Interface Sampling (TIS) is a path sampling technique, related to Forward Flux Sampling, used for calculating rate constants of rare events. It involves defining interfaces along an order parameter and then specifically sampling ensembles of trajectories that start in the reactant state and reach a particular interface, or start at one interface and reach the next. By calculating the crossing probabilities between interfaces, TIS reconstructs the overall rate constant."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000865 "TIS"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000865 "transition interface sampling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000865 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000865 obo:MOLSIM_000845)

# Class: obo:MOLSIM_000866 (ADF input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000866 "An input file format that carries the keywords and data blocks instructing the Amsterdam Density Functional software how to perform a quantum chemical calculation. It specifies details like the desired computational task (e.g., geometry optimization, frequency calculation), the molecular geometry, the choice of density functional and basis set, and other calculation parameters. The format uses specific ADF keywords and block structures (e.g., ATOMS, GEOMETRY). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000866 "ADF input format"@en)
SubClassOf(obo:MOLSIM_000866 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000867 (CHARMM input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000867 "A CHARMM input file is a script containing a sequence of commands written in the CHARMM scripting language, which directs the CHARMM program to perform various tasks. These tasks can range from reading topology and coordinate files, setting up system parameters, running energy minimizations or molecular dynamics simulations, to analyzing results."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000867 "CHARMM input format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000867 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000867 obo:MOLSIM_000438)

# Class: obo:MOLSIM_000868 (GAMESS input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000868 "An input file format that instructs the GAMESS (US) quantum chemistry program, structured into groups identified by keywords starting with '$', such as $CONTRL, $BASIS and $DATA. Within these groups, keywords specify the type of calculation (e.g., RUNTYP=OPTIMIZE), the theoretical method (e.g., SCFTYP=RHF), basis set, molecular geometry, and other computational details. The format follows specific Fortran namelist-like conventions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000868 "GAMESS input format"@en)
SubClassOf(obo:MOLSIM_000868 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000869 (GAMESS-UK input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000869 "A text data format that specifies a molecular system and the settings for a quantum chemistry calculation to the GAMESS-UK program, using directives such as TITLE, RUNTYPE, GEOMETRY and BASIS. Its keywords and layout differ substantially from those of the separate GAMESS (US) program, so files are not interchangeable between them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000869 "GAMESS-UK input format"@en)
SubClassOf(obo:MOLSIM_000869 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000870 (gjf format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000870 "An input file format that instructs the Gaussian quantum chemistry software, carrying the extension .com or .gjf. It characteristically includes a 'route section' (starting with #) containing keywords that define the theoretical method, basis set, and calculation type (e.g., optimization, frequency), followed by a title section, charge and spin multiplicity, and the molecular geometry. The structure is highly standardized within the Gaussian ecosystem. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000870 "GAUSSIAN com format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000870 "GAUSSIAN gjf format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000870 "gjf format"@en)
SubClassOf(obo:MOLSIM_000870 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000871 (GROMACS input  format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000871 "In GROMACS, the primary molecular dynamics input file usually has an .mdp extension and contains keyword-value pairs defining the simulation parameters. Processed by the grompp tool, it controls aspects like the integration algorithm, timestep, simulation length, temperature and pressure coupling methods, and cutoff schemes. This file dictates how the MD simulation engine (mdrun) will execute the run."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000871 "GROMACS input format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000871 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000871 obo:MOLSIM_002065)

# Class: obo:MOLSIM_000872 (HyperChem hin format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000872 "A data format, written with the extension .hin, that is the native way the HyperChem modelling package stores a molecular system. It holds atomic coordinates, connectivity, force field atom types, and settings for a calculation. It serves both as input to the program and as the way a session is saved. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000872 "HyperChem hin format"@en)
SubClassOf(obo:MOLSIM_000872 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000873 (Jaguar input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000873 "An input file format that carries the instructions for a quantum chemistry calculation in Jaguar, part of the Schrodinger suite. It uses a specific syntax with data sections delimited by &section_name (e.g., &gen, &zmat) and terminated by &, containing keywords and values controlling the calculation type, method, basis set, and molecular geometry. The structure facilitates setting up various QM tasks. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000873 "Jaguar input format"@en)
SubClassOf(obo:MOLSIM_000873 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000874 (MOPAC cartesian format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000874 "A data format specifying a molecule's geometry to the MOPAC semi-empirical program as 3 coordinates per atom. Each coordinate carries a flag saying whether it may be optimised or must be held fixed. That per-coordinate control is what distinguishes it from a plain coordinate list. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000874 "MOPAC cartesian format"@en)
SubClassOf(obo:MOLSIM_000874 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000875 (MOPAC internal format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000875 "A data format specifying a molecule's geometry to the MOPAC semi-empirical program as bond lengths, angles and rotations. As with its coordinate counterpart, each value carries a flag saying whether it may be optimised. It is the form used when a particular bond or angle must be scanned or held. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000875 "MOPAC internal format"@en)
SubClassOf(obo:MOLSIM_000875 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000876 (NAMD configuration format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000876 "A NAMD configuration file, typically ending in .namd, contains parameters and commands that control a molecular dynamics simulation run using the NAMD software. It uses a keyword-value pair format, often leveraging Tcl scripting capabilities, to specify input files (structure, coordinates, parameters), simulation conditions (temperature, pressure, duration), and algorithms. This file dictates the entire simulation protocol."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000876 "NAMD configuration format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000876 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000876 obo:MOLSIM_002065)

# Class: obo:MOLSIM_000877 (NWChem input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000877 "An NWChem input file (.nw) uses directives and nested blocks to instruct the NWChem software package on performing computational chemistry tasks. It is composed of commands, called directives, which define data (such as basis sets, geometries, and filenames) and the actions to be performed on that data. Directives are processed in the order presented in the input file, with the exception of certain start-up directives (see Input File Structure) which provide critical job control information, and are processed before all other input. Most directives are specific to a particular module and define data that is used by that module only. A few directives (see Top-level Directives) potentially affect all modules, for instance by specifying the total electric charge on the system."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000877 "NWChem input format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000877 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000877 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000878 (Q-Chem input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000878 "An input file format that instructs the Q-Chem quantum chemistry program, using data blocks marked by $block_name and $end. Key blocks include $molecule (defining charge, multiplicity, and geometry), $rem (specifying calculation method, basis set, job type via keywords), and potentially others like $basis or $opt. This structure organizes the input required for a wide range of QM calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000878 "Q-Chem input format"@en)
SubClassOf(obo:MOLSIM_000878 obo:MOLSIM_000437)

# Class: obo:MOLSIM_000879 (ADF output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000879 "A text data format in which the Amsterdam Density Functional program records a completed calculation. It holds the input as read back, the convergence history, the final energy with its breakdown into physically meaningful components, and the computed properties. That energy decomposition is what distinguishes it from other quantum chemistry output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000879 "ADF output format"@en)
SubClassOf(obo:MOLSIM_000879 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000880 (RKF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000880 "A structured binary file format generated by the Amsterdam Density Functional package, written with the extension .rkf and formerly called ADF Tape41. It stores a comprehensive set of calculation results, including basis set details, molecular orbital coefficients, electron densities, gradients, and potentially Hessians, in a key-value database format. This file is essential for advanced analysis, visualization, and restarting calculations. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000880 "ADF Tape41 format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000880 "ADF rkf format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000880 "RKF format"@en)
SubClassOf(obo:MOLSIM_000880 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000881 (CHARMM output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000881 "The CHARMM output file is the main text log generated during a CHARMM run, typically containing an echo of the input script commands interspersed with the results produced by those commands. This includes detailed energy breakdowns, progress information during dynamics or minimization (like step number, time, temperature, pressure, energies), and outputs from analysis routines. It serves as the primary record of the CHARMM job execution."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000881 "CHARMM output format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000881 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000881 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000882 (GAMESS output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000882 "A text data format, written with the extension .log or .out, in which the GAMESS (US) program records a completed calculation. It holds the input as read back, the basis set and geometry, convergence progress for the SCF or geometry optimisation, final energies, molecular orbital information and calculated properties. It is the file results are extracted from. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000882 "GAMESS output format"@en)
SubClassOf(obo:MOLSIM_000882 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000883 (GAMESS-UK output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000883 "A text data format in which the GAMESS-UK program records a completed calculation, including the input as read back, convergence progress, final energies and calculated properties. Its structure and keywords differ from those of the separate GAMESS (US) program, so a parser written for one will not read the other. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000883 "GAMESS-UK output format"@en)
SubClassOf(obo:MOLSIM_000883 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000884 (GAUSSIAN log format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000884 "A text data format, written with the extension .log, in which the Gaussian program records a completed calculation. It holds setup information, convergence progress, final energies, molecular orbital details, properties such as dipole moments and charges, and vibrational and thermochemical results when those were requested. A compact summary called the archive entry sits near the end. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000884 "GAUSSIAN log format"@en)
SubClassOf(obo:MOLSIM_000884 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000885 (GROMACS output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000885 "The GROMACS MD output typically refers to the primary text log file (.log) generated by the mdrun simulation engine. It contains summary information about the simulation setup, detailed performance data (like PME load balancing and timings), step-by-step progress updates (if configured in the .mdp file), and final run statistics including energy averages and runtime. This file is crucial for monitoring performance and verifying run completion."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000885 "GROMACS output format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000885 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000885 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000886 (Jaguar output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000886 "A text data format, written with the extension .out, in which the Jaguar program records a completed calculation. It holds the input parameters, convergence information for the SCF and geometry optimisation cycles, final energies, properties such as charges and dipole moments, and vibrational frequencies when requested. The final geometry is usually written to a separate structure file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000886 "Jaguar output format"@en)
SubClassOf(obo:MOLSIM_000886 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000887 (MOPAC output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000887 "An output file format holding the results of a calculation performed by the MOPAC semi-empirical program, written with the extension .out. It typically includes an echo of the input keywords, details of geometry optimization steps (if performed), the final optimized geometry, the calculated heat of formation (ΔH f), ionization potential, dipole moment, and atomic charges. A summary section usually highlights the key results and timings. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000887 "MOPAC output format"@en)
SubClassOf(obo:MOLSIM_000887 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000888 (NWChem output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000888 "A text data format, written with the extension .out or .nwout, in which the NWChem program records the tasks its input file requested. It holds the calculation setup, convergence progress, energies from whichever quantum, molecular mechanics or combined method was used, properties and timings. Because the program accepts very varied inputs, the layout of the file varies with them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000888 "NWChem output format"@en)
SubClassOf(obo:MOLSIM_000888 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000889 (Q-Chem output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000889 "A text data format, written with the extension .out or .qcout, in which the Q-Chem program records a completed calculation. It holds the method and basis set used, convergence information for the SCF and geometry optimisation, final electronic energies, molecular orbital information, and properties such as charges and dipole moments. A summary section usually collects the main computed values. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000889 "Q-Chem output format"@en)
SubClassOf(obo:MOLSIM_000889 obo:MOLSIM_000439)

# Class: obo:MOLSIM_000890 (GAUSSIAN chk format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000890 "A binary checkpoint file format that stores the state of a completed or running Gaussian calculation, including the molecular geometry, basis set details, molecular orbital coefficients, density matrix and forces. It is essential for restarting interrupted calculations (especially geometry optimizations or frequency calculations) and for post-processing tasks like generating cube files or performing wavefunction analysis. It can be converted to a formatted version (.fchk). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000890 "GAUSSIAN chk format"@en)
SubClassOf(obo:MOLSIM_000890 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000891 (GAUSSIAN restart format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000891 "A binary data format, written with the extension .chk, in which Gaussian stores the state of a calculation so that a later job can continue from it. It holds the geometry, the wavefunction and Hessian information. A later job reads it when the input asks for it, for example with Geom=Checkpoint or Guess=Read. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000891 "GAUSSIAN restart format"@en)
SubClassOf(obo:MOLSIM_000891 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000892 (GROMACS restart format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000892 "A binary data format, written with the extension .cpt, in which GROMACS stores the complete state of a running simulation at intervals. It holds the step number, the time, the positions, the velocities, the box and the state of the thermostat and barostat. Resuming from it continues the run exactly, as though it had never stopped. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000892 "GROMACS restart format"@en)
SubClassOf(obo:MOLSIM_000892 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000893 (NWChem restart format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000893 "Restarting an NWChem calculation involves using various files generated during a previous run, depending on the calculation type. This may include the run database (.db), molecular orbital vector files (.movecs), geometry files, or specific QM/MM restart files (.rst)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000893 "NWChem restart format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000893 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000893 obo:MOLSIM_000441)

# Class: obo:MOLSIM_000894 (mdfrc format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000894 "A data format that stores the force on every atom of a system at each saved step of an AMBER simulation. It records forces where a trajectory format records positions. It is used for debugging a force field and for analyses that need the forces themselves. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000894 "AMBER mdfrc format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000894 "mdfrc format"@en)
SubClassOf(obo:MOLSIM_000894 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000895 (gro format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000895 "The GROMACS .gro file is a simple, formatted text file used to store molecular coordinates, atom/residue names, and optionally velocities. It includes a title line, the total number of atoms, and then one line per atom specifying residue and atom information, coordinates (in nanometers), and optionally velocities. The file concludes with the periodic box vectors. It is typically used to store single structures."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000895 "GROMACS gro format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000895 "gro format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000895 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000895 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000896 (TINKER xyz format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000896 "A specialized text-based file format used by the TINKER software package. While it shares the '.xyz' extension with the standard Cartesian coordinate format, it is distinct in that it explicitly includes atom indices, force field atom types, and connectivity (bond) lists for every atom, serving as both a coordinate and topology file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000896 "TINKER xyz format"@en)
SubClassOf(obo:MOLSIM_000896 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000897 (TURBOMOLE coordinate format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000897 "A data format used by TURBOMOLE to record atomic coordinates, written as a labelled section inside the program's control file rather than as a separate file. It lists Cartesian coordinates, in atomic units unless another unit is stated, followed by the element of each atom. Keeping it inside the control file is why a TURBOMOLE job is a directory rather than a single file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000897 "TURBOMOLE coordinate format"@en)
SubClassOf(obo:MOLSIM_000897 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000898 (itp format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000898 "A GROMACS include topology file (.itp) contains the topology definition for a specific type of molecule (like a protein, lipid, or solvent). It typically includes sections like [ moleculetype ], [ atoms ], [ bonds ], etc., and is designed to be reusable. These .itp files are incorporated into the main system topology (.top) file using the #include directive."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000898 "GROMACS include topology format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000898 "GROMACS itp format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000898 "itp format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000898 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000898 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000899 (top format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000899 "A topology file format that describes an entire molecular system to be simulated with GROMACS, written with the extension .top. It typically starts by including force field parameter files and specific molecule topology files (.itp) using #include directives. Crucially, it concludes with a [ molecules ] section listing the names and counts of each type of molecule present in the simulation box. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000899 ".top")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000899 "GROMACS system topology format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000899 "GROMACS top format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000899 "top format"@en)
SubClassOf(obo:MOLSIM_000899 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000900 (NWChem topology format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000900 "A data format specifying the topology of a system to NWChem, written as labelled sections inside the program's input file rather than as a separate file. It gives the atoms, their types and charges, and the force field to apply. Keeping it in the input file is why an NWChem calculation is described by 1 file rather than 2. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000900 "NWChem topology format"@en)
SubClassOf(obo:MOLSIM_000900 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000901 (PSF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000901 "A Protein Structure File (.psf) defines the atoms, connectivity (bonds, angles, dihedrals, impropers), and basic atomic properties (like type indices, charges, masses) for a molecular system. Importantly, it does not contain the actual force field parameters. PSF files are used by the simulation programs CHARMM and NAMD."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000901 "PSF format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000901 orcid:0000-0002-2294-5393)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_000901 "The format originates with X-Plor. Recorded here rather than in the definition, which was verified on 2026-09-18 without it. Source: EDAM 1.25, class format_3882 PSF (http://edamontology.org/format_3882)."@en)
SubClassOf(obo:MOLSIM_000901 obo:MOLSIM_001091)

# Class: obo:MOLSIM_000902 (dcd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000902 "The DCD (.dcd) trajectory format is a widely used binary file format for storing atomic coordinates from molecular dynamics simulations, optionally including periodic box information. Originally developed for CHARMM, it is now supported by many simulation packages (like NAMD, LAMMPS) and analysis tools (like VMD) due to its efficiency and portability."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000902 "dcd format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000902 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000902 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000903 (GROMACS trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000903 "A binary data format in which GROMACS records the positions of atoms through a simulation, in either a compressed form holding coordinates only or a full form holding velocities and forces as well. The compressed form discards low-order digits to save space, which is acceptable for analysis and not for restarting a run. Which was written determines what the trajectory can afterwards be used for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000903 "GROMACS trajectory format"@en)
SubClassOf(obo:MOLSIM_000903 obo:MOLSIM_001090)

# Class: obo:MOLSIM_000904 (molecular structure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000904 "A molecular structure is the information that specifies the three-dimensional arrangement of atoms in a molecule. It is typically represented by a list of atomic coordinates (X, Y, Z) for each atom in the system. This structural information is the fundamental input for visualization and is the starting point for any molecular simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000904 "molecular structure"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000904 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000904 obo:MOLSIM_001073)

# Class: obo:MOLSIM_000905 (small molecule structure (deprecated))

AnnotationAssertion(owl:deprecated obo:MOLSIM_000905 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000905 "OBSOLETE. Small molecule structure formats are designed primarily for representing organic and drug-like molecules, often emphasizing chemical details like bond orders, formal charges, and stereochemistry. These formats are widely used in cheminformatics, drug discovery databases, and as input for various modeling tasks. Common examples include SDF, Mol2, and SMILES strings."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000905 "obsolete small molecule structure"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000905 "Retired in the file-format flattening. Classifying structure formats by molecule size was an artificial distinction: a small molecule can be stored in a PDB file and a macromolecule in a mol2 file. Its former children are now direct children of 'molecular structure format' (MOLSIM:001088). Reported in GitHub issue #20."@en)

# Class: obo:MOLSIM_000906 (Mol2 format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000906 "The Mol2 format (.mol2) is a text-based file format originating from Sybyl software, commonly used to represent small molecules, especially in docking and cheminformatics applications. It stores atomic coordinates, atom names, connectivity (including bond orders), partial charges, and often uses specific Sybyl atom types. A single Mol2 file can contain multiple molecular structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000906 "Mol2 format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000906 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000906 obo:MOLSIM_001088)
DisjointClasses(obo:MOLSIM_000906 obo:MOLSIM_000907)

# Class: obo:MOLSIM_000907 (SDF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000907 "The Structure-Data File (SDF, .sdf) format is widely used in cheminformatics for storing libraries of small molecules along with associated data. It essentially consists of multiple blocks defining atomic coordinates and connectivity for each molecule concatenated together, where each block can be followed by data fields like IDs or calculated properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000907 "SDF format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000907 orcid:0000-0002-2294-5393)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_000907 "The format was developed by MDL Information Systems. Recorded here rather than in the definition, which was verified on 2026-09-18 without it. Source: EDAM 1.25, class format_3814 SDF (http://edamontology.org/format_3814)."@en)
SubClassOf(obo:MOLSIM_000907 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000908 (sequence data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000908 "Sequence formats are standardized ways to represent the primary structure of biological macromolecules, such as the order of amino acids in a protein or nucleotides in DNA/RNA, using strings of characters. These formats usually include a header line providing an identifier and description, followed by the sequence itself using standard codes (e.g., one-letter codes). They are fundamental in bioinformatics for storing and exchanging sequence data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000908 "sequence data format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000908 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000908 obo:MOLSIM_000436)

# Class: obo:MOLSIM_000909 (volumetric data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000909 "A data format that stores a property varying continuously through 3-dimensional space, such as electron density or electrostatic potential, as values on a regular grid of points. A file in one of these formats states the grid's origin, its dimensions and its spacing, then lists a value for each point. They are used to visualize and analyse spatial distributions from simulation or from experiment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000909 "volumetric data format"@en)
SubClassOf(obo:MOLSIM_000909 obo:MOLSIM_000436)

# Class: obo:MOLSIM_000910 (general data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000910 "General data formats are versatile, often standardized ways to structure and exchange data that are not tied to a specific application domain like molecular simulation. Formats like XML or JSON use tags or key-value pairs to create hierarchical and self-describing data structures. They are sometimes employed in simulation contexts for storing metadata, configuration, or for facilitating data exchange between different tools."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000910 "general data format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000910 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000910 obo:MOLSIM_000436)

# Class: obo:MOLSIM_000911 (analysis script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000911 "A script holding the sequence of commands that an analysis program or library carries out on simulation data. It records exactly what was computed and in what order, so an analysis can be repeated. It is often the only surviving record of how a published number was obtained. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000911 "analysis script"@en)
SubClassOf(obo:MOLSIM_000911 obo:MOLSIM_001074)

# Class: obo:MOLSIM_000912 (FASTA format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000912 "The Fasta format is a simple and widely used text-based format for storing biological sequence data (nucleotides or amino acids). Each sequence entry begins with a single-line description header, marked by a greater-than symbol ('>'), followed by the sequence data on one or more subsequent lines. Its simplicity makes it easily readable by humans and parsable by many bioinformatics tools."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000912 "FASTA format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000912 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000912 obo:MOLSIM_000908)

# Class: obo:MOLSIM_000913 (cube format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000913 "A text data format storing a property sampled on a regular 3-dimensional grid, together with the positions of the atoms it surrounds. It states the grid's origin, its axes and its spacing, then lists one value per point. Electron density, electrostatic potential and molecular orbitals are all distributed in it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000913 "GAUSSIAN cube format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000913 "cube format"@en)
SubClassOf(obo:MOLSIM_000913 obo:MOLSIM_000909)

# Class: obo:MOLSIM_000914 (XML format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000914 "XML (Extensible Markup Language) is a flexible, text-based markup language used to encode data in a format that is both human-readable and machine-readable. It uses user-defined tags to structure data hierarchically with elements and attributes. XML is widely used for data exchange on the web and in various scientific domains, including bioinformatics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000914 "XML format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000914 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000914 obo:MOLSIM_000910)

# Class: obo:MOLSIM_000915 (CML format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000915 "A data format, built on XML, that records chemical information as structured, labelled text. It defines tags for molecular structures, reactions, spectra and calculation results, so that a file states what each number is rather than relying on position. Its purpose is exchange between programs that would otherwise each need a reader for the others' formats. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000915 "CML format"@en)
SubClassOf(obo:MOLSIM_000915 obo:MOLSIM_000914)

# Class: obo:MOLSIM_000916 (Ptraj script format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000916 "A text data format holding a sequence of commands for the ptraj or cpptraj trajectory analysis programs of AmberTools. A file in this format names the input trajectories with trajin, may name a reference structure, and then lists analysis commands such as rms, distance, hbond, radgyr or cluster. It is the record of how a trajectory was post-processed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000916 "Ptraj script format"@en)
SubClassOf(obo:MOLSIM_000916 obo:MOLSIM_000438)

# Class: obo:MOLSIM_000917 (structural analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000917 "A category of analysis methods focused on examining the three-dimensional arrangement of atoms (geometry and conformation) and the overall shape and topology of molecules based on simulation data or optimized structures. This includes measuring geometric parameters (distances, angles, dihedrals), identifying characteristic local and global structural features, comparing structures, and quantifying structural fluctuations. It helps understand molecular architecture, flexibility, stability, and structure-function relationships."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000917 "structural analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000917 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000917 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000918 (global structure analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000918 "OBSOLETE. A structural analysis focusing on the overall architecture, shape, fold, and packing of a macromolecule or molecular complex, rather than fine details. This is often characterized by metrics like the radius of gyration, principal moments of inertia, overall dimensions, secondary structure content (for proteins), or tertiary arrangement of domains. It provides a macroscopic view of the molecule's conformation and large-scale structural changes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000918 "obsolete global structure analysis"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_000918 "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000918 "Retired because it grouped nothing: the analyses its definition named (radius of gyration, principal moments of inertia, secondary structure) are siblings under MOLSIM:000917 structural analysis, not subclasses of this term. Raised in the August 2026 definition review.")

# Class: obo:MOLSIM_000921 (crd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000921 "A generic name for a text-based file format that stores the Cartesian (x, y, z) coordinates of atoms in a molecular system. The specific layout can vary, as multiple simulation packages like CHARMM and Amber have their own distinct versions of a \".crd\" file. Due to its ambiguity, it is often necessary to specify which software's CRD format is being used."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000921 "crd format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000921 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000921 obo:MOLSIM_001088)

# Class: obo:MOLSIM_000923 (local structure analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000923 "A structural analysis focusing on the detailed geometric arrangement of small groups of atoms within a molecule. This includes analyzing specific bond lengths, bond angles, dihedral angles, ring conformations (like sugar pucker), hydrogen bonding patterns, or the conformation of amino acid side chains. It provides fine-grained insights into specific interactions, conformational preferences, and flexibility at the atomic or residue level."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000923 "local structure analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000923 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000923 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000924 (atom triplet angle calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000924 "A fundamental local structure analysis that calculates the angle formed by three specified atoms (A-B-C), centered on atom B. These bond angles are essential parameters defining the geometry and shape of molecules. Monitoring their values and distributions during simulations reveals information about molecular flexibility and conformational preferences around specific centers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000924 "atom triplet angle calculation analysis"@en)
SubClassOf(obo:MOLSIM_000924 obo:MOLSIM_000923)

# Class: obo:MOLSIM_000925 (dihedral calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000925 "A local structure analysis technique that calculates the torsion angle defined by four sequentially bonded atoms (A-B-C-D), representing the rotation around the central bond (B-C). Dihedral angles are critical for determining the three-dimensional conformation of flexible molecules, including protein backbones, side chains, and polymer chains. Analyzing their values and distributions reveals accessible rotational states and conformational dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000925 "dihedral calculation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000925 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000925 obo:MOLSIM_000923)

# Class: obo:MOLSIM_000926 (distance calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000926 "A basic local structure analysis technique that measures the distance between any two specified atoms (bonded or non-bonded) in a molecular system. Monitoring distances is essential for tracking bond lengths, identifying close contacts, analyzing non-covalent interactions (like hydrogen bonds, salt bridges, van der Waals contacts), and assessing overall conformational changes or molecular dimensions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000926 "distance calculation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000926 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000926 obo:MOLSIM_000923)

# Class: obo:MOLSIM_000927 (pucker analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000927 "A specialized local structure analysis used to describe and quantify the non-planar conformation (puckering) of cyclic molecular fragments, particularly five-membered (e.g., furanose rings in DNA/RNA, proline) or six-membered rings (e.g., pyranose rings, cyclohexane). It employs parameters like pseudorotation angles and amplitudes to precisely define the ring's shape (e.g., envelope, twist, chair, boat conformations). This analysis is vital for understanding the structure and function of nucleic acids and carbohydrates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000927 "pucker analysis"@en)
SubClassOf(obo:MOLSIM_000927 obo:MOLSIM_000923)

# Class: obo:MOLSIM_000928 (atomic properties analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000928 "A type of structural analysis focusing on quantifying properties associated with individual atoms within the molecular structure, often reflecting their local environment or dynamics. Examples include atomic fluctuations (Root Mean Square Fluctuation, RMSF, or B-factors) indicating mobility, solvent accessibility surface area (SASA) quantifying exposure to solvent, or coordination numbers describing the local packing density. Analyzing these properties provides atom-specific insights into dynamics, interactions, and structural roles. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000928 "atomic properties analysis"@en)
SubClassOf(obo:MOLSIM_000928 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000936 (amber OL24)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000936 "A refined set of force field parameters specifically developed to improve the accuracy of DNA simulations using the AMBER force field. It provides an updated description of the sugar-pucker torsional potential, which is critical for correctly capturing the conformational equilibrium between A-form and B-form DNA. These parameters are intended as an update to be used in conjunction with a parent protein-DNA force field like ff14SB. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000936 "AMBER OL24"@en)
SubClassOf(obo:MOLSIM_000936 obo:MOLSIM_000010)

# Class: obo:MOLSIM_000937 (structure clustering analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000937 "An analysis method that groups the structures in a trajectory by how similar they are, usually measured by the distance between them after superposition. It reduces thousands of frames to a handful of representative shapes. Those representatives are what a trajectory is usually described and pictured by. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000937 "structure clustering analysis"@en)
SubClassOf(obo:MOLSIM_000937 obo:MOLSIM_000123)

# Class: obo:MOLSIM_000938 (structure clustering with dihedral binning)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000938 "A specialized structure clustering approach where conformations are grouped primarily based on the values of selected dihedral angles, rather than overall coordinate RMSD. Structures are assigned to bins based on which ranges their key dihedral angles fall into, and clusters are formed by grouping structures within the same or similar bins. This method is particularly useful for analyzing conformational changes driven by specific torsions, like backbone transitions or sidechain rotations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000938 "structure clustering with dihedral binning"@en)
SubClassOf(obo:MOLSIM_000938 obo:MOLSIM_000937)

# Class: obo:MOLSIM_000939 (dynamics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000939 "Dynamics analysis involves processing the time-series data generated from molecular dynamics simulations, primarily the trajectory files, to extract quantitative information and insights about the system's behavior. This encompasses a wide range of techniques aimed at understanding molecular motions, conformational changes, interactions, and kinetic or thermodynamic properties. The goal is to translate raw simulation output into meaningful physical or biological understanding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000939 "dynamics analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000939 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000939 obo:MOLSIM_000004)
SubClassOf(obo:MOLSIM_000939 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000940 (AMBER force field parameter format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000940 "A text-based file format used by the AMBER software suite to store standard force field parameters. These files (historically using the .dat extension) contain the equilibrium values and force constants for bonds, angles, dihedrals, and non-bonded interactions for specific atom types. They serve as the central parameter database loaded by system-building tools like LEaP. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000940 "AMBER dat format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000940 "AMBER force field parameter format"@en)
SubClassOf(obo:MOLSIM_000940 obo:MOLSIM_002066)

# Class: obo:MOLSIM_000941 (coordinate rotation modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000941 "A coordinate rotation method is a structure modification method that applies a mathematical rotation to the coordinates of a molecule or a group of atoms. This procedure changes the orientation of the selected atoms in three-dimensional space without altering their internal structure."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000941 "coordinate rotation modeling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000941 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_000941 obo:MOLSIM_000305)

# Class: obo:MOLSIM_000942 (time cross correlation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000942 "A dynamics analysis method that measures how the fluctuations of 2 different properties relate to each other over time, including at a time delay. A positive value means they rise and fall together, a negative value means one rises as the other falls, and near zero means they are independent. The delay at which the relationship is strongest shows which motion leads and which follows. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000942 "time cross correlation analysis"@en)
SubClassOf(obo:MOLSIM_000942 obo:MOLSIM_000342)

# Class: obo:MOLSIM_000943 (RMSD correlation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000943 "A dynamics analysis method that measures how the displacement of each atom or residue from its average position relates to that of every other, over the course of a simulation. A strongly positive value means 2 sites move in the same direction, a negative value means they move in opposite directions. The result is usually drawn as a dynamic cross-correlation map, which shows which parts of a molecule move as one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000943 "is it synonymous as \"atomic correlation analysis\"?")
AnnotationAssertion(rdfs:label obo:MOLSIM_000943 "RMSD correlation analysis"@en)
SubClassOf(obo:MOLSIM_000943 obo:MOLSIM_000342)

# Class: obo:MOLSIM_000944 (motion analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000944 "Motion analysis encompasses techniques used to characterize the types, directions, and magnitudes of movements occurring within a molecular system during a simulation. These methods aim to simplify the complex, high-dimensional atomic motions into understandable patterns or dominant modes. This helps identify functionally relevant conformational changes, flexibility, and collective dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000944 "motion analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000944 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000944 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000945 (principal axis alignment analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000945 "A structural analysis method that superposes structures by matching their principal axes of inertia rather than by minimising the distance between corresponding atoms. It aligns on overall mass distribution and shape, so it is unaffected by local differences that would dominate a least-squares fit. It suits comparisons of rotational motion and of overall shape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000945 "principal axis alignment analysis"@en)
SubClassOf(obo:MOLSIM_000945 obo:MOLSIM_000944)

# Class: obo:MOLSIM_000946 (coordinate projection analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000946 "A dynamics analysis method that maps the many-dimensional motion in a trajectory onto 1 or a few chosen directions. The chosen direction may be a simple geometric measure such as a distance or an angle, or a vector taken from principal component analysis. Projecting this way reduces a trajectory to a small number of curves that can be read directly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000946 "coordinate projection analysis"@en)
SubClassOf(obo:MOLSIM_000946 obo:MOLSIM_000944)

# Class: obo:MOLSIM_000947 (eigenmode analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000947 "A dynamics analysis method that decomposes the motion of a molecular system into a set of independent collective modes, each with a characteristic amplitude or frequency. Principal component analysis applied to a trajectory and normal mode analysis applied to a single structure are the 2 standard ways of obtaining them. The modes show the principal directions in which a molecule moves. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000947 "eigenmode analysis"@en)
SubClassOf(obo:MOLSIM_000947 obo:MOLSIM_000944)

# Class: obo:MOLSIM_000948 (diffusion analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000948 "A type of dynamics analysis focused on quantifying the random translational and rotational movement of molecules or particles within the simulation environment due to thermal energy. It primarily involves calculating diffusion coefficients, which measure the rate at which particles spread out over time. This analysis provides insights into transport properties, viscosity, and mobility in fluids, membranes, or crowded cellular environments. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000948 "diffusion analysis"@en)
SubClassOf(obo:MOLSIM_000948 obo:MOLSIM_000939)

# Class: obo:MOLSIM_000949 (diffusion calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000949 "An analysis method that extracts a diffusion coefficient from a trajectory, most often by tracking how the mean squared displacement of the molecules grows with time. Over long enough times that growth is linear, and its slope gives the coefficient. Reading a slope from too short a stretch of trajectory is the usual way this measurement goes wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000949 "diffusion calculation analysis"@en)
SubClassOf(obo:MOLSIM_000949 obo:MOLSIM_000948)

# Class: obo:MOLSIM_000950 (energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000950 "A type of structural analysis focused on calculating and interpreting the potential energy associated with specific molecular structures or conformations obtained from simulations or modeling. This includes calculating single point energies, comparing energies of different conformers, or decomposing the total energy into contributing components. It helps assess the stability and likelihood of different structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000950 "energy analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000950 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000950 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000951 (binding energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000951 "An energy analysis quantity representing the net energy change associated with the formation of a molecular complex from its individual, separated components in a specific reference state (e.g., gas phase or solution). It typically refers to the difference in potential energy or free energy between the bound complex and the unbound molecules, indicating the strength of the association (a more negative value implies stronger binding). Various computational methods (QM, MM-PBSA/GBSA) can estimate binding energies, sometimes including entropic and solvation effects (binding free energy). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000951 "binding energy analysis"@en)
SubClassOf(obo:MOLSIM_000951 obo:MOLSIM_000950)

# Class: obo:MOLSIM_000952 (MM-PBSA analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000952 "A widely used computational method for estimating the binding free energy of a molecular complex, particularly for large biomolecules like protein-ligand systems. It combines molecular mechanics (MM) energies calculated from simulation snapshots with continuum solvation models, specifically using the Poisson-Boltzmann (PB) equation to calculate electrostatic solvation energy and a surface area (SA) term for nonpolar solvation energy. It averages results over multiple simulation snapshots to implicitly include entropic effects related to conformation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000952 "MM-PBSA analysis"@en)
SubClassOf(obo:MOLSIM_000952 obo:MOLSIM_010025)

# Class: obo:MOLSIM_000953 (MM-GBSA analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000953 "A computational method for estimating binding free energies, similar to MM-PBSA, that also combines molecular mechanics (MM) energies with continuum solvation and surface area (SA) terms. However, it uses the Generalized Born (GB) model, an approximation to the Poisson-Boltzmann equation, to calculate the electrostatic solvation energy. The GB model is generally computationally faster than PB, making MM-GBSA efficient for large-scale calculations like virtual screening, though potentially less accurate in some cases. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000953 "MM-GBSA analysis"@en)
SubClassOf(obo:MOLSIM_000953 obo:MOLSIM_010025)

# Class: obo:MOLSIM_000954 (interaction energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000954 "An energy analysis term usually referring to the direct potential energy change when two or more molecules or fragments are brought together from infinite separation to their geometry within the complex, calculated using a specific theoretical level (MM or QM). It typically represents the sum of direct electrostatic and van der Waals (or quantum mechanical equivalents like electrostatics, exchange-repulsion, induction, dispersion) interactions between the components in the fixed complex geometry. It often excludes contributions from the energy required to distort the fragments upon binding and solvation effects, representing a key component of the total binding energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000954 "interaction energy analysis"@en)
SubClassOf(obo:MOLSIM_000954 obo:MOLSIM_000951)

# Class: obo:MOLSIM_000955 (hydrogen bond interaction energies analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000955 "A specific type of interaction energy analysis focused on quantifying the energetic contribution of individual or collective hydrogen bonds within or between molecules. This can be estimated using specialized energy decomposition schemes, analysis of electrostatic and van der Waals terms between donor-hydrogen-acceptor atoms from a force field, or derived from quantum mechanical calculations. Quantifying H-bond energies helps understand their role in stabilizing structures and mediating molecular recognition. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000955 "hydrogen bond interaction energies analysis"@en)
SubClassOf(obo:MOLSIM_000955 obo:MOLSIM_000954)

# Class: obo:MOLSIM_000956 (base pair stacking energies analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000956 "A specific interaction energy analysis quantifying the stabilizing energetic contribution from the non-covalent interactions (primarily van der Waals/dispersions and electrostatics) between adjacent nucleobases (DNA, RNA). These interactions occur between the aromatic base rings and are essential for the stability, geometry, and mechanical properties of nucleic acid structures. Stacking interaction energies are commonly estimated using quantum mechanical methods or specially parameterized molecular mechanics force fields."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000956 "base pair stacking energies analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000956 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000956 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_000956 obo:MOLSIM_000954)

# Class: obo:MOLSIM_000963 (AMBER crd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000963 "This refers to one of the file formats used by Amber to store atomic coordinates. Its extension is commonly .inpcrd, .crd or .mdcrd. It contains a list of coordinates in ASCII, usually read alongside a topology file, and may optionally include periodic box information."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000963 "AMBER inpcrd format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000963 "AMBER prmcrd format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_000963 "Amber's standard ASCII coordinate trajectory file format. The \"Coordinates Data Set\" or \"COORDS\" in Amber is not a file format, but rather a specialized, in-memory data structure used by the cpptraj analysis program. It is designed to efficiently hold and manipulate sets of coordinate frames (i.e., structures) loaded from trajectory files during an analysis session. Since the COORDS data set is an internal, in-memory representation, it does not have a file extension. Users can interact with it using file-based commands: Loading: users populate a COORDS data set by loading data from standard Amber file formats, such as restart files (.rst7), PDB files, or trajectory files (.nc, .mdcrd), using the loadcrd command. Saving: users write the contents of a COORDS data set to a file using the crdout command. The output will be in a standard coordinate or trajectory format (e.g., Amber restart, PDB, etc.), not a special \"COORDS format.\""@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000963 "AMBER crd format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000963 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000963 obo:MOLSIM_000921)

# Class: obo:MOLSIM_000974 (solvent analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000974 "A category of analysis methods focused specifically on characterizing the structure, dynamics, and properties of the solvent molecules (most commonly water) surrounding a solute molecule within a simulation. This includes examining solvent density and distribution around the solute, analyzing hydrogen bonding networks within the solvent and between solvent and solute, calculating residence times of solvent molecules near the solute, and assessing the overall impact of the solvent on solute behavior. It provides crucial insights into solvation phenomena. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000974 "solvent analysis"@en)
SubClassOf(obo:MOLSIM_000974 obo:MOLSIM_000026)

# Class: obo:MOLSIM_000975 (water shell analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000975 "A concept within hydration analysis referring to concentric layers of water molecules surrounding a solute, typically defined based on distance thresholds from the solute atoms or surface. Analysis focuses on characterizing the properties of water within specific shells (e.g., first, second hydration shell), including the number of water molecules (coordination number), their average density, preferred orientations, hydrogen bonding patterns, and residence times compared to bulk water. This provides a structured way to describe the local solvent environment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000975 "water shell analysis"@en)
SubClassOf(obo:MOLSIM_000975 obo:MOLSIM_000983)

# Class: obo:MOLSIM_000976 (radial distribution analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000976 "A fundamental distribution analysis method that calculates the probability of finding a particle (e.g., a solvent atom like oxygen) at a given distance 'r' from a central reference point (e.g., a solute atom or the solute's center of mass), relative to the probability expected for a uniform distribution at that distance. The resulting function, the radial distribution function or RDF, often denoted g(r), typically shows peaks corresponding to ordered solvation shells and decays to 1 at large distances (bulk solvent). Integration of the first peak gives the average coordination number in the first solvation shell. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000976 "radial distribution analysis"@en)
SubClassOf(obo:MOLSIM_000976 obo:MOLSIM_000984)

# Class: obo:MOLSIM_000978 (conformation validation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000978 "A specific type of validation technique focused on assessing the quality of the three-dimensional arrangement of atoms (the conformation) in simulated biomolecules. It evaluates whether the molecular geometry, including bond lengths, angles, and steric arrangements, is plausible according to known chemical and physical rules. This ensures the structural models generated or sampled during a simulation are stereochemically sound. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000978 "conformation validation analysis"@en)
SubClassOf(obo:MOLSIM_000978 obo:MOLSIM_000353)
DisjointClasses(obo:MOLSIM_000978 obo:MOLSIM_000981)

# Class: obo:MOLSIM_000979 (ramachandran analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000979 "A widely used graphical tool for conformation validation specifically applied to proteins. It plots the distribution of backbone dihedral angles (phi and psi) for each amino acid residue, allowing visualization of whether these angles fall into sterically allowed or disallowed regions. This provides a crucial check for the quality and realism of the protein backbone structure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000979 "ramachandran analysis"@en)
SubClassOf(obo:MOLSIM_000979 obo:MOLSIM_000917)
DisjointClasses(obo:MOLSIM_000979 obo:MOLSIM_000980)

# Class: obo:MOLSIM_000980 (structural check analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000980 "A form of conformation validation that involves examining various geometric features of a biomolecular structure beyond just backbone torsion angles. This may include verifying appropriate bond lengths, bond angles, checking for unrealistic close contacts between atoms (clashes), or assessing other stereochemical parameters against standard values. It serves as a general quality control measure for the overall molecular model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000980 "structural check analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000980 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000980 obo:MOLSIM_000978)

# Class: obo:MOLSIM_000981 (secondary structure assignment analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000981 "Refers to the regular, local folding patterns occurring within the backbone of polymers like proteins or nucleic acids, such as alpha-helices and beta-sheets in proteins. These structures are defined by specific patterns of hydrogen bonds between backbone atoms and represent key building blocks of the molecule's overall three-dimensional architecture. While not a technique itself, analyzing secondary structure content and stability is often part of simulation validation and analysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000981 "secondary structure assignment analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000981 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000981 obo:MOLSIM_000917)

# Class: obo:MOLSIM_000982 (secondary structure changes analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000982 "Refers to the dynamic transformations or fluctuations observed in the secondary structure elements of a biomolecule during a simulation or over time. Monitoring these changes, such as the formation or dissolution of helices or sheets, provides insights into molecular flexibility, folding pathways, or responses to interactions. Analyzing these dynamics helps understand how molecular function relates to structural transitions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000982 "secondary structure changes analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000982 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_000982 obo:MOLSIM_000981)

# Class: obo:MOLSIM_000983 (hydration analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000983 "A specific type of solvent analysis focusing on the direct interaction of water molecules with a solute molecule. It involves characterizing the arrangement, orientation, dynamics, and energetics of water molecules in the immediate vicinity of the solute, often referred to as the hydration shell(s). Understanding hydration patterns is critical as these interfacial water molecules strongly influence the solute's structure, stability, dynamics, and interactions with other molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000983 "hydration analysis"@en)
SubClassOf(obo:MOLSIM_000983 obo:MOLSIM_000974)

# Class: obo:MOLSIM_000984 (distribution analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000984 "A solvent analysis technique focused on determining the average spatial arrangement or probability density of solvent molecules relative to the solute molecule, averaged over a simulation trajectory. This often involves calculating various distribution functions (e.g., radial, spatial, or angular) that quantify how the likelihood of finding a solvent molecule varies with position and/or orientation around the solute. It reveals preferred solvation sites and the overall structure of the solvent environment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000984 "distribution analysis"@en)
SubClassOf(obo:MOLSIM_000984 obo:MOLSIM_000974)

# Class: obo:MOLSIM_000985 (matrix diagonalization analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000985 "A core mathematical technique from linear algebra used to simplify a square matrix by finding its characteristic values (eigenvalues) and directions (eigenvectors), effectively transforming it into a diagonal matrix. In biomolecular simulations, this is heavily used in methods like Principal Component Analysis (PCA) to identify dominant modes of collective atomic motion from covariance matrices, or in Normal Mode Analysis (NMA) to find vibrational frequencies from Hessian matrices. Diagonalization reveals the fundamental components or modes underlying complex data or system dynamics. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000985 "matrix diagonalization analysis"@en)
SubClassOf(obo:MOLSIM_000985 obo:MOLSIM_000383)

# Class: obo:MOLSIM_000986 (coarse-grained elastic mesoscopic model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000986 "A coarse-grained model in which groups of atoms, or whole residues, are represented as beads joined by simple springs. The springs are chosen to reproduce the overall shape and flexibility of the assembly rather than any chemistry, so the model can cover structures far too large to simulate atom by atom. What it can show is how the parts move relative to each other; what it cannot show is anything that depends on a specific chemical group. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000986 "coarse-grained elastic mesoscopic model"@en)
SubClassOf(obo:MOLSIM_000986 obo:MOLSIM_000475)

# Class: obo:MOLSIM_000987 (coarse-grained worm-like chain)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000987 "A coarse-grained model that treats a polymer as a bendable filament described by 2 numbers: its total length, and the distance over which it stays pointing the same way. In a simulation it is built as a chain of beads whose bond and angle terms reproduce those 2 numbers. It is how DNA is modelled when what matters is how it coils and loops rather than which base is where. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000987 "coarse-grained worm-like chain"@en)
SubClassOf(obo:MOLSIM_000987 obo:MOLSIM_000475)

# Class: obo:MOLSIM_000988 (complementary techniques for MD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000988 "Experimental or computational methods used alongside Molecular Dynamics (MD) simulations to provide synergistic information, validate simulation accuracy, or compute properties challenging for standard MD alone. These techniques bridge simulation results with real-world measurements or provide deeper thermodynamic or structural insights. They help build a more comprehensive understanding of the molecular system under study."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000988 "complementary techniques for MD"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000988 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000988 obo:MOLSIM_000304)

# Class: obo:MOLSIM_000989 (nuclear overhauser effect)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000989 "An experimental Nuclear Magnetic Resonance (NMR) phenomenon that arises from the through-space dipolar coupling between nearby nuclear spins (commonly protons), used as a complementary technique to MD. Detecting NOEs allows measurement of short inter-proton distances (typically < 6 Å), providing crucial experimental restraints for determining or validating biomolecular structures and conformational ensembles in solution. MD simulations can be used to predict NOEs for comparison with experiments or refined using experimental NOE data."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000989 "NOE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000989 "nuclear overhauser effect (NOE)"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_000989 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_000989 obo:MOLSIM_000988)
DisjointClasses(obo:MOLSIM_000989 obo:MOLSIM_000990)

# Class: obo:MOLSIM_000990 (small-angle scattering)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000990 "An experimental technique, either using X-rays (SAXS) or neutrons (SANS), where radiation is scattered by molecules in solution at low angles, providing information complementary to MD simulations. The resulting scattering profile is sensitive to the overall size, shape, and quaternary structure (oligomerization) of the molecules, averaged over the entire ensemble present in the sample. SAS data provides valuable low-resolution structural information that can be used to validate conformational ensembles generated by MD or to guide modeling of large-scale structures. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000990 "SAS"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000990 "small-angle scattering"@en)
SubClassOf(obo:MOLSIM_000990 obo:MOLSIM_000988)

# Class: obo:MOLSIM_001008 (spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001008 "Spectroscopy is the study of how matter interacts with energy, particularly electromagnetic radiation like light. By analyzing how energy is absorbed, emitted, or scattered by a substance, we can learn about its atomic and molecular structure, composition, and dynamics. It serves as a fundamental set of tools for observing the properties of molecules."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001008 "spectroscopy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001008 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001008 obo:MOLSIM_000304)

# Class: obo:MOLSIM_001009 (vibrational spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001009 "A spectroscopic technique that probes how the bonds in a molecule stretch, bend and twist, by measuring absorption in the infrared or scattering of visible light. Each vibration has a frequency set by the masses involved and the stiffness of the bond, so the spectrum reports on chemical structure. It is one of the few measurements a simulation can be compared against directly, because a force field predicts exactly those frequencies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001009 "vibrational spectroscopy"@en)
SubClassOf(obo:MOLSIM_001009 obo:MOLSIM_001008)

# Class: obo:MOLSIM_001010 (infrared spectra)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001010 "A spectrum recording how strongly a sample absorbs infrared light across a range of frequencies. Absorption occurs where the frequency matches a molecular vibration that changes the molecule's dipole, so the positions of the bands identify chemical groups. It is directly comparable with frequencies computed from a force field or a quantum calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001010 "infrared spectra"@en)
SubClassOf(obo:MOLSIM_001010 obo:MOLSIM_001009)

# Class: obo:MOLSIM_001011 (raman spectra)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001011 "A spectrum recording the small shift in frequency of light scattered by a sample, which reveals the vibrations that took or gave energy to the photons. It responds to vibrations that change the molecule's polarizability, which are largely different from those infrared absorption sees. The 2 techniques are therefore complementary rather than alternatives. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001011 "raman spectra"@en)
SubClassOf(obo:MOLSIM_001011 obo:MOLSIM_001009)

# Class: obo:MOLSIM_001012 (pre-resonance raman spectra)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001012 "A spectrum recorded with the illuminating light tuned close to, but not at, a frequency the sample absorbs. Approaching an absorption greatly enhances the scattering from vibrations connected with it, so a chosen part of a large molecule dominates the spectrum. Staying short of the absorption avoids the sample being heated or damaged. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001012 "pre-resonance raman spectra"@en)
SubClassOf(obo:MOLSIM_001012 obo:MOLSIM_001009)

# Class: obo:MOLSIM_001013 (vibrational circular dichroism)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001013 "A spectroscopic technique measuring the difference in infrared absorption between left and right circularly polarized light. Only molecules that are not superimposable on their mirror images show such a difference, and the sign of each band reveals which form is present. It reports on 3-dimensional structure in solution, where ordinary infrared absorption reports only on which groups are there. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001013 "vibrational circular dichroism"@en)
SubClassOf(obo:MOLSIM_001013 obo:MOLSIM_001009)

# Class: obo:MOLSIM_001014 (electronic spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001014 "A spectroscopic technique that probes transitions of electrons between energy levels, usually driven by ultraviolet or visible light. The energy absorbed or emitted reports on the spacing of those levels, which depends on bonding and conjugation. It is how colour, fluorescence and photochemical behaviour are studied. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001014 "electronic spectroscopy"@en)
SubClassOf(obo:MOLSIM_001014 obo:MOLSIM_001008)

# Class: obo:MOLSIM_001015 (UV/visible spectra)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001015 "A spectrum recording how strongly a sample absorbs light across the ultraviolet and visible range, as a function of wavelength. Absorption occurs where the photon energy matches a gap between electronic levels, so the positions of the bands report on bonding and conjugation. It is the measurement a computed electronic transition is compared against. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001015 "UV/Vis"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001015 "UV/visible spectra"@en)
SubClassOf(obo:MOLSIM_001015 obo:MOLSIM_001014)

# Class: obo:MOLSIM_001016 (electronic transition band shape)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001016 "A property giving the full profile of an absorption or emission band in an electronic spectrum, including its width and any structure within it, rather than only where its peak lies. The width reports how much the molecule's geometry changes when it absorbs light, and the structure within it reveals individual vibrations. A calculation matching only the peak position can still be wrong about both. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001016 "electronic transition band shape"@en)
SubClassOf(obo:MOLSIM_001016 obo:MOLSIM_001014)

# Class: obo:MOLSIM_001017 (magnetic spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001017 "A spectroscopic technique that probes the magnetic behaviour of nuclei or unpaired electrons, by observing how they respond in an applied magnetic field. The response depends on the local environment of each spin, which is what makes it report on structure. Nuclear magnetic resonance and electron paramagnetic resonance belong here. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001017 "magnetic spectroscopy"@en)
SubClassOf(obo:MOLSIM_001017 obo:MOLSIM_001008)

# Class: obo:MOLSIM_001018 (antiferromagnetic coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001018 "An interaction between nearby unpaired electron spins that favours their pointing in opposite directions. The paired arrangement has lower energy than the aligned one, so the system has little or no net magnetism. It occurs between metal centres in many metalloproteins and determines their magnetic signature. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001018 "antiferromagnetic coupling"@en)
SubClassOf(obo:MOLSIM_001018 obo:MOLSIM_001017)

# Class: obo:MOLSIM_001019 (hyperfine coupling tensor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001019 "A 3-by-3 array describing how strongly an electron spin interacts with a nearby nuclear spin, and how that strength depends on direction. Its directional part reports where the unpaired electron sits relative to the nucleus. It is what electron paramagnetic resonance spectra are interpreted through. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001019 "hyperfine spectra tensors"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001019 "hyperfine coupling tensor"@en)
SubClassOf(obo:MOLSIM_001019 obo:MOLSIM_001017)

# Class: obo:MOLSIM_001020 (rotational spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001020 "A spectroscopic technique that probes transitions between a molecule's rotational energy levels, almost always in the gas phase where molecules turn freely. The spacing of the levels depends on how the molecule's mass is distributed, so the spectrum gives bond lengths and angles very precisely. It is among the most accurate structural measurements available and works only for small molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001020 "rotational spectroscopy"@en)
SubClassOf(obo:MOLSIM_001020 obo:MOLSIM_001008)

# Class: obo:MOLSIM_001021 (vibration-rotation coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001021 "An interaction between a molecule's vibration and its rotation, arising because a vibrating molecule changes shape and so changes how easily it turns. It means the 2 motions cannot be treated as independent. It shows in a spectrum as a shift in rotational line spacing that depends on which vibrational state the molecule is in. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001021 "vibration-rotation coupling"@en)
SubClassOf(obo:MOLSIM_001021 obo:MOLSIM_001020)

# Class: obo:MOLSIM_001022 (chiroptical spectroscopy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001022 "A spectroscopic technique that measures how a sample responds differently to left and right circularly polarized light. Only molecules that are not superimposable on their mirror images give such a difference, so these techniques report on handedness. Optical rotation, circular dichroism and Raman optical activity belong here. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001022 "specialized techniques"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001022 "chiroptical spectroscopy"@en)
SubClassOf(obo:MOLSIM_001022 obo:MOLSIM_001008)

# Class: obo:MOLSIM_001023 (raman optical activity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001023 "A spectroscopic technique that measures the small difference in scattered light intensity when a chiral sample is illuminated with left and right circularly polarized light. The difference is roughly one part in a thousand, so the measurement is difficult. It is sensitive to the 3-dimensional arrangement of a molecule in solution, which few other techniques report on directly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001023 "raman optical activity"@en)
SubClassOf(obo:MOLSIM_001023 obo:MOLSIM_001022)

# Class: obo:MOLSIM_001024 (optical rotation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001024 "The turning of the plane of polarized light as it passes through a sample of molecules that are not superimposable on their mirror images. The direction and size of the turn depend on which mirror form is present and in what excess. It is how the handedness of a sample is measured, and computing it correctly is a demanding test of a quantum method. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001024 "optical rotations"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001024 "optical rotation"@en)
SubClassOf(obo:MOLSIM_001024 obo:MOLSIM_001022)

# Class: obo:MOLSIM_001032 (running average calculation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001032 "A running average calculation is a statistical analysis technique used to smooth out short-term fluctuations in time-series data and highlight longer-term trends. It is calculated by averaging a property over a sliding time window as the simulation progresses. For simulation experts, monitoring the running average of properties like the total energy or temperature is a standard method for assessing whether a simulation has reached a stable equilibrium. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001032 "running average calculation analysis"@en)
SubClassOf(obo:MOLSIM_001032 obo:MOLSIM_000400)

# Class: obo:MOLSIM_001037 (GROMOS configuration format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001037 "A text-based file format used by the GROMOS simulation software to store the complete configuration of a molecular system. It is organized into data blocks (e.g., POSITION, VELOCITY, BOX) and contains atomic coordinates, periodic box dimensions, and optionally velocities. This format typically uses the .cnf file extension and is the primary input for coordinates in GROMOS simulations. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001037 "cnf format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001037 "g96 format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001037 "GROMOS configuration format"@en)
SubClassOf(obo:MOLSIM_001037 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001038 (MPDyn crd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001038 "A file format for the MPDyn simulation program that stores the atomic coordinates of a molecular system. This format contains the x, y, and z positions for each atom, structured for use with the MPDyn software package. It provides the essential structural input for running simulations with MPDyn. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001038 "MPDyn crd format"@en)
SubClassOf(obo:MOLSIM_001038 obo:MOLSIM_000921)

# Class: obo:MOLSIM_001039 (trj format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001039 "The .trj format is an ASCII (text-based) trajectory file format used by the Amber molecular dynamics software suite and other analysis programs. Its fundamental purpose is to store a time-series of atomic coordinates, capturing the dynamic motion of a system during a simulation. The file contains sequential \"frames\" where each frame is a complete set of X, Y, and Z coordinates for every atom in the system at a specific point in time. It can also store periodic box dimensions, although this capability is sometimes limited."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001039 "AMBER trj format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001039 "The .trj format belongs to a family of older Amber text-based trajectory formats. Its role is best understood in comparison to its relatives: vs. .mdcrd: The .trj and .mdcrd formats are functionally identical. Both are safe, relatively unambiguous choices for storing Amber ASCII trajectories. A file with one extension can often be renamed to the other without causing issues in analysis software. vs. .crd: The .crd extension is highly ambiguous and problematic. It is the native format for the CHARMM simulation package and is interpreted as such by default in many tools. Using .trj avoids this critical format conflict. vs. .nc (NetCDF): The NetCDF format is the modern, binary, and recommended format for Amber trajectories. Compared to .trj, NetCDF (.nc) files are smaller, faster to read/write, and store data with higher precision. The .trj format is considered a legacy option."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001039 "trj format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001039 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001039 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001040 (distance matrix format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001040 "A distance matrix in molecular simulation is a 2D data set that stores the pairwise distances between a selection of particles, such as atoms or residues, calculated from a simulation trajectory. It is a common form of analysis used to study conformational changes, structural stability, and the relative movement of different parts of a molecule."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001040 "Common examples include: - General Text Formats: Often saved as plain text (.txt), comma-separated values (.csv), or a generic data (.dat) file for easy parsing and use in other programs. - Program-Specific Formats: Some simulation packages output the matrix in their own specific formats. For example, GROMACS can generate a distance matrix as an .xpm file, which is a portable pixmap image format. - Binary Formats: For efficiency, especially with large matrices, they may be saved in binary formats like NumPy's .npy format, which is common in Python-based analysis workflows."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001040 "distance matrix format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001040 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001040 obo:MOLSIM_010020)

# Class: obo:MOLSIM_001041 (xpm  format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001041 "A text data format that stores a 2-dimensional matrix, such as a distance matrix, an RMSD matrix or a hydrogen bond pattern, by encoding each value as a character standing for a colour. It is a specialised use of the general XPixMap image format, so an ordinary image viewer can open it. GROMACS writes it and converts it to PostScript with gmx xpm2ps. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001041 ".xpm")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001041 "GROMACS xpm format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001041 "XPM format"@en)
SubClassOf(obo:MOLSIM_001041 obo:MOLSIM_001040)

# Class: obo:MOLSIM_001042 (prmtop format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001042 "A text data format that holds the complete static description of a molecular system for an AMBER simulation: its atoms, the bonds between them, the force field parameters that govern their interactions, and their partial charges. It carries everything the simulation engine needs except the coordinates, which come from a separate file. It is read once at the start of a run and does not change during it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001042 "AMBER parmtop format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001042 "AMBER prmtop format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001042 "parm7 format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001042 "AMBER PARM7 format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001042 "AMBER parm7 format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001042 "prmtop format"@en)
SubClassOf(obo:MOLSIM_001042 obo:MOLSIM_000472)

# Class: obo:MOLSIM_001043 (parm7 format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001043 "OBSOLETE. A file format from the Amber simulation software that describes the structure and force field parameters of a molecule. This is the traditional, ASCII-based version of the Amber parameter/topology file, containing all information needed to calculate forces on the system. It is often used interchangeably with the prmtop format."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001043 "AMBER PARM7 format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001043 "AMBER parm7 format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001043 "obsolete parm7 format"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001043 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001043 obo:MOLSIM_001042)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001043 "Retired 2026-08-07 as an internal duplicate of MOLSIM:001042 prmtop format. ParmEd writes one Amber topology format under two extensions, .prmtop and .parm7, so these were never two formats. Both terms also carried skos:exactMatch to the same EDAM term, EDAM:format_3881 AMBER top, which is what surfaced the duplication. prmtop survives because it is the name that actually occurs in practice: 19 occurrences against 0 for parm7 in the AMBER keyword corpus this ontology was extracted from. Its names are kept as exact synonyms on MOLSIM:001042."@en)

# Class: obo:MOLSIM_001044 (CIF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001044 "The Crystallographic Information File (cif) format is a standard text-based file format used to store information about molecular structures, especially those determined by experiments. It uses a flexible tag-based structure with key-value pairs, making it more robust and extensible for handling the large, complex structures and extensive metadata common in modern structural biology. As the official format of the Protein Data Bank (PDB), the macromolecular CIF (mmCIF) variant has superseded the older PDB format for archiving and distributing 3D coordinates of proteins and nucleic acids."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001044 "CIF format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001044 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001044 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001045 (arc format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001045 "A file format used by the TINKER simulation package to store the trajectory of a molecular system. It archives the atomic coordinates from different snapshots of a simulation in a single file for later analysis. This is the standard trajectory output for TINKER simulations. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001045 ".arc")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001045 "TINKER arc format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001045 "This can also be a coordinate format from Tinker package as well.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001045 "arc format"@en)
SubClassOf(obo:MOLSIM_001045 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001046 (original residue number)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001046 "The original residue number is the number assigned to an amino acid in the original experimental data file. As a type of identifier, it represents the residue number as it appeared in the source file, typically a PDB file, before any renumbering may have occurred during simulation setup. This is crucial for mapping simulation results back to the standard numbering used in publications and other databases, especially when multiple chains or insertions are present."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001046 "oresnums")
AnnotationAssertion(rdfs:comment obo:MOLSIM_001046 "The residue number as it appeared in the original input (e.g., PDB) file"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001046 "original residue number"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001046 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001046 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001047 (chain ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001047 "A chain ID is a letter used to label different polymer molecules, like different protein chains, in a structure file. The chain ID usually has a limited number of characters like in the PDB format (1) or in mmCIF and PSF formats (4). It is an essential part of the atom selection syntax in analysis tools, allowing for targeting of specific molecules in a system."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001047 "chainid"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001047 "An identifier used in PDB files to distinguish different polymer chains."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001047 "chain ID"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001047 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001047 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001048 (insertion code)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001048 "An insertion code is a letter used in PDB and mmCIF structure files when extra amino acids have been inserted into a sequence without renumbering every residue after the insertion, thus allowing multiple residues to share the same residue number. This code is critical for unambiguously identifying specific residues in atom selections (e.g. residue \"10A\" is distinct from \"10B\"). This is referred to in PDB files as \"icode\"."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001048 "icodes"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001048 "A character used in PDB files to handle insertions in a sequence."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001048 "insertion code"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001048 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001048 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001049 (rst format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001049 "A file format from the Amber software that saves the state of a simulation in plain text, allowing the run to be continued later. It contains the atomic coordinates, velocities, and periodic box dimensions at a specific point in time, in a human-readable form. The same ASCII format is written under several extensions, including .rst, .rst7 and .restrt. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001049 "rst7 format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001049 "restrt format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001049 "rst format"@en)
SubClassOf(obo:MOLSIM_001049 obo:MOLSIM_000471)

# Class: obo:MOLSIM_001050 (rst7 format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001050 "OBSOLETE. A text-based file format from the Amber software that saves the state of a simulation. It is the ASCII version of the Amber restart file, containing coordinates, velocities, and box information in a human-readable format. This format is often used for its portability and ease of inspection."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001050 "obsolete rst7 format"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001050 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001050 obo:MOLSIM_001049)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001050 "Retired 2026-08-07 as an internal duplicate of MOLSIM:001049 rst format. ParmEd writes one Amber ASCII coordinate format under several extensions, .rst7, .restrt and .inpcrd, so .rst and .rst7 were never two formats; the real division in this family is ASCII against the binary NetCDF MOLSIM:001051 ncrst format. Both terms also carried skos:closeMatch to the same EDAM term, EDAM:format_3886 RST, which is the pattern that surfaced the duplication. The curator chose rst as the surviving label; note that ParmEd itself does not write a .rst extension, so rst7 format and restrt format are kept as exact synonyms on MOLSIM:001049."@en)

# Class: obo:MOLSIM_001051 (ncrst format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001051 "A binary file format from the Amber software that saves the complete state of a simulation. It is a NetCDF-based version of the Amber restart file, storing coordinates, velocities, and box vectors with high precision. This is the modern, preferred format for restarting Amber simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001051 "A NetCDF-based restart file for Amber simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001051 "ncrst format"@en)
SubClassOf(obo:MOLSIM_001051 obo:MOLSIM_000471)

# Class: obo:MOLSIM_001052 (CHARMM crd format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001052 "CHARMM commonly uses coordinate files in its own CARD format (.crd), which is a formatted ASCII file including atom coordinates along with atom numbers, residue names/numbers, atom types, and possibly weighting factors. It often starts with a title section describing the system."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001052 "CHARMM crd format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001052 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001052 obo:MOLSIM_000921)

# Class: obo:MOLSIM_001053 (CHARMM cor format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001053 "A file format from the CHARMM simulation software that stores the atomic coordinates of a molecule. It is a binary, unformatted version of the CHARMM coordinate file, making it more compact and faster to read than its text-based counterpart. This format is often used for saving and reading structures within CHARMM workflows. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001053 "CHARMM cor format"@en)
SubClassOf(obo:MOLSIM_001053 obo:MOLSIM_000921)

# Class: obo:MOLSIM_001054 (trr trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001054 "A binary file format from the GROMACS software that stores the full-precision trajectory of a simulation. It saves the atomic coordinates, velocities, and forces at each time step without any loss of precision. This format is used instead of XTC format when high accuracy is needed for analysis."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001054 "GROMACS trr format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001054 "trr trajectory format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001054 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001054 obo:MOLSIM_000903)

# Class: obo:MOLSIM_001055 (XTC trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001055 "A compressed, binary file format from the GROMACS software for storing the trajectory of a molecular simulation. It uses a lossy compression algorithm to store atomic coordinates with reduced precision, resulting in much smaller file sizes. This is the most common trajectory format for GROMACS users when only atomic positions are needed for analysis. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001055 "GROMACS xtc format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001055 "XTC trajectory format"@en)
SubClassOf(obo:MOLSIM_001055 obo:MOLSIM_000903)

# Class: obo:MOLSIM_001056 (TNG trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001056 "A modern, binary file format from the GROMACS software used to store the results of a molecular simulation. It supports various compression algorithms and can store not only coordinates but also velocities, forces, and other trajectory data. This format is designed for high efficiency and flexibility in storing large simulation datasets. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001056 "GROMACS tng format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001056 "TNG trajectory format"@en)
SubClassOf(obo:MOLSIM_001056 obo:MOLSIM_000903)

# Class: obo:MOLSIM_001057 (SQM input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001057 "An input file format for the SQM program, which performs a type of quantum mechanical calculation. It contains keywords and molecular geometry specifications that control the semi-empirical quantum mechanics calculation within the AmberTools suite. This format is typically used for generating atomic charges for new molecules. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001057 ".sqm")
AnnotationAssertion(rdfs:comment obo:MOLSIM_001057 "An input file format for the semi-empirical QM program SQM."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001057 "SQM input format"@en)
SubClassOf(obo:MOLSIM_001057 obo:MOLSIM_000437)

# Class: obo:MOLSIM_001058 (dtr format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001058 "A binary file format used by the Desmond simulation software to store the trajectory of a molecular system. It efficiently stores atomic coordinates, velocities, and other data in a block-based structure. This is the native trajectory output format for simulations run with Desmond. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001058 ".dtr")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001058 "Desmond dtr format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001058 "A trajectory file format used by the Desmond simulation software."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001058 "dtr format"@en)
SubClassOf(obo:MOLSIM_001058 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001059 (conflib  format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001059 "A data format holding the set of conformations found by a low-mode conformational search, each with its energy. It is written as the search proceeds, so the accumulated results survive an interrupted run. It is read back to continue a search or to analyse the conformations found. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001059 ".conflib")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001059 "LMOD conflib format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001059 "conflib format"@en)
SubClassOf(obo:MOLSIM_001059 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001060 (MDTraj h5 format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001060 "A binary data format built on HDF5 in which the MDTraj library stores trajectories together with the topology they belong to. Keeping both in one file removes the usual need to supply a separate topology when reading a trajectory. It is the native format of that library rather than a community standard. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001060 ".h5")
AnnotationAssertion(rdfs:comment obo:MOLSIM_001060 "An HDF5-based trajectory file format used by the MDTraj library.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001060 "MDTraj h5 format"@en)
SubClassOf(obo:MOLSIM_001060 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001061 (H5MD format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001061 "A data format for molecular simulation data, defined as a community standard on top of the general-purpose HDF5 container. It specifies where positions, velocities, forces and metadata are placed, so any program following it can read another's output. It belongs to no single simulation program, which is what distinguishes it from the engine-specific formats. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001061 ".h5md")
AnnotationAssertion(rdfs:label obo:MOLSIM_001061 "H5MD format"@en)
SubClassOf(obo:MOLSIM_001061 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001062 (PQR format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001062 "The PQR format is a modification of the standard Protein Data Bank (PDB) format used in computational biology to store atomic coordinate data along with atomic partial charges (Q) and radii (R). The name itself is a mnemonic, representing PDB + Q (charge) + R (radius). Its primary advantage is that it bundles the necessary structural and electrostatic parameters into a single, PDB-like file that is easily parsed by both analysis software and molecular visualization programs. These files are most commonly generated by the PDB2PQR software, which processes a standard PDB file, adds missing hydrogen atoms, and assigns atomic charges and radii based on a chosen force field."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001062 ".pqr")
AnnotationAssertion(rdfs:label obo:MOLSIM_001062 "PQR format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001062 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001062 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001063 (MOE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001063 "The Molecular Operating Environment (MOE) is a comprehensive, commercial software system for drug discovery, molecular modeling, and computational chemistry developed by the Chemical Computing Group. It integrates visualization with a vast array of tools for structure preparation, docking, pharmacophore modeling, and molecular dynamics setup within a single unified interface."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001063 "Molecular Operating Environment"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001063 "MOE"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001063 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001063 obo:MOLSIM_000490)
SubClassOf(obo:MOLSIM_001063 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001064 (TIP3PFW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001064 "A water model with 3 sites whose bonds and angle can stretch and bend rather than being held rigid. Flexibility is needed when vibrational spectra are being computed, or when the model is combined with a method that cannot handle constraints. It forces a shorter timestep, because bond vibrations are the fastest motion in the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001064 "A flexible three-site water model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001064 "TIP3PFW"@en)
SubClassOf(obo:MOLSIM_001064 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001065 (SPCFW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001065 "A water model with 3 sites, derived from the SPC geometry, whose bonds and angle can stretch and bend. Its bonded parameters were refitted alongside the flexibility so that the liquid's density and diffusion stay correct. Making a rigid model flexible without refitting changes both. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001065 "A flexible three-site water model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001065 "SPCFW"@en)
SubClassOf(obo:MOLSIM_001065 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001066 (ptraj format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001066 "An output option of the secstruct command in cpptraj that writes secondary structure data as plain text laid out the way the older ptraj program wrote it. It is a formatting choice rather than a file type, so it fixes no file extension; the output goes to whatever filename the out directive gives. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001066 "CPPTRAJ ptraj format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001066 "ptraj format"@en)
SubClassOf(obo:MOLSIM_001066 obo:MOLSIM_010020)

# Class: obo:MOLSIM_001067 (xmgrace)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001067 "Xmgrace is a computer program used to make scientific graphs and plots from data. As a type of visualization tool, Xmgrace is a 2D plotting program for X Window Systems. Some simulation analysis tools, like GROMACS and cpptraj, can directly generate output files in a compatible format for easy plotting of time-series data like RMSD or energy. This tool is associated with file formats like .agr and .xvg."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001067 "xmgrace"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001067 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001067 obo:MOLSIM_002042)

# Class: obo:MOLSIM_001068 (gnuplot)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001068 "A visualization tool that draws 2-dimensional and 3-dimensional graphs from data files, driven from the command line or from a script. Because it is scriptable it can be called from an analysis pipeline to produce figures without a person present. It is one of the standard ways simulation output is plotted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001068 "gnuplot"@en)
SubClassOf(obo:MOLSIM_001068 obo:MOLSIM_002042)

# Class: obo:MOLSIM_001069 (visual molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001069 "A visualization program for displaying and animating molecular structures and trajectories in 3 dimensions. It handles systems of millions of atoms and includes a scripting language, so analyses can be run on what is being shown. It is the program most molecular dynamics trajectories are looked at in. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001069 "VMD")
AnnotationAssertion(rdfs:label obo:MOLSIM_001069 "visual molecular dynamics"@en)
SubClassOf(obo:MOLSIM_001069 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001070 (NMWiz)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001070 "A visualization plugin for VMD that draws and animates collective modes of motion from normal mode analysis or principal component analysis. It shows a mode as arrows on the structure, or as a trajectory moving along it. It turns an eigenvector into something that can be looked at. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001070 "A VMD plugin for visualizing and analyzing normal modes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001070 "NMWiz"@en)
SubClassOf(obo:MOLSIM_001070 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001071 (traj3d format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001071 "A data format that records a 3-dimensional histogram as though it were the path of a single particle, writing the 3 histogram dimensions as the x, y and z coordinates of 1 atom over successive frames. That trick lets a volumetric distribution, such as where water sits around a solute, be opened in a molecular viewer as a point cloud. It is produced by the hist command of cpptraj. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001071 "CPPTRAJ traj3d format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001071 "The traj3d \"pseudo-trajectory\" is not a standard, independent file format but rather a specialized output option available within the hist command in Amber's cpptraj analysis program. It is created by taking the three data dimensions of a 3D histogram and writing them out as the X, Y, and Z coordinates of a single \"atom\" over time. This reformatting creates a trajectory-like file that can be loaded into molecular visualization software. The purpose is to allow researchers to visually inspect the 3D distribution of data from the histogram in a more intuitive, interactive 3D space, rather than as a static 2D plot. There is no mandatory file extension for the output file itself."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001071 "traj3d format"@en)
SubClassOf(obo:MOLSIM_001071 obo:MOLSIM_001090)

# Class: obo:MOLSIM_001072 (information content entity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001072 "OBSOLETE. An information content entity is an abstract concept representing any piece of data, information, or knowledge that can be identified and described. In the context of simulations, it refers to the abstract data itself, such as the concept of a molecular structure or a simulation parameter set, separate from the specific file format used to store it. This distinction helps in organizing and standardizing the description of simulation data and metadata."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001072 "obsolete information content entity"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001072 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001072 obo:IAO_0000030)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001072 "Retired 2026-08-12 when MOLSIM adopted COB as its upper level. IAO:0000030 information content entity is one of COB's five roots and says the same thing, so keeping a MOLSIM class beside it was a duplicate. Its 8 direct children were re-parented onto IAO:0000030 in the same change; the 46 terms below them moved with their parents.")

# Class: obo:MOLSIM_001073 (molecular system specification)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001073 "A molecular system specification defines the physical and chemical properties of a molecule required for computational chemistry and quantum mechanical simulations. This specification is the complete informational blueprint of the system before any simulation is performed."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001073 "molecular system specification"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001073 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001073 obo:IAO_0000030)

# Class: obo:MOLSIM_001074 (process specification)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001074 "A process specification is the abstract set of instructions and parameters that define how a computational task, like a simulation or an analysis, should be performed. It represents the complete plan for the process, including the choice of algorithms, control settings, and input files. This specification must be recorded to ensure a computational experiment is reproducible."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001074 "process specification"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001074 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001074 obo:IAO_0000030)

# Class: obo:MOLSIM_001075 (process output)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001075 "An output file is generated by a computational program and contains the results of the calculation or simulation, along with logs, progress information, and any error messages. These files are crucial for analyzing the outcome of computational jobs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001075 "process output"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001075 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001075 obo:IAO_0000030)

# Class: obo:MOLSIM_001076 (molecular topology)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001076 "The description of what a molecular system is made of: its atoms, their types and charges, the bonds between them, and the force field parameters that apply. It does not change during a simulation, which is why it is kept separately from the coordinates. Without it, a set of coordinates is just a list of numbers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001076 "molecular topology"@en)
SubClassOf(obo:MOLSIM_001076 obo:MOLSIM_001073)

# Class: obo:MOLSIM_001077 (CHARMM topology format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001077 "A category of data formats used by the CHARMM simulation package to describe the molecular topology of a system. These formats define the atoms, connectivity, and the chemical nature of residues. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001077 "CHARMM topology format"@en)
SubClassOf(obo:MOLSIM_001077 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001078 (rtf format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001078 "A data format used by CHARMM that defines a reusable template for one chemical building block, such as an amino acid or a nucleotide. It gives the atoms in that block, their types and charges, the bonds between them, and their standard geometry. A topology for a whole molecule is assembled by joining these templates in sequence. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001078 "residue topology file (RTF) format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001078 "rtf format"@en)
SubClassOf(obo:MOLSIM_001078 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001079 (frcmod format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001079 "A text data format used by AMBER to supply force field parameters that are missing from the main parameter files, or to override ones that are present. It lets a user add parameters for a non-standard molecule without editing the distributed force field. It is read in addition to the main files rather than in place of them. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001079 "AMBER frcmod format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001079 "frcmod format"@en)
SubClassOf(obo:MOLSIM_001079 obo:MOLSIM_002066)

# Class: obo:MOLSIM_001080 (simulation parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001080 "The complete collection of settings that tells a program how to run one simulation, including the temperature and pressure to hold, how long to run, how often to save, and which physical approximations to use. It is normally kept as a single input file. Together with the starting structure it is what would be needed to repeat the run exactly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001080 "simulation parameter set"@en)
SubClassOf(obo:MOLSIM_001080 obo:MOLSIM_001074)

# Class: obo:MOLSIM_001081 (simulation trajectory)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001081 "A simulation trajectory is the record of a molecule's motion over time, captured during a simulation. It consists of a time-ordered sequence of snapshots or \"frames\" where each frame contains the 3D coordinates of all atoms at a specific instant. This trajectory is the primary output of a molecular dynamics simulation and is the raw data used for all subsequent analysis of the system's dynamic behavior."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001081 "trajectory"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001081 "simulation trajectory"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001081 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001081 obo:MOLSIM_001075)

# Class: obo:MOLSIM_001082 (simulation log)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001082 "A simulation log is a text file that records everything that happened during a computer simulation. As a type of process output, the simulation log is a human-readable file that contains a time-ordered record of a simulation run, including an echo of input parameters, performance data, and periodic updates of thermodynamic properties. This file is the primary source for monitoring the progress and stability of a simulation and for diagnosing errors."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001082 "simulation log"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001082 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001082 obo:MOLSIM_001075)

# Class: obo:MOLSIM_001083 (simulation state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001083 "The complete set of information needed to resume a simulation exactly where it stopped. It includes the atomic positions and velocities, the box dimensions, and the internal variables of any thermostat or barostat. Restarting from positions alone gives a different trajectory, because the missing quantities are re-initialised. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001083 "simulation state"@en)
SubClassOf(obo:MOLSIM_001083 obo:MOLSIM_001075)

# Class: obo:MOLSIM_001084 (analysis data)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001084 "Analysis data is the information content that is the result of analyzing simulation data. This includes any derived quantities calculated from a trajectory, such as RMSD values over time, a potential of mean force profile, or a list of identified hydrogen bonds. This processed data represents the scientific findings extracted from the simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001084 "analysis data"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001084 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001084 obo:MOLSIM_001075)

# Class: obo:MOLSIM_001085 (molecular data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001085 "A category for file formats designed to store information about molecules, such as their structure, movement, or the forces governing them. These formats provide standardized ways to represent molecular systems for use in computational chemistry and biology software. This class includes formats for atomic coordinates, trajectories, and force field parameters."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001085 "molecular data format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001085 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001085 obo:MOLSIM_000436)

# Class: obo:MOLSIM_001086 (prep (internal) format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001086 "A prep format in which the geometry of the new building block is given as internal coordinates, being bond lengths, angles and rotations relative to atoms already placed. It is otherwise identical to the variant that uses Cartesian coordinates. Writing the geometry this way makes the connection tree explicit, which is what the residue linking rules are read from. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001086 "AMBER prep (internal) format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001086 "prep (internal) format"@en)
SubClassOf(obo:MOLSIM_001086 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001087 (macromolecular structure format (deprecated))

AnnotationAssertion(owl:deprecated obo:MOLSIM_001087 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001087 "OBSOLETE. A file format specifically designed to describe the complex, three-dimensional structures of large biological molecules like proteins and DNA. These formats accommodate hierarchical descriptions, such as chains and residues, in addition to atomic coordinates. Examples include the widely used PDB and mmCIF formats."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001087 "obsolete macromolecular structure format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001087 "Retired in the file-format flattening. Classifying structure formats by molecule size was an artificial distinction: a small molecule can be stored in a PDB file and a macromolecule in a mol2 file. Its former children are now direct children of 'molecular structure format' (MOLSIM:001088). Reported in GitHub issue #20."@en)

# Class: obo:MOLSIM_001088 (molecular structure format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001088 "A type of file format that describes the three-dimensional arrangement of atoms in a molecule. These formats store atomic coordinates and often include information about chemical bonds and residue identity. They are essential for visualizing molecules and providing the starting point for simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001088 "molecular structure format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001088 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001088 obo:MOLSIM_001085)

# Class: obo:MOLSIM_001089 (software-specific coordinate format (deprecated))

AnnotationAssertion(owl:deprecated obo:MOLSIM_001089 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001089 "OBSOLETE. A coordinate file primarily stores the three-dimensional positions (X, Y, Z coordinates) of atoms in a molecular system. It may also contain atom names, residue information, and potentially periodic box dimensions, but typically lacks detailed bonding (topology) or force field parameter information. Common examples include PDB, GRO, and XYZ formats, used for initial structures or snapshots from simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001089 "obsolete software-specific coordinate format"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001089 "Retired in the same file-format flattening. Grouping coordinate formats by the software that writes them proved unhelpful, since formats are not owned by one program. Its former children are now direct children of 'molecular structure format' (MOLSIM:001088). Related discussion in GitHub issue #20."@en)

# Class: obo:MOLSIM_001090 (molecular trajectory format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001090 "A trajectory file stores the history of atomic positions (and sometimes velocities, forces, energies or the simulation box size) recorded at regular intervals during a molecular dynamics simulation. It contains a series of snapshots (or frames) representing the system's movement over time. Analyzing trajectories allows researchers to study dynamic processes, conformational changes, and calculate time-averaged properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001090 "molecular trajectory format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001090 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001090 obo:MOLSIM_001085)

# Class: obo:MOLSIM_001091 (molecular topology format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001091 "A file format that defines the atoms of a molecular system, how they are bonded together, and the force field parameters that apply to them. This includes atom types, partial charges, and parameters for bonds, angles, dihedral angles, and non-bonded interactions (like Lennard-Jones parameters). It essentially provides the 'rules' for how atoms interact in a molecular mechanics simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001091 "molecular topology format"@en)
SubClassOf(obo:MOLSIM_001091 obo:MOLSIM_001085)

# Class: obo:MOLSIM_001092 (prep (cartesian) format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001092 "A prep format in which the geometry of the new building block is given as Cartesian coordinates, being 3 numbers per atom. It is otherwise identical to the variant that uses internal coordinates. Writing the geometry this way is easier to generate from an existing structure. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001092 "AMBER prep (cartesian) format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001092 "prep (cartesian) format"@en)
SubClassOf(obo:MOLSIM_001092 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001093 (CHARMM par format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001093 "A text data format used by CHARMM that holds the numerical force field parameters: force constants, preferred bond lengths and angles, rotation terms and van der Waals values. It is paired with a separate file defining the residues those parameters apply to. The 2 together are what a CHARMM topology is built from. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001093 "CHARMM parameter format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001093 "par format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001093 "CHARMM par format"@en)
SubClassOf(obo:MOLSIM_001093 obo:MOLSIM_002066)

# Class: obo:MOLSIM_001094 (GAUSSIAN coordinate format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001094 "A data format that specifies the 3-dimensional arrangement of atoms inside a Gaussian input file, either as Cartesian x, y and z coordinates or as a Z-matrix of bond lengths, angles and dihedral angles. The Z-matrix form is chosen when internal coordinates or molecular symmetry need to be held fixed; the Cartesian form is simpler and more common. Both appear in the same place in the input file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001094 "GAUSSIAN coordinate format"@en)
SubClassOf(obo:MOLSIM_001094 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001095 (GAUSSIAN z-matrix format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001095 "A data format specifying a molecule's geometry inside a Gaussian input file as bond lengths, angles and rotations relative to atoms already placed. It is chosen when a geometry must be scanned or constrained, because one number can be varied or frozen directly. It is harder to write than plain coordinates and is not used unless that control is wanted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001095 "GAUSSIAN z-matrix format"@en)
SubClassOf(obo:MOLSIM_001095 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001096 (GAUSSIAN cartesian format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001096 "A data format specifying a molecule's geometry inside a Gaussian input file as an element symbol and 3 coordinates per atom. It is the simpler of the 2 ways Gaussian accepts a geometry and the one nearly always used. Coordinates in this form are easy to generate and carry no information about which internal degrees of freedom matter. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001096 "GAUSSIAN cartesian format"@en)
SubClassOf(obo:MOLSIM_001096 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001097 (job control format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001097 "A text data format holding the settings for a parameter fitting run: which parameters are to be fitted, which reference data to fit against, and how the fit is to be carried out. It is the file the fitting program reads to know what job it is doing. It is specific to that program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001097 "job control format"@en)
SubClassOf(obo:MOLSIM_001097 obo:MOLSIM_000437)

# Class: obo:MOLSIM_001098 (ReaxFF force field format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001098 "A text data format holding the parameters for a reactive force field, which are far more numerous than a conventional force field needs because bonding is computed rather than fixed. A single file covers every element combination the parameter set supports. Parameters for different element sets are not interchangeable, so the file identifies what can be simulated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001098 "ReaxFF force field format"@en)
SubClassOf(obo:MOLSIM_001098 obo:MOLSIM_002066)

# Class: obo:MOLSIM_001099 (DFTB parameter format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001099 "A data format, held in files known as Slater-Koster files, that stores the pre-calculated electronic and repulsive properties between pairs of atom types for a density functional tight binding calculation. The values are derived once from more expensive quantum mechanical calculations and then reused. That reuse is what makes the method fast while keeping a quantum mechanical description of the system. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001099 "skf format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001099 "DFTB parameter format"@en)
SubClassOf(obo:MOLSIM_001099 obo:MOLSIM_002066)

# Class: obo:MOLSIM_001100 (cuttable bond list format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001100 "A text data format listing which bonds a setup program may break when dividing a molecule into smaller pieces. Such a division is needed when parameters are derived fragment by fragment, and the cuts must fall where the chemistry allows. Listing them explicitly stops the program cutting through a group whose parameters must stay whole. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001100 "cuttable bond list format"@en)
SubClassOf(obo:MOLSIM_001100 obo:MOLSIM_000437)

# Class: obo:MOLSIM_001101 (reservoir cluster info file format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001101 "A file format that provides settings for a specialized type of simulation designed to enhance the sampling of molecular motions. It specifies dihedral angle definitions that are used for applying a non-Boltzmann reservoir weighting in enhanced sampling simulations. This format is used as input for advanced simulation techniques that target specific conformational changes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001101 "reservoir cluster info file format"@en)
SubClassOf(obo:MOLSIM_001101 obo:MOLSIM_000437)

# Class: obo:MOLSIM_001102 (EMIL input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001102 "A simulation parameter format that holds the control settings for an EMIL absolute free energy calculation in AMBER, conventionally in a file named emilParameters.in. It records the reference model parameters and the integration settings that the calculation needs. (UNVERIFIED)"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001102 "Berryman J.T. and Schilling T. Free energies by thermodynamic integration relative to an exact solution, used to find the handedness-switching salt concentration for DNA. J. Chem. Theory Comput. 9(1):679-686, 2013.")
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001102 "Berryman J.T. Absolute free energies for biomolecules in implicit or explicit solvent. Physics Procedia, 2014. States that the AMBER implementation of this method is called EMIL.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001102 "emilParameters.in format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001102 "EMIL input format"@en)
SubClassOf(obo:MOLSIM_001102 obo:MOLSIM_002065)

# Class: obo:MOLSIM_001103 (cein format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001103 "The cein format is a specialized input file used in constant redox-potential MD simulations. It defines the properties of residues that can exist in different oxidation states, such as a cysteine that can be oxidized or reduced. This file provides the necessary parameters for a constant redox potential simulation, allowing the system to dynamically change its electronic state in response to a defined electrochemical potential."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001103 "cein format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001103 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001103 obo:MOLSIM_002065)

# Class: obo:MOLSIM_001104 (cpein format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001104 "The cpein format is a complex input file for constant pH and electrochemical potential (CpH/E) MD simulations that simultaneously model changes in both protonation and electron-transfer states. It defines the properties of residues that can be affected by both the surrounding pH and the electrochemical potential. This format is required when studying complex bioenergetic processes where proton and electron transfers are coupled."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001104 "cpein format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001104 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001104 obo:MOLSIM_002065)

# Class: obo:MOLSIM_001105 (component cif)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001105 "A data file, in Crystallographic Information File format, that defines 1 chemical building block found in larger structures, giving its atom names, element types, bonds, charges and ideal geometry. It acts as a dictionary entry that deposited structures refer to rather than repeat. It is how a ligand or a modified residue is described once and reused. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001105 "component cif"@en)
SubClassOf(obo:MOLSIM_001105 obo:MOLSIM_001088)

# Class: obo:MOLSIM_001106 (solvent analysis data format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001106 "A data format that stores the results of analysing how solvent molecules are arranged and behave around a solute. Files in these formats typically hold values on a 3-dimensional grid, such as the chance of finding a solvent atom at a point or the average interaction energy there. Examples include solvent density maps and the correlation functions produced by 3D-RISM theory. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001106 "solvent analysis data format"@en)
SubClassOf(obo:MOLSIM_001106 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001107 (solvent pair distribution format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001107 "A data format that stores a 3-dimensional grid giving the chance of finding a solvent molecule at each position around a solute, relative to a random distribution. The value at each point is the pair distribution function g(r): above 1 means the solvent gathers there, below 1 means it is pushed away. Peaks in the grid mark solvation shells and hydrogen bonding sites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001107 "solvent pair distribution format"@en)
SubClassOf(obo:MOLSIM_001107 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001108 (solvent direct correlation format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001108 "A data format that stores a 3-dimensional grid of the direct correlation function c(r) between a solute and the surrounding solvent. It isolates the solute's direct influence on a solvent molecule at each position, leaving out effects passed along through other solvent molecules. It is a basic quantity in liquid-state theories such as 3D-RISM and is used to derive thermodynamic properties of solvation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001108 "solvent direct correlation format"@en)
SubClassOf(obo:MOLSIM_001108 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001109 (solvent total correlation format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001109 "A data format that stores a 3-dimensional grid of the total correlation function h(r) between a solute and the surrounding solvent. It gives the whole departure from a random solvent distribution caused by the solute, counting both direct and indirect effects, and it relates to the pair distribution function as h(r) = g(r) − 1. It is used in liquid-state theories to calculate solvation properties. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001109 "solvent total correlation format"@en)
SubClassOf(obo:MOLSIM_001109 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001110 (solvent potential file format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001110 "This file format stores a 3D map of the potential energy experienced by the solvent molecules in the space surrounding a central solute. The value at each grid point represents the average potential energy of the solvent at that location, reflecting the combined interactions with the solute and other solvent molecules. This format provides a view of the energetic landscape of the solvent, which can be used to identify energetically favorable or unfavorable regions for solvation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001110 "solvent potential file format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001110 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001110 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001111 (solvent charge density distribution format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001111 "A data format that stores a 3-dimensional grid of the average electric charge density contributed by solvent molecules around a solute. Unlike a map of where solvent atoms sit, it gives the net positive or negative charge at each point, averaged over the simulation. It shows how the solvent screens and responds to the solute's own charges. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001111 "solvent charge density distribution format"@en)
SubClassOf(obo:MOLSIM_001111 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001112 (solvent charge distribution format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001112 "A data format that stores a 3-dimensional grid giving, separately for each kind of partial charge a solvent molecule carries, the chance of finding that charge at each position around a solute. It differs from a charge density map by keeping the positive and negative sites apart rather than summing them. That separation is what reveals preferred hydrogen bonding geometries and ion solvation sites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001112 "solvent charge distribution format"@en)
SubClassOf(obo:MOLSIM_001112 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001113 (solute-solvent potential energy format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001113 "A data format that stores a 3-dimensional grid of the interaction energy a solvent molecule would feel at each position around a solute. Negative values mark positions the solvent is drawn to and positive values mark positions it is pushed away from. The grid shows the energetic landscape that determines how solvent arranges itself. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001113 "solute-solvent potential energy format"@en)
SubClassOf(obo:MOLSIM_001113 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001114 (site-site functionals format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001114 "A data file format used in advanced solvent analysis to describe how the interaction between different types of atoms changes with distance. It stores the mathematical functions, known as pair functionals, that are the core components of integral equation theories like the 3D Reference Interaction Site Model (3D-RISM). These files contain the pre-calculated correlation functions for a pure solvent, which are then used by the 3D-RISM method to determine the solvent structure around a solute molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001114 "site-site functionals format"@en)
SubClassOf(obo:MOLSIM_001114 obo:MOLSIM_010022)

# Class: obo:MOLSIM_001115 (total excess coordination number format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001115 "A data format that stores the average number of extra solvent molecules gathered around a solvent molecule, above what the bulk liquid would give. It measures how strongly the solvent structures itself in the solution. It is produced by 1-dimensional RISM calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001115 "total excess coordination number format"@en)
SubClassOf(obo:MOLSIM_001115 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001116 (total excess charge format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001116 "A data format that stores how much extra electric charge from the solvent gathers around each type of solvent atom. It measures the net charge separation the solute induces in the solvent. It is produced by 3-dimensional RISM calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001116 "total excess charge format"@en)
SubClassOf(obo:MOLSIM_001116 obo:MOLSIM_010021)

# Class: obo:MOLSIM_001117 (GAUSSIAN electrostatic potential format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001117 "A data format in which Gaussian writes the electrostatic potential it computed at a set of points around a molecule, together with those points' coordinates. It is the input a charge fitting program reads. The choice of where the points lie affects the charges obtained, so it is part of the fitting protocol rather than an incidental detail. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001117 "GAUSSIAN electrostatic potential format"@en)
SubClassOf(obo:MOLSIM_001117 obo:MOLSIM_010022)

# Class: obo:MOLSIM_001118 (mdinfo format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001118 "The mdinfo format is a text file generated by the Amber simulation software that provides a concise, real-time summary of a running simulation. It contains the most recently calculated energy terms and thermodynamic properties, such as temperature and pressure, formatted for easy monitoring. This file is continuously updated during a run, making it useful for checking the immediate status and stability of a simulation without having to parse the much larger main output file."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001118 "AMBER mdinfo format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001118 "mdinfo format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001118 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001118 obo:MOLSIM_000439)

# Class: obo:MOLSIM_001119 (database web server)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001119 "A database web server is an online application that provides a graphical interface for searching, visualizing, and retrieving data from a structured repository. It acts as an accessible gateway, allowing researchers to query complex datasets and download specific entries without needing direct interaction with the underlying database management system."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001119 "database web server"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001119 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001119 obo:MOLSIM_001671)

# Class: obo:MOLSIM_001120 (NEF format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001120 "A standard text-based file format designed for exchanging NMR-derived information, particularly structural restraints like distances and angles. It provides a standardized way to represent experimental data used for structure calculation and simulation refinement. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001120 "NMR exchange format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001120 "NEF format"@en)
SubClassOf(obo:MOLSIM_001120 obo:MOLSIM_000440)

# Class: obo:MOLSIM_001163 (parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001163 "An input variable or algorithmic setting defined prior to execution that governs the behavior, conditions, or numerical rules of a computational process (encompassing both simulation generation and post-run analysis). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001163 "parameter"@en)

# Class: obo:MOLSIM_001164 (simulation parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001164 "An input setting that determines the physical interactions, boundary conditions or integration rules used to generate a trajectory. Examples are the target temperature a thermostat holds, the size of the timestep, and the distance beyond which interactions are ignored. These settings are part of what a result means, so a simulation cannot be reproduced or judged without them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001164 "simulation parameter"@en)
SubClassOf(obo:MOLSIM_001164 obo:MOLSIM_001163)

# Class: obo:MOLSIM_001165 (integration parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001165 "A simulation parameter controlling how the equations of motion are advanced in time, including the timestep, the integration algorithm and how long the run lasts. The timestep is the most consequential: too large and the simulation becomes unstable, too small and it wastes time. Most of what makes a run stable or unstable is set here. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001165 "integration parameter"@en)
SubClassOf(obo:MOLSIM_001165 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001166 (simulation time step)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001166 "A type of integration parameter that specifies the discrete interval of time between successive steps in a molecular dynamics simulation. The choice of simulation time step is a critical balance between computational efficiency and numerical stability, as it must be short enough to capture the fastest atomic motions. This is commonly specified in input files with the keyword dt. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001166 "simulation time step"@en)
SubClassOf(obo:MOLSIM_001166 obo:MOLSIM_001165)
SubClassOf(obo:MOLSIM_001166 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001166 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001167 (simulation duration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001167 "A type of integration parameter that specifies the total length of time the simulation is run. This determines how much conformational space can be explored and the timescale of the phenomena that can be observed. The simulation duration is typically set by specifying the total number of steps, nsteps, in the input file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001167 "simulation duration"@en)
SubClassOf(obo:MOLSIM_001167 obo:MOLSIM_001165)

# Class: obo:MOLSIM_001168 (simulation time per stage)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001168 "A specific type of simulation duration that defines the length of a single stage within a multi-stage simulation protocol. This is used in methods like steered MD or umbrella sampling but also during density adaptation and equilibration workflows, where the overall process is broken down into smaller, sequential runs. The simulation time per stage ensures that each part of the protocol is run for a defined period. This is often specified as nsteps within a block for a specific stage."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001168 "simulation time per stage"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001168 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001168 obo:MOLSIM_001167)

# Class: obo:MOLSIM_001169 (minimization convergence criteria)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001169 "An integration parameter giving the conditions under which an energy minimization stops. The usual conditions are that the largest force on any atom has fallen below a threshold, or that the energy has stopped changing between steps. A minimization that stops too early leaves strain in the structure that the first simulation steps then release violently. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001169 "minimization convergence criteria"@en)
SubClassOf(obo:MOLSIM_001169 obo:MOLSIM_001165)

# Class: obo:MOLSIM_001170 (minimization drms criterion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001170 "A specific minimization convergence criteria based on the root-mean-square of the gradient, which represents the forces on the atoms. The minimization will stop when the RMS of the forces falls below this specified threshold. This is a common way to define convergence and is often set with the keyword drms. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001170 "minimization drms criterion"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001170 "AMBER 26 Reference Manual, p. 434, entry drms."@en)
SubClassOf(obo:MOLSIM_001170 obo:MOLSIM_001169)

# Class: obo:MOLSIM_001171 (minimization gradient tolerance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001171 "A specific minimization convergence criteria that sets the root-mean-square gradient threshold for terminating an energy minimization run. The minimization is considered converged when the RMS of the forces on the atoms is less than this gradient tolerance. This is a key parameter for controlling the strictness of the geometry optimization, often set with grms_tol. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001171 "minimization gradient tolerance"@en)
SubClassOf(obo:MOLSIM_001171 obo:MOLSIM_001169)

# Class: obo:MOLSIM_001172 (thermodynamic ensemble parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001172 "A simulation parameter that fixes which quantities are held constant during a run, and so which statistical ensemble is sampled. Holding particle number, volume and temperature gives one ensemble; holding pressure instead of volume gives another. The choice determines which averages taken from the trajectory are meaningful. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001172 "thermodynamic ensemble parameter"@en)
SubClassOf(obo:MOLSIM_001172 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001173 (temperature control parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001173 "A thermodynamic ensemble parameter specifying how the temperature is held at its target, covering the thermostat algorithm, the target value and the coupling strength. A thermostat both holds the temperature and changes the dynamics, so these settings affect more than the average temperature. They must be reported with any result that depends on rates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001173 "temperature control parameter"@en)
SubClassOf(obo:MOLSIM_001173 obo:MOLSIM_001172)

# Class: obo:MOLSIM_001174 (thermostat algorithm parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001174 "A temperature control parameter naming which algorithm holds the temperature, such as Berendsen, Nosé-Hoover or stochastic velocity rescaling. They differ in whether they produce the correct spread of energies or only the correct average. The Berendsen scheme does not, which is why it is used to bring a system to temperature and then replaced. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001174 "thermostat algorithm parameter"@en)
SubClassOf(obo:MOLSIM_001174 obo:MOLSIM_001173)

# Class: obo:MOLSIM_001175 (target temperature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001175 "A temperature control parameter that specifies the desired temperature for the simulation. The thermostat algorithm will adjust the kinetic energy of the atoms to keep the average temperature fluctuating around this target temperature. This is a fundamental parameter for any simulation and is often set with the keyword temp0. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001175 "target temperature"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001175 "AMBER 26 Reference Manual, p. 436, entry temp0."@en)
SubClassOf(obo:MOLSIM_001175 obo:MOLSIM_001173)
SubClassOf(obo:MOLSIM_001175 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000005))
SubClassOf(obo:MOLSIM_001175 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001176 (thermostat coupling parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001176 "A temperature control parameter setting how strongly the system is coupled to the simulated heat bath. Strong coupling holds the temperature close to target and interferes with the natural motion; weak coupling leaves the dynamics alone and lets the temperature wander. Any quantity involving rates depends on this choice. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001176 "thermostat coupling parameter"@en)
SubClassOf(obo:MOLSIM_001176 obo:MOLSIM_001173)

# Class: obo:MOLSIM_001177 (thermostat coupling constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001177 "A thermostat coupling parameter giving the time over which a temperature difference is corrected. A short value corrects aggressively and damps the real motion of the system; a long value is gentle and slow to reach the target. It is the form the coupling strength takes in the Berendsen and Nosé-Hoover thermostats. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001177 "thermostat coupling constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001177 "AMBER 26 Reference Manual, p. 436, entry tautp."@en)
SubClassOf(obo:MOLSIM_001177 obo:MOLSIM_001176)

# Class: obo:MOLSIM_001178 (thermostat collision frequency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001178 "A thermostat coupling parameter giving how often, on average, a particle receives a random kick from the simulated bath in a stochastic thermostat. A high frequency reaches the target temperature quickly and turns the motion into a random walk; a low one preserves the real dynamics and controls temperature weakly. It is the stochastic counterpart of a coupling time constant. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001178 "thermostat collision frequency"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001178 "AMBER 26 Reference Manual, p. 216, entry gamma_ln."@en)
SubClassOf(obo:MOLSIM_001178 obo:MOLSIM_001176)

# Class: obo:MOLSIM_001179 (pressure control parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001179 "A thermodynamic ensemble parameter specifying how the pressure is held at its target, covering the barostat algorithm, the target value, the coupling strength and the compressibility. Pressure fluctuates so strongly in a small system that these settings determine how the volume behaves more than the target does. They apply only to constant-pressure runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001179 "pressure control parameter"@en)
SubClassOf(obo:MOLSIM_001179 obo:MOLSIM_001172)

# Class: obo:MOLSIM_001180 (barostat algorithm parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001180 "A pressure control parameter naming which algorithm holds the pressure at its target, such as Berendsen, Parrinello-Rahman or a Monte Carlo scheme. They differ in whether they generate the correct distribution of volumes or merely the correct average. The Berendsen scheme equilibrates quickly and does not give the correct distribution, which is why it is used to settle a system and then replaced. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001180 "barostat algorithm parameter"@en)
SubClassOf(obo:MOLSIM_001180 obo:MOLSIM_001179)

# Class: obo:MOLSIM_001181 (target pressure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001181 "A pressure control parameter that specifies the desired pressure for the simulation. The barostat algorithm will adjust the volume of the simulation box to keep the average pressure fluctuating around this target pressure. This is a fundamental parameter for any constant pressure simulation and is often set with the keyword pres0. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001181 "target pressure"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001181 "AMBER 26 Reference Manual, p. 438, entry pres0."@en)
SubClassOf(obo:MOLSIM_001181 obo:MOLSIM_001179)

# Class: obo:MOLSIM_001182 (barostat coupling constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001182 "A pressure control parameter giving how quickly the box volume responds to a difference between the current and target pressure. A small value corrects pressure aggressively and makes the volume oscillate; a large one is gentle and slow to settle. Pressure in a small system fluctuates enormously, so this must be slow enough to average over those fluctuations rather than chase them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001182 "barostat coupling constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001182 "AMBER 26 Reference Manual, p. 438, entry taup."@en)
SubClassOf(obo:MOLSIM_001182 obo:MOLSIM_001179)

# Class: obo:MOLSIM_001183 (compressibility)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001183 "A pressure control parameter giving how much the system's volume changes for a given change in pressure. Some barostats need it to work out how far to scale the box when correcting pressure. The value used is that of the solvent, because the solvent is nearly all of the volume. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001183 "compressibility"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001183 "AMBER 26 Reference Manual, p. 438, entry comp."@en)
SubClassOf(obo:MOLSIM_001183 obo:MOLSIM_001179)

# Class: obo:MOLSIM_001184 (interaction parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001184 "A simulation parameter controlling how interactions between atoms are computed, covering the cutoff distances, the long-range electrostatic method and the treatment at the cutoff. These settings determine how much of each interaction is actually included. They affect both cost and correctness, which is why they are reported with any published simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001184 "interaction parameter"@en)
SubClassOf(obo:MOLSIM_001184 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001185 (non-bonded interaction parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001185 "An interaction parameter controlling how van der Waals and short-range electrostatic interactions are computed, covering the cutoff distance, the treatment at that cutoff, and the neighbour list settings. These settings decide how much of the interaction is included and what happens at the boundary. They are among the few settings that affect both speed and correctness directly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001185 "non-bonded interaction parameter"@en)
SubClassOf(obo:MOLSIM_001185 obo:MOLSIM_001184)

# Class: obo:MOLSIM_001186 (non-bonded method parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001186 "A non-bonded interaction parameter naming how interactions are handled at the cutoff distance, such as truncating them sharply or smoothly switching them to zero over a range. A sharp truncation makes the force jump at the cutoff, which adds energy to the system every time a pair crosses it. The choice therefore affects whether energy is conserved. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001186 "non-bonded method parameter"@en)
SubClassOf(obo:MOLSIM_001186 obo:MOLSIM_001185)

# Class: obo:MOLSIM_002269 (van der Waals cutoff distance)

Declaration(Class(obo:MOLSIM_002269))
Declaration(Class(obo:MOLSIM_002270))
Declaration(Class(obo:MOLSIM_002271))
Declaration(Class(obo:MOLSIM_002272))
Declaration(Class(obo:MOLSIM_002273))
Declaration(Class(obo:MOLSIM_002274))
Declaration(Class(obo:MOLSIM_002275))
Declaration(Class(obo:MOLSIM_002276))
Declaration(Class(obo:MOLSIM_002277))
Declaration(Class(obo:MOLSIM_002278))
Declaration(Class(obo:MOLSIM_002279))
Declaration(Class(obo:MOLSIM_002280))
Declaration(Class(obo:MOLSIM_002281))
Declaration(Class(obo:MOLSIM_002282))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002269 "A non-bonded interaction parameter that specifies the distance beyond which van der Waals interactions are no longer calculated. Several programs set this separately from the electrostatic cut-off so that the two can take different values. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002269 "van der Waals cutoff distance"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_002269 "GROMACS 2026.3 Reference Manual, p. 53, entry rvdw, which gives the distance for the LJ or Buckingham cut-off."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_002269 "AMBER 26 Reference Manual, p. 499, entry vdw_cutoff. States that es_cutoff and vdw_cutoff control the cutoffs for vdw and electrostatic direct force interactions separately, that cut must not be given as well, and that vdw_cutoff must be greater than or equal to es_cutoff."@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_002269 "rvdw")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_002269 "vdw_cutoff")
SubClassOf(obo:MOLSIM_002269 obo:MOLSIM_001185)
SubClassOf(obo:MOLSIM_002269 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_002269 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001187 (non-bonded cutoff distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001187 "A non-bonded interaction parameter that specifies the single distance beyond which both van der Waals and electrostatic interactions are no longer calculated directly. Using one distance for both is the common case, and it is the main way to reduce the cost of a simulation. Programs that allow the two to be set separately use a more specific parameter for each. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001187 "non-bonded cutoff distance"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001187 "AMBER 26 Reference Manual, p. 456, entry cut."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001187 "AMBER 26 Reference Manual, p. 467, card CUT, which names this quantity the non-bonded cutoff distance."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001187 "NAMD 3.x User's Guide, p. 55, section 5.2.3, entry cutoff. States that the cutoff is the local interaction distance common to both electrostatic and van der Waals calculations."@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001187 "cut")
SubClassOf(obo:MOLSIM_001187 obo:MOLSIM_001185)
SubClassOf(obo:MOLSIM_001187 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001187 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001188 (switching distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001188 "A non-bonded interaction parameter giving the distance at which a smoothing function starts bringing the interaction energy down to zero at the cutoff. Without it the energy jumps as a pair crosses the cutoff, which adds energy to the system each time. The gap between this distance and the cutoff sets how gentle that transition is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001188 "switching distance"@en)
SubClassOf(obo:MOLSIM_001188 obo:MOLSIM_001185)

# Class: obo:MOLSIM_001189 (pairlist update frequency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001189 "A non-bonded interaction parameter giving how many steps pass between rebuilds of the neighbour list. Rebuilding often is safe and costly; rebuilding rarely is cheap and risks missing a pair that has moved into range. It is chosen together with the pairlist skin, since a thicker skin allows a longer interval. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001189 "pairlist update frequency"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001189 "AMBER 26 Reference Manual, p. 456, entry nsnb."@en)
SubClassOf(obo:MOLSIM_001189 obo:MOLSIM_001185)

# Class: obo:MOLSIM_001190 (pairlist skin)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001190 "A non-bonded interaction parameter giving the extra distance beyond the cutoff within which pairs of atoms are recorded in the neighbour list. Including pairs that are not yet interacting means the list stays valid for several steps as atoms move, so it need not be rebuilt every step. Too small a value lets a pair reach interaction range unnoticed, which silently loses interactions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001190 "pairlist skin"@en)
SubClassOf(obo:MOLSIM_001190 obo:MOLSIM_001185)

# Class: obo:MOLSIM_001191 (electrostatic parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001191 "An interaction parameter controlling how electrostatic interactions are computed. Its members cover which long-range method is used and the settings that method needs, such as grid spacing and real-space cutoff. These settings determine accuracy and cost together, so they are chosen as a set rather than individually. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001191 "electrostatic parameter"@en)
SubClassOf(obo:MOLSIM_001191 obo:MOLSIM_001184)

# Class: obo:MOLSIM_001192 (long-range electrostatic method parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001192 "An electrostatic parameter naming which algorithm computes the long-range electrostatic interactions, such as particle mesh Ewald, plain Ewald summation, or a reaction field. Electrostatic forces fall off slowly enough that simply ignoring them past a cutoff introduces visible artefacts. The choice of method is therefore part of what a published simulation must state. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001192 "long-range electrostatic method parameter"@en)
SubClassOf(obo:MOLSIM_001192 obo:MOLSIM_001191)

# Class: obo:MOLSIM_001193 (PME grid spacing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001193 "An electrostatic parameter giving how far apart the points of the reciprocal-space grid lie in a particle mesh Ewald calculation. A finer grid is more accurate and costs more, and the cost rises with the cube of the refinement. It trades off against the real-space cutoff, so the 2 should be chosen together rather than separately. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001193 "PME grid spacing"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001193 "AMBER 26 Reference Manual, p. 500, entry fft_grids_per_ang."@en)
SubClassOf(obo:MOLSIM_001193 obo:MOLSIM_001191)

# Class: obo:MOLSIM_001194 (PME grid dimensions)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001194 "An electrostatic parameter used by the Particle Mesh Ewald (PME) method that specifies the number of grid points in each dimension for the reciprocal space calculation. Larger PME grid dimensions result in a more accurate calculation but are computationally more expensive. These are often set automatically based on the grid spacing, but can be specified directly with keywords like nfft1, nfft2, and nfft3. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001194 "PME grid dimensions"@en)
SubClassOf(obo:MOLSIM_001194 obo:MOLSIM_001191)

# Class: obo:MOLSIM_001195 (dielectric constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001195 "An electrostatic parameter giving how strongly a medium screens the electrostatic interaction between charges within it. It is 1 in vacuum and in explicit solvent simulations, where the water molecules do the screening themselves, and is raised in implicit solvent models to stand in for solvent that is not present. It scales every Coulomb interaction in the calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001195 "dielectric constant"@en)
SubClassOf(obo:MOLSIM_001195 obo:MOLSIM_001191)

# Class: obo:MOLSIM_001196 (internal dielectric constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001196 "A dielectric constant that describes the interior of the solute in a continuum solvation calculation. It is set low, usually between 1 and 4, because the packed interior of a molecule screens charge poorly. Its value is one of the largest sources of variation between published binding free energy estimates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001196 "internal dielectric constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001196 "AMBER 26 Reference Manual, p. 82, entry epsin."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001196 "AMBER 26 Reference Manual, p. 952, entry indi."@en)
SubClassOf(obo:MOLSIM_001196 obo:MOLSIM_001195)

# Class: obo:MOLSIM_001197 (external dielectric constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001197 "A dielectric constant that describes the bulk solvent surrounding a solute in a continuum solvation calculation. It is set high, near 80 for water, so that the solvent screens electrostatic interactions strongly. Together with the internal value it fixes the dielectric boundary at the molecular surface. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001197 "external dielectric constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001197 "AMBER 26 Reference Manual, p. 82, entry epsout."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001197 "AMBER 26 Reference Manual, p. 952, entry exdi."@en)
SubClassOf(obo:MOLSIM_001197 obo:MOLSIM_001195)

# Class: obo:MOLSIM_001198 (direct sum cutoff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001198 "An electrostatic parameter giving the distance at which the directly summed part of an Ewald calculation stops. Raising it moves work out of the reciprocal-space part and into the real-space part, and lowering it does the reverse. The total accuracy depends on this and the grid spacing together, which is why changing one alone usually makes results worse. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001198 "direct sum cutoff"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001198 "AMBER 26 Reference Manual, p. 499, entry es_cutoff."@en)
SubClassOf(obo:MOLSIM_001198 obo:MOLSIM_001191)

# Class: obo:MOLSIM_001199 (external field parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001199 "An interaction parameter giving the strength, direction and time dependence of a field applied to the system from outside. It is what specifies an applied electric field in a simulation of ion transport or of a membrane under voltage. Without it the field has no defined magnitude. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001199 "external field parameter"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001199 "AMBER 26 Reference Manual, p. 457, entry efx."@en)
SubClassOf(obo:MOLSIM_001199 obo:MOLSIM_001184)

# Class: obo:MOLSIM_001200 (external electric field component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001200 "A specific external field parameter that defines the magnitude of an applied external electric field along a particular axis. This is used to simulate the effect of a uniform electric field on the molecular system. The external electric field component is often specified for each axis, such as efx, efy, and efz. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001200 "external electric field component"@en)
SubClassOf(obo:MOLSIM_001200 obo:MOLSIM_001199)

# Class: obo:MOLSIM_001201 (constraint and restraint parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001201 "A type of simulation parameter that controls the application of geometric constraints or restraints to the system. Constraints are used to fix certain degrees of freedom, while restraints are used to guide the system towards a particular conformation. These constraint and restraint parameter settings are used to control the flexibility of the system or to apply experimental data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001201 "constraint and restraint parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001201 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001201 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001202 (constraint parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001202 "A parameter controlling how geometric constraints are applied, most often to hold bonds involving hydrogen at a fixed length. Fixing those bonds removes the fastest motion in the system, which is what permits a timestep 2 to 4 times longer. Its members say which bonds are held, by which algorithm, and how exactly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001202 "constraint parameter"@en)
SubClassOf(obo:MOLSIM_001202 obo:MOLSIM_001201)

# Class: obo:MOLSIM_001203 (constraint algorithm parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001203 "A constraint parameter naming which algorithm enforces the geometric constraints, such as SHAKE, RATTLE, LINCS or SETTLE. The choice affects speed and how well the constraints are held, not what is being constrained. SETTLE is used for water specifically, because water's constraints have an exact solution that needs no iteration. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001203 "constraint algorithm parameter"@en)
SubClassOf(obo:MOLSIM_001203 obo:MOLSIM_001202)

# Class: obo:MOLSIM_001204 (constrained bond)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001204 "A constraint parameter naming which bonds are held at a fixed length, usually as a choice between all bonds, only those involving hydrogen, or none. Constraining hydrogen bonds is near universal, because it costs almost nothing in accuracy and permits a longer timestep. Constraining all bonds permits a longer step still and does begin to affect the results. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001204 "constrained bonds"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001204 "constrained bond"@en)
SubClassOf(obo:MOLSIM_001204 obo:MOLSIM_001202)

# Class: obo:MOLSIM_001205 (SHAKE tolerance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001205 "A constraint parameter giving how close to its target length a constrained bond must be before the algorithm stops adjusting it. A tighter value holds the geometry more exactly and takes more iterations each step. Too loose a value lets energy drift over a long run, which is the usual sign it was set badly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001205 "SHAKE tolerance"@en)
SubClassOf(obo:MOLSIM_001205 obo:MOLSIM_001202)

# Class: obo:MOLSIM_001206 (restraint parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001206 "A type of constraint and restraint parameter that specifies how artificial restraining potentials are applied to the system. These are used to guide the simulation towards a specific conformation. The restraint parameter settings are essential for biased simulations and structure refinement. These are often set with keywords like restraint_wt and restraintmask."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001206 "restraint parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001206 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001206 obo:MOLSIM_001201)

# Class: obo:MOLSIM_001207 (restraint energy constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001207 "A restraint parameter that specifies the force constant for a harmonic or other restraining potential. A larger restraint energy constant results in a stronger force pulling the restrained atoms towards their target values. This is a key parameter for controlling the strength of the applied restraints. This is often set with the keyword restraint_wt."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001207 "restraint energy constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001207 "AMBER 26 Reference Manual, p. 433, entry restraint_wt."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001207 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001207 obo:MOLSIM_001206)

# Class: obo:MOLSIM_001208 (restraint mask)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001208 "A restraint parameter that names which atoms a restraining force applies to, written as a selection expression rather than a list. It is what lets part of a system be held in place while the rest moves freely, such as holding a protein still while water settles around it. A mask that selects the wrong atoms produces a simulation that runs normally and means something else. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001208 "restraint mask"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001208 "AMBER 26 Reference Manual, p. 433, entry restraintmask."@en)
SubClassOf(obo:MOLSIM_001208 obo:MOLSIM_001206)

# Class: obo:MOLSIM_001209 (water cap force constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001209 "A specific restraint energy constant used to apply a restraining potential to a spherical cap of water molecules around a solute. This is used in some simulation setups to prevent the solute from becoming exposed to the vacuum. The water cap force constant controls the strength of this spherical boundary potential. This is often set with the keyword fcap."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001209 "water cap force constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001209 "AMBER 26 Reference Manual, p. 454, entry fcap."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001209 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001209 obo:MOLSIM_001206)

# Class: obo:MOLSIM_001210 (system setup parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001210 "A simulation parameter that fixes what the system is made of and what state it is in, rather than how it is advanced in time. Examples are the size and shape of the box, the water model, and the number of ions added. These are chosen once while the system is built and do not change while it runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001210 "system setup parameter"@en)
SubClassOf(obo:MOLSIM_001210 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001211 (pH)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001211 "A system setup parameter giving the acidity of the simulated solution. It determines which acidic and basic groups carry a proton, and so the charge on the molecule. In an ordinary simulation it is used once to assign fixed protonation states; in a constant pH simulation it is held during the run and the states respond to it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001211 "pH"@en)
SubClassOf(obo:MOLSIM_001211 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001212 (ionic strength)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001212 "A system setup parameter that specifies the molar concentration of salt in the simulation solvent. The ionic strength affects the screening of electrostatic interactions and is crucial for mimicking experimental buffer conditions. This is a key parameter for accurately modeling the electrostatic environment of the system. This is often set with the keyword ion_concentration or saltcon."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001212 "ionic strength"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001212 "AMBER 26 Reference Manual, p. 984, entry ion_concentration."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001212 "AMBER 26 Reference Manual, p. 73, entry saltcon."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001212 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001212 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001213 (periodic box dimensions)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001213 "A system setup parameter that specifies the size and shape of the periodic box used to create a periodic system. The periodic box dimensions are essential for any simulation using periodic boundary conditions. They determine the overall density of the system."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001213 "periodic box dimensions"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001213 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001213 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001214 (molecular termini state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001214 "A system setup parameter giving the chemical state of each end of a polymer chain: charged, neutral, or capped with a group that mimics the continuation of the chain. Capping is used when the simulated fragment is part of a longer chain in reality, so that an artificial charge is not introduced. A wrong choice adds or removes charge at exactly the place a fragment is most exposed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001214 "molecular termini state"@en)
SubClassOf(obo:MOLSIM_001214 obo:MOLSIM_001210)

# Class: obo:MOLSIM_002264 (acetyl capping group)

Declaration(Class(obo:MOLSIM_002264))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002264 "A molecular termini state in which the N-terminus of a polymer chain is closed off with an acetyl group, so that the end carries no electric charge. Capping this way makes a short peptide behave more like a piece cut from the middle of a longer chain. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002264 "ACE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002264 "acetyl capping group"@en)
SubClassOf(obo:MOLSIM_002264 obo:MOLSIM_001214)

# Class: obo:MOLSIM_002265 (N-methylamide capping group)

Declaration(Class(obo:MOLSIM_002265))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002265 "A molecular termini state in which the C-terminus of a polymer chain is closed off with an N-methylamide group, so that the end carries no electric charge. It is the usual partner to an acetyl group at the other end of the chain. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002265 "NME"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002265 "N-methylamide capping group"@en)
SubClassOf(obo:MOLSIM_002265 obo:MOLSIM_001214)

# Class: obo:MOLSIM_002266 (amide capping group)

Declaration(Class(obo:MOLSIM_002266))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002266 "A molecular termini state in which the C-terminus of a polymer chain is closed off with a plain amide group, so that the end carries no electric charge. It is a smaller alternative to an N-methylamide cap. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002266 "NHE"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002266 "amide capping group"@en)
SubClassOf(obo:MOLSIM_002266 obo:MOLSIM_001214)

# Class: obo:MOLSIM_002267 (charged N-terminus)

Declaration(Class(obo:MOLSIM_002267))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002267 "A molecular termini state in which the N-terminus of a polymer chain is left uncapped and carries a positive charge, as a free amine group does at the pH of most simulations. This is the usual choice when the chain being simulated is a whole protein rather than a fragment of one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002267 "charged N-terminus"@en)
SubClassOf(obo:MOLSIM_002267 obo:MOLSIM_001214)

# Class: obo:MOLSIM_002268 (charged C-terminus)

Declaration(Class(obo:MOLSIM_002268))
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002268 "A molecular termini state in which the C-terminus of a polymer chain is left uncapped and carries a negative charge, as a free carboxylic acid group does at the pH of most simulations. This is the usual choice when the chain being simulated is a whole protein rather than a fragment of one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002268 "charged C-terminus"@en)
SubClassOf(obo:MOLSIM_002268 obo:MOLSIM_001214)

# Class: obo:MOLSIM_001215 (alchemical transformation state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001215 "A system setup parameter that specifies whether the simulation involves an alchemical transformation for a free energy calculation. This parameter indicates that some atoms/residues in the system have their properties changed over the course of the simulation. The alchemical transformation state is a key descriptor for identifying free energy calculations. This is often controlled by a perturbation flag (lambda, λ)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001215 "alchemical transformation state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001215 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001215 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001216 (number of replicates)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001216 "A simulation process parameter that specifies the number of independent simulation runs performed from the same or similar initial conditions. Running number of replicates helps to assess the statistical robustness and convergence of simulation results. This is a key parameter of the overall simulation experimental design."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001216 "number of replicates"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001216 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001216 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001217 (surface tension)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001217 "A system setup parameter giving the target surface tension for a constant-pressure simulation containing an interface. It is used for membranes and liquid surfaces, where holding pressure alone leaves the area of the interface undetermined. Setting it to zero lets a membrane find its own area, which is usually what is wanted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001217 "surface tension"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001217 "AMBER 26 Reference Manual, p. 439, entry gamma_ten."@en)
SubClassOf(obo:MOLSIM_001217 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001218 (number of QM/MM partitions)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001218 "A system setup parameter giving how many separate quantum regions an adaptive calculation maintains. Several are used when reacting groups sit far apart and would otherwise force one very large quantum region. Each brings its own boundary, so adding one adds another place the 2 descriptions must be joined. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001218 "number of QM/MM partitions"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001218 "AMBER 26 Reference Manual, p. 211, entry n_partition."@en)
SubClassOf(obo:MOLSIM_001218 obo:MOLSIM_001210)

# Class: obo:MOLSIM_001219 (enhanced sampling parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001219 "A type of simulation parameter that controls the application of a specific enhanced sampling method designed to accelerate the exploration of the system's conformational space. These parameters define the nature and strength of the biasing potential or other modifications to the standard simulation protocol."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001219 "enhanced sampling parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001219 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001219 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001220 (steered molecular dynamics parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001220 "A type of enhanced sampling parameter that controls a steered molecular dynamics (sMD) simulation, where an external force is applied to pull the system along a specific coordinate. These parameters define the pulling speed, force constant, and direction of the steering. The steered molecular dynamics parameter settings are essential for setting up non-equilibrium pulling simulations. These are often set with keywords like smd."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001220 "steered molecular dynamics parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001220 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001220 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001221 (atom pulling velocity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001221 "A steered molecular dynamics parameter that specifies the constant speed at which the steered coordinate is changed during a constant-velocity sMD simulation. The atom pulling velocity determines the rate at which the system is pulled in agreement with the selected reaction coordinate. This is often set with the keyword v."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001221 "atom pulling velocity"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001221 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001221 obo:MOLSIM_001220)

# Class: obo:MOLSIM_001222 (steered MD restraint energy constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001222 "A steered molecular dynamics parameter that specifies the stiffness of the harmonic potential used to pull the system along the reaction coordinate. A larger steered MD restraint energy constant results in a stiffer spring and less deviation from the target path. This is a key parameter for controlling the strength of the steering. This is often set with the keyword harm."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001222 "steered MD restraint energy constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001222 "AMBER 26 Reference Manual, p. 610, entry harm."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001222 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001222 obo:MOLSIM_001220)

# Class: obo:MOLSIM_001223 (number of SMD stages)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001223 "A steered molecular dynamics parameter that specifies the total number of distinct stages or windows used in a staged sMD simulation protocol. This allows for the pulling to occur incrementally or for parameters to be changed between stages. The number of sMD stages is a key parameter for setting up complex pulling protocols. This is often set with the keyword nstage."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001223 "number of sMD stages"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001223 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001223 obo:MOLSIM_001220)

# Class: obo:MOLSIM_001224 (umbrella sampling parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001224 "A type of enhanced sampling parameter that controls an umbrella sampling simulation, where a biasing potential is used to confine the system to specific windows along a reaction coordinate. These parameters define the location and strength of the biasing potential in each window. The umbrella sampling parameter settings are essential for setting up simulations to calculate a potential of mean force. These are often set in the input file for each window."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001224 "umbrella sampling parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001224 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001224 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001225 (umbrella sampling restraint energy constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001225 "An umbrella sampling parameter that specifies the strength of the harmonic biasing potential applied in each umbrella sampling window. This force constant determines how strongly the system is restrained around the target value of the reaction coordinate for that window. The umbrella sampling restraint energy constant is a key parameter for ensuring sufficient sampling within each window. This is often set with the keyword anchor_strength."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001225 "umbrella sampling restraint energy constant"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001225 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001225 obo:MOLSIM_001224)

# Class: obo:MOLSIM_001226 (number of umbrella sampling windows)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001226 "An umbrella sampling parameter that specifies the total number of individual simulations (windows) performed in an umbrella sampling workflow. Each window is typically centered at a different value along the reaction coordinate. The number of umbrella sampling windows is a key parameter for ensuring adequate coverage of the entire reaction coordinate."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001226 "number of umbrella sampling windows"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001226 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001226 obo:MOLSIM_001224)

# Class: obo:MOLSIM_001227 (umbrella anchor position)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001227 "An umbrella sampling parameter that determines the center or boundaries of the harmonic potential for a specific umbrella sampling window. This parameter defines the region of the reaction coordinate that will be sampled in that window. The umbrella anchor position is a key parameter that is varied between different windows. This is often set with the keyword anchor_position."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001227 "umbrella anchor position"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001227 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001227 obo:MOLSIM_001224)

# Class: obo:MOLSIM_001228 (accelerated MD parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001228 "A type of enhanced sampling parameter that controls an accelerated molecular dynamics (aMD) simulation. These parameters define the energy threshold and strength of the boost potential that is applied to flatten the energy landscape. The accelerated MD parameter settings are crucial for controlling the degree of enhanced sampling. These are often set in a specific amd section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001228 "accelerated MD parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001228 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001228 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001229 (aMD dihedral energy threshold)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001229 "An accelerated MD parameter that specifies the energy threshold for the dihedral energy, below which the biased potential is applied. This parameter controls when the dihedral energy term is biased. The aMD dihedral energy threshold is a key parameter for tuning the aMD simulation. This is often set with the keyword EthreshD."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001229 "aMD dihedral energy threshold"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001229 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001229 obo:MOLSIM_001228)

# Class: obo:MOLSIM_001230 (aMD dihedral alpha factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001230 "A scaling parameter used to flatten high potential energy barriers, allowing the simulation to explore conformational space much faster. It dictates the magnitude of the bias applied to the system's dihedral degrees of freedom. A smaller aMD dihedral alpha factor results in a larger boost. This is a key parameter for tuning the aMD simulation. This is often set with the keyword alphaD."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001230 "aMD dihedral alpha factor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001230 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001230 obo:MOLSIM_001228)

# Class: obo:MOLSIM_001231 (aMD potential energy threshold)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001231 "An accelerated MD parameter that specifies the energy threshold for the total potential energy, below which the biased potential is applied. This parameter controls when the total potential energy is biased. The aMD potential energy threshold is a key parameter for tuning the aMD simulation. This is often set with the keyword EthreshP."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001231 "aMD potential energy threshold"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001231 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001231 obo:MOLSIM_001228)

# Class: obo:MOLSIM_001232 (aMD potential alpha factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001232 "An accelerated MD parameter that determines the strength of the biased potential applied to the total potential energy term. A smaller aMD potential alpha factor results in a larger boost. This is a key parameter for tuning the aMD simulation. This is often set with the keyword alphaP."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001232 "aMD potential alpha factor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001232 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001232 obo:MOLSIM_001228)

# Class: obo:MOLSIM_001233 (Gaussian accelerated MD parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001233 "A type of enhanced sampling parameter that controls a Gaussian accelerated molecular dynamics (GaMD) simulation. These parameters define the upper limit of the standard deviation for the potential energy boost. The Gaussian accelerated MD parameter settings are crucial for controlling the balance between accuracy and enhanced sampling. These are often set in a specific gamd section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001233 "Gaussian accelerated MD parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001233 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001233 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001234 (GaMD potential boost stddev limit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001234 "A Gaussian accelerated MD parameter that specifies the upper limit of the standard deviation for the potential energy boost. This parameter controls the maximum strength of the applied bias. This is often set with keywords like sigma0P or sigma0D."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001234 "GaMD potential boost stddev limit"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001234 "AMBER 26 Reference Manual, p. 526, entry sigma0D."@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001234 "AMBER 26 Reference Manual, p. 526, entry sigma0P."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001234 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001234 obo:MOLSIM_001233)

# Class: obo:MOLSIM_001235 (random acceleration MD parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001235 "A type of enhanced sampling parameter that controls a random acceleration molecular dynamics (RAMD) simulation. These parameters define the strength of the randomly applied acceleration force. The random acceleration MD parameter settings are crucial for enhancing the exploration of conformational space. These are often set in a specific ramd section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001235 "random acceleration MD parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001235 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001235 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001236 (RAMD boost strength)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001236 "A random acceleration MD parameter that specifies the strength of the acceleration boost applied in a Random Acceleration Molecular Dynamics (RAMD) simulation. This parameter controls the magnitude of the random forces used to accelerate the system's exploration. The RAMD boost strength is a key parameter for tuning the RAMD simulation. This is often set with the keyword ramdboost."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001236 "RAMD boost strength"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001236 "AMBER 26 Reference Manual, p. 458, entry ramdboost."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001236 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001236 obo:MOLSIM_001235)

# Class: obo:MOLSIM_001237 (targeted MD parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001237 "A type of enhanced sampling parameter that controls a targeted molecular dynamics (TMD) simulation. These parameters define the target structure and the strength of the biasing potential used to guide the simulation towards it. The targeted MD parameter settings are essential for simulating large-scale conformational transitions between known start and end states. These are often set in a specific tmd section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001237 "targeted MD parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001237 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001237 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001238 (targeted MD force constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001238 "A targeted MD parameter that specifies the force constant for the RMSD restraint potential used to guide the simulation towards the target structure. A larger targeted MD force constant results in a stronger biasing force. This is a key parameter for controlling the strength of the targeted MD simulation. This is often set with the keyword tgtmdfrc."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001238 "targeted MD force constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001238 "AMBER 26 Reference Manual, p. 532, entry tgtmdfrc."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001238 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001238 obo:MOLSIM_001237)

# Class: obo:MOLSIM_001239 (targeted MD RMSD target)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001239 "A targeted MD parameter that specifies the target root-mean-square deviation (RMSD) value for the restraint. The simulation is guided to reduce the RMSD of the current structure relative to a reference structure to this targeted MD RMSD target value. This is a key parameter for defining the endpoint of the TMD simulation. This is often set with the keyword tgtrmsd."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001239 "targeted MD RMSD target"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001239 "AMBER 26 Reference Manual, p. 532, entry tgtrmsd."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001239 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001239 obo:MOLSIM_001237)

# Class: obo:MOLSIM_001240 (nudged elastic band parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001240 "A type of enhanced sampling parameter that controls a nudged elastic band (NEB) simulation, which is used to find the minimum energy path between two conformations. These parameters define the number of intermediate structures (images) and the spring constants connecting them. The nudged elastic band parameter settings are essential for accurately mapping reaction pathways. These are often set in a specific neb section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001240 "nudged elastic band parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001240 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001240 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001241 (NEB spring constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001241 "A nudged elastic band parameter that specifies the spring force constant connecting adjacent images along the reaction path. This parameter ensures that the images are evenly spaced and do not drift off the path. The NEB spring constant is a key parameter for the stability and convergence of the NEB calculation. This is often set with the keyword nebk."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001241 "NEB spring constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001241 "AMBER 26 Reference Manual, p. 550, entry nebk."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001241 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001241 obo:MOLSIM_001240)

# Class: obo:MOLSIM_001242 (NEB number of images)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001242 "A nudged elastic band parameter that specifies the number of intermediate structures (images) to optimize along the reaction path. A larger NEB number of images provides a more detailed representation of the path but is computationally more expensive. This is a key parameter for controlling the resolution of the NEB calculation. This is often set with the keyword neb_nimage."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001242 "NEB number of images"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001242 "AMBER 26 Reference Manual, p. 550, entry neb_nimage."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001242 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001242 obo:MOLSIM_001240)

# Class: obo:MOLSIM_001243 (well-tempered metadynamics parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001243 "A type of enhanced sampling parameter that controls a well-tempered metadynamics simulation. These parameters define how the height of the added Gaussian hills is rescaled over time, ensuring that the simulation eventually converges. The well-tempered metadynamics parameter settings are crucial for obtaining converged free energy surfaces. These are often set in a specific metadynamics section of the input file."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001243 "well-tempered metadynamics parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001243 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001243 obo:MOLSIM_001219)

# Class: obo:MOLSIM_001244 (well-tempered pseudo-temperature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001244 "A well-tempered metadynamics parameter that controls the rate at which the height of the added Gaussian hills decreases. A higher well-tempered pseudo-temperature results in a faster convergence but a less detailed exploration of the energy landscape. This is a key parameter for tuning the well-tempered metadynamics simulation. This is often set with the keyword wt_temperature."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001244 "well-tempered pseudo-temperature"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001244 "AMBER 26 Reference Manual, p. 613, entry wt_temperature."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001244 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001244 obo:MOLSIM_001243)

# Class: obo:MOLSIM_001245 (QM/MM parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001245 "A simulation parameter that controls a calculation in which part of the system is treated with quantum mechanics and the rest with a force field. Its members set which atoms are in the quantum region, which quantum method is used, and how bonds crossing the boundary are handled. The boundary treatment is the setting most likely to make a result wrong rather than merely imprecise. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001245 "QM/MM parameter"@en)
SubClassOf(obo:MOLSIM_001245 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001246 (QM charge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001246 "A QM/MM parameter giving the total charge of the quantum region as a whole number. The quantum calculation needs a definite number of electrons, so this cannot be left to be worked out. Setting it wrong gives a calculation that runs to completion and describes a different chemical species. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001246 "QM charge"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001246 "AMBER 26 Reference Manual, p. 159, entry qmcharge."@en)
SubClassOf(obo:MOLSIM_001246 obo:MOLSIM_001245)

# Class: obo:MOLSIM_001247 (QM/MM link atom distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001247 "A QM/MM parameter giving how far the completing atom is placed from the quantum atom it is attached to. It is set so the resulting bond has a realistic length for the pair of elements involved. Too short or too long a value distorts the electronic structure right at the boundary, which is usually where the chemistry of interest is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001247 "QM/MM link atom distance"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001247 "AMBER 26 Reference Manual, p. 175, entry lnk_dis."@en)
SubClassOf(obo:MOLSIM_001247 obo:MOLSIM_001245)

# Class: obo:MOLSIM_001248 (QM/MM non-bonded cutoff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001248 "A QM/MM parameter giving the distance beyond which interactions between the quantum region and the classical region are not evaluated. Every classical atom inside it enters the quantum calculation as a charge, so the value controls both cost and accuracy directly. It is usually set larger than the ordinary non-bonded cutoff. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001248 "QM/MM non-bonded cutoff"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001248 "AMBER 26 Reference Manual, p. 172, entry qmcut."@en)
SubClassOf(obo:MOLSIM_001248 obo:MOLSIM_001245)

# Class: obo:MOLSIM_001249 (DFTB parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001249 "A QM/MM parameter controlling a density functional tight binding calculation, covering which parameter files are used, how many charge iterations are allowed and how tightly they must converge. The parameter files are specific to each pair of elements, so a system containing an unparameterised pair cannot be run. Checking that first saves discovering it at run time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001249 "DFTB parameter"@en)
SubClassOf(obo:MOLSIM_001249 obo:MOLSIM_001245)

# Class: obo:MOLSIM_001250 (DFTB max iterations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001250 "A parameter giving the greatest number of self-consistent charge iterations a tight binding calculation may take. It stops a calculation that will not converge from running indefinitely. Reaching the limit means the charges are not converged and the result must not be used. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001250 "DFTB max iterations"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001250 "AMBER 26 Reference Manual, p. 159, entry dftb_maxiter."@en)
SubClassOf(obo:MOLSIM_001250 obo:MOLSIM_001249)

# Class: obo:MOLSIM_001251 (DFTB electronic temperature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001251 "A parameter that spreads electrons smoothly across orbitals near the highest occupied level, as though the electrons were at a raised temperature. The smoothing stops the occupation jumping between iterations, which is what prevents convergence in systems with closely spaced levels. It is a numerical device, and too large a value distorts the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001251 "DFTB electronic temperature"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001251 "AMBER 26 Reference Manual, p. 159, entry dftb_telec."@en)
SubClassOf(obo:MOLSIM_001251 obo:MOLSIM_001249)

# Class: obo:MOLSIM_001252 (SCF parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001252 "A parameter controlling the iterative procedure that solves for a molecule's electrons, covering how close successive iterations must agree, how many are allowed, and which acceleration scheme is applied. A calculation that does not converge produces no result at all, so these decide whether it finishes. They are adjusted when a difficult system fails rather than set routinely. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001252 "SCF parameter"@en)
SubClassOf(obo:MOLSIM_001252 obo:MOLSIM_001245)

# Class: obo:MOLSIM_001253 (max SCF iterations)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001253 "A parameter giving the greatest number of iterations a self-consistent field calculation may take before it stops. It exists so that a calculation which will never converge does not run indefinitely. Reaching the limit means the result is not converged and must not be used, however reasonable it looks. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001253 "max SCF iterations"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001253 "AMBER 26 Reference Manual, p. 161, entry itrmax."@en)
SubClassOf(obo:MOLSIM_001253 obo:MOLSIM_001252)

# Class: obo:MOLSIM_001254 (SCF convergence criteria)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001254 "A parameter giving how little the energy or the electron density must change between iterations for a self-consistent field calculation to be considered finished. A tighter value gives a more accurate result and takes more iterations. Forces need a tighter setting than energies, because they are more sensitive to a partly converged density. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001254 "SCF convergence criteria"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001254 "AMBER 26 Reference Manual, p. 160, entry scfconv."@en)
SubClassOf(obo:MOLSIM_001254 obo:MOLSIM_001252)

# Class: obo:MOLSIM_001255 (SCF damping factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001255 "A parameter giving how much of the previous iteration's electron density is mixed into the next one. Mixing slows the calculation down and stops it oscillating between 2 near-solutions. It is raised when a difficult system will not converge and lowered otherwise, because it costs iterations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001255 "SCF damping factor"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001255 "AMBER 26 Reference Manual, p. 479, entry damp."@en)
SubClassOf(obo:MOLSIM_001255 obo:MOLSIM_001252)

# Class: obo:MOLSIM_001256 (DIIS parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001256 "A self-consistent field parameter that controls the direct inversion in the iterative subspace procedure, which speeds up convergence by extrapolating from previous iterations. The values set how many previous iterations are kept and how many extrapolation attempts are made. Poor settings make a calculation converge slowly or oscillate without settling. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001256 "DIIS parameter"@en)
SubClassOf(obo:MOLSIM_001256 obo:MOLSIM_001252)

# Class: obo:MOLSIM_001257 (DIIS attempts)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001257 "A DIIS parameter giving how many extrapolation attempts the convergence accelerator makes. Raising it makes the accelerator act more aggressively, which usually converges faster and occasionally oscillates instead. It is one of the first settings changed when a calculation fails to converge. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001257 "DIIS attempts"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001257 "AMBER 26 Reference Manual, p. 162, entry ndiis_attempts."@en)
SubClassOf(obo:MOLSIM_001257 obo:MOLSIM_001256)

# Class: obo:MOLSIM_001258 (number of DIIS matrices)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001258 "A DIIS parameter giving how many previous error vectors the convergence accelerator keeps and extrapolates from. It sets the size of the subspace used, so a larger value uses more history and more memory. Too few gives a poor extrapolation and too many can include iterations no longer relevant. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001258 "DIIS matrices"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001258 "number of DIIS matrices"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001258 "ndiis_matrices")
SubClassOf(obo:MOLSIM_001258 obo:MOLSIM_001256)

# Class: obo:MOLSIM_001259 (constant pH parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001259 "A simulation parameter controlling a constant pH run, covering how often protonation changes are attempted, how long the system is allowed to relax after one, and at what pH the simulation is held. These settings determine whether the protonation states are sampled properly or barely move. They are specific to this kind of simulation and appear nowhere else. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001259 "constant pH parameter"@en)
SubClassOf(obo:MOLSIM_001259 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001260 (CpHMD state change attempt frequency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001260 "A constant pH parameter giving how many simulation steps pass between attempts to change a residue's protonation state. Attempting more often samples the protonation states better and costs more, because each attempt requires extra calculation. Attempting too rarely leaves a residue stuck in one state for most of the run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001260 "CpHMD state change attempt frequency"@en)
SubClassOf(obo:MOLSIM_001260 obo:MOLSIM_001259)

# Class: obo:MOLSIM_001261 (number of CpHMD solvent relaxation steps)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001261 "A constant pH parameter that specifies the number of solvent relaxation steps performed after a protonation state change. Those steps let the solvent reorient around the residue that has just been charged or neutralised. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001261 "CpHMD solvent relaxation steps"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001261 "number of CpHMD solvent relaxation steps"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001261 "ntrelax")
SubClassOf(obo:MOLSIM_001261 obo:MOLSIM_001259)

# Class: obo:MOLSIM_001262 (polarizable force field parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001262 "A simulation parameter controlling a run with a polarizable force field, covering how the induced dipoles are solved for and how tightly they must converge. A loose convergence makes the forces slightly inconsistent with the energy, which shows as energy drift. These settings do not arise at all with a fixed-charge force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001262 "polarizable force field parameter"@en)
SubClassOf(obo:MOLSIM_001262 obo:MOLSIM_001164)

# Class: obo:MOLSIM_001263 (induced dipole convergence criterion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001263 "A polarizable force field parameter giving how little the induced dipoles must change between iterations before they are accepted. A tighter value gives forces closer to the exact ones and costs more iterations each step. Too loose a value makes the forces slightly inconsistent with the energy, which shows up as energy drift. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001263 "induced dipole convergence criterion"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001263 "AMBER 26 Reference Manual, p. 465, entry dipole_scf_tol."@en)
SubClassOf(obo:MOLSIM_001263 obo:MOLSIM_001262)

# Class: obo:MOLSIM_001264 (analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001264 "An input setting that determines the mathematical, statistical or filtering rules applied when existing simulation data is processed. Examples are the distance below which 2 structures count as similar, the size of a block in an error estimate, and the spacing of an analysis grid. The same trajectory analysed with different settings gives different numbers, so they are part of the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001264 "analysis parameter"@en)
SubClassOf(obo:MOLSIM_001264 obo:MOLSIM_001163)

# Class: obo:MOLSIM_001265 (clustering parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001265 "A type of analysis parameter that controls a clustering algorithm used to group similar molecular conformations from a trajectory. These parameters define the distance metric, the cutoff for cluster membership, and the number of clusters to be generated. The clustering parameter settings are crucial for identifying the dominant conformational states sampled in a simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001265 "clustering parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001265 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001265 obo:MOLSIM_001264)

# Class: obo:MOLSIM_001266 (clustering distance cutoff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001266 "A clustering parameter that specifies the distance threshold for grouping conformations into the same cluster. Two structures with a distance (e.g., RMSD) less than the clustering distance cutoff are considered to be in the same cluster. This is a key parameter for defining the granularity of the clustering. This is often set with the keyword epsilon or cutoff."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001266 "clustering distance cutoff"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001266 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001266 obo:MOLSIM_001265)

# Class: obo:MOLSIM_001267 (number of clusters to generate)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001267 "A clustering parameter giving how many groups the algorithm should produce. Algorithms such as k-means require it in advance, so it is chosen either from prior knowledge or by trying several values and comparing a quality measure. Choosing it badly either merges distinct conformations or splits one into several. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001267 "number of clusters to generate"@en)
SubClassOf(obo:MOLSIM_001267 obo:MOLSIM_001265)

# Class: obo:MOLSIM_001268 (volumetric analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001268 "An analysis parameter that controls how a 3-dimensional grid of values is produced, such as a density or an electrostatic potential map. Its members set where the grid sits, how far apart its points are and what is computed at each. Spacing chosen too coarsely hides features; chosen too finely it produces files too large to handle. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001268 "volumetric analysis parameter"@en)
SubClassOf(obo:MOLSIM_001268 obo:MOLSIM_001264)

# Class: obo:MOLSIM_001269 (grid spacing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001269 "A volumetric analysis parameter giving the distance between neighbouring points of a 3-dimensional grid. A finer grid resolves smaller features and produces a file whose size grows with the cube of the refinement. Too coarse a grid hides exactly the ordered water sites such an analysis is usually looking for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001269 "grid spacing"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001269 "AMBER 26 Reference Manual, p. 138, entry grdspc."@en)
SubClassOf(obo:MOLSIM_001269 obo:MOLSIM_001268)

# Class: obo:MOLSIM_001270 (grid function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001270 "A volumetric analysis parameter naming which quantity is computed at each point of a 3-dimensional grid, such as a density, an interaction energy or a correlation function. The choice determines what the resulting map shows. The available choices depend on the analysis program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001270 "grid function"@en)
SubClassOf(obo:MOLSIM_001270 obo:MOLSIM_001268)

# Class: obo:MOLSIM_001271 (number of grid points)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001271 "A volumetric analysis parameter that specifies the number of points in each dimension of a three-dimensional grid. It controls the size and the resolution of the volumetric data. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001271 "grid points"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001271 "number of grid points"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001271 "--ng")
SubClassOf(obo:MOLSIM_001271 obo:MOLSIM_001268)

# Class: obo:MOLSIM_001272 (statistical analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001272 "An analysis parameter controlling a statistical calculation, such as the confidence level, the number of resampling trials or the block size. These settings determine what an error bar means, so a value quoted without them cannot be interpreted. They are part of the result rather than an implementation detail. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001272 "statistical analysis parameter"@en)
SubClassOf(obo:MOLSIM_001272 obo:MOLSIM_001264)

# Class: obo:MOLSIM_001273 (p-value threshold)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001273 "A statistical analysis parameter giving the value below which a result is called significant. It is the share of the time a real effect would be claimed when none exists, so setting it at 0.05 accepts being wrong 1 time in 20. It must be chosen before the data are examined, or it means nothing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001273 "p-value threshold"@en)
SubClassOf(obo:MOLSIM_001273 obo:MOLSIM_001272)

# Class: obo:MOLSIM_001274 (confidence level)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001274 "A statistical analysis parameter giving how often an interval computed this way would contain the true value, if the whole procedure were repeated many times. A level of 95% means 19 such intervals in 20 would contain it. It does not mean there is a 95% chance the true value lies in the particular interval computed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001274 "confidence level"@en)
SubClassOf(obo:MOLSIM_001274 obo:MOLSIM_001272)

# Class: obo:MOLSIM_001275 (number of bootstrap replications)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001275 "A statistical analysis parameter giving how many times the data are resampled in a bootstrap estimate. More resamples make the estimate of the uncertainty itself more stable, at a cost that is simply proportional. It does not make the underlying data more informative, which is the mistake this setting invites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001275 "number of bootstrap replications"@en)
SubClassOf(obo:MOLSIM_001275 obo:MOLSIM_001272)

# Class: obo:MOLSIM_001276 (kernel density bandwidth)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001276 "A statistical analysis parameter giving the width of the smooth bumps placed on each data point in a kernel density estimate. Too narrow a width shows every random fluctuation as a peak; too wide a one merges genuinely separate peaks into one. It is the single most consequential choice in such an estimate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001276 "kernel density bandwidth"@en)
SubClassOf(obo:MOLSIM_001276 obo:MOLSIM_001272)

# Class: obo:MOLSIM_001277 (free energy analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001277 "An analysis parameter that controls how a free energy is calculated from simulation data. The group covers settings for end-point methods, for thermodynamic integration and for the analysis of umbrella sampling. Its members determine whether an estimate converges, so they must be recorded with the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001277 "free energy analysis parameter"@en)
SubClassOf(obo:MOLSIM_001277 obo:MOLSIM_001264)

# Class: obo:MOLSIM_001278 (MM-PBSA/GBSA parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001278 "A free energy analysis parameter that controls a molecular mechanics Poisson-Boltzmann or generalized Born surface area calculation. Its members set the continuum solvent model and the surface area treatment. They are the settings that make 2 published binding free energies for the same system disagree. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001278 "MM-PBSA/GBSA parameter"@en)
SubClassOf(obo:MOLSIM_001278 obo:MOLSIM_001277)

# Class: obo:MOLSIM_001279 (membrane dielectric constant)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001279 "A dielectric constant that describes an implicit membrane slab in a continuum solvation calculation. It is set low to represent the non-polar lipid core, which screens charge about as poorly as a protein interior. It is what makes burying a charge in the membrane region cost energy in the model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001279 "membrane dielectric constant"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001279 "AMBER 26 Reference Manual, p. 953, entry emem."@en)
SubClassOf(obo:MOLSIM_001279 obo:MOLSIM_001278)

# Class: obo:MOLSIM_001280 (probe radius)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001280 "A parameter giving the radius of the sphere rolled over a molecule's van der Waals surface to define its solvent-accessible surface area. It is normally set to 1.4 ångström, the effective radius of a water molecule. It controls how far into clefts the solvent is considered to reach, and so it changes the non-polar part of the solvation free energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001280 "probe radius"@en)
AnnotationAssertion(obo:IAO_0000119 obo:MOLSIM_001280 "AMBER 26 Reference Manual, p. 952, entry prbrad."@en)
SubClassOf(obo:MOLSIM_001280 obo:MOLSIM_001278)

# Class: obo:MOLSIM_001281 (cavity offset)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001281 "A parameter giving the constant term added to the surface-area estimate of the non-polar solvation free energy. It absorbs the part of that energy which does not scale with area. It is fitted together with the surface tension coefficient and the 2 should not be taken from different sources. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001281 "cavity offset"@en)
SubClassOf(obo:MOLSIM_001281 obo:MOLSIM_001278)

# Class: obo:MOLSIM_001282 (cavity surface tension)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001282 "A parameter giving the coefficient that converts solvent-accessible surface area into non-polar solvation free energy. It plays the part surface tension plays for a macroscopic interface, though it is fitted to small-molecule data rather than measured. It is fitted together with the cavity offset. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001282 "cavity surface tension"@en)
SubClassOf(obo:MOLSIM_001282 obo:MOLSIM_001278)

# Class: obo:MOLSIM_001283 (thermodynamic integration parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001283 "A free energy analysis parameter that controls a thermodynamic integration calculation. Its members set how many intermediate coupling states are used and how they are spaced along the path. Too few or badly spaced states leave the integral under-sampled where the energy changes fastest. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001283 "thermodynamic integration parameter"@en)
SubClassOf(obo:MOLSIM_001283 obo:MOLSIM_001277)

# Class: obo:MOLSIM_001284 (number of lambda windows)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001284 "A thermodynamic integration parameter giving how many intermediate coupling states are simulated along the transformation path. More windows make the numerical integration more accurate and the calculation proportionally more expensive. Too few leaves the integrand under-sampled where it changes fastest, which is usually near the end points. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001284 "number of lambda windows"@en)
SubClassOf(obo:MOLSIM_001284 obo:MOLSIM_001283)

# Class: obo:MOLSIM_001285 (umbrella sampling analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001285 "A type of free energy analysis parameter that controls the analysis of umbrella sampling simulations to generate a potential of mean force. These parameters define the settings for the histogramming and reweighting procedure. The umbrella sampling analysis parameter settings are crucial for correctly combining the data from multiple windows. These are often set in the input file for a WHAM or MBAR analysis program."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001285 "umbrella sampling analysis parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001285 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001285 obo:MOLSIM_001277)

# Class: obo:MOLSIM_001286 (potential mean force convergence step size)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001286 "An umbrella sampling analysis parameter that specifies the increment or step size used when assessing the convergence of the calculated Potential of Mean Force (PMF). The PMF is calculated using progressively larger amounts of data to check for convergence. The potential of mean force convergence step size is a key parameter for ensuring that the calculated free energy profile is reliable. This is a key parameter for WHAM analysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001286 "potential of mean force convergence step size"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001286 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001286 obo:MOLSIM_001285)

# Class: obo:MOLSIM_001287 (3D-RISM parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001287 "A parameter controlling a 3D-RISM calculation, covering the grid on which the solvent distribution is computed, the closure relation used, and how tightly the solution must converge. The closure choice changes the answer, not merely its precision. These settings must be reported for a solvation free energy from this method to be interpretable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001287 "3D-RISM parameter"@en)
SubClassOf(obo:MOLSIM_001287 obo:MOLSIM_001277)

# Class: obo:MOLSIM_001288 (3D-RISM convergence tolerance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001288 "A 3D-RISM parameter giving how little the solution must change between iterations before the calculation is declared finished. A tighter value gives a more accurate solvent distribution and needs more iterations. Too loose a value returns a result that looks complete and is still drifting. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001288 "3D-RISM convergence tolerance"@en)
SubClassOf(obo:MOLSIM_001288 obo:MOLSIM_001287)

# Class: obo:MOLSIM_001289 (solute-solvent interaction cutoff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001289 "A parameter giving the distance beyond which solute-solvent interactions are not evaluated in a 3D-RISM calculation. Raising it improves accuracy and raises cost, because the number of grid points grows with the cube of the distance. It is one of the main controls on how long such a calculation takes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001289 "solute-solvent interaction cutoff"@en)
SubClassOf(obo:MOLSIM_001289 obo:MOLSIM_001287)

# Class: obo:MOLSIM_001290 (NMR analysis parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001290 "A type of analysis parameter that controls the analysis of simulation data to generate properties that can be compared with Nuclear Magnetic Resonance (NMR) experiments. These parameters define the settings for calculating NMR-related observables from a trajectory. The NMR analysis parameter settings are crucial for validating simulations against experimental data. These are often set in the input file for an NMR analysis program."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001290 "NMR analysis parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001290 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001290 obo:MOLSIM_001264)

# Class: obo:MOLSIM_001291 (R6 averaged distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001291 "An NMR analysis parameter that specifies a particular form of distance averaging used in NMR structure calculation and refinement. This method involves averaging the inverse sixth power of the distance between two atoms, which is directly related to the Nuclear Overhauser Effect (NOE) intensity. The <r⁻⁶>⁻¹/⁶ averaged distance is a key parameter for back-calculating NOEs from a simulation trajectory. This is often referred to as R6 averaging."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001291 "R6 averaged distance"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001291 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001291 obo:MOLSIM_001290)

# Class: obo:MOLSIM_001292 (computed observable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001292 "A quantitative or qualitative output data item generated by a simulation or analysis process. It represents the actual measured state, derived metric, or calculated result of the system (e.g., instantaneous potential energy, calculated RMSD, assigned cluster IDs). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001292 "computed observable"@en)

# Class: obo:MOLSIM_001293 (thermodynamic property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001293 "A property describing the macroscopic thermodynamic state of a system, whose value depends only on that state and not on how the system reached it. In simulation it is obtained as an average over sampled configurations rather than from a single one. Energy, entropy and free energy are its members. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001293 "thermodynamic property"@en)
SubClassOf(obo:MOLSIM_001293 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001294 (energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001294 "A thermodynamic property giving the total energy of a system, computed from the positions and velocities of its atoms using the force field. It is reported at intervals through a run and is the first quantity checked when something is suspected to be wrong. Its components are reported separately, because a fault usually shows in one of them rather than in the total. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001294 "energy"@en)
SubClassOf(obo:MOLSIM_001294 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001295 (potential energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001295 "A component of a system's energy that depends only on where the atoms are, not on how fast they are moving. It is computed from the force field, summing the bonded terms with the electrostatic and van der Waals interactions. Its gradient is the force on each atom, which is what drives the simulation forward. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001295 "potential energy"@en)
SubClassOf(obo:MOLSIM_001295 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001296 (total potential energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001296 "A potential energy summing every bonded and non-bonded contribution for one configuration of the system. It is reported at intervals during a run and is the first thing checked when a simulation is suspected of going wrong. A steady drift in it means the integration is unstable or a setting is inconsistent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001296 "total potential energy"@en)
SubClassOf(obo:MOLSIM_001296 obo:MOLSIM_001295)

# Class: obo:MOLSIM_001297 (electrostatic energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001297 "A component of the potential energy arising from the Coulomb interaction between the partial charges on the atoms. It falls off slowly with distance, so it reaches much further than the other non-bonded term and needs special treatment in a periodic system. It is what makes polarity, solvation and ionic binding come out right or wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001297 "electrostatic energy"@en)
SubClassOf(obo:MOLSIM_001297 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001298 (1-4 electrostatic energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001298 "A component of the electrostatic energy covering only pairs of atoms separated by exactly 3 bonds. Such pairs are close enough that the plain Coulomb term would double-count what the torsion term already describes, so force fields scale it down by a fixed factor. The factor differs between force fields, which is one reason their parameters cannot be mixed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001298 "1-4 electrostatic energy"@en)
SubClassOf(obo:MOLSIM_001298 obo:MOLSIM_001297)

# Class: obo:MOLSIM_001299 (Van der Waals energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001299 "A component of the potential energy covering the short-range interaction between atoms not bonded to each other: a steep repulsion when they approach too closely and a weaker attraction at slightly greater distance. The repulsion is what gives atoms an effective size. The attraction is what makes non-polar molecules condense into liquids at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001299 "Van der Waals energy"@en)
SubClassOf(obo:MOLSIM_001299 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001300 (1-4 Van der Waals energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001300 "A component of the van der Waals energy covering only pairs of atoms separated by exactly 3 bonds. Such pairs are close enough that the full interaction would double-count what the rotation term already describes, so force fields scale it down. The scaling factor differs between force fields, which is one reason their parameters cannot be mixed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001300 "1-4 Van der Waals energy"@en)
SubClassOf(obo:MOLSIM_001300 obo:MOLSIM_001299)

# Class: obo:MOLSIM_001301 (angle energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001301 "A component of the potential energy stored in the bending of the angle between 3 bonded atoms away from its preferred value. It is softer than the bond stretching term, so angles deform more readily than bond lengths. It is what keeps a carbon centre roughly tetrahedral without any explicit rule saying so. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001301 "angle energy"@en)
SubClassOf(obo:MOLSIM_001301 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001302 (Urey-Bradley energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001302 "A component of the angle energy that adds a spring directly between the 2 outer atoms of a bonded triple, in addition to the angle term itself. It corrects the coupling between bending an angle and stretching the bonds around it, which the angle term alone cannot represent. It is used by the CHARMM force fields and not by most others. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001302 "Urey-Bradley energy"@en)
SubClassOf(obo:MOLSIM_001302 obo:MOLSIM_001301)

# Class: obo:MOLSIM_001303 (dihedral energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001303 "A component of the potential energy associated with rotation about a bond, defined by 4 atoms in sequence and repeating as the rotation goes round. It is what makes some rotational positions preferred over others, which sets the shapes a molecule can adopt. It is the term most often refitted when a force field is improved, because conformational preferences depend on it most. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001303 "dihedral energy"@en)
SubClassOf(obo:MOLSIM_001303 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001304 (improper torsion energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001304 "A component of the potential energy that holds a group of 4 atoms flat, or holds a centre in one of its 2 mirror forms. Unlike an ordinary torsion it is defined over atoms that are not in a chain, and it has a single preferred value rather than repeating. Without it a planar group such as an aromatic ring or an amide would slowly pucker. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001304 "improper torsion energy"@en)
SubClassOf(obo:MOLSIM_001304 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001305 (dispersion energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001305 "A component of the potential energy arising from momentary fluctuations in an atom's electron cloud inducing matching fluctuations in its neighbours. It is always attractive and falls off rapidly with distance, so only near neighbours contribute. It is weak between any 2 atoms and dominant in large non-polar molecules simply because there are so many pairs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001305 "dispersion energy"@en)
SubClassOf(obo:MOLSIM_001305 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001306 (polarization energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001306 "A component of the potential energy arising from a molecule's electron cloud being distorted by the electric field of its surroundings. A force field with fixed atomic charges cannot represent it and absorbs its average effect into those charges instead. Representing it explicitly is what distinguishes a polarizable force field and what makes it several times more expensive. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001306 "polarization energy"@en)
SubClassOf(obo:MOLSIM_001306 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001307 (restraint energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001307 "A component of the reported energy arising from artificial forces added to hold atoms near chosen positions or values. It measures how hard the restraint is pulling, so it says how far the system is straining against what was imposed on it. It is not part of the system's physical energy and must be excluded from any thermodynamic quantity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001307 "restraint energy"@en)
SubClassOf(obo:MOLSIM_001307 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001308 (QM energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001308 "A component of the reported energy computed quantum mechanically for one region of a system. It appears only in calculations where part of the system is treated that way and the rest with a force field. It cannot be compared with a force field energy, because the 2 are measured from different zero points. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001308 "QM energy"@en)
SubClassOf(obo:MOLSIM_001308 obo:MOLSIM_001294)
SubClassOf(obo:MOLSIM_001308 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001308 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001309 (SCF energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001309 "A quantum mechanical energy giving the electronic energy of a region once the iterative solution has converged. It is the energy of the best single-configuration description of the electrons, before any correlation correction is added. It is the baseline that post-Hartree-Fock methods improve on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001309 "SCF energy"@en)
SubClassOf(obo:MOLSIM_001309 obo:MOLSIM_001308)
SubClassOf(obo:MOLSIM_001309 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001309 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001310 (boost energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001310 "A component of the system's energy that represents an artificial (non negative) energy term added to the potential to accelerate sampling in enhanced sampling simulations. This non-physical energy helps the system overcome high energy barriers more quickly. It is reported in the log files of methods like Accelerated MD as E_boost or amd_boost."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001310 "boost energy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001310 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001310 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001311 (accelerated MD boost energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001311 "Accelerated Molecular Dynamics (aMD or GaMD) is a powerful enhanced sampling technique designed to speed up conformational transitions in biomolecular simulations. It works by applying a harmonic boost potential to the system's true potential energy surface whenever it drops below a predefined threshold. The accelerated MD boost energy is the key quantity used to reweight the biased trajectory to recover correct thermodynamic properties. It is often reported in log files as amd_boost."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001311 "accelerated MD boost energy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001311 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001311 obo:MOLSIM_001310)

# Class: obo:MOLSIM_001312 (10-12 H-bond energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001312 "A special potential term used in some older force fields to explicitly model hydrogen bonds. It is calculated using a 10-12 Lennard-Jones-like function between donor and acceptor atoms. This term is not commonly used in modern force fields but may be found in older simulation outputs. It is often reported as HBOND in energy summaries when such a potential is used."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001312 "10-12 H-bond energy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001312 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001312 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001313 (locally enhanced sampling energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001313 "A component of the reported energy contributed by the several non-interacting copies of a region that a locally enhanced sampling simulation contains. Because the copies do not see each other, their energies are summed rather than being the energy of a real system. The term exists only in this kind of simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001313 "locally enhanced sampling energy"@en)
SubClassOf(obo:MOLSIM_001313 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001314 (free energy property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001314 "A thermodynamic property combining energy and entropy into the quantity that determines which way a process goes at fixed temperature. It is the amount of work obtainable from the system under those conditions. Because it contains entropy it cannot be read off a single structure, only from an ensemble. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001314 "free energy property"@en)
SubClassOf(obo:MOLSIM_001314 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001315 (binding free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001315 "A free energy giving the change on taking 2 molecules from separate, solvated states to a bound complex. It is the quantity that determines binding affinity, so it is what a docking or free energy calculation is usually trying to predict. It is negative when binding is favourable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001315 "binding free energy"@en)
SubClassOf(obo:MOLSIM_001315 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001316 (relative binding free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001316 "A free energy giving the difference in binding free energy between 2 ligands binding the same receptor. It is obtained by transforming 1 ligand into the other alchemically, which cancels the parts of the calculation the 2 have in common. That cancellation is why it can be computed far more accurately than either absolute value. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001316 "relative binding free energy"@en)
SubClassOf(obo:MOLSIM_001316 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001317 (solvation free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001317 "A free energy giving the change on moving a molecule from vacuum into a solvent. It measures how favourable it is for the molecule to be surrounded by that solvent, and so it underlies solubility and partitioning. It appears as a leg in most thermodynamic cycles used to compute binding. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001317 "solvation free energy"@en)
SubClassOf(obo:MOLSIM_001317 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001318 (hydration free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001318 "A solvation free energy where the solvent is water. It gives the change on moving a molecule from the gas phase into aqueous solution. It is the most common benchmark for testing whether a force field treats solute-water interactions correctly, because accurate experimental values exist for many small molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001318 "hydration free energy"@en)
SubClassOf(obo:MOLSIM_001318 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001319 (polar solvation energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001319 "A component of the solvation free energy arising from electrostatic interaction between the solute's charges and the solvent. It covers both the favourable interaction of polar groups with the solvent and the cost of forming a cavity in a polar medium. Continuum solvent models compute this term and the non-polar term separately. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001319 "polar solvation energy"@en)
SubClassOf(obo:MOLSIM_001319 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001320 (nonpolar solvation energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001320 "A component of the solvation free energy arising from everything other than electrostatics, chiefly the cost of forming a cavity and the dispersion attraction between solute and solvent. It is usually estimated as proportional to the solvent-accessible surface area. That approximation is the weakest step in most end-point free energy calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001320 "nonpolar solvation energy"@en)
SubClassOf(obo:MOLSIM_001320 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001321 (surface area energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001321 "A non-polar solvation energy computed as a function of the solvent-accessible surface area of a molecule, usually a constant times the area plus an offset. It stands for the cost of opening a cavity in the solvent together with the dispersion attraction across its surface. It is the simplest of the non-polar treatments and the one used by default. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001321 "surface area energy"@en)
SubClassOf(obo:MOLSIM_001321 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001322 (Poisson-Boltzmann energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001322 "A polar solvation energy obtained by solving the Poisson-Boltzmann equation for a solute of low dielectric constant embedded in a continuum of high dielectric constant. It treats the electrostatics of solvation without approximating the shape of the molecule. It is more expensive and more faithful than the generalized Born alternative. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001322 "Poisson-Boltzmann energy"@en)
SubClassOf(obo:MOLSIM_001322 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001323 (Generalized Born energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001323 "A polar solvation energy obtained from the generalized Born model, which approximates the Poisson-Boltzmann result with a closed-form expression using an effective radius for each atom. It is far faster, which is what makes it usable inside a running simulation rather than only in post-processing. Its accuracy depends on how the effective radii are computed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001323 "Generalized Born energy"@en)
SubClassOf(obo:MOLSIM_001323 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001324 (3D-RISM solvation energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001324 "A specific type of solvation free energy calculated using the 3D Reference Interaction Site Model (3D-RISM). This method provides a detailed, atomistic picture of the solvent structure around the solute and its thermodynamics. The 3D-RISM solvation energy is a key output of 3D-RISM calculations. This value is often reported as the excess chemical potential."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001324 "3D-RISM solvation energy"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001324 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001324 obo:MOLSIM_001317)

# Class: obo:MOLSIM_001325 (excess chemical potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001325 "A type of thermodynamic property representing the free energy change of adding one particle to a system at constant volume and temperature. It is a direct measure of solvation free energy and is the primary output of methods like 3D-RISM. The calculated Excess Chemical Potential, often denoted µex or --exchem, is a key indicator of a molecule's solubility. This term is often found in the output of 3D-RISM calculations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001325 "excess chemical potential"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001325 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001325 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001326 (entropy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001326 "A thermodynamic property measuring how many microscopic arrangements a system can adopt while looking the same macroscopically. It enters the free energy with a negative sign multiplied by temperature, so a state with more arrangements is favoured, more strongly at higher temperature. It is far harder to compute from a simulation than energy, because it depends on the extent of the sampled region rather than on its depth. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001326 "entropy"@en)
SubClassOf(obo:MOLSIM_001326 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001327 (solvation entropy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001327 "An entropy component giving the change in disorder when a solute is placed in a solvent. It combines the conformational freedom the solute loses with the reorganisation forced on the solvent around it. For a non-polar solute in water the solvent term dominates, which is the origin of the hydrophobic effect. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001327 "solvation entropy"@en)
SubClassOf(obo:MOLSIM_001327 obo:MOLSIM_001326)

# Class: obo:MOLSIM_001328 (reweighting entropy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001328 "A diagnostic quantity measuring how evenly the statistical weights are spread when data from several biased simulations are combined. A low value means a few configurations carry most of the weight, so the effective sample is much smaller than the number of frames. It is checked before a reweighted average is trusted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001328 "reweighting entropy"@en)
SubClassOf(obo:MOLSIM_001328 obo:MOLSIM_001326)

# Class: obo:MOLSIM_001329 (translational entropy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001329 "An entropy component arising from the positions a molecule's centre of mass can occupy. It falls when a molecule is confined, which is why binding always carries a translational entropy cost. It depends on concentration, so the standard state must be stated with any value. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001329 "translational entropy"@en)
SubClassOf(obo:MOLSIM_001329 obo:MOLSIM_001326)

# Class: obo:MOLSIM_001330 (orientational entropy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001330 "An entropy component arising from the orientations a molecule can adopt. Like the translational component it falls on binding, because a bound molecule is held in a fixed orientation. The 2 together are the rigid-body entropy cost of forming a complex. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001330 "orientational entropy"@en)
SubClassOf(obo:MOLSIM_001330 obo:MOLSIM_001326)

# Class: obo:MOLSIM_001331 (conserved quantity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001331 "A thermodynamic property that should not change during a simulation in a given ensemble, and is therefore watched to check that the integration is sound. With no thermostat or barostat it is the total energy; with them it is that energy plus terms accounting for what they have added or removed. A steady drift in it means the timestep is too large or a setting is inconsistent, whatever else looks normal. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001331 "conserved quantity"@en)
SubClassOf(obo:MOLSIM_001331 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001332 (nonequilibrium work)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001332 "A thermodynamic property giving the work done on a system while it is driven away from equilibrium, obtained by integrating the applied force along the path taken. It differs between repetitions of the same process, so it is a distribution rather than a single number. A fluctuation theorem relates that distribution to the equilibrium free energy difference. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001332 "nonequilibrium work"@en)
SubClassOf(obo:MOLSIM_001332 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001333 (structural property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001333 "A type of output data descriptor that quantifies some aspect of the three-dimensional arrangement of atoms in a molecule or system. These descriptors are used to characterize the conformation, shape, size, and flexibility of molecules. They are the most common type of analysis performed on simulation trajectories."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001333 "structural property"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001333 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001333 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001334 (root mean square deviation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001334 "A type of structural property that measures the average distance between the atoms of two superimposed molecular structures. It is the most common metric for quantifying the difference between two conformations, often used to track a simulation's stability relative to a starting structure. Analysis outputs frequently report the RMSD value over time."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001334 "RMSD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001334 "root mean square deviation (RMSD)"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001334 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001334 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001334 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001334 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001335 (root mean square fluctuation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001335 "A type of structural property that measures the fluctuation of each individual atom around its average position over the course of a simulation. It is used to identify flexible or mobile regions within a molecule, such as loops or termini in a protein. Analysis outputs often report the per-residue RMSF or atomicfluct to highlight these regions."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001335 "RMSF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001335 "root mean square fluctuation (RMSF)"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001335 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001335 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001335 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001335 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001336 (distance RMSD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001336 "A type of structural property that measures the difference between two structures based on their internal pairwise atomic distances, rather than their Cartesian coordinates. This metric does not require structural alignment and can be more sensitive to changes in internal conformation. It is a useful alternative to standard RMSD for comparing flexible molecules."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001336 "dRMSD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001336 "distance RMSD (dRMSD)"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001336 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001336 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001336 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001336 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001337 (hydrogen mass repartitioning analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001337 "Hydrogen mass repartitioning is a system setup method where a portion of the mass of a heavy atom is transferred to its bonded hydrogen atoms. This makes the hydrogens heavier, which slows down their bond vibrations and allows a larger time step to be used in a molecular dynamics simulation. For experts, this technique, often abbreviated HMR, is a common strategy to increase computational efficiency without significantly altering the system's dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001337 "hydrogen mass repartitioning analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001337 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001337 obo:MOLSIM_000328)

# Class: obo:MOLSIM_001338 (ion-oxygen distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001338 "A distance giving the average separation between an ion and the oxygen atoms of the water molecules around it. It is the first thing measured when an ion's parameters are tested, because it can be compared directly with X-ray and neutron scattering data. Getting it wrong means the ion's whole interaction with its environment is wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001338 "ion-oxygen distance"@en)
SubClassOf(obo:MOLSIM_001338 obo:MOLSIM_000080)
SubClassOf(obo:MOLSIM_001338 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001338 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001339 (angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001339 "A structural property giving the angle formed at the middle atom of 3 specified atoms. Following one through a trajectory is the simplest way to watch a local geometry change, such as a hydrogen bond opening. It is measured between any 3 atoms, whether or not they are bonded. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001339 "angle"@en)
SubClassOf(obo:MOLSIM_001339 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001339 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001339 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001340 (dihedral angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001340 "A type of structural property representing the torsion angle defined by four sequentially bonded atoms, which describes the rotation around the central bond. The dihedral angle is the most important descriptor for characterizing the overall conformation of a flexible molecule. Its value is a primary output of many structural analysis tools. This value is commonly referred to as dihedral or torsion."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001340 "dihedral angle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001340 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001340 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001340 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001340 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001341 (protein backbone torsion angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001341 "A dihedral angle describing the rotation about one of the bonds in a protein backbone. The pair of angles either side of each alpha carbon determines the local shape of the chain, and so which secondary structure that stretch forms. Plotting the 2 against each other gives the Ramachandran plot, whose crowded and empty regions show which shapes are possible at all. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001341 "protein backbone torsion angle"@en)
SubClassOf(obo:MOLSIM_001341 obo:MOLSIM_001340)
SubClassOf(obo:MOLSIM_001341 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001341 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001342 (protein side-chain torsion angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001342 "A specific type of dihedral angle that describes the conformation of an amino acid's side chain. These angles determine the spatial arrangement of the side chain's functional groups. They are critical for understanding molecular interactions and protein packing. These angles are commonly referred to as chi angles, such as chi1 or chi2."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001342 "protein side-chain torsion angle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001342 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001342 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001342 obo:MOLSIM_001340)
SubClassOf(obo:MOLSIM_001342 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001342 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001343 (nucleic acid torsion angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001343 "A specific nucleic acid backbone dihedral angle is a torsion angle describing rotation about a bond in the sugar-phosphate backbone of DNA or RNA. The six backbone torsion angles (α, β, γ, δ, ε, and ζ), together with the glycosidic torsion angle (χ) and the sugar pucker, define the local conformation, flexibility, and overall geometry of the nucleic acid helix."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001343 "nucleic acid torsion angle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001343 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001343 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001343 obo:MOLSIM_001340)
SubClassOf(obo:MOLSIM_001343 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001343 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001344 (radius of gyration)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001344 "A type of structural property that measures the overall compactness of a molecule or a group of atoms. It is calculated as the root-mean-square distance of the atoms from their common center of mass. The radius of gyration is used to monitor large-scale conformational changes like protein folding or unfolding."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001344 "Rg"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001344 "radius of gyration"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001344 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001344 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001344 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001344 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001345 (B-factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001345 "A structural property that quantifies the positional fluctuation or displacement of an atom, representing its mobility. It is calculated from the mean-square fluctuations of atomic positions in a simulation and is analogous to the crystallographic B-factor or temperature factor. High B-factor values indicate regions of high flexibility. This value is often referred to as bfactor or B-factor."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001345 "B-factor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001345 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001345 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001345 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001345 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000047))
SubClassOf(obo:MOLSIM_001345 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001346 (TM-score)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001346 "A structural property rating how similar the overall folds of 2 proteins are, on a scale from 0 to 1, with the contribution of each residue pair weighted so that the result does not depend on protein length. Length independence is what it adds over a plain distance measure, where a longer protein always scores worse. A value above roughly 0.5 means the 2 share the same fold. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001346 "TM-score"@en)
SubClassOf(obo:MOLSIM_001346 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001346 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001346 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001347 (native contact)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001347 "A structural property giving how many of the atom or residue contacts present in a reference folded structure are also present in the conformation being scored. It is usually reported as a fraction of the reference set rather than a raw count. It is the most common single-number reaction coordinate for folding. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001347 "native contacts"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001347 "native contact"@en)
SubClassOf(obo:MOLSIM_001347 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001347 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000189))
SubClassOf(obo:MOLSIM_001347 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001348 (coordination number)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001348 "A type of structural property that represents the average number of neighboring particles within a certain distance of a central particle. For an ion in water, the Coordination Number typically refers to the number of water molecules in its first solvation shell. It is a fundamental descriptor of local solvent structure and is used to validate force fields. This value is often abbreviated as CN."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001348 "CN"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001348 "coordination number"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001348 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001348 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001348 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000189))
SubClassOf(obo:MOLSIM_001348 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001349 (molecular surface area)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001349 "A type of structural property that measures the surface area of a molecule that is accessible to a solvent. This quantity is crucial for understanding solvation effects. It is a key component in implicit solvent models and is often used to characterize a molecule's exposure to its environment. This value is commonly known as Solvent Accessible Surface Area or SASA."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001349 "molecular surface area"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001349 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001349 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001349 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000047))
SubClassOf(obo:MOLSIM_001349 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001350 (sugar pucker)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001350 "A type of structural property that describes the specific three-dimensional conformation of a sugar ring, such as the ribose in DNA or RNA. The pucker is a critical determinant of the local and global structure of a nucleic acid helix. It is often described by a pseudorotation angle and can be analyzed to characterize A-form, B-form, or other helical types. This value is a standard output of nucleic acid analysis tools."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001350 "puckering"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001350 "sugar pucker"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001350 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001350 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001350 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001351 (chirality)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001351 "A structural property recording which of its 2 mirror forms a centre in a molecule takes. The 2 forms cannot be superimposed and often behave completely differently in a biological system. A force field cannot change one into the other, so an error here persists through an entire simulation unnoticed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001351 "chirality"@en)
SubClassOf(obo:MOLSIM_001351 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001351 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001351 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001352 (molecular orientation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001352 "A type of structural property that describes the rotational position of a molecule or a group of atoms in three-dimensional space. It is often represented by a set of Euler angles, a rotation matrix, or a quaternion. Analyzing the orientation is essential for understanding the tumbling of molecules in solution or the alignment of components in a complex."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001352 "orientation"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001352 "molecular orientation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001352 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001352 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001353 (orientation angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001353 "A specific type of orientation descriptor that represents the angle of rotation between the current orientation and a reference orientation. This provides a simple, scalar measure of how much a molecule has rotated. This value is often reported as ORIENTATION_ANGLE."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001353 "orientation angle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001353 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001353 obo:MOLSIM_001352)
SubClassOf(obo:MOLSIM_001353 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001353 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001354 (orientation projection)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001354 "A specific type of orientation descriptor that represents the cosine of the angle of rotation between the current and reference positions. This value is often used in analyses of rotational correlation. This value is often reported as ORIENTATION_PROJ."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001354 "orientation projection"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001354 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001354 obo:MOLSIM_001352)

# Class: obo:MOLSIM_001355 (tilt)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001355 "A base pair step parameter that describes the rotation of one base pair relative to the next around their short axes. A non-zero tilt causes the helix to bend. It is an important parameter for describing DNA curvature. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001355 "tilt"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001355 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001355 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001355 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001355 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001355 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001356 (spin angle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001356 "A specific type of orientation descriptor that represents the angle of rotation of a molecule around a specific unit axis. The SPINANGLE is useful for analyzing spinning motions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001356 "spin angle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001356 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001356 obo:MOLSIM_001352)
SubClassOf(obo:MOLSIM_001356 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001356 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001357 (orientation quaternion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001357 "A specific type of orientation descriptor that uses a four-component mathematical object to represent the rotation of a molecule in 3D space. A quaternion avoids the singularities that can occur with Euler angles, making it a robust way to track molecular orientation. The components are often labeled QUATERNION0 through QUATERNION3. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001357 "orientation quaternion"@en)
SubClassOf(obo:MOLSIM_001357 obo:MOLSIM_001352)

# Class: obo:MOLSIM_001358 (nucleic acid parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001358 "A type of structural property that provides a detailed, quantitative description of the geometry of a nucleic acid helix. These parameters are calculated by specialized analysis programs to characterize the structure of DNA and RNA. They are essential for comparing simulated structures to experimental data and for understanding sequence-dependent structural variations. These are the standard output of programs like do_x3dna or cpptraj."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001358 "nucleic acid parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001358 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001358 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001358 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001359 (base pair parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001359 "A type of nucleic acid parameter that describes the relative geometry and orientation of the two bases within a single base pair. These parameters quantify any non-ideal arrangements within the pair. They are used to characterize the internal conformation and planarity of base pairs. These parameters include shear, stretch, stagger, buckle, propeller twist, and opening. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001359 "base pair parameter"@en)
SubClassOf(obo:MOLSIM_001359 obo:MOLSIM_001358)

# Class: obo:MOLSIM_001360 (shear)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001360 "A base pair parameter that quantifies the translational displacement of one base relative to the other along their short axis, within the plane of the base pair. A non-zero shear indicates a lateral displacement of the two bases from their ideal paired geometry, altering their relative alignment while maintaining the base-pair plane. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001360 "shear"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001360 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001360 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001360 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001360 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001360 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001361 (stretch)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001361 "A base pair parameter that quantifies the translational displacement of one base relative to the other along the axis of the hydrogen bonds. A non-zero stretch measures how much the base pair is pulled apart or compressed. It reflects the strength and dynamics of the hydrogen bonds holding the pair together. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001361 "stretch"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001361 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001361 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001361 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001361 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001361 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001362 (stagger)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001362 "A base pair parameter that quantifies the translational displacement of one base relative to the other along the axis perpendicular to the base pair plane. A non-zero stagger indicates that the two bases are offset in the direction normal to the base-pair plane, resulting in a difference in their relative height and a deviation from an ideal coplanar geometry. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001362 "stagger"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001362 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001362 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001362 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001362 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001362 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001363 (buckle)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001363 "A base pair parameter that describes the rotation of the two bases relative to each other around their long axis, roughly parallel to the hydrogen bonds. A non-zero buckle angle indicates that the bases are tilted relative to each other, producing a bent base-pair geometry. It contributes to the overall shape of the helix. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001363 "buckle"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001363 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001363 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001363 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001363 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001363 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001364 (propeller twist)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001364 "A base pair parameter that describes the rotation of the two bases relative to each other around an axis connecting their glycosidic bonds. This propeller twist optimizes stacking with adjacent base pairs but can strain hydrogen bonds. It is a key determinant of helix stability and groove dimensions. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001364 "propeller twist"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001364 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001364 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001364 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001364 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001364 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001365 (opening)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001365 "An intra-base-pair parameter that describes the relative rotation of the two bases around the axis perpendicular to the base-pair plane. A non-zero opening angle indicates that the base pair deviates from its ideal planar geometry, altering the orientation of the hydrogen-bonding and increasing their exposure to the solvent. Large opening values are often associated with transient base-pair opening (\"breathing\") or fraying events. Opening is a standard structural parameter reported by nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001365 "opening"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001365 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001365 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001365 obo:MOLSIM_001359)
SubClassOf(obo:MOLSIM_001365 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001365 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001366 (base pair step parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001366 "A type of nucleic acid parameter that describes the relative geometry and orientation between two successive base pairs in a helix. These parameters define the local helical structure. They are essential for characterizing the sequence-dependent variations in DNA and RNA structure. These parameters include shift, slide, rise, tilt, roll, and twist."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001366 "base pair step parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001366 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001366 obo:MOLSIM_001358)

# Class: obo:MOLSIM_001367 (shift)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001367 "A base pair step parameter that describes the translational displacement of one base pair relative to the next along their short axes. A non-zero shift indicates a lateral sliding motion. It affects the alignment and stacking interactions between adjacent base pairs. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001367 "shift"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001367 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001367 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001367 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001367 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001367 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001368 (slide)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001368 "A base pair step parameter that describes the translational displacement of one base pair relative to the next along their long axes. A non-zero slide is a major determinant of the width of the major and minor grooves. It is a key parameter for describing B-form DNA. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001368 "slide"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001368 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001368 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001368 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001368 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001368 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001369 (rise)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001369 "A base pair step parameter that describes the translational distance between two adjacent base pairs along the central helical axis. The rise per step is a primary determinant of the overall length of the DNA or RNA helix. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001369 "rise"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001369 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001369 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001369 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001369 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001369 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001370 (roll)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001370 "A base pair step parameter that describes the rotation of one base pair relative to the next around their long axes. A non-zero roll angle causes the helix to bend into the major or minor groove. It is a crucial parameter for DNA bendability and protein recognition. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001370 "roll"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001370 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001370 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001370 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001370 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001370 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001371 (twist)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001371 "A base pair step parameter that describes the rotation of one base pair relative to the next around the central helical axis. The helical twist is the primary determinant of the number of base pairs per turn in a DNA or RNA helix. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001371 "twist"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001371 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001371 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001371 obo:MOLSIM_001366)
SubClassOf(obo:MOLSIM_001371 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000121))
SubClassOf(obo:MOLSIM_001371 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001372 (displacement parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001372 "A nucleic acid parameter that quantifies the position of a base pair's reference frame relative to the global or local helical axis. Displacement is the distance (in Å) between the center of the base pair and the global helical axis, measured perpendicular to the helix axis. They include x-displacement and y-displacement."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001372 "displacement parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001372 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001372 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001372 obo:MOLSIM_001358)

# Class: obo:MOLSIM_001373 (x-displacement)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001373 "A displacement parameter that measures the translation of a base pair away from the central helical axis towards the major or minor groove. The x-displacement is a key parameter for distinguishing between A-form and B-form DNA. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001373 "x-displacement"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001373 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001373 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001373 obo:MOLSIM_001372)
SubClassOf(obo:MOLSIM_001373 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001373 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001374 (y-displacement)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001374 "A displacement parameter that measures the translation of a base pair away from the central helical axis along the axis of the base pair's hydrogen bonds. The y-displacement is typically small in canonical DNA structures. This is a standard output of nucleic acid analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001374 "y-displacement"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001374 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001374 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001374 obo:MOLSIM_001372)
SubClassOf(obo:MOLSIM_001374 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001374 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001375 (electronic property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001375 "A property describing where a molecule's electrons are and how they behave, obtained from a quantum mechanical calculation. These properties cannot be obtained from a classical simulation, because it has no electrons to describe. They are what determines chemical reactivity and how a molecule responds to light or to a field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001375 "electronic property"@en)
SubClassOf(obo:MOLSIM_001375 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001376 (atomic charge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001376 "An electronic property giving the partial electric charge assigned to a single atom in a molecule. No such quantity exists in the underlying physics, because electrons are not divided between atoms; it is a convention for splitting a continuous distribution. Different conventions give different values for the same molecule, so the method must always be stated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001376 "atomic charge"@en)
SubClassOf(obo:MOLSIM_001376 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001377 (electrostatic potential (ESP) derived charge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001377 "An atomic charge obtained by fitting point charges so that they reproduce the electrostatic potential computed around the molecule. It is the kind of charge most force fields use, because reproducing that potential is what a charge in a force field is for. Its weakness is that buried atoms are poorly determined, which is why restrained variants of the fit exist. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001377 "electrostatic potential (ESP) derived charge"@en)
SubClassOf(obo:MOLSIM_001377 obo:MOLSIM_001376)

# Class: obo:MOLSIM_001378 (dipole moment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001378 "An electronic property giving how far and in which direction a molecule's positive and negative charge are separated. It is what makes a molecule polar, and it determines how it aligns in a field and how strongly it interacts with other polar molecules. It is one of the few charge-related quantities that is measurable and does not depend on any convention. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001378 "dipole moment"@en)
SubClassOf(obo:MOLSIM_001378 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001379 (multipole moment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001379 "An electronic property describing a molecule's charge distribution in more detail than a dipole, through terms that capture progressively finer features of its shape. A molecule with no dipole can still interact strongly through these, as benzene does. Polarizable force fields use them on each atom in place of a single point charge. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001379 "multipole moment"@en)
SubClassOf(obo:MOLSIM_001379 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001380 (polarizability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001380 "An electronic property giving how easily a molecule's electron cloud is distorted by an electric field. A larger, softer electron cloud distorts more, so polarizability rises with molecular size. It determines the strength of dispersion attraction, which is what holds non-polar molecules together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001380 "polarizability"@en)
SubClassOf(obo:MOLSIM_001380 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001381 (hyperpolarizability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001381 "A polarizability describing how a molecule's electron cloud responds to a strong electric field, beyond the part that responds in proportion to the field. It is what makes a material double the frequency of light passing through it, or change its refractive index with intensity. It matters for optical materials and is negligible at ordinary field strengths. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001381 "hyperpolarizability"@en)
SubClassOf(obo:MOLSIM_001381 obo:MOLSIM_001380)

# Class: obo:MOLSIM_001382 (time-dependent polarizability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001382 "A polarizability describing how a molecule's response to an electric field changes with the frequency at which the field oscillates. The electron cloud cannot follow a very rapidly changing field, so the response falls off as frequency rises. It is what determines refractive index and optical rotation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001382 "time-dependent polarizability"@en)
SubClassOf(obo:MOLSIM_001382 obo:MOLSIM_001380)

# Class: obo:MOLSIM_001383 (ionization potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001383 "An electronic property giving the least energy needed to remove an electron from a molecule. A high value means the molecule holds its electrons tightly and is hard to oxidise. Together with the electron affinity it says how readily the molecule will give or take electrons in a reaction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001383 "ionization potential"@en)
SubClassOf(obo:MOLSIM_001383 obo:MOLSIM_001375)
SubClassOf(obo:MOLSIM_001383 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001383 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001384 (electron affinity)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001384 "An electronic property giving the energy released when an electron is added to a molecule. A large value means the molecule accepts electrons readily and is easily reduced. It is the counterpart of the ionization potential, which measures losing one instead. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001384 "electron affinity"@en)
SubClassOf(obo:MOLSIM_001384 obo:MOLSIM_001375)
SubClassOf(obo:MOLSIM_001384 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001384 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001385 (wavefunction property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001385 "An electronic property read directly from the mathematical function describing a molecule's electrons, rather than from an energy difference. Orbital energies, orbital shapes and the electron density itself belong here. They depend on the method and basis set used, so they are comparable only between calculations done the same way. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001385 "wavefunction property"@en)
SubClassOf(obo:MOLSIM_001385 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001386 (wavefunction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001386 "A wavefunction property giving the total electronic energy of a system at a fixed arrangement of its nuclei. It is the main output of a quantum chemistry calculation and the quantity whose derivatives give the forces. It is meaningful only as a difference, because its absolute value depends on the method and basis set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001386 "wavefunction energy"@en)
SubClassOf(obo:MOLSIM_001386 obo:MOLSIM_001385)
SubClassOf(obo:MOLSIM_001386 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001386 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001387 (wavefunction stability index)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001387 "A wavefunction property saying whether a converged solution is a true minimum or merely a point where the iteration stopped changing. A self-consistent field calculation can settle on a solution that a small change would lower, which looks converged and is not. Checking this is routine for open-shell and transition metal systems, where such false solutions are common. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001387 "wavefunction stability index"@en)
SubClassOf(obo:MOLSIM_001387 obo:MOLSIM_001385)
SubClassOf(obo:MOLSIM_001387 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001387 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001388 (charge distribution descriptor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001388 "An electronic property giving the total charge of a chosen group of atoms rather than of a single one. Grouping is more robust than per-atom charges, because the arbitrariness of dividing charge between neighbouring atoms partly cancels. It is used to state the charge of a quantum region or of a functional group. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001388 "charge distribution descriptor"@en)
SubClassOf(obo:MOLSIM_001388 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001389 (core region charge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001389 "A charge distribution descriptor giving the total charge of the atoms treated at the highest level of theory in a layered calculation. It must usually be an integer, and a non-integer value signals that the region was drawn across a polar bond. Checking it is a standard step when setting up a hybrid calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001389 "core region charge"@en)
SubClassOf(obo:MOLSIM_001389 obo:MOLSIM_001388)

# Class: obo:MOLSIM_001390 (buffer region charge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001390 "A charge distribution descriptor giving the total charge of the atoms between the high-level region and the rest of the system. That intermediate shell exists so the high-level region is not in direct contact with the crudest description. Its charge is recorded because it determines the field the inner region feels. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001390 "buffer region charge"@en)
SubClassOf(obo:MOLSIM_001390 obo:MOLSIM_001388)

# Class: obo:MOLSIM_001391 (kinetic property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001391 "A property describing how a system moves and changes with time, rather than what shape it has at one instant. Diffusion coefficients, relaxation times and transition rates belong here. They can only be obtained from a trajectory, because a single structure carries no information about time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001391 "kinetic property"@en)
SubClassOf(obo:MOLSIM_001391 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001392 (diffusion coefficient)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001392 "A kinetic property giving how fast particles spread out through random thermal motion. It is obtained from the slope of the mean squared displacement against time, or from the integral of the velocity autocorrelation function. It is one of the few simulated quantities that can be compared directly with a straightforward experiment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001392 "diffusion coefficient"@en)
SubClassOf(obo:MOLSIM_001392 obo:MOLSIM_001391)

# Class: obo:MOLSIM_001393 (mean square displacement)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001393 "A kinetic property giving the average of the squared distance a particle has moved from where it started, as a function of elapsed time. In a liquid it grows in proportion to time once the motion has become random, and the constant of proportionality gives the diffusion coefficient. Departure from that straight line marks motion that is still constrained rather than free. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001393 "mean square displacement"@en)
SubClassOf(obo:MOLSIM_001393 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001393 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000047))
SubClassOf(obo:MOLSIM_001393 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001394 (NMR relaxation time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001394 "A type of kinetic property that characterizes the rate at which nuclear spins return to thermal equilibrium after being perturbed in a Nuclear Magnetic Resonance (NMR) experiment. These relaxation times are sensitive to molecular motions on different timescales. They are key experimental observables that can be compared with simulation results to validate molecular dynamics. These are known as T1 and T2 relaxation times."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001394 "NMR relaxation time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001394 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001394 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001394 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001394 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001395 (T1 relaxation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001395 "A specific type of NMR relaxation time, also known as the spin-lattice or longitudinal relaxation time. It characterizes the rate at which the nuclear spins exchange energy with their surrounding environment (the \"lattice\"). The T1 relaxation time is sensitive to fast molecular motions, on the order of the inverse of the Larmor frequency. This is a key parameter in NMR spectroscopy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001395 "T1 relaxation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001395 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001395 obo:MOLSIM_001394)
SubClassOf(obo:MOLSIM_001395 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001395 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001396 (T2 relaxation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001396 "A specific type of NMR relaxation time, also known as the spin-spin or transverse relaxation time. It characterizes the rate at which the nuclear spins lose phase coherence with each other. The T2 relaxation time is sensitive to both fast and slow molecular motions, making it a rich source of dynamical information. This is a key parameter in NMR spectroscopy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001396 "T2 relaxation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001396 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001396 obo:MOLSIM_001394)
SubClassOf(obo:MOLSIM_001396 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001396 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001397 (correlation time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001397 "A type of kinetic property that represents the time scale over which a system's properties, such as the orientation of a bond, remain correlated. It is a measure of the \"memory\" of the system's dynamics. The correlation time is a key parameter in the interpretation of NMR relaxation data. This is often denoted tcorr or tau_c."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001397 "correlation time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001397 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001397 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001397 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001397 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001398 (spectroscopic property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001398 "A physical quantity that can be measured by or is related to a spectroscopic experiment. These properties are often calculated from simulations and compared directly with experimental data to validate the accuracy of the simulation model. They provide a crucial link between computational models and the real world. These are the primary outputs of computational spectroscopy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001398 "spectroscopic property"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001398 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001398 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001399 (J-coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001399 "A type of spectroscopic property that measures the through-bond interaction between two nuclear spins, which causes splitting of NMR signals. The J-coupling is highly sensitive to the dihedral angle between the coupled nuclei, as described by the Karplus relationship. It is a key piece of experimental data used to determine molecular conformation. This is a standard output of NMR analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001399 "J-coupling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001399 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001399 obo:MOLSIM_001398)
SubClassOf(obo:MOLSIM_001399 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000105))
SubClassOf(obo:MOLSIM_001399 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001400 (residual dipolar coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001400 "A type of spectroscopic property that provides long-range structural information in NMR experiments by measuring the orientation of bond vectors in a weakly aligned molecule. Residual Dipolar Couplings (RDCs) are extremely valuable for determining the relative orientation of distant parts of a molecule. They provide powerful restraints for refining molecular structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001400 "residual dipolar coupling"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001400 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001400 obo:MOLSIM_001398)
SubClassOf(obo:MOLSIM_001400 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000105))
SubClassOf(obo:MOLSIM_001400 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001401 (deuterium order parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001401 "The deuterium order parameter (SCD) measures the orientational order and dynamic disorder of lipid acyl chains in MD simulations. It allows for direct validation of membrane fluidity and structural phases against deuterium NMR experiments."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001401 "deuterium order parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001401 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001401 obo:MOLSIM_001398)
SubClassOf(obo:MOLSIM_001401 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001401 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001402 (S2 order parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001402 "A type of spectroscopic property that measures the motional restriction of a bond vector, typically an N-H bond in a protein, on fast timescales. The S2 order parameter ranges from 0 (completely isotropic motion) to 1 (completely rigid) and is measured by NMR relaxation experiments. It is a powerful tool for characterizing internal protein dynamics. This is a standard output of NMR relaxation analysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001402 "S2 order parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001402 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001402 obo:MOLSIM_001398)
SubClassOf(obo:MOLSIM_001402 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001402 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001403 (statistical property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001403 "A property obtained by statistical analysis of a dataset, typically a trajectory. Because a simulation samples rather than solves, almost everything reported from one is of this kind. Each carries an uncertainty that depends on how much independent data went into it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001403 "statistical property"@en)
SubClassOf(obo:MOLSIM_001403 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001404 (Pearson product-moment correlation coefficient)

AnnotationAssertion(owl:deprecated obo:MOLSIM_001404 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001404 "OBSOLETE. A specific type of correlation coefficient that measures the linear relationship between two continuous variables. It is the most common method for calculating correlation. This value is often reported in analysis as the Pearson correlation coefficient or simply 'r'. This is a standard output of statistical packages."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001404 obo:STATO_0000280)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001404 "Obsoleted 2026-07-29: duplicated both MOLSIM:000112 and STATO:0000280 - 'Pearson product-moment correlation coefficient' is the full formal name of Pearson's correlation coefficient. Replaced by the reused STATO term."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001404 "obsolete Pearson product-moment correlation coefficient"@en)

# Class: obo:MOLSIM_001405 (Spearman rank correlation coefficient)

AnnotationAssertion(owl:deprecated obo:MOLSIM_001405 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001405 "OBSOLETE. A specific type of correlation coefficient that measures the monotonic relationship between two variables, based on their ranks rather than their raw values. It is less sensitive to outliers than the Pearson correlation. The Spearman rank correlation coefficient is a non-parametric measure of association. This is often reported as rho or Spearman's rho."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001405 obo:STATO_0000201)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001405 "Obsoleted 2026-07-29: duplicated STATO:0000201. STATO is the canonical OBO home for statistics and its definition of this term is fuller than MOLSIM's (it covers the monotonic-function reading, the perfect +/-1 case, and when to prefer it over Pearson's). Note the symbol 'rho' named in the retired definition is not carried on the STATO term, which has no synonyms, because MOLSIM must not annotate a foreign IRI."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001405 "obsolete Spearman rank correlation coefficient"@en)

# Class: obo:MOLSIM_001406 (Kendall tau correlation coefficient)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001406 "A correlation coefficient measuring how far 2 variables place items in the same order, computed by counting the pairs they agree and disagree about. It uses only the ordering, so it is unaffected by how the values are spaced and by extreme outliers. That makes it the right measure when the purpose is to rank rather than to predict a number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001406 "Kendall tau correlation coefficient"@en)
SubClassOf(obo:MOLSIM_001406 obo:STATO_0000142)
SubClassOf(obo:MOLSIM_001406 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001406 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001407 (root mean square error (RMSE))

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001407 "A statistical property giving the typical size of the difference between predicted and observed values, computed by squaring the differences, averaging them and taking the square root. Squaring first makes large errors count disproportionately, so a single bad prediction moves it noticeably. It is in the same units as the quantity itself, which makes it directly interpretable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001407 "root mean square error (RMSE)"@en)
SubClassOf(obo:MOLSIM_001407 obo:MOLSIM_001403)

# Class: obo:MOLSIM_001408 (mean absolute error (MAE))

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001408 "A statistical property giving the average size of the difference between predicted and observed values, ignoring sign. Because it does not square the differences, every error counts in proportion to its size and one large error does not dominate. It is the measure to prefer when outliers are expected and should not be allowed to control the score. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001408 "mean absolute error (MAE)"@en)
SubClassOf(obo:MOLSIM_001408 obo:MOLSIM_001403)

# Class: obo:MOLSIM_001409 (standard error of the mean (SEM))

AnnotationAssertion(owl:deprecated obo:MOLSIM_001409 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001409 "OBSOLETE. A type of statistical property that estimates the standard deviation of the sample mean, quantifying how precisely the sample mean represents the true population mean. It is calculated by dividing the sample standard deviation by the square root of the sample size. The standard error of the mean is a key measure of the uncertainty of a calculated average value. This is often abbreviated as SEM."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001409 obo:STATO_0000037)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001409 "Obsoleted 2026-07-29: duplicated STATO:0000037. STATO is the canonical OBO home for statistics; reused in place of this term. Note the '(SEM)' abbreviation carried by the retired label is not reproduced on the STATO term, because MOLSIM must not annotate a foreign IRI; STATO's own definition spells out the abbreviation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001409 "obsolete standard error of the mean (SEM)"@en)

# Class: obo:MOLSIM_001410 (coefficient of determination)

AnnotationAssertion(owl:deprecated obo:MOLSIM_001410 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001410 "OBSOLETE. A type of statistical property, also known as R-squared, that indicates the proportion of the variance in the dependent variable that is predictable from the independent variable(s). It provides a measure of how well the observed outcomes are replicated by the model. The coefficient of determination is a key metric for assessing the goodness of fit of a regression model. This is often reported as R^2 or R-squared."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001410 obo:STATO_0000564)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001410 "Obsoleted 2026-07-29: duplicated STATO:0000564. STATO is the canonical OBO home for statistics; reused in place of this term."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001410 "obsolete coefficient of determination"@en)

# Class: obo:MOLSIM_001411 (distribution overlap)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001411 "A type of statistical property that quantifies the degree to which two probability distributions share common regions. In umbrella sampling simulations, this is a critical diagnostic for ensuring that adjacent simulation windows have sampled sufficiently overlapping regions of phase space. The distribution overlap is a key metric for validating the results of umbrella sampling or replica exchange simulations. This is often reported as Phase space overlap (PSO)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001411 "distribution overlap"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001411 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001411 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001411 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001411 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001412 (phase space overlap)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001412 "A measure of how far the configurations sampled at 2 neighbouring alchemical states coincide. Free energy estimators need configurations typical of 1 state to be reachable from the other; where they are not, the estimate is biased whatever its apparent precision. It is checked per pair of neighbouring states, not once for the whole calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001412 "phase space overlap"@en)
SubClassOf(obo:MOLSIM_001412 obo:MOLSIM_001411)
SubClassOf(obo:MOLSIM_001412 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001412 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001413 (conditional probability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001413 "A statistical property giving how likely something is, given that something else is already known to have happened. It is what the transition probabilities of a Markov model are: the chance of being in one state next, given the state now. Confusing it with the unconditional probability is among the commonest errors in reading such a model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001413 "conditional probability"@en)
SubClassOf(obo:MOLSIM_001413 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001413 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001413 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001414 (standard deviation)

AnnotationAssertion(owl:deprecated obo:MOLSIM_001414 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001414 "OBSOLETE. A type of statistical property that measures the amount of variation or dispersion of a set of values. A low standard deviation indicates that the values tend to be close to the mean, while a high value indicates that the values are spread out over a wider range. It is a fundamental measure of the variability of a calculated property. This is often abbreviated as sd or stdev."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001414 obo:STATO_0000237)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001414 "Obsoleted 2026-07-29: duplicated STATO:0000237. STATO is the canonical OBO home for statistics; reused in place of this term."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001414 "obsolete standard deviation"@en)

# Class: obo:MOLSIM_001415 (Hausdorff distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001415 "A statistical property giving how far apart 2 sets of points are, as the largest distance from any point of either set to the nearest point of the other. It is controlled by the worst-matched point rather than by the typical one. That makes it sensitive to a single outlier, which is sometimes the intention and sometimes a trap. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001415 "Hausdorff distance"@en)
SubClassOf(obo:MOLSIM_001415 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001415 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001415 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001416 (clustering quality metric)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001416 "A statistical property rating how well a set of groups describes the data, typically by comparing how tight the groups are against how far apart they lie. Such measures are used to choose how many groups to make, since most algorithms will produce any number asked for. No measure settles the question; they narrow it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001416 "clustering quality metric"@en)
SubClassOf(obo:MOLSIM_001416 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001416 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001416 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001417 (Davies-Bouldin Index)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001417 "A clustering quality metric giving the average, over all groups, of how similar each group is to the one it most resembles. Similarity here combines how spread out the 2 groups are with how close their centres lie. A lower value means the groups are compact and well separated, so it is minimised rather than maximised. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001417 "Davies-Bouldin Index"@en)
SubClassOf(obo:MOLSIM_001417 obo:MOLSIM_001416)
SubClassOf(obo:MOLSIM_001417 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001417 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001418 (pseudo-F statistic)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001418 "A clustering quality metric giving the ratio of the variation between groups to the variation within them. A high value means the groups differ from each other far more than their members differ among themselves. It is computed for several possible numbers of groups, and the number giving the highest value is taken as the best. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001418 "pseudo-F statistic"@en)
SubClassOf(obo:MOLSIM_001418 obo:MOLSIM_001416)
SubClassOf(obo:MOLSIM_001418 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001418 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001419 (SSR/SST ratio)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001419 "A clustering quality metric giving the share of the total variation in the data that is accounted for by the differences between groups. A value near 1 means almost all the variation is captured by the grouping. It always rises as more groups are added, so it is read by looking for where it stops rising steeply rather than by taking its maximum. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001419 "SSR/SST ratio"@en)
SubClassOf(obo:MOLSIM_001419 obo:MOLSIM_001416)
SubClassOf(obo:MOLSIM_001419 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001419 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001420 (cluster silhouette)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001420 "A clustering quality metric giving, for each structure, how much closer it is to its own group than to the nearest other group, on a scale from −1 to 1. A value near 1 means it clearly belongs where it was put, near 0 that it sits on a boundary, and negative that it would fit another group better. Averaging it over all structures rates the whole grouping. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001420 "cluster silhouette"@en)
SubClassOf(obo:MOLSIM_001420 obo:MOLSIM_001416)
SubClassOf(obo:MOLSIM_001420 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001420 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001421 (correlation function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001421 "A statistical property giving how strongly 2 quantities are related when separated by a given distance or a given interval of time. Its shape says both how strong the relationship is and over what range it persists. Almost every dynamic or structural quantity taken from a trajectory is one of these or derived from one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001421 "correlation function"@en)
SubClassOf(obo:MOLSIM_001421 obo:MOLSIM_001403)

# Class: obo:MOLSIM_001422 (velocity autocorrelation function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001422 "A correlation function giving how much a particle's velocity at one moment still resembles its velocity a given time later. It starts at its maximum and decays as collisions randomise the motion, so how fast it decays measures how crowded the environment is. Its integral over time gives the diffusion coefficient. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001422 "VACF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001422 "velocity autocorrelation function"@en)
SubClassOf(obo:MOLSIM_001422 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001423 (auto-covariance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001423 "A specific type of correlation function that measures the covariance of a signal with itself at different time points. It is similar to the autocorrelation function but is not normalized."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001423 "auto-covariance"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001423 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001423 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001424 (total correlation function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001424 "A correlation function giving the total departure from randomness in the positions of 2 particles in a liquid, counting both their direct influence on each other and influence passed through intervening particles. It is written h(r) and relates to the pair distribution function as h(r) = g(r) − 1. It is 1 of the 2 unknowns the RISM equations solve for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001424 "total correlation function"@en)
SubClassOf(obo:MOLSIM_001424 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001425 (direct correlation function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001425 "A specific type of correlation function that describes the direct correlation between two particles in a liquid, excluding indirect effects mediated by other particles. It is a fundamental quantity in the statistical mechanics of liquids, related to the total correlation function by the Ornstein-Zernike equation. This is often denoted as c(r). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001425 "direct correlation function"@en)
SubClassOf(obo:MOLSIM_001425 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001426 (pair-distribution function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001426 "A correlation function giving how likely a particle is to be found at each distance from another particle, relative to a uniform distribution. Peaks mark the distances at which neighbours prefer to sit, so the first peak gives the size of the first solvation shell. It is the standard way the structure of a liquid is described. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001426 "pair-distribution function"@en)
SubClassOf(obo:MOLSIM_001426 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001427 (miscellaneous descriptor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001427 "A type of output data descriptor for calculated properties that do not fit into the other major categories like thermodynamic or structural properties. This includes mathematical quantities derived from the potential energy surface or other specific analysis metrics. These are often specialized outputs from analysis programs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001427 "miscellaneous descriptor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001427 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001427 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001428 (gradient)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001428 "A vector of the first derivatives of the potential energy with respect to each atomic coordinate. Its negative is the force on each atom, which is what a simulation uses to move them. A minimization has converged when it is close to zero everywhere. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001428 "gradient"@en)
SubClassOf(obo:MOLSIM_001428 obo:MOLSIM_001427)

# Class: obo:MOLSIM_001429 (hessian)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001429 "A matrix of the second derivatives of the potential energy with respect to every pair of atomic coordinates. It gives the curvature of the energy surface at a point, so it says whether that point is a minimum, a saddle or neither. Diagonalising it gives the vibrational normal modes and their frequencies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001429 "hessian"@en)
SubClassOf(obo:MOLSIM_001429 obo:MOLSIM_001427)

# Class: obo:MOLSIM_001430 (atom interaction count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001430 "A descriptor giving how many interactions of a chosen kind, such as hydrogen bonds or close contacts, involve a particular atom or group. It reduces a pattern of contacts to a single number that can be followed over time. What it counts depends entirely on the distance and angle criteria used, which must be stated with it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001430 "atom interaction count"@en)
SubClassOf(obo:MOLSIM_001430 obo:MOLSIM_001427)
SubClassOf(obo:MOLSIM_001430 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000189))
SubClassOf(obo:MOLSIM_001430 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001431 (similarity score)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001431 "A type of miscellaneous descriptor that provides a metric for measuring the similarity between two entities, such as molecular structures or atom types. The similarity score is a quantitative measure used in various contexts, from virtual screening to parameter estimation. This is a key output of cheminformatics tools. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001431 "similarity score"@en)
SubClassOf(obo:MOLSIM_001431 obo:MOLSIM_001427)
SubClassOf(obo:MOLSIM_001431 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001431 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001432 (adaptive string method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001432 "The Adaptive String Method (ASM) is a numerical technique used in computational chemistry and physics to find minimum free energy paths (MFEPs) or reaction pathways in complex, high-dimensional systems such as chemical reactions, conformational changes in biomolecules, or phase transitions. It is an improvement over the original string method because it adapts the distribution of points (\"images\") along the path to better capture regions of high curvature or complexity. For experts, this adaptive placement of images leads to a more efficient and accurate determination of the minimum free energy path."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001432 "adaptive string method"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001432 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001432 obo:MOLSIM_000860)

# Class: obo:MOLSIM_001433 (ensemble trajectory analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001433 "Ensemble trajectory analysis is a method that involves analyzing a large collection of independent simulation trajectories together, rather than just a single long one. This approach provides a more robust and statistically reliable picture of a molecule's behavior by sampling a wider range of starting conditions and potential pathways. It is particularly important for studying complex processes like protein folding or for achieving converged statistics on a system's properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001433 "ensemble trajectory analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001433 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001433 obo:MOLSIM_000939)

# Class: obo:MOLSIM_001434 (ABCG2 charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001434 "A method for assigning partial atomic charges to organic molecules for use in molecular simulations. This model aims to produce charges that accurately reproduce a molecule's interaction with water, a key factor in predicting properties like solvation free energy. When used with the General AMBER Force Field (GAFF2), it has demonstrated the ability to achieve \"chemical accuracy\" for a wide range of compounds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001434 "ABCG2 charge model"@en)
SubClassOf(obo:MOLSIM_001434 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001435 (CM1 charge method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001435 "A method that obtains atomic charges by taking the charges from a fast semi-empirical calculation and correcting them with terms fitted to reproduce measured dipole moments. The correction is what fixes the known bias of the underlying charges. It is fast enough to apply to large numbers of molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001435 "CM1 charge method"@en)
SubClassOf(obo:MOLSIM_001435 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001436 (CM2 charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001436 "A charge model refining the earlier CM1 scheme with corrections fitted against a larger set of measured dipole moments and covering more elements. The functional form is unchanged; the fitting set and the coverage are wider. It is used where semi-empirical charges are wanted quickly and reliably. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001436 "CM2 charge model"@en)
SubClassOf(obo:MOLSIM_001436 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001437 (Gasteiger charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001437 "A charge model that assigns partial charges by passing charge between bonded atoms according to their electronegativity until the flow stops. It needs no quantum calculation at all, only the bond connectivity. It is fast enough for millions of molecules and crude enough that it is used for screening rather than for simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001437 "Gasteiger charge model"@en)
SubClassOf(obo:MOLSIM_001437 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001438 (iterative polarizable charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001438 "A charge model in which atomic charges are recomputed in response to the surrounding electric field, and the calculation repeated until they stop changing. Each atom's charge affects the field its neighbours feel, so they cannot be solved one at a time. It is one of the ways a polarizable force field represents the response of the electron cloud. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001438 "iterative polarizable charge model"@en)
SubClassOf(obo:MOLSIM_001438 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001439 (amber OL3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001439 "A force field for RNA, built on the AMBER ff99 parameter set with the backbone and glycosidic dihedral terms refit by the Olomouc group. The refit corrected a drift into non-native backbone conformations that earlier RNA parameters suffered from over long simulations. It is the standard AMBER choice for RNA. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001439 "AMBER OL3"@en)
SubClassOf(obo:MOLSIM_001439 obo:MOLSIM_000011)

# Class: obo:MOLSIM_001440 (amber ff15ipq)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001440 "This is a specialized force field for simulating proteins that pays extra attention to how proteins interact with water and charged ions. The AMBER ff15ipq force field was developed to improve the description of protein interactions with ions by using a novel charge model (Implicitly Polarized Charge, IPq) that better reproduces experimental hydration free energies. This force field is particularly recommended for simulations where the accurate modeling of protein-ion interactions or salt bridge dynamics is critical to the system's behavior."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001440 "AMBER ff15ipq"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001440 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001440 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001441 (amber ff15ipq-m)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001441 "A force field specifically parameterized for the simulation of protein mimetics, which are synthetic molecules designed to mimic natural proteins. It extends the existing ff15ipq force field to include parameters for non-standard, artificial, heterogenous building blocks, such as D-amino acids and beta-amino acids. This enables researchers to accurately model the structure and dynamics of these non-natural biopolymers."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001441 "AMBER ff15ipq-m"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001441 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001441 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001442 (amber ff03)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001442 "Amber ff03 is a modified version of the ff99 AMBER force field. The main changes are that charges are now derived from quantum calculations that use a continuum dielectric to mimic solvent polarization, and that the φ and ψ backbone torsions for proteins are modified, with the effect of decreasing the preference for helical configurations. The changes are just for proteins; nucleic acid parameters are the same as in ff99."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001442 "AMBER ff03"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001442 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001442 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001443 (amber ff03ua)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001443 "This is a simplified version of the AMBER ff03 force field where the aliphatic hydrogen atoms on all amino acid side-chains are united to their corresponding carbon atoms. The aliphatic hydrogen atoms on all alpha carbon atoms are still represented explicitly to minimize the impact of the united-atom approximation on protein backbone conformations. In addition, aromatic hydrogens are also explicitly represented. Nucleic acid parameters are still in all atom and kept the same as in ff99."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001443 "AMBER ff03ua"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001443 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001443 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001444 (amber OL15)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001444 "A force field for DNA, built on the AMBER parameter set with the backbone dihedral terms refit by the Olomouc group. It improves the description of the sugar-phosphate backbone and of helical twist over the preceding DNA parameters. It was the standard AMBER choice for DNA until the 2021 revision. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001444 "AMBER OL15"@en)
SubClassOf(obo:MOLSIM_001444 obo:MOLSIM_000010)

# Class: obo:MOLSIM_001445 (nucleic acid force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001445 "A nucleic acid force field is a set of mathematical functions and parameters specifically designed to simulate the behavior of DNA and RNA molecules. These force fields contain parameters optimized to accurately reproduce the unique structural features of nucleic acids, such as the double helix, sugar puckering, and base stacking interactions. They are essential for any realistic simulation of genetic material or functional RNA molecules."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001445 "nucleic acid force field"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001445 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001445 obo:MOLSIM_000772)

# Class: obo:MOLSIM_001446 (amber bsc1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001446 "The AMBER bsc1 force field is a specific and widely used refinement for the dihedral angle parameters of the DNA backbone, designed for use with AMBER force fields. Developed by the Barcelona Supercomputing Center (BSC), it significantly improves the description of DNA's structural dynamics compared to the uncorrected force fields. It is considered a standard addition for obtaining accurate DNA simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001446 "AMBER bsc1"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001446 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001446 obo:MOLSIM_001445)

# Class: obo:MOLSIM_001447 (tumuc1 DNA force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001447 "A force field for DNA whose bonded parameters and partial charges were derived from high-level quantum mechanical calculations rather than fitted to experimental data. The consistent derivation is what distinguishes it from force fields assembled from separately fitted terms. It targets DNA structure and dynamics specifically. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001447 "tumuc1 DNA force field"@en)
SubClassOf(obo:MOLSIM_001447 obo:MOLSIM_000010)

# Class: obo:MOLSIM_001448 (amber OL21)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001448 "A force field for DNA from the Olomouc group, refit against new quantum mechanical calculations and experimental data. It is the most recent member of that series and supersedes the 2015 revision. It targets the same systems with a broader fitting set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001448 "AMBER OL21"@en)
SubClassOf(obo:MOLSIM_001448 obo:MOLSIM_000010)

# Class: obo:MOLSIM_001449 (lipid11)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001449 "A force field for phospholipids in the AMBER family, released in 2011, built on a modular scheme in which head groups and tails are parameterised separately and combined. The modularity allows lipids not in the original set to be assembled from existing pieces. It has been superseded by later revisions in the same series. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001449 "lipid11"@en)
SubClassOf(obo:MOLSIM_001449 obo:MOLSIM_000008)

# Class: obo:MOLSIM_001450 (GAFFLipid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001450 "A force field for lipids built on the General Amber Force Field, deriving its parameters from that general scheme rather than fitting them to membrane properties. Being general, it covers lipid species that a purpose-built membrane force field does not. It reproduces bulk membrane properties less well than parameters fitted for that purpose. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001450 "GAFFLipid"@en)
SubClassOf(obo:MOLSIM_001450 obo:MOLSIM_000008)

# Class: obo:MOLSIM_001451 (ParmAM1)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001451 "A parameter set in which the bonded terms of a force field are derived from calculations with the AM1 semi-empirical quantum method. Deriving parameters this way gives coverage for molecules no fitted force field includes, at the accuracy that method allows. It is used when a molecule falls outside every available parameter set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001451 "ParmAM1"@en)
SubClassOf(obo:MOLSIM_001451 obo:MOLSIM_000013)

# Class: obo:MOLSIM_001452 (ParmPM3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001452 "A parameter set in which the bonded terms of a force field are derived from calculations with the PM3 semi-empirical quantum method. Deriving parameters this way gives coverage for molecules no fitted force field includes, at the accuracy that method allows. PM3 and AM1 were fitted differently, so the 2 parameter sets are alternatives rather than successive versions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001452 "ParmPM3"@en)
SubClassOf(obo:MOLSIM_001452 obo:MOLSIM_000013)

# Class: obo:MOLSIM_001453 (material force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001453 "A force field parameterised for solid-state materials such as metals, oxides and semiconductors. It must represent bonding that has no fixed pairing, such as the shared electrons of a metal, which the bonded terms of a biomolecular force field cannot. It is not interchangeable with a biomolecular force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001453 "material force field"@en)
SubClassOf(obo:MOLSIM_001453 obo:MOLSIM_000007)

# Class: obo:MOLSIM_001454 (GAL17 force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001454 "A material force field for zeolites, which are porous crystalline aluminosilicates. It covers the framework atoms and their interaction with molecules held in the pores. It is a materials force field and shares no parameters with the biomolecular ones. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001454 "GAL17 force field"@en)
SubClassOf(obo:MOLSIM_001454 obo:MOLSIM_001453)

# Class: obo:MOLSIM_001455 (AMBER-DYES force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001455 "A force field parameter set for the fluorescent dye molecules used to label biomolecules in experiments. It is built to be used alongside the standard AMBER protein and nucleic acid parameters without modification. It lets a labelled construct be simulated as it was actually measured, which matters when interpreting FRET distances. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001455 "AMBER-DYES force field"@en)
SubClassOf(obo:MOLSIM_001455 obo:MOLSIM_000013)

# Class: obo:MOLSIM_001456 (PDDG/PM3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001456 "A semi-empirical quantum method applying pairwise distance-dependent corrections to the PM3 parameterisation. The corrections markedly improve heats of formation for organic molecules. It uses the same underlying approximation and differs in the correction terms and their fitted values. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001456 "PDDG/PM3"@en)
SubClassOf(obo:MOLSIM_001456 obo:MOLSIM_000803)

# Class: obo:MOLSIM_001457 (MNDO/d)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001457 "A semi-empirical quantum method extending MNDO with d orbitals on the heavier main-group elements. Without them, elements from the third row onwards are described badly, because their bonding involves those orbitals. It extends the method's usable range rather than changing how it treats the elements it already covered. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001457 "MNDO/d"@en)
SubClassOf(obo:MOLSIM_001457 obo:MOLSIM_000803)

# Class: obo:MOLSIM_001458 (external field model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001458 "A model that adds the effect of a field imposed from outside the system, such as an electric or magnetic field. The field acts on the charges in the system but is not affected by them. It is how a simulation represents an applied voltage, or the environment of a membrane under a potential difference. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001458 "external field model"@en)
SubClassOf(obo:MOLSIM_001458 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001459 (external point charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001459 "An external field model in which the field comes from one or more fixed charges placed in or around the system. The charges do not move and feel no force themselves. It is a way of representing a nearby charged object without simulating it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001459 "external point charge model"@en)
SubClassOf(obo:MOLSIM_001459 obo:MOLSIM_001458)

# Class: obo:MOLSIM_001460 (local density approximation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001460 "The simplest approximation used for the exchange-correlation term in density functional theory, which treats the electron density at each point as though it were part of a uniform gas of that density. It uses no information about how the density varies from place to place. It is reasonable for metals and poor for molecules, where the density changes sharply. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001460 "LDA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001460 "local density approximation"@en)
SubClassOf(obo:MOLSIM_001460 obo:MOLSIM_000627)

# Class: obo:MOLSIM_001461 (generalized gradient approximation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001461 "A class of approximations for the exchange-correlation term in density functional theory that uses how fast the electron density changes at each point as well as its value there. Including that rate of change corrects much of the error of the simpler treatment for molecules. It is the level most routine calculations use. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001461 "GGA"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001461 "generalized gradient approximation"@en)
SubClassOf(obo:MOLSIM_001461 obo:MOLSIM_000627)

# Class: obo:MOLSIM_001462 (hybrid GGA functional)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001462 "An exchange-correlation functional that mixes a fixed fraction of exactly computed exchange from Hartree-Fock theory with a density-based approximation. The mixture cancels part of the error each part makes alone, particularly the artificial repulsion of an electron from itself. It costs several times more than a purely density-based functional and is markedly more accurate for molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001462 "hybrid GGA functional"@en)
SubClassOf(obo:MOLSIM_001462 obo:MOLSIM_000627)

# Class: obo:MOLSIM_001463 (QM/MM model component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001463 "A constituent part of a hybrid model in which a small region is treated with quantum mechanics and the rest with a force field. The parts are the quantum region, the classical region, and the treatment of the boundary between them. The boundary is the difficult part, because bonds crossing it must be handled without either description breaking down. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001463 "QM/MM model component"@en)
SubClassOf(obo:MOLSIM_001463 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001464 (integration grid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001464 "A set of points at which a function is evaluated so that an integral over space can be computed as a weighted sum. Density functional theory needs one because part of its energy cannot be integrated analytically. Its density controls both the accuracy of the result and a noticeable share of the cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001464 "integration grid"@en)
SubClassOf(obo:MOLSIM_001464 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001465 (SG1 integration grid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001465 "A fixed, pre-defined integration grid for density functional theory calculations, chosen as a general-purpose default. Its point counts are set in advance rather than adapted to the molecule, so results are reproducible between programs that use it. It trades some accuracy for that predictability. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001465 "SG1 integration grid"@en)
SubClassOf(obo:MOLSIM_001465 obo:MOLSIM_001464)

# Class: obo:MOLSIM_001466 (link atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001466 "An extra atom, usually a hydrogen, placed in a hybrid quantum and classical simulation to complete a bond cut by the boundary between the 2 regions. Without it the quantum region would have an unsatisfied valence and behave like a radical. It is not part of the real molecule and is invisible to the classical region. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001466 "link atom"@en)
SubClassOf(obo:MOLSIM_001466 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001467 (bond stretching potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001467 "The part of a force field giving how the energy rises as a covalent bond departs from its preferred length. It is almost always a simple spring, chosen because it is cheap and accurate for the small departures thermal motion produces. A spring cannot break, which is the deliberate limitation of a classical force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001467 "bond stretching potential"@en)
SubClassOf(obo:MOLSIM_001467 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001468 (angle bending potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001468 "The part of a force field giving how the energy rises as the angle between 3 bonded atoms departs from its preferred value. Like the bond term it is usually a spring, but a much softer one. That softness is why bending is the main way a molecule accommodates strain. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001468 "angle bending potential"@en)
SubClassOf(obo:MOLSIM_001468 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001469 (dihedral potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001469 "The part of a force field giving how the energy varies as a bond is rotated, written as a sum of cosine terms so that it repeats through a full turn. The number of minima per turn is set by which cosine terms are included. It carries most of what a force field knows about molecular shape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001469 "dihedral potential"@en)
SubClassOf(obo:MOLSIM_001469 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001470 (1-4 non-bonded interaction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001470 "It is an electrostatic or van der Waals force between two atoms that are separated by at least three covalent bonds. It is typically composed of two parts: the van der Waals component, which models short-range repulsion and dispersion, and the electrostatic component, which models the Coulomb interaction between atomic partial charges."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001470 "1-4 non-bonded interaction"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001470 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001470 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001471 (virtual site)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001471 "A point in a force field that carries charge or interaction parameters but no mass, held at a fixed position relative to real atoms. It lets charge be placed where no nucleus sits, such as on a lone pair or slightly off a nucleus. The 4-point water models and the extra points on halogens are the common examples. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001471 "extra points"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001471 "virtual site"@en)
SubClassOf(obo:MOLSIM_001471 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001472 (bonded metal model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001472 "A way of modelling a metal ion with explicit bonds to the atoms coordinating it, so the geometry of the site is held by the same terms that hold any other bond. It reproduces the fixed arrangement of a metal centre in a protein. The bonds cannot break, so the ion cannot exchange its coordinating atoms or leave. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001472 "bonded metal model"@en)
SubClassOf(obo:MOLSIM_001472 obo:MOLSIM_000015)

# Class: obo:MOLSIM_001473 (non-bonded metal model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001473 "A way of modelling a metal ion as a charged sphere interacting only through electrostatics and van der Waals terms, with no bonds to its neighbours. The ion can then exchange its surroundings freely, as a real ion in solution does. It cannot reproduce the fixed geometry of a metal held in a protein site. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001473 "non-bonded metal model"@en)
SubClassOf(obo:MOLSIM_001473 obo:MOLSIM_000015)

# Class: obo:MOLSIM_001474 (12-6-4 Lennard-Jones model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001474 "A non-bonded potential that adds a term falling off with the fourth power of distance to the usual repulsion and attraction, representing the ion polarizing the molecules around it. That extra attraction is what a fixed-charge model otherwise omits entirely for a highly charged ion. It lets one parameter set reproduce both an ion's hydration energy and its ion-water distance, which the standard form cannot. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001474 "12-6-4 Lennard-Jones model"@en)
SubClassOf(obo:MOLSIM_001474 obo:MOLSIM_000015)

# Class: obo:MOLSIM_001475 (water cap)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001475 "A solvation model in which the solute is surrounded by a spherical droplet of explicit water rather than a fully periodic box. Using a droplet cuts the number of water molecules sharply, which is the whole purpose. It introduces a free surface, where water behaves unlike bulk, so results near the edge of the droplet are unreliable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001475 "water cap"@en)
SubClassOf(obo:MOLSIM_001475 obo:MOLSIM_000065)

# Class: obo:MOLSIM_001476 (molecule model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001476 "A representation of a single molecule as a set of atoms together with the rules governing how they interact. It fixes what is represented explicitly and what is left out, such as whether hydrogens appear individually. It is the unit a simulated system is assembled from. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001476 "molecule model"@en)
SubClassOf(obo:MOLSIM_001476 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001477 (Einstein molecule model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001477 "A model in which a molecule is represented as a set of independent harmonic oscillators, each vibrating about a fixed position. It is not meant to describe any real molecule; it serves as a reference state whose free energy is known exactly. That known value is what absolute free energies of solids and of bound states are measured against. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001477 "Einstein molecule model"@en)
SubClassOf(obo:MOLSIM_001477 obo:MOLSIM_001476)

# Class: obo:MOLSIM_001478 (generalized Born implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001478 "An implicit solvent model that approximates the electrostatic part of the solvation free energy with a closed-form expression, using an effective radius for each atom that reflects how deeply it is buried. It avoids solving a partial differential equation, so it is fast enough to run inside a simulation rather than only afterwards. Its accuracy rests entirely on how those effective radii are computed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001478 "generalized Born implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001478 obo:MOLSIM_000068)

# Class: obo:MOLSIM_001479 (GB-Neck2 implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001479 "A generalized Born implicit solvent model that refines the neck correction to the effective Born radii with re-fitted parameters. It reproduces Poisson-Boltzmann solvation energies more closely than the earlier neck model. It is the version recommended for folding and for intrinsically disordered systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001479 "GB-Neck2 implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001479 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001480 (experimental refinement model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001480 "An experimental refinement model is a computational model used to improve or interpret raw experimental data, particularly in structural biology. It combines a theoretical energy function, like a molecular mechanics force field, with terms that represent the experimental observations, such as X-ray diffraction patterns or NMR restraints."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001480 "experimental refinement model"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001480 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001480 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001481 (bulk solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001481 "A model of the disordered solvent in a crystal, used during experimental structure refinement to account for the scattering that ordered atoms do not explain. It treats that solvent as a uniform continuum of constant electron density rather than as individual water molecules. Without it, the low-resolution terms of a diffraction pattern cannot be fitted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001481 "bulk solvent model"@en)
SubClassOf(obo:MOLSIM_001481 obo:MOLSIM_001480)

# Class: obo:MOLSIM_001482 (soft core potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001482 "A non-bonded potential energy function modified so that the energy stays finite when 2 atoms overlap completely. It removes the singularity in the Lennard-Jones and Coulomb terms that appears as an atom is created or annihilated in an alchemical calculation. Without it the calculation becomes numerically unstable near the end points of the coupling parameter. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001482 "soft core potential"@en)
SubClassOf(obo:MOLSIM_001482 obo:MOLSIM_000430)

# Class: obo:MOLSIM_001483 (additive force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001483 "A force field in which the total energy is the sum of independent terms, each depending on a fixed set of atoms and unaffected by the rest of the system. Independence is what makes the energy cheap to compute and easy to parallelise. It also means the parameters cannot respond to their environment, which is what a polarizable force field adds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001483 "additive force field"@en)
SubClassOf(obo:MOLSIM_001483 obo:MOLSIM_000007)

# Class: obo:MOLSIM_001484 (statistical model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001484 "A model that describes a system through the probabilities of its possible microscopic arrangements, rather than by following any one of them. It connects what individual particles do to the temperature, pressure and free energy that are actually measured. Every thermodynamic quantity taken from a simulation rests on one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001484 "statistical mechanics model"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001484 "statistical model"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001484 "Not to be confused with STATO:0000107 \"statistical model\", which is a statistics and inference concept: a formalization of relationships between random variables. This term is the statistical-MECHANICS sense - the theoretical framework connecting the microscopic motion of atoms to macroscopic thermodynamic properties, for example the canonical ensemble. Renamed 2026-07-29 to remove that ambiguity; \"statistical model\" is retained as an exact synonym."@en)
SubClassOf(obo:MOLSIM_001484 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001485 (Maxwell-Boltzmann distribution)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001485 "A statistical model giving how the speeds of particles are spread at a given temperature, when the system is at thermal equilibrium. Most particles move near an average speed, with a long tail of fast ones and few very slow ones. Starting velocities in a simulation are drawn from it, and the observed distribution is checked against it to confirm the system has equilibrated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001485 "Maxwell-Boltzmann distribution"@en)
SubClassOf(obo:MOLSIM_001485 obo:MOLSIM_001484)

# Class: obo:MOLSIM_001486 (two-state transition model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001486 "A two-state transition model is a simplified statistical mechanics model used to describe a system that can exist in two distinct states, such as a protein in a folded or unfolded state. The model characterizes the probability of switching from one state to the other, often used to analyze the kinetics of conformational changes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001486 "two-state transition model"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001486 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001486 obo:MOLSIM_001484)

# Class: obo:MOLSIM_001487 (Becke integration grid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001487 "A scheme for building the grid of points on which a density functional theory calculation is integrated, by giving each atom its own spherical grid and blending them with weights that sum to 1 everywhere. The blending avoids double counting where atomic grids overlap. It is the standard construction such grids are built by. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001487 "Becke integration grid"@en)
SubClassOf(obo:MOLSIM_001487 obo:MOLSIM_001464)

# Class: obo:MOLSIM_001488 (Lebedev integration grid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001488 "A set of points and weights on a sphere chosen so that a numerical integration over that sphere is exact for spherical harmonics up to a stated order. It reaches a given accuracy with far fewer points than an evenly spaced grid. It is the angular part of the grid a density functional theory calculation integrates on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001488 "Lebedev integration grid"@en)
SubClassOf(obo:MOLSIM_001488 obo:MOLSIM_001464)

# Class: obo:MOLSIM_001489 (SPC/E-b)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001489 "A rigid 3-site water model refitted from its predecessor to reproduce measured properties of biomolecules in water rather than of bulk water alone. The refit adjusts how strongly water interacts with a solute. It exists because a model fitted to pure water does not necessarily solvate a protein correctly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001489 "SPC/E-b"@en)
SubClassOf(obo:MOLSIM_001489 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001490 (TIP3P-FB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001490 "A rigid 3-site water model refitted from its predecessor against a wide set of measured properties simultaneously, rather than a few. Fitting to many targets at once gives better agreement across temperature and pressure than fitting to a handful. It keeps the 3-site form, so it costs no more than the model it replaces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001490 "TIP3P-FB"@en)
SubClassOf(obo:MOLSIM_001490 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001491 (OPC3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001491 "A rigid 3-site water model whose charges and geometry were chosen to reproduce the measured electrostatic moments of a water molecule in the liquid, rather than being fitted directly to bulk properties. Getting those moments right makes the bulk properties follow. It reproduces more measured quantities than other 3-site models at the same cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001491 "OPC3"@en)
SubClassOf(obo:MOLSIM_001491 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001492 (OPC3-pol)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001492 "A 3-site water model that adjusts its charge distribution in response to the electric field around it. Real water is markedly more polar in the liquid than as an isolated molecule, and a fixed-charge model must compromise between the 2. A polarizable model does not have to, at several times the cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001492 "OPC3-pol"@en)
SubClassOf(obo:MOLSIM_001492 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001493 (WatFour (WT4) coarse-grained)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001493 "A coarse-grained water model in which 1 interaction bead stands for 4 real water molecules. Reducing the solvent particle count fourfold is where most of the speed of a coarse-grained simulation comes from, because solvent dominates the atom count. It is used with coarse-grained force fields such as MARTINI. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001493 "WatFour (WT4) coarse-grained"@en)
SubClassOf(obo:MOLSIM_001493 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001494 (crystallographic model component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001494 "A crystallographic model component is a fundamental concept used to describe the structure of a crystal. It represents one of the key pieces of information, such as the repeating unit or the symmetry rules, that define how molecules are arranged in a crystalline solid."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001494 "crystallographic model component"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001494 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001494 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001495 (asymmetric unit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001495 "The smallest portion of a crystal from which the whole structure can be built by applying the symmetry operations of its space group. It may hold 1 molecule, several, or a fraction of 1, depending on where the molecules sit relative to the symmetry elements. It is what a deposited crystal structure file usually contains. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001495 "asymmetric unit"@en)
SubClassOf(obo:MOLSIM_001495 obo:MOLSIM_001494)

# Class: obo:MOLSIM_001496 (solvation shell)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001496 "A solvation shell refers to the layer of solvent molecules that are in direct contact with or in the immediate vicinity of a solute molecule. These solvent molecules are often more ordered and have different dynamic properties compared to the bulk solvent further away. Usually, analyzing the structure and dynamics of the first and second solvation shells is crucial for understanding the details of solute-solvent interactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001496 "solvation shell"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001496 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001496 obo:MOLSIM_000065)

# Class: obo:MOLSIM_001497 (molecular structure representation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001497 "A way of describing the 3-dimensional arrangement of atoms in a molecule, either as Cartesian coordinates or as internal coordinates such as bond lengths, angles and dihedral angles. The 2 carry the same information but behave differently: internal coordinates make a constraint or a symmetry easy to impose, Cartesian ones make a translation or a rotation trivial. The choice is usually dictated by the program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001497 "molecular structure representation"@en)
SubClassOf(obo:MOLSIM_001497 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001498 (Z-matrix coordinate representation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001498 "A way of describing a molecule's geometry by giving each atom's position relative to atoms already placed, as a bond length, an angle and a rotation. It expresses shape directly, so a symmetry or a constraint can be imposed by fixing one number. It becomes unstable when 3 atoms it refers to lie nearly in a straight line. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001498 "Z-matrix coordinate representation"@en)
SubClassOf(obo:MOLSIM_001498 obo:MOLSIM_001497)

# Class: obo:MOLSIM_001499 (force field parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001499 "The collection of fitted numbers that gives a force field its behaviour for a particular class of molecules, such as proteins, lipids or carbohydrates. The functional form stays the same across sets; the numbers change. A simulation states both the form and the set, because the form alone does not identify what was used. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001499 "force field parameter set"@en)
SubClassOf(obo:MOLSIM_001499 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001500 (phosaa10 parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001500 "A parameter set covering phosphorylated amino acids such as phosphoserine, phosphothreonine and phosphotyrosine, for use alongside the ff10 protein force field. Standard protein parameters do not include them, because phosphorylation is a modification rather than a standard residue. It is matched to that protein force field and should not be used with another. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001500 "phosaa10 parameter set"@en)
SubClassOf(obo:MOLSIM_001500 obo:MOLSIM_001499)

# Class: obo:MOLSIM_001501 (phosaa14SB parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001501 "A parameter set covering phosphorylated amino acids such as phosphoserine, phosphothreonine and phosphotyrosine, for use alongside the ff14SB protein force field. Standard protein parameters do not include them, because phosphorylation is a modification rather than a standard residue. It is matched to that protein force field and should not be used with another. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001501 "phosaa14SB parameter set"@en)
SubClassOf(obo:MOLSIM_001501 obo:MOLSIM_001499)

# Class: obo:MOLSIM_001502 (phosaa19SB parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001502 "A parameter set covering phosphorylated amino acids such as phosphoserine, phosphothreonine and phosphotyrosine, for use alongside the ff19SB protein force field. Standard protein parameters do not include them, because phosphorylation is a modification rather than a standard residue. It is matched to that protein force field and should not be used with another. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001502 "phosaa19SB parameter set"@en)
SubClassOf(obo:MOLSIM_001502 obo:MOLSIM_001499)

# Class: obo:MOLSIM_001503 (Joung/Cheatham ion parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001503 "A set of parameters for common single-atom ions, fitted separately for each of several water models. Fitting per water model is the point: parameters that behave correctly with one water model do not with another. Using them with a water model they were not fitted for gives wrong hydration and wrong ion pairing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001503 "Joung/Cheatham ion parameter set"@en)
SubClassOf(obo:MOLSIM_001503 obo:MOLSIM_001499)

# Class: obo:MOLSIM_001504 (basis set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001504 "A collection of mathematical functions combined to represent the shape of each electron orbital in a quantum chemistry calculation. The true orbitals cannot be written down, so they are built up from a finite set of simpler functions instead. Everything a calculation can and cannot describe follows from which functions are in that set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001504 "basis set"@en)
SubClassOf(obo:MOLSIM_001504 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001505 (auxiliary basis set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001505 "A set of mathematical functions used to approximate products of orbital basis functions, rather than the orbitals themselves, so that electron repulsion integrals can be computed more cheaply. It is what makes density fitting and resolution-of-identity methods fast. It must be matched to the orbital basis set it is paired with, or the speed-up costs accuracy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001505 "auxiliary basis set"@en)
SubClassOf(obo:MOLSIM_001505 obo:MOLSIM_001504)

# Class: obo:MOLSIM_001506 (Lipid_ext parameter set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001506 "A parameter set extending the standard lipid parameters to cover lipid species they do not include. It is used when a membrane contains a lipid the main parameter set was never fitted for. Parameters obtained this way are less well tested than those in the main set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001506 "Lipid_ext parameter set"@en)
SubClassOf(obo:MOLSIM_001506 obo:MOLSIM_001499)

# Class: obo:MOLSIM_001507 (deep potential range corrected potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001507 "A type of machine learning force field that combines a deep neural network for short-range atomic interactions with a classical physics-based function for long-range interactions. The neural network is trained on high-accuracy quantum mechanics data to learn the complex, many-body interactions at short distances. This hybrid approach leverages the power of machine learning for the most difficult part of the calculation while retaining an efficient and physically correct description of the long-range forces, such as electrostatics. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001507 "deep potential range corrected potential"@en)
SubClassOf(obo:MOLSIM_001507 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001508 (space group)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001508 "A description of the full symmetry of a crystal, listing the rotations, reflections, translations and their combinations that leave the structure unchanged. There are 230 such groups in 3 dimensions, and every crystal belongs to exactly 1. Together with the asymmetric unit it determines the entire crystal. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001508 "space group"@en)
SubClassOf(obo:MOLSIM_001508 obo:MOLSIM_001494)

# Class: obo:MOLSIM_001509 (OBC implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001509 "A generalized Born implicit solvent model that computes effective Born radii with the scheme of Onufriev, Bashford and Case. Its radii agree closely with Poisson-Boltzmann results at a small fraction of the cost. It is the default implicit solvent in AMBER and the most widely used member of this family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001509 "OBC implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001509 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001510 (GBn implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001510 "A generalized Born implicit solvent model that corrects the effective Born radii for the narrow regions between overlapping atomic spheres, which earlier formulations treated as more solvent-exposed than they are. The correction matters most in crevices and buried pockets. The letter n in the name stands for those neck regions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001510 "GBn implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001510 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001511 (SYBYL atom type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001511 "A label classifying an atom by its element and its local bonding environment, in the scheme used by the SYBYL software and by the Mol2 file format. It distinguishes, for instance, an aromatic carbon from a carbon in a double bond. It is the classification most cheminformatics tools read from a structure file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001511 "SYBYL atom type"@en)
SubClassOf(obo:MOLSIM_001511 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001512 (generalized distance coordinate restraint)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001512 "A generalized distance coordinate restraint is a type of restraint that is applied to a complex coordinate defined as a combination of multiple distances, angles, or dihedrals. This allows for the restraining of complex conformational changes, such as the movement of a whole domain, that cannot be described by a single distance."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001512 "generalized distance coordinate restraint"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001512 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001512 obo:MOLSIM_000364)

# Class: obo:MOLSIM_001513 (magnetic susceptibility tensor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001513 "An electronic property giving how a molecule's electrons respond to a magnetic field, as a 3-by-3 array because the response depends on the field's direction relative to the molecule. A molecule with circulating electrons, such as an aromatic ring, responds much more strongly along one axis than the others. It is what underlies the ring current shifts seen in NMR spectra. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001513 "magnetic susceptibility tensor"@en)
SubClassOf(obo:MOLSIM_001513 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001514 (alignment tensor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001514 "An alignment tensor is a mathematical object that describes the degree and direction of the average orientation of molecules in a sample that is not perfectly random. In an NMR experiment, molecules can be weakly aligned by a magnetic field, and the alignment tensor quantifies this small but measurable preference in orientation. This tensor is crucial for interpreting experimental data like residual dipolar couplings (RDCs), which provide powerful long-range structural information."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001514 "alignment tensor"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001514 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001514 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001515 (Lennard-Jones parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001515 "A pair of numbers defining the van der Waals interaction of an atom type: one giving how strongly it is attracted and one giving its effective size. Parameters for 2 different atom types are combined by a rule specific to each force field. Those combining rules differ between force fields, which is one reason their parameters cannot be mixed. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001515 "Lennard-Jones parameters"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001515 "Lennard-Jones parameter"@en)
SubClassOf(obo:MOLSIM_001515 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001516 (Poisson-Boltzmann model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001516 "An implicit solvent model that represents a solute as a low-dielectric cavity in a high-dielectric continuum and solves for the electrostatic potential, including the screening by mobile salt ions. It makes no analytical approximation to the molecule's shape, so it is the reference the faster models are judged against. Solving it numerically is expensive, which is why it is usually applied to snapshots rather than during a simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001516 "Poisson-Boltzmann model"@en)
SubClassOf(obo:MOLSIM_001516 obo:MOLSIM_000068)

# Class: obo:MOLSIM_001517 (analytical linearized Poisson-Boltzmann model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001517 "A Poisson-Boltzmann model in which the equation is linearized and solved in closed form under simplifying assumptions about geometry. It is far faster than solving the full non-linear equation numerically. It holds only where electrostatic potentials are small, so it is unreliable for highly charged systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001517 "analytical linearized Poisson-Boltzmann model"@en)
SubClassOf(obo:MOLSIM_001517 obo:MOLSIM_001516)

# Class: obo:MOLSIM_001518 (CHAGB implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001518 "A generalized Born implicit solvent model that accounts for charge hydration asymmetry, the fact that a negative ion and a positive ion of the same size are not solvated equally by water. It adjusts the solvation term according to the sign of the charge, which a standard generalized Born model cannot do. It was built to improve solvation free energies for ions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001518 "CHAGB implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001518 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001519 (GBION implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001519 "A generalized Born implicit solvent model whose effective Born radii for ions were re-fitted to reproduce measured hydration free energies. It targets the ions specifically, leaving the treatment of the solute unchanged. It is used where ion solvation must be right but explicit water is too expensive. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001519 "GBION implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001519 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001520 (GBNSR6 implicit solvent model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001520 "A generalized Born implicit solvent model that computes each atom's effective radius from an analytical integral over the molecular surface rather than over atomic volumes. Integrating over the surface reproduces Poisson-Boltzmann results more closely, particularly for buried atoms. It is built for accuracy at a cost still far below solving the Poisson-Boltzmann equation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001520 "GBNSR6 implicit solvent model"@en)
SubClassOf(obo:MOLSIM_001520 obo:MOLSIM_001478)

# Class: obo:MOLSIM_001521 (group transfer free energy model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001521 "A model that estimates the free energy of a process by adding up tabulated free energies for moving each chemical group between environments, such as from water into a protein interior. The group values are measured once on small molecules and then reused. It is fast and additive, which also means it cannot capture effects that depend on how groups are arranged relative to one another. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001521 "group transfer free energy model"@en)
SubClassOf(obo:MOLSIM_001521 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001522 (small molecule structural database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001522 "A database holding the 2-dimensional and 3-dimensional structures of small organic compounds. Such collections supply the starting geometries and the reference conformations that force field parameters are fitted and tested against. They differ from protein structure archives in holding many small entries rather than few large ones. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001522 "small molecule structural database"@en)
SubClassOf(obo:MOLSIM_001522 obo:MOLSIM_000691)

# Class: obo:MOLSIM_001523 (3D-RISM model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001523 "A RISM model that solves the integral equations on a 3-dimensional grid around a solute, giving the spatial distribution of each solvent site. It shows where solvent molecules are likely to sit, including individual ordered water positions, without running a simulation. It needs the bulk solvent correlation functions from a 1-dimensional calculation as input. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001523 "3D-RISM model"@en)
SubClassOf(obo:MOLSIM_001523 obo:MOLSIM_001535)

# Class: obo:MOLSIM_001524 (closure relation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001524 "An approximate equation relating the 2 unknown correlation functions in an integral equation theory of liquids, so that the system can be solved. Without it there are 2 unknowns and 1 equation. Different choices, such as hypernetted-chain or Kovalenko-Hirata, give measurably different solvation free energies from otherwise identical input. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001524 "closure relation"@en)
SubClassOf(obo:MOLSIM_001524 obo:MOLSIM_001535)

# Class: obo:MOLSIM_001525 (Kovalenko-Hirata closure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001525 "The Kovalenko-Hirata (KH) closure is a mathematical approximation used in the statistical mechanical Ornstein-Zernike (OZ) integral equation theory (commonly utilized in 3D-RISM theory) to calculate solvent structure and solvation free energy."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001525 "Kovalenko-Hirata closure"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001525 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001525 obo:MOLSIM_001524)

# Class: obo:MOLSIM_001526 (machine-learned solvent excluded surface model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001526 "An implicit solvent model that predicts solvation free energy with a model trained on more expensive calculations, using the shape of the surface the solvent cannot enter. It replaces the analytical approximation that a generalized Born model makes with a fitted one. It is faster than solving the Poisson-Boltzmann equation and more accurate than the analytical approximations, within the range it was trained on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001526 "machine-learned solvent excluded surface model"@en)
SubClassOf(obo:MOLSIM_001526 obo:MOLSIM_000068)

# Class: obo:MOLSIM_001527 (delta machine learning potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001527 "A machine-learned potential that predicts only the difference between a cheap approximate calculation and an accurate one, rather than the full energy. The difference is smaller and smoother than the energy itself, so far less training data is needed to learn it well. The cheap calculation still has to be run, which is the cost of the approach. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001527 "delta machine learning potential"@en)
SubClassOf(obo:MOLSIM_001527 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001528 (RESP induced dipole charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001528 "A charge model that fits permanent point charges to the electrostatic potential and adds an induced dipole on each atom to represent the response to a field. The permanent part describes the isolated molecule and the induced part its response to the environment. It is how a polarizable force field is parameterised from quantum calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001528 "RESP induced dipole charge model"@en)
SubClassOf(obo:MOLSIM_001528 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001529 (RESP permanent multipole charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001529 "A charge model that fits a dipole and higher terms on each atom, not only a point charge, to reproduce the electrostatic potential around a molecule. The extra terms capture features a point charge cannot, such as the anisotropy of a lone pair or the positive region on a halogen. It is more accurate and more expensive to use. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001529 "RESP permanent multipole charge model"@en)
SubClassOf(obo:MOLSIM_001529 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001530 (amber fb15)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001530 "The AMBER FB15 (force-balanced 15) protein force field is a refinement of the AMBER94 ff with a systematic and thorough optimization of the intramolecular terms. The key difference in the optimized result is a significant lowering of the potential in regions away from the energy minima, which is expected to yield greater flexibility in finite temperature simulations. This force field is particularly useful for simulations of proteins, particularly when fluctuations away from equilibrium, conformational changes, and/or temperature dependence are expected to play important roles."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001530 "AMBER fb15"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001530 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001530 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001531 (united-atom force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001531 "A force field in which non-polar hydrogens are merged into the heavy atom they are bonded to, so that a methyl group is one interaction site. It roughly halves the atom count of an organic system at little cost in accuracy, because those hydrogens carry almost no charge. Polar hydrogens are kept, because they form hydrogen bonds. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001531 "united-atom force field"@en)
SubClassOf(obo:MOLSIM_001531 obo:MOLSIM_000007)

# Class: obo:MOLSIM_001533 (drude oscillator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001533 "A light charged particle attached by a spring to an atom, used to represent how that atom's electron cloud shifts in an electric field. The particle moves with the field while the atom stays put, which reproduces polarization without any electrons being modelled. Treating polarization as an extra particle lets an ordinary integrator handle it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001533 "drude oscillator"@en)
SubClassOf(obo:MOLSIM_001533 obo:MOLSIM_001262)

# Class: obo:MOLSIM_001534 (1D-RISM model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001534 "A RISM model that solves the integral equations for a homogeneous fluid, giving site-to-site correlation functions that depend only on distance. It describes the structure of the bulk solvent itself, with no solute present. Its output is the required input for a 3-dimensional calculation around a solute. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001534 "1D-RISM model"@en)
SubClassOf(obo:MOLSIM_001534 obo:MOLSIM_001535)

# Class: obo:MOLSIM_001535 (RISM model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001535 "A statistical mechanical model of molecular liquids that predicts how solvent molecules arrange themselves around a solute by solving integral equations for site-to-site correlation functions. It gives an atomistic picture of solvation without simulating individual solvent molecules moving. It sits between an implicit solvent model and explicit solvent in both cost and detail. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001535 "reference interaction site model"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001535 "RISM model"@en)
SubClassOf(obo:MOLSIM_001535 obo:MOLSIM_000065)

# Class: obo:MOLSIM_001536 (dielectrically consistent RISM model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001536 "A RISM model corrected so that its results reproduce the known dielectric constant of the solvent. Standard RISM does not, which distorts long-range electrostatics. The correction matters most for solvation free energies of charged solutes. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001536 "dielectrically consistent RISM model"@en)
SubClassOf(obo:MOLSIM_001536 obo:MOLSIM_001535)

# Class: obo:MOLSIM_001537 (temperature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001537 "A thermodynamic property giving the average kinetic energy of the particles in a system, expressed on a conventional scale. In a simulation it is computed from the velocities and fluctuates strongly, because the system is small. A value quoted from a short stretch of trajectory can differ from the target by several degrees for that reason alone. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001537 "temperature"@en)
SubClassOf(obo:MOLSIM_001537 obo:MOLSIM_001293)
SubClassOf(obo:MOLSIM_001537 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000005))
SubClassOf(obo:MOLSIM_001537 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001538 (charge-dependent van der Waals correction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001538 "A force field feature in which an atom's effective size changes with the partial charge it currently carries. A real atom shrinks as it loses electron density and expands as it gains it, which a fixed radius cannot represent. It matters most for atoms whose charge varies widely between environments. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001538 "charge-dependent van der Waals correction"@en)
SubClassOf(obo:MOLSIM_001538 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001539 (GFN1-xTB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001539 "A semi-empirical tight binding method parameterised to give good geometries, vibrational frequencies and non-covalent interactions across most of the periodic table. It was fitted against those 3 targets rather than against energies, which is what its name records. It is used to optimise structures and screen conformations quickly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001539 "GFN1-xTB"@en)
SubClassOf(obo:MOLSIM_001539 obo:MOLSIM_000803)

# Class: obo:MOLSIM_001540 (GFN2-xTB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001540 "A semi-empirical tight binding method that adds atom-centred multipoles and a density-dependent dispersion treatment to the earlier method in its family. Those additions improve non-covalent interactions and the description of charged systems. It is the member of the family in general use. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001540 "GFN2-xTB"@en)
SubClassOf(obo:MOLSIM_001540 obo:MOLSIM_000803)

# Class: obo:MOLSIM_001541 (PIF correction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001541 "A correction applied to free energy calculations in which the electronic description changes between the 2 states, adjusting for the mismatch between them. Without it the computed difference contains a contribution from the change of method rather than from the chemistry. It is applied after the calculation rather than changing how it runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001541 "PIF correction"@en)
SubClassOf(obo:MOLSIM_001541 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001542 (MAIS correction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001542 "A correction applied to free energy calculations run with a particular polarizable force field, adjusting for the way that force field attenuates interactions at short range. Without it the computed free energies carry a systematic offset. It is applied after the calculation rather than changing how it runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001542 "MAIS correction"@en)
SubClassOf(obo:MOLSIM_001542 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001543 (reactive force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001543 "A force field that allows bonds to form and break during a simulation, by making the bonding terms depend on how many neighbours each atom currently has rather than on a fixed list. That removes the fixed topology an ordinary force field relies on. It reaches system sizes no quantum method can while still describing reactions, at a cost far above a conventional force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001543 "reactive force field"@en)
SubClassOf(obo:MOLSIM_001543 obo:MOLSIM_000007)

# Class: obo:MOLSIM_001544 (ReaxFF)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001544 "A reactive force field in which the strength of every bond is recomputed from interatomic distances at each step, so bonds can form and break. Charges are also recomputed, since they change as bonds do. It reaches system sizes no quantum method can while still describing reactions, at perhaps 100 times the cost of a conventional force field. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001544 "ReaxFF"@en)
SubClassOf(obo:MOLSIM_001544 obo:MOLSIM_001543)

# Class: obo:MOLSIM_001545 (NBFIX correction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001545 "An adjustment that replaces the van der Waals parameters for one particular pair of atom types, overriding whatever the combining rule would give. It exists because the combining rule is a convenience rather than physics, and fails badly for some pairs, ions with carboxylate oxygens in particular. It is applied pair by pair rather than by changing the atom types themselves. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001545 "NBFIX correction"@en)
SubClassOf(obo:MOLSIM_001545 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001546 (polarization algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001546 "An algorithm that computes the induced dipole on each atom in a polarizable force field. Each induced dipole changes the field felt by the others, so they must be solved together rather than one at a time. That coupling is what makes a polarizable simulation several times more expensive than a fixed-charge one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001546 "polarization algorithm"@en)
SubClassOf(obo:MOLSIM_001546 obo:MOLSIM_000382)

# Class: obo:MOLSIM_001547 (Applequist scheme)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001547 "A classical model that computes induced dipoles in a set of polarizable atoms by giving each a point polarizability and solving the resulting linear equations self-consistently. It captures how the dipole induced on one atom polarizes its neighbours in turn. It diverges when atoms are too close together, which later schemes damp. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001547 "Applequist scheme"@en)
SubClassOf(obo:MOLSIM_001547 obo:MOLSIM_001546)

# Class: obo:MOLSIM_001548 (RESP permanent virtual site charge model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001548 "A charge model that fits point charges to the electrostatic potential while allowing some of them to sit at fixed positions away from any nucleus. Placing charge off-nucleus reproduces directional features, such as a lone pair, without the cost of higher multipole terms. It is the cheaper alternative to a multipole description. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001548 "RESP permanent virtual site charge model"@en)
SubClassOf(obo:MOLSIM_001548 obo:MOLSIM_000204)

# Class: obo:MOLSIM_001549 (linear mixing potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001549 "A potential energy function formed as a straight-line interpolation between the functions of an initial and a final state, controlled by a coupling parameter running from 0 to 1. It is what makes a continuous path between 2 chemically different states possible in an alchemical calculation. It behaves badly when atoms appear or disappear, which is why the soft-core variant exists. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001549 "linear mixing potential"@en)
SubClassOf(obo:MOLSIM_001549 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001550 (CpHMD library format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001550 "A data format defining, for each residue that can gain or lose a proton, the topology and charges of every protonation state it can take and the reference energy of each. A constant pH simulation reads it to know what states are available and what switching between them costs. A residue absent from the library cannot titrate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001550 "CpHMD library format"@en)
SubClassOf(obo:MOLSIM_001550 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001551 (correction map)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001551 "A force field component that adds an energy correction read from a 2-dimensional grid indexed by a pair of neighbouring backbone rotation angles. The pair of angles is treated together rather than as 2 independent terms, which is what lets the correction fix their coupling. It was introduced to bring simulated backbone conformational populations into line with experiment. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001551 "CMAP")
AnnotationAssertion(rdfs:label obo:MOLSIM_001551 "correction map"@en)
SubClassOf(obo:MOLSIM_001551 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001552 (restraint potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001552 "A restraint potential is an artificial energy function that is added to the force field to guide a simulation. This potential adds an energy penalty when the system deviates from a user-defined geometric target, such as a specific distance, angle, or RMSD value."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001552 "restraint potential"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001552 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001552 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001553 (inhomogeneous fluid solvation theory)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001553 "A statistical mechanical theory that describes solvent around a solute by treating the solvent as a fluid whose density and orientation vary with position. It assigns energy and entropy to each region rather than to the system as a whole. That local assignment is what lets individual water sites be scored for displacement by a ligand. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001553 "inhomogeneous fluid solvation theory"@en)
SubClassOf(obo:MOLSIM_001553 obo:MOLSIM_000141)

# Class: obo:MOLSIM_001554 (periodic boundary conditions)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001554 "A simulation technique in which the box is treated as one cell of an infinite lattice of identical copies, so a particle leaving one side re-enters the opposite side. It removes the surface that a finite box would otherwise have, where molecules would behave unlike those in bulk. The box must be large enough that a molecule does not interact with its own image. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001554 "periodic boundary conditions"@en)
SubClassOf(obo:MOLSIM_001554 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001555 (expanded ensemble simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001555 "An expanded ensemble simulation is an enhanced sampling method where the simulation samples not only the coordinates of the system but also an additional thermodynamic variable, such as temperature or an alchemical coupling parameter. The system can move dynamically between different temperatures or states, which helps it to overcome energy barriers and sample a wider range of conformations. For experts, this method is a powerful framework that generalizes techniques like replica-exchange and lambda-dynamics for calculating free energies."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001555 "expanded ensemble simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001555 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001555 obo:MOLSIM_000845)

# Class: obo:MOLSIM_001556 (system setup tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001556 "A software program that assembles the parts of a simulation into a system that is ready to run. It places the molecule in a box, fills the box with solvent, adds ions to reach the intended charge and concentration, and writes the topology and coordinate files. It is the step at which a structure becomes a simulatable system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001556 "system setup tool"@en)
SubClassOf(obo:MOLSIM_001556 obo:MOLSIM_001850)

# Class: obo:MOLSIM_001557 (AddToBox)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001557 "A system preparation program that inserts a stated number of molecules, such as solvent or ions, into a simulation box that already contains other molecules. It places them without creating overlaps. It is used at the end of system preparation to reach a target composition or density. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001557 "AddToBox"@en)
SubClassOf(obo:MOLSIM_001557 obo:MOLSIM_001956)

# Class: obo:MOLSIM_001558 (electrostatics analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001558 "An electrostatics analysis tool is a type of software designed to calculate and visualize the electrostatic properties of a molecule. These tools typically take a molecular structure with assigned atomic charges and compute quantities like the electrostatic potential on the molecule's surface or the total electrostatic energy of solvation. They are essential for understanding how a molecule will interact with other charged molecules and its polar solvent environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001558 "electrostatics analysis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001558 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001558 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001559 (adaptive Poisson-Boltzmann solver)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001559 "A numerical solver that computes the electrostatic potential around a molecule in solvent by solving the Poisson-Boltzmann equation on a grid that is refined where the potential changes fastest. Refining only where needed gives the accuracy of a fine grid at much lower cost. It is the usual way continuum electrostatics is computed for a large biomolecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001559 "adaptive Poisson-Boltzmann solver"@en)
SubClassOf(obo:MOLSIM_001559 obo:MOLSIM_001558)

# Class: obo:MOLSIM_001560 (mbondi3)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001560 "A set of van der Waals radii in the modified-Bondi series, with further adjustments to the radii of specific atoms including carboxylate oxygens and the hydrogens bonded to nitrogen. It was fitted for use with a particular generalized Born model and improves salt-bridge and nucleic acid behaviour. It is the third revision in that series. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001560 "mbondi3"@en)
SubClassOf(obo:MOLSIM_001560 obo:MOLSIM_000272)

# Class: obo:MOLSIM_001561 (cphstats)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001561 "An analysis program that processes the output of a constant pH molecular dynamics run and reports pKa values and titration curves for the titratable residues. It reads the record of protonation state changes rather than the trajectory. It is what turns a constant pH simulation into a number that can be compared with experiment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001561 "cphstats"@en)
SubClassOf(obo:MOLSIM_001561 obo:MOLSIM_001962)

# Class: obo:MOLSIM_001562 (application programming interface)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001562 "A defined set of functions and rules through which one piece of software uses another. It fixes what can be asked for and what comes back, so the 2 sides can change independently as long as the agreement holds. It is how a simulation engine is driven from a script rather than from a command line. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001562 "application programming interface"@en)
SubClassOf(obo:MOLSIM_001562 obo:MOLSIM_000170)

# Class: obo:MOLSIM_001563 (CUDA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001563 "A programming platform and interface for running general computation on NVIDIA graphics processors. A graphics processor performs thousands of simple operations at once, which suits computing forces on many atoms simultaneously. Most simulation engines run several times faster through it than on processors alone, at the cost of working only on one manufacturer's hardware. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001563 "CUDA"@en)
SubClassOf(obo:MOLSIM_001563 obo:MOLSIM_001562)

# Class: obo:MOLSIM_001564 (free energy analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001564 "A software program that computes free energy differences from the data produced by enhanced sampling simulations. It implements estimators such as the weighted histogram analysis method or the multi-state Bennett acceptance ratio, which combine data across simulation windows. It is the last step of a free energy workflow, turning many biased runs into 1 number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001564 "free energy analysis tool"@en)
SubClassOf(obo:MOLSIM_001564 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001565 (edgembar)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001565 "An analysis program that computes free energy differences across the edges of an alchemical network using the multi-state Bennett acceptance ratio estimator. Treating the calculation as a network lets inconsistencies around closed cycles be detected and corrected. It is built for campaigns of many ligands rather than single pairs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001565 "edgembar"@en)
SubClassOf(obo:MOLSIM_001565 obo:MOLSIM_001968)

# Class: obo:MOLSIM_001566 (library)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001566 "A software library is a collection of pre-written code and subroutines that provide specific functionalities to be used by other programs. Libraries are not executed directly by end-users but are imported or linked by developers to perform specialized tasks, such as mathematical computations or file parsing."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001566 "library"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001566 "software library"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001566 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001566 obo:MOLSIM_000170)

# Class: obo:MOLSIM_001567 (FFTW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001567 "A software library for computing discrete Fourier transforms, which convert data between a description in space or time and one in frequency. Particle mesh Ewald performs one at every step, so its speed sets a large part of a simulation's cost. The library measures the machine it is running on and chooses its method accordingly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001567 "FFTW"@en)
SubClassOf(obo:MOLSIM_001567 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001568 (mdgx)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001568 "A simulation engine, distributed with AmberTools, used for force field parameter fitting, free energy calculations and testing new algorithms as well as for ordinary molecular dynamics. It exposes parts of the calculation that the production engines keep fixed. It is a development and method-testing tool rather than a production engine. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001568 "mdgx"@en)
SubClassOf(obo:MOLSIM_001568 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001569 (utility script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001569 "A small script that performs one well-defined supporting task inside a larger workflow, such as converting between file formats or pulling one value out of an output file. It does no science itself; it makes the pieces that do fit together. A published workflow usually depends on several, which is why they are recorded here. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001569 "utility script"@en)
SubClassOf(obo:MOLSIM_001569 obo:MOLSIM_001802)

# Class: obo:MOLSIM_001570 (metalpdb2mol2.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001570 "A utility script that converts a structure file containing a metal ion into a format carrying explicit bonds and charges. A structure file records positions and leaves bonding implicit, which is not enough to build a metal site. It is the first step of parameterising a metal centre. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001570 "metalpdb2mol2.py"@en)
SubClassOf(obo:MOLSIM_001570 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001571 (Onufriev-Bashford-Case radii set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001571 "A set of atomic radii fitted for use with the generalized Born model of the same authors. Radii and generalized Born model are fitted together, so using 1 with a different model degrades both. It is the default radii set for that model in AMBER. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001571 "Onufriev-Bashford-Case radii set"@en)
SubClassOf(obo:MOLSIM_001571 obo:MOLSIM_000272)

# Class: obo:MOLSIM_001572 (ndfes)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001572 "The ndfes software, included in the FE-ToolKit package, is used to analyze biased umbrella sampling to estimate free energy surfaces in an arbitrary number of reaction coordinate dimensions using either the variational free energy profile (vFEP), multistate Bennett acceptance ratio method (MBAR), or the highly-related weighted thermodynamic perturbation and generalized weighted thermodynamic perturbation methods."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001572 "ndfes"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001572 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001572 obo:MOLSIM_001969)

# Class: obo:MOLSIM_001573 (ParmEd)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001573 "ParmEd is a software package and Python library designed for manipulating and converting molecular topology and parameter files from various simulation packages, with a primary focus on the AMBER force field format. It allows users to programmatically modify force field parameters, change molecular connectivity, and convert between different file formats."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001573 "ParmEd"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001573 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001573 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001574 (pdb4amber)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001574 "A system preparation program that cleans a Protein Data Bank structure file so the AMBER tools can read it. It renumbers residues, corrects atom naming, and reports problems such as missing atoms, alternate locations and unusual residues. It is run before force field parameters are assigned, because those steps fail on an unprepared file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001574 "pdb4amber"@en)
SubClassOf(obo:MOLSIM_001574 obo:MOLSIM_001957)

# Class: obo:MOLSIM_001575 (PropPDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001575 "A system setup program that builds a larger box by repeating a small crystallographic unit cell along chosen directions. It is needed when the original cell is smaller than the distance at which interactions are cut off, which would let a molecule interact with its own image. Repeating the cell makes the box big enough for that not to happen. (UNVERIFIED)"@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_001575 <https://ambermd.org/doc12/Amber25.pdf>)
AnnotationAssertion(rdfs:label obo:MOLSIM_001575 "PropPDB"@en)
SubClassOf(obo:MOLSIM_001575 obo:MOLSIM_001955)

# Class: obo:MOLSIM_001576 (ProScrs.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001576 "A utility script in AmberTools that scores protein structures or docked poses using a choice of scoring functions. It ranks candidate structures rather than producing one. It is used to sift the output of a docking run before any of it is simulated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001576 "ProScrs.py"@en)
SubClassOf(obo:MOLSIM_001576 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001577 (py_resp.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001577 "A utility script that fits atomic charges to a computed electrostatic potential, with a restraint pulling charges on buried atoms towards zero. The restraint exists because the potential outside a molecule barely constrains its interior, so an unrestrained fit gives buried charges that are large and arbitrary. It is the Python implementation of that fitting procedure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001577 "py_resp.py"@en)
SubClassOf(obo:MOLSIM_001577 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001578 (pyresp_gen.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001578 "A utility script that writes the input file for the charge fitting program, recording which charges are constrained to be equal and how strongly buried atoms are restrained. Setting those constraints by hand is the part of the procedure most easily got wrong. It performs no fitting itself. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001578 "pyresp_gen.py"@en)
SubClassOf(obo:MOLSIM_001578 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001579 (pytraj)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001579 "Pytraj is a Python library that provides a programmable interface to the powerful trajectory analysis capabilities of the cpptraj engine from the AmberTools suite. It allows users to write Python scripts to perform a wide range of analyses, such as calculating RMSD, distances, and hydrogen bonds, directly on simulation trajectories. Pytraj enables the creation of complex, automated, and reproducible analysis workflows that integrate seamlessly with other Python data science tools."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001579 "pytraj"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001579 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001579 obo:MOLSIM_000251)
SubClassOf(obo:MOLSIM_001579 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001580 (SQM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001580 "A quantum chemistry program in AmberTools that performs semi-empirical calculations, used both on its own and as the quantum part of a hybrid simulation. It implements the NDDO-based methods and the tight binding ones. It is the engine the AmberTools charge assignment tools call. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001580 "SQM"@en)
SubClassOf(obo:MOLSIM_001580 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001581 (TeraChem)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001581 "A quantum chemistry engine written from the outset to run on graphics processors rather than adapted to them. Being designed for that hardware rather than ported to it gives it a substantial speed advantage on the calculations it supports. It supports fewer methods than a general-purpose package in exchange. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001581 "TeraChem"@en)
SubClassOf(obo:MOLSIM_001581 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001582 (torch PBSA runtime)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001582 "A software library that performs Poisson-Boltzmann surface area calculations using the PyTorch framework. Running the calculation that way gives it graphics processor acceleration and automatic derivatives without either being written by hand. The derivatives are what let the solvation term contribute forces during a simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001582 "torch PBSA runtime"@en)
SubClassOf(obo:MOLSIM_001582 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001583 (UnitCell)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001583 "A system setup program that rebuilds a complete crystallographic repeating unit from a structure file by applying the symmetry operations recorded in it. A deposited file usually contains only the smallest unique part, leaving the rest to be generated. The program performs that generation so the full contents of the cell can be simulated. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001583 "UnitCell"@en)
SubClassOf(obo:MOLSIM_001583 obo:MOLSIM_001955)

# Class: obo:MOLSIM_001584 (xleap)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001584 "A graphical system preparation program that builds a molecular system for AMBER interactively: loading a structure, applying a force field, adding solvent and ions, and writing the topology and coordinate files. It is the graphical front end to the same engine the command-line tool uses. The 2 produce identical output from identical commands. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001584 "xleap"@en)
SubClassOf(obo:MOLSIM_001584 obo:MOLSIM_000259)

# Class: obo:MOLSIM_001585 (build system tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001585 "A program that turns source code into a working executable, working out what must be compiled and in what order. It also finds the libraries the program depends on and links them in. Which options it was given affects how fast the resulting program runs, and sometimes what it can do. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001585 "build system tool"@en)
SubClassOf(obo:MOLSIM_001585 obo:MOLSIM_000171)

# Class: obo:MOLSIM_001586 (CMake)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001586 "A build system tool that reads a single description of how a program is assembled and generates the build files each platform's compiler expects. It lets one set of instructions serve Linux, macOS and Windows. Most simulation software is built with it, so which version was used is part of reproducing an installation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001586 "CMake"@en)
SubClassOf(obo:MOLSIM_001586 obo:MOLSIM_001585)

# Class: obo:MOLSIM_001587 (Intel Math Kernel Library)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001587 "The Intel oneAPI Math Kernel Library (oneMKL) is a collection of highly optimized mathematical functions for science, engineering, and financial applications, specifically tuned for Intel processors. It provides high-performance implementations of routines for linear algebra (BLAS, LAPACK, ScaLAPACK), Fast Fourier Transforms (FFT), and other core mathematical operations. For biomolecular simulation software, linking against oneMKL can significantly boost performance by accelerating the fundamental mathematical computations underlying the simulation algorithms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001587 "Intel oneAPI Math Kernel Library"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001587 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001587 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001588 (package manager)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001588 "A package manager is a tool that automates the process of installing, upgrading, configuring, and removing software packages and their dependencies. It simplifies the management of the complex web of software required for scientific computing by handling the details of where to find packages and which versions are compatible. For simulation scientists, package managers like Conda are crucial for creating stable and reproducible software environments."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001588 "package manager"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001588 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001588 obo:MOLSIM_000171)

# Class: obo:MOLSIM_001589 (Miniconda)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001589 "Miniconda is a minimal, bootstrap installer for the Conda package manager, which is widely used in the scientific computing community. It includes only the Conda package manager and Python, allowing users to create customized software environments by installing only the packages they need. For researchers, Miniconda provides a lightweight way to set up isolated and reproducible environments for their simulation and analysis software."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001589 "Miniconda"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001589 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001589 obo:MOLSIM_001588)

# Class: obo:MOLSIM_001590 (update_amber)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001590 "A utility script distributed with AmberTools that fetches and applies official updates and fixes to an existing installation. It contacts the update server, downloads what applies to the installed version, and patches the source. Which updates have been applied is part of what identifies the version a result came from. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001590 "update_amber"@en)
SubClassOf(obo:MOLSIM_001590 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001591 (rism1d)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001591 "An analysis program that solves the 1-dimensional RISM equations for a pure solvent, giving its structural and thermodynamic properties. Its output describes the bulk liquid with no solute present. It must be run before any 3-dimensional RISM calculation, which takes those results as input. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001591 "rism1d"@en)
SubClassOf(obo:MOLSIM_001591 obo:MOLSIM_001963)

# Class: obo:MOLSIM_001592 (QUICK)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001592 "A quantum chemistry engine for density functional theory written to run on graphics processors. Its integral evaluation is the part moved onto that hardware, which is where most of the time in such a calculation goes. It is used as the quantum part of hybrid simulations, where the same calculation must be repeated at every step. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001592 "QUICK"@en)
SubClassOf(obo:MOLSIM_001592 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001593 (MRCC)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001593 "A quantum chemistry program for very high accuracy electronic structure calculations, implementing coupled cluster methods to arbitrary excitation level and their multi-reference forms. Those methods are the benchmark other methods are measured against. Its cost restricts it to small systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001593 "MRCC"@en)
SubClassOf(obo:MOLSIM_001593 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001594 (Fireball)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001594 "A quantum chemistry engine that performs density functional calculations using orbitals confined to a fixed radius around each atom, with the resulting integrals tabulated in advance. Confining the orbitals is what makes the tabulation possible and the calculation fast. It is used for large systems where full density functional theory would be too slow. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001594 "Fireball"@en)
SubClassOf(obo:MOLSIM_001594 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001595 (DFTB+)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001595 "A quantum chemistry engine implementing density functional tight binding, an approximation that replaces most of the electronic integrals with values tabulated in advance. It is 2 to 3 orders of magnitude faster than full density functional theory while remaining quantum mechanical. Its accuracy depends on parameters fitted for each pair of elements, so it works only for element combinations that have been parameterised. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001595 "DFTB+"@en)
SubClassOf(obo:MOLSIM_001595 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001596 (xTB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001596 "A quantum chemistry program implementing the extended tight binding family of semi-empirical methods. It is fast enough to optimise geometries and search conformations for molecules of a few hundred atoms in seconds. It is widely used as a preliminary step before a more expensive calculation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001596 "xTB"@en)
SubClassOf(obo:MOLSIM_001596 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001597 (PUPIL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001597 "A software framework that connects separate simulation programs so that each can compute the part of a system it is best suited to. It passes coordinates, energies and forces between them and keeps them in step. It is what allows a quantum chemistry program and a molecular dynamics program to run 1 simulation together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001597 "PUPIL"@en)
SubClassOf(obo:MOLSIM_001597 obo:MOLSIM_000157)

# Class: obo:MOLSIM_001598 (TCPB-cpp)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001598 "A software library that lets a classical simulation program request energies and forces from the TeraChem quantum chemistry program over a network connection. The 2 programs run separately and exchange data at each step. It is what allows a quantum and a classical engine to run one hybrid simulation together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001598 "TCPB-cpp"@en)
SubClassOf(obo:MOLSIM_001598 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001599 (PuReMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001599 "A simulation engine built to run reactive force field simulations, where bonding is recomputed at every step rather than fixed. Recomputing the bond network is what makes such a simulation expensive, and the engine is written around doing it in parallel. It is used for reactions in materials and at surfaces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001599 "PuReMD"@en)
SubClassOf(obo:MOLSIM_001599 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001600 (reduce)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001600 "A structure preparation program that adds hydrogen atoms to a macromolecular structure and chooses their positions. It also decides how to orient groups whose 2 possible arrangements X-ray data cannot distinguish, such as the ends of asparagine and glutamine side chains. Crystallography rarely sees hydrogens, so a structure file usually arrives without them and a simulation cannot start until they are there. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001600 "reduce"@en)
SubClassOf(obo:MOLSIM_001600 obo:MOLSIM_000223)

# Class: obo:MOLSIM_001601 (gwh)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001601 "A system setup utility that places the hydrogen atoms of water molecules taken from an experimental structure. Crystallography sees the oxygen of an ordered water and not its hydrogens, so their orientation must be worked out. It chooses orientations that make sensible hydrogen bonds with the surroundings. (UNVERIFIED)"@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_001601 <https://ambermd.org/doc12/Amber25.pdf>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001601 "guess water hydrogens"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001601 "gwh"@en)
SubClassOf(obo:MOLSIM_001601 obo:MOLSIM_001957)

# Class: obo:MOLSIM_001602 (pdbremix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001602 "Pdbremix is a utility designed for advanced manipulation and modification of Protein Data Bank (PDB) files. It allows users to perform a wide range of tasks such as renumbering residues, changing atom or residue names, and translating or rotating parts of a molecule. Experts use this tool for complex system-building tasks that require precise, custom modifications to a standard PDB file before simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001602 "pdbremix"@en)
SubClassOf(obo:MOLSIM_001602 obo:MOLSIM_001957)

# Class: obo:MOLSIM_001603 (Packmol)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001603 "A system preparation program that builds an initial arrangement of molecules inside a defined region by packing them to satisfy stated counts and spatial constraints while keeping them from overlapping. It solves a constrained optimisation rather than placing molecules at random. It is how a mixed or layered starting system is built when a regular lattice will not do. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001603 "Packmol"@en)
SubClassOf(obo:MOLSIM_001603 obo:MOLSIM_001956)

# Class: obo:MOLSIM_001604 (AMBAT)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001604 "AMBAT is a software tool used to construct three-dimensional models of cell membranes for use in AMBER molecular simulations. Consisting of a set of scripts, it automates the complex process of arranging lipid molecules to form a proper bilayer and can then embed a protein structure within that prepared membrane. As part of the AmberTools suite, AMBAT (Amber Membrane Builder and Analysis Tool) provides a script-based workflow for both the initial construction of lipid bilayer systems and for subsequent analysis of membrane properties, serving as a specialized tool for preparing membrane protein simulations."@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_001604 <https://ambermd.org/doc12/Amber25.pdf>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001604 "Amber Membrane Builder and Analysis Tool"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001604 "AMBAT"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001604 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001604 obo:MOLSIM_000225)

# Class: obo:MOLSIM_001605 (parameter fitting tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001605 "A software program that derives force field parameters by adjusting them until the force field reproduces reference data, usually quantum calculations. It is used when no existing parameter covers a molecule and assignment by analogy is not good enough. Its output is a parameter set, not a prepared system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001605 "parameter fitting tool"@en)
SubClassOf(obo:MOLSIM_001605 obo:MOLSIM_000172)

# Class: obo:MOLSIM_001606 (Parmscan)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001606 "A utility program that searches automatically for force field parameters giving the best agreement with reference data, by trying many combinations rather than fitting one term at a time. Searching the whole space at once can find a combination that fitting terms separately misses. It is used for parameter development rather than for preparing a single system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001606 "described in https://doi.org/10.1002/jcc.1079")
AnnotationAssertion(rdfs:label obo:MOLSIM_001606 "Parmscan"@en)
SubClassOf(obo:MOLSIM_001606 obo:MOLSIM_001605)

# Class: obo:MOLSIM_001607 (parmchk2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001607 "A utility program in AmberTools that checks whether every parameter a molecule needs is present in the chosen force field, and writes an additional parameter file supplying the missing ones by analogy. Missing parameters otherwise stop system preparation with an error. Parameters it supplies by analogy are guesses and are flagged as such in its output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001607 "parmchk2"@en)
SubClassOf(obo:MOLSIM_001607 obo:MOLSIM_001970)

# Class: obo:MOLSIM_001608 (parmcal)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001608 "An interactive utility included in the AmberTools software package for deriving force field parameters. It assists users in calculating new parameters for bond lengths and angles based on a set of built-in empirical rules. This tool is particularly useful when parameterizing a new molecule for which no existing force field parameters are available. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001608 "parmcal"@en)
SubClassOf(obo:MOLSIM_001608 obo:MOLSIM_001970)

# Class: obo:MOLSIM_001609 (paramfit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001609 "A utility program in AmberTools that fits rotation parameters by adjusting them until the force field reproduces energies computed quantum mechanically along a rotation. Rotation terms are the ones most often wrong for a new molecule, because they depend on the whole local environment. It is used when the parameters supplied by analogy are not good enough. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001609 "paramfit"@en)
SubClassOf(obo:MOLSIM_001609 obo:MOLSIM_001605)

# Class: obo:MOLSIM_001610 (MCPB.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001610 "A utility program in AmberTools that builds force field parameters for a metal centre in a protein, from quantum calculations on the metal and the groups around it. A metal site has no standard parameters, because its geometry and charge depend on which groups coordinate it. It automates a procedure that is otherwise long and easy to get wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001610 "MCPB.py"@en)
SubClassOf(obo:MOLSIM_001610 obo:MOLSIM_001605)

# Class: obo:MOLSIM_001611 (pyMSMT)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001611 "A Python toolkit for parameterising metal sites in biomolecules, providing the components that the metal centre parameter builder is assembled from. It handles the quantum calculations, the charge fitting and the assembly of the resulting parameters. It is a toolkit rather than a single program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001611 "pyMSMT"@en)
SubClassOf(obo:MOLSIM_001611 obo:MOLSIM_001605)

# Class: obo:MOLSIM_001612 (atomtype)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001612 "A utility program in AmberTools that assigns a force field atom type to every atom of a molecule, from its element and its bonding environment. Every parameter a molecule receives follows from those assignments. It is run before parameters are looked up, and its output is worth inspecting for unusual chemistry. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001612 "atomtype"@en)
SubClassOf(obo:MOLSIM_001612 obo:MOLSIM_001970)

# Class: obo:MOLSIM_001613 (am1bcc)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001613 "A utility program in AmberTools that assigns partial charges to an organic molecule by running a fast semi-empirical calculation and then applying tabulated corrections based on each bond's type. The corrections are fitted so the result approximates a far more expensive fitted charge set. It is how charges are produced for a ligand in seconds rather than hours. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001613 "am1bcc"@en)
SubClassOf(obo:MOLSIM_001613 obo:MOLSIM_001971)

# Class: obo:MOLSIM_001614 (bondtype)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001614 "A utility program in AmberTools that works out the bond order of each bond in a molecule, distinguishing single, double and aromatic bonds. Structure files often record coordinates without bond orders, which must then be inferred from geometry. The result determines which parameters the bond receives. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001614 "bondtype"@en)
SubClassOf(obo:MOLSIM_001614 obo:MOLSIM_001970)

# Class: obo:MOLSIM_001615 (respgen)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001615 "A utility program in AmberTools that writes the input files for a restrained fit of atomic charges to a computed electrostatic potential. It sets up which charges are constrained to be equal and how strongly buried atoms are restrained, which is the part that is easy to get wrong by hand. The fit itself is performed by a separate program. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001615 "respgen"@en)
SubClassOf(obo:MOLSIM_001615 obo:MOLSIM_001971)

# Class: obo:MOLSIM_001616 (prepgen)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001616 "A utility program in AmberTools that builds a residue template file for a new molecule from its structure and charges. It works out the connection tree and which atoms serve as the head and tail. It is run once per new building block, and its output is reused thereafter. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001616 "prepgen"@en)
SubClassOf(obo:MOLSIM_001616 obo:MOLSIM_001972)

# Class: obo:MOLSIM_001617 (residuegen)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001617 "A utility program in AmberTools that produces a complete residue template for a new molecule, running charge assignment and atom typing and then building the template. It automates the sequence of steps that the individual tools would otherwise be run through by hand. It is the usual route for adding a modified residue. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001617 "residuegen"@en)
SubClassOf(obo:MOLSIM_001617 obo:MOLSIM_001972)

# Class: obo:MOLSIM_001618 (divcon)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001618 "A quantum chemistry engine that divides a large molecule into overlapping regions, solves each separately, and assembles the result. Doing so makes the cost grow in proportion to the system size rather than far faster, which is what puts whole proteins within reach. The overlap between regions is what keeps the joins from introducing errors. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001618 "divcon"@en)
SubClassOf(obo:MOLSIM_001618 obo:MOLSIM_000161)

# Class: obo:MOLSIM_001619 (acdoctor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001619 "A validation script that inspects a small molecule structure file for the faults that stop force field parameters being assigned, such as wrong atom types, bad connectivity and inconsistent valences. It reports each fault and in some cases corrects it. It is run before antechamber rather than after a failure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001619 "acdoctor"@en)
SubClassOf(obo:MOLSIM_001619 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001620 (IPMach.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001620 "A utility script in AmberTools that helps fit parameters for ion models, by running simulations at trial parameter values and comparing the resulting hydration free energies and ion-water distances against measurements. Ion parameters must be fitted against such properties rather than derived, because no calculation gives them directly. It automates the repeated trials that fitting requires. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001620 "IPMach.py"@en)
SubClassOf(obo:MOLSIM_001620 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001621 (PdbSearcher.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001621 "This is a utility script designed to search for and retrieve specific molecular structure files from the Protein Data Bank (PDB). It allows a user to programmatically find structures based on criteria such as the PDB ID, the name of the molecule, or the experimental method used. This automates the process of gathering the necessary input structures for a large-scale simulation or analysis project. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001621 "PdbSearcher.py"@en)
SubClassOf(obo:MOLSIM_001621 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001622 (genremdinputs.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001622 "A system preparation script that writes 1 input file per replica for a replica exchange molecular dynamics run, from a template and a list of temperatures. A replica exchange run needs as many input files as it has replicas, which is too many to write by hand. It is what makes the number of replicas a parameter rather than a chore. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001622 "genremdinputs.py"@en)
SubClassOf(obo:MOLSIM_001622 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001623 (nfe-umbrella-slice)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001623 "The nfe-umbrella-slice script is a utility used in the analysis of umbrella sampling simulations, likely as part of a larger free energy calculation workflow. Its purpose is to extract a specific portion or \"slice\" of the simulation data from the collective output of all umbrella windows. Experts use this for tasks such as assessing the convergence of the free energy profile by analyzing how it changes as more data is included."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001623 "nfe-umbrella-slice"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001623 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001623 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001624 (cpinutil.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001624 "A system preparation script, part of AmberTools, that writes the input file a constant pH molecular dynamics run needs. It records which residues may change protonation state and the parameters the titration algorithm uses. Without it the simulation has no list of titratable sites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001624 "cpinutil.py"@en)
SubClassOf(obo:MOLSIM_001624 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001625 (ceinutil.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001625 "The ceinutil.py script is a utility used to prepare the input files for constant redox-potential MD simulations in AMBER. It allows the user to specify which residues can change their redox state and defines the parameters for the simulation. This script is essential for setting up simulations that model the behavior of molecules in a specific electrochemical environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001625 "ceinutil.py"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001625 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001625 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001626 (cpeinutil.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001626 "A system preparation script that writes the input file for a simulation holding both pH and redox potential constant. It records which residues may change protonation state and which may change oxidation state. It is the constant pH preparation script extended to redox-active sites. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001626 "cpeinutil.py"@en)
SubClassOf(obo:MOLSIM_001626 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001627 (cyanarest_to_amberRST)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001627 "The cyana_rest_to_amberRST script iscript converts CYANA .upl upper distance limit files into AMBER .RST format, allowing for the inclusion of restraints in molecular dynamics simulations. This conversion tool is commonly used to prepare input data for AMBER's sander or pmemd applications."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001627 "cyana_rest_to_amberRST"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001627 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001627 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001628 (makeDIP_RST)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001628 "This script is a utility for creating a restraint file (RST) for a simulation that uses direct dipolar coupling (DIP) data from NMR experiments. It likely reads experimental dipolar coupling values and generates the corresponding energy restraint terms in a format that can be read by a simulation program like AMBER. This automates the process of incorporating this specific type of experimental data into a simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001628 "makeDIP_RST"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001628 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001628 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001629 (placeAV.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001629 "placeAV.py is a utility script used to convert the predicted solvent binding sites from a Placevent analysis into explicit atomic coordinates. It reads the centers of high-density solvent regions determined by the analysis and places dummy atoms or water molecules at those specific locations within a structure file. This tool allows researchers to visualize potential hydration sites or use them as defined starting positions for explicit solvent molecules in subsequent simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001629 "placeAV.py"@en)
SubClassOf(obo:MOLSIM_001629 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001630 (FRETrest.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001630 "The FRETrest.py script is a utility used to generate distance restraints for a molecular dynamics simulation based on experimental data from Förster Resonance Energy Transfer (FRET) experiments. It translates the efficiency of energy transfer between two fluorescent labels into a distance distribution that can be used to bias the simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001630 "FRETrest.py"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001630 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001630 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001631 (ambpdb)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001631 "The ambpdb utility is a command-line tool in the AmberTools suite that converts AMBER's native topology (.prmtop) and coordinate (.inpcrd or .rst7) files into the standard Protein Data Bank (PDB) format."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001631 "ambpdb"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001631 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001631 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001632 (ante-MMPBSA.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001632 "A system preparation script that derives the separate receptor and ligand topology files needed for an end-point binding free energy calculation by stripping atoms from the topology of the complex. Deriving them this way guarantees the 3 topologies are consistent. Building them independently is the common source of mismatched-topology errors. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001632 "ante-MMPBSA.py"@en)
SubClassOf(obo:MOLSIM_001632 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001633 (extract_WAMMenergies.pl)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001633 "A Perl script used as part of the FEW (Free Energy Workflow) software to post-process simulation data. Its primary function is to parse output files and calculate a summary of effective binding energies from a free energy calculation. This script automates the data extraction step, making the analysis of complex binding energy simulations more efficient. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001633 "extract_WAMMenergies.pl"@en)
SubClassOf(obo:MOLSIM_001633 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001634 (extract_LIEenergies.pl)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001634 "The extract_LIEenergies.pl script is a utility designed to parse simulation output files and extract the specific energy components required for a Linear Interaction Energy (LIE) calculation. It typically reads the log files to find the average van der Waals and electrostatic interaction energies of a ligand with its environment. For researchers using the LIE method, this script automates the data extraction step needed to calculate the binding free energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001634 "extract_LIEenergies.pl"@en)
SubClassOf(obo:MOLSIM_001634 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001635 (identify_transformations.pl)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001635 "This script is a utility used in the setup of alchemical free energy calculations to automatically identify the atoms that change between two different ligand structures. It likely compares two molecule files and generates a list of the atoms that are unique to each, which is necessary for defining the alchemical transformation. This automates a key and often error-prone step in preparing relative binding free energy calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001635 "identify_transformations.pl"@en)
SubClassOf(obo:MOLSIM_001635 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001636 (bar_pbsa.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001636 "The bar_pbsa.py script is a utility that likely combines results from Bennett Acceptance Ratio (BAR) free energy calculations with endpoint MM/PBSA calculations. This hybrid approach may be used to refine free energy estimates or to decompose a rigorously calculated free energy into physically intuitive components. For experts in free energy methods, this script represents a tool for advanced, multi-step analysis workflows. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001636 "bar_pbsa.py"@en)
SubClassOf(obo:MOLSIM_001636 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001637 (edgembar-amber2dats.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001637 "A utility script that converts output files from AMBER simulations into the specific data format required by the edgembar free energy analysis program. It processes AMBER's energy or log files to extract the necessary potential energy values for each frame of the simulation. This script is an essential data preparation step for using the edgembar tool to analyze free energy calculations that were performed with the AMBER software. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001637 "edgembar-amber2dats.py"@en)
SubClassOf(obo:MOLSIM_001637 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001638 (edgembar-WriteGraphHtml.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001638 "A utility script from the edgembar software package that visualizes the results of a large-scale free energy calculation. It takes the calculated free energy differences between many different molecules and generates an interactive HTML file that displays the results as a network graph. This allows researchers to easily explore the relationships and predicted binding affinities for a whole series of compounds in a web browser. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001638 "edgembar-WriteGraphHtml.py"@en)
SubClassOf(obo:MOLSIM_001638 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001639 (edgembar-bookend2dats.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001639 "This is a utility script from the edgembar software package used to process the output from a specific type of free energy calculation. It likely extracts the necessary energy data from simulations of the \"bookend\" or reference states in a large alchemical network. This data preparation is a required step before the main edgembar program can combine all the results to calculate the final relative free energies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001639 "edgembar-bookend2dats.py"@en)
SubClassOf(obo:MOLSIM_001639 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001640 (fetkutils-tischedule.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001640 "A utility script that generates the list of coupling parameter values a thermodynamic integration calculation will simulate, choosing their number and spacing. Even spacing is wasteful, because the integrand changes much faster near the end points than in the middle. It produces the schedule before the simulations are run rather than adjusting it during them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001640 "fetkutils-tischedule.py"@en)
SubClassOf(obo:MOLSIM_001640 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001641 (ndfes-PrepareAmberData.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001641 "This script is a utility designed to convert simulation output files from the AMBER software package into a format that can be used by the ndfes free energy analysis toolkit. It reads AMBER trajectory and output files and extracts the necessary data, such as the values of collective variables over time. This is an essential interoperability step for analyzing AMBER simulations with the ndfes suite of tools. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001641 "ndfes-PrepareAmberData.py"@en)
SubClassOf(obo:MOLSIM_001641 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001642 (ndfes-CheckEquil.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001642 "This script is a utility used to check if a simulation has reached a stable equilibrium. It analyzes a time-series of a specific property, such as a collective variable, from a simulation output file to determine if its average value has stopped fluctuating systematically. This is a crucial step in free energy calculations to ensure that the data used for analysis is from a well-equilibrated system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001642 "ndfes-CheckEquil.py"@en)
SubClassOf(obo:MOLSIM_001642 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001643 (ndfes-CombineMetafiles.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001643 "This script is a utility for combining multiple metadata files generated during a free energy calculation, particularly from metadynamics simulations. It merges the information about the biasing potential that was added at different times or from different parallel runs into a single, unified file. This is a necessary data processing step before the final free energy surface can be reconstructed from the combined simulation data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001643 "ndfes-CombineMetafiles.py"@en)
SubClassOf(obo:MOLSIM_001643 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001644 (ndfes-PrintFES.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001644 "This script is a utility that takes the final, processed data from a free energy calculation and writes it out as a human-readable file representing the free energy surface (FES). The output is typically a data grid where each point has a coordinate and a corresponding free energy value. This file is the final result of the calculation and is used directly for plotting and visualizing the energetic landscape of the molecular process. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001644 "ndfes-PrintFES.py"@en)
SubClassOf(obo:MOLSIM_001644 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001645 (ndfes-AvgFESs.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001645 "This script is a utility from a specific software package (ndfes) used to average multiple free energy surfaces (FESs). It likely takes several free energy profiles, for example from replicate simulations, and calculates their average and standard deviation. This is a standard final step in free energy analysis to obtain a statistically robust result and estimate its uncertainty. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001645 "ndfes-AvgFESs.py"@en)
SubClassOf(obo:MOLSIM_001645 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001646 (ndfes-path)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001646 "This is a computational tool used to find the most likely transition pathway between two stable molecular shapes on a free energy surface. It takes a pre-calculated free energy landscape and uses an algorithm to identify the minimum free energy path connecting two specified states. This analysis is used to understand the mechanism and sequence of events during a conformational change or a chemical reaction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001646 "ndfes-path"@en)
SubClassOf(obo:MOLSIM_001646 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001647 (ndfes-path-prepguess.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001647 "This script is a utility used to create a plausible starting guess for the transition pathway between two molecular conformations. It typically generates a series of intermediate structures by linearly interpolating between the known start and end states. This initial guess provides a starting point for more sophisticated path-finding algorithms that then refine the path to find the minimum free energy route. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001647 "ndfes-path-prepguess.py"@en)
SubClassOf(obo:MOLSIM_001647 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001648 (ndfes-path-analyzesims.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001648 "This script is a utility for analyzing the set of simulations that were run to determine a transition pathway. It processes the trajectories from simulations performed along a path to refine its position or to calculate properties, such as the average force, along that path. This analysis is a key part of iterative path-finding methods that use simulation data to converge on the minimum free energy path. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001648 "ndfes-path-analyzesims.py"@en)
SubClassOf(obo:MOLSIM_001648 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001649 (finddgref.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001649 "A utility script that selects a reference free energy value from a set of calculations, so that every result in the set can be quoted relative to the same zero point. A relative free energy calculation gives differences, not absolute values, so a common reference has to be chosen before results can be compared. It reads the calculation outputs and reports which value it chose. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001649 "finddgref.py"@en)
SubClassOf(obo:MOLSIM_001649 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001650 (espgen.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001650 "A utility script that extracts the electrostatic potential and the points it was computed at from quantum chemistry output, and writes them in the form a charge fitting program expects. It is a format conversion between 2 steps of charge derivation. It performs no fitting itself. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001650 "espgen.py"@en)
SubClassOf(obo:MOLSIM_001650 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001651 (pype-resp.py)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001651 "A utility script that runs the whole charge derivation procedure end to end: the quantum calculation, the extraction of the potential, the construction of the fitting input and the fit itself. Doing it in one step removes the several file conversions the separate tools require. Those conversions are where the procedure is usually got wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001651 "pype-resp.py"@en)
SubClassOf(obo:MOLSIM_001651 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001652 (chamber)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001652 "The chamber script is a utility within the AmberTools suite that facilitates the conversion of CHARMM-formatted force field files into a format that can be used by AMBER. It processes CHARMM topology (PSF) and parameter (PAR) files, allowing users to run simulations with CHARMM force fields using the AMBER simulation engines."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001652 "chamber"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001652 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001652 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001653 (match_atomname)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001653 "match_atomname is a utility program within the AmberTools suite that takes an input file and a reference file in pdb, ac, prepi, prepc and mol2 format and it automatically detects the corresponding atom name in the reference for each atom name in the input. An output file in the same format as that of the input is generated using the matched atom names. Designed to recover atom-name information lost after running Gaussian calculations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001653 "match_atomname"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001653 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001653 obo:MOLSIM_001569)

# Class: obo:MOLSIM_001654 (MPI library)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001654 "A software library implementing the message passing standard, providing the functions a parallel program calls to send and receive data between machines. The standard says what the functions do; a library is a working version of them. Which one is installed affects performance but not results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001654 "MPI library"@en)
SubClassOf(obo:MOLSIM_001654 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001655 (MVAPICH2-GDR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001655 "An implementation of the message passing standard that moves data directly between graphics processors on different machines, without routing it through their central processors. Avoiding that detour removes a large part of the delay in a simulation running across several machines with accelerators. It requires network hardware that supports direct access. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001655 "MVAPICH2-GDR"@en)
SubClassOf(obo:MOLSIM_001655 obo:MOLSIM_001654)

# Class: obo:MOLSIM_001656 (ARPACK)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001656 "A software library for finding a few eigenvalues and eigenvectors of a very large matrix without forming the whole matrix. Normal mode analysis of a large structure needs exactly that, since only the slowest modes are of interest. Computing every mode would be impossible for a system of that size. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001656 "ARPACK"@en)
SubClassOf(obo:MOLSIM_001656 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001657 (calcpka)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001657 "A computational tool used to predict the acidity constant, or pKa, of ionizable groups in a protein or other molecule. It takes a 3D structure as input and uses a model, often based on continuum electrostatics, to calculate how the local chemical environment shifts the pKa of each titratable residue. This is a critical preparation step for any simulation, as it allows for the assignment of the correct protonation states for all residues at a given experimental pH. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001657 "calcpka"@en)
SubClassOf(obo:MOLSIM_001657 obo:MOLSIM_001962)

# Class: obo:MOLSIM_001658 (addles)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001658 "A system preparation program that rewrites a topology file to contain several non-interacting copies of a chosen region of a molecule, as locally enhanced sampling requires. The copies feel the rest of the system but not each other. It is run before the simulation, because the method cannot be switched on afterwards. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001658 "addles"@en)
SubClassOf(obo:MOLSIM_001658 obo:MOLSIM_000259)

# Class: obo:MOLSIM_001659 (programming language)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001659 "A formal system of instructions and syntax rules in which computer programs are written. Which one a tool is written in affects how fast it runs and how easily it can be changed or extended. It is recorded because reproducing a computational result may require the same language version. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001659 "programming language"@en)
SubClassOf(obo:MOLSIM_001659 obo:MOLSIM_000001)

# Class: obo:MOLSIM_001660 (NAB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001660 "NAB, or Nucleic Acid Builder, is a specialized programming language designed specifically for the purpose of constructing and manipulating three-dimensional models of nucleic acids and proteins. For experts, NAB provides a powerful and scriptable way to build complex or non-standard biomolecular structures that would be difficult to create with standard graphical tools. Originally distributed with the AmberTools software suite, it is now only available from an independent GitHub repository."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001660 "NAB"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001660 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001660 obo:MOLSIM_001659)

# Class: obo:MOLSIM_001661 (FE-ToolKit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001661 "The FE-ToolKit is a collection of tools designed to facilitate the setup, execution, and analysis of alchemical free energy simulations and umbrella sampling."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001661 "FE-ToolKit"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001661 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001661 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001662 (saxs_rism)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001662 "An analysis program that computes a theoretical small-angle X-ray scattering profile from a structure together with a solvent distribution from 3D-RISM theory. Including the ordered solvent layer matters because that layer scatters measurably. It differs from the trajectory-based tool in obtaining the solvent from theory rather than from sampling. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001662 "saxs_rism"@en)
SubClassOf(obo:MOLSIM_001662 obo:MOLSIM_001961)

# Class: obo:MOLSIM_001663 (saxs_md)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001663 "An analysis program that computes a theoretical small-angle X-ray scattering profile from a molecular dynamics trajectory, by averaging the scattering of the sampled conformations. Averaging over an ensemble is what makes the result comparable with a measurement on a solution. It uses the trajectory alone, with no explicit solvent model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001663 "saxs_md"@en)
SubClassOf(obo:MOLSIM_001663 obo:MOLSIM_001961)

# Class: obo:MOLSIM_001664 (software suite)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001664 "A collection of separate programs distributed and installed together, sharing file formats and conventions so that the output of one is directly usable by the next. AmberTools and GROMACS are examples. The distinction from a single program matters, because a suite's name is often used loosely for the one program in it that a study actually ran. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001664 "software suite"@en)
SubClassOf(obo:MOLSIM_001664 obo:MOLSIM_000001)

# Class: obo:MOLSIM_001665 (MoFT)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001665 "A software suite for developing, fitting and checking force field parameters. It covers the whole process from quantum calculations through fitting to validation against reference data. It is used to build a parameter set rather than to prepare a single system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001665 "MoFT"@en)
SubClassOf(obo:MOLSIM_001665 obo:MOLSIM_001664)

# Class: obo:MOLSIM_001666 (metatwist)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001666 "Metatwist is an analysis tool for studying the twisting motions of helical molecules, such as DNA, using data from a metadynamics simulation. It is probably designed to analyze a free energy surface calculated as a function of a helical twist collective variable. This would allow a researcher to quantify the energetic cost and identify the pathways associated with the twisting and untwisting of a molecular helix. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001666 "metatwist"@en)
SubClassOf(obo:MOLSIM_001666 obo:MOLSIM_001960)

# Class: obo:MOLSIM_001667 (ptraj)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001667 "A trajectory analysis program, formerly part of the AMBER suite, that read a script of commands and computed properties such as RMSD, distances and angles from a coordinate file. It has been superseded by cpptraj, which is faster and handles more formats. It is retained because older published workflows refer to it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001667 "ptraj"@en)
SubClassOf(obo:MOLSIM_001667 obo:MOLSIM_000251)

# Class: obo:MOLSIM_001668 (placevent analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001668 "An analysis method that converts a continuous solvent density map into a list of discrete water positions, by repeatedly taking the highest remaining peak and removing the density around it. A simulation needs individual water molecules, and a theory-derived map gives only a density. It is the step that turns one into the other. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001668 "placevent analysis"@en)
SubClassOf(obo:MOLSIM_001668 obo:MOLSIM_000328)

# Class: obo:MOLSIM_001669 (PMEMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001669 "A simulation engine, distributed with the commercial AMBER package, optimised for speed on large systems and on graphics processing units. It supports fewer methods than the general-purpose engine but runs the common ones far faster. It is the engine most production molecular dynamics in AMBER is run with. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001669 "PMEMD"@en)
SubClassOf(obo:MOLSIM_001669 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001670 (sander)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001670 "A simulation engine, distributed with AmberTools, that performs energy minimisation, molecular dynamics and some free energy calculations. It is the general-purpose engine of the suite and supports the widest range of methods. It is slower than the optimised engine in the commercial package, which is the trade for that breadth. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001670 "sander"@en)
SubClassOf(obo:MOLSIM_001670 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001671 (web server)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001671 "A software service reached through a web browser that runs a computational tool on the user's behalf and returns the result. Nothing is installed locally, which puts methods within reach of people who could not otherwise run them. The trade is that the input leaves the user's machine and the version that ran it cannot be pinned down later. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001671 "web server"@en)
SubClassOf(obo:MOLSIM_001671 obo:MOLSIM_000001)

# Class: obo:MOLSIM_001672 (GLYCAM-Web)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001672 "GLYCAM-Web is a collection of online tools and web servers that assist researchers in building three-dimensional models of carbohydrates and glycoproteins. It uses the GLYCAM force field to generate realistic structures and provides tools for tasks like predicting the conformation of glycosidic linkages."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001672 "GLYCAM-Web"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001672 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001672 obo:MOLSIM_000714)

# Class: obo:MOLSIM_001673 (Glycoprotein Builder)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001673 "The Glycoprotein Builder is a web-based tool that automates the process of constructing three-dimensional models of glycoproteins. It allows users to start with a protein structure and graphically attach various glycan (sugar chain) structures to specific amino acid residues. For researchers, this tool greatly simplifies the otherwise complex and tedious task of building a complete, simulation-ready model of a glycosylated protein."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001673 "Glycoprotein Builder"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001673 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001673 obo:MOLSIM_001119)

# Class: obo:MOLSIM_001674 (RDKit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001674 "An open-source software library for working with chemical structures, covering reading and writing file formats, computing molecular descriptors, generating 3-dimensional conformations and comparing molecules. It is the foundation most cheminformatics workflows in Python are built on. It handles the chemistry around a simulation rather than the simulation itself. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001674 "RDKit"@en)
SubClassOf(obo:MOLSIM_001674 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001675 (OpenMM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001675 "A software library for running molecular dynamics, designed to be called from a program rather than run as a command. It is built around graphics processors and is among the fastest engines available on them. Being a library rather than an application is what makes it the usual foundation for new methods. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001675 "OpenMM"@en)
SubClassOf(obo:MOLSIM_001675 obo:MOLSIM_000160)
SubClassOf(obo:MOLSIM_001675 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001676 (MPI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001676 "A standard specifying how parts of a parallel program running on separate machines exchange data by sending messages to one another. Because the machines share no memory, every piece of shared information must be sent explicitly. It is how a single simulation is spread across the nodes of a cluster. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001676 "Message Parsing Interface"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001676 "MPI"@en)
SubClassOf(obo:MOLSIM_001676 obo:MOLSIM_001562)

# Class: obo:MOLSIM_001677 (OpenMP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001677 "A programming interface that lets parts of a program run on several processor cores that share the same memory, by marking sections of the code rather than rewriting it. It is how most simulation engines use the cores of a single machine. It does not spread work across separate machines, which needs a different mechanism. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001677 "OpenMP"@en)
SubClassOf(obo:MOLSIM_001677 obo:MOLSIM_001562)

# Class: obo:MOLSIM_001678 (BLAS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001678 "A specification of low-level linear algebra routines, such as multiplying a matrix by a vector or by another matrix. Hardware vendors supply versions tuned for their own processors, so the same program runs at very different speeds depending on which is installed. Almost every numerical library is built on top of it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001678 "BLAS"@en)
SubClassOf(obo:MOLSIM_001678 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001679 (LAPACK)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001679 "A software library providing routines for linear algebra problems such as solving systems of equations, finding eigenvalues and eigenvectors, and least-squares fitting. Normal mode analysis, principal component analysis and many other analyses reduce to calls into it. Its speed determines how large a matrix those analyses can handle. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001679 "LAPACK"@en)
SubClassOf(obo:MOLSIM_001679 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001680 (DL-Find)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001680 "DL-Find is a software library that provides a collection of robust algorithms for geometry optimization tasks. It contains routines for efficiently finding energy minima (stable structures) and first-order saddle points (transition states) on a potential energy surface. This library acts as an optimization engine that can be incorporated into other simulation or quantum chemistry programs to perform complex structural searches and reaction path calculations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001680 "DL-Find"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001680 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001680 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001681 (sff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001681 "A software library that reads force field definition files and makes their parameters available to a program. It handles the file formats the parameters are distributed in, so that each simulation program does not need its own reader. It is a component used inside other software rather than a program a user runs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001681 "sff"@en)
SubClassOf(obo:MOLSIM_001681 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001682 (3DNA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001682 "x3DNA is a comprehensive software package for the analysis, rebuilding, and visualization of three-dimensional nucleic acid structures. It takes a DNA or RNA structure file as input and calculates a wide range of standard helical and base pair parameters that are used to describe the detailed geometry of the helix. It is a cornerstone tool in the field of nucleic acid structural biology for characterizing and comparing experimental or simulated structures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001682 "3DNA"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001682 "x3DNA"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001682 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001682 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001682 obo:MOLSIM_001960)

# Class: obo:MOLSIM_001683 (MBX)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001683 "A simulation engine that computes intermolecular interactions by summing separately fitted contributions from pairs, triples and larger groups of molecules. Building up the interaction this way reaches near quantum accuracy for water and small molecules. Its cost rises steeply with the size of the groups included. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001683 "MBX"@en)
SubClassOf(obo:MOLSIM_001683 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001684 (match analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001684 "A match analysis tool is a program that compares two or more molecular structures or datasets to find and quantify their similarities. This can involve superimposing two protein structures to calculate their RMSD or searching a database of small molecules to find ones that have a similar shape or chemical features to a query compound."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001684 "match analysis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001684 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001684 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001685 (WAMM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001685 "An integration algorithm that advances a simulation using a weighted average of momenta from more than one point in the step. The averaging damps the numerical error that accumulates in a plain scheme. It is intended to permit a longer timestep than the standard integrators allow. (UNVERIFIED)"@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_001685 <https://doi.org/10.1016/j.jcp.2013.06.039>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001685 "Weighted Averaging Momentum Method"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001685 "WAMM"@en)
SubClassOf(obo:MOLSIM_001685 obo:MOLSIM_000157)

# Class: obo:MOLSIM_001686 (LIEW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001686 "A software framework that automates a binding free energy calculation by the linear interaction energy method, running the simulations of the bound and free ligand and combining their averaged interaction energies. It carries out in 1 step what would otherwise be a hand-assembled sequence of runs. The empirical coefficients it applies are what turn the energy differences into a free energy. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001686 "Linear Interaction Energy Workflow"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001686 "LIEW"@en)
SubClassOf(obo:MOLSIM_001686 obo:MOLSIM_000157)

# Class: obo:MOLSIM_001687 (TIW)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001687 "A software framework that automates a relative binding free energy calculation by thermodynamic integration, preparing the system, running the series of coupling states and analysing the result. It removes the bookkeeping of managing many simultaneous runs. It is the thermodynamic integration counterpart to the linear interaction energy workflow. (UNVERIFIED)"@en)
AnnotationAssertion(dcterms:source obo:MOLSIM_001687 <https://doi.org/10.1002/jcc.23218>)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001687 "Thermodynamic Integration Workflow"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001687 "TIW"@en)
SubClassOf(obo:MOLSIM_001687 obo:MOLSIM_000157)

# Class: obo:MOLSIM_001688 (numerical solver algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001688 "A numerical solver is an algorithm that finds approximate solutions to complex mathematical equations that cannot be solved by hand. These algorithms are the computational engines that solve the underlying mathematical problems in many scientific simulations. For experts, this includes iterative algorithms like the conjugate gradient method used to solve the large systems of linear equations that arise in implicit solvent models or quantum mechanical calculations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001688 "numerical solver algorithm"@en)
SubClassOf(obo:MOLSIM_001688 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001689 (biconjugate gradient solver algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001689 "An iterative algorithm for solving a large system of linear equations whose matrix is not symmetric. The ordinary conjugate gradient method requires symmetry and fails without it. It is used for the equations arising in continuum electrostatics, where the matrix is not symmetric. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001689 "biconjugate gradient solver algorithm"@en)
SubClassOf(obo:MOLSIM_001689 obo:MOLSIM_001688)

# Class: obo:MOLSIM_001690 (modified direct inversion in the iterative subspace solver algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001690 "An algorithm that speeds up an iterative calculation by combining several previous iterations into a better next guess, with the combination chosen to make the estimated error smallest. It is the standard way a self-consistent field calculation is brought to convergence. Without it many calculations oscillate indefinitely instead of settling. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001690 "modified direct inversion in the iterative subspace solver algorithm"@en)
SubClassOf(obo:MOLSIM_001690 obo:MOLSIM_001688)

# Class: obo:MOLSIM_001691 (integration algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001691 "An algorithm that advances the positions and velocities of the atoms from one step to the next, using the forces computed at the current step. It approximates the continuous equations of motion by a sequence of small jumps. How well it conserves energy over a long run is the main thing that separates one from another. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001691 "integration algorithm"@en)
SubClassOf(obo:MOLSIM_001691 obo:MOLSIM_000382)

# Class: obo:MOLSIM_001692 (Beeman integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001692 "An integration algorithm that advances positions and velocities using the forces at the current and 2 previous steps. It produces the same trajectory as the Verlet family but computes velocities more accurately at each point. That matters when a quantity depending on velocity, such as kinetic energy, is being reported. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001692 "Beeman integrator"@en)
SubClassOf(obo:MOLSIM_001692 obo:MOLSIM_001691)

# Class: obo:MOLSIM_001693 (modified incomplete Choleski conjugate gradient solver algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001693 "An iterative algorithm for solving a large system of linear equations that first computes a rough approximate factorisation of the matrix and uses it to make the problem easier to solve. The approximation is deliberately incomplete, because an exact one would cost as much as solving the system directly. It converges in far fewer iterations than the unaided method. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001693 "modified incomplete Choleski conjugate gradient solver algorithm"@en)
SubClassOf(obo:MOLSIM_001693 obo:MOLSIM_001688)

# Class: obo:MOLSIM_001694 (numerical integration algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001694 "An algorithm that computes the approximate value of a definite integral from values sampled at discrete points. It is used wherever the function being integrated is known only at the points where it was measured or computed. The free energy of a thermodynamic integration calculation is obtained this way. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001694 "numerical integration algorithm"@en)
SubClassOf(obo:MOLSIM_001694 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001695 (Lebedev quadrature algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001695 "A numerical integration algorithm for integrating a function over the surface of a sphere, using a fixed set of points and weights chosen to be exact for spherical harmonics up to a given order. It reaches a given accuracy with far fewer points than an evenly spaced arrangement. It supplies the angular part of the grid used in density functional theory. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001695 "Lebedev quadrature algorithm"@en)
SubClassOf(obo:MOLSIM_001695 obo:MOLSIM_001694)

# Class: obo:MOLSIM_001696 (analysis algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001696 "An algorithm that computes a property or finds a pattern in raw simulation data. It is the concrete procedure an analysis method is carried out by, as distinct from the idea of the method itself. Two programs implementing the same method can use different algorithms and give slightly different numbers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001696 "analysis algorithm"@en)
SubClassOf(obo:MOLSIM_001696 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001697 (signal processing algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001697 "An analysis algorithm that examines or transforms data recorded as a sequence in time. A trajectory is such a sequence, so techniques built for signals apply to it directly. Smoothing, filtering and decomposing a series into its frequencies all belong here. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001697 "signal processing algorithm"@en)
SubClassOf(obo:MOLSIM_001697 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001698 (butterworth filter algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001698 "A signal processing algorithm that removes frequencies above or below a chosen point while leaving the remaining ones as flat as possible. Flatness in the kept range is what it optimises, at the cost of a gradual rather than sharp cut-off. It is used to separate slow collective motion in a trajectory from fast thermal noise. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001698 "butterworth filter algorithm"@en)
SubClassOf(obo:MOLSIM_001698 obo:MOLSIM_001697)

# Class: obo:MOLSIM_001699 (trapezoid integration algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001699 "A numerical integration algorithm that approximates the area under a curve by joining neighbouring points with straight lines and summing the resulting trapezoids. It needs only the sampled points, with no assumption about the function between them. It is the usual way the thermodynamic integration curve is integrated over the coupling parameter. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001699 "trapezoid integration algorithm"@en)
SubClassOf(obo:MOLSIM_001699 obo:MOLSIM_001694)

# Class: obo:MOLSIM_001700 (random number generator algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001700 "A random number generator is an algorithm designed to produce a sequence of numbers that lacks any discernible pattern, appearing to be random. In computational science, these are essential for introducing the element of chance required by certain simulation methods. For experts, these pseudo-random number generators are critical components of stochastic thermostats and Monte Carlo algorithms. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001700 "random number generator algorithm"@en)
SubClassOf(obo:MOLSIM_001700 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001701 (Marsaglia random number generator algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001701 "A pseudo-random number generator of the family developed by Marsaglia, built from simple shift and multiply operations on a small internal state. The simplicity makes them fast and easy to implement, which is why they appear inside simulation engines. They pass standard statistical tests while using far less state than a long-period generator. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001701 "Marsaglia random number generator algorithm"@en)
SubClassOf(obo:MOLSIM_001701 obo:MOLSIM_001700)

# Class: obo:MOLSIM_001702 (Mersenne Twister random number generator algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001702 "A pseudo-random number generator that produces a sequence repeating only after an extremely long period, with no detectable pattern in ordinary statistical tests. It is the default generator in many scientific libraries. It is not suitable where an adversary must not predict the sequence, which does not arise in simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001702 "Mersenne Twister random number generator algorithm"@en)
SubClassOf(obo:MOLSIM_001702 obo:MOLSIM_001700)

# Class: obo:MOLSIM_001703 (permuted congruential random number generator algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001703 "A permuted congruential generator is a type of pseudo-random number generator that aims to improve the statistical properties of simpler linear congruential generators. It takes the output of a standard congruential generator and applies a permutation (shuffling) to its bits to break up correlations. For experts, this represents a class of generators that offers a good trade-off between computational simplicity and improved statistical quality. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001703 "permuted congruential random number generator algorithm"@en)
SubClassOf(obo:MOLSIM_001703 obo:MOLSIM_001700)

# Class: obo:MOLSIM_001704 (Xoshiro128++ random number generator algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001704 "A pseudo-random number generator built from shift, rotate and add operations on 128 bits of state. It is fast and passes current statistical test suites, and its small state makes it cheap to keep one per thread. Giving each thread its own generator is what keeps a parallel simulation reproducible. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001704 "Xoshiro128++ random number generator algorithm"@en)
SubClassOf(obo:MOLSIM_001704 obo:MOLSIM_001700)

# Class: obo:MOLSIM_001705 (MDposit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001705 "MDposit is a web-based platform and portal designed for the sharing, visualization, and analysis of molecular dynamics simulation data. It serves as a distributed database interface that allows users to browse, access, and interactively view trajectories from different research groups. This tool aims to facilitate the dissemination and reuse of large-scale simulation datasets within the scientific community."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001705 "MDposit"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001705 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001705 obo:MOLSIM_001119)

# Class: obo:MOLSIM_001706 (fast fourier transform algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001706 "An algorithm that converts data between a description in time or space and one in frequency, in a time that grows only slightly faster than the amount of data. Computing the same transform directly would cost far more, growing with the square of the data size. It is what makes particle mesh Ewald affordable, since one is performed at every step. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001706 "fast fourier transform algorithm"@en)
SubClassOf(obo:MOLSIM_001706 obo:MOLSIM_001697)

# Class: obo:MOLSIM_001707 (DBSCAN clustering algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001707 "A clustering algorithm that grows a group outward from any point with enough neighbours within a chosen distance, and leaves sparse points unassigned. It needs no target number of groups and can find groups of any shape. Structures left unassigned are treated as rare conformations rather than forced into a group, which suits a trajectory well. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001707 "DBSCAN clustering algorithm"@en)
SubClassOf(obo:MOLSIM_001707 obo:MOLSIM_000253)

# Class: obo:MOLSIM_001708 (k-means clustering algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001708 "A clustering algorithm that divides structures into a fixed number of groups by repeatedly assigning each to the nearest group centre and then recomputing the centres. The number of groups must be chosen in advance, which is its main limitation. It also assumes groups are roughly round and of similar size, which conformations often are not. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001708 "k-means clustering algorithm"@en)
SubClassOf(obo:MOLSIM_001708 obo:MOLSIM_000253)

# Class: obo:MOLSIM_001709 (density peaks clustering algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001709 "A clustering algorithm that picks group centres as points which have many close neighbours and are also far from any point with still more neighbours. Those 2 conditions identify a peak in the crowding rather than an arbitrary starting point. Every other point then joins the nearest denser point, which assigns the whole set in one pass. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001709 "density peaks clustering algorithm"@en)
SubClassOf(obo:MOLSIM_001709 obo:MOLSIM_000253)

# Class: obo:MOLSIM_001710 (Levenberg-Marquardt algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001710 "An optimization algorithm for fitting a non-linear model to data, which shifts between 2 strategies according to how well the fit is going: a cautious one far from the answer and a fast one near it. That shift is what makes it converge reliably from a poor starting guess. It is the standard method for fitting force field parameters to reference data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001710 "Levenberg-Marquardt algorithm"@en)
SubClassOf(obo:MOLSIM_001710 obo:MOLSIM_000407)

# Class: obo:MOLSIM_001711 (residue library)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001711 "A data file holding the complete definition of a molecular building block, giving its atoms, their types and charges, the bonds between them and their standard geometry. It lets a topology be assembled from a sequence without every atom being specified. A residue absent from it cannot be built automatically. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001711 "residue library"@en)
SubClassOf(obo:MOLSIM_001711 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001712 (downhill simplex minimizer algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001712 "An optimization algorithm that keeps a set of trial points forming a simple shape and repeatedly replaces its worst point by reflecting it through the others. It never needs a derivative, only the ability to evaluate the function. That makes it usable where derivatives are unavailable or unreliable, at the cost of converging slowly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001712 "downhill simplex minimizer algorithm"@en)
SubClassOf(obo:MOLSIM_001712 obo:MOLSIM_000408)

# Class: obo:MOLSIM_001713 (Hawkins-Cramer-Truhlar radii set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001713 "A set of effective atomic radii fitted for use with the SMx family of implicit solvent models. The radii absorb part of the error of the underlying model, which is why they are specific to it. Substituting a general-purpose set such as Bondi changes the computed solvation energies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001713 "Hawkins-Cramer-Truhlar radii set"@en)
SubClassOf(obo:MOLSIM_001713 obo:MOLSIM_000272)

# Class: obo:MOLSIM_001714 (Gaussian quadrature algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001714 "A numerical integration algorithm that evaluates a function at specially chosen points, with matching weights, so the result is exact for polynomials up to a given degree. Choosing the positions as well as the weights doubles the degree that a given number of points can handle. It needs the function to be evaluable anywhere, not only at points already sampled. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001714 "Gaussian quadrature algorithm"@en)
SubClassOf(obo:MOLSIM_001714 obo:MOLSIM_001694)

# Class: obo:MOLSIM_001715 (surface area calculation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001715 "An algorithm that computes how much of a molecule's surface a solvent molecule can reach. It does so by rolling a sphere the size of a solvent molecule over the atoms and measuring the area traced out. The result is used to estimate how much it costs to make a hole in the solvent for the molecule to sit in. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001715 "surface area calculation algorithm"@en)
SubClassOf(obo:MOLSIM_001715 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001716 (LCPO algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001716 "An algorithm that estimates solvent-accessible surface area from a sum over overlapping pairs of atoms, with fitted coefficients, rather than by placing test points. Having a closed form makes it fast enough to run at every step of a simulation, and to be differentiated so it contributes forces. Point-based methods are more accurate and cannot do either. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001716 "LCPO algorithm"@en)
SubClassOf(obo:MOLSIM_001716 obo:MOLSIM_001715)

# Class: obo:MOLSIM_001717 (RMSD calculation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001717 "An algorithm that measures how far 2 structures differ, by first superposing them to remove any overall shift or rotation and then taking the root mean square of the remaining distances between matched atoms. Without the superposition step, moving a molecule across the box would register as a large change in shape. The choice of which atoms to superpose on decides what the number means. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001717 "RMSD calculation algorithm"@en)
SubClassOf(obo:MOLSIM_001717 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001718 (quaternion RMSD algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001718 "An algorithm that finds the optimal superposing rotation by solving a 4-by-4 eigenvalue problem rather than by decomposing a matrix. Representing the rotation with 4 numbers avoids the numerical failure that matrix methods can suffer when the 2 structures are nearly mirror images. It gives the same answer as the matrix route and is more robust. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001718 "quaternion RMSD algorithm"@en)
SubClassOf(obo:MOLSIM_001718 obo:MOLSIM_001717)

# Class: obo:MOLSIM_001719 (Broyden-Fletcher-Goldfarb-Shanno algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001719 "An optimization algorithm that builds an approximation to the curvature of a function from the slopes seen at successive steps, and uses it to choose each new step. Approximating the curvature rather than computing it converges in far fewer steps than using slope alone, without the cost of second derivatives. It stores a full matrix, which limits it to problems with a moderate number of variables. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001719 "BFGS")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001719 "BFGS algorithm"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001719 "Broyden-Fletcher-Goldfarb-Shanno algorithm"@en)
SubClassOf(obo:MOLSIM_001719 obo:MOLSIM_000407)

# Class: obo:MOLSIM_001720 (conjugate gradient algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001720 "A minimization algorithm that chooses each step from the current downhill direction combined with the previous step's direction, so that it does not undo progress already made. That memory is what lets it follow a long narrow valley, where steepest descent zig-zags. It is the usual choice once the worst overlaps in a structure have been removed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001720 "conjugate gradient algorithm"@en)
SubClassOf(obo:MOLSIM_001720 obo:MOLSIM_000408)

# Class: obo:MOLSIM_001721 (Powell's algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001721 "An optimization algorithm that finds a minimum by searching along one direction at a time and gradually replacing those directions with better ones built from the progress made. It never needs a derivative, only function values. It suits problems where derivatives are unavailable or too noisy to trust. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001721 "Powell's algorithm"@en)
SubClassOf(obo:MOLSIM_001721 obo:MOLSIM_000407)

# Class: obo:MOLSIM_001722 (multiple time-stepping algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001722 "An integration algorithm that updates different forces at different intervals, evaluating the fast-changing bonded forces every step and the slow-changing long-range forces only every few steps. Most of the cost of a simulation is in the long-range forces, so evaluating them less often is a large saving. Stretching the interval too far makes the simulation unstable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001722 "multiple time-stepping algorithm"@en)
SubClassOf(obo:MOLSIM_001722 obo:MOLSIM_001691)

# Class: obo:MOLSIM_001723 (r-RESPA integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001723 "A multiple time-stepping algorithm that separates forces by how fast they change and nests their updates inside one another, in a way that can be run backwards to recover the starting state exactly. That reversibility is what keeps energy from drifting, which simpler multiple time-stepping schemes do not manage. It is the standard implementation of the idea. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001723 "r-RESPA integrator"@en)
SubClassOf(obo:MOLSIM_001723 obo:MOLSIM_001722)

# Class: obo:MOLSIM_001724 (Treecode algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001724 "An algorithm that computes long-range forces quickly by grouping distant particles into a hierarchy of cells and treating each distant group as a single source. A group far enough away is indistinguishable from a point, so computing its members separately is wasted work. It reduces the cost from growing with the square of the particle count to growing close to linearly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001724 "Treecode algorithm"@en)
SubClassOf(obo:MOLSIM_001724 obo:MOLSIM_000384)

# Class: obo:MOLSIM_001725 (force-coordinate extrapolation integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001725 "An advanced algorithm for updating atom positions in a molecular dynamics simulation that uses information from previous steps to predict the future motion. It works by extrapolating both the forces and the coordinates to the next time point, which can allow for a larger time step while maintaining numerical stability. This type of integrator is a specialized method aimed at improving the computational efficiency of a simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001725 "force-coordinate extrapolation integrator"@en)
SubClassOf(obo:MOLSIM_001725 obo:MOLSIM_001722)

# Class: obo:MOLSIM_001726 (QM/MM region selection algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001726 "An algorithm that decides, during a simulation, which atoms belong in the quantum region at each moment. It is needed when molecules such as solvent move in and out of the region of interest, so a fixed list would either trap them or cut them in half. The difficulty is changing the assignment without a jump in energy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001726 "QM/MM region selection algorithm"@en)
SubClassOf(obo:MOLSIM_001726 obo:MOLSIM_001546)

# Class: obo:MOLSIM_001727 (hysteretic region selection algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001727 "A region selection algorithm that uses 2 distance thresholds, a nearer one for entering the quantum region and a farther one for leaving it. The gap between them stops an atom sitting exactly at the boundary from switching back and forth every step. That repeated switching is what makes a single-threshold rule unusable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001727 "hysteretic region selection algorithm"@en)
SubClassOf(obo:MOLSIM_001727 obo:MOLSIM_001726)

# Class: obo:MOLSIM_001728 (quantum mechanics algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001728 "An algorithm that solves the equations of quantum mechanics for a molecular system, to obtain how its electrons are arranged and what energy that costs. All such algorithms are approximate, because the exact equations cannot be solved for more than one electron. They differ in which approximation they make and what it costs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001728 "quantum mechanics algorithm"@en)
SubClassOf(obo:MOLSIM_001728 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001729 (divide and conquer algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001729 "An algorithm that makes a quantum calculation on a large molecule possible by splitting it into overlapping pieces, solving each, and recombining them. A conventional calculation costs far more than proportionally more as the system grows, which is what this avoids. The pieces must overlap, or the joins between them introduce errors. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001729 "divide and conquer algorithm"@en)
SubClassOf(obo:MOLSIM_001729 obo:MOLSIM_001728)

# Class: obo:MOLSIM_001730 (I/r-RESPA integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001730 "A multiple time-stepping algorithm of the RESPA family adapted for polarizable force fields, where the induced dipoles must be resolved at each evaluation of the long-range forces. Polarizable models make the long-range part far more expensive, so separating it out matters more than usual. It splits the forces by range as well as by how quickly they change. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001730 "I/r-RESPA integrator"@en)
SubClassOf(obo:MOLSIM_001730 obo:MOLSIM_001722)

# Class: obo:MOLSIM_001731 (Nose-Hoover chain thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001731 "A temperature control algorithm that couples the system to a bath variable, that variable to a second, and so on along a chain. The chain fixes a failure of the single-variable form, which cannot reach the correct distribution for a system with few degrees of freedom or one starting far from equilibrium. A chain of 3 to 5 is usual. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001731 "Nose-Hoover chain thermostat"@en)
SubClassOf(obo:MOLSIM_001731 obo:MOLSIM_000038)

# Class: obo:MOLSIM_001732 (Bussi thermostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001732 "A temperature control algorithm that rescales the velocities towards the target temperature by a factor drawn partly at random, so that the energy follows the correct distribution rather than being driven to a single value. It reaches equilibrium as quickly as the simple rescaling schemes while sampling correctly, which they do not. stochastic velocity rescaling thermostat should be kept as an exact synonym. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001732 "Bussi thermostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_001732 "ntt=11")
SubClassOf(obo:MOLSIM_001732 obo:MOLSIM_000038)

# Class: obo:MOLSIM_001733 (velocity-Verlet middle integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001733 "An integration algorithm of the velocity-Verlet family in which the thermostat acts halfway through each step rather than at its start or end. Placing it there keeps the sampled distribution closer to the correct one when the timestep is large. The difference shows up as an error in temperature that grows with timestep in the other arrangements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001733 "velocity-Verlet middle integrator"@en)
SubClassOf(obo:MOLSIM_001733 obo:MOLSIM_001691)

# Class: obo:MOLSIM_001734 (Car-Parrinello induced dipole scheme)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001734 "A polarization algorithm that gives each induced dipole a small fictitious mass and lets it move under its own equation of motion, instead of solving for it exactly at every step. If the mass is small enough the dipoles stay close to the exact solution while never being solved for. It removes the iteration that otherwise dominates the cost. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001734 "Car-Parrinello induced dipole scheme"@en)
SubClassOf(obo:MOLSIM_001734 obo:MOLSIM_001546)

# Class: obo:MOLSIM_001735 (middle thermostat scheme)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001735 "A way of placing the thermostat's action halfway through each integration step rather than at its beginning or end. That placement keeps the sampled distribution correct at much larger timesteps than the alternatives allow. The difference appears as a temperature error that grows with timestep in the other arrangements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001735 "middle thermostat scheme"@en)
SubClassOf(obo:MOLSIM_001735 obo:MOLSIM_000038)

# Class: obo:MOLSIM_001736 (Tan&Luo radii set)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001736 "A set of atomic radii fitted for use with the GB-Neck2 implicit solvent model. Fitting them alongside that model is what lets it reproduce Poisson-Boltzmann solvation energies closely. They are not interchangeable with radii fitted for other generalized Born models. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001736 "Tan&Luo radii set"@en)
SubClassOf(obo:MOLSIM_001736 obo:MOLSIM_000272)

# Class: obo:MOLSIM_001737 (Polak-Ribiere conjugate gradient algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001737 "A minimization algorithm that chooses each search direction from the current downhill slope combined with the previous direction, using a particular formula for how much of the previous one to keep. That formula is what separates it from the other conjugate gradient variants. It recovers well when progress stalls, because its formula resets the direction automatically in that case. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001737 "Polak-Ribiere conjugate gradient algorithm"@en)
SubClassOf(obo:MOLSIM_001737 obo:MOLSIM_001720)

# Class: obo:MOLSIM_001738 (limited-memory BFGS algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001738 "An optimization algorithm that builds an approximate picture of the curvature of a function from the last few steps taken, rather than storing the full curvature matrix. Storing that matrix is impossible when there are hundreds of thousands of variables, as in a large molecular system. Keeping only recent history gives most of the benefit at a fraction of the memory. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001738 "L-BFGS algorithm"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001738 "L-BGFS minimizer"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001738 "limited-memory BFGS algorithm"@en)
SubClassOf(obo:MOLSIM_001738 obo:MOLSIM_001719)

# Class: obo:MOLSIM_001739 (truncated Newton conjugate gradient algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001739 "A minimization algorithm that uses curvature information about the energy surface to choose each step, computing that information only approximately and stopping the approximation early. Using curvature converges in far fewer steps than using slope alone, and computing it exactly would be impossible for a large system. Stopping early is the compromise the name refers to. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001739 "truncated Newton conjugate gradient algorithm"@en)
SubClassOf(obo:MOLSIM_001739 obo:MOLSIM_000408)

# Class: obo:MOLSIM_001740 (enhanced sampling algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001740 "An enhanced sampling algorithm is a computational procedure that modifies a standard simulation to accelerate the exploration of a molecule's possible states or to observe rare events. These algorithms are designed to overcome the high energy barriers that can trap a simulation in a single state for a long time."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001740 "enhanced sampling algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001740 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001740 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001741 (multiple-walkers algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001741 "An enhanced sampling algorithm where multiple independent simulation replicas (walkers) simultaneously explore the conformational space and contribute to a single, shared biasing potential. This parallelization significantly accelerates the convergence of methods like metadynamics or adaptive biasing force."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001741 "multiple-walkers algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001741 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001741 obo:MOLSIM_001740)

# Class: obo:MOLSIM_001742 (InChI code)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001742 "The IUPAC International Chemical Identifier (InChI) is a standardized text string that provides a unique, machine-readable signature for a specific chemical substance. It is algorithmically generated from a molecule's structural information and it is sensitive to its chirality, ensuring that a given compound will always produce the same identifier regardless of how it is drawn. This code serves as a universal label for linking chemical information across different databases and software."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001742 "InChI code"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001742 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001742 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001743 (ICOSA algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001743 "The ICOSA algorithm is a computational method used to rapidly calculate the solvent-accessible surface area (SASA) of a molecule. It works by placing a sphere of dots, arranged in a pattern based on an icosahedron, around each atom and then counting how many of these dots are not covered by neighboring atoms. This numerical approach provides a fast and efficient way to estimate the molecular surface area, a property that is crucial for implicit solvent models and for analyzing a molecule's exposure to its environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001743 "ICOSA algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001743 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001743 obo:MOLSIM_001715)

# Class: obo:MOLSIM_001744 (steepest descent algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001744 "A minimization algorithm that moves the atoms at each step in the direction of the force on them, which is the steepest downhill direction from where they are. It is robust and almost never fails, because that direction always lowers the energy. It slows to a crawl in a long narrow valley, where the steepest direction points across the valley rather than along it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001744 "steepest descent algorithm"@en)
SubClassOf(obo:MOLSIM_001744 obo:MOLSIM_000408)

# Class: obo:MOLSIM_001745 (secondary structure assignment algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001745 "An algorithm that identifies which parts of a protein form regular repeating shapes, such as helices and sheets, from the coordinates of its backbone. It works by finding the pattern of hydrogen bonds between backbone groups, or by examining backbone angles. It is what turns a list of coordinates into the helix-and-arrow picture of a protein. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001745 "secondary structure assignment algorithm"@en)
SubClassOf(obo:MOLSIM_001745 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001746 (DSSP algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001746 "The DSSP (Define Secondary Structure of Proteins) algorithm is the most widely used and standard algorithm for assigning secondary structure to the residues of a protein. It works by identifying the characteristic hydrogen-bonding patterns between the backbone amide and carbonyl groups that define alpha-helices and beta-sheets. The detailed, per-residue output of the DSSP algorithm is a standard tool for protein structure analysis and validation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001746 "DSSP algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001746 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001746 obo:MOLSIM_001745)

# Class: obo:MOLSIM_001747 (trajectory analysis algorithm (deprecated))

AnnotationAssertion(owl:deprecated obo:MOLSIM_001747 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001747 "OBSOLETE. A trajectory analysis algorithm is a computational procedure that processes the time-series of atomic coordinates from a simulation to calculate a specific property. These algorithms are the engines of analysis tools, turning raw simulation output into interpretable scientific data. For experts, this includes the specific algorithms for tasks like imaging periodic trajectories, calculating correlation functions, or clustering conformations."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001747 "candidate for removal per https://github.com/CPCLab/molsim-ontology/issues/21")
AnnotationAssertion(rdfs:label obo:MOLSIM_001747 "obsolete trajectory analysis algorithm"@en)

# Class: obo:MOLSIM_001748 (toroidal-view-preserving algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001748 "A specialized algorithm for visualizing molecules in a periodic simulation box that ensures chemical bonds are always drawn correctly, even when they cross a boundary. It treats the periodic box as a torus (a donut shape), so that when a molecule is viewed, its connectivity is preserved without being artificially \"broken\" at the box edges. This scheme is important for creating clear and unambiguous visualizations of molecular structures and their interactions within a periodic environment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001748 "toroidal-view-preserving algorithm"@en)
SubClassOf(obo:MOLSIM_001748 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001749 (cubic spline interpolation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001749 "An algorithm that draws a smooth curve through a set of points by fitting a cubic polynomial between each neighbouring pair and matching their slopes and curvatures where they join. The matching is what stops the curve having visible corners. It is how a free energy profile is drawn from values computed at discrete points. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001749 "cubic spline interpolation algorithm"@en)
SubClassOf(obo:MOLSIM_001749 obo:MOLSIM_001697)

# Class: obo:MOLSIM_001750 (continuous wavelet transform)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001750 "A method that decomposes a signal into contributions at each frequency and each moment at once, by matching it against a shape that is stretched and shifted across the data. A plain frequency analysis gives no information about when. That matters for a trajectory, where a motion may appear only during part of the run. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001750 "continuous wavelet transform"@en)
SubClassOf(obo:MOLSIM_001750 obo:MOLSIM_001697)

# Class: obo:MOLSIM_001751 (statistical algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001751 "An algorithm that applies the methods of statistics to summarise data, estimate a quantity, or judge how reliable a result is. Simulation output is a sample rather than an exact answer, so every number taken from it needs one. Reporting a value without an uncertainty is the most common failure this addresses. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001751 "statistical algorithm"@en)
SubClassOf(obo:MOLSIM_001751 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001752 (kernel density estimation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001752 "A statistical algorithm that estimates the distribution behind a set of points by placing a small smooth bump on each and adding them together. It assumes no particular shape for the distribution, unlike fitting a named family. How wide the bumps are decides whether it reveals real structure or smooths it away. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001752 "kernel density estimation algorithm"@en)
SubClassOf(obo:MOLSIM_001752 obo:MOLSIM_001751)

# Class: obo:MOLSIM_001753 (residue name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001753 "A residue name is a standardized short code, typically three or four letters, used in structure files to identify a specific type of molecular building block. For example, 'ALA' is the residue name for the amino acid alanine, and 'DG' can represent a deoxyguanosine nucleotide."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001753 orcid:0000-0003-4177-3619)
AnnotationAssertion(rdfs:label obo:MOLSIM_001753 "residue name"@en)
SubClassOf(obo:MOLSIM_001753 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001754 (GLYCAM residue name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001754 "A short code identifying a particular sugar in the GLYCAM carbohydrate force field, encoding not only which sugar it is but which of its hydroxyl groups are linked onward. Sugars branch, so the same sugar appears in many linkage patterns and each needs its own template. That is why the naming carries linkage information where amino acid codes do not. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001754 "GLYCAM residue name"@en)
SubClassOf(obo:MOLSIM_001754 obo:MOLSIM_001753)

# Class: obo:MOLSIM_001755 (atom name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001755 "An atom name is a unique label given to an atom within a specific residue to distinguish it from other atoms of the same element. For example, in an amino acid, the names 'CA' and 'CB' are used to differentiate the alpha-carbon from the beta-carbon."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001755 orcid:0000-0003-4177-3619)
AnnotationAssertion(rdfs:label obo:MOLSIM_001755 "atom name"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001755 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001755 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001756 (residue connection atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001756 "The atom of a residue designated to form the bond joining it to the neighbouring residue in a chain. Building a polymer from residue templates requires knowing which atom on each side makes that bond. Without it, templates could be listed in order and never joined. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001756 "residue connection atom"@en)
SubClassOf(obo:MOLSIM_001756 obo:MOLSIM_001711)

# Class: obo:MOLSIM_001757 (unit head atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001757 "The atom of a residue template that bonds to the preceding residue in a chain. In a protein it is the backbone nitrogen. Together with the tail atom it defines the direction in which templates are joined. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001757 "unit head atom"@en)
SubClassOf(obo:MOLSIM_001757 obo:MOLSIM_001711)

# Class: obo:MOLSIM_001758 (unit tail atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001758 "The atom of a residue template that bonds to the following residue in a chain. In a protein it is the backbone carbonyl carbon. A template with no tail atom defined cannot be followed by another, which is how a chain terminus is expressed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001758 "unit tail atom"@en)
SubClassOf(obo:MOLSIM_001758 obo:MOLSIM_001711)

# Class: obo:MOLSIM_001759 (Miller indices (deprecated))

AnnotationAssertion(owl:deprecated obo:MOLSIM_001759 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001759 "OBSOLETE. Miller indices are a set of three integers (h, k, l) that uniquely describe the orientation of a plane of atoms within a crystal lattice. These indices are determined from the positions of the spots in an X-ray diffraction pattern and are fundamental to crystallography. They are used to define the specific crystal faces and to calculate the theoretical diffraction pattern from a structural model."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001759 "Marked for removal. See: https://github.com/CPCLab/molsim-ontology/issues/26"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001759 "obsolete Miller indices"@en)

# Class: obo:MOLSIM_001760 (residue type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001760 "A classification recorded in a topology stating what general kind of building block a residue is, such as protein, nucleic acid, water, ion or solvent. Analysis tools use it to select parts of a system without naming every residue. A mis-set value makes a selection quietly omit or include the wrong atoms. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001760 "residue type"@en)
SubClassOf(obo:MOLSIM_001760 obo:MOLSIM_001711)

# Class: obo:MOLSIM_001761 (volumetric data component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001761 "A constituent part of a 3-dimensional data map, being either a grid point or the value stored at it. The grid points fix where the map is sampled and the values say what was found there. The term exists so that the 2 can be referred to separately. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001761 "volumetric data component"@en)
SubClassOf(obo:MOLSIM_001761 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001762 (voxel)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001762 "A single cell of a 3-dimensional grid, holding one value for the small volume of space it covers. It is to a volume what a pixel is to an image. Analyses that map a property through space, such as where water sits around a protein, report their results one of these at a time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001762 "voxel"@en)
SubClassOf(obo:MOLSIM_001762 obo:MOLSIM_001761)

# Class: obo:MOLSIM_001763 (atom type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001763 "A classification assigned to an atom to describe its fundamental chemical identity or its specific physical and computational properties within a molecular model."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001763 orcid:0000-0003-4177-3619)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001763 "Previous definition: An atom type is a classification assigned to an atom in a force field that defines its interaction parameters based on its chemical environment. It encodes not just the chemical element but also its hybridization state and bonding pattern, so a carbonyl carbon will have a different atom type than an aromatic carbon."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001763 "atom type"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001763 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001763 obo:MOLSIM_000447)

# Class: obo:MOLSIM_001764 (neural network atom type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001764 "A description of an atom's surroundings used by a machine-learned force field, computed from the positions of its neighbours rather than assigned from a table. A conventional atom type is a fixed label such as \"aromatic carbon\"; this instead varies continuously with the local geometry. That is what lets such a model describe environments it was never given a label for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001764 "neural network atom type"@en)
SubClassOf(obo:MOLSIM_001764 obo:MOLSIM_001763)

# Class: obo:MOLSIM_001765 (modified amino acid residue name)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001765 "A code identifying an amino acid that has been chemically altered, such as by phosphorylation or methylation. The standard 3-letter codes cover only the 20 unmodified residues, so a modified one needs a code of its own. The code is what links the residue to the extra parameters its modification requires. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001765 "modified amino acid residue name"@en)
SubClassOf(obo:MOLSIM_001765 obo:MOLSIM_001753)

# Class: obo:MOLSIM_001766 (path image)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001766 "A path image is a single, discrete snapshot or structure that represents one point along a continuous pathway between two molecular states. A collection of these images is used in methods like the Nudged Elastic Band (NEB) to map out a reaction path or conformational transition."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001766 "path image"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001766 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001766 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001767 (trajectory post-processing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001767 "Trajectory post-processing is the general process of cleaning and preparing raw simulation trajectory files before performing detailed scientific analysis. This typically involves essential steps like removing the overall rotation and translation of a target molecule to keep it centered, and fixing any molecules that appear \"broken\" by the periodic boundary conditions. These routine procedures are necessary to create a clean trajectory that is suitable for correct visualization and accurate calculation of structural properties."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001767 "trajectory post-processing"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001767 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001767 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001768 (match list preparation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001768 "A system preparation stage in which a correspondence is established between the atoms of 2 structures, saying which atom of one plays the part of which atom of the other. An alchemical transformation needs it to know which atoms change and which stay. A wrong correspondence produces a calculation that runs to completion and gives a wrong answer. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001768 "match list preparation"@en)
SubClassOf(obo:MOLSIM_001768 obo:MOLSIM_000002)

# Class: obo:MOLSIM_001769 (topology and coordinate file preparation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001769 "A preparation process that produces the 2 files a simulation needs: a topology file saying what the system is made of, and a coordinate file saying where everything currently is. The topology lists the atoms, the bonds between them and the force field parameters, and it does not change during the run. The coordinates change at every step, which is why the 2 are kept apart. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001769 "topology and coordinate file preparation"@en)
SubClassOf(obo:MOLSIM_001769 obo:MOLSIM_000002)

# Class: obo:MOLSIM_001770 (rotational diffusion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001770 "The random tumbling of a molecule in a liquid, caused by collisions with the solvent around it. How fast it tumbles depends on its size and shape and on how viscous the solvent is. It is what NMR relaxation measurements are sensitive to, which is how a simulated value can be checked. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001770 "rotational diffusion"@en)
SubClassOf(obo:MOLSIM_001770 obo:MOLSIM_001391)

# Class: obo:MOLSIM_001771 (backmapping modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001771 "A modelling method that rebuilds an all-atom structure from a coarse-grained one, placing the atoms each grouped site stands for. Information was discarded when the coarse model was built, so the rebuilt atoms are a plausible arrangement rather than a recovered one. It is used to inspect a coarse-grained result in atomic detail, or to continue a simulation at finer resolution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001771 "backmapping modeling"@en)
SubClassOf(obo:MOLSIM_001771 obo:MOLSIM_000305)

# Class: obo:MOLSIM_001772 (NMR refinement)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001772 "NMR refinement is a computational process used to generate or improve a three-dimensional model of a molecule using experimental data from Nuclear Magnetic Resonance (NMR) spectroscopy. The method involves finding a structure, or an ensemble of structures, that is both stereochemically realistic and consistent with a set of experimental restraints, such as distances between atoms derived from the Nuclear Overhauser Effect. This process is essential for translating the raw data from an NMR experiment into a high-resolution atomic model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001772 "NMR refinement"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001772 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001772 obo:MOLSIM_000202)

# Class: obo:MOLSIM_001773 (LEaP preparation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001773 "A system preparation stage in which a molecular system is assembled and given force field parameters, producing the topology and coordinate files a simulation needs. It covers loading the structure, choosing the force field, adding solvent and counter-ions, and writing the output. It is the step at which a structure becomes a simulatable system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001773 "LEaP preparation"@en)
SubClassOf(obo:MOLSIM_001773 obo:MOLSIM_000002)

# Class: obo:MOLSIM_001774 (momentum removal)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001774 "A procedure applied at intervals during a simulation that subtracts any overall translation, and sometimes rotation, of the whole system. Small numerical errors accumulate into a drift of the entire box, which would otherwise be counted as thermal motion and inflate the temperature. Removing it keeps the reported temperature meaning what it should. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001774 "momentum removal"@en)
SubClassOf(obo:MOLSIM_001774 obo:MOLSIM_000002)

# Class: obo:MOLSIM_001775 (post-translational modification)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001775 "A chemical change made to a protein after it has been built from its amino acid sequence, such as attaching a phosphate, a sugar or a lipid. It can switch the protein's activity on or off, mark it for destruction, or send it to a particular part of the cell. Standard force fields do not include the modified residues, so extra parameters are needed to simulate one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001775 "post-translational modification"@en)
SubClassOf(obo:MOLSIM_001775 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001776 (N-linked glycosylation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001776 "A post-translational modification in which a branched sugar chain is attached to the nitrogen of an asparagine side chain. It is among the most common modifications of proteins on the cell surface and of secreted proteins. The sugar chains are large, flexible and highly variable, which makes them among the hardest parts of a protein to simulate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001776 "N-linked glycosylation"@en)
SubClassOf(obo:MOLSIM_001776 obo:MOLSIM_001775)

# Class: obo:MOLSIM_001777 (O-linked glycosylation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001777 "A post-translational modification in which sugars are attached to the oxygen of a serine or threonine side chain, added one at a time rather than as a preassembled block. Because they are added singly, the resulting chains vary far more between copies of the same protein than the nitrogen-linked kind. That variability is what makes such proteins hard to define, let alone simulate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001777 "O-linked glycosylation"@en)
SubClassOf(obo:MOLSIM_001777 obo:MOLSIM_001775)

# Class: obo:MOLSIM_001778 (wavefunction model)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001778 "A model specifying the mathematical form assumed for the many-electron wavefunction in a quantum chemistry calculation, such as a single determinant or a combination of several configurations. It fixes what electronic structure the calculation is able to represent before any basis set is chosen. A single determinant cannot describe bond breaking or a near-degenerate ground state. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001778 "wavefunction model"@en)
SubClassOf(obo:MOLSIM_001778 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001779 (restricted closed-shell wavefunction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001779 "A wavefunction model in which every occupied molecular orbital holds exactly 2 electrons of opposite spin. It applies to molecules with no unpaired electrons, which is most stable organic molecules in their ground state. It is the default assumption of a quantum chemistry calculation unless an open-shell model is asked for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001779 "restricted closed-shell wavefunction"@en)
SubClassOf(obo:MOLSIM_001779 obo:MOLSIM_001778)

# Class: obo:MOLSIM_001780 (unrestricted open-shell wavefunction)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001780 "A type of wavefunction model specifically used for molecules that have unpaired electrons, such as radicals or certain metal complexes. In an unrestricted open-shell wavefunction, electrons with spin-up and spin-down are allowed to occupy different spatial orbitals, providing the necessary flexibility to describe the different distributions of the unpaired electrons. This model is the basis for Unrestricted Hartree-Fock (UHF) and open-shell DFT calculations and is essential for correctly modeling the electronic structure and properties of radical species. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001780 "unrestricted open-shell wavefunction"@en)
SubClassOf(obo:MOLSIM_001780 obo:MOLSIM_001778)

# Class: obo:MOLSIM_001781 (secondary structure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001781 "A regular, repeating local shape that a stretch of a protein or nucleic acid chain folds into, held together by hydrogen bonds between nearby parts of the backbone. In proteins the common ones are the helix and the sheet; in nucleic acids they include the double helix and the hairpin. It is local, so one chain contains many such stretches with irregular regions between them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001781 "secondary structure"@en)
SubClassOf(obo:MOLSIM_001781 obo:SO_0001078)

# Class: obo:MOLSIM_001782 (beta sheet)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001782 "A beta sheet is a common shape in proteins where parts of the amino acid chain line up side-by-side like ribbons in a flat, pleated sheet. It is a secondary structure motif formed by two or more extended polypeptide chains, called beta-strands, which are linked laterally by a regular pattern of hydrogen bonds between their backbone atoms. These sheet structures form the rigid core of many proteins and are critical for creating binding surfaces for other molecules. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001782 "beta sheet"@en)
SubClassOf(obo:MOLSIM_001782 obo:MOLSIM_001781)

# Class: obo:MOLSIM_001783 (parallel beta sheet)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001783 "A parallel beta sheet is a type of beta sheet where the adjacent protein chains all run in the same direction, like lanes on a one-way highway. In this arrangement, the neighboring beta-strands are all aligned in the same N-terminus to C-terminus direction, which results in a pattern of angled, evenly spaced hydrogen bonds between the strands. This arrangement is typically found buried in the core of a protein and often requires long loop connections between the strands."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001783 "parallel beta sheet"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001783 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001783 obo:MOLSIM_001782)

# Class: obo:MOLSIM_001784 (anti-parallel beta sheet)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001784 "An anti-parallel beta sheet is a type of beta sheet where the adjacent protein strands run in opposite directions, like traffic on a two-way street. In this arrangement, the neighboring beta-strands are aligned in opposite N-terminus to C-terminus directions, resulting in a pattern of straight, perpendicular hydrogen bonds between the strands. This arrangement is generally more stable than the parallel form and is a very common structural motif found in many proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001784 "anti-parallel beta sheet"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001784 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001784 obo:MOLSIM_001782)

# Class: obo:MOLSIM_001785 (helix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001785 "OBSOLETE. A helix is a common shape in proteins and DNA where the molecular chain is twisted into a spiral or corkscrew. It is a secondary structure motif characterized by a repeating pattern of backbone dihedral angles that causes the polymer chain to follow a helical path, which is stabilized by a regular pattern of internal hydrogen bonds. The alpha-helix in proteins and the double helix of DNA are two of the most fundamental and recognizable structures in biology."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001785 "obsolete helix"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001785 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001785 obo:SO_0001114)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001785 "Retired 2026-08-05 in favour of the Sequence Ontology term, which covers the same concept in the ontology whose scope owns protein secondary structure. The MOLSIM hierarchy position is preserved: the SO class is asserted under MOLSIM:001781 secondary structure so the DSSP category set stays in one place."@en)

# Class: obo:MOLSIM_001786 (3-10 helix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001786 "OBSOLETE. The 3-10 helix is a type of spiral shape found in proteins that is tighter and more narrow than the common alpha-helix. It is a secondary structure motif characterized by a repeating hydrogen bond between the backbone carbonyl of a residue and the backbone amide of the residue three positions down the chain (i → i+3). While less common than the alpha-helix, short segments of 3-10 helix are often found at the ends of alpha-helices, acting as a cap to the structure."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001786 "obsolete 3-10 helix"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001786 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001786 obo:SO_0001119)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001786 "Retired 2026-08-05 in favour of the Sequence Ontology term, which covers the same concept in the ontology whose scope owns protein secondary structure. The MOLSIM hierarchy position is preserved: the SO class is asserted under MOLSIM:001781 secondary structure so the DSSP category set stays in one place."@en)

# Class: obo:MOLSIM_001787 (alpha helix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001787 "OBSOLETE. The alpha-helix is the most common spiral shape found in proteins, resembling a coiled ribbon. It is a right-handed secondary structure motif characterized by a repeating hydrogen bond between the backbone carbonyl of a residue and the backbone amide of the residue four positions down the chain (i → i+4). This highly stable and common structure forms a fundamental building block for the architecture of most proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001787 "obsolete alpha helix"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001787 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001787 obo:SO_0001117)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001787 "Retired 2026-08-05 in favour of the Sequence Ontology term, which covers the same concept in the ontology whose scope owns protein secondary structure. The MOLSIM hierarchy position is preserved: the SO class is asserted under MOLSIM:001781 secondary structure so the DSSP category set stays in one place."@en)

# Class: obo:MOLSIM_001788 (pi helix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001788 "OBSOLETE. The pi-helix is a wide spiral shape found in proteins that is less stable than the common alpha-helix. It is a secondary structure motif characterized by a repeating hydrogen bond between the backbone carbonyl of a residue and the backbone amide of the residue five positions down the chain (i → i+5). Because its internal packing is less favorable, the pi-helix is usually found only as a short, single-turn insertion within other helical structures. Once thought to be rare, short π-helices are found in 15% of known protein structures and are believed to be an evolutionary adaptation derived by the insertion of a single amino acid into an α-helix."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001788 "obsolete pi helix"@en)
AnnotationAssertion(owl:deprecated obo:MOLSIM_001788 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001788 obo:SO_0001118)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001788 "Retired 2026-08-05 in favour of the Sequence Ontology term, which covers the same concept in the ontology whose scope owns protein secondary structure. The MOLSIM hierarchy position is preserved: the SO class is asserted under MOLSIM:001781 secondary structure so the DSSP category set stays in one place."@en)

# Class: obo:MOLSIM_001789 (turn)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001789 "A secondary structure element in which 3 to 5 residues reverse the direction of a protein chain over a short distance. It is what lets 2 stretches of chain run back alongside each other, so a compact fold is possible at all. Without turns a chain could only extend. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001789 "turn"@en)
SubClassOf(obo:MOLSIM_001789 obo:MOLSIM_001781)

# Class: obo:MOLSIM_001790 (bend)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001790 "A bend is a region in a protein chain that creates a sharp turn, changing the direction of the polypeptide. It is a short structural motif, typically involving a few amino acid residues, that is characterized by a specific pattern of backbone dihedral angles that reverses the direction of the chain."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001790 "bend"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001790 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001790 obo:MOLSIM_001781)

# Class: obo:MOLSIM_001791 (extended beta conformation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001791 "A backbone conformation in which a polypeptide segment is stretched into a flat zig-zag, with backbone dihedral angles near the fully extended region of the Ramachandran plot. It is the conformation a strand takes inside a beta sheet, and the most extended a polypeptide reaches. The zig-zag is what places successive side chains on alternating faces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001791 "extended beta conformation"@en)
SubClassOf(obo:MOLSIM_001791 obo:MOLSIM_001781)

# Class: obo:MOLSIM_001792 (beta bridge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001792 "A beta bridge is an isolated, localized hydrogen bond between two amino acid residues from different segments of a protein, mimicking the interactions found in β-sheets."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001792 "beta bridge"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001792 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001792 obo:MOLSIM_001781)

# Class: obo:MOLSIM_001793 (conformational transition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001793 "A conformational transition is the process where a molecule changes from one stable three-dimensional molecular arrangement to another. This can be a large-scale event, such as a protein switching between an active and an inactive state, or a more local change like the flipping of a sugar ring. Studying these transitions is fundamental to understanding how molecular function is controlled by changes in structure."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001793 "conformational transition"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001793 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001793 obo:MOLSIM_001391)

# Class: obo:MOLSIM_001794 (crankshaft motion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001794 "A crankshaft motion refers to a specific, localized, correlated movement of a protein's backbone. Specifically, it is an oscillation or rotation of a rigid peptide plane along an axis defined by two adjacent Cα carbon atoms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001794 "crankshaft motion"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001794 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001794 obo:MOLSIM_001793)

# Class: obo:MOLSIM_001795 (MDL solvent model format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001795 "The Solvent MoDeL (MDL) file is an explicit molecular model input used for 1D-RISM and 3D-RISM (Reference Interaction Site Model) calculations in software like Amber. It supplies atomic coordinates, partial charges, and Lennard-Jones parameters for solvent molecules or ions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001795 "MDL solvent model format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001795 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001795 obo:MOLSIM_001091)

# Class: obo:MOLSIM_001796 (mean solvation force)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001796 "In computational chemistry and molecular dynamics, the mean solvation force is the average net force exerted by solvent molecules on a solute molecule, with all solvent degrees of freedom thermally averaged out. It represents the derivative of the potential of mean force (PMF) and drives conformational changes and structural binding in liquids."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001796 "mean solvation force"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001796 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001796 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001796 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000107))
SubClassOf(obo:MOLSIM_001796 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001797 (atom position)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001797 "The atom position is the precise location of an atom in three-dimensional space. It is described by a set of three Cartesian coordinates (X, Y, Z) that specify its location relative to a defined origin. The collection of all atom positions for a molecule at a given instant constitutes a single \"frame\" of a simulation trajectory, and the evolution of these positions over time is the fundamental output of a molecular dynamics simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001797 "atom position"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001797 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001797 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001798 (charge transfer energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001798 "An interaction energy component arising when a small amount of electron density moves from one molecule to another at close range. It is a quantum mechanical effect that a force field with fixed atomic charges cannot represent, yet it contributes measurably to hydrogen bonds and to interactions with metal ions. Capturing it needs a polarizable force field or a quantum mechanical treatment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001798 "charge transfer energy"@en)
SubClassOf(obo:MOLSIM_001798 obo:MOLSIM_001294)
SubClassOf(obo:MOLSIM_001798 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001798 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001799 (reference energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001799 "An energy chosen as the zero point against which other energies in a calculation are reported. In a free energy calculation it is usually a known or simplified state, and every other state is quoted as a difference from it. Comparisons between systems are meaningless unless the same choice was made for both. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001799 "reference energy"@en)
SubClassOf(obo:MOLSIM_001799 obo:MOLSIM_001294)
SubClassOf(obo:MOLSIM_001799 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000111))
SubClassOf(obo:MOLSIM_001799 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001800 (physical property)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001800 "A physical property is a measurable characteristic of a substance or system that describes its physical state, such as its temperature, pressure, or density. In molecular simulations, these properties are calculated as averages over the course of the trajectory to describe the macroscopic state of the simulated system. These calculated properties are the primary outputs used to validate a simulation against experimental data and to understand the material characteristics of the molecular model."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001800 "physical property"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001800 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001800 obo:MOLSIM_001292)

# Class: obo:MOLSIM_001801 (atomic scattering factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001801 "A quantity giving how strongly a single atom scatters a wave, as a function of scattering angle. It rises with the number of electrons the atom has and falls as the angle increases, because the electron cloud has finite size. It is the per-atom term that structure factors are built from. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001801 "atomic scattering factor"@en)
SubClassOf(obo:MOLSIM_001801 obo:MOLSIM_001800)
SubClassOf(obo:MOLSIM_001801 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001801 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001802 (script)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001802 "A program written in a language that is interpreted as it runs rather than compiled first, used to drive a sequence of steps automatically. Being interpreted makes it quick to change and slow to execute, which suits work that is mostly waiting on other programs. Most of the workflow around a simulation is scripts rather than compiled code. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001802 "script"@en)
SubClassOf(obo:MOLSIM_001802 obo:MOLSIM_000001)

# Class: obo:MOLSIM_001803 (interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001803 "An energy arising from the forces between 2 or more separate molecules, or between distinct parts of 1 molecule, computed as the energy of the whole minus the sum of the energies of the parts held at the same geometry. It gathers the electrostatic and van der Waals contributions into a single number. It measures how strongly the parts are held together, but it is not a free energy, because it contains no entropy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001803 "interaction energy"@en)
SubClassOf(obo:MOLSIM_001803 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001804 (solute-water interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001804 "An interaction energy between a solute and all the water molecules around it. It sums the electrostatic and van der Waals contributions over every solute-water pair. Following it through a trajectory shows how the solute's contact with water changes as it moves. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001804 "solute-water interaction energy"@en)
SubClassOf(obo:MOLSIM_001804 obo:MOLSIM_001803)

# Class: obo:MOLSIM_001805 (water-water interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001805 "An interaction energy summing the interactions of every water molecule with every other water molecule in a system. It measures how strongly the solvent holds itself together, separately from anything the solute does. Changes in it are how the cost of opening a cavity for a solute is seen. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001805 "water-water interaction energy"@en)
SubClassOf(obo:MOLSIM_001805 obo:MOLSIM_001803)

# Class: obo:MOLSIM_001806 (REMD round-trip time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001806 "The REMD round-trip time is a diagnostic metric that measures how long it takes for a single simulation copy to travel through the full range of temperatures in a Replica Exchange Molecular Dynamics simulation. In this method, multiple simulations are run at different temperatures, and this metric tracks the time for one replica to go from the lowest to the highest temperature and back again. A short round-trip time indicates that the simulation is sampling conformations efficiently, which is necessary to obtain reliable results."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001806 "REMD round-trip time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001806 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001806 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001806 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001806 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001807 (lifetime curve data)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001807 "Lifetime curve data is a graph that shows how long a specific molecular interaction, such as a hydrogen bond, typically lasts in a simulation. The curve usually plots the probability that an interaction, once formed, will still exist after a certain amount of time has passed. This data is generated by calculating the autocorrelation function of an interaction's existence over a trajectory, and fitting the curve provides a characteristic lifetime for that interaction."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001807 "lifetime curve data"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001807 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001807 obo:MOLSIM_001391)

# Class: obo:MOLSIM_001808 (running average)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001808 "An average taken over a window that moves along a series, giving one value for each position of the window. It removes short-term fluctuation so that a slower trend can be seen. The width of the window sets what counts as fluctuation and what counts as trend. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001808 "running average"@en)
SubClassOf(obo:MOLSIM_001808 obo:MOLSIM_001403)

# Class: obo:MOLSIM_001809 (root-mean-square inner product)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001809 "A measure of how far 2 sets of collective modes span the same motions, computed from the inner products between their eigenvectors. A value near 1 means the 2 sets describe the same motion, and a value near 0 means they do not. It is how the modes from 2 simulations, or from a simulation and an experiment, are compared. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001809 "root-mean-square inner product"@en)
SubClassOf(obo:MOLSIM_001809 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001809 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001809 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001810 (RMS average correlation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001810 "A single number summarising how strongly the parts of a molecule move together, computed as the root mean square of all the pairwise correlation values. It reduces a whole correlation matrix to 1 figure, so 2 simulations can be compared directly. It says how much correlated motion there is but not where. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001810 "RMS average correlation"@en)
SubClassOf(obo:MOLSIM_001810 obo:STATO_0000142)
SubClassOf(obo:MOLSIM_001810 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001810 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001811 (solute-solvent interaction energy density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001811 "A quantity giving the average interaction energy between a solute and the solvent at each point in the space around it, stored on a 3-dimensional grid. Negative regions mark positions where a solvent molecule is held, positive regions mark positions it avoids. It differs from a density map in reporting energy rather than how often solvent is found. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001811 "solute-solvent interaction energy density"@en)
SubClassOf(obo:MOLSIM_001811 obo:MOLSIM_001803)

# Class: obo:MOLSIM_001812 (solvent-solvent interaction energy density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001812 "A quantity giving, at each point of a 3-dimensional grid, the average interaction energy between solvent molecules there. Comparing it with the bulk value shows where a solute has disturbed the solvent's own structure. Regions where solvent holds itself together less well than in the bulk are where a ligand can most easily displace it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001812 "solvent-solvent interaction energy density"@en)
SubClassOf(obo:MOLSIM_001812 obo:MOLSIM_001803)

# Class: obo:MOLSIM_001813 (normalized PME solvent energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001813 "An energy giving the average electrostatic interaction of a single solvent molecule with all the other solvent molecules, obtained by dividing the total solvent-solvent energy by the number of solvent molecules. Normalising this way makes the value comparable between systems holding different amounts of solvent. Without it, a larger box simply reports a larger number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001813 "normalized PME solvent energy"@en)
SubClassOf(obo:MOLSIM_001813 obo:MOLSIM_001294)
SubClassOf(obo:MOLSIM_001813 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001813 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001814 (PME solvent energy density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001814 "A quantity giving the average electrostatic energy of the solvent at each point of a 3-dimensional grid, computed with particle mesh Ewald. It shows where the solvent is electrostatically stabilised and where it is strained. It differs from a solvent density map in reporting energy rather than how much solvent is present. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001814 "PME solvent energy density"@en)
SubClassOf(obo:MOLSIM_001814 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001815 (normalized water-water interaction energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001815 "An interaction energy giving the average interaction of a single water molecule with its neighbours, obtained by dividing the total water-water energy by the number of water molecules. Dividing this way makes systems containing different amounts of water comparable. A shift in it marks water that is more or less strongly bound than in the bulk. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001815 "normalized water-water interaction energy"@en)
SubClassOf(obo:MOLSIM_001815 obo:MOLSIM_001803)
SubClassOf(obo:MOLSIM_001815 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001815 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001816 (dipole moment density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001816 "A quantity giving the average direction and size of molecular dipoles at each point of a 3-dimensional grid. It shows how solvent molecules orient themselves around a solute, which a plain density map cannot. Regions where the dipoles all point the same way mark strong local electric fields. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001816 "dipole moment density"@en)
SubClassOf(obo:MOLSIM_001816 obo:MOLSIM_001375)

# Class: obo:MOLSIM_001817 (neighbor density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001817 "A measure of how crowded the surroundings of an atom or molecule are, given as the number of neighbours within a chosen distance. It is the simplest description of local packing. Comparing it with the bulk value shows where a structure is more or less tightly packed than usual. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001817 "neighbor density"@en)
SubClassOf(obo:MOLSIM_001817 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001818 (normalized neighbor count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001818 "A measure of how many molecules sit near a chosen point, divided by how many would be expected there if they were spread evenly. A value above 1 means molecules gather at that point and below 1 means they avoid it. Dividing out the expected number is what makes values at different distances comparable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001818 "normalized neighbor count"@en)
SubClassOf(obo:MOLSIM_001818 obo:MOLSIM_001348)
SubClassOf(obo:MOLSIM_001818 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001818 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001819 (tetrahedral order parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001819 "A measure of how closely the 4 nearest neighbours of a water molecule sit at the corners of a regular tetrahedron around it. Water in its ordinary hydrogen-bonded network is close to tetrahedral, and disruption shows as a fall in the value. It is how water near a surface or an ion is shown to be structured differently from bulk water. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001819 "tetrahedral order parameter"@en)
SubClassOf(obo:MOLSIM_001819 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001819 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001819 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001820 (normalized tetrahedral order parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001820 "A tetrahedral order parameter rescaled to run from −1/3 to 1, where 1 is a perfect tetrahedron and 0 is a random arrangement. The rescaling puts the value of random water at 0, so a number can be read directly as how much more ordered than random the arrangement is. It is the form usually reported. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001820 "normalized tetrahedral order parameter"@en)
SubClassOf(obo:MOLSIM_001820 obo:MOLSIM_001819)
SubClassOf(obo:MOLSIM_001820 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001820 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001821 (chemical shift restraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001821 "A chemical shift restraint simulation is a method where experimental Nuclear Magnetic Resonance (NMR) chemical shifts are used to guide a molecular dynamics simulation. An additional energy term is added that penalizes the simulation if the back-calculated chemical shifts from the trajectory do not agree with the experimental values. For experts, this method is a powerful tool for refining the accuracy of a structural ensemble to be consistent with experimental NMR data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001821 "chemical shift restraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001821 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001821 obo:MOLSIM_000364)

# Class: obo:MOLSIM_001822 (pseudocontact shift restraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001822 "A pseudocontact shift restraint simulation is a technique that uses a specific type of NMR data, known as pseudocontact shifts (PCS), to guide a simulation. PCS provide long-range distance and angular information relative to a paramagnetic metal center in the molecule. For structural biologists, using PCS restraints is a powerful method for determining the structure and dynamics of proteins and their complexes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001822 "pseudocontact shift restraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001822 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001822 obo:MOLSIM_000364)

# Class: obo:MOLSIM_001823 (direct dipolar coupling restraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001823 "A direct dipolar coupling restraint simulation is a method that incorporates experimental NMR data from residual dipolar couplings (RDCs) to guide a MD simulation. RDCs provide information about the orientation of chemical bonds relative to an external magnetic field."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001823 "direct dipolar coupling restraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001823 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001823 obo:MOLSIM_000364)

# Class: obo:MOLSIM_001824 (residual chemical shift anisotropy restraint simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001824 "A residual chemical shift anisotropy (RCSA) restraint simulation is a technique that uses NMR RCSA data to guide a MD simulation. RCSA provides information about the orientation of the chemical shift tensor for specific atoms, which is sensitive to local structure and dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001824 "residual chemical shift anisotropy restraint simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001824 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001824 obo:MOLSIM_000364)

# Class: obo:MOLSIM_001825 (book-keeping energy term)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001825 "A value printed in a simulation's energy output that tracks part of the algorithm rather than any physical interaction. Thermostats and barostats that add extra degrees of freedom to the system report these, so that a conserved total can still be checked. Adding such a value into a reported potential energy is a common and silent error. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001825 "book-keeping energy term"@en)
SubClassOf(obo:MOLSIM_001825 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001826 (solvent reaction field potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001826 "An electrostatic method that represents the solvent beyond a cutoff distance as a uniform medium that polarizes in response to the charges inside, rather than as individual molecules. The polarized medium pushes back with a field that is added to the direct interactions. It is much cheaper than Ewald summation and less accurate, particularly for a system carrying a net charge. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001826 "solvent reaction field potential"@en)
SubClassOf(obo:MOLSIM_001826 obo:MOLSIM_001294)

# Class: obo:MOLSIM_001827 (collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001827 "A collective variable is a simplified coordinate that helps describe a complex process in a simulation, such as the distance between two proteins as they bind. Instead of tracking thousands of atomic coordinates, a collective variable reduces the system's motion to one or a few key parameters that capture the essence of the event. These variables are frequently used in enhanced sampling methods to focus computational effort on exploring a specific conformational change or reaction pathway."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001827 "collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001827 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001827 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001828 (distance collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001828 "A distance collective variable is a simple coordinate that measures the separation between two specific atoms or groups of atoms. It is one of the most common variables used in simulations to track processes like a drug molecule unbinding from its target protein. Monitoring this distance provides a straightforward way to follow the progress of an association or dissociation event."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001828 "distance collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001828 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001828 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001829 (center of mass distance collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001829 "A center of mass distance collective variable measures the separation between the centers of mass of two groups of atoms, such as two entire proteins or a protein and a ligand. This provides a robust measure of the distance between whole molecular entities, averaging out the fast motions of individual atoms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001829 "center of mass distance collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001829 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001829 obo:MOLSIM_001828)

# Class: obo:MOLSIM_001830 (difference of center of mass distances collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001830 "This is a complex coordinate that tracks the difference between two separate center-of-mass distance measurements. It defines a reaction coordinate by calculating the absolute difference between two distinct COM distance measurements."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001830 "difference of center of mass distances collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001830 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001830 obo:MOLSIM_001828)

# Class: obo:MOLSIM_001831 (linear combination of distances collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001831 "A linear combination of distances is a mathematical expression used in molecular simulations to define a collective variable (CV). It sums or subtracts multiple specific atomic distances, each multiplied by a defined weight, creating a single reaction coordinate to track conformational changes like folding or chemical reactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001831 "linear combination of distances collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001831 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001831 obo:MOLSIM_001828)

# Class: obo:MOLSIM_001832 (angle collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001832 "An angle collective variable is a low-dimensional geometric descriptor that measures the angle formed by three specific atoms or groups of atoms during a simulation. This variable is used to monitor hinge-like motions, such as the opening and closing of domains in a protein."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001832 "angle collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001832 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001832 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001833 (center of mass angle collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001833 "A center of mass angle collective variable measures the angle formed by the centers of mass of three distinct groups of atoms. This is useful for describing the large-scale orientation of entire protein domains or molecules relative to one another, smoothing out the rapid fluctuations of individual atoms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001833 "center of mass angle collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001833 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001833 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001834 (torsion collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001834 "A torsion collective variable is a coordinate that tracks the value of a specific dihedral angle, which describes the rotation around a chemical bond. These variables are fundamental for describing the detailed three-dimensional shape of a flexible molecule. They are often used in enhanced sampling simulations to accelerate the rotation of protein side chains or to explore different backbone conformations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001834 "torsion collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001834 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001834 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001835 (center of mass torsion collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001835 "A center of mass torsion collective variable is a dihedral angle defined by the centers of mass of four distinct groups of atoms, rather than four single atoms. This allows for the description of torsional or twisting motions between large molecular domains or subunits."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001835 "center of mass torsion collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001835 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001835 obo:MOLSIM_001834)

# Class: obo:MOLSIM_001836 (sum of cosines of dihedrals collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001836 "This is a collective variable created by summing the cosine values of several different dihedral angles within a molecule. This mathematical combination creates a smooth, continuous variable that describes the collective rotational state of multiple bonds at once. It is often used in enhanced sampling methods to create a simplified coordinate that captures a complex, multi-dimensional conformational change."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001836 "sum of cosines of dihedrals collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001836 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001836 obo:MOLSIM_001834)

# Class: obo:MOLSIM_001837 (sum of sines of dihedrals collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001837 "This is a collective variable created by summing the sine values of several different dihedral angles within a molecule. This mathematical combination creates a smooth, continuous variable that describes the collective rotational state of multiple bonds at once. It is often used in enhanced sampling methods to create a simplified coordinate that captures a complex, multi-dimensional conformational change."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001837 "sum of sines of dihedrals collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001837 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001837 obo:MOLSIM_001834)

# Class: obo:MOLSIM_001838 (paired dihedral collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001838 "A paired dihedral collective variable is a coordinate that combines two different dihedral angles, often the phi and psi backbone angles of a protein, into a single analysis. This is most commonly used to generate a two-dimensional free energy map, known as a Ramachandran plot, which reveals the energetically allowed conformations of the protein backbone. This analysis is fundamental for understanding protein structure and flexibility."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001838 "paired dihedral collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001838 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001838 obo:MOLSIM_001834)

# Class: obo:MOLSIM_001839 (pattern dihedral collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001839 "A pattern dihedral is a specialized Collective Variable (CV) used in MD to track the conformational transitions of a molecular system, such as protein folding or crystal polymorphs. It measures a weighted linear combination of multiple specific dihedral angles to act as a low-dimensional structural parameter, often replacing a complex set of atomic coordinates."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001839 "pattern dihedral collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001839 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001839 obo:MOLSIM_001834)

# Class: obo:MOLSIM_001840 (radius of gyration collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001840 "The radius of gyration is a collective variable that measures the overall compactness of a molecule or a group of atoms. It quantifies how spread out the atoms are from the molecule's center of mass, with a smaller value indicating a more compact shape. This variable is commonly used as a simple metric to monitor large-scale conformational changes, such as the process of a protein folding into its native structure or unfolding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001840 "radius of gyration collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001840 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001840 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001841 (multi-RMSD collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001841 "A multi-RMSD collective variable is a coordinate that simultaneously measures a molecule's structural similarity to several different reference structures. This is useful for tracking a molecule's transitions between multiple known functional states, such as an active, inactive, and an intermediate conformation. By monitoring which reference structure the molecule is closest to, this variable can map out the complex conformational landscape connecting different states."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001841 "multi-RMSD collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001841 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001841 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001842 (number of bonds collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001842 "A number of bonds collective variable is a coordinate that counts the number of specific chemical bonds that exist at any given moment in a simulation. This variable is only meaningful when using a reactive force field that allows chemical bonds to form and break. It serves as a simple and direct way to track the progress of a chemical reaction by monitoring the creation or destruction of key covalent bonds."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001842 "number of bonds collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001842 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001842 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001843 (handedness collective variable)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001843 "A handedness collective variable is a mathematical measure that quantifies the chirality, or \"handedness,\" of a molecular structure, such as the left-handed versus right-handed twist of a helix. This variable provides a continuous value that can track a molecule's transition between different chiral states during a simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001843 "handedness collective variable"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001843 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001843 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001844 (structure factor)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001844 "A complex quantity describing how strongly and with what phase a crystal scatters a wave in a given direction, summed over the atoms in its repeating unit. Its magnitude is what a diffraction experiment measures; its phase is not, which is the central difficulty of crystallography. The electron density follows from both by Fourier transform. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001844 "structure factor"@en)
SubClassOf(obo:MOLSIM_001844 obo:MOLSIM_001800)

# Class: obo:MOLSIM_001845 (hardware)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001845 "The physical components of a computer system on which software runs: processors, memory, storage and the networks between machines. It is recorded alongside a simulation because how long the work took, and sometimes whether it is bit-for-bit reproducible, depends on it. The scientific result should not depend on it, and a difference between machines is a sign of a problem. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001845 "hardware"@en)

# Class: obo:MOLSIM_001846 (van der Waals radius)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001846 "A parameter giving the effective size of an atom, as the distance at which another atom begins to be repelled strongly. It is the radius of the hard sphere that best represents where Pauli repulsion overtakes the weak attraction between 2 non-bonded atoms. These radii set the molecular surface used in solvation models and in most measures of packing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001846 "van der Waals radius"@en)
SubClassOf(obo:MOLSIM_001846 obo:MOLSIM_000272)

# Class: obo:MOLSIM_001847 (Larmor frequency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001847 "The Larmor frequency is the specific rate at which a magnetic particle, like an atomic nucleus, wobbles or \"precesses\" when placed in a strong external magnetic field. This is analogous to the way a spinning top wobbles in the Earth's gravitational field. This frequency is the fundamental principle behind all Nuclear Magnetic Resonance (NMR) experiments, as it determines the exact frequency of energy the nucleus will absorb."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001847 "Larmor frequency"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001847 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001847 obo:MOLSIM_001800)
SubClassOf(obo:MOLSIM_001847 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000105))
SubClassOf(obo:MOLSIM_001847 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001848 (QM/MM switching function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001848 "A function that varies smoothly between 0 and 1 across a shell of space, used to blend an atom's quantum and classical descriptions as it crosses the boundary. Blending removes the jump in energy that an abrupt reassignment would cause. The width of the shell trades smoothness against how many atoms are in a mixed state at once. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001848 "QM/MM switching function"@en)
SubClassOf(obo:MOLSIM_001848 obo:MOLSIM_001463)

# Class: obo:MOLSIM_001849 (convergence analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001849 "A data analysis method that tests whether a simulation has run long enough for the quantity of interest to stop drifting. It follows a chosen property, such as total energy or a structural measure, and checks whether its running average settles over the later part of the trajectory. Without it, a reported average may reflect only the part of the trajectory that happened to be sampled. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001849 "convergence analysis"@en)
SubClassOf(obo:MOLSIM_001849 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001850 (modeling and setup tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001850 "A modeling and setup tool is a type of software used to construct and prepare a molecular system before a simulation is run. This involves tasks like building a molecule from scratch, repairing a structure from an experimental database, or surrounding a protein with water molecules to mimic its natural environment. For an expert, these tools are essential for creating a chemically correct and physically stable starting point, which is a prerequisite for any meaningful simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001850 "modeling and setup tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001850 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001850 obo:MOLSIM_000158)

# Class: obo:MOLSIM_001851 (simulation engine)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001851 "A software program that performs a simulation itself, computing the forces on every atom and advancing their positions step by step. It takes a prepared system and a set of parameters and produces a trajectory. Everything else in a simulation workflow either prepares its input or analyses its output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001851 "simulation engine"@en)
SubClassOf(obo:MOLSIM_001851 obo:MOLSIM_000158)

# Class: obo:MOLSIM_001852 (essential dynamics analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001852 "A dynamics analysis method that reduces the motion in a trajectory to the few collective movements that account for most of the total fluctuation, using principal component analysis. The largest components are usually functionally meaningful, such as hinge bending between domains, while the smallest are thermal noise. It lets a trajectory of thousands of coordinates be discussed in terms of 2 or 3 motions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001852 "essential dynamics analysis"@en)
SubClassOf(obo:MOLSIM_001852 obo:MOLSIM_000939)

# Class: obo:MOLSIM_001853 (correlation matrix)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001853 "A matrix whose entry at row i and column j gives the correlation between the fluctuations of quantities i and j. In trajectory analysis the quantities are usually the displacements of atoms or residues, so the matrix says which parts of the molecule move together. It is the input from which correlated motion and network analyses are computed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001853 "correlation matrix"@en)
SubClassOf(obo:MOLSIM_001853 obo:MOLSIM_001403)

# Class: obo:MOLSIM_001854 (flexibility analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001854 "A structural analysis method that identifies which parts of a molecule are rigid and which move, usually by computing the root-mean-square fluctuation of each atom or residue about its average position. The result separates a stable core from mobile loops and termini. It is also what simulated values are compared against experimental B-factors with. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001854 "flexibility analysis"@en)
SubClassOf(obo:MOLSIM_001854 obo:MOLSIM_000917)

# Class: obo:MOLSIM_001855 (contact map)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001855 "A contact map is a simplified 2D picture that shows which parts of a molecule are touching other parts of itself or other molecules. Contact maps provide a representation of molecular interactions or a protein foldings."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001855 "contact map"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001855 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001855 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001856 (native contact map)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001856 "A contact map recording which pairs of atoms or residues are in contact in a reference folded structure. It is built once from an experimental structure and then used as the benchmark a simulated conformation is scored against. The fraction of its contacts that a conformation reproduces is the usual measure of how folded that conformation is. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001856 "native contact map"@en)
SubClassOf(obo:MOLSIM_001856 obo:MOLSIM_001855)

# Class: obo:MOLSIM_001857 (non native contact map)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001857 "A non-native contact map is a contact map that shows the atomic touches in a misfolded or unfolded protein structure that are not present in its correct, functional shape. It is used to identify incorrect or transient interactions that may form during a simulation, especially in the study of protein folding pathways or misfolded states. Analyzing non-native contacts is crucial for understanding the formation of misfolded intermediates and kinetic traps on the folding landscape. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001857 "non native contact map"@en)
SubClassOf(obo:MOLSIM_001857 obo:MOLSIM_001855)

# Class: obo:MOLSIM_001858 (hydrophobic patch)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001858 "Hydrophobic patches are clusters of non-polar, \"water-fearing\" atoms or amino acid side-chains that are exposed on the surface of a larger molecule, such as a protein. Because water molecules are highly polar, they are repelled by these non-polar regions and instead cluster together to interact with themselves."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001858 "hydrophobic patches"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001858 "hydrophobic patch"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001858 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001858 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001859 (network analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001859 "A data analysis method that represents a molecule as a graph, with atoms or residues as nodes and interactions or correlations as edges, and then applies graph theory to it. It finds residues that act as hubs and traces paths of correlated motion between distant sites. It is the usual way to reason about allosteric communication and about the reach of a mutation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001859 "network analysis"@en)
SubClassOf(obo:MOLSIM_001859 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001860 (pocket analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001860 "A structural analysis method that finds cavities on or inside a molecule and measures their size, shape and how they change over time. A cavity that appears only briefly cannot be seen in a single experimental structure. Finding such transient cavities is one of the things simulation adds to a static structure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001860 "pocket analysis"@en)
SubClassOf(obo:MOLSIM_001860 obo:MOLSIM_000917)

# Class: obo:MOLSIM_001861 (ligand analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001861 "An analysis method that examines the behaviour of a small molecule bound to a larger one during a simulation. It covers how the ligand moves within its site, which contacts it makes and keeps, and whether it stays bound at all. It treats the ligand as the subject rather than as part of the system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001861 "ligand analysis"@en)
SubClassOf(obo:MOLSIM_001861 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001862 (computing system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001862 "The complete set of hardware on which a simulation runs, from a single workstation to a large cluster. It is recorded because how long a simulation took, and sometimes whether it is exactly reproducible, depends on it. Results should not depend on it, and a difference between machines is a sign that something is wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001862 "computing system"@en)
SubClassOf(obo:MOLSIM_001862 obo:MOLSIM_001845)

# Class: obo:MOLSIM_001863 (ligand cavity analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001863 "An analysis method that characterises the pocket a ligand occupies, measuring its volume, shape and how that changes as the simulation proceeds. A pocket that opens and closes during a run cannot be judged from the single structure a crystal gives. It is how a binding site is shown to be druggable or transient. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001863 "ligand cavity analysis"@en)
SubClassOf(obo:MOLSIM_001863 obo:MOLSIM_000984)
SubClassOf(obo:MOLSIM_001863 obo:MOLSIM_001860)

# Class: obo:MOLSIM_001864 (residence time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001864 "Residence time is the average amount of time that a molecule, such as a water molecule or a ligand, spends in a specific, defined location, like a protein's binding site. It is calculated from a simulation by monitoring when a molecule enters a region and when it leaves, and then averaging this duration over many such events."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001864 "residence times"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001864 "residence time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001864 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001864 obo:MOLSIM_001391)
SubClassOf(obo:MOLSIM_001864 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_001864 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001865 (pLDDT)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001865 "A confidence score produced by a structure prediction model for each residue, estimating how accurately that residue's position has been placed, on a scale from 0 to 100. It reports the model's confidence, not the accuracy of the structure, so a confident prediction can still be wrong. Regions scoring low are often genuinely disordered rather than badly predicted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001865 "pLDDT"@en)
SubClassOf(obo:MOLSIM_001865 obo:MOLSIM_001403)
SubClassOf(obo:MOLSIM_001865 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001865 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001866 (backbone DH fluctuation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001866 "Backbone DH fluctuations are a measure of how much the backbone of a protein wiggles and changes shape during a simulation. It specifically quantifies the fluctuations in the dihedral angles (DH) of the protein's backbone, which describe the rotations around the chemical bonds that connect the amino acids. Analyzing these fluctuations provides a detailed picture of the protein's flexibility and dynamics that is independent of its overall tumbling motion."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001866 "backbone DH fluctuations"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001866 "backbone DH fluctuation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001866 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001866 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001867 (membrane analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001867 "Membrane analysis is a category of analysis methods specifically focused on characterizing the properties of lipid bilayer simulations. These methods are used to quantify the structural and dynamic behavior of the membrane itself and its interactions with other molecules, like embedded proteins. This includes calculating key properties such as the area per lipid, membrane thickness, and lipid order parameters to validate the simulation and understand membrane function."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001867 "membrane analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001867 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001867 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001868 (area per lipid)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001868 "The area per lipid is a fundamental biophysical metric representing the average cross-sectional surface area occupied by a single lipid molecule within a lipid bilayer. It is calculated by dividing the total area of the simulation box in the membrane plane by the number of lipids in one leaflet."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001868 "area per lipid"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001868 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001868 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001869 (lipid contact analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001869 "Lipid contact analysis is an analysis method used to identify and quantify the interactions between lipid molecules and a protein embedded in the membrane. The analysis tracks which specific lipid molecules are in close contact with the protein over the course of a simulation. This method may be used for identifying potential \"hotspot\" lipid binding sites on a membrane protein and understanding the composition of the annular lipid shell."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001869 "lipid contact analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001869 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001869 obo:MOLSIM_001867)

# Class: obo:MOLSIM_001870 (lipid density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001870 "Lipid density is a measure of how tightly packed the lipid molecules are in a simulated cell membrane. It is typically calculated as a one-dimensional profile along the axis perpendicular to the membrane plane, showing the mass or electron density of different lipid components like headgroups and tails. Analyzing the lipid density profile is a fundamental check to ensure the simulated membrane has the correct structure and thickness, and it reveals how an embedded protein might locally perturb the lipid packing."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001870 "lipid density"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001870 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001870 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001870 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000052))
SubClassOf(obo:MOLSIM_001870 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001871 (lipid distribution analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001871 "Lipid distribution refers to the spatial arrangement and composition of different types of lipid molecules within a simulated membrane. In a mixed bilayer, lipids are often not randomly distributed but can form distinct domains or clusters, and some lipids may preferentially accumulate around an embedded protein. Analyzing this distribution is crucial for understanding membrane organization and the specific lipid environment required for a membrane protein's function."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001871 "lipid distribution analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001871 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001871 obo:MOLSIM_000984)

# Class: obo:MOLSIM_001872 (lipid order parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001872 "Lipid order parameters are a set of values that measure how well-aligned and ordered the flexible tails of lipid molecules are within a simulated cell membrane. A value of 1 means the lipid tail is perfectly straight and aligned perpendicular to the membrane surface, while a value of 0 means it is completely disordered. These parameters, specifically the deuterium order parameter (SCD), can be directly compared with experimental results from NMR spectroscopy, making them one of the most important metrics for validating the physical accuracy of a membrane simulation."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001872 "lipid order parameters"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001872 "lipid order parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001872 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001872 obo:MOLSIM_001398)
SubClassOf(obo:MOLSIM_001872 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000186))
SubClassOf(obo:MOLSIM_001872 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001873 (membrane geometry)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001873 "Membrane geometry describes the overall three-dimensional shape and dimensions of a simulated cell membrane. This includes properties like the membrane's thickness, its lateral dimensions in the simulation box, and its overall shape, which can be planar, curved, or even vesicular. Characterizing the membrane geometry is a fundamental part of analyzing membrane simulations, ensuring the system is stable and providing the context for the behavior of embedded proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001873 "membrane geometry"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001873 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001873 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001874 (membrane curvature)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001874 "Membrane curvature is a measure of how much a simulated cell membrane is bent or curved. This property is calculated by fitting the positions of the lipid headgroups to a mathematical surface and then determining the local or average curvature of that surface. Analyzing membrane curvature is essential for studying processes like vesicle formation, membrane fusion, and the influence of proteins that induce or sense bending in the lipid bilayer."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001874 "membrane curvature"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001874 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001874 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001875 (membrane width)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001875 "The membrane width is the thickness of a simulated cell membrane, measured from one side to the other, along the z-axis. It is typically defined as the distance between the peaks in the density profile of the lipid headgroups or phosphate atoms on opposite sides of the bilayer. The membrane width is a key structural parameter that is monitored to confirm a simulation is properly equilibrated and is used to understand how membrane proteins match their hydrophobic length to the surrounding lipid environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001875 "membrane width"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001875 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001875 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001875 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001875 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001876 (pore dimension)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001876 "The pore dimension refers to the size and shape of a channel or tunnel that passes through a protein. This property is calculated by finding the radius of the narrowest point (the constriction site) and the overall profile of the channel's radius along its length. Analyzing the pore dimensions is critical for understanding how ion channels and transporters function, as it determines which molecules are small enough to pass through the membrane."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001876 "pore dimension"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001876 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001876 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001876 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001876 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001877 (DNA-bendability)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001877 "DNA bendability is the intrinsic mechanical property that describes how easily a DNA double helix can deviate from its ideal straight conformation by adopting a bent or curved structure. This property depends on the nucleotide sequence, with some sequences being inherently more flexible than others. Sequence-dependent bendability plays a key role in DNA packaging, nucleosome formation, and protein-DNA recognition, as many proteins induce or stabilize DNA bending upon binding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001877 "DNA-bendability"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001877 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001877 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001877 obo:MOLSIM_001391)

# Class: obo:MOLSIM_001878 (base breathing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001878 "Base breathing refers to a specific and transient opening of one or more base pairs in a DNA or RNA double helix due to the temporary disruption of hydrogen bonds. During these events, the bases become transiently exposed to the surrounding solvent and more accessible without necessarily becoming fully unstacked from the helix. When this opening occurs at the ends of the duplex, it is commonly referred to as terminal fraying. These spontaneous opening events are a natural part of the helix's dynamics and are thought to be important for allowing proteins to access the genetic information encoded in the bases. Analyzing the frequency and duration of these motions provides insight into the local stability and accessibility of the DNA or RNA structure."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001878 "base breathing"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001878 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001878 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001878 obo:MOLSIM_001793)

# Class: obo:MOLSIM_001879 (helical parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001879 "A helical parameter is one of a set of measurements that describe the detailed 3D shape of a DNA or RNA double helix. These parameters quantify the relative position and orientation of adjacent base pairs, including values for twist, roll, slide, and rise, which define the local helical geometry. Calculating these parameters from a simulation trajectory is the standard method for characterizing the sequence-dependent structure of nucleic acids and for distinguishing between different helical forms like A-DNA and B-DNA."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001879 "helical parameter"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001879 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001879 obo:MOLSIM_001358)

# Class: obo:MOLSIM_001880 (inter-BP correlation analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001880 "Inter-base pair (Inter-BP) correlation analysis refers to the statistical coupling between the structural parameters of neighboring DNA base pairs or base-pair steps. It quantifies how variations in one helical parameter (e.g., roll, twist, or slide) are associated with changes in the same or different parameters at adjacent base pairs. These correlations reveal sequence-dependent structural coupling and cooperative conformational behavior within the DNA double helix, providing insight into its flexibility, mechanics, and recognition by DNA-bining proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001880 "inter-BP correlation analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001880 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001880 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001880 obo:MOLSIM_000342)

# Class: obo:MOLSIM_001881 (nucleic acid backbone flexibility)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001881 "Nucleic acid backbone flexibility is a measure of the ability of the sugar-phosphate backbone of DNA or RNA to adopt different conformations through rotations about its backbone torsion angles. It is commonly characterized by analyzing the distributions and fluctuations during a simulation of the backbone dihedral angles (α, β, γ, δ, ε, ζ), the glycosidic angle (χ), and the sugar pucker. Backbone flexibility plays a fundamental role in determining the structural dynamics, mechanical properties, and biological functions of nucleic acids, influencing DNA bending and packaging as well as RNA folding and molecular recognition."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001881 "nucleic acid backbone flexibility"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001881 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001881 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_001881 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001882 (nucleosome wrapping)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001882 "Nucleosome wrapping describes the way a long DNA molecule is spooled around a histone protein octamer, forming the fundamental repeating unit of chromatin. Studying nucleosome wrapping is essential for understanding how DNA is compacted and how access to the genetic code is regulated for gene expression."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001882 "nucleosome wrapping"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001882 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001882 obo:MOLSIM_001333)

# Class: obo:MOLSIM_001883 (stiffness)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001883 "A property giving how strongly a structure resists being deformed by an applied force. For a single bond or angle it is set by the force constant in the force field; for a whole molecule or assembly it emerges from the network of interactions. It is the inverse of flexibility and is measured in force per unit displacement. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001883 "stiffness"@en)
SubClassOf(obo:MOLSIM_001883 obo:MOLSIM_001800)

# Class: obo:MOLSIM_001884 (concerted motions analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001884 "A dynamics analysis method that identifies groups of atoms whose movements are correlated, so that they travel together as a unit rather than fluctuating independently. It picks out large-scale events such as a protein domain shifting or twisting as a whole. Those events are usually the ones that matter for function, such as an active site opening and closing. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001884 "concerted motions analysis"@en)
SubClassOf(obo:MOLSIM_001884 obo:MOLSIM_000342)

# Class: obo:MOLSIM_001885 (trajectory meta analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001885 "Trajectory meta-analysis refers to a higher level of analysis that involves comparing, contrasting, or combining the results from multiple, independent simulation trajectories. This can be used to improve statistical certainty, assess the convergence of a simulation, or identify the differences in dynamics between a wild-type protein and a mutant. This approach is essential for drawing robust conclusions that are not dependent on a single simulation run."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001885 "trajectory meta analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001885 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001885 obo:MOLSIM_000004)

# Class: obo:MOLSIM_001886 (trajectory comparison)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001886 "Trajectory comparison is a specific type of meta-analysis where two or more simulation trajectories are quantitatively compared to identify similarities and differences in their conformational sampling. This is often done by calculating metrics that measure the overlap of the conformational ensembles or by projecting the trajectories onto a common free energy landscape. This method is used to rigorously assess the impact of a mutation or ligand binding on a protein's dynamics."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001886 "trajectory comparison"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001886 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001886 obo:MOLSIM_001885)

# Class: obo:MOLSIM_001887 (molecular simulation system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001887 "A molecular simulation system is the complete collection of all the molecules included in a computational model for a simulation. This includes the main molecule of interest, such as a protein, as well as all the surrounding solvent molecules, ions, and any other components."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001887 "molecular simulation system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001887 orcid:0000-0002-2294-5393)

# Class: obo:MOLSIM_001888 (carbohydrate system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001888 "A carbohydrate system is a type of molecular simulation system where the primary molecules being studied are carbohydrates. This can range from a single sugar molecule in water to a complex polysaccharide or the glycan portion of a glycoprotein. These systems require specialized force fields and analysis techniques to accurately model the unique stereochemistry and flexibility of glycosidic linkages."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001888 "carbohydrate system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001888 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001888 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001889 (complex system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001889 "A complex system in this context refers to a molecular simulation system that contains two or more interacting macromolecules, or a macromolecule interacting with a smaller molecule like a drug. The primary focus of simulating such a system is to study the interactions, binding, and functional consequences of the molecules coming together."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001889 "complex system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001889 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001889 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001890 (ligand complex system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001890 "A ligand complex system is a type of complex system where the focus is on the interaction between a large macromolecule, such as a protein or DNA, and a smaller molecule, known as a ligand. These simulations are central to the field of drug discovery, where the goal is to understand how a potential drug molecule binds to its biological target."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001890 "ligand complex system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001890 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001890 obo:MOLSIM_001889)

# Class: obo:MOLSIM_001891 (DNA-ligand system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001891 "A DNA-ligand system is a type of molecular simulation system where the primary molecules being studied are DNA molecules interacting with small molecule ligands. These simulations are used to study how drugs or other small molecules bind to DNA, which can be a mechanism for anti-cancer or anti-viral therapies. These systems are important for understanding intercalation, groove binding, and the structural changes induced in DNA upon ligand binding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001891 "DNA-ligand system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001891 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001891 obo:MOLSIM_001890)

# Class: obo:MOLSIM_001892 (RNA-ligand system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001892 "An RNA-ligand system is a type of molecular simulation system where the primary molecules being studied are RNA molecules interacting with small molecule ligands. With the growing recognition of RNA as a major drug target, these simulations are becoming increasingly important for discovering and designing new therapeutics. These systems are challenging due to the high flexibility of RNA and the often subtle nature of the binding interactions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001892 "RNA-ligand system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001892 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001892 obo:MOLSIM_001890)

# Class: obo:MOLSIM_001893 (protein-ligand system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001893 "A molecular system consisting of a protein bound to a small molecule. It is the most commonly simulated kind of complex, because it is what drug binding is. What is usually studied is how tightly the 2 bind and which contacts hold them together. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001893 "protein-ligand system"@en)
SubClassOf(obo:MOLSIM_001893 obo:MOLSIM_001890)

# Class: obo:MOLSIM_001894 (hybrid complex system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001894 "A hybrid complex system is a type of complex system composed of macromolecules from different biological classes. This most commonly refers to a complex formed between a protein and a nucleic acid, such as a transcription factor bound to DNA. Simulating these systems is essential for understanding many fundamental biological processes like gene regulation and DNA repair."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001894 "hybrid complex system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001894 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001894 obo:MOLSIM_001889)

# Class: obo:MOLSIM_001895 (nucleic acid complex system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001895 "A nucleic acid complex system is a type of molecular simulation system where the primary molecules being studied are two or more nucleic acid molecules. This can include a standard DNA double helix, an RNA duplex, or more complex structures like DNA-RNA hybrids or multi-stranded RNA junctions. These simulations are crucial for understanding the structure and stability of the genetic material and functional RNA molecules."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001895 "nucleic acid complex system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001895 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001895 obo:MOLSIM_001889)

# Class: obo:MOLSIM_001896 (DNA-DNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001896 "A DNA-DNA system is a type of molecular simulation system where the primary molecules being studied are two or more interacting strands of DNA. The most common example is the simulation of a DNA double helix to study its sequence-dependent structure and dynamics. These systems are also used to study more complex assemblies like DNA quadruplexes or Holliday junctions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001896 "DNA-DNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001896 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001896 obo:MOLSIM_001895)

# Class: obo:MOLSIM_001897 (DNA-RNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001897 "A DNA-RNA system is a type of molecular simulation system where the primary molecules being studied are one ore more DNA strands interacting with one or more RNA strands. Such hybrid helices are important biological intermediates that occur during processes like transcription and reverse transcription. Simulating these systems is important for understanding the structural basis of these fundamental genetic processes."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001897 "DNA-RNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001897 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001897 obo:MOLSIM_001895)

# Class: obo:MOLSIM_001898 (RNA-RNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001898 "An RNA-RNA system is a type of molecular simulation system where the primary molecules being studied are two or more interacting RNA strands. This includes RNA duplexes, which are common in viral genomes and regulatory RNAs, as well as the vast and complex RNA assemblies that form the ribosome. Simulating these systems is critical for understanding the structural basis of RNA function and catalysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001898 "RNA-RNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001898 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001898 obo:MOLSIM_001895)

# Class: obo:MOLSIM_001899 (protein complex system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001899 "A molecular system in which a protein is bound to another macromolecule, either a second protein or a nucleic acid. Such a system is simulated to study how the 2 recognise each other and what holds them together. The interface between them is usually what the study is about. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001899 "protein complex system"@en)
SubClassOf(obo:MOLSIM_001899 obo:MOLSIM_001889)

# Class: obo:MOLSIM_001900 (protein-DNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001900 "A protein-DNA system is a type of molecular simulation system where the primary molecules being studied are proteins interacting with DNA molecules. These systems are fundamental to nearly all aspects of genetics, including DNA replication, repair, and the regulation of gene expression by transcription factors. Simulating these complexes is crucial for understanding the molecular basis of how proteins read and manipulate the genetic code."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001900 "protein-DNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001900 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001900 obo:MOLSIM_001899)

# Class: obo:MOLSIM_001901 (protein-RNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001901 "A protein-RNA system is a type of molecular simulation system where the primary molecules being studied are proteins interacting with RNA molecules. These complexes, known as ribonucleoproteins, are central to a vast range of cellular processes, including protein synthesis by the ribosome and RNA splicing. Simulating these systems is essential for understanding the intricate interplay between proteins and RNA that governs much of cell biology."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001901 "protein-RNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001901 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001901 obo:MOLSIM_001899)

# Class: obo:MOLSIM_001902 (protein-protein system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001902 "A protein complex system made up of 2 or more proteins bound to each other. Such pairings carry most cellular signalling and hold most large cellular structures together. What is usually studied is the interface: which residues touch, and how tightly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001902 "protein-protein system"@en)
SubClassOf(obo:MOLSIM_001902 obo:MOLSIM_001899)

# Class: obo:MOLSIM_001903 (ion system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001903 "A molecular system whose subject is the behaviour of ions, usually dissolved in water. Such systems are simulated to test how well a force field reproduces measured hydration free energies, activity coefficients and ion pairing. Getting ions right is a precondition for trusting any simulation of a charged biomolecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001903 "ion system"@en)
SubClassOf(obo:MOLSIM_001903 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001904 (lipid system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001904 "A lipid system is a type of molecular simulation system where the primary molecule being studied are lipids, usually arranged as a bilayer in water. These simulations are used to study the fundamental physical properties of biological membranes, such as their phase behavior, fluidity, and permeability."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001904 "lipid system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001904 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001904 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001905 (nucleic acid system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001905 "A nucleic acid system is a type of molecular simulation system where the primary molecules being studied are nucleic acids, such as a DNA duplex or a folded RNA. These simulations are typically performed to study the intrinsic structure, flexibility, and conformational dynamics of the nucleic acid."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001905 "nucleic acid system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001905 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001905 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001906 (DNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001906 "A DNA system is a type of molecular simulation system where the primary molecules being studied are DNA. This most often involves the simulation of a DNA double helix to investigate its sequence-dependent structure, flexibility, and dynamics. These simulations are used to understand properties like DNA bending and the transitions between different helical forms like A- and B-DNA."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001906 "DNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001906 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001906 obo:MOLSIM_001905)

# Class: obo:MOLSIM_001907 (RNA system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001907 "An RNA system is a type of molecular simulation system where the primary molecules being studied are RNA. Unlike DNA, RNA molecules often fold into complex and specific three-dimensional structures to perform their biological functions. Simulating these systems is crucial for understanding the principles of RNA folding and the structural basis of RNA catalysis."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001907 "RNA system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001907 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001907 obo:MOLSIM_001905)

# Class: obo:MOLSIM_001908 (protein system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001908 "A protein system is a type of molecular simulation system where the primary molecules being studied are proteins. These simulations are typically run to study its structural stability, intrinsic flexibility, and conformational changes. This is the most common type of simulation, fundamental to understanding how a protein's structure relates to its function."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001908 "protein system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001908 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001908 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001909 (intrinsically disordered protein system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001909 "An Intrinsically Disordered Protein (IDP) system refers to proteins or regions of proteins that lack a fixed, stable three-dimensional structure under physiological conditions. Instead of adopting a single rigid shape, they exist as dynamic ensembles of interconverting structures that drive vital cellular functions."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001909 "IDP system"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001909 "intrinsically disordered protein system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001909 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001909 obo:MOLSIM_001908)

# Class: obo:MOLSIM_001910 (membrane protein system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001910 "A membrane protein system is a specific type of protein system where the protein is embedded within a lipid bilayer, mimicking its native environment in a cell membrane. These are among the most complex and computationally demanding types of simulations to set up and run. For experts, these simulations are essential for understanding the function of proteins that act as channels, transporters, and receptors in the cell."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001910 "membrane protein system"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001910 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001910 obo:MOLSIM_001908)

# Class: obo:MOLSIM_001911 (small molecule system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001911 "A molecular system whose subject is one or more small organic molecules rather than a macromolecule. Such systems are simulated to obtain properties like solubility or partitioning, and to test force field parameters before they are used on anything larger. They are small enough that long simulations and many repeats are affordable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001911 "small molecule system"@en)
SubClassOf(obo:MOLSIM_001911 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001912 (water system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001912 "A molecular system containing water and nothing else. It is simulated to test how well a water model reproduces measured properties such as density, diffusion coefficient, dielectric constant and the temperature of maximum density. No water model reproduces all of them at once, so the choice depends on which matter for the intended study. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001912 "water system"@en)
SubClassOf(obo:MOLSIM_001912 obo:MOLSIM_001887)

# Class: obo:MOLSIM_001913 (simulation model resolution)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001913 "A property of a simulation model giving how much detail is kept when the real system is represented, from every atom down to whole domains as single sites. It is the first choice made when a model is built, because it fixes both what the model can show and what it costs. The levels below it are the named steps on that scale. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001913 "simulation model resolution"@en)
SubClassOf(obo:MOLSIM_001913 obo:MOLSIM_000006)

# Class: obo:MOLSIM_001914 (all atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001914 "All-atom is a simulation model resolution where every atom in the system, including all hydrogen atoms, is represented as an individual particle with its own parameters. This provides the highest level of structural detail and is the standard for most high-resolution biomolecular simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001914 "all atom"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001914 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001914 obo:MOLSIM_001913)

# Class: obo:MOLSIM_001915 (coarse grained)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001915 "A simulation model resolution in which several atoms are represented by 1 interaction site. Cutting the particle count and smoothing the energy landscape allows both larger systems and a longer timestep, so far longer times become reachable. Nothing smaller than a site can be observed in such a model. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001915 "coarse grained"@en)
SubClassOf(obo:MOLSIM_001915 obo:MOLSIM_001913)

# Class: obo:MOLSIM_001916 (mesoscopic)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001916 "A simulation model resolution in which whole proteins, or long segments of a polymer, are each represented by a single site. It is the coarsest level at which particles are still tracked individually, above which a continuum description is used instead. It is used for assembly and phase behaviour, where molecular detail does not affect the result. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001916 "mesoscopic"@en)
SubClassOf(obo:MOLSIM_001916 obo:MOLSIM_001913)

# Class: obo:MOLSIM_001917 (united-atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001917 "A simulation model resolution in which non-polar hydrogens are merged into the heavy atom they are bonded to, while all other atoms are kept. It removes roughly half the particles in an organic system at almost no cost in accuracy, because those hydrogens carry little charge. It sits between all-atom and coarse-grained resolution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001917 "united-atom"@en)
SubClassOf(obo:MOLSIM_001917 obo:MOLSIM_001913)

# Class: obo:MOLSIM_001918 (MDAnalysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001918 "MDAnalysis is an open-source Python library used for the analysis of molecular dynamics simulation trajectories. It provides a flexible and object-oriented framework that allows users to read, write, and manipulate atomic coordinate data from a wide variety of simulation packages. MDAnalysis is a powerful tool for writing custom, complex, and reproducible analysis scripts in a familiar Python environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001918 "MDAnalysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001918 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001918 obo:MOLSIM_000251)
SubClassOf(obo:MOLSIM_001918 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001919 (MDTraj)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001919 "MDTraj is a modern, open-source Python library designed for the fast and efficient analysis of molecular dynamics trajectories. It excels at reading and writing a very broad range of trajectory and topology file formats, making it highly interoperable. MDTraj provides a fast and powerful toolkit for performing common structural and time-series analyses on simulation data."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001919 "MDTraj"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001919 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001919 obo:MOLSIM_000251)
SubClassOf(obo:MOLSIM_001919 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001920 (ProDy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001920 "A Python library for analysing protein structural dynamics, covering structure file parsing, conformational ensemble analysis and the calculation of collective modes. It brings normal mode analysis and elastic network models into a scripting environment. It is used to compare simulated motion with motion inferred from experimental structures. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001920 "ProDy"@en)
SubClassOf(obo:MOLSIM_001920 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001921 (BioBB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001921 "BioBB, or BioExcel Building Blocks, is a library of Python wrappers that create a standardized interface for many common biomolecular simulation programs like GROMACS and AmberTools. Each building block performs a specific task, such as running an energy minimization or calculating an RMSD, using a consistent input and output format. For computational biologists, BioBB provides an interoperable toolkit for constructing complex, reproducible, and portable simulation workflows."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001921 "BioBB"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001921 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001921 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001922 (3DMol.js)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001922 "3Dmol.js is a JavaScript library used for creating interactive, 3D visualizations of molecular structures directly within a web browser. It allows web developers to embed high-quality molecular viewers into websites and web applications without requiring any plugins. For creators of online scientific resources, 3Dmol.js provides a lightweight and versatile tool for displaying and interacting with molecular data on the web."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001922 "3DMol.js"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001922 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001922 obo:MOLSIM_001566)
SubClassOf(obo:MOLSIM_001922 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001923 (NGL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001923 "NGL Viewer is a WebGL-based JavaScript library for the fast and high-quality visualization of large molecular complexes and trajectories in the web browser. It is designed for high-performance rendering, enabling smooth, interactive exploration of even very large structures like ribosomes or viral capsids."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001923 "NGL"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001923 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001923 obo:MOLSIM_001566)
SubClassOf(obo:MOLSIM_001923 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001924 (Open Babel)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001924 "Open Babel is a versatile software program and library, often called a \"chemical toolbox,\" for reading, writing, and converting between over 100 different chemical file formats. It allows users to easily interconvert between the various file types used by different simulation, modeling, and visualization programs. Its powerful interoperability makes it an essential utility in many simulation and modeling workflows for preparing and manipulating molecular structure files."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001924 "Open Babel"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001924 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001924 obo:MOLSIM_000166)

# Class: obo:MOLSIM_001925 (editconf)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001925 "A system preparation program in the GROMACS suite that manipulates a structure file: converting between formats, setting the size and shape of the box, centring the molecule and rotating or translating it. It changes how a system is placed rather than what it contains. It is normally run before the box is filled with solvent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001925 "editconf"@en)
SubClassOf(obo:MOLSIM_001925 obo:MOLSIM_001956)

# Class: obo:MOLSIM_001926 (gmx)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001926 "A command-line program that provides access to every tool in the GROMACS suite through a single entry point, with the tool named as its first argument. It is not itself a simulation engine; it dispatches to the preparation, simulation and analysis programs. Almost every GROMACS command in a published protocol begins with it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001926 "gmx"@en)
SubClassOf(obo:MOLSIM_001926 obo:MOLSIM_000251)

# Class: obo:MOLSIM_001927 (CHARMM-GUI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001927 "CHARMM-GUI is a powerful and widely used web server that provides a graphical interface for generating input files for a wide variety of complex biomolecular simulations. It automates many difficult and error-prone setup tasks, such as building lipid membranes, solvating proteins, and preparing systems for free energy calculations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001927 "CHARMM-GUI"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001927 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001927 obo:MOLSIM_000225)
SubClassOf(obo:MOLSIM_001927 obo:MOLSIM_000714)

# Class: obo:MOLSIM_001928 (Modeller)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001928 "Modeller is a widely used computer program for generating three-dimensional models of proteins through homology or comparative modeling. It predicts a protein's structure by using the known structure of a related protein as a template and satisfying spatial restraints. For researchers, Modeller is a powerful tool to create high-quality structural hypotheses for proteins whose experimental structures have not yet been determined, providing a starting point for further simulation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001928 "Modeller"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001928 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001928 obo:MOLSIM_001958)

# Class: obo:MOLSIM_001929 (ACEMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001929 "A molecular dynamics program written to run on NVIDIA graphics processors. It was among the first engines to reach microsecond simulations on a single desktop machine. Its speed comes from targeting one kind of hardware rather than supporting many. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001929 "ACEMD"@en)
SubClassOf(obo:MOLSIM_001929 obo:MOLSIM_000160)

# Class: obo:MOLSIM_001930 (SAMSON)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001930 "A software platform for building, viewing and simulating molecular systems at the nanometre scale. Its functions are supplied by separate modules, so users and developers can add capabilities without changing the platform itself. That modular design is what distinguishes it from a fixed-feature suite. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001930 "SAMSON"@en)
SubClassOf(obo:MOLSIM_001930 obo:MOLSIM_001664)

# Class: obo:MOLSIM_001931 (Blender)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001931 "Blender is a free and open-source 3D computer graphics software suite used for creating animated films, visual effects, art, and 3D printed models. While not a dedicated molecular viewer, it is often used by computational biologists to import molecular structures and create high-quality, cinematic renderings and scientific animations. Blender provides a professional-level tool for producing visually stunning figures and movies for publications and presentations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001931 "Blender"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001931 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001931 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001932 (Jmol)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001932 "Jmol is a free, open-source molecular viewer for 3D chemical structures, written in the Java programming language. Because it is Java-based, it can run on a wide variety of operating systems and was often used as a tool for displaying molecules on websites. For researchers and educators, Jmol provided a versatile and accessible tool for basic molecular visualization and analysis. Nowadays replaced by JavaScript and openGL tools such as JSMol, NGL or Mol*."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001932 "Jmol"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001932 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001932 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001933 (MolStar)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001933 "MolStar (Mol*) is a modern, web-based toolkit for visualizing and analyzing large-scale molecular data. It is designed for high-performance rendering of extremely large structures, such as those from cryo-electron microscopy, directly in a web browser. For the structural biology community, Mol* is the state-of-the-art viewer integrated into databases like the PDB for exploring complex biological assemblies."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001933 "Mol*"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001933 "MolStar"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001933 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001933 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001934 (UCSF Chimera)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001934 "A visualization and analysis program for molecular structures and related data, extensible through user-written modules. It produces publication-quality images and handles structures together with density maps and sequence data. It has been superseded for large data by its successor, but remains in use because many published workflows depend on it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001934 "UCSF Chimera"@en)
SubClassOf(obo:MOLSIM_001934 obo:MOLSIM_000490)
SubClassOf(obo:MOLSIM_001934 obo:MOLSIM_002041)

# Class: obo:MOLSIM_001935 (YASARA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001935 "A molecular modelling and simulation software suite covering structure prediction, structure cleaning, simulation and analysis in one program. Its steps are heavily automated, so a full workflow can be run without assembling separate tools. That automation is what distinguishes it from suites that expose each step separately. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001935 "YASARA"@en)
SubClassOf(obo:MOLSIM_001935 obo:MOLSIM_000160)
SubClassOf(obo:MOLSIM_001935 obo:MOLSIM_001664)

# Class: obo:MOLSIM_001936 (high-performance computing cluster system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001936 "A computing system consisting of a group of individual computers (nodes) linked together by a high-speed network to function as a single, coordinated system for parallel processing. This encompasses a wide range of scales, from small laboratory clusters to massive institutional systems. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001936 "HPC system"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001936 "high-performance computing cluster system"@en)
SubClassOf(obo:MOLSIM_001936 obo:MOLSIM_001862)

# Class: obo:MOLSIM_001937 (supercomputer system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001937 "A high-performance computing cluster system that operates at or near the maximum performance rate for computers at the time of its deployment. Supercomputers are typically characterized by massive scale, specialized high-speed interconnects, and act as national or global resources for the most demanding computational tasks (e.g., Summit, Frontier, or specialized MD machines like Anton). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001937 "supercomputer system"@en)
SubClassOf(obo:MOLSIM_001937 obo:MOLSIM_001936)

# Class: obo:MOLSIM_001938 (cloud computing platform system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001938 "A cloud computing platform is a service that provides on-demand access to powerful computing resources over the internet. This allows researchers to run large-scale simulations on virtual clusters hosted by commercial providers like Amazon Web Services (AWS) or Google Cloud. This approach offers flexible access to the latest hardware, such as high-end GPUs, without the cost and maintenance of owning a physical supercomputer. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001938 "cloud computing platform system"@en)
SubClassOf(obo:MOLSIM_001938 obo:MOLSIM_001862)

# Class: obo:MOLSIM_001939 (processing unit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001939 "The hardware component that performs the arithmetic and logic of a computation. A general-purpose one handles varied work a few operations at a time, while a graphics processor performs thousands of similar operations at once. Which kind a simulation runs on changes its speed by a large factor. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001939 "processing unit"@en)
SubClassOf(obo:MOLSIM_001939 obo:MOLSIM_001845)

# Class: obo:MOLSIM_001940 (central processing unit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001940 "The general-purpose processor of a computer, which handles varied instructions a few at a time with a large amount of fast local memory. It runs the parts of a simulation that are not easily done many at once, such as file handling and control logic. It is much slower than a graphics processor at the force calculation and much faster at everything irregular. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001940 "central processing unit"@en)
SubClassOf(obo:MOLSIM_001940 obo:MOLSIM_001939)

# Class: obo:MOLSIM_001941 (graphics processing unit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001941 "A processor holding thousands of small cores that carry out the same operation on many pieces of data at once. Computing the force on every atom is exactly that kind of work, which is why simulations run several times faster on one. It performs badly on work that branches differently for each item. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001941 "graphics processing unit"@en)
SubClassOf(obo:MOLSIM_001941 obo:MOLSIM_001939)

# Class: obo:MOLSIM_001942 (application-specific integrated circuit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001942 "A chip built to perform one particular computation, with its circuitry fixed at manufacture. Giving up all flexibility buys a very large gain in speed and energy efficiency for that one task. The Anton machines, built solely for molecular dynamics, are the example in this field. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001942 "ASIC")
AnnotationAssertion(rdfs:label obo:MOLSIM_001942 "application-specific integrated circuit"@en)
SubClassOf(obo:MOLSIM_001942 obo:MOLSIM_001939)

# Class: obo:MOLSIM_001943 (network interconnect)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001943 "The high-speed communication hardware linking the machines of a cluster to one another. A simulation spread across many machines exchanges data every step, so the delay in that link can matter more than the speed of the processors. It is what limits how far one simulation can usefully be spread. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001943 "network interconnect"@en)
SubClassOf(obo:MOLSIM_001943 obo:MOLSIM_001845)

# Class: obo:MOLSIM_001944 (pressure)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001944 "A thermodynamic property giving the force per unit area the particles exert on the boundaries of the simulation box. It is computed from the virial, which combines the positions of the atoms with the forces between them. It fluctuates far more violently than temperature, often by hundreds of atmospheres, so only a long average is meaningful. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001944 "pressure"@en)
SubClassOf(obo:MOLSIM_001944 obo:MOLSIM_001293)
SubClassOf(obo:MOLSIM_001944 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000109))
SubClassOf(obo:MOLSIM_001944 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001946 (volume)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001946 "A thermodynamic property giving the size of the periodic simulation box. It is fixed in a constant-volume simulation and varies in a constant-pressure one, where it is the quantity the barostat adjusts. Its average, divided into the mass in the box, gives the density that is compared with experiment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001946 "volume"@en)
SubClassOf(obo:MOLSIM_001946 obo:MOLSIM_001293)
SubClassOf(obo:MOLSIM_001946 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000095))
SubClassOf(obo:MOLSIM_001946 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001947 (ethernet)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001947 "A networking technology used to connect computers in most ordinary local networks. It is cheap and universal, and its delay in delivering a message is higher than a specialised cluster network's. A simulation spread across machines connected this way spends much of its time waiting. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001947 "ethernet"@en)
SubClassOf(obo:MOLSIM_001947 obo:MOLSIM_001943)

# Class: obo:MOLSIM_001948 (infiniband)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001948 "A networking technology built for computing clusters, with very low delay and the ability to move data straight between machines' memory without involving their processors. That directness is what makes it suitable for a simulation whose parts must exchange data at every step. It is the most common cluster network. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001948 "infiniband"@en)
SubClassOf(obo:MOLSIM_001948 obo:MOLSIM_001943)

# Class: obo:MOLSIM_001949 (omni-path)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001949 "A networking technology built by Intel for connecting the nodes of a supercomputer, competing with InfiniBand on delay and bandwidth. It appeared in several large machines and is no longer developed by its originator. It is recorded because published simulations ran on machines using it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001949 "omni-path"@en)
SubClassOf(obo:MOLSIM_001949 obo:MOLSIM_001943)

# Class: obo:MOLSIM_001950 (MDrepo)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001950 "MDRepo is a public repository dedicated to the archival and sharing of molecular dynamics simulation data generated by the research community. It provides a standardized infrastructure for scientists to upload, store, and retrieve simulation trajectories and associated metadata. By centralizing access to these datasets, MDRepo promotes the reproducibility and secondary analysis of biomolecular simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001950 "MDrepo"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001950 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001950 obo:MOLSIM_001119)

# Class: obo:MOLSIM_001951 (ATLAS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001951 "ATLAS is a specialized database that stores a comprehensive collection of standardized all-atom molecular dynamics simulations of proteins. It combines simulation trajectories with analyses of protein flexibility and dynamics, linked to experimental structural data. This resource allows researchers to explore the dynamic properties of a wide range of protein families in a consistent and comparative manner."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001951 "ATLAS"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001951 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001951 obo:MOLSIM_001119)

# Class: obo:MOLSIM_001952 (GPCRmd)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001952 "GPCRmd is a community-driven database and web platform specifically focused on molecular dynamics simulations of G-protein-coupled receptors (GPCRs). It provides a repository for storing simulation trajectories of this important protein family, along with tools for interactive visualization and analysis. This resource aids researchers in understanding the complex signaling mechanisms and conformational landscapes of GPCRs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001952 "GPCRmd"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001952 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001952 obo:MOLSIM_001119)

# Class: obo:MOLSIM_001953 (InflateGro)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001953 "InflateGRO is a utility script used to construct lipid membrane systems by packing lipids around a membrane protein. It works by initially expanding the distance between lipid molecules and then iteratively shrinking the system back to a realistic density while removing lipids that overlap with the protein. This method automates the challenging process of embedding a protein structure into a tight, pre-equilibrated lipid bilayer."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001953 "InflateGro"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001953 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001953 obo:MOLSIM_000225)

# Class: obo:MOLSIM_001954 (MemProtMD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001954 "MemProtMD is a database that provides a collection of coarse-grained molecular dynamics simulations for membrane proteins found in the Protein Data Bank. It uses an automated pipeline to insert protein structures into lipid bilayers and simulate their equilibrium dynamics. This resource offers insights into the membrane orientation, lipid interactions, and stability of a vast number of membrane proteins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001954 "MemProtMD"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001954 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001954 obo:MOLSIM_000225)

# Class: obo:MOLSIM_001955 (crystallographic build tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001955 "A crystallographic build tool is a software utility used to reconstruct a full crystal lattice or supercell from the asymmetric unit provided in a structure file. It applies the specific symmetry operations defined by the space group to generate the complete crystallographic packing environment."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001955 "crystallographic build tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001955 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001955 obo:MOLSIM_001556)

# Class: obo:MOLSIM_001956 (system packing and solvation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001956 "A software program that defines the shape and size of a simulation box and fills it with solvent molecules and ions at a target density and concentration. It places the molecules so that none overlap, which a random arrangement would not achieve. It is the step that turns a lone molecule into a system with an environment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001956 "system packing and solvation tool"@en)
SubClassOf(obo:MOLSIM_001956 obo:MOLSIM_001556)

# Class: obo:MOLSIM_001957 (structure cleaning and manipulation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001957 "A software program that standardises and repairs the formatting of a molecular structure file, by renumbering residues, correcting atom names, removing unwanted records and splitting or joining chains. The work is clerical rather than scientific, but nothing downstream runs until it is done. Most structure files from experimental sources need it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001957 "structure cleaning and manipulation tool"@en)
SubClassOf(obo:MOLSIM_001957 obo:MOLSIM_000490)

# Class: obo:MOLSIM_001958 (homology modeling tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001958 "A homology modeling tool is a software program designed to predict the three-dimensional structure of a protein based on its amino acid sequence and experimentally determined template structures. It constructs a model by mapping the target sequence onto the backbone of a homologous protein and computationally refining the loops and side chains to resolve steric conflicts. For experts, these tools are a solution for generating starting structural models when high-resolution crystallography or NMR data for the specific target is unavailable."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001958 "homology modeling tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001958 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001958 obo:MOLSIM_001850)

# Class: obo:MOLSIM_001959 (AutoDock Vina)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001959 "AutoDock Vina is an open-source software tool for molecular docking that predicts the preferred orientation and binding affinity of a small molecule to a protein receptor. It utilizes a sophisticated iterated local search global optimizer combined with an empirical scoring function to efficiently explore the conformational space of the ligand."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001959 "AutoDock Vina"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001959 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001959 obo:MOLSIM_000162)

# Class: obo:MOLSIM_001960 (nucleic acid analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001960 "A nucleic acid analysis tool is a specialized software program designed to characterize the geometry and topology of DNA and RNA structures. It calculates parameters such as base-pair step geometry (roll, tilt, twist), groove dimensions, and sugar pucker to describe the helical conformation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001960 "nucleic acid analysis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001960 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001960 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001961 (scattering analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001961 "A software program that computes the scattering pattern a structure or trajectory would produce in an experiment. Comparing that computed pattern with a measured one is how a simulated ensemble is tested against solution data. It turns coordinates into something directly comparable with a measurement. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001961 "scattering analysis tool"@en)
SubClassOf(obo:MOLSIM_001961 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001962 (titration analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001962 "A software program that works out which acidic and basic groups in a molecule carry a proton, and at what acidity they gain or lose one. It either predicts those values from the structure or measures them from a simulation that allowed protons to move. Which groups are charged changes a molecule's behaviour, so this must be settled before a simulation is set up. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001962 "titration analysis tool"@en)
SubClassOf(obo:MOLSIM_001962 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001963 (solvation analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001963 "A software program that characterises the structure and thermodynamics of the solvent around a solute. It computes quantities such as radial distribution functions, solvent density maps, and the solvation free energies given by integral equation theories. It is how a hydration shell is described quantitatively rather than by eye. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001963 "solvation analysis tool"@en)
SubClassOf(obo:MOLSIM_001963 obo:MOLSIM_000164)

# Class: obo:MOLSIM_001964 (TM-align)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001964 "An algorithm and program that superposes 2 protein structures and scores how similar their folds are, on a scale that does not depend on how long the proteins are. Length independence is what lets a short and a long protein be compared meaningfully. It finds the correspondence between residues itself, so no alignment need be supplied. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001964 "TM-align"@en)
SubClassOf(obo:MOLSIM_001964 obo:MOLSIM_001684)

# Class: obo:MOLSIM_001965 (DALI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001965 "DALI (Distance Alignment) is a software method that compares protein structures by analyzing their internal distance matrices rather than their rigid-body superposition. This approach allows to detect distant evolutionary relationships and structural similarities even when the proteins have undergone significant conformational changes or distortions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001965 "DALI"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001965 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001965 obo:MOLSIM_001684)

# Class: obo:MOLSIM_001966 (LS-align)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001966 "LS-align is an algorithm designed for atom-level structural comparison of ligand molecules. The target function of LS-align is a combination of inter-atom distance, atom mass, and chemical bond connections; while the final atom-to-atom alignment is generated by maximizing such target function through an enhanced-greedy based, iterative heuristic search algorithm."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001966 "LS-align"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001966 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001966 obo:MOLSIM_001684)

# Class: obo:MOLSIM_001967 (replica exchange algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001967 "An enhanced sampling algorithm that manages multiple parallel simulation replicas running at different thermodynamic states (e.g., temperatures or Hamiltonians). It evaluates and periodically attempts to swap the states of these replicas based on a Metropolis-style acceptance criterion to facilitate barrier crossing and improve conformational sampling."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001967 "replica exchange algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001967 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001967 obo:MOLSIM_001740)

# Class: obo:MOLSIM_001968 (alchemical analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001968 "A software program that computes a free energy difference from simulations run along a path of non-physical intermediate states. It implements estimators such as the multi-state Bennett acceptance ratio or thermodynamic integration. It is separate from the simulation engine that generated the states. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001968 "alchemical analysis tool"@en)
SubClassOf(obo:MOLSIM_001968 obo:MOLSIM_001564)

# Class: obo:MOLSIM_001969 (free energy surface analysis tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001969 "A free energy surface analysis tool is a software utility used to reconstruct the multidimensional free energy landscape of a system from enhanced sampling simulation data. It processes the history of visited states or applied biases, such as those from metadynamics or umbrella sampling, to generate a potential of mean force (PMF) map. Enable the visualization of low-energy basins and transition barriers along specific collective variables or reaction coordinates."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001969 "free energy surface analysis tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001969 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001969 obo:MOLSIM_001564)

# Class: obo:MOLSIM_001970 (parameter assignment tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001970 "A software program that inspects a molecule, works out which atom type each atom belongs to, and looks up the parameters that follow. The assignment is made from element and bonding environment. It is where a general force field becomes a specific set of numbers for one molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001970 "parameter assignment tool"@en)
SubClassOf(obo:MOLSIM_001970 obo:MOLSIM_000172)

# Class: obo:MOLSIM_001971 (charge derivation tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001971 "A software program that computes partial atomic charges for a molecule so it can be simulated with a force field. The method used must match the one the force field's own charges were derived with, or the molecule will interact too strongly or too weakly with everything else. It is run once per new molecule. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001971 "charge derivation tool"@en)
SubClassOf(obo:MOLSIM_001971 obo:MOLSIM_000172)

# Class: obo:MOLSIM_001972 (residue template tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001972 "A software program that produces the library file defining a new building block: its atoms, their types and charges, the bonds between them and the atoms that join it to its neighbours. Once written, that template lets the block be used anywhere in a chain. It is what makes a non-standard residue reusable rather than a one-off. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001972 "residue template tool"@en)
SubClassOf(obo:MOLSIM_001972 obo:MOLSIM_000172)

# Class: obo:MOLSIM_001973 (AMBERGS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001973 "A force field of the AMBER family with its backbone rotation terms refitted to correct a bias towards helical structure in the parameters it was derived from. The bias mattered because a simulation would form helices whatever the sequence. It targets peptides and small proteins where secondary structure is the property under study. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001973 "AMBERGS"@en)
SubClassOf(obo:MOLSIM_001973 obo:MOLSIM_000009)

# Class: obo:MOLSIM_001974 (GROMOS 53a6)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001974 "A GROMOS parameter set whose non-bonded parameters were refitted to reproduce free energies of transfer between water and cyclohexane for amino acid analogues. That refit corrected a known bias towards over-stabilising folded structures. It became the standard choice for protein simulation in that family. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001974 "GROMOS 53a6"@en)
SubClassOf(obo:MOLSIM_001974 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001975 (GROMOS 53a5)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001975 "A GROMOS parameter set fitted to reproduce properties of biomolecules in non-polar surroundings, such as the interior of a membrane. It shares its bonded parameters with the aqueous-fitted set of the same generation and differs in the non-bonded ones. The 2 are alternatives chosen by environment, not successive versions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001975 "GROMOS 53a5"@en)
SubClassOf(obo:MOLSIM_001975 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001976 (GROMOS 43a1p)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001976 "A GROMOS parameter set extending an earlier one with parameters for phosphorylated amino acids. Standard parameter sets do not include them, because phosphorylation is a modification rather than a standard residue. It covers phosphoserine, phosphothreonine and phosphotyrosine. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001976 "GROMOS 43a1p"@en)
SubClassOf(obo:MOLSIM_001976 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001977 (GROMOS-87)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001977 "A force field of the GROMOS family, released in the late 1980s, in which non-polar hydrogens are merged into the heavy atoms they are bonded to. It set the parameter conventions the later GROMOS revisions were built on. It is of historical interest rather than in current use. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001977 "GROMOS-87"@en)
SubClassOf(obo:MOLSIM_001977 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001978 (PLUMED)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001978 "PLUMED is an open-source software library designed to analyze molecular dynamics simulations and perform enhanced sampling of free energy landscapes. It functions as middleware that interfaces with various simulation engines to calculate collective variables and apply biasing potentials in real-time."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001978 "PLUMED"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001978 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001978 obo:MOLSIM_001566)

# Class: obo:MOLSIM_001979 (domain decomposition algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001979 "A parallel computing method that divides the simulation box into regions and gives each to a different processor, which handles the atoms currently inside it. Because interactions are short-ranged, a processor mostly needs data from its own region and its immediate neighbours. It is what allows a single simulation to use hundreds of processors at once. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001979 "domain decomposition algorithm"@en)
SubClassOf(obo:MOLSIM_001979 obo:MOLSIM_000382)

# Class: obo:MOLSIM_001980 (GROMOS force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001980 "A family of force fields in which non-polar hydrogens are merged into the heavy atoms they are bonded to, with parameters fitted to reproduce measured free energies of transfer between water and a non-polar liquid. Fitting to transfer free energies is what distinguishes it, since that quantity governs how a molecule partitions between environments. The family is identified by a number naming each parameter set. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001980 "GROMOS force field"@en)
SubClassOf(obo:MOLSIM_001980 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001981 (GROMOS96)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001981 "The GROMOS96 force field is a family of united-atom molecular mechanics parameter sets developed in conjunction with the GROMOS96 simulation software. It treats non-polar hydrogen atoms as part of the heavy atoms they are bonded to (e.g., CH, CH2, CH3) to reduce computational complexity while maintaining accuracy for biomolecular simulations."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001981 "GROMOS96"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001981 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001981 obo:MOLSIM_001531)

# Class: obo:MOLSIM_001982 (MARTINI force field)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001982 "A coarse-grained force field that maps roughly 4 heavy atoms and their hydrogens onto 1 interaction bead, with beads classified by polarity, charge and hydrophobicity. The small number of bead types makes it transferable across lipids, proteins and carbohydrates. It is the most widely used coarse-grained model for membrane simulation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001982 "MARTINI force field"@en)
SubClassOf(obo:MOLSIM_001982 obo:MOLSIM_000736)

# Class: obo:MOLSIM_001983 (OPLS-AA/M)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001983 "A force field of the OPLS all-atom family with its protein parameters refitted again, against both quantum calculations and measured properties of peptides in solution. Fitting to solution data as well as to isolated molecules is what distinguishes it from the earlier revision. It is the current OPLS choice for proteins. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001983 "OPLS-AA/M"@en)
SubClassOf(obo:MOLSIM_001983 obo:MOLSIM_000759)

# Class: obo:MOLSIM_001984 (OPLS-AA/L)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001984 "A force field of the OPLS all-atom family with its protein backbone and side-chain rotation terms refitted against high-level quantum calculations. The refit corrected secondary structure preferences that the original parameters got wrong. It was the standard OPLS choice for proteins before the later revision. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001984 "OPLS-AA/L"@en)
SubClassOf(obo:MOLSIM_001984 obo:MOLSIM_000759)

# Class: obo:MOLSIM_001985 (polarizable water)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001985 "A computer model of water that allows the electric charge distribution within each molecule to shift in response to its surroundings. Unlike fixed-charge models, it explicitly includes terms for electronic polarization, often via induced dipoles, Drude oscillators, or fluctuating charges. For experts, these models (e.g., TIP4P-FQ, AMOEBA water) capture non-additive many-body effects and are essential for accurately simulating interfaces, ion solvation, and spectroscopic properties. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001985 "polarizable water"@en)
SubClassOf(obo:MOLSIM_001985 obo:MOLSIM_000014)

# Class: obo:MOLSIM_001986 (minimum image convention)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001986 "A rule used in computer simulations to calculate forces in a repeating, infinite system. It states that a particle should interact only with the nearest instance of another particle, whether that instance is in the same simulation box or a neighboring periodic copy. For experts, this approximation is valid when the cutoff radius is less than half the shortest box vector, ensuring particles do not interact with their own periodic images (except in small systems where this artifact is intentional). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001986 "minimum image convention"@en)
SubClassOf(obo:MOLSIM_001986 obo:MOLSIM_000037)

# Class: obo:MOLSIM_001987 (minimum distance)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001987 "A measurement of the closest separation between two distinct groups of atoms in a structure. It is calculated by evaluating the Euclidean distance between all possible atom pairs from the two groups and selecting the smallest value. This metric is frequently used in trajectory analysis to define contact maps, monitor collision avoidance, or serve as a collective variable for pathway sampling."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001987 "minimum distance"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001987 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_001987 obo:MOLSIM_001333)
SubClassOf(obo:MOLSIM_001987 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000001))
SubClassOf(obo:MOLSIM_001987 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_001988 (helmholtz free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001988 "A measure of the useful energy available to do work in a system held at constant temperature and volume. It is a thermodynamic potential defined as the internal energy minus the product of temperature and entropy (A=U−TS). For experts, this quantity is the natural free energy ensemble for NVT (canonical) simulations and is often calculated using methods like thermodynamic integration or Bennett acceptance ratio. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001988 "helmholtz free energy"@en)
SubClassOf(obo:MOLSIM_001988 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001989 (gibbs free energy)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001989 "A measure of the maximum reversible work a system can perform at constant temperature and pressure. Defined as the enthalpy minus the product of temperature and entropy (G=H−TS), it determines the direction of spontaneous change and chemical equilibrium. For experts, this is the primary thermodynamic potential of interest in NPT simulations and is used to calculate binding affinities, solvation energies, and phase equilibria. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001989 "gibbs free energy"@en)
SubClassOf(obo:MOLSIM_001989 obo:MOLSIM_001314)

# Class: obo:MOLSIM_001990 (virial)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001990 "A mathematical quantity used to calculate the pressure of a system based on the positions and forces of its atoms. It is derived from the virial theorem and involves summing the dot products of atomic coordinates and the forces acting upon them. For experts, in molecular dynamics, the instantaneous virial is essential for the pressure tensor calculation and the function of barostat algorithms in NPT simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001990 "virial"@en)
SubClassOf(obo:MOLSIM_001990 obo:MOLSIM_001293)

# Class: obo:MOLSIM_001991 (autocorrelation function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001991 "A statistical tool that measures how much a property's value at one time resembles its value at a later time. It quantifies the \"memory\" of a system by calculating the correlation between a time-series signal and a time-shifted version of itself. For experts, calculated as C(t)=⟨A(0)A(t)⟩, it is fundamental for computing transport coefficients (like diffusion via Green-Kubo relations) and relaxation times. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001991 "autocorrelation function"@en)
SubClassOf(obo:MOLSIM_001991 obo:MOLSIM_001421)

# Class: obo:MOLSIM_001992 (cromer's method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001992 "A mathematical approach used to estimate how strongly atoms scatter X-rays. It approximates the atomic scattering factor using a sum of Gaussian functions based on quantum mechanical calculations of electron density. For experts, this parametrization (often the Cromer-Mann coefficients) is standard in crystallography and simulation analysis for calculating theoretical structure factors and comparing simulation trajectories with experimental X-ray scattering data (SAXS/WAXS). (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001992 "cromer's method"@en)
SubClassOf(obo:MOLSIM_001992 obo:MOLSIM_001696)

# Class: obo:MOLSIM_001993 (accelerated weight histogram)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001993 "An enhanced sampling method that applies a bias which is updated as the simulation runs, driven by how evenly the chosen coordinate has been visited so far. The bias grows where the system has spent time and shrinks where it has not, which pushes it into unvisited regions. The free energy profile is recovered from the bias that was needed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001993 "accelerated weight histogram"@en)
SubClassOf(obo:MOLSIM_001993 obo:MOLSIM_000845)

# Class: obo:MOLSIM_001994 (reaction coordinate)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001994 "A simplified variable used to track the progress of a chemical reaction or a complex structural change. It reduces the motion of thousands of atoms into a single parameter that describes the transition from a starting state to a final state."@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001994 "Distinct from the object property MOLSIM_001036. Modeled here as a Class (the variable itself)."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001994 "reaction coordinate"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001994 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_001994 obo:MOLSIM_001827)

# Class: obo:MOLSIM_001995 (position restraints)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001995 "A computational technique used to anchor atoms to specific locations in 3D space during a simulation. It applies an artificial harmonic energy penalty proportional to the square of the displacement of an atom from a reference coordinate. For experts, these are heavily used during system equilibration (to relax solvent around a fixed solute) or in free energy calculations to prevent ligand drift, typically defined with a force constant k in units of kJ/(mol*nm^2) or kcal/mol."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001995 "position restraints"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_001995 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_001995 obo:MOLSIM_001552)

# Class: obo:MOLSIM_001996 (Urey-Bradley potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001996 "A specific interaction term used in molecular mechanics force fields to refine the vibrational behavior of bond angles. It introduces a harmonic potential acting on the distance between the two atoms at the ends of a bond angle (the 1-3 interaction), effectively placing a spring across the angle. For experts, this term is a hallmark of the CHARMM force field family, used to couple bond stretching and angle bending modes to better reproduce vibrational frequencies obtained from spectroscopy. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001996 "Urey-Bradley potential"@en)
SubClassOf(obo:MOLSIM_001996 obo:MOLSIM_000331)

# Class: obo:MOLSIM_001997 (exclusions)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001997 "A configuration setting or list within a molecular topology that identifies pairs of atoms whose non-bonded interactions (electrostatic and van der Waals) should be ignored during force calculation. These exclusions typically apply to atoms connected by one or two covalent bonds (1-2 and 1-3 pairs) to prevent conflicts with bonded energy terms. For experts, exclusion rules vary by force field (e.g., AMBER scales 1-4 interactions, while CHARMM or GROMOS may exclude them entirely), making this a critical factor in topology conversion. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001997 "Defines the concept of the exclusion list/rule.")
AnnotationAssertion(rdfs:label obo:MOLSIM_001997 "exclusions"@en)
SubClassOf(obo:MOLSIM_001997 obo:MOLSIM_001185)

# Class: obo:MOLSIM_001998 (holonomic constraint)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001998 "A mathematical restriction applied to a molecular system that depends only on the coordinates of the particles and time, reducing the system's degrees of freedom. In molecular dynamics, these typically manifest as fixed bond lengths or rigid water geometries (f(r1,r2,…)=0). For experts, integrating these constraints requires specialized algorithms like SHAKE, RATTLE, or LINCS to solve for the Lagrange multipliers that maintain the geometric requirements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001998 "holonomic constraint"@en)
SubClassOf(obo:MOLSIM_001998 obo:MOLSIM_001201)

# Class: obo:MOLSIM_001999 (smooth particle mesh Ewald)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001999 "An enhanced version of the Particle Mesh Ewald method that uses Euler exponential splines (B-splines) to interpolate charge density onto a grid. Unlike standard PME which uses Lagrangian interpolation, SPME allows the potential to be differentiated analytically to obtain forces, improving energy conservation and accuracy. For experts, this is the standard implementation in packages like AMBER and GROMACS (Essmann et al., 1995), offering N log N scaling. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001999 "SPME"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001999 "smooth particle mesh Ewald"@en)
SubClassOf(obo:MOLSIM_001999 obo:MOLSIM_000054)

# Class: obo:MOLSIM_002000 (dispersion interaction parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002000 "A numerical coefficient in a force field that quantifies the strength of the long-range attractive forces between two atoms due to induced dipole fluctuations. In the standard Lennard-Jones potential, this is the C6 term, proportional to the product of the interaction energy well depth and the sixth power of the collision diameter (4ϵσ^6). For experts, this parameter governs the asymptotic decay of the van der Waals potential and is often derived from atomic polarizabilities. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002000 "dispersion interaction parameter"@en)
SubClassOf(obo:MOLSIM_002000 obo:MOLSIM_001515)

# Class: obo:MOLSIM_002001 (repulsion interaction parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002001 "A numerical coefficient in a force field that defines the stiffness of the short-range repulsive barrier between two atoms. In the Lennard-Jones potential, this is the C12 term (4ϵσ^12), approximating the Pauli exclusion principle that prevents atomic overlap. For experts, while physically approximating an exponential repulsion, the 1/r ^12 form is chosen primarily for computational efficiency as the square of the dispersion term. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002001 "repulsion interaction parameter"@en)
SubClassOf(obo:MOLSIM_002001 obo:MOLSIM_001515)

# Class: obo:MOLSIM_002002 (atom freezing)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002002 "A simulation technique where the positions of a selected group of atoms are kept strictly fixed throughout the integration. This is achieved by zeroing the forces and velocities (or setting masses to infinity) for those atoms, effectively removing them from the equations of motion. For experts, this is distinct from position restraints (where atoms vibrate around a point) and is used to model rigid walls, surface adsorption, or to equilibrate solvent around a static protein structure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002002 "atom freezing"@en)
SubClassOf(obo:MOLSIM_002002 obo:MOLSIM_001201)

# Class: obo:MOLSIM_002003 (coarse-graining)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002003 "A modelling method that reduces a system's degrees of freedom by grouping atoms into single interaction sites according to chemical or structural rules. It is the act of building the model, as distinct from the resolution the resulting model has. The rule chosen for grouping determines what the model can still represent. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002003 "coarse-graining"@en)
SubClassOf(obo:MOLSIM_002003 obo:MOLSIM_000305)

# Class: obo:MOLSIM_002004 (stochastic dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002004 "A simulation method that adds a random force and a matching frictional drag to the equations of motion, imitating collisions with a surrounding fluid that is not itself simulated. The 2 additions are tied together so the system settles at the intended temperature. It also serves as a thermostat, which is why it is often used even when the solvent is present. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002004 "stochastic dynamics"@en)
SubClassOf(obo:MOLSIM_002004 obo:MOLSIM_000843)

# Class: obo:MOLSIM_002005 (non-equilibrium molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002005 "A simulation method in which the system is deliberately driven away from equilibrium by an applied force, flow or gradient. Measuring how it responds gives transport properties such as viscosity and thermal conductivity directly, which an equilibrium simulation can only obtain indirectly from fluctuations. The driving must be gentle enough that the response stays proportional to it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002005 "NEMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002005 "non-equilibrium molecular dynamics"@en)
SubClassOf(obo:MOLSIM_002005 obo:MOLSIM_000843)

# Class: obo:MOLSIM_002006 (flooding potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002006 "A computational technique used to force a protein out of its stable resting shape so it can explore new structures. It works by adding a localized repulsive energy hill, based on the system's principal components, to the energy minimum the molecule currently occupies."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002006 "flooding potential"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002006 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002006 obo:MOLSIM_001552)

# Class: obo:MOLSIM_002007 (simulated tempering)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002007 "Simulated tempering is an enhanced sampling technique that helps a system explore different configurations by allowing its temperature to fluctuate dynamically up and down during a single simulation. Unlike replica exchange, which uses parallel copies, this method uses a single trajectory that jumps between discrete temperature levels based on a probabilistic acceptance rule. It requires the pre-calculation or iterative determination of weighting factors for each temperature to ensuring uniform sampling and efficient barrier crossing."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002007 "simulated tempering"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002007 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002007 obo:MOLSIM_001555)

# Class: obo:MOLSIM_002008 (bonded type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002008 "A classification code in a force field topology that selects which parameters apply to a bond, angle or rotation, based on the kinds of atoms involved. Assigning it is how a general parameter set is applied to a particular molecule. A wrong assignment gives a molecule the wrong stiffness or the wrong preferred shape, and nothing reports it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002008 "bonded type"@en)
SubClassOf(obo:MOLSIM_002008 obo:MOLSIM_000447)

# Class: obo:MOLSIM_002009 (salt bridge)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002009 "A salt bridge is a strong non-covalent interaction formed between a positively charged amino acid side chain and a negatively charged one. It combines two physical forces: an electrostatic attraction between the opposing charges and a hydrogen bond between specific atoms in the residues. For experts, these interactions (typically between Arg/Lys and Asp/Glu) contribute significantly to protein thermostability but have a complex energetic dependence on the local dielectric environment and pH."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002009 "salt bridge"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002009 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002009 obo:MOLSIM_000187)

# Class: obo:MOLSIM_002010 (solvation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002010 "A preparation process in which a solute is placed inside a box of solvent molecules, usually water, and any solvent that overlaps the solute is removed. The solvent box is normally pre-equilibrated, so the liquid already has the right density and structure before the solute enters it. Without this step a simulation would have the molecule sitting in a vacuum, which changes its behaviour completely. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002010 "solvation"@en)
SubClassOf(obo:MOLSIM_002010 obo:MOLSIM_000002)

# Class: obo:MOLSIM_002011 (termini)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002011 "The 2 ends of a biological polymer chain, which differ chemically from each other and from everything between them. In a protein one end carries a free amino group and the other a free carboxyl group, each charged at ordinary acidity. They must be assigned a chemical state before a simulation, because a standard residue template does not cover them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002011 "termini"@en)
SubClassOf(obo:MOLSIM_002011 obo:MOLSIM_001333)

# Class: obo:MOLSIM_002012 (continuation state)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002012 "A configuration setting that instructs a molecular dynamics engine to resume a simulation exactly from where a previous run finished. It requires reading the full state of the system—including atomic positions, velocities, and sometimes forces—from a checkpoint or restart file to ensure a seamless trajectory."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002012 "continuation state"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002012 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002012 obo:MOLSIM_001164)

# Class: obo:MOLSIM_002013 (test particle insertion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002013 "A sampling method that computes the chemical potential of a species by repeatedly placing a non-interacting trial particle at random positions in a simulation and recording the energy it would have. Averaging the Boltzmann factor of those energies gives the excess chemical potential directly. It fails for dense systems, where almost every insertion overlaps an existing particle. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002013 "test particle insertion"@en)
SubClassOf(obo:MOLSIM_002013 obo:MOLSIM_000610)

# Class: obo:MOLSIM_002014 (Gibbs sampling replica exchange)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002014 "Gibbs sampling replica exchange is an advanced simulation method used to efficiently explore the different shapes and energy states of a molecule. Unlike standard replica exchange which attempts to swap temperatures between neighboring simulations, this method attempts to swap configurations among all running simulations simultaneously based on a global probability criterion. It is an advanced Markov chain Monte Carlo (MCMC) algorithm. It overcomes the problem of simulations getting trapped in low-energy \"metastable\" states by running multiple copies (replicas) of a system at different conditions."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002014 "Gibbs sampling replica exchange"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002014 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002014 obo:MOLSIM_000858)

# Class: obo:MOLSIM_002015 (shell molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002015 "A simulation method for polarizable force fields in which each polarizable atom is given a light charged particle attached to it by a spring. The particle shifts in response to the local electric field, which reproduces how an atom's electron cloud distorts. Treating polarization as an extra particle lets an ordinary integrator handle it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002015 "shell molecular dynamics"@en)
SubClassOf(obo:MOLSIM_002015 obo:MOLSIM_000843)

# Class: obo:MOLSIM_002016 (enforced rotation simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002016 "A simulation method that forces a specific part of a molecular system, such as a protein subunit, to spin around a defined axis. An external potential is applied to a group of atoms to induce rotation at a constant angular velocity or under a constant torque while the rest of the system responds dynamically."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002016 "enforced rotation simulation"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002016 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002016 obo:MOLSIM_000859)

# Class: obo:MOLSIM_002017 (MTTK pressure coupling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002017 "A mathematical method used to keep the pressure constant in a computer simulation of a molecular system. The Martyna-Tobias-Klein (MTTK) algorithm controls pressure by dynamically adjusting the size of the simulation box using equations of motion that rigorously sample the correct statistical ensemble. For experts, while theoretically rigorous for generating the NPT ensemble without the artifacts of stochastic collisions, it involves coupling the cell vectors to a thermostat chain and has been largely superseded or modified in some software versions due to implementation complexities or equipartition issues. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002017 "MTTK pressure coupling"@en)
SubClassOf(obo:MOLSIM_002017 obo:MOLSIM_000039)

# Class: obo:MOLSIM_002018 (buckingham potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002018 "A mathematical formula used to calculate the forces between atoms that are not chemically bonded to each other. Unlike the standard Lennard-Jones model, it replaces the steep r ^−12 repulsion term with an exponential function to better describe the softness of atomic electron clouds at short distances. For experts, the potential usually takes the form V(r)=Aexp(−Br)−Cr^−6, and while physically more accurate for repulsion, requires computational safeguards to prevent atomic fusion at very short distances where the exponential term turns over. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002018 "buckingham potential"@en)
SubClassOf(obo:MOLSIM_002018 obo:MOLSIM_000430)

# Class: obo:MOLSIM_002019 (neural network potential)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002019 "A computational model that uses machine learning algorithms to predict the potential energy and forces of a molecular system. It approximates the complex quantum mechanical energy landscape by training a neural network on a large dataset of reference atomic configurations and energies. For experts, these potentials (like ANI or DeepMD) offer ab initio accuracy at a computational cost closer to classical force fields, provided the simulation remains within the chemical space represented in the training data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002019 "neural network potential"@en)
SubClassOf(obo:MOLSIM_002019 obo:MOLSIM_000007)

# Class: obo:MOLSIM_002020 (hybrid NNP/MM simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002020 "A multiscale simulation technique that couples a region described by a Neural Network Potential (NNP) with a larger environment described by a classical molecular mechanics (MM) force field. It allows for the accurate modeling of reactive centers or complex electronic effects using machine learning, while efficiently capturing long-range environmental effects with standard physics-based models. For experts, this method typically employs electrostatic or mechanical embedding schemes similar to QM/MM to handle the boundary interactions between the NNP-active region and the classical surroundings. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002020 "hybrid NNP/MM simulations"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002020 "hybrid NNP/MM simulation"@en)
SubClassOf(obo:MOLSIM_002020 obo:MOLSIM_000336)

# Class: obo:MOLSIM_002021 (interactive molecular dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002021 "A simulation technique that allows a user to visualize and physically manipulate a running molecular simulation in real-time. Through a specialized interface or haptic device, the user applies external forces to specific atoms while the simulation engine calculates the system's response on the fly. For experts, IMD uses a client-server architecture where the visualization client sends force vectors to the simulation server, which integrates these as time-dependent external potentials, useful for guiding docking or unfolding pathways. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002021 "interactive molecular dynamics"@en)
SubClassOf(obo:MOLSIM_002021 obo:MOLSIM_000843)

# Class: obo:MOLSIM_002022 (leapfrog integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002022 "A numerical method used to solve the equations of motion in a simulation by updating positions and velocities at offset time intervals. It calculates velocities at half-integer time steps and positions at integer time steps, ensuring that the integration is time-reversible and symplectic (energy-conserving). For experts, while computationally efficient and stable (O(Δt ^2)), it does not provide velocities and positions at the same instant, requiring interpolation for calculating kinetic energy or pressure at step t. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002022 "leapfrog integrator"@en)
SubClassOf(obo:MOLSIM_002022 obo:MOLSIM_001691)

# Class: obo:MOLSIM_002023 (velocity verlet integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002023 "A numerical algorithm for integrating Newton's equations of motion that updates atomic positions and velocities at the same time step. It improves upon the leap-frog method by providing synchronized coordinates and velocities, which is essential for accurate calculation of kinetic energy and instantaneous pressure. For experts, this symplectic, time-reversible integrator is the standard in many MD codes because it facilitates the implementation of velocity-dependent algorithms like thermostats and barostats with high numerical stability. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002023 "velocity verlet integrator"@en)
SubClassOf(obo:MOLSIM_002023 obo:MOLSIM_001691)

# Class: obo:MOLSIM_002024 (brownian dynamics integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002024 "A numerical algorithm used to simulate the motion of particles in a fluid where friction dominates over inertia. It integrates the overdamped Langevin equation, assuming that the momenta relax instantaneously, so particle positions are updated based on forces and a random displacement derived from the diffusion coefficient. For experts, this integrator allows for much larger time steps than standard MD by ignoring fast inertial motions, making it ideal for simulating diffusion-controlled processes or coarse-grained systems. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002024 "brownian dynamics integrator"@en)
SubClassOf(obo:MOLSIM_002024 obo:MOLSIM_001691)

# Class: obo:MOLSIM_002025 (brownian dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002025 "A simulation method that models the movement of molecules as a random walk driven by thermal collisions and damped by solvent viscosity. Unlike standard molecular dynamics, it ignores the mass and inertia of the particles, assuming that friction brings them to a terminal velocity instantly in response to forces. For experts, this is the limit of Langevin dynamics where the friction coefficient is very large (overdamped regime), often used for simulating large biomolecules or coarse-grained models where solvent is treated implicitly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002025 "brownian dynamics"@en)
SubClassOf(obo:MOLSIM_002025 obo:MOLSIM_000843)

# Class: obo:MOLSIM_002026 (stochastic dynamics integrator)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002026 "A numerical algorithm that incorporates random noise and frictional drag directly into the equations of motion to mimic the effect of a solvent. It integrates the Langevin equation (or similar stochastic differential equations) to simultaneously propagate the system and control its temperature. For experts, this integrator (often GROMACS' sd integrator) acts as a local thermostat, ensuring correct canonical ensemble sampling without the synchronization artifacts sometimes seen with global thermostats like Berendsen or Nosé-Hoover. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002026 "stochastic dynamics integrator"@en)
SubClassOf(obo:MOLSIM_002026 obo:MOLSIM_001691)

# Class: obo:MOLSIM_002027 (triclinic box)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002027 "A triclinic box is a geometric shape for a periodic simulation cell defined by three vectors of arbitrary length and mutual angles. This flexibility allows it to represent any crystal lattice system or to optimize the solvent volume around a solute by fitting the box shape more closely than a standard cube."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002027 "triclinic box"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002027 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002027 obo:MOLSIM_000032)

# Class: obo:MOLSIM_002028 (stochastic cell rescaling barostat)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002028 "A pressure control algorithm that changes the box size according to an equation combining a steady restoring term with a random one. The random term is what makes it produce the correct distribution of volumes rather than merely the correct average. It reaches equilibrium quickly like the simple rescaling schemes while being correct like the deterministic ones. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002028 "stochastic cell rescaling barostat"@en)
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000247) obo:MOLSIM_002254 obo:MOLSIM_002028 "pcoupl=C-rescale")
AnnotationAssertion(Annotation(dcterms:source obo:MOLSIM_000217) obo:MOLSIM_002254 obo:MOLSIM_002028 "baro_stochastic=1")
SubClassOf(obo:MOLSIM_002028 obo:MOLSIM_000039)

# Class: obo:MOLSIM_002029 (integrator type)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002029 "A configuration parameter that specifies the numerical algorithm used to propagate the system's coordinates and velocities through time. It determines whether the simulation performs energy minimization (e.g., steepest descent), classical dynamics (e.g., leap-frog, velocity Verlet), or stochastic dynamics (e.g., Langevin). For experts, this setting (e.g., integrator in GROMACS, imin in AMBER) fundamentally defines the physics engine and the ensemble generated by the simulation executable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002029 "integrator type"@en)
SubClassOf(obo:MOLSIM_002029 obo:MOLSIM_001165)

# Class: obo:MOLSIM_002030 (trajectory output interval)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002030 "A simulation control parameter that dictates how frequently the system's atomic coordinates are written to the trajectory file during a run. It is defined as an integer representing the number of integration time steps between save events. For experts, variables like nstxout (GROMACS) or ntwx (AMBER) must be chosen to balance the need for high temporal resolution in analysis against data storage limits and I/O performance overhead. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002030 "trajectory output interval"@en)
SubClassOf(obo:MOLSIM_002030 obo:MOLSIM_002108)

# Class: obo:MOLSIM_002031 (temperature coupling groups)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002031 "A simulation setting that divides the molecular system into distinct subsets, such as \"Protein\" and \"Solvent,\" each regulated by its own independent thermostat. This separation ensures that energy is distributed evenly across components with different heating rates or degrees of freedom, preventing the \"hot solvent, cold solute\" artifact. For experts, correct assignment (e.g., tc-grps in GROMACS) is critical in non-periodic or vacuum simulations to prevent the accumulation of translational kinetic energy, known as the \"flying ice cube\" effect. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002031 "temperature coupling groups"@en)
SubClassOf(obo:MOLSIM_002031 obo:MOLSIM_001173)

# Class: obo:MOLSIM_002032 (cutoff scheme)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002032 "A configuration parameter that selects the algorithmic strategy used to generate neighbor lists and truncate non-bonded interactions. It dictates whether the neighbor search is performed based on individual atoms or charge-neutral groups, and how the buffer zone is managed to permit infrequent list updates. For experts, modern engines favor the \"Verlet\" scheme (buffered neighbor lists) over the legacy \"Group\" scheme, as the former supports efficient parallelization on GPUs and ensures better energy conservation with PME. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002032 "cutoff scheme"@en)
SubClassOf(obo:MOLSIM_002032 obo:MOLSIM_001185)

# Class: obo:MOLSIM_002033 (neighbor list cutoff)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002033 "A distance parameter that defines the radius of the sphere around an atom within which neighboring atoms are tracked for potential interactions. Atoms found within this distance are stored in a neighbor list, which allows the simulation to avoid calculating distances between distant atom pairs at every time step. For experts, this value (rlist) must be strictly larger than the interaction cutoff (rvdw + rlist_skin) to ensure that atoms diffusing into interaction range are accounted for between list updates. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002033 "neighbor list cutoff"@en)
SubClassOf(obo:MOLSIM_002033 obo:MOLSIM_001185)

# Class: obo:MOLSIM_002034 (velocity generation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002034 "A preparation step that assigns starting velocities to the atoms, drawn at random from the distribution appropriate to a chosen temperature. A structure alone carries no velocities, so they must come from somewhere before dynamics can begin. Drawing them from that distribution rather than setting them to zero is what lets the system reach the intended temperature quickly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002034 "velocity generation"@en)
SubClassOf(obo:MOLSIM_002034 obo:MOLSIM_001210)

# Class: obo:MOLSIM_002035 (spatial distribution function)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002035 "A function giving the density of a chosen atom or molecule at each point in the space around a reference molecule, relative to its average density in the bulk. Unlike a radial distribution function, which averages over all directions and returns a curve, it keeps the direction and returns a 3-dimensional map. That is what lets specific sites be seen, such as a water molecule that sits in the same pocket throughout a simulation. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002035 "SDF"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002035 "spatial distribution function"@en)
SubClassOf(obo:MOLSIM_002035 obo:MOLSIM_001421)

# Class: obo:MOLSIM_002036 (GROMACS portable energy format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002036 "A binary file format used by the GROMACS simulation package to store time-series data of system energies and thermodynamic properties. It records values such as potential energy components, temperature, pressure, and box dimensions at specified intervals in a portable, machine-independent format. For experts, this file (extension .edr) is accessed via the gmx energy tool to extract statistics or plotting data, and its binary nature ensures no loss of precision compared to text logs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002036 "GROMACS portable energy format"@en)
SubClassOf(obo:MOLSIM_002036 obo:MOLSIM_000439)

# Class: obo:MOLSIM_002037 (GROMACS index format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002037 "A text-based file format used by GROMACS to define specific subsets or groups of atoms within a molecular system. It lists atom indices assigned to named groups, allowing users to apply specific actions (like thermostatting, restraining, or analyzing) to just those selected parts. For experts, this file (extension .ndx) is generated by gmx make_ndx and is essential for setting up non-standard simulation protocols where default groups like \"Protein\" or \"Solvent\" are insufficient. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002037 "GROMACS index format"@en)
SubClassOf(obo:MOLSIM_002037 obo:MOLSIM_000437)

# Class: obo:MOLSIM_002038 (GROMACS portable input format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002038 "A binary file format used by GROMACS that creates a self-contained description of a simulation ready to be executed. It combines the atomic coordinates, velocities, molecular topology, and all simulation control parameters into a single, portable machine-readable file. For experts, this file (extension .tpr) is generated by the gmx grompp preprocessor and ensures consistency by validating that the structure matches the topology and parameters before the simulation engine is launched. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002038 "GROMACS portable input format"@en)
SubClassOf(obo:MOLSIM_002038 obo:MOLSIM_000441)

# Class: obo:MOLSIM_002039 (atom ID)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002039 "An atom ID is usually a number, that uniquely defines a given atom in a molecular structure. It is typically used in molecular topology descriptions to uniquely identify an atom from the set of atoms defining the system."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002039 orcid:0000-0003-4177-3619)
AnnotationAssertion(rdfs:label obo:MOLSIM_002039 "atom ID"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002039 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002039 obo:MOLSIM_000447)

# Class: obo:MOLSIM_002040 (JSmol)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002040 "JSmol is an open-source, HTML5/JavaScript-based molecular viewer that allows for the interactive 3D visualization of chemical structures within web browsers without requiring Java or other plugins. It is the modern, JavaScript implementation of the popular Jmol applet, widely used in chemical education, databases, and web-based cheminformatics tools."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002040 "JSmol"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002040 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002040 obo:MOLSIM_002041)

# Class: obo:MOLSIM_002041 (molecular structure visualization tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002041 "A visualization tool designed specifically to render and interactively display three-dimensional models of molecular structures, complexes, and dynamic simulation trajectories. These tools are used to visually inspect atomic coordinates, molecular surfaces, and spatial relationships."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002041 "molecular structure visualization tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002041 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002041 obo:MOLSIM_000163)

# Class: obo:MOLSIM_002042 (data plotting tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002042 "A visualization tool designed to generate 2D or 3D graphs, charts, and plots from numerical data files."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002042 "data visualization tool"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002042 "data plotting tool"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002042 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002042 obo:MOLSIM_000163)

# Class: obo:MOLSIM_002043 (CAMPARI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002043 "A simulation program that performs both molecular dynamics and Monte Carlo sampling of biological macromolecules. It is used particularly for intrinsically disordered proteins, where no single structure exists and broad sampling matters more than speed. Its Monte Carlo moves can change a chain's shape in ways dynamics would take far longer to reach. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002043 "CAMPARI"@en)
SubClassOf(obo:MOLSIM_002043 obo:MOLSIM_000160)

# Class: obo:MOLSIM_002044 (HIP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002044 "A programming interface, developed by AMD, that lets the same source code run on graphics processors from more than one manufacturer. It closely mirrors the interface used for NVIDIA hardware, so existing code can be converted with little change. It exists so that a simulation engine need not be maintained twice. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002044 "HIP"@en)
SubClassOf(obo:MOLSIM_002044 obo:MOLSIM_001562)

# Class: obo:MOLSIM_002045 (SYCL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002045 "A standard C++ layer that lets code for processors of different kinds be written as ordinary single-source C++, with the device parts compiled out of the same file. It removes the separate device language that earlier portable interfaces required. It is the route several simulation engines have taken to support more than one manufacturer's accelerators. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002045 "SYCL"@en)
SubClassOf(obo:MOLSIM_002045 obo:MOLSIM_001562)

# Class: obo:MOLSIM_002046 (OpenCL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002046 "An open standard for writing programs that run across processors of different kinds, including central processors, graphics processors and specialised accelerators. One program can then use whatever hardware is present. Its portability comes at some cost in speed against an interface written for one manufacturer. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002046 "open computing language"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002046 "OpenCL"@en)
SubClassOf(obo:MOLSIM_002046 obo:MOLSIM_001562)

# Class: obo:MOLSIM_002047 (OpenMPI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002047 "An open-source implementation of the message passing standard, assembled from several earlier projects and designed to support many kinds of network hardware. It is the other of the 2 implementations in general use. Which one a simulation was built against is part of reproducing its performance, though not its results. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002047 "OpenMPI"@en)
SubClassOf(obo:MOLSIM_002047 obo:MOLSIM_001566)

# Class: obo:MOLSIM_002048 (MPICH)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002048 "An open-source implementation of the message passing standard, used directly and also as the basis several hardware vendors build their own versions on. It is one of the 2 implementations nearly all clusters use. Its performance depends heavily on the network hardware it is configured for. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002048 "MPICH"@en)
SubClassOf(obo:MOLSIM_002048 obo:MOLSIM_001566)

# Class: obo:MOLSIM_002049 (AutoDock)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002049 "AutoDock is a suite of automated docking tools designed to predict how small molecules bind to a receptor of known 3D structure. AutoDock (e.g., AutoDock 4) utilizes a Lamarckian genetic algorithm and a grid-based empirical scoring function."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002049 "AutoDock"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002049 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002049 obo:MOLSIM_000162)

# Class: obo:MOLSIM_002050 (GOLD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002050 "GOLD (Genetic Optimisation for Ligand Docking) is a highly regarded commercial docking program developed by the Cambridge Crystallographic Data Centre (CCDC). It uses a genetic algorithm to explore ligand conformational space and offers multiple scoring functions. It is frequently used in pharmaceutical pipelines to generate highly accurate protein-ligand complex structures for subsequent MD refinement."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002050 "Genetic Optimisation for Ligand Docking"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002050 "GOLD"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002050 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002050 obo:MOLSIM_000162)

# Class: obo:MOLSIM_002051 (Glide)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002051 "Glide (Grid-based Ligand Docking with Energetics) is a commercial molecular docking program within the Schrödinger software suite. It uses a systematic, hierarchical search of positional, orientational, and conformational space followed by evaluation with an empirical scoring function. It is heavily utilized in industry for virtual screening and preparing complexes for Desmond MD simulations."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002051 "Grid-based Ligand Docking with Energetics"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002051 "Glide"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002051 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002051 obo:MOLSIM_000162)

# Class: obo:MOLSIM_002052 (rDock)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002052 "A molecular docking program that predicts how a small molecule will bind to a protein or a nucleic acid, and scores how well it fits. It searches for good positions using a mix of random and directed steps, which lets it cover many possibilities without testing them all. It was one of the first docking programs built to handle nucleic acid targets as well as proteins. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002052 "rDock"@en)
SubClassOf(obo:MOLSIM_002052 obo:MOLSIM_000162)

# Class: obo:MOLSIM_002053 (adaptive biasing force algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002053 "An enhanced sampling algorithm used in molecular dynamics to calculate free energy profiles and accelerate the sampling of complex molecular systems. By continuously applying an on-the-fly biasing force, ABF allows systems to escape kinetic traps and evenly explore reaction pathways."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002053 "ABF algorithm"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002053 "adaptive biasing force algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002053 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002053 obo:MOLSIM_001740)

# Class: obo:MOLSIM_002054 (Wang-Landau algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002054 "Wang-Landau algorithm simulations are a class of flat-histogram Monte Carlo methods designed to directly estimate the density of states (DOS) of a physical or mathematical system. Unlike traditional methods dependent on temperature, it generates a random walk in energy space that allows you to calculate thermodynamic properties across all temperatures."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002054 "Wang-Landau algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002054 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002054 obo:MOLSIM_001740)

# Class: obo:MOLSIM_002055 (well-tempered metadynamics algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002055 "A specific algorithmic extension of metadynamics where the height of the added Gaussian biasing potentials is gradually decreased over time based on the amount of bias already accumulated at that location. This ensures that the biasing potential converges smoothly to the true free energy surface, avoiding the over-filling of energy basins."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002055 "well-tempered metadynamics algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002055 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002055 obo:MOLSIM_001740)

# Class: obo:MOLSIM_002056 (steered molecular dynamics algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002056 "An algorithm that applies a time-dependent, usually harmonic, guiding potential to specific atoms or collective variables. It calculates the necessary biasing forces to force the system to evolve along a predefined reaction coordinate, simulating non-equilibrium processes like ligand unbinding or protein unfolding."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002056 "SMD algorithm"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002056 "steered molecular dynamics algorithm"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002056 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002056 obo:MOLSIM_001740)

# Class: obo:MOLSIM_002057 (multiple-walkers metadynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002057 "An enhanced sampling simulation method and a specific variant of metadynamics where multiple independent simulations (walkers) are run in parallel. All walkers simultaneously explore the conformational space and deposit Gaussian bias potentials into a single, shared history-dependent bias grid. This approach significantly accelerates the reconstruction of complex free energy surfaces while maintaining the exact theoretical accuracy of standard metadynamics."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002057 "MWMD"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002057 "multiple-walkers metadynamics"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002057 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002057 obo:MOLSIM_000852)

# Class: obo:MOLSIM_002058 (PDBQT format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002058 "The PDBQT format is an extension of the standard PDB format specifically designed for use with the AutoDock and AutoDock Vina molecular docking suites. In addition to atomic coordinates, it stores calculated partial charges ('Q') and AutoDock-specific atom types ('T'), making it a structural format that intrinsically carries the predictive interaction parameters required for, and generated by, docking algorithms."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002058 "PDBQT format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002058 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002058 obo:MOLSIM_000715)
SubClassOf(obo:MOLSIM_002058 obo:MOLSIM_001088)

# Class: obo:MOLSIM_002059 (PROPKA output format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002059 "A text data format recording the predicted acidity of each titratable group in a protein, together with the structural reasons for each prediction. It lists the contributions separately, such as burial from solvent and nearby charges, so a prediction can be checked rather than taken on trust. It is normally written with the extension .pka. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002059 "pka format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002059 "PROPKA output format"@en)
SubClassOf(obo:MOLSIM_002059 obo:MOLSIM_000715)

# Class: obo:MOLSIM_002060 (docking log format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002060 "A docking log format is a text-based or tabular file generated by molecular docking software (such as AutoDock Vina, Glide, or GOLD) to record the numerical results of a virtual screening or pose prediction run. It typically contains ranked lists of predicted binding poses, estimated binding affinities or docking scores, and clustering metrics like RMSD, serving as the primary predictive output for analyzing binding without needing to parse the 3D structure files."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002060 "docking log format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002060 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002060 obo:MOLSIM_000715)

# Class: obo:MOLSIM_002061 (PAE matrix format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002061 "A data format, usually written as JSON, that stores the predicted aligned error matrix from a deep learning protein structure prediction. Entry X,Y gives the expected error in the position of residue X when the predicted and true structures are superposed on residue Y. It is how the confidence in relative domain orientation and in predicted interfaces is judged, which a per-residue confidence score cannot show. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002061 "Predicted Aligned Error matrix format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002061 "PAE matrix format"@en)
SubClassOf(obo:MOLSIM_002061 obo:MOLSIM_000715)

# Class: obo:MOLSIM_002062 (Maestro format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002062 "The Maestro format (typically .mae or .maegz) is the native, proprietary text-based format developed by Schrödinger software suite, used to store molecular structures along with associated properties."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002062 "mae format"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002062 "maegz format"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002062 "Maestro format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002062 orcid:0000-0002-8291-8071)
SubClassOf(obo:MOLSIM_002062 obo:MOLSIM_000715)
SubClassOf(obo:MOLSIM_002062 obo:MOLSIM_001088)

# Class: obo:MOLSIM_002063 (metropolis Monte Carlo)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002063 "A sampling algorithm that proposes a random change to a system and accepts it always if the energy falls, and with a probability depending on the energy rise if it does not. Repeating this generates configurations in the right proportions for the temperature, without ever computing a force. It samples equilibrium properties correctly but says nothing about how fast anything happens. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002063 "metropolis Monte Carlo"@en)
SubClassOf(obo:MOLSIM_002063 obo:MOLSIM_001740)

# Class: obo:MOLSIM_002064 (mdrun)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002064 "A simulation engine, the program in the GROMACS suite that performs the simulation itself. It reads a single pre-compiled input file holding the system, the parameters and the starting state, and writes the trajectory. Every other GROMACS program prepares its input or analyses its output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002064 "mdrun"@en)
SubClassOf(obo:MOLSIM_002064 obo:MOLSIM_000160)

# Class: obo:MOLSIM_002065 (simulation parameter format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002065 "A data format that specifies the control variables, algorithmic settings, and thermodynamic conditions required to execute a computational simulation run. It dictates exactly how the simulation engine will propagate the system over time, defining parameters such as the integration algorithm, time step, total duration, non-bonded cutoff distances, and the specific thermostat and barostat algorithms used for temperature and pressure coupling. For experts, files in this format (such as GROMACS .mdp or AMBER mdin) define the physical ensemble and numerical methods of the computational experiment, acting as the primary instruction set for the core molecular dynamics engine. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002065 "simulation parameter format"@en)
SubClassOf(obo:MOLSIM_002065 obo:MOLSIM_000437)

# Class: obo:MOLSIM_002066 (force field parameter format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002066 "A data format that stores the numerical coefficients and empirical rules defining the potential energy function of a molecular mechanics force field. It contains the specific values needed to calculate interactions between atom types, including equilibrium lengths and force constants for bonded terms (bonds, angles, dihedrals), as well as Lennard-Jones parameters and partial charges for non-bonded terms. For experts, these files (such as AMBER .dat/.frcmod or CHARMM .par) supply the fundamental physical constants required by the simulation engine to compute interatomic forces, and are kept strictly distinct from the molecular coordinates or run control settings. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002066 "force field parameter format"@en)
SubClassOf(obo:MOLSIM_002066 obo:MOLSIM_000437)

# Class: obo:MOLSIM_002067 (simulation environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002067 "A simulation environment represents the overall physical medium or surrounding context in which the primary molecular system is embedded during a computational study. It defines the macroscopic nature of the system's surroundings, such as whether the molecule is in a vacuum, dissolved in a liquid, or embedded in a lipid bilayer."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002067 "simulation environment"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002067 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002067 obo:MOLSIM_000006)

# Class: obo:MOLSIM_002068 (vacuum environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002068 "An environment in which a molecule is simulated entirely on its own, with nothing around it. Without solvent a molecule collapses on itself, because the non-polar groups that would avoid water have nothing to avoid. It is used for parameterisation and for comparison with gas-phase measurements, not to represent biological conditions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002068 "vacuum environment"@en)
SubClassOf(obo:MOLSIM_002068 obo:MOLSIM_002067)

# Class: obo:MOLSIM_002069 (solvated environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002069 "A solvated environment is a simulation context in which the primary solute molecule is completely surrounded by a liquid medium composed of solvent molecules. This environment is characterized by bulk liquid properties such as density, viscosity, and a specific dielectric constant. Simulating molecules in a solvated environment is essential for capturing the thermodynamic and structural effects of solvent interactions, which heavily dictate biomolecular folding and binding."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002069 "solvated environment"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002069 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002069 obo:MOLSIM_002067)

# Class: obo:MOLSIM_002070 (aqueous environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002070 "A solvated environment in which the liquid is water, alone or nearly so. It is the setting almost all biological molecules exist in, so it is the default choice for a biomolecular simulation. The behaviour of water near a surface differs enough from bulk water that the amount included matters. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002070 "aqueous environment"@en)
SubClassOf(obo:MOLSIM_002070 obo:MOLSIM_002069)

# Class: obo:MOLSIM_002071 (non-aqueous environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002071 "A solvated environment in which the liquid is something other than water, such as methanol, chloroform or octanol. These solvents differ from water in polarity and in their ability to form hydrogen bonds, so a molecule adopts different shapes in them. Simulations in octanol are used to predict how a drug will partition between water and fat. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002071 "non-aqueous environment"@en)
SubClassOf(obo:MOLSIM_002071 obo:MOLSIM_002069)

# Class: obo:MOLSIM_002072 (membrane environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002072 "A membrane environment is a highly anisotropic, heterogeneous simulation context representing a cellular membrane, typically composed of a self-assembled lipid bilayer separating two aqueous compartments. It features a hydrophobic core and polar interfacial regions. Modeling a membrane environment is essential for simulating the structure, dynamics, and transport mechanisms of transmembrane proteins, ion channels, and membrane-active peptides or drugs."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002072 "membrane environment"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002072 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002072 obo:MOLSIM_002067)

# Class: obo:MOLSIM_002073 (crystal lattice environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002073 "An environment in which molecules are packed in a regular repeating arrangement fixed by a crystallographic space group, as in a solid. Neighbouring molecules constrain each other, so shapes seen here may not be those the molecule takes in solution. Simulating it is how a crystal structure is checked against the conditions it was measured in. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002073 "crystal lattice environment"@en)
SubClassOf(obo:MOLSIM_002073 obo:MOLSIM_002067)

# Class: obo:MOLSIM_002074 (interfacial environment)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002074 "An interfacial environment is a simulation context characterized by the boundary or interface between two distinct physical phases, such as a liquid-vapor (water-air) interface or a liquid-solid interface. The physical properties of the system change drastically across this boundary."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002074 "interfacial environment"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002074 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_002074 obo:MOLSIM_002067)

# Class: obo:MOLSIM_002075 (conformational ensemble)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002075 "A dataset consisting of a collection of distinct molecular structures or conformations. Unlike a simulation trajectory, it does not inherently possess a chronological order, but rather represents a sampling of the structurally accessible states of a molecule (e.g., an NMR structural ensemble, or representative frames extracted via clustering). (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002075 "structural ensemble"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002075 "conformational ensemble"@en)
SubClassOf(obo:MOLSIM_002075 obo:IAO_0000030)

# Class: obo:MOLSIM_002076 (molecular mechanics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002076 "A computational method that models molecules using classical physics, treating atoms as particles and bonds as springs, with the energy given by a fitted set of functions called a force field. Electrons never appear, so the method cannot describe a bond being made or broken. What it buys by that omission is speed: systems of hundreds of thousands of atoms become affordable. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002076 "MM"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002076 "molecular mechanics method"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002076 "molecular mechanics"@en)
SubClassOf(obo:MOLSIM_002076 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002077 (empirical scoring method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002077 "A method that estimates binding strength by adding up contributions from countable features of a complex, such as hydrogen bonds, buried surface and rotatable bonds, with weights fitted to measured affinities. It computes no physics, which is what makes it fast enough to rank millions of candidates. It ranks far better than it predicts, so its numbers should not be read as energies. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002077 "empirical scoring function"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002077 "empirical scoring method"@en)
SubClassOf(obo:MOLSIM_002077 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002078 (implicit solvent method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002078 "A modelling method that represents the effect of a surrounding liquid as a continuous medium instead of as individual molecules. It computes solvation free energy from the shape and charges of the solute using parameters such as atomic radii and a surface tension coefficient. It removes most of the atoms from a simulation, which makes it far faster but blind to any effect that depends on a specific solvent molecule. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002078 "continuum solvation model"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002078 "implicit solvent method"@en)
SubClassOf(obo:MOLSIM_002078 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002079 (elastic network modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002079 "A modelling method that represents a macromolecule as nodes, usually 1 per residue, joined by simple springs between neighbours within a cutoff distance. It discards chemistry entirely and keeps only shape and connectivity, which is enough to reproduce large-scale collective motion. It is cheap enough to apply to assemblies far too large to simulate. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002079 "ENM"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002079 "elastic network modeling"@en)
SubClassOf(obo:MOLSIM_002079 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002080 (quantitative structure-activity relationship modeling)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002080 "A modelling method that predicts a molecule's biological effect from numbers computed about its chemical structure. It fits a statistical relationship on compounds whose activity is known, then applies it to compounds whose activity is not. It predicts well only for molecules resembling the training set, which is why the range it was fitted over must be reported with it. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002080 "QSAR"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002080 "quantitative structure-activity relationship modeling"@en)
SubClassOf(obo:MOLSIM_002080 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002081 (machine-learned potential method)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002081 "A computational method that predicts the energy and forces of a system using a model trained on quantum mechanical calculations, instead of a fitted analytical force field. It aims for quantum accuracy at a cost close to a force field's. It is reliable only for systems resembling those it was trained on, which is its central limitation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002081 "machine-learned potential method"@en)
SubClassOf(obo:MOLSIM_002081 obo:MOLSIM_000841)

# Class: obo:MOLSIM_002082 (secondary structure change)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002082 "A local change in which a stretch of a protein or nucleic acid chain switches from one regular repeating shape to another, or to no regular shape at all. It happens by breaking and remaking the hydrogen bonds between nearby parts of the backbone, for example when a helix unwinds into a loop. It is local, so the rest of the molecule can stay as it was. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002082 "secondary structure change"@en)
SubClassOf(obo:MOLSIM_002082 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002083 (folding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002083 "The process by which a linear chain of amino acids or nucleotides collapses into the compact 3-dimensional shape it needs to work. It is driven by non-polar groups avoiding water, by hydrogen bonds forming, and by charges attracting or repelling. Simulating it is hard because the process is slow on the scale a simulation can reach, yet the chain must find 1 shape among an enormous number. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002083 "folding"@en)
SubClassOf(obo:MOLSIM_002083 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002084 (unfolding)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002084 "The process by which a structured molecule loses its working 3-dimensional shape and becomes a disordered chain. It happens when the many weak interactions holding the structure together are disrupted at once, by heat, pressure, a change in acidity, or a chemical that competes for them. It is often simulated instead of folding, because it can be driven to happen fast enough to watch. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002084 "unfolding"@en)
SubClassOf(obo:MOLSIM_002084 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002085 (domain motion)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002085 "A collective motion in which a whole folded region of a protein shifts or rotates relative to the rest. It usually happens by bending or twisting at a hinge joining 2 more rigid regions. It is the kind of motion that opens and closes a binding site. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002085 "domain motion"@en)
SubClassOf(obo:MOLSIM_002085 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002086 (allosteric transition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002086 "A structural change in which something happening at one site on a molecule alters how a distant site behaves. The effect travels through the molecule along connected, coupled motions rather than through direct contact. It is how a molecule binding at one place can switch activity on or off somewhere else entirely. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002086 "allosteric transition"@en)
SubClassOf(obo:MOLSIM_002086 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002087 (ligand-induced allosteric transition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002087 "An allosteric transition set off by a small molecule binding at one site, which changes behaviour at a distant one. The effect travels through connected motions in the structure rather than through direct contact. It is how a drug can switch a protein's activity without touching its active site. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002087 "ligand-induced allosteric transition"@en)
SubClassOf(obo:MOLSIM_002087 obo:MOLSIM_002086)

# Class: obo:MOLSIM_002088 (entropy-driven allosteric transition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002088 "An allosteric transition in which the signal is carried by a change in flexibility rather than by a change in average shape. A perturbation at one site alters how much a distant site fluctuates, which changes its affinity without moving it. Because the average structure barely changes, crystallography alone cannot detect it. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002088 "entropy-driven allosteric transition"@en)
SubClassOf(obo:MOLSIM_002088 obo:MOLSIM_002086)

# Class: obo:MOLSIM_002089 (sugar ring pucker transition)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002089 "A conformational rearrangement in which the five-membered sugar ring of a nucleotide shifts between different non-planar shapes. In nucleic acids, this commonly involves transitions between North (C3′-endo-like) and South (C2′-endo-like) conformations, affecting local backbone geometry. Correctly reproducing these populations is an important test of nucleic-acid force fields and helps distinguish A- and B-form helices."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002089 "sugar ring flip"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002089 "sugar ring pucker transition"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002089 orcid:0000-0002-4303-9349)
SubClassOf(obo:MOLSIM_002089 obo:MOLSIM_001793)

# Class: obo:MOLSIM_002090 (molecular structural component)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002090 "A physical constituent of a simulated molecular system that is treated as a distinct unit with its own properties and spatial coordinates. It covers atoms, ions, residues, polymer chains and whole molecules. (UNVERIFIED)"@en)
AnnotationAssertion(obo:IAO_0000116 obo:MOLSIM_002090 "Top-level parent for the structural components of a simulated system. Kept as a MOLSIM class rather than reusing CHEBI:23367 molecular entity, because this branch spans 2 ChEBI branches that do not meet: atom and molecule are molecular entities in ChEBI, while residue and chain sit under CHEBI:24433 group, a sibling of molecular entity. Grouping all 4 suits the description of a coordinate file, where they are 4 levels of one containment hierarchy. Renamed from 'molecular entity' on 2026-08-21 so that the primary label is unique across the ontologies MOLSIM is released alongside; the former name is kept as an exact synonym."@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002090 "molecular entity"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002090 "molecular structural component"@en)

# Class: obo:MOLSIM_002091 (residue)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002091 "A single building block within a polymer chain, such as one amino acid in a protein or one nucleotide in a nucleic acid. It is a group of atoms that share an identifier and are handled together, so a structure file can refer to \"residue 45\" rather than to each of its atoms. Most analyses work at this level, because it matches how biologists talk about a structure. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002091 "residue"@en)
SubClassOf(obo:MOLSIM_002091 obo:MOLSIM_002090)

# Class: obo:MOLSIM_002092 (atom)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002092 "The smallest unit of a chemical element, and the smallest particle a classical molecular simulation tracks. In such a simulation it is represented as a point carrying a mass, a partial electric charge and a radius, all taken from the force field rather than computed. Everything else in a simulated system is built from these points and the bonds between them. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002092 "atom"@en)
SubClassOf(obo:MOLSIM_002092 obo:MOLSIM_002090)

# Class: obo:MOLSIM_002093 (chain)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002093 "A continuous run of residues joined by covalent bonds and labelled with a single identifier in a structure file, such as one strand of DNA or one polypeptide. The identifier is what separates the subunits of a complex from one another. Getting it wrong joins 2 separate molecules into 1 in the eyes of every tool that reads the file. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002093 "chain"@en)
SubClassOf(obo:MOLSIM_002093 obo:MOLSIM_002090)

# Class: obo:MOLSIM_002094 (molecular unit)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002094 "A chemical unit composed of two or more atoms bonded together, or a single monoatomic ion counted as one. In computational chemistry, it represents a complete, covalently continuous structure—ranging from a single solvent molecule to a massive protein—that does not share covalent bonds with other entities in the system. For simulation experts, defining individual molecules is necessary for applying periodic boundary imaging, managing solvent dynamics, and computing macroscopic thermodynamic properties like diffusion. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002094 "molecule"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002094 "molecular unit"@en)
SubClassOf(obo:MOLSIM_002094 obo:MOLSIM_002090)

# Class: obo:MOLSIM_002095 (pocket detection tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002095 "A pocket detection tool a computational algorithm that identifies and characterizes transient or persistent cavities on the surface of a biomolecular structure from a trajectory or static coordinate set, typically by analyzing atomic coordinates, solvent accessibility, or geometric properties, to predict potential ligand-binding sites and assess their dynamic accessibility and druggability."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002095 orcid:0000-0002-2294-5393)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_002095 "cavity detection tool"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002095 "pocket detection tool"@en)
SubClassOf(obo:MOLSIM_002095 obo:MOLSIM_000164)

# Class: obo:MOLSIM_002096 (fpocket)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002096 "fpocket is a fast, open-source algorithm designed to predict and analyze potential binding pockets (cavities) on proteins and other biomolecules. It is used in structural bioinformatics for applications like drug discovery, protein function annotation, and the analysis of molecular dynamics trajectories."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002096 orcid:0000-0002-2294-5393)
AnnotationAssertion(rdfs:label obo:MOLSIM_002096 "fpocket"@en)
SubClassOf(obo:MOLSIM_002096 obo:MOLSIM_002095)

# Class: obo:MOLSIM_002097 (Curves+)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002097 "Curves+ is a software program for the structural analysis of DNA and RNA three-dimensional structures. It calculates a comprehensive set of geometric parameters describing nucleic acid conformation, including base-pair, base-pair step, backbone, groove, and helical axis parameters, using a reference frame attached to each base. These descriptors provide a detailed characterization of nucleic acid structure and flexibility."@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002097 orcid:0000-0002-7544-0938)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002097 orcid:0000-0002-4303-9349)
AnnotationAssertion(rdfs:label obo:MOLSIM_002097 "Curves+"@en)
SubClassOf(obo:MOLSIM_002097 obo:MOLSIM_001960)

# Class: obo:MOLSIM_002098 (restart simulation process)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002098 "An execution that resumes a previously interrupted or completed molecular dynamics run by reading saved coordinates, velocities, and simulation state from a restart file. It allows a long simulation to be continued across multiple sessions without loss of continuity. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002098 "restart simulation process"@en)
SubClassOf(obo:MOLSIM_002098 obo:MOLSIM_000003)

# Class: obo:MOLSIM_002099 (metadata extraction tool)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002099 "A data processing tool that reads simulation input, output, or trajectory files and extracts descriptive metadata such as system composition, run settings, and provenance information. It supports cataloguing and FAIR annotation of simulation datasets. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002099 "metadata extraction tool"@en)
SubClassOf(obo:MOLSIM_002099 obo:MOLSIM_000165)

# Class: obo:MOLSIM_002100 (PMEMD.cuda)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002100 "A build of the AMBER simulation engine that runs on NVIDIA graphics processors. It performs the whole simulation on the graphics card, so data need not be moved back and forth each step, which is where the speed comes from. It supports fewer methods than the processor build, so which was used should be recorded. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002100 "PMEMD.cuda"@en)
SubClassOf(obo:MOLSIM_002100 obo:MOLSIM_001669)

# Class: obo:MOLSIM_002101 (metadata validation process)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002101 "A validation analysis that checks recorded or extracted metadata for completeness, correctness, and internal consistency against expected schemas or physical constraints. It helps ensure that a simulation dataset is reliably described before it is shared or archived. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002101 "metadata validation process"@en)
SubClassOf(obo:MOLSIM_002101 obo:MOLSIM_000353)

# Class: obo:MOLSIM_002102 (coordinate wrapping process)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002102 "A trajectory post-processing that translates atomic coordinates back into the primary periodic unit cell."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002102 "coordinate wrapping process"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002102 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002102 obo:MOLSIM_001767)

# Class: obo:MOLSIM_002103 (NMR restrained simulation)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002103 "A restrained simulation method that biases the dynamics using experimental nuclear magnetic resonance observables, such as interatomic distance restraints from nuclear Overhauser effects or torsion-angle restraints from scalar couplings. It guides the simulated structure toward conformations consistent with the measurements. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002103 "NMR restrained simulation"@en)
SubClassOf(obo:MOLSIM_002103 obo:MOLSIM_000364)

# Class: obo:MOLSIM_002104 (belly dynamics)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002104 "A restrained subset dynamics in which only a selected group of atoms is allowed to move while the remaining atoms are held fixed throughout the run. It reduces computational cost and focuses sampling on a region of interest, taking its name from the Amber convention of designating a mobile region. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002104 "belly dynamics"@en)
SubClassOf(obo:MOLSIM_002104 obo:MOLSIM_000335)

# Class: obo:MOLSIM_002105 (replica exchange attempt frequency)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002105 "An enhanced sampling parameter that specifies how often exchanges between neighboring replicas are attempted during a replica exchange simulation. It controls the rate at which configurations are swapped between conditions such as different temperatures. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002105 "replica exchange attempt frequency"@en)
SubClassOf(obo:MOLSIM_002105 obo:MOLSIM_001219)

# Class: obo:MOLSIM_002106 (center of mass removal interval)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002106 "An integration parameter that specifies how frequently the net translational motion of the system's center of mass is removed during a run. Periodic removal prevents the gradual accumulation of spurious overall drift of the simulated system. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002106 "center of mass removal interval"@en)
SubClassOf(obo:MOLSIM_002106 obo:MOLSIM_001165)

# Class: obo:MOLSIM_002107 (multi-timestep inner loop count)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002107 "An integration parameter that specifies how many short inner integration steps are taken per long outer step in a multiple-timestep integration scheme. It sets how often fast-varying forces are evaluated relative to slow-varying forces to improve computational efficiency. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002107 "multi-timestep inner loop count"@en)
SubClassOf(obo:MOLSIM_002107 obo:MOLSIM_001165)

# Class: obo:MOLSIM_002108 (output control parameter)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002108 "A simulation parameter that governs how frequently and in what form simulation data are written to output files during a run. It determines the temporal resolution and volume of the recorded energies, coordinates, and diagnostic information. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002108 "output control parameter"@en)
SubClassOf(obo:MOLSIM_002108 obo:MOLSIM_001164)

# Class: obo:MOLSIM_002109 (energy output interval)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002109 "An output control parameter that specifies how often energy and related thermodynamic quantities are written to the output or log during a run. Smaller intervals give finer-grained monitoring at the cost of larger output files. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002109 "energy output interval"@en)
SubClassOf(obo:MOLSIM_002109 obo:MOLSIM_002108)

# Class: obo:MOLSIM_002110 (restart output interval)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002110 "An output control parameter that specifies how often a restart file containing the current coordinates, velocities, and state is written during a run. It determines how much progress can be recovered if the run is interrupted. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002110 "restart output interval"@en)
SubClassOf(obo:MOLSIM_002110 obo:MOLSIM_002108)

# Class: obo:MOLSIM_002111 (log output interval)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002111 "An output control parameter that specifies how often diagnostic and status information is written to the simulation log during a run. It controls the verbosity and temporal resolution of the recorded run history. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002111 "log output interval"@en)
SubClassOf(obo:MOLSIM_002111 obo:MOLSIM_002108)

# Class: obo:MOLSIM_002112 (simulation state time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002112 "A simulation state that represents the elapsed model time reached by the system at a given point in a molecular dynamics run. It records how far the simulation has advanced along the physical time coordinate."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002112 "simulation state time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002112 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002112 obo:MOLSIM_001083)
SubClassOf(obo:MOLSIM_002112 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002112 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002113 (final density)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002113 "A thermodynamic property that represents the mass density of the simulated system at the end of a run or equilibration stage. It is commonly compared against experimental density to assess whether the system has equilibrated correctly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002113 "final density"@en)
SubClassOf(obo:MOLSIM_002113 obo:MOLSIM_001293)
SubClassOf(obo:MOLSIM_002113 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000052))
SubClassOf(obo:MOLSIM_002113 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002114 (computational performance metric)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002114 "A computed observable that quantifies the computational cost or efficiency of a simulation run rather than a physical property of the system. Examples include elapsed real time and the amount of simulated time produced per unit of computing time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002114 "computational performance metric"@en)
SubClassOf(obo:MOLSIM_002114 obo:MOLSIM_001292)

# Class: obo:MOLSIM_002115 (total wallclock time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002115 "A computational performance metric that measures the total real-world elapsed time taken to complete a run from start to finish. It reflects the actual time a user waits, including all computation and input or output. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002115 "total wallclock time"@en)
SubClassOf(obo:MOLSIM_002115 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002115 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002115 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002116 (total cpu time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002116 "A computational performance metric that measures the cumulative processor time consumed by a run, summed across all active compute cores. It reflects total computational effort rather than elapsed real time. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002116 "total cpu time"@en)
SubClassOf(obo:MOLSIM_002116 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002116 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002116 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002117 (setup wallclock time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002117 "A computational performance metric that measures the real-world elapsed time spent preparing a run before the production phase begins, such as reading inputs and building data structures. It isolates initialization overhead from the main computation."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002117 "setup wallclock time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002117 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002117 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002117 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002117 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002118 (production wallclock time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002118 "A computational performance metric that measures the real-world elapsed time spent in the production phase of a simulation run, during which the trajectory of interest is generated. It excludes setup and finalization overhead."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002118 "production wallclock time"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_002118 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_002118 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002118 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002118 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002119 (average integration step time)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002119 "A computational performance metric that represents the mean real-world time required to advance the simulation by one integration step. It is a convenient measure of per-step computational efficiency. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002119 "average integration step time"@en)
SubClassOf(obo:MOLSIM_002119 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002119 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000003))
SubClassOf(obo:MOLSIM_002119 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_002120 (simulation throughput)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_002120 "A computational performance metric that expresses how much simulated model time is produced per unit of real-world computing time, commonly reported as nanoseconds per day. It is a standard measure for comparing the practical speed of simulations. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_002120 "simulation throughput"@en)
SubClassOf(obo:MOLSIM_002120 obo:MOLSIM_002114)
SubClassOf(obo:MOLSIM_002120 ObjectAllValuesFrom(obo:IAO_0000039 obo:UO_0000280))
SubClassOf(obo:MOLSIM_002120 DataAllValuesFrom(obo:IAO_0000004 xsd:decimal))

# Class: obo:MOLSIM_010011 (Kabsch RMSD algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010011 "An algorithm that finds the rotation bringing 2 matched sets of points into the closest possible agreement, by decomposing the matrix of their cross-correlations. It gives the rotation only, so the 2 sets must already have been centred on their averages. It is the standard way structures are superposed before any difference between them is measured. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010011 "Kabsch RMSD algorithm"@en)
SubClassOf(obo:MOLSIM_010011 obo:MOLSIM_001717)

# Class: obo:MOLSIM_010012 (STRIDE algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010012 "An algorithm that assigns secondary structure to each residue of a protein from its atomic coordinates. It combines hydrogen bond energies with backbone angle preferences, where the older DSSP method uses hydrogen bonds alone. The extra criterion makes its assignments agree more closely with those a crystallographer would make by eye. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010012 "STRIDE algorithm"@en)
SubClassOf(obo:MOLSIM_010012 obo:MOLSIM_001745)

# Class: obo:MOLSIM_010013 (gaussian mixture model algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010013 "A statistical algorithm that describes a distribution as a weighted sum of several bell-shaped components, fitting the position, width and weight of each. It suits data made of several overlapping groups, where one component would fit none of them. Each component can then be treated as a conformational state. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010013 "Gaussian mixture model algorithm"@en)
SubClassOf(obo:MOLSIM_010013 obo:MOLSIM_001751)

# Class: obo:MOLSIM_010014 (parametric distribution fitting algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010014 "A statistical algorithm that fits a chosen family of distributions to data by finding the parameter values that make the data most likely, or most probable given a prior. Assuming a family lets a whole distribution be summarised by 2 or 3 numbers. The assumption is also the weakness: if the data do not follow that family, the fit is confidently wrong. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010014 "parametric distribution fitting algorithm"@en)
SubClassOf(obo:MOLSIM_010014 obo:MOLSIM_001751)

# Class: obo:MOLSIM_010015 (spline-based estimation algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010015 "A statistical algorithm that estimates a distribution by fitting smooth polynomial pieces joined at chosen points, rather than assuming a named family. It can follow a shape that no standard distribution matches. Its accuracy depends on how many joining points are used, which must be chosen to avoid following noise. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010015 "spline-based estimation algorithm"@en)
SubClassOf(obo:MOLSIM_010015 obo:MOLSIM_001751)

# Class: obo:MOLSIM_010016 (Shrake-Rupley algorithm)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010016 "An algorithm that computes the surface area of a molecule reachable by solvent, by placing test points over each atom's surface and counting those not buried by neighbouring atoms. The test points approximate rolling a solvent-sized sphere over the molecule. Its accuracy depends on how many test points are used, which is the one setting it has. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010016 "Shrake-Rupley algorithm"@en)
SubClassOf(obo:MOLSIM_010016 obo:MOLSIM_001715)

# Class: obo:MOLSIM_010017 (color Tanimoto score)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010017 "A similarity score giving how far the chemical features of 2 aligned molecules coincide, such as hydrogen bond donors, acceptors and charged groups. It complements a shape comparison, which cannot tell a hydrogen bond donor from an acceptor of the same size. \"Color\" here refers to feature type, not to any visual property. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010017 "color Tanimoto score"@en)
SubClassOf(obo:MOLSIM_010017 obo:MOLSIM_000075)

# Class: obo:MOLSIM_010018 (shape Tanimoto score)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010018 "A similarity score giving how far the volumes of 2 aligned molecules overlap, as the shared volume divided by the volume either occupies. It ranges from 0 for no overlap to 1 for identical shape. It considers only shape, so 2 chemically unlike molecules that fill the same space score highly. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010018 "shape Tanimoto score"@en)
SubClassOf(obo:MOLSIM_010018 obo:MOLSIM_000075)

# Class: obo:MOLSIM_010019 (Tanimoto combo score)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010019 "A similarity score adding the shape score and the chemical feature score, giving a value between 0 and 2. Adding them weights shape and chemistry equally, which suits searching for a molecule that both fits a site and makes the same contacts. Reporting the 2 parts separately alongside it is usual, since the sum hides which one is high. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010019 "Tanimoto combo score"@en)
SubClassOf(obo:MOLSIM_010019 obo:MOLSIM_000075)

# Class: obo:MOLSIM_010020 (molecular trajectory analysis format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010020 "A molecular trajectory analysis format is a specialized file structure designed to store processed data derived from the analysis of a molecular dynamics simulation. These formats typically contain derived quantities, such as secondary structure timelines, pairwise distance matrices, or principal component vectors, rather than raw atomic coordinates. They allow for the efficient storage and rapid retrieval of complex analysis results without the need to re-process the massive original trajectory files."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010020 "molecular trajectory analysis format"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_010020 orcid:0000-0002-2294-5393)
SubClassOf(obo:MOLSIM_010020 obo:MOLSIM_001085)

# Class: obo:MOLSIM_010021 (solvent analysis format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010021 "A data format that stores spatial or statistical data describing how solvent molecules are distributed around a solute and what properties they carry there. Files in these formats usually hold a 3-dimensional grid of values such as local solvent density, charge distribution, or interaction energy. They are used to visualize hydration shells and to calculate thermodynamic properties of solvation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010021 "solvent analysis format"@en)
SubClassOf(obo:MOLSIM_010021 obo:MOLSIM_001085)

# Class: obo:MOLSIM_010022 (quantum chemistry format)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010022 "A data format that stores the results of an electronic structure calculation, such as molecular orbitals, electron densities, basis sets or electrostatic potentials. Files in these formats are how quantum chemistry programs hand their results to visualization software and to other analysis tools. The group covers both program-specific formats and interchange formats. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010022 "quantum chemistry format"@en)
SubClassOf(obo:MOLSIM_010022 obo:MOLSIM_001085)

# Class: obo:MOLSIM_010023 (electronic lab journal source)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010023 "A data source that holds data, observations or protocols recorded directly in a digital laboratory notebook system used by a research group. Unlike a public database or a formal publication, it contains raw internal records of day-to-day work and of the exact conditions of an experiment. Citing it says where the data came from when that data sits inside a system owned by one institution and has not yet been publicly deposited or peer reviewed."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010023 "electronic laboratory notebook source"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_010023 orcid:0000-0003-4846-8051)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_010023 "electronic lab journal source"@en)
SubClassOf(obo:MOLSIM_010023 obo:MOLSIM_000688)

# Class: obo:MOLSIM_010024 (local computing cluster system)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010024 "A set of networked computers housed and administered within a single institution, used as one pooled resource. It differs from a national facility in being controlled locally, so access and software are decided by the group that runs it. Most routine simulation work is done on one of these rather than on a large shared machine. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010024 "local computing cluster system"@en)
SubClassOf(obo:MOLSIM_010024 obo:MOLSIM_001862)

# Class: obo:MOLSIM_010025 (effective energy analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010025 "A free energy analysis method that estimates the free energy of a single conformation by adding its internal potential energy to its solvation free energy. It leaves out the solute's internal entropy, on the assumption that this cancels when 2 similar states are compared. It is the reasoning that the end-point binding free energy methods rest on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010025 "effective energy analysis"@en)
SubClassOf(obo:MOLSIM_010025 obo:MOLSIM_000951)

# Class: obo:MOLSIM_010026 (protein-peptide docking analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010026 "A computational method that predicts the structure of a complex between a protein and a short peptide. It is harder than docking a small rigid molecule, because a peptide has many rotatable bonds and usually has no fixed shape of its own until it binds. Methods for it therefore search over the peptide's conformation as well as its position. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010026 "protein-peptide docking analysis"@en)
SubClassOf(obo:MOLSIM_010026 obo:MOLSIM_000255)

# Class: obo:MOLSIM_010027 (membrane placement analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010027 "Membrane placement analysis is a computational method used to determine the optimal position and orientation of a protein structure within a lipid bilayer. It calculates the most energetically favorable alignment by assessing the hydrophobicity of the protein surface and matching it to the hydrophobic core and polar interfaces of the membrane. This analysis is a critical prerequisite for setting up stable membrane protein simulations and for understanding how proteins anchor themselves in the cell membrane."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010027 "membrane placement analysis"@en)
AnnotationAssertion(obo:IAO_0000117 obo:MOLSIM_010027 orcid:0009-0007-1391-4986)
SubClassOf(obo:MOLSIM_010027 obo:MOLSIM_000328)

# Class: obo:MOLSIM_010028 (leap analysis)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_010028 "A validation method that checks an assembled molecular system for chemical and topological errors before a simulation is set up. It reports missing force field parameters, a non-integer net charge, and atoms placed on top of one another. It is run as the last step of system preparation, because each of those faults makes the resulting topology unusable. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_010028 "leap analysis"@en)
SubClassOf(obo:MOLSIM_010028 obo:MOLSIM_000328)

############################
#   Named Individuals
############################

# Individual: obo:MOLSIM_000723 (PDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000723 "A protein structural database that is the single worldwide archive for experimentally determined 3-dimensional structures of large biological molecules, including proteins, nucleic acids and their complexes. Nearly every simulation of a biological molecule begins with a structure taken from it. Its accession codes are the standard way a structure is cited. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000723 "PDB"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000723 "Protein Data Bank"@en)
ClassAssertion(obo:MOLSIM_000692 obo:MOLSIM_000723)

# Individual: obo:MOLSIM_000724 (PDBe)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000724 "A protein structural database that is the European member of the worldwide Protein Data Bank partnership, holding the same archive and adding its own search and analysis tools. The 3 regional members share one set of entries, so a structure deposited at any of them appears at all. What differs is the interface and the services built on top. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000724 "PDBe"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000724 "Protein Data Bank in Europe"@en)
ClassAssertion(obo:MOLSIM_000692 obo:MOLSIM_000724)

# Individual: obo:MOLSIM_000725 (PDBj)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000725 "A founding member of the Worldwide Protein Data Bank (wwPDB) organization, serving as the Asian regional center for the PDB. PDBj collects, processes, and disseminates macromolecular structure data, and develops tools and resources for structural biology research in Japan and globally. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000725 "PDBj"@en)
ClassAssertion(obo:MOLSIM_000692 obo:MOLSIM_000725)

# Individual: obo:MOLSIM_000726 (PDBsum)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000726 "A pictorial database that provides an at-a-glance overview of the contents of each 3D macromolecular structure deposited in the Protein Data Bank (PDB). PDBsum presents schematic diagrams of molecular interactions, protein domains, ligand binding sites, and other structural features. It is a useful tool for quickly understanding PDB entries. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000726 "PDBsum"@en)
ClassAssertion(obo:MOLSIM_000692 obo:MOLSIM_000726)

# Individual: obo:MOLSIM_000727 (NDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000727 "A nucleic acid structural database archiving experimentally determined 3-dimensional structures of DNA, RNA and their complexes. It describes structures in terms specific to nucleic acids, such as base pairing and backbone conformation, which a general structure archive does not. It is where nucleic acid geometry is looked up rather than derived. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000727 "NDB"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000727 "Nucleic Acid Database"@en)
ClassAssertion(obo:MOLSIM_000693 obo:MOLSIM_000727)

# Individual: obo:MOLSIM_000728 (EMDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000728 "An electron microscopy database that is the main public archive for 3-dimensional density maps of biomolecular complexes and subcellular structures. A map from this source shows shape at a resolution that may be too low to place individual atoms, which is why an atomic model is deposited separately. The 2 together are what a cryogenic electron microscopy study produces. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000728 "EMDB"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000728 "Electron Microscopy Data Bank"@en)
ClassAssertion(obo:MOLSIM_000694 obo:MOLSIM_000728)

# Individual: obo:MOLSIM_000729 (EMPIAR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000729 "An electron microscopy database holding the raw 2-dimensional image data, including movies and tilt series, from which 3-dimensional maps were reconstructed. Keeping the raw images allows a reconstruction to be repeated or improved as methods advance. It is the layer beneath the density map archive. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000729 "EMPIAR"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000729 "Electron Microscopy Public Image Archive"@en)
ClassAssertion(obo:MOLSIM_000694 obo:MOLSIM_000729)

# Individual: obo:MOLSIM_000730 (GenBank)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000730 "The NIH genetic sequence database, an annotated collection of all publicly available DNA sequences, maintained by the National Center for Biotechnology Information (NCBI). As part of the INSDC, GenBank is a foundational resource for molecular biology, genomics, and evolutionary studies worldwide. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000730 "GenBank"@en)
ClassAssertion(obo:MOLSIM_000697 obo:MOLSIM_000730)

# Individual: obo:MOLSIM_000731 (UniProtKB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000731 "A knowledge-based database of protein sequences together with what is known about each protein's function, structure and modifications. It was formed by joining 3 earlier collections and is the reference most protein identifiers point at. It has a manually reviewed section and a much larger automatically annotated one. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000731 "UniProtKB"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000731 "UniProt Knowledgebase"@en)
ClassAssertion(obo:MOLSIM_000708 obo:MOLSIM_000731)

# Individual: obo:MOLSIM_000732 (ENA)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000732 "A nucleic acid sequence database covering raw sequencing reads, assembled sequences and their annotations, from organisms of every kind. It is the European member of a 3-way partnership whose members exchange records daily, so a sequence deposited at one appears at all. Which one holds a record therefore says where it was deposited, not where it can be found. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000732 "ENA"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000732 "European Nucleotide Archive"@en)
ClassAssertion(obo:MOLSIM_000697 obo:MOLSIM_000732)

# Individual: obo:MOLSIM_000733 (DDBJ)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000733 "A nucleic acid sequence database that is the Japanese member of the same 3-way partnership as the European and American archives. The 3 exchange records daily and hold the same content. It is the deposition route for work done in its region. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000733 "DDBJ"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000733 "DNA Data Bank of Japan"@en)
ClassAssertion(obo:MOLSIM_000697 obo:MOLSIM_000733)

# Individual: obo:MOLSIM_000734 (UniProtKB/Swiss-Prot)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000734 "The manually annotated and reviewed section of the UniProt Knowledgebase (UniProtKB). Swiss-Prot entries contain high-quality protein sequence information, detailed functional annotations, and extensive cross-references, derived from literature and curator evaluation. It represents the gold standard for protein annotation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000734 "UniProtKB/Swiss-Prot"@en)
ClassAssertion(obo:MOLSIM_000696 obo:MOLSIM_000734)

# Individual: obo:MOLSIM_000811 (UniProtKB/TrEMBL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000811 "The computationally annotated section of the UniProt Knowledgebase (UniProtKB), containing protein sequences that are not yet manually curated. TrEMBL entries are largely derived from the translation of coding sequences in nucleotide sequence databases and are automatically annotated. It provides broad sequence coverage. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000811 "UniProtKB/TrEMBL"@en)
ClassAssertion(obo:MOLSIM_000696 obo:MOLSIM_000811)

# Individual: obo:MOLSIM_000919 (NCBI RefSeq Protein)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000919 "The NCBI Reference Sequence (RefSeq) collection for protein data, offering a curated, non-redundant set of protein sequences, often linked to corresponding nucleotide sequences and genomic annotations. RefSeq proteins serve as stable reference points for protein identification, annotation, and comparative analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000919 "NCBI RefSeq Protein"@en)
ClassAssertion(obo:MOLSIM_000696 obo:MOLSIM_000919)

# Individual: obo:MOLSIM_000920 (PIR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000920 "A protein sequence database that produced one of the first curated collections of protein sequences, beginning in the 1960s. Its own collection is no longer maintained separately, having been merged into the UniProt Knowledgebase. It remains cited because a great deal of older literature refers to its identifiers. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000920 "PIR"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000920 "Protein Information Resource"@en)
ClassAssertion(obo:MOLSIM_000696 obo:MOLSIM_000920)

# Individual: obo:MOLSIM_000922 (NCBI RefSeq Nucleotide)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000922 "The NCBI Reference Sequence (RefSeq) collection for nucleotide data, providing a comprehensive, integrated, non-redundant, and well-annotated set of sequences for chromosomes, genomic regions, transcripts, and RNAs. RefSeq aims to provide stable reference sequences for various organisms. It is a critical resource for genomics and gene annotation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000922 "NCBI RefSeq Nucleotide"@en)
ClassAssertion(obo:MOLSIM_000697 obo:MOLSIM_000922)

# Individual: obo:MOLSIM_000929 (PubChem Compound)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000929 "A public repository within PubChem that contains validated chemical structure information for small molecules, including their identifiers, properties, and links to related information. PubChem Compound is a comprehensive resource for chemical information and a key component of the PubChem suite. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000929 "PubChem Compound"@en)
ClassAssertion(obo:MOLSIM_000699 obo:MOLSIM_000929)

# Individual: obo:MOLSIM_000930 (ChEBI)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000930 "A chemical structure database and ontology covering small molecules that take part in biological processes, as products, reactants or regulators. Being an ontology as well as a dictionary, it records how compounds relate to one another rather than only listing them. MOLSIM maps to it and does not import it, because its hierarchy is far deeper than this field needs. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000930 "ChEBI"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000930 "Chemical Entities of Biological Interest"@en)
ClassAssertion(obo:MOLSIM_000699 obo:MOLSIM_000930)

# Individual: obo:MOLSIM_000931 (ZINC20)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000931 "A free database of commercially available chemical compounds prepared in ready-to-dock, 3D formats for virtual screening and computational drug discovery. ZINC20 contains millions of purchasable compounds with annotated properties, facilitating large-scale ligand docking and cheminformatics studies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000931 "ZINC20"@en)
ClassAssertion(obo:MOLSIM_000699 obo:MOLSIM_000931)

# Individual: obo:MOLSIM_000932 (DrugBank)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000932 "A comprehensive, freely accessible online database containing detailed information on drugs, drug targets, drug interactions, and drug metabolism. It combines detailed drug data with comprehensive drug target information, making it a vital resource for pharmacology, medicinal chemistry, and pharmaceutical research. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000932 "DrugBank"@en)
ClassAssertion(obo:MOLSIM_000700 obo:MOLSIM_000932)

# Individual: obo:MOLSIM_000933 (ChemSpider)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000933 "A free chemical structure database providing fast access to over millions of structures, properties, and associated information from various sources. It allows users to search by chemical name, synonym, trade name, registry number, or structure. ChemSpider is a comprehensive resource for chemists and researchers needing chemical information. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000933 "ChemSpider"@en)
ClassAssertion(obo:MOLSIM_000699 obo:MOLSIM_000933)

# Individual: obo:MOLSIM_000934 (TTD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000934 "A drug information database recording the protein and nucleic acid targets that drugs act on, the drugs directed at each, and the diseases involved. It is organised around the target rather than the compound. It is used to find what has already been tried against a protein before a new study is designed. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000934 "TTD"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000934 "Therapeutic Target Database"@en)
ClassAssertion(obo:MOLSIM_000700 obo:MOLSIM_000934)

# Individual: obo:MOLSIM_000935 (DailyMed)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000935 "A website operated by the U.S. National Library of Medicine (NLM) that provides high-quality information about marketed drugs, including FDA-approved drug labels (package inserts). It offers comprehensive information for healthcare providers and the public on drug ingredients, indications, dosage, warnings, and adverse reactions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000935 "DailyMed"@en)
ClassAssertion(obo:MOLSIM_000700 obo:MOLSIM_000935)

# Individual: obo:MOLSIM_000957 (ChEMBL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000957 "A manually curated, large-scale database of bioactive drug-like small molecules and their quantitative bioactivity data against drug targets (primarily proteins). It brings together chemical, bioactivity, and genomic data to aid the translation of genomic information into effective new drugs. ChEMBL is a critical resource for drug discovery, pharmacology, and medicinal chemistry. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000957 "ChEMBL"@en)
ClassAssertion(obo:MOLSIM_000707 obo:MOLSIM_000957)

# Individual: obo:MOLSIM_000958 (MassIVE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000958 "A spectroscopic database holding mass spectrometry datasets, chiefly from proteomics experiments. It stores the measurements themselves rather than conclusions drawn from them, so an analysis can be repeated. It is one of the archives a proteomics study is expected to deposit in. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000958 "MassIVE"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000958 "Mass Spectrometry Interactive Virtual Environment"@en)
ClassAssertion(obo:MOLSIM_000701 obo:MOLSIM_000958)

# Individual: obo:MOLSIM_000959 (SDBS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000959 "An integrated spectral database system for organic compounds, maintained by the National Institute of Advanced Industrial Science and Technology (AIST), Japan. SDBS contains NMR (1H, 13C), mass spectra, IR, Raman, and ESR spectra for a large number of organic compounds. It is a valuable resource for chemical identification and structural elucidation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000959 "SDBS"@en)
ClassAssertion(obo:MOLSIM_000701 obo:MOLSIM_000959)

# Individual: obo:MOLSIM_000960 (BMRB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000960 "An NMR data repository collecting nuclear magnetic resonance measurements on biological macromolecules and metabolites, including assigned chemical shifts, coupling constants and relaxation data. Those quantities are what a simulated structure or trajectory is compared against. It is the NMR counterpart of the structure archives. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000960 "BMRB"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000960 "Biological Magnetic Resonance Data Bank"@en)
ClassAssertion(obo:MOLSIM_000702 obo:MOLSIM_000960)

# Individual: obo:MOLSIM_000961 (ComplexCARP)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000961 "An NMR data repository specialising in assigned chemical shifts for complex carbohydrates and their complexes. Carbohydrates are poorly covered by the general NMR archives, because their signals overlap heavily and their assignment is difficult. It exists to hold the assignments that do get made. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000961 "ComplexCARP"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000961 "Complex Carbohydrate Magnetic Resonance Database"@en)
ClassAssertion(obo:MOLSIM_000702 obo:MOLSIM_000961)

# Individual: obo:MOLSIM_000962 (InterPro)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000962 "A database that integrates predictive signatures for protein families, domains, and functional sites from multiple member databases (e.g., Pfam, PROSITE, SMART, CDD, CATH, SCOP). InterPro provides a comprehensive overview of protein sequence features, aiding in functional annotation and comparative analysis. It is a powerful tool for protein characterization. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000962 "InterPro"@en)
ClassAssertion(obo:MOLSIM_000703 obo:MOLSIM_000962)

# Individual: obo:MOLSIM_000964 (Pfam)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000964 "A large collection of protein families, each represented by multiple sequence alignments and hidden Markov models (HMMs). Pfam is used to identify conserved domains and families in protein sequences, providing insights into their function and evolutionary relationships. It is a widely used resource for protein sequence annotation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000964 "Pfam"@en)
ClassAssertion(obo:MOLSIM_000704 obo:MOLSIM_000964)

# Individual: obo:MOLSIM_000965 (SMART)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000965 "A web-based resource used for the identification and annotation of genetically mobile domains and the analysis of domain architectures in proteins. SMART contains manually curated models for hundreds of domains involved in signaling, extracellular functions, and chromatin regulation. It is a valuable tool for protein sequence analysis and functional prediction. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000965 "SMART"@en)
ClassAssertion(obo:MOLSIM_000704 obo:MOLSIM_000965)

# Individual: obo:MOLSIM_000966 (PROSITE)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000966 "A database of protein domains, families, and functional sites, characterized by patterns (regular expressions) or profiles (position-specific scoring matrices) derived from multiple sequence alignments. PROSITE is used to identify known motifs and domains in protein sequences, aiding in functional prediction. It is part of the SIB ExPASy server. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000966 "PROSITE"@en)
ClassAssertion(obo:MOLSIM_000704 obo:MOLSIM_000966)

# Individual: obo:MOLSIM_000967 (CDD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000967 "A protein family and domain database holding curated models of protein domains, together with models imported from other collections. Searching a sequence against it identifies which known domains a protein contains. That is usually the first step in deciding what part of a protein to simulate. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000967 "CDD"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000967 "Conserved Domain Database"@en)
ClassAssertion(obo:MOLSIM_000704 obo:MOLSIM_000967)

# Individual: obo:MOLSIM_000968 (SCOP2)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000968 "A database that provides a detailed and comprehensive hierarchical classification of protein structural domains based on their evolutionary relationships and structural similarities. SCOP2 builds upon the original SCOP, aiming to provide a more automated and comprehensive classification. It is a key resource for understanding protein structure and evolution. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000968 "SCOP2"@en)
ClassAssertion(obo:MOLSIM_000705 obo:MOLSIM_000968)

# Individual: obo:MOLSIM_000969 (CATH)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000969 "A structural classification database that sorts protein domains taken from experimental structures into a hierarchy of 4 levels, from broad shape down to evolutionary relationship. The 4 levels are what its name enumerates. It is used to find structurally similar proteins when sequence similarity is too weak to detect. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000969 "CATH"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000969 "Class, Architecture, Topology, Homologous superfamily"@en)
ClassAssertion(obo:MOLSIM_000705 obo:MOLSIM_000969)

# Individual: obo:MOLSIM_000970 (ECOD)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000970 "A structural classification database that groups protein domains primarily by evolutionary relationship rather than by shape. It emphasises distant relationships that a purely structural comparison would miss. It is updated continuously as new structures appear, where some classifications are revised in releases. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000970 "ECOD"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000970 "Evolutionary Classification of Protein Domains"@en)
ClassAssertion(obo:MOLSIM_000705 obo:MOLSIM_000970)

# Individual: obo:MOLSIM_000971 (KEGG Pathway)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000971 "A collection of manually drawn pathway maps representing current knowledge on molecular interaction and reaction networks for metabolism, genetic information processing, environmental information processing, cellular processes, organismal systems, and human diseases. KEGG Pathway is part of the larger Kyoto Encyclopedia of Genes and Genomes (KEGG) resource. It is widely used for pathway analysis and systems biology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000971 "KEGG Pathway"@en)
ClassAssertion(obo:MOLSIM_000706 obo:MOLSIM_000971)

# Individual: obo:MOLSIM_000972 (Reactome)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000972 "A free, open-source, curated, and peer-reviewed pathway database that provides detailed information on human biological pathways and processes. Reactome uses a hierarchical organization to describe molecular events, from individual reactions to complex pathways, linking genes, proteins, and small molecules. It is a key resource for systems biology and pathway analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000972 "Reactome"@en)
ClassAssertion(obo:MOLSIM_000706 obo:MOLSIM_000972)

# Individual: obo:MOLSIM_000973 (BioCyc)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000973 "A collection of thousands of Pathway/Genome Databases (PGDBs), each describing the genome and metabolic pathways of a specific organism, plus a multi-organism pathway database (MetaCyc). BioCyc provides curated information on genes, enzymes, metabolites, and reactions, facilitating comparative genomics and metabolic network analysis. It is a key resource for systems biology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000973 "BioCyc"@en)
ClassAssertion(obo:MOLSIM_000706 obo:MOLSIM_000973)

# Individual: obo:MOLSIM_000977 (WikiPathways)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000977 "A community-curated, open, and collaborative platform for biological pathway diagrams. WikiPathways allows researchers to contribute, edit, and share pathway information, fostering a dynamic and up-to-date collection of pathway models across various species. It promotes open access to pathway knowledge. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000977 "WikiPathways"@en)
ClassAssertion(obo:MOLSIM_000706 obo:MOLSIM_000977)

# Individual: obo:MOLSIM_000991 (BindingDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000991 "A public, web-accessible database focusing on measured binding affinities of interactions between proteins (considered as drug targets) and small, drug-like molecules. It primarily contains data from enzyme assays, isothermal titration calorimetry, and surface plasmon resonance. BindingDB is a valuable resource for drug discovery, cheminformatics, and validating computational predictions. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000991 "BindingDB"@en)
ClassAssertion(obo:MOLSIM_000707 obo:MOLSIM_000991)

# Individual: obo:MOLSIM_000992 (PubChem BioAssay)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000992 "A public repository within PubChem that stores descriptions and results of biological screening assays on chemical substances, typically from high-throughput screening programs. PubChem BioAssay links chemical structures to their biological activities, providing valuable data for drug discovery and chemical biology. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000992 "PubChem BioAssay"@en)
ClassAssertion(obo:MOLSIM_000707 obo:MOLSIM_000992)

# Individual: obo:MOLSIM_000993 (IUPHAR/BPS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000993 "A bioactivity database, curated by experts, of pharmacological targets such as receptors, ion channels, enzymes and transporters, together with the drugs and ligands that act on them. Its entries are written and checked by specialists in each target family rather than gathered automatically. That makes it smaller than the automatically assembled collections and more reliable per entry. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000993 "IUPHAR/BPS"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000993 "IUPHAR/BPS Guide to Pharmacology"@en)
ClassAssertion(obo:MOLSIM_000707 obo:MOLSIM_000993)

# Individual: obo:MOLSIM_000994 (DisGeNET)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000994 "A discovery platform integrating and standardizing data on gene-disease associations (GDAs) and variant-disease associations (VDAs) from multiple public repositories and scientific literature. DisGeNET provides scores to rank these associations and tools for their analysis and interpretation. It is a valuable resource for studying the genetic basis of human diseases. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000994 "DisGeNET"@en)
ClassAssertion(obo:MOLSIM_000708 obo:MOLSIM_000994)

# Individual: obo:MOLSIM_000995 (OMIM)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000995 "A knowledge-based database cataloguing human genes and the inherited disorders and traits associated with them. It is organised around the link between a gene and the effects of altering it, rather than around sequences. It is how a mutation being simulated is connected to a clinical consequence. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000995 "OMIM"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000995 "Online Mendelian Inheritance in Man"@en)
ClassAssertion(obo:MOLSIM_000708 obo:MOLSIM_000995)

# Individual: obo:MOLSIM_000996 (Zenodo)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000996 "A general-purpose open-access repository operated by CERN and OpenAIRE, allowing researchers in all disciplines to deposit research outputs, including datasets, software, publications, and figures. Zenodo assigns DOIs to uploads, making them citable and discoverable. It supports FAIR data principles. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000996 "Zenodo"@en)
ClassAssertion(obo:MOLSIM_000709 obo:MOLSIM_000996)

# Individual: obo:MOLSIM_000997 (Dryad Digital Repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000997 "A general-purpose, curated repository that makes the data underlying scientific and medical publications discoverable, freely reusable, and citable. Dryad provides a platform for researchers to archive and share diverse datasets associated with their research articles. It promotes open science and data reproducibility. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000997 "Dryad Digital Repository"@en)
ClassAssertion(obo:MOLSIM_000709 obo:MOLSIM_000997)

# Individual: obo:MOLSIM_000998 (Figshare)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000998 "A general-purpose online digital repository where researchers can preserve and share their research outputs, including figures, datasets, images, and code. Figshare allows users to make their work citable and discoverable, supporting open science practices across various disciplines. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000998 "Figshare"@en)
ClassAssertion(obo:MOLSIM_000709 obo:MOLSIM_000998)

# Individual: obo:MOLSIM_000999 (MDDBR)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_000999 "A simulation data repository, based in Europe, for storing and sharing biomolecular simulation data. It accepts trajectories together with the metadata describing how they were produced, which is what makes a deposited trajectory reusable. MOLSIM exists in large part to give that metadata a shared vocabulary. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_000999 "MDDBR"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_000999 "Molecular Dynamics Data Bank"@en)
ClassAssertion(obo:MOLSIM_000710 obo:MOLSIM_000999)

# Individual: obo:MOLSIM_001000 (BioSimDB)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001000 "A publicly accessible database designed to store, search, and analyze biomolecular simulation data, including trajectories, input parameters, and analysis results. It aims to promote reproducibility, data sharing, and re-use of simulation data within the molecular modeling community. BioSimDB facilitates the discovery and comparison of simulation studies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001000 "BioSimDB"@en)
ClassAssertion(obo:MOLSIM_000710 obo:MOLSIM_001000)

# Individual: obo:MOLSIM_001001 (MoDEL)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001001 "A database and web server that provides a collection of pre-equilibrated molecular dynamics simulations of proteins, particularly focusing on pharmaceutically relevant targets. MoDEL aims to offer ready-to-use starting points for further simulation studies, such as ligand binding or conformational analysis. (UNVERIFIED)"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001001 "MoDEL database"@en)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001001 "Distinct from the class 'model' (MOLSIM:000006), which it resembles only in spelling: this is a named simulation data repository, that is a general kind of representation. Case-insensitive lexical matching conflates the two, so prefer the synonym 'MoDEL database' when matching."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001001 "MoDEL"@en)
ClassAssertion(obo:MOLSIM_000710 obo:MOLSIM_001001)

# Individual: obo:MOLSIM_001002 (MDsrv)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001002 "A web server and platform designed for sharing, visualizing, and analyzing molecular dynamics (MD) simulation trajectories directly in a web browser. MDsrv allows researchers to easily disseminate their MD data and provides interactive tools for common trajectory analyses without requiring local software installation. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001002 "MDsrv"@en)
ClassAssertion(obo:MOLSIM_000710 obo:MOLSIM_001002)

# Individual: obo:MOLSIM_001003 (PDB-Dev)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001003 "A prototype deposition and archiving system for structural models of biomolecular systems determined using integrative or hybrid (I/H) methods, which combine data from various experimental techniques and computational approaches. PDB-Dev aims to establish standards for archiving these complex structural models. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001003 "PDB-Dev"@en)
ClassAssertion(obo:MOLSIM_000692 obo:MOLSIM_001003)

# Individual: obo:MOLSIM_001004 (AlphaFold Protein Structure Database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001004 "A comprehensive repository providing open access to millions of high-accuracy protein structure predictions generated by DeepMind's AlphaFold AI system. It significantly expands structural coverage of known protein sequences, offering valuable models for proteins lacking experimental structures. This database is a key resource for structural biology and drug discovery. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001004 "AlphaFold Protein Structure Database"@en)
ClassAssertion(obo:MOLSIM_000711 obo:MOLSIM_001004)

# Individual: obo:MOLSIM_001005 (SWISS-MODEL Repository)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001005 "A database of continuously updated, high-quality 3D protein structure models generated by the SWISS-MODEL homology modeling pipeline. It provides access to pre-computed models for a large number of protein sequences, particularly those from model organisms and UniProtKB. It is a key resource for obtaining theoretical protein models. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001005 "SWISS-MODEL Repository"@en)
ClassAssertion(obo:MOLSIM_000711 obo:MOLSIM_001005)

# Individual: obo:MOLSIM_001006 (ESMatlas)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001006 "A predicted structure repository holding several hundred million protein structure predictions, generated by a language model trained on protein sequences. Its scale comes from predicting directly from sequence without searching for related structures, which is far faster than earlier methods. Its predictions are less accurate than those from methods that do search, and cover sequences those methods have never been run on. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001006 "ESMatlas"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001006 "Evolutionary Scale Modeling Atlas"@en)
ClassAssertion(obo:MOLSIM_000711 obo:MOLSIM_001006)

# Individual: obo:MOLSIM_001007 (ModelArchive)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001007 "A public repository for archiving and distributing 3D structural models of biomacromolecules, particularly those generated by computational methods that are not eligible for deposition in the PDB. ModelArchive supports the FAIR (Findable, Accessible, Interoperable, Reusable) principles for theoretical models. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001007 "ModelArchive"@en)
ClassAssertion(obo:MOLSIM_000711 obo:MOLSIM_001007)

# Individual: obo:MOLSIM_001025 (MetaboLights)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001025 "A database for cross-species, cross-technique metabolomics experiments and derived information, maintained at EMBL-EBI. MetaboLights archives metadata about studies, raw experimental data, and processed metabolite identifications and quantifications. It is a key repository for the metabolomics community. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001025 "MetaboLights"@en)
ClassAssertion(obo:MOLSIM_000712 obo:MOLSIM_001025)

# Individual: obo:MOLSIM_001026 (GNPS)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001026 "A metabolomics repository and analysis platform for mass spectrometry data on natural products, which groups related compounds by the similarity of their spectra. Grouping this way identifies compounds that no reference library contains, by their resemblance to ones it does. Its reference spectra are contributed and curated by its users. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001026 "GNPS"@en)
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MOLSIM_001026 "Global Natural Products Social Molecular Networking"@en)
ClassAssertion(obo:MOLSIM_000712 obo:MOLSIM_001026)

# Individual: obo:MOLSIM_001027 (Metabolomics Workbench)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001027 "A public repository for metabolomics data and metadata, part of the NIH Common Fund's Metabolomics Program. It serves as a national and international data repository and coordinating center, providing tools for data analysis, visualization, and integration with other omics data. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001027 "Metabolomics Workbench"@en)
ClassAssertion(obo:MOLSIM_000712 obo:MOLSIM_001027)

# Individual: obo:MOLSIM_001028 (PubMed)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001028 "A free search engine primarily accessing the MEDLINE database of references and abstracts on life sciences and biomedical topics, maintained by the U.S. National Library of Medicine (NLM) at the National Institutes of Health (NIH). PubMed is the foremost resource for searching biomedical literature. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001028 "PubMed"@en)
ClassAssertion(obo:MOLSIM_000713 obo:MOLSIM_001028)

# Individual: obo:MOLSIM_001029 (Scopus)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001029 "A large abstract and citation database of peer-reviewed literature: scientific journals, books, and conference proceedings, owned by Elsevier. Scopus provides tools for tracking, analyzing, and visualizing research output across various disciplines. It is a major competitor to Web of Science for literature searching and citation analysis. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001029 "Scopus"@en)
ClassAssertion(obo:MOLSIM_000713 obo:MOLSIM_001029)

# Individual: obo:MOLSIM_001030 (Web of Science)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001030 "A multidisciplinary citation indexing service and database platform owned by Clarivate Analytics. Web of Science provides access to multiple databases covering scholarly journals, books, conference proceedings, and patents, offering comprehensive citation data and research analytics. It is a major tool for literature discovery and impact assessment. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001030 "Web of Science"@en)
ClassAssertion(obo:MOLSIM_000713 obo:MOLSIM_001030)

# Individual: obo:MOLSIM_001031 (Google Scholar)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001031 "A freely accessible web search engine that indexes the full text or metadata of scholarly literature across an array of publishing formats and disciplines. While not a curated database, it serves as a primary discovery tool for finding academic papers, theses, books, and abstracts. It is widely used by researchers for literature searches. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001031 "Google Scholar"@en)
ClassAssertion(obo:MOLSIM_000713 obo:MOLSIM_001031)

# Individual: obo:MOLSIM_001532 (Cambridge Structural Database)

AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001532 "The small molecule structural database that serves as the primary repository for experimentally determined three-dimensional crystal structures of small organic and metal-organic molecules. It provides high-quality reference geometries used for validating force fields and for obtaining starting structures in computational studies. (UNVERIFIED)"@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001532 "Cambridge Structural Database"@en)
ClassAssertion(obo:MOLSIM_001522 obo:MOLSIM_001532)

# Individual: obo:MOLSIM_001945 (obsolete Omni-Path)

AnnotationAssertion(owl:deprecated obo:MOLSIM_001945 "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0000115 obo:MOLSIM_001945 "OBSOLETE. A redundant untyped individual that duplicated the class 'omni-path' (MOLSIM:001949). It should not be used; use that class instead."@en)
AnnotationAssertion(obo:IAO_0100001 obo:MOLSIM_001945 obo:MOLSIM_001949)
AnnotationAssertion(rdfs:comment obo:MOLSIM_001945 "Obsoleted: redundant untyped individual duplicating the class 'omni-path' (MOLSIM_001949), which is the concept to use instead."@en)
AnnotationAssertion(rdfs:label obo:MOLSIM_001945 "obsolete Omni-Path"@en)

