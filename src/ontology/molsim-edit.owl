DisjointClasses(obo:MOLSIM_000273 obo:MOLSIM_000274 obo:MOLSIM_000275 obo:MOLSIM_000495 obo:MOLSIM_001560 obo:MOLSIM_001571 obo:MOLSIM_001713 obo:MOLSIM_001736 obo:MOLSIM_001846)
