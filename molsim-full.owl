    <!-- http://purl.obolibrary.org/obo/IAO_0000103 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000103">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term was initially used in an attempt to structure part of the ontology, but in retrospect failed to do a good job.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">failed exploratory term</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000120 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000120">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Class has all its metadata, but is either not guaranteed to be in its final location in the asserted IS_A hierarchy or refers to another class that is not complete.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">metadata complete</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000121 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000121">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">The term was created to ease viewing/sorting terms for development purposes, but will not be included in a release.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">organizational term</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000122 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000122">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Class has undergone final review, is ready for use, and will be included in the next release. Any class lacking &quot;ready_for_release&quot; should be considered likely to change place in hierarchy, have its definition refined, or be obsoleted in the next release.  Those classes deemed &quot;ready_for_release&quot; will also derived from a chain of ancestor classes that are also &quot;ready_for_release.&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ready for release</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000123 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000123">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Class is being worked on; however, the metadata (including definition) are not complete or sufficiently clear to the branch editors.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">metadata incomplete</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000124 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000124">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Nothing done yet beyond assigning a unique class ID and proposing a preferred term.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">uncurated</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000125 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000125">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">All definitions, placement in the asserted IS_A hierarchy and required minimal metadata are complete. The class is awaiting a final review by someone other than the term editor.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pending final vetting</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000226 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000226">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term was created to temporarily stand in for a semantic purpose, but is no longer needed, typically due to another permanent term being defined.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">placeholder removed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000227 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000227">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term has been combined with one or more other terms to create a more encompassing (merged) term.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">terms merged</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000228 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000228">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term has been replaced by a term imported from another ontology.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">term imported</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000229 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000229">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term has been split into two or more new terms.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">term split</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000410 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000410">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000409"/>
        <obo:IAO_0000119 xml:lang="en">A Formal Theory of Substances, Qualities, and Universals, http://ontology.buffalo.edu/bfo/SQU.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">universal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000420 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000420">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000409"/>
        <obo:IAO_0000115 xml:lang="en">A defined class is a class that is defined by a set of logically necessary and sufficient conditions but is not a universal</obo:IAO_0000115>
        <rdfs:label xml:lang="en">defined class</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000421 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000421">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000409"/>
        <obo:IAO_0000115 xml:lang="en">A named class expression is a logical expression that is given a name. The name can be used in place of the expression.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">named class expression</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000423 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000423">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Terms with this status should eventually replaced with a term from another ontology.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">group:OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">to be replaced with external ontology term</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000428 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000428">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">A term that is metadata complete, has been reviewed, and problems have been identified that require discussion before release. Such a term requires editor note(s) to identify the outstanding issues.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">group:OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">requires discussion</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000723 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000723">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000692"/>
        <obo:IAO_0000115 xml:lang="en">A protein structural database that is the single worldwide archive for experimentally determined 3-dimensional structures of large biological molecules, including proteins, nucleic acids and their complexes. Many simulations of biological molecules begin with a structure taken from it. Its accession codes are the standard way a structure is cited. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Protein Data Bank</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">PDB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000724 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000724">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000692"/>
        <obo:IAO_0000115 xml:lang="en">A protein structural database that is the European member of the worldwide Protein Data Bank partnership, run by EMBL-EBI, holding the same archive and adding its own search and analysis tools. The members of the partnership share 1 set of entries, so a structure deposited through any of them appears at all. What differs is the interface and the services built on top. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Protein Data Bank in Europe</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">PDBe</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0472"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000725 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000725">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000692"/>
        <obo:IAO_0000115 xml:lang="en">A protein structural database that is the Japanese member, and a founding member, of the worldwide Protein Data Bank partnership, run at the Institute for Protein Research of Osaka University. It processes the structures deposited mainly from Asia and the Middle East, holds the same archive as the other members, and develops its own tools and services. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PDBj</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0806"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000726 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000726">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000692"/>
        <obo:IAO_0000115 xml:lang="en">A protein structural database that gives a pictorial summary of each 3D structure in the Protein Data Bank, with schematic diagrams of molecular interactions, protein domains, ligand binding sites and other structural features. It helps a reader understand the contents of an entry quickly, without opening the coordinates. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PDBsum</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000727 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000727">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000693"/>
        <obo:IAO_0000115 xml:lang="en">The Nucleic Acid Database (NDB) was a specialized, value-added web repository founded in 1991 to collect, archive, and distribute three-dimensional (3D) structural information about DNA, RNA, and their protein/ligand complexes. The legacy NDB resource has been officially retired. It has been replaced by the Nucleic Acid Knowledgebase (NAKB), which preserves all original NDB functionality while expanding coverage to modern structural biology data.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Nucleic Acid Database</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">NDB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000728 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000728">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000694"/>
        <obo:IAO_0000115 xml:lang="en">The Electron Microscopy Data Bank (EMDB) is a global public repository for 3D electron microscopy (3DEM) density maps and tomograms of biological specimens, macromolecules, viruses, and subcellular structures. It stores cryogenic-sample electron microscopy (cryoEM) volumes, helical reconstructions, electron tomograms, subtomogram averages, and electron crystallography maps.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Electron Microscopy Data Bank</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">EMDB</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0936"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000729 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000729">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000694"/>
        <obo:IAO_0000115 xml:lang="en">An electron microscopy database storing the raw, 2D micrographs and tilt series that researchers use to build 3D cryo-electron microscopy (cryo-EM) maps and models (which are archived in the EMDB).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Electron Microscopy Public Image Archive</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">EMPIAR</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_2350"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000730 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000730">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000697"/>
        <obo:IAO_0000115 xml:lang="en">A nucleic acid sequence database of the U.S. National Institutes of Health, maintained by the National Center for Biotechnology Information (NCBI), that holds an annotated collection of all publicly available DNA sequences. It is the American member of the International Nucleotide Sequence Database Collaboration, together with ENA in Europe and DDBJ in Japan, and the 3 exchange records daily. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">GenBank</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C43818"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000731 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000731">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000708"/>
        <obo:IAO_0000115 xml:lang="en">A knowledge-based database of protein sequences together with what is known about each protein&apos;s function, structure and modifications, run by the UniProt consortium. It was formed by joining Swiss-Prot, TrEMBL and the PIR Protein Sequence Database, and it has a manually reviewed section, Swiss-Prot, and a much larger automatically annotated section, TrEMBL. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">UniProt Knowledgebase</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">UniProtKB</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C47851"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000732 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000732">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000697"/>
        <obo:IAO_0000115 xml:lang="en">A nucleic acid sequence database, run by EMBL-EBI, covering raw sequencing reads, assembled sequences and their annotations from organisms of every kind. It is the European member of the International Nucleotide Sequence Database Collaboration, whose 3 members exchange records daily, so a sequence deposited at any of them can be found at all 3. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">European Nucleotide Archive</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ENA</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000733 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000733">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000697"/>
        <obo:IAO_0000115 xml:lang="en">A nucleic acid sequence database that is the Japanese member of the International Nucleotide Sequence Database Collaboration, together with GenBank in the United States and ENA in Europe. The 3 members exchange records daily, so a sequence deposited at any of them can be found at all 3. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DNA Data Bank of Japan</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">DDBJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000734 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000734">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000696"/>
        <obo:IAO_0000115 xml:lang="en">A protein sequence database that forms the manually annotated and reviewed section of the UniProt Knowledgebase. Its entries combine the protein sequence with functional annotation and cross-references, checked by curators against the literature, which makes it the most reliable part of UniProtKB. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">UniProtKB/Swiss-Prot</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000811 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000811">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000696"/>
        <obo:IAO_0000115 xml:lang="en">A protein sequence database that forms the automatically annotated, unreviewed section of the UniProt Knowledgebase. Most of its entries are translations of the coding sequences submitted to the nucleotide sequence databases, and together they give broad coverage of known proteins. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">UniProtKB/TrEMBL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000919 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000919">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000696"/>
        <obo:IAO_0000115 xml:lang="en">A protein sequence database, run by NCBI, that provides a curated, non-redundant set of reference protein sequences, often linked to the matching nucleotide sequences and genome annotations. Its records serve as stable reference points for identifying, annotating and comparing proteins. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCBI RefSeq Protein</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000920 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000920">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000696"/>
        <obo:IAO_0000115 xml:lang="en">A protein sequence database whose Protein Sequence Database was one of the first curated collections of protein sequences, growing out of an atlas of protein sequences begun in the 1960s. That collection was merged into the UniProt Knowledgebase, and the resource itself remains a member of the UniProt consortium. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Protein Information Resource</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">PIR</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_2205"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000922 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000922">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000697"/>
        <obo:IAO_0000115 xml:lang="en">A nucleic acid sequence database, run by NCBI, that provides a non-redundant, annotated set of reference sequences for chromosomes, genomic regions, transcripts and RNAs. Each sequence serves as a stable reference for the organism it comes from, which supports genome annotation. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCBI RefSeq Nucleotide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000929 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000929">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000699"/>
        <obo:IAO_0000115 xml:lang="en">A chemical structure database within PubChem, run by NCBI, that holds 1 record for each unique, validated small-molecule structure, derived from the substance records that many contributors deposit. Each record gives identifiers, computed properties and links to related information. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PubChem Compound</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000930 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000930">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000699"/>
        <obo:IAO_0000115 xml:lang="en">A chemical structure database and ontology covering small molecules that take part in biological processes, as products, reactants or regulators. Being an ontology as well as a dictionary, it records how compounds relate to one another rather than only listing them. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Chemical Entities of Biological Interest</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ChEBI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000931 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000931">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000699"/>
        <obo:IAO_0000115 xml:lang="en">A chemical structure database of commercially available compounds, prepared in ready-to-dock 3D formats for virtual screening, which is the computer search for molecules that may bind a target. It is provided by the Irwin and Shoichet laboratories at the University of California, San Francisco, and holds hundreds of millions of purchasable compounds with annotated properties. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ZINC20</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000932 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000932">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000700"/>
        <obo:IAO_0000115 xml:lang="en">A drug information database holding detailed data on drugs together with their targets, interactions and metabolism. It combines information about each drug with information about the proteins it acts on, and its data are free for non-commercial research but need a licence for commercial use. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">DrugBank</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/MI_2002"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000933 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000933">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000699"/>
        <obo:IAO_0000115 xml:lang="en">A chemical structure database, owned by the Royal Society of Chemistry, that gives free access to millions of chemical structures with their properties and related information, gathered from many sources. It can be searched by chemical name, synonym, trade name, registry number or structure. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ChemSpider</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000934 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000934">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000700"/>
        <obo:IAO_0000115 xml:lang="en">A drug information database recording the protein and nucleic acid targets that drugs act on, the drugs directed at each, and the diseases involved. It is organised around the target rather than the compound. It is used to find what has already been tried against a protein before a new study is designed. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Therapeutic Target Database</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">TTD</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000935 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000935">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000700"/>
        <obo:IAO_0000115 xml:lang="en">A drug information database, run by the U.S. National Library of Medicine, that publishes the labels of marketed drugs as submitted to the U.S. Food and Drug Administration, including package inserts. The labels describe each drug&apos;s ingredients, uses, dosage, warnings and side effects for healthcare providers and the public. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">DailyMed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000957 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000957">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000707"/>
        <obo:IAO_0000115 xml:lang="en">A bioactivity database of manually curated data on drug-like small molecules and their measured activity against biological targets, mostly proteins, maintained by EMBL-EBI. It brings together chemical, bioactivity and genomic data to help turn genomic information into new drugs. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ChEMBL</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_1349"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000958 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000958">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000701"/>
        <obo:IAO_0000115 xml:lang="en">A spectroscopic database holding mass spectrometry datasets, chiefly from proteomics experiments. It stores the measurements themselves consenting to check reproducibility.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Mass Spectrometry Interactive Virtual Environment</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">MassIVE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000959 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000959">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000701"/>
        <obo:IAO_0000115 xml:lang="en">The Spectral Database for Organic Compounds (SDBS) is a free, searchable online database of experimental molecular spectra for organic molecules, hosted by the National Institute of Advanced Industrial Science and Technology (AIST) in Japan. SDBS contains NMR (1H, 13C), mass spectra, IR, Raman, and ESR spectra for a large number of organic compounds.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <rdfs:label xml:lang="en">SDBS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000960 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000960">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000702"/>
        <obo:IAO_0000115 xml:lang="en">An NMR data repository collecting nuclear magnetic resonance measurements on biological macromolecules and metabolites, including assigned chemical shifts, coupling constants and relaxation data. Those quantities are what a simulated structure or trajectory is compared against.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">Biological Magnetic Resonance Data Bank</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">BMRB</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_1346"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000961 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000961">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000702"/>
        <obo:IAO_0000115 xml:lang="en">An NMR data repository specialising in assigned chemical shifts for complex carbohydrates and their complexes. Carbohydrates are poorly covered by the general NMR archives, because their signals overlap heavily and their assignment is difficult. It exists to hold the assignments that do get made. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Complex Carbohydrate Magnetic Resonance Database</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ComplexCARP</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000962 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000962">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000703"/>
        <obo:IAO_0000115 xml:lang="en">A secondary database, run by EMBL-EBI, that combines the protein family, domain and functional site signatures of several member databases, such as Pfam, PROSITE, SMART, CDD and CATH-Gene3D, into 1 resource. Searching a protein sequence against it shows which families and domains the protein belongs to, which helps predict its function. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">InterPro</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0449"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000964 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000964">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000704"/>
        <obo:IAO_0000115 xml:lang="en">A protein family and domain database in which each family is represented by a multiple sequence alignment and a hidden Markov model, a statistical model of the sequence pattern the family shares. It is used to find conserved domains and families in protein sequences, and it is now provided through InterPro at EMBL-EBI. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Pfam</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0451"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000965 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000965">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000704"/>
        <obo:IAO_0000115 xml:lang="en">A protein family and domain database for identifying and annotating mobile domains, which are domains found in many different protein contexts, and for analysing the domain architecture of proteins. It is developed at EMBL and holds manually curated models for more than 1,000 domains, many of them involved in signalling, extracellular functions and chromatin regulation. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">SMART</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0457"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000966 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000966">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000704"/>
        <obo:IAO_0000115 xml:lang="en">A protein family and domain database that describes protein domains, families and functional sites by sequence patterns or by profiles, which are scoring tables derived from multiple sequence alignments. It is maintained by the SIB Swiss Institute of Bioinformatics and is used to find known motifs and domains in a protein sequence. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PROSITE</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0455"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000967 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000967">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000704"/>
        <obo:IAO_0000115 xml:lang="en">A protein family and domain database, maintained by NCBI, holding curated models of protein domains together with models imported from other collections, such as Pfam and SMART. Searching a sequence against it shows which known domains a protein contains, which helps decide what part of a protein to simulate. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Conserved Domain Database</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">CDD</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0450"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000968 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000968">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000705"/>
        <obo:IAO_0000115 xml:lang="en">A structural classification database that classifies protein domains of known structure by their evolutionary relationships and structural similarities. It is the successor of the original SCOP, developed at the MRC Laboratory of Molecular Biology, and organises its classes as a network in which a domain can be related to more than 1 group, instead of the single strict tree that SCOP used. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">SCOP2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000969 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000969">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000705"/>
        <obo:IAO_0000115 xml:lang="en">A structural classification database that sorts protein domains taken from experimental structures into a hierarchy of 4 levels, from broad shape down to evolutionary relationship. The 4 levels are what its name enumerates. It is used to find structurally similar proteins when sequence similarity is too weak to detect. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Class, Architecture, Topology, Homologous superfamily</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">CATH</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000970 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000970">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000705"/>
        <obo:IAO_0000115 xml:lang="en">A structural classification database that groups protein domains by evolutionary relationship rather than by shape, with a focus on distant relationships between proteins whose sequences have become too different to show them. Its levels run from architecture through possible homology (X-groups), homology (H-groups) and topology (T-groups) to families, and it is updated regularly as new structures enter the Protein Data Bank. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Evolutionary Classification of Protein Domains</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ECOD</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000971 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000971">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000706"/>
        <obo:IAO_0000115 xml:lang="en">A pathway database of manually drawn maps of molecular interaction and reaction networks, covering metabolism, genetic and environmental information processing, cellular processes, organismal systems and human diseases. It is part of the Kyoto Encyclopedia of Genes and Genomes (KEGG), developed in Japan by Kanehisa Laboratories. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">KEGG Pathway</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000972 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000972">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000706"/>
        <obo:IAO_0000115 xml:lang="en">A pathway database of human biological pathways and processes that is free, open-source, curated by experts and peer-reviewed. It describes biology as a hierarchy running from single molecular reactions up to whole pathways, linking the genes, proteins and small molecules involved. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Reactome</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0467"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000973 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000973">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000706"/>
        <obo:IAO_0000115 xml:lang="en">A pathway database that collects thousands of organism-specific databases, each describing the genome and metabolic pathways of 1 organism, together with MetaCyc, a reference database of pathways from many organisms. It is maintained by SRI International and records genes, enzymes, metabolites and reactions, which supports the comparison of metabolism between organisms. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">BioCyc</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_1105"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000977 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000977">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000706"/>
        <obo:IAO_0000115 xml:lang="en">A pathway database of biological pathway diagrams that anyone can contribute to and edit, so the collection is curated by its community of users. It covers many species, and its content is released under the CC0 public domain waiver. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">WikiPathways</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000991 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000991">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000707"/>
        <obo:IAO_0000115 xml:lang="en">A public, web-accessible database focusing on measured binding affinities of interactions between proteins (considered as drug targets) and small, drug-like molecules. It primarily contains data from enzyme assays, isothermal titration calorimetry, and surface plasmon resonance.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <rdfs:label xml:lang="en">BindingDB</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_1123"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000992 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000992">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000707"/>
        <obo:IAO_0000115 xml:lang="en">A free, public repository hosted by the U.S. National Center for Biotechnology Information (NCBI) that archives experimental descriptions of biological activities and test results for small molecules, cell-based screens, and small interfering RNAs (siRNAs).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <rdfs:label xml:lang="en">PubChem BioAssay</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000993 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000993">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000707"/>
        <obo:IAO_0000115 xml:lang="en">An expert-curated, open-access online portal and searchable database that provides quantitative data on biological targets and the prescription medicines and experimental drugs that act on them. Its entries are written and checked by specialists in each target family rather than gathered automatically.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0007-1391-4986"/>
        <oboInOwl:hasExactSynonym xml:lang="en">IUPHAR/BPS Guide to Pharmacology</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">IUPHAR/BPS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000994 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000994">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000708"/>
        <obo:IAO_0000115 xml:lang="en">A knowledge-based database that collects gene-disease and variant-disease associations from public databases and the scientific literature, standardises them, and scores each association so that it can be ranked. It is developed by the company MedBioinformatics Solutions, with free access for academic research and paid licences for commercial use. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">DisGeNET</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000995 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000995">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000708"/>
        <obo:IAO_0000115 xml:lang="en">A knowledge-based database cataloguing human genes and the inherited disorders and traits associated with them. It is organised around the link between a gene and the effects of altering it, rather than around sequences. It can be used to connect a mutation being simulated to its known clinical consequences. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Online Mendelian Inheritance in Man</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">OMIM</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0480"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000996 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000996">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000709"/>
        <obo:IAO_0000115 xml:lang="en">A repository database for research outputs from all disciplines, such as datasets, software, publications and figures, operated by CERN and created within the European OpenAIRE project. Every upload receives a DOI, a permanent identifier that makes it citable. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Zenodo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000997 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000997">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000709"/>
        <obo:IAO_0000115 xml:lang="en">A repository database, checked by curators, that publishes the data underlying scientific and medical publications so that the data can be found, freely reused and cited. Researchers deposit the datasets that belong to their articles, and the data are released into the public domain under the CC0 dedication. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Dryad Digital Repository</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000998 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000998">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000709"/>
        <obo:IAO_0000115 xml:lang="en">A repository database where researchers in any discipline can store and share research outputs such as figures, datasets, images and code. Each item can be given a DOI, a permanent identifier that makes it citable and easier to find. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Figshare</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_000999 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000999">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000710"/>
        <obo:IAO_0000115 xml:lang="en">A simulation data repository, based in Europe, for storing and sharing biomolecular simulation data. It accepts trajectories together with the metadata describing how they were produced, which is what makes a deposited trajectory reusable by others. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Molecular Dynamics Data Bank</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">MDDBR</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001000 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001000">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000710"/>
        <obo:IAO_0000115 xml:lang="en">A simulation data repository for molecular dynamics trajectories of biomolecules, contributed by the biomolecular simulation community in the United Kingdom and hosted by the Physical Sciences Data Infrastructure (PSDI). It records how each simulation was set up, from the starting structure and force field to the run parameters, so that the data can be reproduced and reused. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">BioSimDB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001001 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001001">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000710"/>
        <obo:IAO_0000115 xml:lang="en">A simulation data repository of atomistic molecular dynamics trajectories of proteins, chosen to represent the monomeric soluble protein structures in the Protein Data Bank. It was developed by IRB Barcelona and the Barcelona Supercomputing Center, and its trajectories are used to describe how flexible each protein is. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MoDEL database</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Distinct from the class &apos;model&apos; (MOLSIM:000006), which it resembles only in spelling: this is a named simulation data repository, that is a general kind of representation. Case-insensitive lexical matching conflates the two, so prefer the synonym &apos;MoDEL database&apos; when matching.</rdfs:comment>
        <rdfs:label xml:lang="en">MoDEL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001002 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001002">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000710"/>
        <obo:IAO_0000115 xml:lang="en">A web server tool for sharing, viewing and analysing molecular dynamics simulation trajectories directly in a web browser, without installing software locally. A research group runs it on its own server to make its trajectories available to others, with interactive views and common analyses. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">MDsrv</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001003 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001003">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000692"/>
        <obo:IAO_0000115 xml:lang="en">A protein structural database for structures of biological molecules determined by integrative or hybrid methods, which combine data from several experimental techniques with computational modelling. It began as a prototype archive and in 2024 was unified with the Protein Data Bank and renamed PDB-IHM, so its structures now receive PDB accession codes. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PDB-Dev</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001004 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001004">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000711"/>
        <obo:IAO_0000115 xml:lang="en">A predicted structure repository that gives open access to protein structure predictions made by the AlphaFold system, covering a large share of the protein sequences in UniProt. It is run by EMBL-EBI together with Google DeepMind, and supplies models for proteins that have no experimentally determined structure. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">AlphaFold Protein Structure Database</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001005 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001005">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000711"/>
        <obo:IAO_0000115 xml:lang="en">A predicted structure repository of 3D protein models built automatically by the SWISS-MODEL homology modelling pipeline, which bases each model on an experimentally determined structure of a related protein. It is updated regularly and provides precomputed models for a large number of sequences in UniProtKB, especially those of model organisms. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">SWISS-MODEL Repository</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001006 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001006">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000711"/>
        <obo:IAO_0000115 xml:lang="en">A predicted structure repository holding several hundred million structure predictions for metagenomic proteins, which are proteins known only from DNA sequenced directly from environmental samples, made with the ESMFold model developed at Meta AI. ESMFold predicts a structure from a single sequence with a protein language model, without first collecting related sequences, which makes it much faster than earlier methods but on average less accurate. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Evolutionary Scale Modeling Atlas</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ESMatlas</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001007 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001007">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000711"/>
        <obo:IAO_0000115 xml:lang="en">A predicted structure repository for 3D models of biological macromolecules made by computational methods, which the Protein Data Bank does not accept because they are not based on experimental data. Each deposited model receives a stable accession code, which is also a DOI, so that it can be cited, and the archive is developed by the SIB Swiss Institute of Bioinformatics and the Biozentrum of the University of Basel. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ModelArchive</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001025 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001025">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000712"/>
        <obo:IAO_0000115 xml:lang="en">A metabolomics repository, maintained at EMBL-EBI, for metabolomics experiments across species and measurement techniques, together with the information derived from them. It archives study descriptions, raw experimental data and the identified and measured metabolites. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">MetaboLights</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001026 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001026">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000712"/>
        <obo:IAO_0000115 xml:lang="en">A metabolomics repository and analysis platform for mass spectrometry data on natural products, which groups related compounds by the similarity of their spectra. Grouping this way helps suggest the identity of compounds that no reference library contains, from their resemblance to ones that it does. Its reference spectra are contributed and curated by its users. (UNVERIFIED)</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Global Natural Products Social Molecular Networking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">GNPS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001027 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001027">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000712"/>
        <obo:IAO_0000115 xml:lang="en">A public repository for metabolomics data and metadata, part of the NIH Common Fund&apos;s Metabolomics Program. It serves as a national and international data repository and coordinating center, providing tools for data analysis, visualization, and integration with other omics data. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Metabolomics Workbench</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001028 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001028">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000713"/>
        <obo:IAO_0000115 xml:lang="en">A literature database, run by the U.S. National Library of Medicine at the National Institutes of Health, that gives free search access to references and abstracts in the life sciences and biomedicine, drawn mainly from the MEDLINE database. Its records link to the full text where a publisher or PubMed Central makes it available. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">PubMed</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MI_0446"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001029 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001029">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000713"/>
        <obo:IAO_0000115 xml:lang="en">A literature database of abstracts and citations covering peer-reviewed journals, books and conference proceedings, owned by the publisher Elsevier and available by subscription. It provides tools to track, analyse and visualise research output and citations across disciplines. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Scopus</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001030 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001030">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000713"/>
        <obo:IAO_0000115 xml:lang="en">A literature database and citation index covering many disciplines, owned by the company Clarivate and available by subscription. It gives access to several databases of scholarly journals, books, conference proceedings and patents, with the citation links between their records, and is used for literature searches and for measuring research impact. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Web of Science</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001031 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001031">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_000713"/>
        <obo:IAO_0000115 xml:lang="en">A literature database, provided free of charge by Google as a web search engine, that indexes the full text or metadata of scholarly literature across many publishing formats and disciplines. It is not curated: its index is built automatically, so its coverage is broad but its records can contain errors. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Google Scholar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001532 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001532">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_001522"/>
        <obo:IAO_0000115 xml:lang="en">The small molecule structural database that serves as the primary repository for experimentally determined three-dimensional crystal structures of small organic and metal-organic molecules. It provides high-quality reference geometries used for validating force fields and for obtaining starting structures in computational studies. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Cambridge Structural Database</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_001945 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001945">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. A redundant untyped individual that duplicated the class &apos;omni-path&apos; (MOLSIM:001949). It should not be used; use that class instead.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_001949"/>
        <rdfs:comment xml:lang="en">Obsoleted: redundant untyped individual duplicating the class &apos;omni-path&apos; (MOLSIM_001949), which is the concept to use instead.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Omni-Path</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_002174 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_002174">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_002161"/>
        <obo:IAO_0000115 xml:lang="en">The file format convention denoted by the string AMBERRESTART in a NetCDF file&apos;s global Conventions attribute, designating the file as an AMBER restart or state file. Such a file holds a single configuration with no frame dimension, while a trajectory holds many frames, and because NetCDF is a general container this attribute is the declared way to tell the 2 apart. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">AMBERRESTART NetCDF convention</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_002175 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_002175">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_002161"/>
        <obo:IAO_0000115 xml:lang="en">The file format convention denoted by the string AMBER in a NetCDF file&apos;s global Conventions attribute, designating the file as an AMBER coordinate trajectory. It is the counterpart of the restart convention and distinguishes a file of many frames from a file holding 1 state. The distinction cannot be made from the file extension alone. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">AMBER trajectory NetCDF convention</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_002176 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_002176">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_002162"/>
        <obo:IAO_0000115 xml:lang="en">The system classification label assigned to a molecular system composed of a protein receptor, a small-molecule ligand and explicit water molecules. Explicit water means that individual water molecules are present in the model, rather than a continuum that only imitates their average effect. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Protein / Ligand in Explicit Water</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_002177 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_002177">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_002166"/>
        <obo:IAO_0000115 xml:lang="en">The hydrogen detection strategy that identifies hydrogen atoms by testing whether an atom&apos;s atomic number is exactly 1, used when applying or detecting hydrogen mass repartitioning. It is the reliable test, because atomic number is a physical fact recorded in the topology. It cannot be used where the topology omits atomic numbers, which is why a name-based fallback exists. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">atomic number HMR detection strategy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MOLSIM_002178 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MOLSIM_002178">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MOLSIM_002166"/>
        <obo:IAO_0000115 xml:lang="en">The hydrogen detection strategy that identifies hydrogen atoms by testing whether an atom&apos;s name begins with the letter H, used when applying or detecting hydrogen mass repartitioning. It is a fallback for topologies that do not record atomic numbers. It is not reliable: the element symbols of helium, hafnium and mercury (He, Hf, Hg) also begin with H, and some naming conventions put a digit before the H. (UNVERIFIED)</obo:IAO_0000115>
        <rdfs:label xml:lang="en">atom name HMR detection strategy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OMO_0001000 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OMO_0001000">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term was added to the ontology on the assumption it was in scope, but it turned out later that it was not.</obo:IAO_0000115>
        <rdfs:label>out of scope</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OMO_0001002 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OMO_0001002">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">The term was added to the ontology on the assumption it was a valid domain entity, but it turns out the entity does not exist in reality.</obo:IAO_0000115>
        <rdfs:label>domain entity does not exist</rdfs:label>
    </owl:NamedIndividual>
    


