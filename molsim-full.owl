        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000105"/>
        <obo:IAO_0000115>A frequency unit which is equal to one million hertz or 10^[6] V.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>mH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>megahertz</oboInOwl:hasRelatedSynonym>
