    <!-- http://purl.obolibrary.org/obo/UO_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
