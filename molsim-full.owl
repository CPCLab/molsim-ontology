        <oboInOwl:hasExactSynonym>INSDC_note:sequence_feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>located_sequence_feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sequence feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>located sequence feature</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>SO:0000110</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <rdfs:label>sequence_feature</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000110"/>
