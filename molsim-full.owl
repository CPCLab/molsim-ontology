    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000325"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A frequency unit which is equal to one million hertz or 10^[6] V.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0010069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0010069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000110"/>
        <obo:IAO_0000115>A pressure unit which is equal to 100,000 pascal or the pressure or stress on a surface caused by a force of 100,000 newtons spread over a surface of 1 m^[2].</obo:IAO_0000115>
        <rdfs:label>bar</rdfs:label>
