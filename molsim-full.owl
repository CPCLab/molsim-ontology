        <owl:annotatedTarget>A pressure unit which is equal to 100,000 pascal or the pressure or stress on a surface caused by a force of 100,000 newtons spread over a surface of 1 m^[2].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


