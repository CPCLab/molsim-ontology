        <owl:annotatedTarget>A nucleotide modified by methylation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SO_0000417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001070"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0100021"/>
        <obo:IAO_0000115>A structurally or functionally defined protein region. In proteins with multiple domains, the combination of the domains determines the function of the protein. A region which has been shown to recur throughout evolution.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>BS:00012</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>BS:00134</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>SO:0001069</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>domain</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>structural domain</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>polypeptide domain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polypeptide_structural_domain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000417</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#biosapiens"/>
        <rdfs:comment>Range. Old definition from before biosapiens: A region of a single polypeptide chain that folds into an independent unit and exhibits biological activity. A polypeptide chain may have multiple domains.</rdfs:comment>
        <rdfs:label>polypeptide_domain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000417"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A structurally or functionally defined protein region. In proteins with multiple domains, the combination of the domains determines the function of the protein. A region which has been shown to recur throughout evolution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>EBIBS:GAR</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>domain</owl:annotatedTarget>
        <oboInOwl:hasDbXref>uniprot:feature_type</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/so#BS"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000417"/>
