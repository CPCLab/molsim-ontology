        <owl:annotatedTarget>A time unit which is equal to one thousandth of one millionth of a second or 10^[-9] s.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the influence exerted by some mass.</obo:IAO_0000115>
