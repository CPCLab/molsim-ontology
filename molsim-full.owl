            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000208"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000209"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000008"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000009"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000010"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000011"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000012"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000013"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000014"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000015"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000016"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001445"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000017"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000485"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000580"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000581"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000018"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000019"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000020"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001449"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_001450"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000021"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000132"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MOLSIM_000682"/>
