    <!-- http://purl.obolibrary.org/obo/UO_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000182"/>
        <obo:IAO_0000115>A density unit which is a standard measure of the mass of a substance in a given volume.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mass per unit volume</oboInOwl:hasExactSynonym>
        <rdfs:label>mass density unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A density unit which is a standard measure of the mass of a substance in a given volume.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the rate of movement. Speed is measured in the same physical units of measurement as velocity, but does not contain the element of direction that velocity has. Speed is thus the magnitude component of velocity.</obo:IAO_0000115>
        <rdfs:label>speed/velocity unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the rate of movement. Speed is measured in the same physical units of measurement as velocity, but does not contain the element of direction that velocity has. Speed is thus the magnitude component of velocity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wikipedia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000051"/>
        <obo:IAO_0000115>A concentration unit which is a standard measure of the number of moles of a given substance per liter of solution.</obo:IAO_0000115>
        <rdfs:label>unit of molarity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A concentration unit which is a standard measure of the number of moles of a given substance per liter of solution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000062"/>
        <obo:IAO_0000115>A unit of concentration which expresses a concentration of 1 mole of solute per liter of solution (mol/L).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>M</oboInOwl:hasExactSynonym>
        <rdfs:label>molar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit of concentration which expresses a concentration of 1 mole of solute per liter of solution (mol/L).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000062"/>
        <obo:IAO_0000115>A unit of molarity which is equal to one thousandth of a molar or 10^[-3] M.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mM</oboInOwl:hasExactSynonym>
        <rdfs:label>millimolar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit of molarity which is equal to one thousandth of a molar or 10^[-3] M.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000094"/>
        <obo:IAO_0000115>A speed/velocity unit which is equal to the speed of an object traveling 1 meter distance in one second.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>m/s</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>metre per second</oboInOwl:hasExactSynonym>
        <rdfs:label>meter per second</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A speed/velocity unit which is equal to the speed of an object traveling 1 meter distance in one second.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.</obo:IAO_0000115>
        <rdfs:label>volume unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the number of repetitive actions in a particular time.</obo:IAO_0000115>
        <rdfs:label>frequency unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000105"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the number of repetitive actions in a particular time.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000106"/>
        <obo:IAO_0000115>A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Hz</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>s^1</oboInOwl:hasExactSynonym>
        <rdfs:label>hertz</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000106"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the force is applied when a mass is accelerated.</obo:IAO_0000115>
        <rdfs:label>force unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the force is applied when a mass is accelerated.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the force applied to a given area.</obo:IAO_0000115>
        <rdfs:label>pressure unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000109"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the force applied to a given area.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the work done by a certain force (gravitational, electric, magnetic, force of inertia, etc).</obo:IAO_0000115>
        <rdfs:label>energy unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the work done by a certain force (gravitational, electric, magnetic, force of inertia, etc).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the figure or space formed by the junction of two lines or planes.</obo:IAO_0000115>
        <rdfs:label>angle unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the figure or space formed by the junction of two lines or planes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wikipedia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000121"/>
        <obo:IAO_0000115>A unit which is a standard measure of the angle formed by two straight lines in the same plane.</obo:IAO_0000115>
        <rdfs:label>plane angle unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000122"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the angle formed by two straight lines in the same plane.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wikipedia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000123"/>
        <obo:IAO_0000115>A plane angle unit which is equal to the angle subtended at the center of a circle by an arc equal in length to the radius of the circle, approximately 57 degrees 17 minutes and 44.6 seconds.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>rad</oboInOwl:hasExactSynonym>
        <rdfs:label>radian</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plane angle unit which is equal to the angle subtended at the center of a circle by an arc equal in length to the radius of the circle, approximately 57 degrees 17 minutes and 44.6 seconds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIST:NIST</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000010"/>
        <obo:IAO_0000115>A time unit which is equal to one thousandth of one millionth of a second or 10^[-9] s.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ns</oboInOwl:hasExactSynonym>
        <rdfs:label>nanosecond</rdfs:label>
